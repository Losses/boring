diff --git a/out/rev-param-identity/identity/probe/revp1/RevIdentity.hx b/out/rev-param-identity/identity/probe/revp1/RevIdentity.hx
new file mode 100644
--- a/out/rev-param-identity/identity/probe/revp1/RevIdentity.hx	2026-09-22 21:36:18.530607732 -0400
+++ b/out/rev-param-identity/identity/probe/revp1/RevIdentity.hx
@@ -0,0 +1,145 @@
+package revp1;
+#if macro
+import haxe.macro.Context;
+import haxe.macro.Type;
+import SourceComparisonAnalysis;
+
+/** Independent review probe: does parameterIdentity carry the owning
+    declaration identity? Calls the REAL SourceComparisonAnalysis, no copy. */
+class RevIdentity {
+    public static function run():Void {
+        final oneRef = declRef("revp1.One");
+        final twoRef = declRef("revp1.Two");
+        final alphaRef = declRef("revp1.Alpha");
+        final betaRef = declRef("revp1.Beta");
+        final swapRef = declRef("revp1.Swap");
+        final subRef = declRef("revp1.sub.SubHolder");
+        final anonRef = declRef("revp1.AnonField");
+
+        final oneT = paramType(oneRef, 0);
+        final twoT = paramType(twoRef, 0);
+        final alphaT = paramType(alphaRef, 0);
+        final betaU = paramType(betaRef, 0);
+        final swapA = paramType(swapRef, 0);
+        final swapB = paramType(swapRef, 1);
+        final subT = paramType(subRef, 0);
+
+        Sys.println("== raw parameter ClassType facts ==");
+        dumpParam("One.T", oneT);
+        dumpParam("Two.T", twoT);
+        dumpParam("Alpha.T", alphaT);
+        dumpParam("Beta.U", betaU);
+        dumpParam("Swap.A", swapA);
+        dumpParam("Swap.B", swapB);
+        dumpParam("SubHolder.T", subT);
+
+        Sys.println("");
+        Sys.println("== parameterIdentity keys (real SourceComparisonAnalysis.parameterIdentity) ==");
+        Sys.println("One.T       => " + Std.string(SourceComparisonAnalysis.parameterIdentity(oneT)));
+        Sys.println("Two.T       => " + Std.string(SourceComparisonAnalysis.parameterIdentity(twoT)));
+        Sys.println("Alpha.T     => " + Std.string(SourceComparisonAnalysis.parameterIdentity(alphaT)));
+        Sys.println("Beta.U      => " + Std.string(SourceComparisonAnalysis.parameterIdentity(betaU)));
+        Sys.println("Swap.A      => " + Std.string(SourceComparisonAnalysis.parameterIdentity(swapA)));
+        Sys.println("Swap.B      => " + Std.string(SourceComparisonAnalysis.parameterIdentity(swapB)));
+        Sys.println("SubHolder.T => " + Std.string(SourceComparisonAnalysis.parameterIdentity(subT)));
+
+        Sys.println("");
+        Sys.println("== cross-declaration key collisions ==");
+        Sys.println("One.T   == Two.T     (same package, diff owner, same name) : " + (SourceComparisonAnalysis.parameterIdentity(oneT) == SourceComparisonAnalysis.parameterIdentity(twoT)));
+        Sys.println("One.T   == Alpha.T   (same package, diff owner, same name) : " + (SourceComparisonAnalysis.parameterIdentity(oneT) == SourceComparisonAnalysis.parameterIdentity(alphaT)));
+        Sys.println("Alpha.T == Beta.U    (same package, diff owner, diff name) : " + (SourceComparisonAnalysis.parameterIdentity(alphaT) == SourceComparisonAnalysis.parameterIdentity(betaU)));
+        Sys.println("Swap.A  == Swap.B    (same owner, diff names)              : " + (SourceComparisonAnalysis.parameterIdentity(swapA) == SourceComparisonAnalysis.parameterIdentity(swapB)));
+        Sys.println("One.T   == SubHolder.T (diff module, same name)            : " + (SourceComparisonAnalysis.parameterIdentity(oneT) == SourceComparisonAnalysis.parameterIdentity(subT)));
+
+        Sys.println("");
+        Sys.println("== ownParameterSlot controls (real API, RecordDeclaration owner) ==");
+        Sys.println("slot(One.T,   owner One)        : " + Std.string(SourceComparisonAnalysis.ownParameterSlot(oneT, RecordDeclaration(oneRef))));
+        Sys.println("slot(Two.T,   owner One)  neg   : " + Std.string(SourceComparisonAnalysis.ownParameterSlot(twoT, RecordDeclaration(oneRef))));
+        Sys.println("slot(Alpha.T, owner One)  neg   : " + Std.string(SourceComparisonAnalysis.ownParameterSlot(alphaT, RecordDeclaration(oneRef))));
+        Sys.println("slot(Two.T,   owner Two)        : " + Std.string(SourceComparisonAnalysis.ownParameterSlot(twoT, RecordDeclaration(twoRef))));
+        Sys.println("slot(Beta.U,  owner Beta)       : " + Std.string(SourceComparisonAnalysis.ownParameterSlot(betaU, RecordDeclaration(betaRef))));
+        Sys.println("slot(Swap.A,  owner Swap)       : " + Std.string(SourceComparisonAnalysis.ownParameterSlot(swapA, RecordDeclaration(swapRef))));
+        Sys.println("slot(Swap.B,  owner Swap)       : " + Std.string(SourceComparisonAnalysis.ownParameterSlot(swapB, RecordDeclaration(swapRef))));
+        Sys.println("slot(SubHolder.T, owner SubHolder) : " + Std.string(SourceComparisonAnalysis.ownParameterSlot(subT, RecordDeclaration(subRef))));
+
+        Sys.println("");
+        Sys.println("== schemaParameterIndex (real API) ==");
+        Sys.println("index(Two.T,   args [One.T])     : " + Std.string(SourceComparisonAnalysis.schemaParameterIndex(twoT, [oneT])));
+        Sys.println("index(One.T,   args [One.T])     : " + Std.string(SourceComparisonAnalysis.schemaParameterIndex(oneT, [oneT])));
+        Sys.println("index(Swap.B,  args [Swap.A,Swap.B]) : " + Std.string(SourceComparisonAnalysis.schemaParameterIndex(swapB, [swapA, swapB])));
+
+        Sys.println("");
+        Sys.println("== anonymous structures ==");
+        final anonT = fieldType(anonRef, "anon");
+        final anonPlainRef = moduleDeclRef("revp1.AnonField", "AnonPlain");
+        final anonPlainT = fieldType(anonPlainRef, "anon");
+        Sys.println("AnonField.anon type            : " + Std.string(anonT).substr(0, 60));
+        Sys.println("AnonPlain.anon  type           : " + Std.string(anonPlainT).substr(0, 60));
+        Sys.println("SourceComparisonAnalysis.parameterIdentity(AnonField.anon) : " + Std.string(SourceComparisonAnalysis.parameterIdentity(anonT)));
+        Sys.println("SourceComparisonAnalysis.parameterIdentity(AnonPlain.anon) : " + Std.string(SourceComparisonAnalysis.parameterIdentity(anonPlainT)));
+        Sys.println("SourceComparisonAnalysis.ownParameterSlot(AnonField.anon, owner AnonField) : " + Std.string(SourceComparisonAnalysis.ownParameterSlot(anonT, RecordDeclaration(anonRef))));
+
+        Sys.println("");
+        Sys.println("== real schema path: SourceComparisonAnalysis.analyzeRecordSchema(One) + SourceComparisonAnalysis.comparisonPlan(SortedKey) ==");
+        final schemaNode = SourceComparisonAnalysis.analyzeRecordSchema(oneRef);
+        switch (SourceComparisonAnalysis.comparisonPlan(schemaNode, SortedKey)) {
+            case ComparisonPlanReady(plan):
+                for (f in plan.fields)
+                    Sys.println("field " + f.field.name + " => " + Std.string(f.operation));
+                Sys.println("plan.complete: " + plan.complete);
+            case other:
+                Sys.println("NOT ready: " + Std.string(other));
+        }
+        Sys.println("");
+        Sys.println("== real schema path: SourceComparisonAnalysis.analyzeRecordSchema(Swap) + SourceComparisonAnalysis.comparisonPlan(SortedKey) ==");
+        final swapSchema = SourceComparisonAnalysis.analyzeRecordSchema(swapRef);
+        switch (SourceComparisonAnalysis.comparisonPlan(swapSchema, SortedKey)) {
+            case ComparisonPlanReady(plan):
+                for (f in plan.fields)
+                    Sys.println("field " + f.field.name + " => " + Std.string(f.operation));
+            case other:
+                Sys.println("NOT ready: " + Std.string(other));
+        }
+    }
+
+    static function dumpParam(label:String, type:Type):Void {
+        switch (type) {
+            case TInst(reference, args):
+                final cls = reference.get();
+                Sys.println(label + ": pack=[" + cls.pack.join(".") + "] module=" + cls.module + " name=" + cls.name + " kind=" + Std.string(cls.kind) + " args=" + args.length);
+            case other:
+                Sys.println(label + ": UNEXPECTED " + Std.string(other));
+        }
+    }
+
+    static function paramType(ref:Ref<ClassType>, index:Int):Type {
+        final params = ref.get().params;
+        if (index >= params.length) throw "no parameter " + index;
+        return params[index].t;
+    }
+
+    static function declRef(path:String):Ref<ClassType> {
+        return switch (Context.getType(path)) {
+            case TInst(reference, _): reference;
+            case other: throw "unexpected " + path + " " + Std.string(other);
+        }
+    }
+
+    static function moduleDeclRef(modulePath:String, name:String):Ref<ClassType> {
+        for (entry in Context.getModule(modulePath))
+            switch (entry) {
+                case TInst(reference, _):
+                    final cls = reference.get();
+                    if (cls.name == name) return reference;
+                case _:
+            }
+        throw "type " + name + " not in module " + modulePath;
+    }
+
+    static function fieldType(ref:Ref<ClassType>, name:String):Type {
+        for (field in ref.get().fields.get())
+            if (field.name == name) return field.type;
+        throw "field " + name + " not found";
+    }
+}
+#end
