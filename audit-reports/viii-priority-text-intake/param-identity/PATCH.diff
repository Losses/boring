diff --git a/out/rev-param-identity/callsite/probe/revp2/RevCallSite.hx b/out/rev-param-identity/callsite/probe/revp2/RevCallSite.hx
new file mode 100644
--- a/out/rev-param-identity/callsite/probe/revp2/RevCallSite.hx	2026-09-22 21:36:18.530607732 -0400
+++ b/out/rev-param-identity/callsite/probe/revp2/RevCallSite.hx
@@ -0,0 +1,180 @@
+package revp2;
+#if macro
+import haxe.macro.Context;
+import haxe.macro.Type;
+import haxe.macro.TypeTools;
+import SourceComparisonAnalysis;
+
+/** Call-site probe against the REAL SourceComparisonAnalysis.
+    Verifies fresh-Ref behavior, node/plan dedup, and whether
+    sameTypeParameter's Ref-pointer branch is reachable on public paths. */
+class RevCallSite {
+    public static function run():Void {
+        Sys.println("== A. declarationReference twice for the same class (Point) ==");
+        final pointCls = clsOf("revp2.Point");
+        final pointRef1 = SourceComparisonAnalysis.declarationReference(pointCls);
+        final pointRef2 = SourceComparisonAnalysis.declarationReference(pointCls);
+        Sys.println("ref1 == ref2 (pointer)       : " + (pointRef1 == pointRef2));
+        Sys.println("ref1.get() == ref2.get() (ClassType): " + (pointRef1.get() == pointRef2.get()));
+
+        Sys.println("");
+        Sys.println("== A2. parameter-object stability across fresh declaration References (Generic) ==");
+        final gRef1 = SourceComparisonAnalysis.declarationReference(clsOf("revp2.Generic"));
+        final gRef2 = SourceComparisonAnalysis.declarationReference(clsOf("revp2.Generic"));
+        final gRef3 = SourceComparisonAnalysis.declarationReference(clsOf("revp2.Generic"));
+        final tG1 = gRef1.get().params[0].t;
+        final tG2 = gRef2.get().params[0].t;
+        Sys.println("gRef1 == gRef2 (pointer)     : " + (gRef1 == gRef2));
+        Sys.println("gRef1.get() == gRef2.get()   : " + (gRef1.get() == gRef2.get()));
+        Sys.println("tG1 == tG2 (same Type object): " + (tG1 == tG2));
+        Sys.println("ref(tG1) == ref(tG2) (Ref)   : " + (instRefOf(tG1) == instRefOf(tG2)));
+
+        Sys.println("");
+        Sys.println("== B. analyzeRecord dedup across two fresh Refs (Point) ==");
+        final nodeA = SourceComparisonAnalysis.analyzeRecord(pointRef1, []);
+        final nodeB = SourceComparisonAnalysis.analyzeRecord(pointRef2, []);
+        Sys.println("nodeA == nodeB (pointer)     : " + (nodeA == nodeB));
+        Sys.println("nodeA fields                 : " + nodeA.fields.length);
+        Sys.println("nodeB fields                 : " + nodeB.fields.length);
+        Sys.println("plan(nodeA) ready            : " + isReady(SourceComparisonAnalysis.comparisonPlan(nodeA, OptionalEqualityCapability)));
+        Sys.println("plan(nodeB) ready            : " + isReady(SourceComparisonAnalysis.comparisonPlan(nodeB, OptionalEqualityCapability)));
+
+        Sys.println("");
+        Sys.println("== C. Generic plan with stored parameter argument (one Builder) ==");
+        final nodeG = SourceComparisonAnalysis.analyzeRecord(gRef1, [tG1]);
+        switch (SourceComparisonAnalysis.comparisonPlan(nodeG, OptionalEqualityCapability)) {
+            case ComparisonPlanReady(plan):
+                var childPlan:Null<SourceRecordComparisonPlan> = null;
+                var pairPlan:Null<SourceRecordComparisonPlan> = null;
+                for (f in plan.fields) {
+                    Sys.println("field " + f.field.name + " => " + Std.string(f.operation).substr(0, 56));
+                    final nested = nestedPlan(f.operation);
+                    if (f.field.name == "child") childPlan = nested;
+                    if (f.field.name == "pair") pairPlan = nested;
+                }
+                Sys.println("nested Pair plans same node (dedup): " + (childPlan != null && childPlan == pairPlan));
+            case other:
+                Sys.println("NOT ready: " + Std.string(other).substr(0, 160));
+        }
+
+        Sys.println("");
+        Sys.println("== C2. what applyTypeParameters produces for the real 'pair' field type ==");
+        final gFields = gRef1.get().fields.get();
+        var pairFieldType:Null<Type> = null;
+        var childFieldType:Null<Type> = null;
+        for (f in gFields) {
+            if (f.name == "pair") pairFieldType = f.type;
+            if (f.name == "child") childFieldType = f.type;
+        }
+        final pairSubbed = TypeTools.applyTypeParameters(pairFieldType, gRef1.get().params, [tG1]);
+        final childSubbed = TypeTools.applyTypeParameters(childFieldType, gRef1.get().params, [tG1]);
+        dumpSubbed("pair  field (Pair<T>)", pairSubbed, tG1);
+        dumpSubbed("child field (Null<Pair<T>>)", childSubbed, tG1);
+
+        Sys.println("");
+        Sys.println("== D. Wrapper (nested non-generic record) ==");
+        final wrapperNode = SourceComparisonAnalysis.analyzeRecord(refOf("revp2.Wrapper"), []);
+        switch (SourceComparisonAnalysis.comparisonPlan(wrapperNode, OptionalEqualityCapability)) {
+            case ComparisonPlanReady(plan):
+                Sys.println("ready, fields: " + [for (f in plan.fields) f.field.name].join(","));
+            case other:
+                Sys.println("NOT ready: " + Std.string(other).substr(0, 160));
+        }
+
+        Sys.println("");
+        Sys.println("== E. recursive Loop with two fresh Refs ==");
+        final loopRef1 = SourceComparisonAnalysis.declarationReference(clsOf("revp2.Loop"));
+        final loopRef2 = SourceComparisonAnalysis.declarationReference(clsOf("revp2.Loop"));
+        final loopA = SourceComparisonAnalysis.analyzeRecord(loopRef1, []);
+        final loopB = SourceComparisonAnalysis.analyzeRecord(loopRef2, []);
+        Sys.println("loopA == loopB (pointer)     : " + (loopA == loopB));
+        switch (SourceComparisonAnalysis.comparisonPlan(loopA, OptionalEqualityCapability)) {
+            case ComparisonPlanReady(plan):
+                Sys.println("plan(loopA) ready, fields: " + [for (f in plan.fields) f.field.name].join(",") + " complete=" + plan.complete);
+            case other:
+                Sys.println("plan(loopA) NOT ready: " + Std.string(other).substr(0, 160));
+        }
+
+        Sys.println("");
+        Sys.println("== F. admitDeclaration (real paths) ==");
+        final intType = Context.getType("Int");
+        Sys.println("admit Generic<Int>  OptionalEquality : " + Std.string(SourceComparisonAnalysis.admitDeclaration(RecordDeclaration(gRef1), [intType], OptionalEqualityCapability)).substr(0, 110));
+        Sys.println("admit Generic<> binder SortedKey     : " + Std.string(SourceComparisonAnalysis.admitDeclaration(RecordDeclaration(gRef3), [tG2], SortedKey)).substr(0, 110));
+        Sys.println("admit Generic<> binder OptionalEq    : " + Std.string(SourceComparisonAnalysis.admitDeclaration(RecordDeclaration(gRef3), [tG2], OptionalEqualityCapability)).substr(0, 110));
+        Sys.println("admit Loop (recursive) SortedKey     : " + Std.string(SourceComparisonAnalysis.admitDeclaration(RecordDeclaration(loopRef1), [], SortedKey)).substr(0, 110));
+
+        Sys.println("");
+        Sys.println("== G. schema path (analyzeRecordSchema + comparisonPlan) ==");
+        final schemaNode = SourceComparisonAnalysis.analyzeRecordSchema(gRef1);
+        switch (SourceComparisonAnalysis.comparisonPlan(schemaNode, SortedKey)) {
+            case ComparisonPlanReady(plan):
+                Sys.println("schema SortedKey: " + [for (f in plan.fields) f.field.name + ":" + Std.string(f.operation).substr(0, 26)].join(", "));
+            case other:
+                Sys.println("schema SortedKey NOT ready: " + Std.string(other).substr(0, 160));
+        }
+        final schemaNode2 = SourceComparisonAnalysis.analyzeRecordSchema(gRef2);
+        Sys.println("schema node fresh-Ref reuse (same Builder? no, fresh) : " + (schemaNode == schemaNode2));
+
+        Sys.println("");
+        Sys.println("== H. sameTypeParameter reachability facts ==");
+        Sys.println("h1: tG1 == tG2 identical object          : " + (tG1 == tG2) + "  (A2)");
+        Sys.println("h2: pair-field substituted arg identity  : see C2 (arg == tG1 ?)");
+        Sys.println("h3: nested Pair dedup in one Builder     : see C (same node ?)");
+        Sys.println("h4: conclusion basis: if C2 shows identical objects, sameType");
+        Sys.println("    short-circuits on left==right before the parameter branch, so");
+        Sys.println("    sameTypeParameter is only reached with the SAME Ref (true) or,");
+        Sys.println("    if objects differ with fresh Refs, returns false (node dup).");
+    }
+
+    static function dumpSubbed(label:String, subbed:Type, tG:Type):Void {
+        switch (subbed) {
+            case TInst(c, args):
+                final cls = c.get();
+                Sys.println(label + " => " + cls.name + "<...> args=" + args.length);
+                if (args.length == 1) {
+                    Sys.println("    arg == tG (identity)        : " + (args[0] == tG));
+                    Sys.println("    ref(arg) == ref(tG) (Ref)   : " + (instRefOf(args[0]) == instRefOf(tG)));
+                    Sys.println("    arg key == tG key           : " + (SourceComparisonAnalysis.parameterIdentity(args[0]) == SourceComparisonAnalysis.parameterIdentity(tG)));
+                }
+            case TAbstract(a, aargs):
+                Sys.println(label + " => TAbstract " + a.get().name + " args=" + aargs.length);
+                for (inner in aargs) dumpSubbed(label + ".inner", inner, tG);
+            case other:
+                Sys.println(label + " => " + Std.string(other).substr(0, 80));
+        }
+    }
+
+    static function nestedPlan(op:SourceComparisonOperation):Null<SourceRecordComparisonPlan> {
+        return switch (op) {
+            case NullBeforePresent(inner): nestedPlan(inner);
+            case RecordOrder(n, _): n;
+            case _: null;
+        }
+    }
+
+    static function isReady(result:SourceComparisonPlanResult):Bool {
+        return result.match(ComparisonPlanReady(_));
+    }
+
+    static function clsOf(path:String):ClassType {
+        return switch (Context.getType(path)) {
+            case TInst(reference, _): reference.get();
+            case other: throw "unexpected " + path;
+        }
+    }
+
+    static function refOf(path:String):Ref<ClassType> {
+        return switch (Context.getType(path)) {
+            case TInst(reference, _): reference;
+            case other: throw "unexpected " + path;
+        }
+    }
+
+    static function instRefOf(t:Type):Ref<ClassType> {
+        return switch (t) {
+            case TInst(reference, _): reference;
+            case other: throw "unexpected " + Std.string(other);
+        }
+    }
+}
+#end
