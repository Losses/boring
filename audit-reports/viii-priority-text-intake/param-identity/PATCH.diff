diff --git a/out/rev-param-identity/compiled/probe/BuildProbe.hx b/out/rev-param-identity/compiled/probe/BuildProbe.hx
new file mode 100644
--- a/out/rev-param-identity/compiled/probe/BuildProbe.hx	2026-09-22 21:36:18.530607732 -0400
+++ b/out/rev-param-identity/compiled/probe/BuildProbe.hx
@@ -0,0 +1,138 @@
+import haxe.macro.Context;
+import haxe.macro.Expr.Field;
+import haxe.macro.Type;
+import haxe.macro.TypeTools;
+import SourceComparisonAnalysis;
+
+/** Runs via @:build while revp3.Trigger compiles: Point/Pair/Generic/Boxed
+    are COMPILED at this point. Measures Ref/ClassType/parameter stability
+    and whether sameTypeParameter's fresh-Ref false branch still fires on
+    the public analyzeRecord path for compiled classes. */
+class BuildProbe {
+    static var once = false;
+
+    static var calls = 0;
+
+    macro public static function run():Array<Field> {
+        final fields = Context.getBuildFields();
+        final localRef = Context.getLocalClass();
+        if (localRef == null)
+            return fields;
+        final local = localRef.get();
+        calls++;
+        if (local.name == "Trigger" || local.module == "revp3" || local.name == "ProbeMain")
+            Sys.println("[dbg] build call " + calls + " module=" + local.module + " pack=" + Std.string(local.pack) + " name=" + local.name);
+        if (local.name != "Trigger" || local.pack.length != 1 || local.pack[0] != "revp3")
+            return fields;
+        if (once)
+            return fields;
+        once = true;
+        Sys.println("== P1. compiled-class Ref/ClassType stability (Point) ==");
+        final pointRef1 = SourceComparisonAnalysis.declarationReference(clsOf("revp3.Point"));
+        final pointRef2 = SourceComparisonAnalysis.declarationReference(clsOf("revp3.Point"));
+        Sys.println("ref1 == ref2 (pointer)        : " + (pointRef1 == pointRef2));
+        Sys.println("ref1.get() == ref2.get() (cls): " + (pointRef1.get() == pointRef2.get()));
+
+        Sys.println("");
+        Sys.println("== P2. compiled Generic parameter stability ==");
+        final gRef1 = SourceComparisonAnalysis.declarationReference(clsOf("revp3.Generic"));
+        final gRef2 = SourceComparisonAnalysis.declarationReference(clsOf("revp3.Generic"));
+        final tG1 = gRef1.get().params[0].t;
+        final tG2 = gRef2.get().params[0].t;
+        Sys.println("gRef1 == gRef2 (pointer)      : " + (gRef1 == gRef2));
+        Sys.println("gRef1.get() == gRef2.get()    : " + (gRef1.get() == gRef2.get()));
+        Sys.println("tG1 == tG2 (object)           : " + (tG1 == tG2));
+        Sys.println("ref(tG1) == ref(tG2) (Ref)    : " + (instRefOf(tG1) == instRefOf(tG2)));
+
+        Sys.println("");
+        Sys.println("== P3. field type vs params[0].t within one compiled ClassType ==");
+        var valueFieldType:Null<Type> = null;
+        for (f in gRef1.get().fields.get())
+            if (f.name == "value") valueFieldType = f.type;
+        Sys.println("value field type == tG1 (object) : " + (valueFieldType == tG1));
+        if (valueFieldType != null) {
+            Sys.println("ref(value field) == ref(tG1)      : " + (instRefOf(valueFieldType) == instRefOf(tG1)));
+            final subbed = TypeTools.applyTypeParameters(valueFieldType, gRef1.get().params, [tG1]);
+            Sys.println("applyTypeParameters(T, [tG1]) == tG1 (object) : " + (subbed == tG1));
+            Sys.println("ref(subbed) == ref(tG1)                    : " + (instRefOf(subbed) == instRefOf(tG1)));
+        }
+
+        Sys.println("");
+        Sys.println("== P4. Boxed: nested Pair dedup within one Builder (compiled) ==");
+        final boxedRef = SourceComparisonAnalysis.declarationReference(clsOf("revp3.Boxed"));
+        final tB = boxedRef.get().params[0].t;
+        final nodeBoxed = SourceComparisonAnalysis.analyzeRecord(boxedRef, [tB]);
+        var childNode:Null<SourceRecordNode> = null;
+        var pairNode:Null<SourceRecordNode> = null;
+        for (f in nodeBoxed.fields) {
+            Sys.println("field " + f.field.name + " shape=" + Std.string(f.shape).substr(0, 60));
+            final nested = nestedNode(f.shape);
+            if (f.field.name == "child") childNode = nested;
+            if (f.field.name == "pair") pairNode = nested;
+        }
+        Sys.println("nested Pair nodes same (dedup ok)   : " + (childNode != null && childNode == pairNode));
+        if (childNode != null && pairNode != null) {
+            Sys.println("childNode state=" + childNode.state + " fields=" + childNode.fields.length);
+            Sys.println("pairNode  state=" + pairNode.state + " fields=" + pairNode.fields.length);
+        }
+
+        Sys.println("");
+        Sys.println("== P5. Boxed with maxRecordNodes=2 (public limit) ==");
+        final nodeLimited = SourceComparisonAnalysis.analyzeRecord(boxedRef, [tB], 2);
+        switch (SourceComparisonAnalysis.comparisonPlan(nodeLimited, OptionalEqualityCapability)) {
+            case ComparisonPlanReady(_):
+                Sys.println("plan(limited): READY");
+            case ComparisonPlanFailed(path, reason, _):
+                Sys.println("plan(limited): FAILED at " + path + " : " + reason);
+            case ComparisonPlanUnresolved(path, reason):
+                Sys.println("plan(limited): UNRESOLVED at " + path + " : " + reason);
+        }
+        for (f in nodeLimited.fields) {
+            final nested = nestedNode(f.shape);
+            if (nested != null)
+                Sys.println("field " + f.field.name + " nested state=" + nested.state);
+        }
+
+        Sys.println("");
+        Sys.println("== P6. control: Boxed with concrete Int argument (no parameter branch) ==");
+        final nodeConcrete = SourceComparisonAnalysis.analyzeRecord(boxedRef, [Context.getType("Int")]);
+        var cChild:Null<SourceRecordNode> = null;
+        var cPair:Null<SourceRecordNode> = null;
+        for (f in nodeConcrete.fields) {
+            final nested = nestedNode(f.shape);
+            if (f.field.name == "child") cChild = nested;
+            if (f.field.name == "pair") cPair = nested;
+        }
+        Sys.println("concrete: nested Pair nodes same (dedup) : " + (cChild != null && cPair == cChild));
+        switch (SourceComparisonAnalysis.comparisonPlan(nodeConcrete, OptionalEqualityCapability)) {
+            case ComparisonPlanReady(plan):
+                Sys.println("concrete plan READY, fields: " + [for (f in plan.fields) f.field.name].join(","));
+            case other:
+                Sys.println("concrete plan NOT ready: " + Std.string(other).substr(0, 140));
+        }
+        return fields;
+    }
+
+    static function nestedNode(shape:SourceComparisonShape):Null<SourceRecordNode> {
+        return switch (shape) {
+            case NullableShape(inner): nestedNode(inner);
+            case RecordShape(n): n;
+            case RecordUseShape(n, _): n;
+            case _: null;
+        }
+    }
+
+    static function clsOf(path:String):ClassType {
+        return switch (Context.getType(path)) {
+            case TInst(reference, _): reference.get();
+            case other: throw "unexpected " + path;
+        }
+    }
+
+    static function instRefOf(t:Type):Ref<ClassType> {
+        return switch (t) {
+            case TInst(reference, _): reference;
+            case other: throw "unexpected " + Std.string(other);
+        }
+    }
+}
