diff --git a/tests/haxe/dc-fs-missing/fsprobe/FsProbe.hx b/tests/haxe/dc-fs-missing/fsprobe/FsProbe.hx
new file mode 100644
index 0000000..b24cf91
--- /dev/null
+++ b/tests/haxe/dc-fs-missing/fsprobe/FsProbe.hx
@@ -0,0 +1,125 @@
+package fsprobe;
+
+import std.Console;
+import std.Fs;
+
+#if dart_output
+// The Dart target gives `std.Console` no lowering; this fixture's recorder
+// branches on that target only (see ProbePrint.hx). It is a fixture
+// branch, not a production ruling, and the gap is recorded as an
+// observation in the runner's report rather than repaired here.
+#end
+
+/**
+	Read-only observation fixture for the host failure semantics of a
+	MISSING path through `std.Fs` (docs/specs/stdlib/17-platform-modules.md
+	"Failure behavior", docs/specs/stdlib/03-haxe-exception.md).
+
+	It implements no expectation and changes no compiler: it measures what
+	every target chain really does with one path that does not exist and
+	prints one deterministic line per observation, so the five target
+	outputs and the Haxe oracle can be compared byte for byte.
+
+	The recorder is `std.Console.log`, not `Sys.println`: `Sys` is a host
+	platform API the shared subset does not translate, and `std.Console` is
+	the platform module specification 17 rules for exactly this edge.
+
+	Every path this fixture touches is built from `missingRoot()` and never
+	resolves, so no stage reads or writes a file outside the invoking
+	working directory.
+
+	The observations, deliberately measured and never asserted here:
+
+	- `m1` is the boolean `Fs.isDirectory` produces for a missing path. A
+	  target that raises instead takes the whole arm, and the runner
+	  records the arm's own status; a `m1` line therefore proves a return
+	  and nothing but the returned boolean.
+	- `m3`/`m4`/`m5` record whether the catch block RUNS for `Fs.readText`
+	  on a missing path, the caught value's class name and its message.
+	- `m6`/`m7` record the same read with no catch clause at all, so a host
+	  failure escapes the entry if the host raises at all.
+
+	The catch clause names `FsProbeFault`, the message-only exception shape
+	features/06 rules for a text-only failure; nothing in the shared subset
+	lets generated code name the abstract `haxe.Exception` base itself, and
+	production raises through the same message-only shape.
+**/
+class FsProbe {
+	public static function missingRoot():String {
+		return "out/fs-missing/probe/definitely-missing";
+	}
+
+	/**
+		The fixture's line recorder. It never emits the file:line prefix
+		`trace` carries, so the same call prints the same bytes on every
+		target.
+	**/
+	public static function say(label:String, text:String):Void {
+		#if dart_output
+		ProbePrint.print(label + "|" + text);
+		#else
+		Console.log(label + "|" + text);
+		#end
+	}
+
+	/**
+		Message text of the exception a catch clause bound, or `<none>` when
+		the clause never ran. The parameter is the only type that makes the
+		region admissible (features/06 catch-type admissibility), so the read
+		goes through one `switch` on the value instead of a `== null` test:
+		the Rust target renders a message-only exception as a plain struct,
+		where `Null<T>` narrowing is not the shared-subset shape, and every
+		target then reads the field the same way.
+	**/
+	public static function messageOf(error:FsProbeFault):String {
+		return switch (error) {
+			case null: "<not-caught>";
+			case bound: bound.message;
+		}
+	}
+
+	public static function run():Void {
+		final missing = missingRoot() + "/no-such-file.txt";
+		say("m0", "probe-start");
+
+		// m1: the boolean isDirectory produces for a missing path.
+		final dir = Fs.isDirectory(missing);
+		say("m1", "isDirectory-returned|" + Std.string(dir));
+
+		// m2: does the catch run for readText on a missing path, and what
+		// did the host hand the clause?
+		var caught = false;
+		var name = "<not-caught>";
+		var message = "<not-caught>";
+		try {
+			final text = Fs.readText(missing);
+			say("m2", "readText-returned|" + text);
+		} catch (error:FsProbeFault) {
+			caught = true;
+			name = "haxe.Exception";
+			message = messageOf(error);
+		}
+		say("m3", "readText-catch-ran|" + Std.string(caught));
+		say("m4", "caught-declared-class|" + name);
+		say("m5", "caught-message|" + message);
+
+		// m6: the same call with no catch clause at all, so a host failure
+		// escapes the entry. The line after the call separates "returned"
+		// from "the process stopped here".
+		say("m6", "uncaught-region-start");
+		final escaped = Fs.readText(missing);
+		say("m7", "uncaught-region-returned|" + escaped);
+	}
+}
+
+/**
+	A message-only exception of this fixture (features/06 message-only
+	exception shape), deliberately separate from the shared
+	`samples/boring` types so the fixture adds no symbol to the production
+	root lists.
+**/
+class FsProbeFault extends haxe.Exception {
+	public function new(message:String) {
+		super(message);
+	}
+}
