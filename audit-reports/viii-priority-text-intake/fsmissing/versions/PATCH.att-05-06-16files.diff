+//! Native harness of the dc-fs-missing probe.
+//!
+//! It calls the generated `FsProbe::fs_probe_run` and prints nothing of its
+//! own: every observation line comes from the generated module, so a Rust
+//! process that dies inside an observation dies at the same point the
+//! other targets report, and its exit status is the observation's.
+//!
+//! The panic of `std.Fs.readText` on a missing path is *not* caught here.
+//! This harness adds no `catch_unwind`: whether the Rust failure model
+//! reaches the generated catch clause is exactly what the probe measures,
+//! and wrapping it would hide that. (docs/specs/stdlib/17-platform-modules.md
+//! "Failure behavior"; docs/specs/stdlib/03-haxe-exception.md)
+
+fn main() {
+    dc_fs_missing::fsprobe::fs_probe::FsProbe::fs_probe_run();
+}
