+package fsprobe;
+
+#if dart_output
+/**
+	Line writer for the Dart target.
+	`std.Console` has no Dart lowering in this tree: the generated import
+	lands on the empty stub the reference writer emits for a referenced
+	extern-only module, and no `console` object exists on the VM. Dart's
+	own `print` renders the text as written, which is the same rendering
+	the other four targets give `std.Console.log`.
+**/
+@:native("print")
+extern class ProbePrint {
+	static function print(text:String):Void;
+}
+#end
