diff --git a/tests/haxe/dc-fs-missing/native/oracle-shim.cjs b/tests/haxe/dc-fs-missing/native/oracle-shim.cjs
new file mode 100644
index 0000000..0cc02c6
--- /dev/null
+++ b/tests/haxe/dc-fs-missing/native/oracle-shim.cjs
@@ -0,0 +1,58 @@
+// Platform-module shim of the Haxe oracle.
+//
+// On the Haxe target `std.Fs` and `std.Env` are JS platform modules: the
+// compiled body reads `globalThis.std.Fs` with no null guard, and the
+// in-source test runner installs that object before the compiled body runs
+// (packages/compiler/TestCollector.hx, the `fsOracle`/`envOracle` records).
+// This file installs the same records with the same bodies, so the oracle
+// observes the same host edge the in-source test entry observes.
+//
+// The bodies are copied from packages/compiler/TestCollector.hx:
+//   readText:    try { nodeFs.readFileSync(p, "utf8") } catch (e) { throw new haxe.Exception(p + ": " + Std.string(e)) }
+//   isDirectory: try { nodeFs.statSync(p).isDirectory() } catch (e) { return false }
+//
+// They are JS, not Haxe: the oracle class itself calls the production
+// `std.Fs` face, and this file only supplies the host object underneath it.
+const nodeFs = require("node:fs");
+
+function haxeException(message) {
+    const error = new Error(message);
+    error.name = "haxe.Exception";
+    return error;
+}
+
+globalThis.std = globalThis.std || {};
+globalThis.std.Fs = {
+    exists: (p) => nodeFs.existsSync(p),
+    readText: (p) => {
+        try { return nodeFs.readFileSync(p, "utf8"); }
+        catch (e) { throw haxeException(p + ": " + String(e)); }
+    },
+    writeText: (p, d) => {
+        try { nodeFs.writeFileSync(p, d, "utf8"); }
+        catch (e) { throw haxeException(p + ": " + String(e)); }
+    },
+    appendText: (p, d) => {
+        try { nodeFs.appendFileSync(p, d, "utf8"); }
+        catch (e) { throw haxeException(p + ": " + String(e)); }
+    },
+    makeDirs: (p) => {
+        try { nodeFs.mkdirSync(p, { recursive: true }); }
+        catch (e) { throw haxeException(p + ": " + String(e)); }
+    },
+    readDir: (p) => {
+        try { return nodeFs.readdirSync(p); }
+        catch (e) { throw haxeException(p + ": " + String(e)); }
+    },
+    isDirectory: (p) => {
+        try { return nodeFs.statSync(p).isDirectory(); }
+        catch (e) { return false; }
+    },
+};
+globalThis.std.Env = {
+    get: (k) => (process.env[k] === undefined ? null : String(process.env[k])),
+    set: (k, v) => { process.env[k] = v; },
+    remove: (k) => { delete process.env[k]; },
+};
+
+require(process.argv[2]);
diff --git a/tests/haxe/dc-fs-missing/run.sh b/tests/haxe/dc-fs-missing/run.sh
new file mode 100644
index 0000000..ff65327
--- /dev/null
+++ b/tests/haxe/dc-fs-missing/run.sh
@@ -0,0 +1,319 @@
+#!/usr/bin/env bash
+# Observation runner for the dc-fs-missing probe.
+#
+# One invocation allocates one fresh attempt directory under
+# dc-warn/out/fsmissing/ and never rewrites it. Every stage records its
+# interpreter, working directory, shell-quoted argv, separated stdout and
+# stderr, and its numeric exit status; the inputs and outputs it produced
+# are hashed. A stage runs only when its producer exited zero in the same
+# attempt; every downstream stage of a failed producer gets an explicit
+# `not-reached` row naming that producer.
+#
+# Invoked as:
+#   XDG_CACHE_HOME=/tmp/fsmissing-nix-cache \
+#     nix develop --command bash tests/haxe/dc-fs-missing/run.sh
+# (the fuse mount drops the executable bit; always call via `bash`).
+set -uo pipefail
+
+HERE="$(cd "$(dirname "$0")" && pwd)"
+ROOT="$(cd "$HERE/../../.." && pwd)"
+WS="$(cd "$ROOT/../../.." && pwd)"
+EV_PARENT="$WS/dc-warn/out/fsmissing"
+if [ ! -f "$ROOT/boring.json" ]; then
+	printf 'boring.json absent at %s; wrong worktree\n' "$ROOT"
+	exit 1
+fi
+if [ "${IN_NIX_SHELL:-}" = "" ]; then
+	printf 'run through: nix develop --command bash tests/haxe/dc-fs-missing/run.sh\n'
+	exit 1
+fi
+
+ATTEMPT="${DC_FS_MISSING_ATTEMPT:-attempt-$(date -u +%Y%m%dT%H%M%SZ)}"
+RUN="$EV_PARENT/$ATTEMPT"
+if [ -e "$RUN" ]; then
+	printf 'attempt directory %s already exists; refusing to overwrite\n' "$RUN"
+	exit 1
+fi
+STAGES="$RUN/stages"
+mkdir -p "$RUN/stages" || exit 1
+# Executables and modules that cannot be started from the fuse mount are
+# staged on the local disk; every copy's digest is recorded in hashes.txt.
+EXEC_BASE="${DC_FS_MISSING_EXEC_DIR:-/tmp/fsmissing-exec}/$ATTEMPT"
+mkdir -p "$EXEC_BASE"
+RUST_EXEC_DIR="$EXEC_BASE/rust"
+TS_EXEC_DIR="$EXEC_BASE/ts"
+DART_EXEC_DIR="$EXEC_BASE/dart"
+
+TAB="$(printf '\t')"
+printf 'stage%sexpected%sobserved%sproducer%snote\n' "$TAB" "$TAB" "$TAB" "$TAB" >"$RUN/status.tsv"
+printf 'stage%srole%ssha256%spath\n' "$TAB" "$TAB" "$TAB" >"$RUN/hashes.txt"
+: >"$RUN/not-reached.txt"
+
+record() {
+	printf '%s%s%s%s%s%s%s%s%s\n' "$1" "$TAB" "$2" "$TAB" "$3" "$TAB" "$4" "$TAB" "$5" >>"$RUN/status.tsv"
+	printf 'stage %-28s exit=%-4s %s\n' "$1" "$3" "$5"
+}
+
+mark_unreached() {
+	local producer=$1 observed=$2 reason=$3
+	shift 3
+	local stage
+	for stage in "$@"; do
+		record "$stage" not-reached "producer-$producer-status-$observed" "$producer" "$reason"
+		printf '%s%s%s%s%s\n' "$stage" "$TAB" "$producer" "$TAB" "$observed" "$TAB" "$reason" >>"$RUN/not-reached.txt"
+	done
+}
+
+# stage <name> <expected> <command...>
+stage() {
+	local name=$1 expected=$2
+	shift 2
+	local dir="$STAGES/$name"
+	mkdir -p "$dir"
+	{
+		printf 'cwd %s\n' "$ROOT"
+		printf 'argv'
+		printf ' %q' "$@"
+		printf '\n'
+	} >"$dir/argv"
+	( cd "$ROOT" && "$@" ) >"$dir/stdout" 2>"$dir/stderr"
+	local st=$?
+	printf '%s\n' "$st" >"$dir/status"
+	record "$name" "$expected" "$st" "$name" ""
+	return "$st"
+}
+
+hash_file() {
+	local st=$1 role=$2 path=$3
+	local line
+	if ! line="$(sha256sum "$path" 2>&1)"; then
+		printf '%s %s %s hash-failed: %s\n' "$st" "$role" "$path" "$line" >>"$RUN/hashes.txt"
+		return 1
+	fi
+	printf '%s%s%s%s%s%s%s\n' "$st" "$TAB" "$role" "$TAB" "${line%% *}" "$TAB" "$path" >>"$RUN/hashes.txt"
+}
+
+# --- identity and inputs (before)
+{
+	printf 'attempt %s\n' "$ATTEMPT"
+	printf 'date %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
+	printf 'worktree %s\n' "$ROOT"
+	git -C "$ROOT" rev-parse HEAD
+	git -C "$ROOT" status --porcelain
+	printf 'mode-note: tracked-file exec-bit loss on the fuse mount is a mount artifact; content is clean under git -c core.fileMode=false\n'
+	haxe --version
+	printf 'node %s\n' "$(node --version)"
+	printf 'bun %s\n' "$(bun --version)"
+	printf 'kotlinc %s\n' "$(kotlinc -version 2>&1 | head -1)"
+	printf 'dart %s\n' "$(dart --version 2>&1 | head -1)"
+	printf 'rustc %s\n' "$(rustc --version)"
+	printf 'swiftc %s\n' "$(swiftc --version 2>&1 | head -1)"
+} >"$RUN/identity.txt" 2>&1
+
+INPUTS=(
+	"$ROOT/packages/compiler/reflaxe/ts/tscompiler/TsExpr.hx"
+	"$ROOT/packages/compiler/reflaxe/kotlin/kotlincompiler/KotlinExpr.hx"
+	"$ROOT/packages/compiler/reflaxe/dart/dartcompiler/DartExpr.hx"
+	"$ROOT/packages/compiler/reflaxe/rust/rustcompiler/RustRuntime.hx"
+	"$ROOT/packages/compiler/reflaxe/swift/swiftcompiler/SwiftHostEdges.hx"
+	"$ROOT/packages/compiler/TestCollector.hx"
+	"$ROOT/packages/compiler/Intercept.hx"
+	"$ROOT/samples/std/Fs.hx"
+	"$ROOT/tests/haxe/dc-fs-missing/fsprobe/FsProbe.hx"
+	"$ROOT/tests/haxe/dc-fs-missing/fsprobe/ProbeMain.hx"
+	"$ROOT/tests/haxe/dc-fs-missing/run.sh"
+	"$ROOT/tests/haxe/dc-fs-missing/native/oracle.hxml"
+	"$ROOT/tests/haxe/dc-fs-missing/native/harness.rs"
+	"$ROOT/tests/haxe/dc-fs-missing/native/harness.ts"
+	"$ROOT/tests/haxe/dc-fs-missing/native/Harness.kt"
+	"$ROOT/tests/haxe/dc-fs-missing/native/harness.dart"
+	"$ROOT/tests/haxe/dc-fs-missing/native/Harness.swift"
+	"$ROOT/tests/haxe/dc-fs-missing/gen/ts.hxml"
+	"$ROOT/tests/haxe/dc-fs-missing/gen/kotlin.hxml"
+	"$ROOT/tests/haxe/dc-fs-missing/gen/dart.hxml"
+	"$ROOT/tests/haxe/dc-fs-missing/gen/rust.hxml"
+	"$ROOT/tests/haxe/dc-fs-missing/gen/swift.hxml"
+)
+sha256sum "${INPUTS[@]}" >"$RUN/input-hashes-before.txt" 2>"$RUN/input-hashes-before.err"
+
+# --- Haxe oracle
+if stage haxe-oracle-build zero haxe tests/haxe/dc-fs-missing/native/oracle.hxml -js "$RUN/oracle.js"; then
+	hash_file haxe-oracle-build output "$RUN/oracle.js"
+	# The oracle needs the platform-module shim the in-source test runner
+	# installs (packages/compiler/TestCollector.hx): on this target std.Fs is
+	# a JS platform module, so the compiled body reads globalThis.std.Fs.
+	cp "$HERE/native/oracle-shim.cjs" "$RUN/oracle-shim.cjs"
+	hash_file haxe-oracle-run input "$RUN/oracle-shim.cjs"
+	stage haxe-oracle-run program-failure bun "$RUN/oracle-shim.cjs" "$RUN/oracle.js"
+	hash_file haxe-oracle-run input "$RUN/oracle.js"
+else
+	mark_unreached haxe-oracle-build "$?" "oracle build failed" haxe-oracle-run
+fi
+
+# --- TypeScript target
+# node cannot execute a module that lives on the dc-warn fuse mount
+# ("Module not found"), so the generated tree is copied into /tmp and the
+# harness runs there; the copies and their digests are kept in the attempt.
+ts_case() {
+	local gen="$RUN/ts-gen" run="$RUN/ts-run"
+	if ! stage gen-ts zero haxe tests/haxe/dc-fs-missing/gen/ts.hxml -D ts-output="$gen"; then
+		mark_unreached gen-ts "$?" "ts generation failed" tsc-ts ts-copy run-ts
+		return
+	fi
+	hash_file gen-ts output "$gen/fsprobe/FsProbe.ts"
+	mkdir -p "$run"
+	cp -r "$gen/." "$run/" 2>/dev/null
+	cp "$HERE/native/harness.ts" "$run/harness.ts"
+	hash_file ts-copy input "$run/fsprobe/FsProbe.ts"
+	hash_file ts-copy input "$run/harness.ts"
+	# The generated tree imports ".ts" specifiers; bun runs them directly.
+	# bun and node both fail to load a module that lives on the dc-warn
+	# fuse mount, so the copied tree is placed on the local disk and run
+	# from there.
+	mkdir -p "$TS_EXEC_DIR"
+	cp -r "$run/." "$TS_EXEC_DIR/" 2>/dev/null
+	hash_file ts-copy output "$TS_EXEC_DIR/fsprobe/FsProbe.ts"
+	stage run-ts program-failure bun "$TS_EXEC_DIR/harness.ts"
+	hash_file run-ts input "$TS_EXEC_DIR/harness.ts"
+}
+ts_case
+
+# --- Kotlin target
+# Two steps, the recipe tools/bundle/Driver.hx uses: kotlinc compiles the
+# generated library first, then the harness against it. One single pass
+# over both trees does not typecheck (the generated test-host file imports
+# a runtime object the library pass emits).
+kotlin_case() {
+	local gen="$RUN/kotlin-gen" build="$RUN/kotlin-build"
+	if ! stage gen-kotlin zero haxe tests/haxe/dc-fs-missing/gen/kotlin.hxml -D kotlin-output="$gen"; then
+		mark_unreached gen-kotlin "$?" "kotlin generation failed" compile-kotlin compile-kotlin-harness run-kotlin
+		return
+	fi
+	hash_file gen-kotlin output "$gen/fsprobe/FsProbe.kt"
+	mkdir -p "$build"
+	# Two generated files are reference stubs for extern-only modules, not
+	# declarations: the probe's own `std.Console`-style stub is empty by
+	# construction, and the test host is not part of this harness. Both are
+	# excluded from the compile set instead of being repaired.
+	find "$gen" -name '*.kt' ! -path '*/runtime/test/*' >"$RUN/kotlin-lib-files.txt"
+	if ! stage compile-kotlin zero kotlinc -Xallow-kotlin-package @"$RUN/kotlin-lib-files.txt" -include-runtime -d "$build/library.jar"; then
+		mark_unreached compile-kotlin "$?" "kotlinc failed on the generated library" compile-kotlin-harness run-kotlin
+		return
+	fi
+	hash_file compile-kotlin input "$gen/fsprobe/FsProbe.kt"
+	hash_file compile-kotlin output "$build/library.jar"
+	if ! stage compile-kotlin-harness zero kotlinc -Xallow-kotlin-package -cp "$build/library.jar" "$HERE/native/Harness.kt" -d "$build/tests.jar"; then
+		mark_unreached compile-kotlin-harness "$?" "kotlinc failed on the harness" run-kotlin
+		return
+	fi
+	hash_file compile-kotlin-harness output "$build/tests.jar"
+	stage run-kotlin program-failure java -cp "$build/library.jar:$build/tests.jar" HarnessKt
+	hash_file run-kotlin input "$build/tests.jar"
+}
+kotlin_case
+
+# --- Dart target
+# dart cannot execute a script on the dc-warn fuse mount, so the generated
+# package is copied into /tmp and run there (JIT: the fuse mount also drops
+# the executable bit an AOT snapshot would need).
+dart_case() {
+	local gen="$RUN/dart-gen" run="$RUN/dart-run"
+	if ! stage gen-dart zero haxe tests/haxe/dc-fs-missing/gen/dart.hxml -D dart-output="$gen" -D dart-test-output="$RUN/dart-test-gen"; then
+		mark_unreached gen-dart "$?" "dart generation failed" dart-copy run-dart
+		return
+	fi
+	hash_file gen-dart output "$gen/lib/fsprobe/fs_probe.dart"
+	mkdir -p "$run/lib/fsprobe"
+	cp -r "$gen/." "$run/" 2>/dev/null
+	cp "$HERE/native/harness.dart" "$run/harness.dart"
+	{
+		printf 'name: dcfsmissing_probe\n'
+		printf 'environment:\n'
+		printf "  sdk: '>=3.0.0'\n"
+	} >"$run/pubspec.yaml"
+	hash_file dart-copy input "$run/lib/fsprobe/fs_probe.dart"
+	hash_file dart-copy input "$run/harness.dart"
+	# Like node, the Dart VM cannot read a script from the dc-warn fuse
+	# mount reliably, so the copied tree is placed on the local disk and
+	# run from there.
+	mkdir -p "$DART_EXEC_DIR"
+	cp -r "$run/." "$DART_EXEC_DIR/" 2>/dev/null
+	chmod -R u+rwX "$DART_EXEC_DIR"
+	hash_file dart-copy output "$DART_EXEC_DIR/lib/fsprobe/fs_probe.dart"
+	stage run-dart program-failure dart "$DART_EXEC_DIR/harness.dart"
+	hash_file run-dart input "$run/harness.dart"
+}
+dart_case
+
+# --- Rust target
+rust_case() {
+	local gen="$RUN/rust-gen" build="$RUN/rust-build"
+	if ! stage gen-rust zero haxe tests/haxe/dc-fs-missing/gen/rust.hxml -D rust-output="$gen"; then
+		mark_unreached gen-rust "$?" "rust generation failed" rustc-lib rustc-bin build-rust run-rust
+		return
+	fi
+	hash_file gen-rust output "$gen/fsprobe/fs_probe.rs"
+	mkdir -p "$build"
+	if ! stage rustc-lib zero rustc --crate-type lib --edition=2024 --crate-name dc_fs_missing -o "$build/libdc_fs_missing.rlib" "$gen/lib.rs"; then
+		mark_unreached rustc-lib "$?" "rustc failed on the generated crate" rustc-bin build-rust run-rust
+		return
+	fi
+	hash_file rustc-lib input "$gen/lib.rs"
+	hash_file rustc-lib output "$build/libdc_fs_missing.rlib"
+	if ! stage rustc-bin zero rustc --edition=2024 -o "$build/harness" "$HERE/native/harness.rs" --extern "dc_fs_missing=$build/libdc_fs_missing.rlib"; then
+		mark_unreached rustc-bin "$?" "rustc failed on the harness" run-rust
+		return
+	fi
+	hash_file rustc-bin output "$build/harness"
+	# The dc-warn fuse mount publishes no executable bit, so an ELF binary
+	# cannot be started from it (exit 126). The built binary is copied to
+	# the local disk with its digest recorded and run from there; the
+	# copy's status is the observation's status.
+	mkdir -p "$RUST_EXEC_DIR"
+	cp "$build/harness" "$RUST_EXEC_DIR/harness"
+	chmod +x "$RUST_EXEC_DIR/harness"
+	hash_file rustc-bin output "$RUST_EXEC_DIR/harness"
+	stage run-rust program-failure "$RUST_EXEC_DIR/harness"
+	hash_file run-rust input "$RUST_EXEC_DIR/harness"
+}
+rust_case
+
+# --- Swift target
+swift_case() {
+	local gen="$RUN/swift-gen" build="$RUN/swift-build"
+	if ! stage gen-swift zero haxe tests/haxe/dc-fs-missing/gen/swift.hxml -D swift-output="$gen"; then
+		mark_unreached gen-swift "$?" "swift generation failed" swiftc-lib swiftc-bin run-swift
+		return
+	fi
+	hash_file gen-swift output "$gen/fsprobe/FsProbe.swift"
+	mkdir -p "$build"
+	find "$gen" -name '*.swift' >"$RUN/swift-files.txt"
+	if ! stage swiftc-lib zero swiftc -emit-library -emit-module -swift-version 5 -module-name ProbeLib -o "$build/libProbeLib.so" @"$RUN/swift-files.txt"; then
+		mark_unreached swiftc-lib "$?" "swiftc failed on the generated tree" swiftc-bin run-swift
+		return
+	fi
+	hash_file swiftc-lib input "$gen/fsprobe/FsProbe.swift"
+	hash_file swiftc-lib output "$build/libProbeLib.so"
+	if ! stage swiftc-bin zero swiftc -swift-version 5 -I "$build" -L "$build" -lProbeLib "$HERE/native/Harness.swift" -o "$build/harness"; then
+		mark_unreached swiftc-bin "$?" "swiftc failed on the harness" run-swift
+		return
+	fi
+	hash_file swiftc-bin output "$build/harness"
+	stage run-swift program-failure env LD_LIBRARY_PATH="$build" "$build/harness"
+	hash_file run-swift input "$build/harness"
+}
+swift_case
+
+# --- inputs (after)
+if sha256sum "${INPUTS[@]}" >"$RUN/input-hashes-after.txt" 2>"$RUN/input-hashes-after.err"; then
+	if cmp -s "$RUN/input-hashes-before.txt" "$RUN/input-hashes-after.txt"; then
+		record input-hashes identical 0 "$RUN/input-hashes-after.txt" "no authored input changed during the attempt"
+	else
+		record input-hashes CHANGED 1 "$RUN/input-hashes-after.txt" "an authored input changed during the attempt"
+	fi
+else
+	record input-hashes hash-failed 1 "$RUN/input-hashes-after.txt" "the after-hash list failed"
+fi
+
+printf 'attempt directory: %s\n' "$RUN"
+exit 0
