package boring;

class MathNaNOps {
    public static function minOf(a:Float, b:Float):Float
        return Math.min(a, b);

    public static function maxOf(a:Float, b:Float):Float
        return Math.max(a, b);

    public static function minInts(a:Int, b:Int):Float
        return Math.min(a, b);

    public static function maxInts(a:Int, b:Int):Float
        return Math.max(a, b);
}
