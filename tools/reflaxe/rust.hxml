# reflaxe Rust target generation
# Run from the repository root: haxe tools/reflaxe/rust.hxml
# Output lands in rust-gen/src via the rust-output define.
-lib reflaxe
-cp tools/reflaxe/rust/std-shadow
-cp tools/reflaxe/rust
-cp tools/haxe
-cp haxe/src
--macro Intercept.run(['haxe/src'], ['haxe/src/boring/BinaryReader.hx', 'haxe/src/boring/BinaryWriter.hx'])
--macro rustcompiler.Compiler.use()
-D rust-output=rust-gen/src
-D runtime-import=crate::runtime
-D runtime-emit=runtime
boring.BinaryReader
boring.BinaryWriter
boring.GlyphMetrics
std.ReadOnlyArray
boring.VectorCodec
boring.VectorError
boring.VectorException
boring.VectorSort
