# Generation target for Reflaxe Kotlin
-lib reflaxe
-cp tools/haxe
-cp haxe/src
-cp tools
--macro Intercept.run(['haxe/src'])
--macro reflaxe.kotlin.Compiler.use()
-D kotlin-out=kotlin/src
