# reflaxe Kotlin target generation
# Run from the repository root: haxe tools/reflaxe/kotlin.hxml
# Output lands in kotlin/gen via the kotlin-output define.
-lib reflaxe
-cp tools/reflaxe/kotlin/std-shadow
-cp tools/reflaxe/kotlin
-cp tools/haxe
-cp haxe/src
--macro Intercept.run(['haxe/src'], ['haxe/src/boring/BinaryReader.hx', 'haxe/src/boring/BinaryWriter.hx'])
--macro kotlincompiler.Compiler.use()
-D kotlin-output=kotlin/gen
-D runtime-import=boring.runtime
-D runtime-emit=runtime
boring.BinaryReader
boring.BinaryWriter
boring.GlyphMetrics
std.ReadOnlyArray
boring.VectorCodec
boring.VectorError
boring.VectorException
boring.VectorSort
