#!/usr/bin/env bash
# boring pre-commit hook: the documentation style check must pass.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
if ! command -v bun >/dev/null 2>&1; then
  echo "pre-commit: bun not found; run git inside 'nix develop' or install bun" >&2
  exit 1
fi
exec bun tools/doc-style/check.ts
