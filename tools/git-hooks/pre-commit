#!/usr/bin/env bash
# boring pre-commit hook: the documentation style check must not regress.
#
# check:docs has a standing whole-repo baseline red state (TCN-213, PIT-488):
# `bun tools/doc-style/check.ts` returns rc=1 with a known hit count on the
# current mainline.  That red is a property of the repository as a whole, not
# of any one commit, so the hook must not refuse a commit whose changes are
# unrelated to the measured hits.
#
# This hook is therefore a no-regression gate, following the same shape as
# tools/warning-gate/check.sh: a committed baseline number in
# tools/doc-style/baseline.txt records the current hit count, and only a
# commit that RAISES the count above the baseline is refused.  A count at or
# below the baseline passes, and the hook reports the standing red state
# truthfully so the developer sees that the baseline exists.
#
# A check that could not be measured is a failure, not a pass: if bun is
# absent or check.ts does not emit a numeric hit count, this hook refuses
# (the warning-gate "0 <= baseline holds vacuously" trap, PIT-366).
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

if ! command -v bun >/dev/null 2>&1; then
  echo "pre-commit: bun not found; run git inside 'nix develop' or install bun" >&2
  exit 1
fi

BASELINE_FILE="tools/doc-style/baseline.txt"
BASELINE=$(sed -n 's/^[[:space:]]*\([0-9][0-9]*\)[[:space:]]*$/\1/p' "$BASELINE_FILE" | tail -n 1)
if ! [[ "$BASELINE" =~ ^[0-9]+$ ]]; then
  echo "pre-commit: cannot read a numeric baseline from $BASELINE_FILE" >&2
  exit 1
fi

OUT="$(mktemp)"
trap 'rm -f "$OUT"' EXIT
set +e
bun tools/doc-style/check.ts >"$OUT" 2>&1
CHECK_RC=$?
set -e

HITS=$(sed -n 's/^hits: \([0-9][0-9]*\)\.$/\1/p' "$OUT" | tail -n 1)

# Print the check output first so the developer sees the hits.
cat "$OUT"

if [[ ! "$HITS" =~ ^[0-9]+$ ]]; then
  echo "pre-commit: check.ts did not report a numeric hit count (rc=$CHECK_RC); refusing" >&2
  exit 1
fi

if [ "$HITS" -gt "$BASELINE" ]; then
  echo "pre-commit: doc-style REGRESSED: $HITS hits > baseline $BASELINE (see $BASELINE_FILE)" >&2
  echo "pre-commit: this commit introduces new doc-style candidates; fix them or refresh" >&2
  echo "pre-commit: the baseline deliberately (never as a side effect of an unrelated commit)." >&2
  exit 1
fi

echo "pre-commit: doc-style baseline red unchanged: $HITS hits (baseline $BASELINE); not" >&2
echo "pre-commit: blocking this commit.  See $BASELINE_FILE for refresh policy." >&2
exit 0