#!/usr/bin/env bash
# boring pre-commit hook: the documentation style check must be clean.
#
# check.ts prints 'hits: N.' and exits 0 only when N is 0. The repository is
# at zero, so any commit that introduces a candidate is refused. This hook is
# zero-tolerance: a clean count is the only passing state.
#
# A check that could not be measured is a failure: if bun is absent or
# check.ts does not emit a numeric hit count, this hook refuses.
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

if ! command -v bun >/dev/null 2>&1; then
  echo "pre-commit: bun not found; run git inside 'nix develop' or install bun" >&2
  exit 1
fi

OUT="$(mktemp)"
trap 'rm -f "$OUT"' EXIT
set +e
bun tools/doc-style/check.ts >"$OUT" 2>&1
CHECK_RC=$?
set -e

HITS=$(sed -n 's/^hits: \([0-9][0-9]*\)\.$/\1/p' "$OUT" | tail -n 1)

# Print the check output first so the developer sees the hits.
cat "$OUT"

if [[ ! "$HITS" =~ ^[0-9]+$ ]]; then
  echo "pre-commit: check.ts did not report a numeric hit count (rc=$CHECK_RC); refusing" >&2
  exit 1
fi

if [ "$HITS" -ne 0 ] || [ "$CHECK_RC" -ne 0 ]; then
  echo "pre-commit: doc-style is not clean: $HITS hits (rc=$CHECK_RC)" >&2
  echo "pre-commit: this commit introduces doc-style candidates; fix them before committing" >&2
  exit 1
fi

exit 0
