-lib reflaxe
-lib boring
-cp packages/compiler/reflaxe/ts/std-shadow
-cp packages/compiler/reflaxe/ts
-cp samples
-cp samples/haxe
-cp packages/registry/src
-cp packages/driver/src
--macro Intercept.run(['samples', 'packages/registry/src', 'packages/driver/src'])
--macro tscompiler.Compiler.use()
-D ts-output=out/driver/ts/gen
-D runtime-import=./runtime
-D runtime-emit=.
-D package-shell=none
driver.Main
