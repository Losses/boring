-lib reflaxe
-lib boring
-cp packages/compiler/reflaxe/dart/std-shadow
-cp packages/compiler/reflaxe/dart
-cp samples
-cp samples/haxe
-cp packages/registry/src
-cp packages/driver/src
--macro Intercept.run(['samples', 'packages/registry/src', 'packages/driver/src'])
--macro dartcompiler.Compiler.use()
-D dart-output=out/driver/dart/gen
-D dart-test-output=out/driver/dart/gen-tests
-D runtime-import=@boring/runtime
-D runtime-emit=lib
driver.Main
