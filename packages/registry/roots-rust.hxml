# Registry tool Rust target (feature spec 26)
-lib reflaxe
-lib boring
-cp packages/compiler/reflaxe/rust/std-shadow
-cp packages/compiler/reflaxe/rust
-cp samples
-cp samples/haxe
-cp packages/registry/src
--macro Intercept.run(['samples', 'packages/registry/src'])
--macro haxe.macro.Compiler.keep('registry.Core')
--macro haxe.macro.Compiler.keep('registry.Json')
--macro haxe.macro.Compiler.keep('registry.Semver')
--macro rustcompiler.Compiler.use()
-D runtime-import=crate::runtime
-D runtime-emit=runtime
-D package-name=registry-tool
-D package-license=MIT
registry.Main
std.FsException
runtime.SortedTable
runtime.UString
