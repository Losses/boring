  "bundles": [
    {
      "id": "haxe",
      "target": "haxe",
      "sourceSet": "haxe",
      "haxeArgs": [
        "-lib",
        "reflaxe",
        "-cp",
        "packages/compiler",
        "-cp",
        "tests/haxe",
        "-cp",
        "packages/test/build-stubs",
        "--macro",
        "haxe.macro.Compiler.addGlobalMetadata('boring', '@:build(std.RecordMember.build())')",
        "--macro",
        "TestCollector.generate('reference/haxe/gen-tests', ['samples/boring'])",
        "-main",
        "GenerateMain",
        "-js",
        "reference/haxe/gen/generate-main.js",
        "-D",
        "boring_oracle"
      ],
      "build": {
        "args": [
          "-lib",
          "reflaxe",
          "-cp",
          "packages/compiler",
          "--macro",
          "Intercept.run(['samples', 'packages/registry/src'])",
          "--macro",
          "haxe.macro.Compiler.addGlobalMetadata('boring', '@:build(std.RecordMember.build())')",
          "-D",
          "analyzer-optimize",
          "-D",
          "boring_oracle"
        ]
      }
    },
    {
      "id": "ts",
      "target": "ts",
      "sourceSet": "ts",
      "haxeArgs": [
        "-lib",
        "reflaxe",
        "-lib",
        "boring",
        "-cp",
        "packages/compiler/reflaxe/ts/std-shadow",
        "-cp",
        "packages/compiler/reflaxe/ts",
        "-cp",
        "samples/haxe",
        "--macro",
        "Intercept.run(['samples', 'packages/registry/src', 'packages/driver/src'])",
        "--macro",
        "haxe.macro.Compiler.keep('registry.Core')",
        "--macro",
        "haxe.macro.Compiler.keep('registry.Json')",
        "--macro",
        "haxe.macro.Compiler.keep('registry.Semver')",
        "--macro",
        "haxe.macro.Compiler.addGlobalMetadata('boring', '@:build(std.RecordMember.build())')",
        "--macro",
        "tscompiler.Compiler.use()",
        "-D",
        "runtime-import=./runtime",
        "-D",
        "runtime-emit=.",
        "-D",
        "package-shell=none"
      ],
      "package": {"name": "boring-codec", "version": "0.1.0", "license": "MIT"}
