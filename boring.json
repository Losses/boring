// boring's own bundle project (feature spec 59). The driver derives every
// output directory (<outRoot>/<id>/gen and <outRoot>/<id>/gen-tests) and
// every results path (<resultsDir>/<id>.jsonl) from this file; none of
// them is named here.
{
  "outRoot": "reference",
  "resultsDir": "out/test-results",
  "baseline": "kotlin",
  "sourceRoots": ["samples", "packages/registry/src"],
  "bundles": [
    {
      "id": "haxe",
      "target": "haxe",
      "rootsFile": "tests/haxe/generate-main.hxml",
      "build": {
        "args": [
          "-lib", "reflaxe",
          "-cp", "packages/compiler",
          "--macro", "Intercept.run(['samples', 'packages/registry/src'])",
          "--macro", "haxe.macro.Compiler.addGlobalMetadata('boring', '@:build(std.RecordMember.build())')",
          "-D", "analyzer-optimize",
          "-D", "boring_oracle"
        ]
      }
    },
    {
      "id": "ts",
      "target": "ts",
      "rootsFile": "examples/ts.hxml",
      "package": { "name": "boring-codec", "version": "0.1.0" }
    },
    {
      "id": "kotlin",
      "target": "kotlin",
      "rootsFile": "examples/kotlin.hxml",
      "build": {
        "args": ["-Xallow-kotlin-package"]
      },
      "package": { "name": "boring-codec", "version": "0.1.0" }
    },
    {
      "id": "dart",
      "target": "dart",
      "rootsFile": "examples/dart.hxml"
    },
    {
      "id": "rust",
      "target": "rust",
      "rootsFile": "examples/rust.hxml"
    },
    {
      "id": "swift",
      "target": "swift",
      "rootsFile": "examples/swift.hxml",
      "build": {
        "args": ["-swift-version", "5"]
      }
    }
  ]
}
