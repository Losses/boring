// boring's own Haxe build and test project (feature spec 59).
{
  "outRoot": "reference",
  "resultsDir": "out/test-results",
  "baseline": "kotlin",
  "sourceRoots": [
    "samples",
    "packages/registry/src",
    "packages/driver/src"
  ],
  "bundles": [
    {
      "id": "haxe",
      "target": "haxe",
      "rootsFile": "tests/haxe/generate-main.hxml",
      "build": {
        "args": [
          "-lib",
          "reflaxe",
          "-cp",
          "packages/compiler",
          "--macro",
          "Intercept.run(['samples', 'packages/registry/src'])",
          "--macro",
          "haxe.macro.Compiler.addGlobalMetadata('boring', '@:build(std.RecordMember.build())')",
          "-D",
          "analyzer-optimize",
          "-D",
          "boring_oracle"
        ]
      }
    },
    {
      "id": "ts",
      "target": "ts",
      "rootsFile": "examples/ts.hxml",
      "package": {
        "name": "boring-codec",
        "version": "0.1.0",
        "license": "MIT"
      }
    },
    {
      "id": "kotlin",
      "target": "kotlin",
      "rootsFile": "examples/kotlin.hxml",
      "build": {
        "args": [
          "-Xallow-kotlin-package"
        ]
      },
      "package": {
        "name": "boring-codec",
        "version": "0.1.0",
        "license": "MIT"
      }
    },
    {
      "id": "dart",
      "target": "dart",
      "rootsFile": "examples/dart.hxml"
    },
    {
      "id": "rust",
      "target": "rust",
      "rootsFile": "examples/rust.hxml"
    },
    {
      "id": "swift",
      "target": "swift",
      "rootsFile": "examples/swift.hxml",
      "haxeArgs": [
        "-D",
        "swift-test-import=Codec"
      ],
      "build": {
        "args": [
          "-swift-version",
          "5"
        ]
      }
    },
    {
      "id": "haxe-f32",
      "target": "haxe",
      "precision": "f32",
      "compare": false,
      "rootsFile": "tests/haxe/generate-main-f32.hxml",
      "haxeArgs": [
        "-D",
        "haxe-test-main=TestMainF32"
      ],
      "build": {
        "args": [
          "-lib",
          "reflaxe",
          "-cp",
          "packages/compiler",
          "--macro",
          "Intercept.run(['samples', 'packages/registry/src'])",
          "--macro",
          "haxe.macro.Compiler.addGlobalMetadata('boring', '@:build(std.RecordMember.build())')",
          "-D",
          "analyzer-optimize",
          "-D",
          "boring_oracle",
          "-D",
          "float-precision=f32"
        ]
      }
    },
    {
      "id": "kotlin-f32",
      "target": "kotlin",
      "precision": "f32",
      "compare": false,
      "rootsFile": "examples/kotlin-f32.hxml",
      "build": {
        "args": [
          "-Xallow-kotlin-package"
        ]
      }
    },
    {
      "id": "rust-f32",
      "target": "rust",
      "precision": "f32",
      "compare": false,
      "rootsFile": "examples/rust-f32.hxml",
      // The crate selects its module float width through the generated
      // [features] table (packageManifest: default = [], f32 = []), so the
      // f32 tree only compiles as f32 when the feature reaches cargo. The
      // precision define names the tree; without this flag cargo builds the
      // f32 emission against TiqianFloat = f64, and tests/rust/vector_gen_f32.rs
      // fails with "expected f64, found f32" at its `index as f32` site.
      "build": {
        "args": [
          "--features",
          "f32"
        ]
      },
      "run": {
        "cargoArgs": [
          "--features",
          "f32"
        ]
      }
    },
    {
      "id": "swift-f32",
      "target": "swift",
      "precision": "f32",
      "compare": false,
      "rootsFile": "examples/swift-f32.hxml",
      "haxeArgs": [
        "-D",
        "swift-test-import=CodecF32"
      ],
      "build": {
        "args": [
          "-swift-version",
          "5"
        ]
      }
    },
    {
      "id": "registry-tool",
      "target": "rust",
      "rootsFile": "packages/registry/roots-rust.hxml",
      "test": false
    }
  ]
}
