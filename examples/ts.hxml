# reflaxe TypeScript target generation (docs/specs/features/14-type-system-mapping.md).
# Run from the repository root: haxe examples/ts.hxml
# The ts-output define writes output to reference/ts/gen.
-lib reflaxe
-lib boring
-cp packages/compiler/reflaxe/ts/std-shadow
-cp packages/compiler/reflaxe/ts
-cp samples
-cp samples/haxe
-cp packages/registry/src
--macro Intercept.run(['samples', 'packages/registry/src'])
--macro haxe.macro.Compiler.keep('registry.Core')
--macro haxe.macro.Compiler.keep('registry.Json')
--macro haxe.macro.Compiler.keep('registry.Semver')
--macro haxe.macro.Compiler.addGlobalMetadata('boring', '@:build(std.RecordMember.build())')
--macro tscompiler.Compiler.use()
-D ts-output=reference/ts/gen
-D ts-test-output=reference/ts/gen-tests
-D ts-test-runner=bun
-D runtime-import=@boring/runtime
-D runtime-emit=.
# The repository resolves the runtime by name through tsconfig.json
# paths, so the package shell stays off (feature spec 24).
-D package-shell=none
boring.BinaryReader
boring.BinaryWriter
boring.Int64Ops
boring.ValuePassingOps
boring.BytesOps
