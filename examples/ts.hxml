# reflaxe TypeScript target generation (docs/specs/targets/07-reflaxe-typescript-target.md).
# Run from the repository root: haxe examples/ts.hxml
# Output lands in reference/ts/gen via the ts-output define.
-lib reflaxe
-lib boring
-cp src/reflaxe/ts/std-shadow
-cp src/reflaxe/ts
-cp samples
--macro Intercept.run(['samples'], ['samples/boring/BinaryReader.hx', 'samples/boring/BinaryWriter.hx'])
--macro tscompiler.Compiler.use()
-D ts-output=reference/ts/gen
-D ts-test-output=reference/ts/gen-tests
-D ts-test-runner=bun
-D runtime-import=@boring/runtime
-D runtime-emit=.
boring.BinaryReader
boring.BinaryWriter
boring.GlyphMetrics
std.ReadOnlyArray
boring.VectorCodec
boring.VectorError
boring.VectorException
boring.VectorSort
boring.ScriptEvidenceTable
boring.WordCharacterTable
boring.CodePointNames
std.SortedMap
std.SortedSet
std.Functional
tests.TestData
tests.VectorCodecTests
tests.DataTableTests
tests.SortedTableTests
boring.ScriptNames
boring.ClusterTags
tests.SortedKeyDomainTests
boring.PipelineOps
tests.PipelineTests
boring.RecordOps
tests.RecordTests
boring.StringBufOps
tests.StringBufTests
boring.ArithmeticOps
tests.ArithmeticTests
boring.DefaultArgsOps
tests.DefaultArgsTests
boring.UStringOps
tests.UStringTests
