# reflaxe Kotlin target generation under the f32 precision switch
# (docs/specs/features/23-float-precision-switch.md).
# Run from the repository root: haxe examples/kotlin-f32.hxml
# The output goes to reference/kotlin-f32/gen and gen-tests.
-lib boring
-cp packages/compiler/reflaxe/kotlin/std-shadow
-cp packages/compiler/reflaxe/kotlin
-cp samples
-cp packages/registry/src
--macro Intercept.run(['samples', 'packages/registry/src'])
--macro haxe.macro.Compiler.keep('registry.Core')
--macro haxe.macro.Compiler.keep('registry.Json')
--macro haxe.macro.Compiler.keep('registry.Semver')

--macro haxe.macro.Compiler.addGlobalMetadata('boring', '@:build(std.RecordMember.build())')
--macro kotlincompiler.Compiler.use()
-D kotlin-output=reference/kotlin-f32/gen
-D kotlin-test-output=reference/kotlin-f32/gen-tests
-D runtime-import=boring.runtime
-D runtime-emit=runtime
-D float-precision=f32
boring.BinaryReader
boring.BinaryWriter
