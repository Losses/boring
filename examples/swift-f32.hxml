# reflaxe Swift target generation under the f32 precision switch
# (docs/specs/features/23-float-precision-switch.md).
# Run from the repository root: haxe examples/swift-f32.hxml
# Output lands in reference/swift-f32/gen and gen-tests.
-lib reflaxe
-lib boring
-cp src/reflaxe/swift/std-shadow
-cp src/reflaxe/swift
-cp samples
--macro Intercept.run(['samples'], ['samples/boring/BinaryReader.hx', 'samples/boring/BinaryWriter.hx', 'samples/boring/Fp32.hx'])
--macro haxe.macro.Compiler.addGlobalMetadata('boring', '@:build(std.RecordMember.build())')
--macro swiftcompiler.Compiler.use()
-D swift-output=reference/swift-f32/gen
-D swift-test-output=reference/swift-f32/gen-tests
-D swift-test-runner=native
-D runtime-import=@boring/runtime
-D runtime-emit=.
-D float-precision=f32
boring.BinaryReader
boring.BinaryWriter
boring.Fp32
boring.Fp16
boring.GlyphMetrics
std.ReadOnlyArray
boring.VectorCodec
boring.VectorError
boring.VectorException
boring.ValueError
boring.ValueException
boring.ValueRecord
boring.PrivateHolder
boring.VectorSort
boring.ScriptEvidenceTable
boring.WordCharacterTable
boring.PayloadTextTable
boring.CodePointNames
std.SortedMap
std.SortedSet
std.Functional
runtime.UString
runtime.GraphemeWalk
runtime.Graphemes
runtime.SortedTable
runtime.TestCore
