# reflaxe Swift target generation under the f32 precision switch
# (docs/specs/features/23-float-precision-switch.md).
# Run from the repository root: haxe examples/swift-f32.hxml
# The output goes to reference/swift-f32/gen and gen-tests.
-lib reflaxe
-lib boring
-cp packages/compiler/reflaxe/swift/std-shadow
-cp packages/compiler/reflaxe/swift
-cp samples
-cp packages/registry/src
--macro Intercept.run(['samples', 'packages/registry/src'])
--macro haxe.macro.Compiler.keep('registry.Core')
--macro haxe.macro.Compiler.keep('registry.Json')
--macro haxe.macro.Compiler.keep('registry.Semver')

--macro haxe.macro.Compiler.addGlobalMetadata('boring', '@:build(std.RecordMember.build())')
--macro swiftcompiler.Compiler.use()
-D swift-output=reference/swift-f32/gen
-D swift-test-output=reference/swift-f32/gen-tests
-D swift-test-runner=native
-D swift-test-import=CodecF32
-D runtime-import=@boring/runtime
-D runtime-emit=.
-D package-shell=none
-D float-precision=f32
boring.BinaryReader
boring.BinaryWriter
