# reflaxe Dart target generation (docs/specs/stdlib/06-std-modules.md).
# Run from the repository root: haxe examples/dart.hxml
# The dart-output define writes output to reference/dart/gen.
-lib reflaxe
-lib boring
-cp src/reflaxe/dart/std-shadow
-cp src/reflaxe/dart
-cp samples
--macro Intercept.run(['samples'])
--macro haxe.macro.Compiler.addGlobalMetadata('boring', '@:build(std.RecordMember.build())')
--macro dartcompiler.Compiler.use()
-D dart-output=reference/dart/gen
-D dart-test-output=reference/dart/gen-tests
-D dart-test-runner=native
-D runtime-import=@boring/runtime
-D runtime-emit=.
boring.BinaryReader
boring.BinaryWriter
boring.Int64Ops
boring.BytesOps
boring.Fp32
boring.Fp16
boring.GlyphMetrics
std.ReadOnlyArray
boring.VectorCodec
boring.VectorError
boring.VectorException
boring.ValueError
boring.ValueException
boring.ValueRecord
boring.PrivateHolder
boring.VectorSort
boring.ScriptEvidenceTable
boring.WordCharacterTable
boring.PayloadTextTable
boring.CodePointNames
std.SortedMap
std.SortedSet
std.Functional
runtime.UString
runtime.GraphemeWalk
runtime.Graphemes
runtime.SortedTable
runtime.TestCore
