# reflaxe Rust target generation
# Run from the repository root: haxe examples/rust.hxml
# Output lands in reference/rust-gen/src via the rust-output define.
-lib reflaxe
-lib boring
-cp src/reflaxe/rust/std-shadow
-cp src/reflaxe/rust
-cp samples
--macro Intercept.run(['samples'], ['samples/boring/BinaryReader.hx', 'samples/boring/BinaryWriter.hx'])
--macro rustcompiler.Compiler.use()
-D rust-output=reference/rust-gen/src
-D runtime-import=crate::runtime
-D runtime-emit=runtime
boring.BinaryReader
boring.BinaryWriter
boring.GlyphMetrics
std.ReadOnlyArray
boring.VectorCodec
boring.VectorError
boring.VectorException
boring.VectorSort
boring.ScriptEvidenceTable
boring.WordCharacterTable
boring.CodePointNames
std.SortedMap
std.SortedSet
std.Functional
runtime.UString
runtime.GraphemeWalk
runtime.Graphemes
tests.TestData
tests.VectorCodecTests
tests.DataTableTests
tests.SortedTableTests
boring.ScriptNames
boring.ClusterTags
tests.SortedKeyDomainTests
boring.PipelineOps
tests.PipelineTests
boring.RecordOps
tests.RecordTests
boring.StringBufOps
tests.StringBufTests
boring.ArithmeticOps
tests.ArithmeticTests
boring.DefaultArgsOps
tests.DefaultArgsTests
boring.UStringOps
boring.GraphemeOps
tests.UStringTests
tests.GraphemeTests
