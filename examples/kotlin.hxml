# reflaxe Kotlin target generation
# Run from the repository root: haxe examples/kotlin.hxml
# Output lands in reference/kotlin/gen via the kotlin-output define.
-lib reflaxe
-lib boring
-cp src/reflaxe/kotlin/std-shadow
-cp src/reflaxe/kotlin
-cp samples
--macro Intercept.run(['samples'], ['samples/boring/BinaryReader.hx', 'samples/boring/BinaryWriter.hx', 'samples/boring/Fp32.hx'])
--macro kotlincompiler.Compiler.use()
-D kotlin-output=reference/kotlin/gen
-D kotlin-test-output=reference/kotlin/gen-tests
-D runtime-import=boring.runtime
-D runtime-emit=runtime
boring.BinaryReader
boring.BinaryWriter
boring.Fp32
boring.Fp16
boring.GlyphMetrics
std.ReadOnlyArray
boring.VectorCodec
boring.VectorError
boring.VectorException
boring.ValueError
boring.ValueException
boring.ValueRecord
boring.PrivateHolder
boring.VectorSort
boring.ScriptEvidenceTable
boring.WordCharacterTable
boring.PayloadTextTable
boring.CodePointNames
std.SortedMap
std.SortedSet
std.Functional
runtime.UString
runtime.GraphemeWalk
runtime.Graphemes
runtime.SortedTable
runtime.TestCore
tests.TestData
tests.VectorCodecTests
tests.Fp32Tests
tests.Fp16Tests
tests.DataTableTests
tests.SortedTableTests
boring.ScriptNames
boring.ClusterTags
tests.SortedKeyDomainTests
boring.PipelineOps
tests.PipelineTests
boring.RecordOps
tests.RecordTests
tests.ValueRecordTests
tests.ValueRecordProbes
boring.StringBufOps
tests.StringBufTests
boring.TryOps
tests.TryTests
boring.ArithmeticOps
tests.ArithmeticTests
boring.DefaultArgsOps
tests.DefaultArgsTests
boring.UStringOps
boring.GraphemeOps
tests.UStringTests
tests.GraphemeTests
boring.PlainLabel
boring.ToStringOps
tests.ToStringTests
boring.EnumQueriesOps
tests.EnumQueriesTests
tests.EnumQueriesProbes
boring.StdStringOps
tests.StdStringTests
