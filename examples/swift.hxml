# reflaxe Swift target generation (docs/specs/features/07-numeric-tower.md).
# Run from the repository root: haxe examples/swift.hxml
# The swift-output define writes output to reference/swift/gen.
-lib reflaxe
-lib boring
-cp packages/compiler/reflaxe/swift/std-shadow
-cp packages/compiler/reflaxe/swift
-cp samples
-cp samples/haxe
-cp packages/registry/src
--macro Intercept.run(['samples', 'packages/registry/src'])
--macro haxe.macro.Compiler.keep('registry.Core')
--macro haxe.macro.Compiler.keep('registry.Json')
--macro haxe.macro.Compiler.keep('registry.Semver')
--macro haxe.macro.Compiler.addGlobalMetadata('boring', '@:build(std.RecordMember.build())')
--macro swiftcompiler.Compiler.use()
-D swift-output=reference/swift/gen
-D swift-test-output=reference/swift/gen-tests
-D swift-test-runner=native
-D swift-test-import=Codec
-D runtime-import=@boring/runtime
-D runtime-emit=.
-D package-shell=none
