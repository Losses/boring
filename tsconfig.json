{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "lib": ["ESNext"],
    "types": ["bun"],
    "baseUrl": ".",
    "paths": {
      "@boring/runtime": ["./reference/ts/gen/runtime.ts"]
    },
    "strict": true,
    "noImplicitAny": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": [
    "reference/ts/src",
    "reference/ts/gen",
    "reference/ts/gen-tests",
    "tests/ts",
    "tools",
    "eslint.config.ts"
  ]
}
