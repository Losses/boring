package tests

import boring.DotDrawKind
import boring.NoneDrawKind
import boring.SealedVariantOps
import boring.StripeDrawKind
import boring.runtime.test.Test

class SealedVariantTests {
@boring.test.Test
    fun testSingletonToString() {
        Test.run("tests.SealedVariantTests.testSingletonToString", "tests.SealedVariantTests.testSingletonToString: singleton variant prints its bare name") {
                Test.equals("NoneDrawKind", NoneDrawKind.instance.toString(), null)
                Test.equals("NoneDrawKind", NoneDrawKind.instance.toString(), null)
                Test.equals("NoneDrawKind", SealedVariantOps.noneLabel(), null)
        }
    }

@boring.test.Test
    fun testRecordToString() {
        Test.run("tests.SealedVariantTests.testRecordToString", "tests.SealedVariantTests.testRecordToString: record variants print fields in parameter order") {
                val stripe = StripeDrawKind(1.5, 0.5)
                val dot = DotDrawKind(2.25, 0.75)
                Test.equals("StripeDrawKind(strokeWidth=1.5, gapLength=0.5)", stripe.toString(), null)
                Test.equals("DotDrawKind(dotDiameter=2.25, gapLength=0.75)", dot.toString(), null)
        }
    }

@boring.test.Test
    fun testLabels() {
        Test.run("tests.SealedVariantTests.testLabels", "tests.SealedVariantTests.testLabels: variant labels distinguish all three classes") {
                Test.equals("none", SealedVariantOps.labelOf(NoneDrawKind.instance), null)
                Test.equals("stripe", SealedVariantOps.labelOf(StripeDrawKind(1.5, 0.5)), null)
                Test.equals("dot", SealedVariantOps.labelOf(DotDrawKind(2.25, 0.75)), null)
        }
    }

@boring.test.Test
    fun testTypeChecks() {
        Test.run("tests.SealedVariantTests.testTypeChecks", "tests.SealedVariantTests.testTypeChecks: variant type checks include the interface and reject siblings") {
                Test.equals(true, true, null)
                Test.equals(true, true, null)
                Test.equals(true, true, null)
                Test.equals(false, false, null)
                Test.equals(false, false, null)
                Test.equals(false, false, null)
        }
    }
}
