+++ b/tests/haxe/ts-sourcemap-three-positions/OriginShapes.hx
@@ -0,0 +1,31 @@
+package;
+
+/**
+	Focused fixture for TS diagnostic source-origin backtracking across three
+	statement positions that hold the *same* call shape:
+
+	  1. direct call statement        -> stmtLines `default:` branch (noteDirectCall IS invoked)
+	  2. local variable initializer   -> stmtLines TVar branch       (noteDirectCall NOT invoked)
+	  3. return expression            -> stmtLines TReturn branch    (noteDirectCall NOT invoked)
+
+	Each authored position renders onto exactly one generated TS line so the
+	tsc TS2345 coordinate can be compared against the origins sidecar spans.
+**/
+class OriginShapes {
+	public static function pick(value:String):String {
+		return value;
+	}
+
+	public static function run():String {
+		// Position 1: direct call statement (result discarded).
+		pick("direct");
+		// Position 2: TVar initializer.
+		final local = pick("init");
+		// Position 3: TReturn expression.
+		return pick("return") + local;
+	}
+
+	public static function main():Void {
+		run();
+	}
+}
diff --git a/tests/haxe/ts-sourcemap-three-positions/resolve-origins.mjs b/tests/haxe/ts-sourcemap-three-positions/resolve-origins.mjs
