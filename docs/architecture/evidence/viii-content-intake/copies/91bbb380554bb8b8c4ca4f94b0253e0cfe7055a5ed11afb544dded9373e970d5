package boring

object FloatArrayAnnoOps {
    fun sumOf(values: MutableList<Float>): Float {
        var total = 0.0f
        for (v in values) {
            total += v
        }
        return total
    }

    fun verify(): Boolean {
        val floats = mutableListOf<Float>(1.5f, 2.0f, 3.5f)
        return FloatArrayAnnoOps.sumOf(floats) == 7.0f
    }
}
