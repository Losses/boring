package tests

import boring.ExtensionConsumer
import boring.ExtensionMode
import boring.FileLevelConsumer
import boring.modeLabel
import boring.publicValue
import boring.runtime.test.Test
import boring.stringLabel

class StaticExtensionTests {
@boring.test.Test
    fun testTopLevelResults() {
        Test.run("tests.StaticExtensionTests.testTopLevelResults", "tests.StaticExtensionTests.testTopLevelResults: top-level functions cross module boundaries") {
                Test.equals(17, FileLevelConsumer.publicResult(), null)
                Test.equals(23, FileLevelConsumer.privateResultThroughPublic(), null)
                Test.equals(17, publicValue(7), null)
        }
    }

@boring.test.Test
    fun testOwnedExtension() {
        Test.run("tests.StaticExtensionTests.testOwnedExtension", "tests.StaticExtensionTests.testOwnedExtension: owned extension renders and evaluates as a receiver method") {
                Test.equals("hot!", ExtensionConsumer.enumResult(), null)
                Test.equals("private-cold", ExtensionConsumer.privateResult(), null)
                Test.equals("cold?", ExtensionMode.Cold.modeLabel("?"), null)
        }
    }

@boring.test.Test
    fun testStringExtension() {
        Test.run("tests.StaticExtensionTests.testStringExtension", "tests.StaticExtensionTests.testStringExtension: foreign string extension keeps its receiver argument") {
                Test.equals("@core", ExtensionConsumer.stringResult(), null)
                Test.equals("#text", "text".stringLabel("#"), null)
        }
    }
}
