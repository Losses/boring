package tests

import boring.SwitchMergeOps
import boring.SwitchMergeValue
import boring.runtime.test.Test

class SwitchMergeTests {
@boring.test.Test
    fun grouped() {
        Test.run("tests.SwitchMergeTests.grouped", "tests.SwitchMergeTests.grouped: grouped variant arms preserve both constructors") {
                Test.equals("grouped:3", SwitchMergeOps.grouped(SwitchMergeValue.First(3)), null)
                Test.equals("grouped:4", SwitchMergeOps.grouped(SwitchMergeValue.Second(4)), null)
                Test.equals("third", SwitchMergeOps.grouped(SwitchMergeValue.Third), null)
        }
    }

@boring.test.Test
    fun single() {
        Test.run("tests.SwitchMergeTests.single", "tests.SwitchMergeTests.single: single variant arms remain distinct") {
                Test.equals("first:1", SwitchMergeOps.single(SwitchMergeValue.First(1)), null)
                Test.equals("second:2", SwitchMergeOps.single(SwitchMergeValue.Second(2)), null)
        }
    }

@boring.test.Test
    fun groupedPlainMatches() {
        Test.run("tests.SwitchMergeTests.groupedPlainMatches", "tests.SwitchMergeTests.groupedPlainMatches: grouped plain arms match without payload bindings") {
                Test.equals("plain", SwitchMergeOps.groupedPlain(SwitchMergeValue.First(1)), null)
                Test.equals("plain", SwitchMergeOps.groupedPlain(SwitchMergeValue.Second(2)), null)
                Test.equals("third", SwitchMergeOps.groupedPlain(SwitchMergeValue.Third), null)
        }
    }
}
