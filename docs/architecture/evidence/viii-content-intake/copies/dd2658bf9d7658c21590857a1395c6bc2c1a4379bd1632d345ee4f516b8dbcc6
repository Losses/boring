package boring

data class ValueRecord(val start: Int, val end: Int, val label: String) {
    init {
    if ((start > end)) {
        throw ValueException.StartAfterEnd
    }
    if ((start < 0)) {
        throw ValueException.NegativeStart
    }
    }
    val length: Int get() = get_length()

    fun get_length(): Int {
        return this.end - this.start
    }
}

fun compareValueRecord(a: ValueRecord, b: ValueRecord): Int {
    var cmp = 0
    cmp = a.start.compareTo(b.start)
    if (cmp != 0) return cmp
    cmp = a.end.compareTo(b.end)
    if (cmp != 0) return cmp
    cmp = a.label.compareTo(b.label)
    if (cmp != 0) return cmp
    return 0
}
