#![cfg(test)]

use crate::boring::arithmetic_ops::ArithmeticOps;
use crate::runtime::test as testlib;
use crate::runtime::test_core;
use crate::runtime::u_string::UStr;


#[test]
fn test_within_int() {
    testlib::run("tests.ArithmeticTests.testWithinInt", "tests.ArithmeticTests.testWithinInt: within checks integer range inclusion", || {
        test_core::TestCore::test_core_equals_bool(true, ArithmeticOps::arithmetic_ops_check_within_int(5, 1, 10), UStr::new(&[]));
        test_core::TestCore::test_core_equals_bool(true, ArithmeticOps::arithmetic_ops_check_within_int(1, 1, 10), UStr::new(&[]));
        test_core::TestCore::test_core_equals_bool(true, ArithmeticOps::arithmetic_ops_check_within_int(10, 1, 10), UStr::new(&[]));
        test_core::TestCore::test_core_equals_bool(false, ArithmeticOps::arithmetic_ops_check_within_int(0, 1, 10), UStr::new(&[]));
        test_core::TestCore::test_core_equals_bool(false, ArithmeticOps::arithmetic_ops_check_within_int(11, 1, 10), UStr::new(&[]));
    });
}

#[test]
fn test_within_float() {
    testlib::run("tests.ArithmeticTests.testWithinFloat", "tests.ArithmeticTests.testWithinFloat: within checks float range inclusion", || {
        test_core::TestCore::test_core_equals_bool(true, ArithmeticOps::arithmetic_ops_check_within_float(5.5f64, 1.0f64, 10.0f64), UStr::new(&[]));
        test_core::TestCore::test_core_equals_bool(true, ArithmeticOps::arithmetic_ops_check_within_float(1.0f64, 1.0f64, 10.0f64), UStr::new(&[]));
        test_core::TestCore::test_core_equals_bool(true, ArithmeticOps::arithmetic_ops_check_within_float(10.0f64, 1.0f64, 10.0f64), UStr::new(&[]));
        test_core::TestCore::test_core_equals_bool(false, ArithmeticOps::arithmetic_ops_check_within_float(0.9f64, 1.0f64, 10.0f64), UStr::new(&[]));
        test_core::TestCore::test_core_equals_bool(false, ArithmeticOps::arithmetic_ops_check_within_float(10.1f64, 1.0f64, 10.0f64), UStr::new(&[]));
    });
}

#[test]
fn test_coerce_at_least() {
    testlib::run("tests.ArithmeticTests.testCoerceAtLeast", "tests.ArithmeticTests.testCoerceAtLeast: coerceAtLeast clamps values to floor", || {
        test_core::TestCore::test_core_equals_int(5i32, i32::from_ne_bytes(((ArithmeticOps::arithmetic_ops_clamp_least_int(3, 5)) as i32).to_ne_bytes()), UStr::new(&[]));
        test_core::TestCore::test_core_equals_int(8i32, i32::from_ne_bytes(((ArithmeticOps::arithmetic_ops_clamp_least_int(8, 5)) as i32).to_ne_bytes()), UStr::new(&[]));
        test_core::TestCore::test_core_equals_float(5.0f64, ArithmeticOps::arithmetic_ops_clamp_least_float(3.2f64, 5.0f64), UStr::new(&[]));
        test_core::TestCore::test_core_equals_float(8.4f64, ArithmeticOps::arithmetic_ops_clamp_least_float(8.4f64, 5.0f64), UStr::new(&[]));
    });
}

#[test]
fn test_coerce_at_most() {
    testlib::run("tests.ArithmeticTests.testCoerceAtMost", "tests.ArithmeticTests.testCoerceAtMost: coerceAtMost clamps values to ceiling", || {
        test_core::TestCore::test_core_equals_int(5i32, i32::from_ne_bytes(((ArithmeticOps::arithmetic_ops_clamp_most_int(8, 5)) as i32).to_ne_bytes()), UStr::new(&[]));
        test_core::TestCore::test_core_equals_int(3i32, i32::from_ne_bytes(((ArithmeticOps::arithmetic_ops_clamp_most_int(3, 5)) as i32).to_ne_bytes()), UStr::new(&[]));
        test_core::TestCore::test_core_equals_float(5.0f64, ArithmeticOps::arithmetic_ops_clamp_most_float(8.2f64, 5.0f64), UStr::new(&[]));
        test_core::TestCore::test_core_equals_float(3.4f64, ArithmeticOps::arithmetic_ops_clamp_most_float(3.4f64, 5.0f64), UStr::new(&[]));
    });
}

#[test]
fn test_coerce_in() {
    testlib::run("tests.ArithmeticTests.testCoerceIn", "tests.ArithmeticTests.testCoerceIn: coerceIn clamps values to range", || {
        test_core::TestCore::test_core_equals_int(10i32, i32::from_ne_bytes(((ArithmeticOps::arithmetic_ops_clamp_in_int(5, 10, 20)) as i32).to_ne_bytes()), UStr::new(&[]));
        test_core::TestCore::test_core_equals_int(15i32, i32::from_ne_bytes(((ArithmeticOps::arithmetic_ops_clamp_in_int(15, 10, 20)) as i32).to_ne_bytes()), UStr::new(&[]));
        test_core::TestCore::test_core_equals_int(20i32, i32::from_ne_bytes(((ArithmeticOps::arithmetic_ops_clamp_in_int(25, 10, 20)) as i32).to_ne_bytes()), UStr::new(&[]));
        test_core::TestCore::test_core_equals_float(10.0f64, ArithmeticOps::arithmetic_ops_clamp_in_float(5.5f64, 10.0f64, 20.0f64), UStr::new(&[]));
        test_core::TestCore::test_core_equals_float(15.5f64, ArithmeticOps::arithmetic_ops_clamp_in_float(15.5f64, 10.0f64, 20.0f64), UStr::new(&[]));
        test_core::TestCore::test_core_equals_float(20.0f64, ArithmeticOps::arithmetic_ops_clamp_in_float(25.5f64, 10.0f64, 20.0f64), UStr::new(&[]));
    });
}

#[test]
fn test_int_range() {
    testlib::run("tests.ArithmeticTests.testIntRange", "tests.ArithmeticTests.testIntRange: IntRange contains evaluates bounds", || {
        test_core::TestCore::test_core_equals_bool(true, ArithmeticOps::arithmetic_ops_in_range(10, 20, 10), UStr::new(&[]));
        test_core::TestCore::test_core_equals_bool(true, ArithmeticOps::arithmetic_ops_in_range(10, 20, 15), UStr::new(&[]));
        test_core::TestCore::test_core_equals_bool(true, ArithmeticOps::arithmetic_ops_in_range(10, 20, 20), UStr::new(&[]));
        test_core::TestCore::test_core_equals_bool(false, ArithmeticOps::arithmetic_ops_in_range(10, 20, 9), UStr::new(&[]));
        test_core::TestCore::test_core_equals_bool(false, ArithmeticOps::arithmetic_ops_in_range(10, 20, 21), UStr::new(&[]));
    });
}
