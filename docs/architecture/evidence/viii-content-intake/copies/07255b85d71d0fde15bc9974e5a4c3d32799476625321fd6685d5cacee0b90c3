#![cfg(test)]

use crate::boring::nullable_array_argument_ops::NullableArrayArgumentOps;
use crate::runtime::test as testlib;
use crate::runtime::test_core;
use crate::runtime::u_string::UStr;


#[test]
fn checked_sum() {
    testlib::run("tests.NullableArrayArgumentTests.checkedSum", "tests.NullableArrayArgumentTests.checkedSum: a null-checked nullable array unwraps into a borrowed Array parameter", || {
        test_core::TestCore::test_core_equals_int(6i32, i32::from_ne_bytes(((NullableArrayArgumentOps::nullable_array_argument_ops_checked_sum(Some(vec![1, 2, 3]))) as i32).to_ne_bytes()), UStr::new(&[]));
        test_core::TestCore::test_core_equals_int(0i32, i32::from_ne_bytes(((NullableArrayArgumentOps::nullable_array_argument_ops_checked_sum(None)) as i32).to_ne_bytes()), UStr::new(&[]));
    });
}
