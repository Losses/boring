function wrapGeneratedSource(content:String):String {
final wrapped:Array<String> = [];
for (line in content.split("\n")) {
var rest = line;
while (rest.length > 280) {
var quote = false;
var escaped = false;
var cut = -1;
var depth = 0;
var i = 0;
while (i < rest.length && i <= 280) {
final c = rest.charAt(i);
if (quote) {
if (escaped) escaped = false;
else if (c == "\\") escaped = true;
else if (c == '"') quote = false;
} else if (c == '"') {
quote = true;
} else if (c == "(" || c == "[") {
depth++;
} else if (c == ")" || c == "]") {
if (depth > 0) depth--;
} else if (c == ',' && depth == 0) {
cut = i;
}
i++;
}
if (cut < 1)
break;
wrapped.push(rest.substr(0, cut + 1));
rest = StringTools.ltrim(rest.substr(cut + 1));
}
wrapped.push(rest);
}
return ParenFold.strip(wrapped.join("\n"));
}
