package tests

import boring.IntDivisionOps
import boring.runtime.test.Test

class IntDivisionTests {
@boring.test.Test
    fun testQuotient() {
        Test.run("tests.IntDivisionTests.testQuotient", "tests.IntDivisionTests.testQuotient: an Int quotient assigned to a Float keeps the fraction") {
                Test.equals(3.5, IntDivisionOps.quotient(7, 2), null)
                Test.equals(0.5, IntDivisionOps.quotient(1, 2), null)
                Test.equals(2.0, IntDivisionOps.quotient(4, 2), null)
        }
    }

@boring.test.Test
    fun testNegativeQuotient() {
        Test.run("tests.IntDivisionTests.testNegativeQuotient", "tests.IntDivisionTests.testNegativeQuotient: negative Int operands keep the Float quotient") {
                Test.equals(-3.5, IntDivisionOps.quotient(-7, 2), null)
                Test.equals(-3.5, IntDivisionOps.quotient(7, -2), null)
                Test.equals(3.5, IntDivisionOps.quotient(-7, -2), null)
        }
    }

@boring.test.Test
    fun testZeroDivisor() {
        Test.run("tests.IntDivisionTests.testZeroDivisor", "tests.IntDivisionTests.testZeroDivisor: an Int quotient over a zero divisor reaches infinity") {
                Test.equals(Double.POSITIVE_INFINITY, IntDivisionOps.quotient(7, 0), null)
                Test.equals(Double.NEGATIVE_INFINITY, IntDivisionOps.quotient(-7, 0), null)
        }
    }

@boring.test.Test
    fun testOffset() {
        Test.run("tests.IntDivisionTests.testOffset", "tests.IntDivisionTests.testOffset: a layout offset keeps the fractional quotient") {
                Test.equals(7.5, IntDivisionOps.offset(10, 3, 4), null)
                Test.equals(2.5, IntDivisionOps.offset(5, 1, 2), null)
                Test.equals(5.0, IntDivisionOps.offset(10, 2, 4), null)
        }
    }

@boring.test.Test
    fun testScaled() {
        Test.run("tests.IntDivisionTests.testScaled", "tests.IntDivisionTests.testScaled: an Int quotient takes part in a Float multiply and add") {
                Test.equals(15.5, IntDivisionOps.scaled(10, 3, 4, 0.5), null)
                Test.equals(21.0, IntDivisionOps.scaled(10, 2, 4, 11.0), null)
        }
    }

@boring.test.Test
    fun testTruncated() {
        Test.run("tests.IntDivisionTests.testTruncated", "tests.IntDivisionTests.testTruncated: the truncating spelling keeps integer division") {
                Test.equals(3, IntDivisionOps.truncated(7, 2), null)
                Test.equals(-3, IntDivisionOps.truncated(-7, 2), null)
                Test.equals(2, IntDivisionOps.truncated(-7, -3), null)
                Test.equals(1, IntDivisionOps.remainder(7, 2), null)
                Test.equals(-1, IntDivisionOps.remainder(-7, 2), null)
        }
    }

@boring.test.Test
    fun testFloored() {
        Test.run("tests.IntDivisionTests.testFloored", "tests.IntDivisionTests.testFloored: a floored Int quotient floors the Float quotient") {
                Test.equals(3.0, IntDivisionOps.floored(7, 2), null)
                Test.equals(-4.0, IntDivisionOps.floored(-7, 2), null)
        }
    }
}
