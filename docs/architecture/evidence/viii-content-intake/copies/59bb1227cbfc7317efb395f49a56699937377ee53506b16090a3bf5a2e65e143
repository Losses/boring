#![cfg(test)]

use crate::runtime::test as testlib;
use crate::runtime::test_core;
use crate::runtime::u_string::UStr;
use crate::runtime::u_string::UString;


#[test]
fn ascii_round_trip() {
    testlib::run("tests.StringCodecTests.asciiRoundTrip", "tests.StringCodecTests.asciiRoundTrip: encodes and decodes ASCII", || {
        let bytes = UString::from("abc").as_bytes().to_vec();
        test_core::TestCore::test_core_equals_int(3i32, i32::from_ne_bytes(((u32::try_from((bytes.len()) & 0xFFFF_FFFF).unwrap_or(0)) as i32).to_ne_bytes()), UStr::new(&[]));
        test_core::TestCore::test_core_equals_int(97i32, i32::from_ne_bytes(((u32::from(bytes[0usize])) as i32).to_ne_bytes()), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[97,98,99]), UString::from(String::from_utf8_lossy(&bytes[0usize..usize::try_from(0 + 3).unwrap_or(0)]).into_owned().as_str()).as_ustr(), UStr::new(&[]));
    });
}

