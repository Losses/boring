#[test]
fn concat_joins() {
    testlib::run("tests.StringCodecTests.concatJoins", "tests.StringCodecTests.concatJoins: concat joins both operands in order", || {
        let left = UString::from("ab").as_bytes().to_vec();
        let right = UString::from("汉").as_bytes().to_vec();
        let joined = { let mut v = left.to_vec(); v.extend_from_slice(&right); v };
        test_core::TestCore::test_core_equals_int(5i32, i32::from_ne_bytes(((u32::try_from((joined.len()) & 0xFFFF_FFFF).unwrap_or(0)) as i32).to_ne_bytes()), UStr::new(&[]));
        test_core::TestCore::test_core_equals_int(97i32, i32::from_ne_bytes(((u32::from(joined[0usize])) as i32).to_ne_bytes()), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[97,98,27721]), UString::from(String::from_utf8_lossy(&joined[0usize..usize::try_from(0 + 5).unwrap_or(0)]).into_owned().as_str()).as_ustr(), UStr::new(&[]));
    });
}

