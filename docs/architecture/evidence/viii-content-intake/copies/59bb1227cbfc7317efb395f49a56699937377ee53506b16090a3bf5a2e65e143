#[test]
fn concat_no_alias() {
    testlib::run("tests.StringCodecTests.concatNoAlias", "tests.StringCodecTests.concatNoAlias: concat never shares storage with its operands", || {
        let mut left = UString::from("ab").as_bytes().to_vec();
        let right = UString::from("cd").as_bytes().to_vec();
        let joined = { let mut v = left.to_vec(); v.extend_from_slice(&right); v };
        left[0usize] = 122u8;
        test_core::TestCore::test_core_equals_int(97i32, i32::from_ne_bytes(((u32::from(joined[0usize])) as i32).to_ne_bytes()), UStr::new(&[]));
    });
}
