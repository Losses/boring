package tests

import boring.ArrayIndexSearchOps
import boring.runtime.test.Test

class ArrayIndexSearchTests {
@boring.test.Test
    fun testElementOnly() {
        Test.run("tests.ArrayIndexSearchTests.testElementOnly", "tests.ArrayIndexSearchTests.testElementOnly: an element-only array search reads the platform overload") {
                val values = ArrayIndexSearchOps.values()
                Test.equals(1, ArrayIndexSearchOps.indexOfElement(values, 7), null)
                Test.equals(4, ArrayIndexSearchOps.lastIndexOfElement(values, 7), null)
                Test.equals(-1, ArrayIndexSearchOps.indexOfElement(values, 8), null)
                Test.equals(-1, ArrayIndexSearchOps.lastIndexOfElement(values, 8), null)
        }
    }

@boring.test.Test
    fun testIndexOfFrom() {
        Test.run("tests.ArrayIndexSearchTests.testIndexOfFrom", "tests.ArrayIndexSearchTests.testIndexOfFrom: an array indexOf keeps its start index") {
                val values = ArrayIndexSearchOps.values()
                Test.equals(1, ArrayIndexSearchOps.indexOfFrom(values, 7, 0), null)
                Test.equals(1, ArrayIndexSearchOps.indexOfFrom(values, 7, 1), null)
                Test.equals(4, ArrayIndexSearchOps.indexOfFrom(values, 7, 2), null)
                Test.equals(-1, ArrayIndexSearchOps.indexOfFrom(values, 7, 5), null)
                Test.equals(-1, ArrayIndexSearchOps.indexOfFrom(values, 7, 6), null)
                Test.equals(-1, ArrayIndexSearchOps.indexOfFrom(values, 7, 100), null)
                Test.equals(4, ArrayIndexSearchOps.indexOfFrom(values, 7, -3), null)
                Test.equals(1, ArrayIndexSearchOps.indexOfFrom(values, 7, -100), null)
        }
    }

@boring.test.Test
    fun testLastIndexOfFrom() {
        Test.run("tests.ArrayIndexSearchTests.testLastIndexOfFrom", "tests.ArrayIndexSearchTests.testLastIndexOfFrom: an array lastIndexOf searches towards index 0 from its start index") {
                val values = ArrayIndexSearchOps.values()
                Test.equals(4, ArrayIndexSearchOps.lastIndexOfFrom(values, 7, 4), null)
                Test.equals(1, ArrayIndexSearchOps.lastIndexOfFrom(values, 7, 3), null)
                Test.equals(1, ArrayIndexSearchOps.lastIndexOfFrom(values, 7, 1), null)
                Test.equals(-1, ArrayIndexSearchOps.lastIndexOfFrom(values, 7, 0), null)
                Test.equals(4, ArrayIndexSearchOps.lastIndexOfFrom(values, 7, 5), null)
                Test.equals(4, ArrayIndexSearchOps.lastIndexOfFrom(values, 7, 100), null)
                Test.equals(4, ArrayIndexSearchOps.lastIndexOfFrom(values, 7, -2), null)
                Test.equals(-1, ArrayIndexSearchOps.lastIndexOfFrom(values, 7, -100), null)
        }
    }

@boring.test.Test
    fun testEmpty() {
        Test.run("tests.ArrayIndexSearchTests.testEmpty", "tests.ArrayIndexSearchTests.testEmpty: an empty array reports a miss in every shape") {
                val values = ArrayIndexSearchOps.empty()
                Test.equals(-1, ArrayIndexSearchOps.indexOfElement(values, 7), null)
                Test.equals(-1, ArrayIndexSearchOps.indexOfFrom(values, 7, 0), null)
                Test.equals(-1, ArrayIndexSearchOps.lastIndexOfElement(values, 7), null)
                Test.equals(-1, ArrayIndexSearchOps.lastIndexOfFrom(values, 7, 0), null)
        }
    }

@boring.test.Test
    fun testNullableReceiver() {
        Test.run("tests.ArrayIndexSearchTests.testNullableReceiver", "tests.ArrayIndexSearchTests.testNullableReceiver: a nullable array receiver keeps its start index") {
                val values = ArrayIndexSearchOps.values()
                Test.equals(1, ArrayIndexSearchOps.indexOfFromNullable(values, 7, 0), null)
                Test.equals(4, ArrayIndexSearchOps.lastIndexOfFromNullable(values, 7, 5), null)
        }
    }

@boring.test.Test
    fun testStringElement() {
        Test.run("tests.ArrayIndexSearchTests.testStringElement", "tests.ArrayIndexSearchTests.testStringElement: an array search compares a String element by value") {
                val words = mutableListOf<String>("alpha", "beta", "gamma", "beta")
                Test.equals(1, ArrayIndexSearchOps.indexOfString(words, "beta", 0), null)
                Test.equals(3, ArrayIndexSearchOps.indexOfString(words, "beta", 2), null)
                Test.equals(-1, ArrayIndexSearchOps.indexOfString(words, "beta", 4), null)
                Test.equals(3, ArrayIndexSearchOps.lastIndexOfString(words, "beta", 4), null)
                Test.equals(1, ArrayIndexSearchOps.lastIndexOfString(words, "beta", 2), null)
                Test.equals(15, ArrayIndexSearchOps.lastIndexOfTextEnd("alpha beta gamma", "a"), null)
                Test.equals(-1, ArrayIndexSearchOps.lastIndexOfTextEnd("alpha beta gamma", "z"), null)
        }
    }
}
