package tests

import boring.ChainedPaint
import boring.CoalescingPreset
import boring.CtorDefaultBadge
import boring.CtorDefaultHolder
import boring.DefaultArgsOps
import boring.GluePlacements
import boring.KeywordNameOps
import boring.ParamReadKind
import boring.ParamReadSpan
import boring.RegionProfile
import boring.runtime.test.Test

class DefaultArgsTests {
@boring.test.Test
    fun testGreet() {
        Test.run("tests.DefaultArgsTests.testGreet", "tests.DefaultArgsTests.testGreet: greet with explicit and default prefix") {
                Test.equals("Greetings Ada", DefaultArgsOps.callGreet0(), null)
                Test.equals("Hello Ada", DefaultArgsOps.callGreet1(), null)
        }
    }

@boring.test.Test
    fun testConfigure() {
        Test.run("tests.DefaultArgsTests.testConfigure", "tests.DefaultArgsTests.testConfigure: configure with zero, one, two, and three omitted arguments") {
                Test.equals(-180.0f, DefaultArgsOps.callConfigure0(), null)
                Test.equals(180.0f, DefaultArgsOps.callConfigure1(), null)
                Test.equals(300.0f, DefaultArgsOps.callConfigure2(), null)
                Test.equals(275.0f, DefaultArgsOps.callConfigure3(), null)
        }
    }

@boring.test.Test
    fun testFormatLabel() {
        Test.run("tests.DefaultArgsTests.testFormatLabel", "tests.DefaultArgsTests.testFormatLabel: formatLabel instance method with nullable and value optional parameters") {
                Test.equals("item:formatted", DefaultArgsOps.callFormatLabel0(), null)
                Test.equals("item-formatted", DefaultArgsOps.callFormatLabel1(), null)
                Test.equals("none-default", DefaultArgsOps.callFormatLabel2(), null)
        }
    }

@boring.test.Test
    fun testDescribeTag() {
        Test.run("tests.DefaultArgsTests.testDescribeTag", "tests.DefaultArgsTests.testDescribeTag: describeTag with explicit null default") {
                Test.equals("alpha:extra", DefaultArgsOps.callDescribeTag0(), null)
                Test.equals("alpha:none", DefaultArgsOps.callDescribeTag1(), null)
        }
    }

@boring.test.Test
    fun testOpenMode() {
        Test.run("tests.DefaultArgsTests.testOpenMode", "tests.DefaultArgsTests.testOpenMode: openMode with zero-argument enum constructor default") {
                Test.equals("write:1", DefaultArgsOps.callOpenMode0(), null)
                Test.equals("read:1", DefaultArgsOps.callOpenMode1(), null)
        }
    }

@boring.test.Test
    fun testAdjust() {
        Test.run("tests.DefaultArgsTests.testAdjust", "tests.DefaultArgsTests.testAdjust: adjust with negative literal default") {
                Test.equals(30.0f, DefaultArgsOps.callAdjust0(), null)
                Test.equals(15.0f, DefaultArgsOps.callAdjust1(), null)
        }
    }

@boring.test.Test
    fun testCoalescingInfinity() {
        Test.run("tests.DefaultArgsTests.testCoalescingInfinity", "tests.DefaultArgsTests.testCoalescingInfinity: coalescing infinity default preserves explicit values") {
                Test.equals(Float.POSITIVE_INFINITY, DefaultArgsOps.callInfinity0(), null)
                Test.equals(1.25f, DefaultArgsOps.callInfinity1(), null)
        }
    }

@boring.test.Test
    fun testCoalescingArrayFreshness() {
        Test.run("tests.DefaultArgsTests.testCoalescingArrayFreshness", "tests.DefaultArgsTests.testCoalescingArrayFreshness: coalescing array defaults are fresh per constructor call") {
                val first = DefaultArgsOps(mutableListOf<String>()).familyNames
                val second = DefaultArgsOps(mutableListOf<String>()).familyNames
                first.add("serif")
                Test.equals(1, first.size, null)
                Test.equals(0, second.size, null)
        }
    }

@boring.test.Test
    fun testCoalescingMapFreshness() {
        Test.run("tests.DefaultArgsTests.testCoalescingMapFreshness", "tests.DefaultArgsTests.testCoalescingMapFreshness: coalescing map defaults are fresh per function call") {
                val first = DefaultArgsOps.callMapDefault()
                val second = DefaultArgsOps.callMapDefault()
                first.put("serif", 1)
                Test.equals(true, first.containsKey("serif"), null)
                Test.equals(false, second.containsKey("serif"), null)
        }
    }

@boring.test.Test
    fun testLocalFunction() {
        Test.run("tests.DefaultArgsTests.testLocalFunction", "tests.DefaultArgsTests.testLocalFunction: local function with default argument called with omission") {
                Test.equals(107, DefaultArgsOps.callLocal(), null)
                Test.equals(207, DefaultArgsOps.callLocalB(), null)
        }
    }

@boring.test.Test
    fun testInterfaceMethod() {
        Test.run("tests.DefaultArgsTests.testInterfaceMethod", "tests.DefaultArgsTests.testInterfaceMethod: interface method with default parameter called through interface") {
                Test.equals("Admin:Sam", DefaultArgsOps.callInterface0(), null)
                Test.equals("User:Sam", DefaultArgsOps.callInterface1(), null)
        }
    }

@boring.test.Test
    fun testParameterRead() {
        Test.run("tests.DefaultArgsTests.testParameterRead", "tests.DefaultArgsTests.testParameterRead: bare earlier-parameter read") {
                Test.equals("hello", DefaultArgsOps.greetWithPrefix("hello"), null)
                Test.equals("hi", DefaultArgsOps.greetWithPrefix("hello", "hi"), null)
        }
    }

@boring.test.Test
    fun testFieldAccess() {
        Test.run("tests.DefaultArgsTests.testFieldAccess", "tests.DefaultArgsTests.testFieldAccess: field access over a parameter") {
                Test.equals("size:2", DefaultArgsOps.sizeLabel(mutableListOf<String>("a", "b")), null)
                Test.equals("size:0", DefaultArgsOps.sizeLabel(null), null)
                Test.equals(2, DefaultArgsOps.fieldAccessSample(mutableListOf<String>("a", "b")), null)
                Test.equals(7, DefaultArgsOps.fieldAccessSample(mutableListOf<String>("a", "b"), 7), null)
        }
    }

@boring.test.Test
    fun testConditional() {
        Test.run("tests.DefaultArgsTests.testConditional", "tests.DefaultArgsTests.testConditional: conditional over a parameter") {
                Test.equals("English", DefaultArgsOps.localeSample("en"), null)
                Test.equals("french", DefaultArgsOps.localeSample("fr", "french"), null)
        }
    }

@boring.test.Test
    fun testCallAndBinaryDefaults() {
        Test.run("tests.DefaultArgsTests.testCallAndBinaryDefaults", "tests.DefaultArgsTests.testCallAndBinaryDefaults: instance method call, static call, and binary operator defaults") {
                Test.equals("HELLO", DefaultArgsOps.methodCallSample("hello"), null)
                Test.equals(7, DefaultArgsOps.staticCallSample(7), null)
                Test.equals(8, DefaultArgsOps.binarySample(7), null)
        }
    }

@boring.test.Test
    fun testStaticFieldRead() {
        Test.run("tests.DefaultArgsTests.testStaticFieldRead", "tests.DefaultArgsTests.testStaticFieldRead: static-field read") {
                Test.equals(4097, DefaultArgsOps.staticFieldSample(1), null)
                Test.equals(6, DefaultArgsOps.staticFieldSample(5, 1), null)
        }
    }

@boring.test.Test
    fun testDependence() {
        Test.run("tests.DefaultArgsTests.testDependence", "tests.DefaultArgsTests.testDependence: dependence assertion: different earlier arguments resolve differently") {
                Test.equals("alpha", DefaultArgsOps.callDependenceA(), null)
                Test.equals("beta", DefaultArgsOps.callDependenceB(), null)
        }
    }

@boring.test.Test
    fun testChainedCoalescing() {
        Test.run("tests.DefaultArgsTests.testChainedCoalescing", "tests.DefaultArgsTests.testChainedCoalescing: chain with both parameters omitted resolves through the earlier default") {
                Test.equals(5.0f, DefaultArgsOps.callChainedBothOmitted(), null)
                Test.equals(7.0f, DefaultArgsOps.callChainedLaterOmitted(), null)
                Test.equals(9.5f, DefaultArgsOps.callChainedBothGiven(), null)
        }
    }

@boring.test.Test
    fun testChainedPaint() {
        Test.run("tests.DefaultArgsTests.testChainedPaint", "tests.DefaultArgsTests.testChainedPaint: constructor chain defaults the later field to the earlier parameter") {
                val both = ChainedPaint()
                Test.equals(0.0f, both.radius, null)
                Test.equals(0.0f, both.followRadius, null)
                val given = ChainedPaint(4.5f)
                Test.equals(4.5f, given.radius, null)
                Test.equals(4.5f, given.followRadius, null)
        }
    }

@boring.test.Test
    fun testCoalescingPreset() {
        Test.run("tests.DefaultArgsTests.testCoalescingPreset", "tests.DefaultArgsTests.testCoalescingPreset: zero-argument self-construction on a field-carrying class keeps the labeled printed form") {
                Test.equals("CoalescingPreset(base=0.125, ceiling=0.5)", CoalescingPreset.Default.toString(), null)
                Test.equals("CoalescingPreset(base=0.125, ceiling=0.5)", CoalescingPreset.Default.toString(), null)
                Test.equals("CoalescingPreset(base=0.25, ceiling=0.75)", CoalescingPreset(0.25f, 0.75f).toString(), null)
        }
    }

@boring.test.Test
    fun ctorDefaultLeafFreshness() {
        Test.run("tests.DefaultArgsTests.ctorDefaultLeafFreshness", "tests.DefaultArgsTests.ctorDefaultLeafFreshness: constructor default leaf builds a fresh instance per omitting call") {
                val first = CtorDefaultHolder()
                val second = CtorDefaultHolder()
                first.badge.tag = "mutated"
                Test.equals("mutated", first.badge.tag, null)
                Test.equals("fresh", second.badge.tag, null)
                val given = CtorDefaultHolder(CtorDefaultBadge("given"))
                Test.equals("given", given.badge.tag, null)
        }
    }

@boring.test.Test
    fun kotlinHardKeywordIdentifiers() {
        Test.run("tests.DefaultArgsTests.kotlinHardKeywordIdentifiers", "tests.DefaultArgsTests.kotlinHardKeywordIdentifiers: kotlin hard keyword identifiers survive every target") {
                Test.equals(5, KeywordNameOps.clampVal(0, 5, 10), null)
                Test.equals(10, KeywordNameOps.clampVal(99, 5, 10), null)
                Test.equals(7, KeywordNameOps.clampVal(7, 5, 10), null)
                Test.equals(8, KeywordNameOps.localKeywordRead(), null)
        }
    }

@boring.test.Test
    fun ctorParamReadDefault() {
        Test.run("tests.DefaultArgsTests.ctorParamReadDefault", "tests.DefaultArgsTests.ctorParamReadDefault: constructor coalescing default reading an earlier parameter resolves at the call site") {
                val bopomofo = ParamReadSpan(ParamReadKind.Bopomofo, if (ParamReadKind.Bopomofo == ParamReadKind.Bopomofo) "zh-TW" else null)
                Test.equals("zh-TW", bopomofo.locale, null)
                val pinyin = ParamReadSpan(ParamReadKind.Pinyin, if (ParamReadKind.Pinyin == ParamReadKind.Bopomofo) "zh-TW" else null)
                Test.equals(null, pinyin.locale, null)
                val given = ParamReadSpan(ParamReadKind.Pinyin, "zh-Latn")
                Test.equals("zh-Latn", given.locale, null)
        }
    }

@boring.test.Test
    fun ctorStaticCallParamReadDefault() {
        Test.run("tests.DefaultArgsTests.ctorStaticCallParamReadDefault", "tests.DefaultArgsTests.ctorStaticCallParamReadDefault: constructor coalescing default calling a static helper with an earlier parameter") {
                val bopo = RegionProfile(ParamReadKind.Bopomofo, GluePlacements.forRegion(ParamReadKind.Bopomofo))
                Test.equals("bopo", bopo.gluePlacement, null)
                val pinyin = RegionProfile(ParamReadKind.Pinyin, GluePlacements.forRegion(ParamReadKind.Pinyin))
                Test.equals("pinyin", pinyin.gluePlacement, null)
                val given = RegionProfile(ParamReadKind.Pinyin, "custom")
                Test.equals("custom", given.gluePlacement, null)
        }
    }
}
