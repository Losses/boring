#![cfg(test)]

use crate::boring::optional_interface_argument_ops::OptionalInterfaceArgumentOps;
use crate::runtime::test as testlib;
use crate::runtime::test_core;
use crate::runtime::u_string::UStr;


#[test]
fn render() {
    testlib::run("tests.OptionalInterfaceArgumentOpsTests.render", "tests.OptionalInterfaceArgumentOpsTests.render: a concrete implementor boxes once into an optional interface argument", || {
        test_core::TestCore::test_core_equals_string(UStr::new(&[99,105,114,99,108,101]), OptionalInterfaceArgumentOps::optional_interface_argument_ops_render_fresh().as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[115,113,117,97,114,101]), OptionalInterfaceArgumentOps::optional_interface_argument_ops_render_local(OptionalInterfaceArgumentOps::optional_interface_argument_ops_make_square()).as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[110,111,110,101]), OptionalInterfaceArgumentOps::optional_interface_argument_ops_render_nullable_local(None).as_ustr(), UStr::new(&[]));
    });
}
