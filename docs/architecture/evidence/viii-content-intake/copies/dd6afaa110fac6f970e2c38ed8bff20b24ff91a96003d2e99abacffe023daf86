#![cfg(test)]

use crate::boring::float_literal_ops::FloatLiteralOps;
use crate::runtime::test as testlib;
use crate::runtime::test_core;
use crate::runtime::u_string::UStr;


#[test]
fn test_arg_leading_dot() {
    testlib::run("tests.FloatLiteralOpsTests.testArgLeadingDot", "tests.FloatLiteralOpsTests.testArgLeadingDot: leading-dot float in argument position lowers", || {
        test_core::TestCore::test_core_equals_float(0.001f32, FloatLiteralOps::float_literal_ops_arg_leading_dot(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_float(0.0f32, FloatLiteralOps::float_literal_ops_integer_constructor_argument(), UStr::new(&[]));
    });
}

#[test]
fn test_local_leading_dot_neg() {
    testlib::run("tests.FloatLiteralOpsTests.testLocalLeadingDotNeg", "tests.FloatLiteralOpsTests.testLocalLeadingDotNeg: negative leading-dot float in initializer position lowers", || {
        test_core::TestCore::test_core_equals_float(-0.1f32, FloatLiteralOps::float_literal_ops_local_leading_dot_neg(), UStr::new(&[]));
    });
}

#[test]
fn test_arg_small() {
    testlib::run("tests.FloatLiteralOpsTests.testArgSmall", "tests.FloatLiteralOpsTests.testArgSmall: small-magnitude leading-dot float in argument position lowers", || {
        test_core::TestCore::test_core_equals_float(0.25f32, FloatLiteralOps::float_literal_ops_arg_small(), UStr::new(&[]));
    });
}

#[test]
fn test_local_small_neg() {
    testlib::run("tests.FloatLiteralOpsTests.testLocalSmallNeg", "tests.FloatLiteralOpsTests.testLocalSmallNeg: negative small-magnitude leading-dot float in initializer position lowers", || {
        test_core::TestCore::test_core_equals_float(-0.5f32, FloatLiteralOps::float_literal_ops_local_small_neg(), UStr::new(&[]));
    });
}
