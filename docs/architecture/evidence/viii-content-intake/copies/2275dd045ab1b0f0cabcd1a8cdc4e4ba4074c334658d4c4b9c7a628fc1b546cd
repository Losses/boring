package boring

data class InlineDefaultOps(val region: Int, val marker: Int = 0, val count: Int = region) {

    override fun toString(): String {
        return "InlineDefaultOps(" + "marker=" + this.marker + ", " + "region=" + this.region + ", " + "count=" + this.count + ")"
    }
}

fun compareInlineDefaultOps(a: InlineDefaultOps, b: InlineDefaultOps): Int {
    var cmp = 0
    cmp = a.marker.compareTo(b.marker)
    if (cmp != 0) return cmp
    cmp = a.region.compareTo(b.region)
    if (cmp != 0) return cmp
    cmp = a.count.compareTo(b.count)
    if (cmp != 0) return cmp
    return 0
}
