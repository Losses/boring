package boring

object MathIntWideningOps {
    fun floorOf(x: Int): Int {
        return (kotlin.math.floor((x).toFloat())).toInt()
    }

    fun ceilOf(x: Int): Int {
        return (kotlin.math.ceil((x).toFloat())).toInt()
    }

    fun sqrtOf(x: Int): Float {
        return kotlin.math.sqrt((x).toFloat())
    }

    fun nanOf(x: Int): Boolean {
        return ((x).toFloat()).isNaN()
    }

    fun finiteOf(x: Int): Boolean {
        return ((x).toFloat()).isFinite()
    }
}
