# Stage 0: environment guard + toolchain resolution record. Explicit
# flake path, local cache, git ceiling, and SOURCE_MANIFEST must all be
# present; the resolved paths of npm, node, tar, python3, haxe, kotlinc
# are recorded into sealed stage evidence (existing behavior boundary:
# npm/node/tar/python3/haxe/kotlinc are used exactly as resolved; no
# flags are added to any package command).
"$EXCLUSIVE_RUNNER_DIR/option-c-stage-wrapper.sh" env-guard "$OPTION_C_ROOT" "$SOURCE_MANIFEST" "$EXCLUSIVE_RUNNER_DIR/option-c-poststate.py" "$RUN/option-c" -- bash -c 'cd "$1" && [ -n "$GIT_CEILING_DIRECTORIES" ] && [ -n "$XDG_CACHE_HOME" ] && [ -f "$SOURCE_MANIFEST" ] && { echo "ceiling=$GIT_CEILING_DIRECTORIES"; echo "cache=$XDG_CACHE_HOME"; echo "root=$OPTION_C_ROOT"; echo "manifest=$SOURCE_MANIFEST"; command -v npm; command -v node; command -v tar; command -v python3; command -v haxe; command -v kotlinc; } > toolchain-resolution.txt && test -s toolchain-resolution.txt' _ "$OPTION_C_ROOT"

# Stage 1: identity attachment — independent of the chain. Cargo.lock
