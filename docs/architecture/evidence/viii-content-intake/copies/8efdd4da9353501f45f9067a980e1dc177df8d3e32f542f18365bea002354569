#!/usr/bin/env bash
# Roots-manifest consistency guard (precision-switch bundles).
#
# WHAT THIS SCRIPT ACTUALLY ENFORCES -- nothing stronger.  (An earlier header
# claimed it kept "the cross-target test id set equal"; the guard never reads a
# module body or a test id, so that claim is withdrawn.  It compares
# root-module LISTS, which is necessary but not sufficient for equal id sets.)
#
# For each guarded target T in {kotlin,rust,swift}, with
#   B = examples/T.hxml        F = examples/T-f32.hxml
#
#  (1) ROOT-SET EQUALITY, BOTH DIRECTIONS.  root(B) == root(F).
#      A module in B but not F ("base-only") and a module in F but not B
#      ("f32-only") are both reported, and either one fails the guard.
#      A root is a bare module-path line `Ident(.Ident)*`, a `-main <module>`
#      argument, or any root of a nested `.hxml` include (depth <= 8).
#  (2) DECLARED DIVERGENCE.  roots-allowlist.json `exempt` entries authorise a
#      specific (target, module) asymmetry.  An entry must be LIVE: that module
#      must really be the asymmetric one for that target.  An entry for a module
#      present in both files, or for a non-guarded target, is a STALE exemption
#      and fails.  Entries are structurally validated: target in
#      {kotlin,rust,swift,*}, module a plausible dotted module path, reason a
#      substantive sentence (>= 24 chars, >= 4 words, not a placeholder such as
#      "x" / "todo" / "n/a"), no duplicate (target,module), no unknown keys.
#  (3) ROOT EXISTENCE.  Every root of both files, and every module named by the
#      allowlist, must resolve to a real .hx on the guarded classpaths
#      (-cp dirs + -lib classpaths) or, as a fallback, anywhere in the
#      repository.  A typo or phantom module fails.
#  (4) TEST-MODULE COVERAGE.  Every .hx under a `tests/` directory of a guarded
#      classpath that declares `@:test` must be a root of at least one of B/F.
#      A test module missing from BOTH files used to be invisible; it now fails
#      unless declared in allowlist section `unrootedTestModules` (also
#      reason-checked and stale-checked).
#
# REPORTED BUT NOT FATAL (use --strict-duplicates to fail on them):
#   * duplicate root lines inside one pair.  The shipped hxml files currently
#     contain 45 such lines; duplicates cannot change the module set, they are
#     inert, and this guard does not modify examples/**.  They are printed with
#     file:line and counted so they stop being invisible.
#
# NOT COVERED: test ids, @:test case sets, module bodies, runtime behaviour
#   under binary32/binary64.  `samples/tests/f32/PrintedFloatTests.hx` ships 6
#   f32-only ids that this guard cannot see (declared in tools/test-consistency/
#   extra-id-allowlist.json).  dart/ts pairs are not guarded (no -f32 variant).
#
# Usage: check-roots-guard.sh [examples-dir] [--repo-root=PATH] [--strict-duplicates]
#
#   examples-dir        default: <script>/../../examples
#   --repo-root=PATH    repository root used for module-source resolution
#                       (also honoured: ROOTS_GUARD_REPO_ROOT).  If discovery
#                       fails the guard FAILS rather than skipping the checks.
#
# Exit: 0 = PASS, 1 = FAILED, 2 = usage error.
set -u

usage() {
    sed -n '2,46p' "$0"
}

examples=""
repo_override="${ROOTS_GUARD_REPO_ROOT:-}"
strict_dups=0
while [ "$#" -gt 0 ]; do
    case "$1" in
        --repo-root=*)       repo_override="${1#*=}" ;;
        --strict-duplicates) strict_dups=1 ;;
        -h|--help)           usage; exit 0 ;;
        -*)                  echo "FAIL: unknown option: $1"; exit 2 ;;
        *)                   if [ -z "$examples" ]; then examples="$1";
                             else echo "FAIL: unexpected argument: $1"; exit 2; fi ;;
    esac
    shift
done

here="$(cd "$(dirname "$0")" && pwd)"
allowlist="${ROOTS_GUARD_ALLOWLIST:-$here/roots-allowlist.json}"
examples="${examples:-$here/../../examples}"
if [ ! -d "$examples" ]; then
    echo "FAIL: examples directory not found: $examples"
    echo "roots guard: FAILED"
    exit 1
fi
examples="$(cd "$examples" && pwd)"

# ---------------------------------------------------------------- repo root --
looks_like_repo() { [ -f "$1/haxelib.json" ] && [ -d "$1/samples" ] && [ -d "$1/packages" ]; }
repo=""
for cand in "$repo_override" "$here/../.." "$examples/.." "$examples/../.." "$PWD"; do
    [ -n "$cand" ] && [ -d "$cand" ] || continue
    abs="$(cd "$cand" && pwd)"
    if looks_like_repo "$abs"; then repo="$abs"; break; fi
done
if [ -z "$repo" ] && [ -n "$repo_override" ] && [ -d "$repo_override" ]; then
    repo="$(cd "$repo_override" && pwd)"
fi
if [ -z "$repo" ]; then
    walk="$examples"
    for _ in 1 2 3 4 5 6; do
        walk="$(dirname "$walk")"
        if looks_like_repo "$walk"; then repo="$walk"; break; fi
        [ "$walk" = "/" ] && break
    done
fi
if [ -z "$repo" ]; then
    echo "FAIL: cannot locate the repository root for module-source resolution (no directory with haxelib.json+samples+packages above $examples); set ROOTS_GUARD_REPO_ROOT=/path/to/repo"
    echo "roots guard: FAILED"
    exit 1
fi

fail=0
exemptions=0
unrooted_decls=0
dup_lines=0

tmpd="$(mktemp -d "${TMPDIR:-/tmp}/roots-guard.XXXXXX")"
trap 'rm -rf "$tmpd"' EXIT

# ------------------------------------------------------- allowlist (via node) --
allow_js="$(cat <<'JS'
const fs = require("fs");
const path = process.argv[1];
const GUARDED = ["kotlin", "rust", "swift"];
const MODULE_RE = /^[A-Za-z_][A-Za-z0-9_]*(\.[A-Za-z_][A-Za-z0-9_]*)*$/;
const PLACEHOLDER = new Set(["x","xx","xxx","n/a","na","none","null","nil","todo","tbd","fixme",
    "wip","temp","test","reason","dummy","placeholder","-","--","?","...","abc","foo","bar","baz",
    "asdf","whatever","misc","other","later","unknown","secret","because"]);
let bad = 0;
function fail(msg) { console.log("FAIL: " + msg); bad = 1; }
function reasonProblem(r) {
    if (typeof r !== "string") return "reason is not a string";
    const t = r.trim();
    if (!t) return "blank/whitespace-only reason";
    if (/[\t\n\r]/.test(t)) return "reason contains a tab or newline";
    const words = t.split(/\s+/);
    if (words.length < 4) return "reason is not a substantive sentence (" + words.length +
        " word(s): " + JSON.stringify(t) + "); need >= 4 words";
    if (t.length < 24) return "reason too short (" + t.length + " chars, need >= 24)";
    if (PLACEHOLDER.has(t.toLowerCase())) return "reason is a placeholder token: " + JSON.stringify(t);
    if (!/[A-Za-z]{3}/.test(t)) return "reason contains no prose";
    return "";
}
function checkEntry(e, where) {
    if (e === null || typeof e !== "object" || Array.isArray(e)) {
        fail(where + ": entry is not an object: " + JSON.stringify(e)); return null;
    }
    const keys = Object.keys(e).sort().join(",");
    if (keys !== "module,reason,target") {
        fail(where + ": entry keys must be exactly target,module,reason (got: " + Object.keys(e).join(",") + ")");
        return null;
    }
    const t = e.target, m = e.module;
    if (typeof t !== "string" || (t !== "*" && GUARDED.indexOf(t) < 0)) {
        fail(where + ": target must be one of " + GUARDED.join("/") + " or * (got: " + JSON.stringify(t) + ")");
        return null;
    }
    if (typeof m !== "string" || !MODULE_RE.test(m)) {
        fail(where + ": module is not a plausible dotted module path: " + JSON.stringify(m));
        return null;
    }
    const rp = reasonProblem(e.reason);
    if (rp) { fail(where + ": " + rp); return null; }
    return { target: t, module: m, reason: String(e.reason).trim() };
}
const doc = { exempt: [], unrootedTestModules: [] };
if (fs.existsSync(path)) {
    let parsed = null;
    try { parsed = JSON.parse(fs.readFileSync(path, "utf8")); }
    catch (err) { fail("allowlist is not valid JSON (" + path + "): " + err.message); }
    if (parsed !== null) {
        if (typeof parsed !== "object" || Array.isArray(parsed)) fail("allowlist must be a JSON object");
        else {
            for (const k of Object.keys(parsed)) {
                if (k !== "exempt" && k !== "unrootedTestModules") fail("unknown top-level key in allowlist: " + JSON.stringify(k));
            }
            for (const sec of ["exempt", "unrootedTestModules"]) {
                const v = parsed[sec];
                if (v === undefined) continue;
                if (!Array.isArray(v)) { fail("allowlist." + sec + " must be an array"); continue; }
                for (let i = 0; i < v.length; i++) {
                    const e = checkEntry(v[i], sec + "[" + i + "]");
                    if (e) doc[sec].push(e);
                }
            }
        }
    }
}
const seen = new Set();
for (const sec of ["exempt", "unrootedTestModules"]) {
    for (const e of doc[sec]) {
        for (const t of (e.target === "*" ? GUARDED.slice() : [e.target])) {
            const key = t + "\t" + e.module;
            if (seen.has(key)) {
                fail(sec + ": duplicate/conflicting entry for target " + t + " module " + e.module +
                     " (also declared elsewhere in this allowlist)");
                continue;
            }
            seen.add(key);
            console.log((sec === "exempt" ? "ALLOW" : "UNROOT") + "\t" + t + "\t" + e.module + "\t" + e.reason);
        }
    }
}
process.exit(bad);
JS
)"
declare -A EX_REASON=() UNROOT_REASON=() EX_USED=() UNROOT_USED=()
allow_out="$(node --eval "$allow_js" "$allowlist")"; allow_rc=$?
if [ -n "$allow_out" ]; then
    while IFS= read -r aline; do
        case "$aline" in
            ALLOW$'\t'*)  IFS=$'\t' read -r _ t m r <<< "$aline"; EX_REASON["$t|$m"]="$r" ;;
            UNROOT$'\t'*) IFS=$'\t' read -r _ t m r <<< "$aline"; UNROOT_REASON["$t|$m"]="$r" ;;
            FAIL:*)       printf '%s\n' "$aline"; fail=1 ;;
            *)            ;;
        esac
    done <<< "$allow_out"
fi
[ "$allow_rc" -eq 0 ] || fail=1

# ------------------------------------------------------------- collection ----
declare -A CP_SEEN=()
CP_ALL=()
INCLUDE_STACK=""
C_QUIET=0

# collect_roots writes its DIAGNOSTICS to stderr (its stdout is the root stream
# that callers redirect into a file) and always records the failure.
c_fail() {
    fail=1
    [ "$C_QUIET" -eq 1 ] && return 0
    printf '%s\n' "$1" >&2
}

note_cp() {
    [ -d "$1" ] || return 0
    local abs; abs="$(cd "$1" && pwd)"
    [ -n "${CP_SEEN[$abs]:-}" ] && return 0
    CP_SEEN["$abs"]=1
    CP_ALL+=("$abs")
}

lib_classpath() {
    local lib="$1" root="" dev="" ver="" cp=""
    if [ -f "$repo/.haxelib/$lib/.dev" ]; then
        dev="$(head -n1 "$repo/.haxelib/$lib/.dev")"
        [ -n "$dev" ] && root="$dev"
    elif [ -f "$repo/.haxelib/$lib/.current" ]; then
        ver="$(head -n1 "$repo/.haxelib/$lib/.current")"
        [ -n "$ver" ] && root="$repo/.haxelib/$lib/$ver"
    fi
    [ -n "$root" ] && [ -d "$root" ] || return 0
    if [ -f "$root/haxelib.json" ]; then
        cp="$(grep -o '"classPath"[[:space:]]*:[[:space:]]*"[^"]*"' "$root/haxelib.json" \
              | head -n1 | sed 's/.*:[[:space:]]*"//; s/"$//')"
    fi
    if [ -n "$cp" ] && [ -d "$root/$cp" ]; then printf '%s\n' "$root/$cp"; else printf '%s\n' "$root"; fi
}

collect_roots() {
    local f="$1" depth="$2" line lineno ref base
    if [ ! -f "$f" ]; then
        c_fail "FAIL: missing file: $f"
        return 0
    fi
    case " $INCLUDE_STACK " in
        *" $f "*) c_fail "FAIL: hxml include cycle at $f"; return 0 ;;
    esac
    if [ "$depth" -gt 8 ]; then c_fail "FAIL: hxml include depth exceeded at $f"; return 0; fi
    INCLUDE_STACK="$INCLUDE_STACK $f"
    lineno=0
    while IFS= read -r line || [ -n "$line" ]; do
        lineno=$((lineno + 1))
        case "$line" in
            ''|'#'*|';'*) continue ;;
            -main|--main)
                c_fail "FAIL: $f:$lineno: '$line' without a module argument"; fail=1; continue ;;
            -main[[:space:]]*|--main[[:space:]]*)
                ref="$(printf '%s' "$line" | sed 's/^-\{1,2\}main[[:space:]]*//; s/[[:space:]]*$//')"
                case "$ref" in
                    '') c_fail "FAIL: $f:$lineno: -main without a module argument"; fail=1 ;;
                    *[!A-Za-z0-9_.]*|[!A-Za-z_]*) c_fail "FAIL: $f:$lineno: malformed -main module path: $ref"; fail=1 ;;
                    *) printf '%s\t%s\t%s\n' "$ref" "$f" "$lineno" ;;
                esac
                continue ;;
            -cp|--cp|-cp[[:space:]]*|--cp[[:space:]]*)
                ref="$(printf '%s' "$line" | sed 's/^-\{1,2\}cp[[:space:]]*//; s/[[:space:]]*$//')"
                if [ -z "$ref" ]; then c_fail "FAIL: $f:$lineno: -cp without a directory"; fail=1; else
                    for base in "$repo" "$examples" "$(dirname "$f")" "$PWD"; do note_cp "$base/$ref"; done
                    case "$ref" in /*) note_cp "$ref" ;; esac
                fi
                continue ;;
            -lib|--lib|-lib[[:space:]]*|--lib[[:space:]]*)
                ref="$(printf '%s' "$line" | sed 's/^-\{1,2\}lib[[:space:]]*//; s/[[:space:]]*$//')"
                if [ -z "$ref" ]; then c_fail "FAIL: $f:$lineno: -lib without a library name"; fail=1; else
                    while IFS= read -r cpdir; do note_cp "$cpdir"; done < <(lib_classpath "$ref")
                fi
                continue ;;
            -*|+*) continue ;;
        esac
        case "$line" in
            *.hxml)
                ref=""
                for base in "$(dirname "$f")" "$examples" "$repo" "$PWD"; do
                    if [ -f "$base/$line" ]; then ref="$base/$line"; break; fi
                done
                if [ -z "$ref" ]; then
                    c_fail "FAIL: $f:$lineno: unresolved hxml include: $line"; fail=1
                else
                    collect_roots "$ref" $((depth + 1))
                fi
                continue ;;
        esac
        if [[ "$line" =~ ^[A-Za-z_][A-Za-z0-9_]*(\.[A-Za-z_][A-Za-z0-9_]*)*$ ]]; then
            printf '%s\t%s\t%s\n' "$line" "$f" "$lineno"
        elif [[ "$line" =~ ^[A-Za-z_][A-Za-z0-9_.]*$ ]]; then
            c_fail "FAIL: $f:$lineno: malformed root module path: $line"; fail=1
        fi
    done < "$f"
    INCLUDE_STACK="${INCLUDE_STACK% "$f"}"
}

resolve_fallback() {
    local rel="${1//.//}.hx" cand
    if [ ! -f "$tmpd/hx-index.txt" ]; then
        find "$repo" \
            \( -name out -o -name reference -o -name node_modules -o -name .git -o -name .haxelib \
               -o -name 'publication-staging' -o -name '.gradle*' -o -name '.cache*' -o -name '.npm-cache' \
               -o -name '.nix-cache' -o -name '.konan-ws' -o -name 'nix-cache' -o -name tmp \) -prune -o \
            -name '*.hx' -print > "$tmpd/hx-index.txt" 2>/dev/null || true
    fi
    while IFS= read -r cand; do
        case "$cand" in */"$rel") printf '%s\n' "$cand"; return 0 ;; esac
    done < "$tmpd/hx-index.txt"
    return 0
}

declare -A RESOLVED=()
RESOLVED_PATH=""
resolve_module() {   # $1 = module; sets RESOLVED_PATH, returns 0 when found
    local m="$1" rel d p
    RESOLVED_PATH=""
    if [ -n "${RESOLVED[$m]:-}" ]; then RESOLVED_PATH="${RESOLVED[$m]}"; return 0; fi
    rel="${m//.//}.hx"
    for d in ${CP_ALL[@]+"${CP_ALL[@]}"}; do
        p="$d/$rel"
        if [ -f "$p" ]; then RESOLVED["$m"]="$p"; RESOLVED_PATH="$p"; return 0; fi
    done
    p="$(resolve_fallback "$m")"
    if [ -n "$p" ]; then RESOLVED["$m"]="$p"; RESOLVED_PATH="$p"; return 0; fi
    return 1
}

# Classpaths are collected up front from every guarded pair; existence is then
# checked against their union (permissive: it cannot invent a failure).
for t in kotlin rust swift; do
    for suff in "" "-f32"; do
        f="$examples/$t$suff.hxml"
        if [ -f "$f" ]; then C_QUIET=1; collect_roots "$f" 0 > /dev/null; C_QUIET=0; fi
    done
done

# ------------------------------------------------------------ test coverage --
declare -A SCAN_MODULES=()
scan_found=0
for d in ${CP_ALL[@]+"${CP_ALL[@]}"}; do
    tdir="$d/tests"
    [ -d "$tdir" ] || continue
    scan_found=1
    while IFS= read -r f; do
        grep -q '@:test' "$f" 2>/dev/null || continue
        rel="${f#$d/}"; rel="${rel%.hx}"
        SCAN_MODULES["${rel//\//.}"]="$f"
    done < <(find "$tdir" -type f -name '*.hx' | sort)
done
if [ "$scan_found" -eq 0 ]; then
    echo "FAIL: no tests/ directory found under any guarded classpath (checked: ${CP_ALL[*]:-none}); the @:test coverage check cannot run"
    fail=1
fi
mapfile -t SCAN_MOD_LIST < <(printf '%s\n' ${SCAN_MODULES[@]+"${!SCAN_MODULES[@]}"} | sort)

# ------------------------------------------------------------ per-target -----
for target in kotlin rust swift; do
    base="$examples/$target.hxml"
    f32="$examples/$target-f32.hxml"
    ok=1
    for f in "$base" "$f32"; do
        if [ ! -f "$f" ]; then echo "FAIL: missing file: $f"; fail=1; ok=0; fi
    done
    [ "$ok" -eq 1 ] || continue
    base_name="$(basename "$base")"
    f32_name="$(basename "$f32")"

    collect_roots "$base" 0 > "$tmpd/roots.base"
    collect_roots "$f32" 0 > "$tmpd/roots.f32"
    cat "$tmpd/roots.base" "$tmpd/roots.f32" > "$tmpd/roots.all"

    : > "$tmpd/dups"
    for rf in "$tmpd/roots.base" "$tmpd/roots.f32"; do
        [ -f "$rf" ] || continue
        awk -F'\t' '{ n[$1]++; loc[$1] = loc[$1] " " $2 ":" $3 }
                    END { for (m in n) if (n[m] > 1) printf "%s\t%d\t%s\n", m, n[m], loc[m] }' \
            "$rf" | sort >> "$tmpd/dups"
    done
    while IFS=$'\t' read -r m cnt locs; do
        [ -z "${m:-}" ] && continue
        echo "DUP: $m listed $cnt times in the $target pair:$locs"
        dup_lines=$((dup_lines + cnt - 1))
    done < "$tmpd/dups"
    if [ "$strict_dups" -eq 1 ] && [ -s "$tmpd/dups" ]; then
        echo "FAIL: --strict-duplicates: duplicate root line(s) in the $target pair (see the DUP: lines above)"
        fail=1
    fi

    cut -f1 "$tmpd/roots.base" | sort -u > "$tmpd/set.base"
    cut -f1 "$tmpd/roots.f32"  | sort -u > "$tmpd/set.f32"
    comm -23 "$tmpd/set.base" "$tmpd/set.f32" > "$tmpd/only.base"
    comm -13 "$tmpd/set.base" "$tmpd/set.f32" > "$tmpd/only.f32"

    while IFS= read -r mod; do
        [ -z "$mod" ] && continue
        key="$target|$mod"
        if [ -n "${EX_REASON[$key]:-}" ]; then
            EX_USED["$key"]=1; exemptions=$((exemptions + 1))
            echo "EXEMPT: $f32_name may omit $mod -- ${EX_REASON[$key]}"
        else
            echo "FAIL: $f32_name omits root module $mod (present in $base_name); add it to $base_name/$f32_name, or declare a live exemption with a substantive reason in $allowlist"
            fail=1
        fi
    done < "$tmpd/only.base"

    while IFS= read -r mod; do
        [ -z "$mod" ] && continue
        key="$target|$mod"
        if [ -n "${EX_REASON[$key]:-}" ]; then
            EX_USED["$key"]=1; exemptions=$((exemptions + 1))
            echo "EXEMPT: $f32_name adds $mod (absent from $base_name) -- ${EX_REASON[$key]}"
        else
            echo "FAIL: $f32_name lists root module $mod that $base_name does not (f32-only divergence: the two root sets differ); remove it, or declare a live exemption with a substantive reason in $allowlist"
            fail=1
        fi
    done < "$tmpd/only.f32"

    while IFS= read -r mod; do
        [ -z "$mod" ] && continue
        if ! resolve_module "$mod"; then
            at="$(awk -F'\t' -v m="$mod" '$1 == m { print $2 ":" $3; exit }' "$tmpd/roots.all")"
            echo "FAIL: root module $mod (at ${at:-unknown}) does not resolve to any .hx on the guarded classpaths or anywhere under $repo"
            fail=1
        fi
    done < <(cut -f1 "$tmpd/roots.all" | sort -u)

    declare -A R_ANY=()
    while IFS= read -r mod; do [ -n "$mod" ] && R_ANY["$mod"]=1; done < <(cat "$tmpd/set.base" "$tmpd/set.f32" | sort -u)
    for mod in ${SCAN_MOD_LIST[@]+"${SCAN_MOD_LIST[@]}"}; do
        [ -n "${R_ANY[$mod]:-}" ] && continue
        key="$target|$mod"
        if [ -n "${UNROOT_REASON[$key]:-}" ]; then
            UNROOT_USED["$key"]=1; unrooted_decls=$((unrooted_decls + 1))
            echo "COVER: declared unrooted @:test module $mod for $target -- ${UNROOT_REASON[$key]}"
        else
            echo "FAIL: $mod declares @:test in ${SCAN_MODULES[$mod]} but is a root of neither $base_name nor $f32_name (a module missing from both files was previously invisible); root it, or declare it in allowlist section unrootedTestModules with a substantive reason"
            fail=1
        fi
    done
    unset R_ANY
done

# ------------------------------------------------- stale / orphan declarations --
mapfile -t ex_keys < <(printf '%s\n' ${EX_REASON[@]+"${!EX_REASON[@]}"} | sort)
for key in ${ex_keys[@]+"${ex_keys[@]}"}; do
    [ -z "$key" ] && continue
    [ -n "${EX_USED[$key]:-}" ] && continue
    t="${key%%|*}"; m="${key#*|}"
    echo "FAIL: stale exemption: {target=$t, module=$m} is never needed -- $m is not asymmetric for $t (it is present in both $t.hxml and $t-f32.hxml, or absent from both); remove the entry from $allowlist"
    fail=1
done

mapfile -t un_keys < <(printf '%s\n' ${UNROOT_REASON[@]+"${!UNROOT_REASON[@]}"} | sort)
for key in ${un_keys[@]+"${un_keys[@]}"}; do
    [ -z "$key" ] && continue
    t="${key%%|*}"; m="${key#*|}"
    if [ -z "${UNROOT_USED[$key]:-}" ]; then
        echo "FAIL: stale unrootedTestModules declaration: {target=$t, module=$m} is no longer unrooted (it is a root of a $t pair); remove the entry from $allowlist"
        fail=1
    fi
    if ! resolve_module "$m"; then
        echo "FAIL: allowlist module $m (declared for $t) does not resolve to any .hx on the guarded classpaths or anywhere under $repo"
        fail=1
    fi
done

for key in ${ex_keys[@]+"${ex_keys[@]}"}; do
    [ -z "$key" ] && continue
    m="${key#*|}"
    if ! resolve_module "$m"; then
        echo "FAIL: allowlist module $m (declared for ${key%%|*}) does not resolve to any .hx on the guarded classpaths or anywhere under $repo"
        fail=1
    fi
done

if [ "$dup_lines" -gt 0 ]; then
    echo "SUMMARY: $dup_lines duplicate root line(s) reported above (non-fatal; --strict-duplicates makes them fatal)"
fi
if [ "$fail" -ne 0 ]; then
    echo "roots guard: FAILED"
    exit 1
fi
echo "roots guard: PASS ($exemptions exemption(s) in force; $unrooted_decls declared unrooted @:test module(s); $dup_lines duplicate root line(s) reported)"
exit 0
