#![cfg(test)]

use crate::boring::switch_case_scope_ops::SwitchCaseScopeOps;
use crate::boring::switch_case_scope_ops::ToneKind;
use crate::runtime::test as testlib;
use crate::runtime::test_core;
use crate::runtime::u_string::UStr;


#[test]
fn test_tone_row() {
    testlib::run("tests.SwitchCaseScopeTests.testToneRow", "tests.SwitchCaseScopeTests.testToneRow: multiple cases declaring the same name resolve without collision", || {
        test_core::TestCore::test_core_equals_int(0i32, i32::from_ne_bytes(((SwitchCaseScopeOps::switch_case_scope_ops_tone_row(ToneKind::Yinping, 5)) as i32).to_ne_bytes()), UStr::new(&[]));
        test_core::TestCore::test_core_equals_int(10i32, i32::from_ne_bytes(((SwitchCaseScopeOps::switch_case_scope_ops_tone_row(ToneKind::Yangping, 5)) as i32).to_ne_bytes()), UStr::new(&[]));
        test_core::TestCore::test_core_equals_int(15i32, i32::from_ne_bytes(((SwitchCaseScopeOps::switch_case_scope_ops_tone_row(ToneKind::Shang, 5)) as i32).to_ne_bytes()), UStr::new(&[]));
        test_core::TestCore::test_core_equals_int(20i32, i32::from_ne_bytes(((SwitchCaseScopeOps::switch_case_scope_ops_tone_row(ToneKind::Qu, 5)) as i32).to_ne_bytes()), UStr::new(&[]));
        test_core::TestCore::test_core_equals_int(0i32, i32::from_ne_bytes(((SwitchCaseScopeOps::switch_case_scope_ops_tone_row(ToneKind::Neutral, 5)) as i32).to_ne_bytes()), UStr::new(&[]));
        test_core::TestCore::test_core_equals_int(25i32, i32::from_ne_bytes(((SwitchCaseScopeOps::switch_case_scope_ops_tone_row(ToneKind::Ru, 5)) as i32).to_ne_bytes()), UStr::new(&[]));
    });
}

#[test]
fn test_tone_ink() {
    testlib::run("tests.SwitchCaseScopeTests.testToneInk", "tests.SwitchCaseScopeTests.testToneInk: cases declaring multiple locals resolve without collision", || {
        test_core::TestCore::test_core_equals_float(0.0f32, SwitchCaseScopeOps::switch_case_scope_ops_tone_ink(ToneKind::Yinping, 1.0f32, 2.0f32), UStr::new(&[]));
        test_core::TestCore::test_core_equals_float(3.0f32, SwitchCaseScopeOps::switch_case_scope_ops_tone_ink(ToneKind::Yangping, 1.0f32, 2.0f32), UStr::new(&[]));
        test_core::TestCore::test_core_equals_float(6.0f32, SwitchCaseScopeOps::switch_case_scope_ops_tone_ink(ToneKind::Shang, 1.0f32, 2.0f32), UStr::new(&[]));
        test_core::TestCore::test_core_equals_float(9.0f32, SwitchCaseScopeOps::switch_case_scope_ops_tone_ink(ToneKind::Qu, 1.0f32, 2.0f32), UStr::new(&[]));
        test_core::TestCore::test_core_equals_float(0.0f32, SwitchCaseScopeOps::switch_case_scope_ops_tone_ink(ToneKind::Neutral, 1.0f32, 2.0f32), UStr::new(&[]));
        test_core::TestCore::test_core_equals_float(12.0f32, SwitchCaseScopeOps::switch_case_scope_ops_tone_ink(ToneKind::Ru, 1.0f32, 2.0f32), UStr::new(&[]));
    });
}

#[test]
fn test_mixed() {
    testlib::run("tests.SwitchCaseScopeTests.testMixed", "tests.SwitchCaseScopeTests.testMixed: mixed declaring and non-declaring cases coexist", || {
        test_core::TestCore::test_core_equals_int(1i32, i32::from_ne_bytes(((SwitchCaseScopeOps::switch_case_scope_ops_mixed(ToneKind::Yinping, 5)) as i32).to_ne_bytes()), UStr::new(&[]));
        test_core::TestCore::test_core_equals_int(2i32, i32::from_ne_bytes(((SwitchCaseScopeOps::switch_case_scope_ops_mixed(ToneKind::Yangping, 5)) as i32).to_ne_bytes()), UStr::new(&[]));
        test_core::TestCore::test_core_equals_int(15i32, i32::from_ne_bytes(((SwitchCaseScopeOps::switch_case_scope_ops_mixed(ToneKind::Shang, 5)) as i32).to_ne_bytes()), UStr::new(&[]));
        test_core::TestCore::test_core_equals_int(25i32, i32::from_ne_bytes(((SwitchCaseScopeOps::switch_case_scope_ops_mixed(ToneKind::Qu, 5)) as i32).to_ne_bytes()), UStr::new(&[]));
        test_core::TestCore::test_core_equals_int(3i32, i32::from_ne_bytes(((SwitchCaseScopeOps::switch_case_scope_ops_mixed(ToneKind::Neutral, 5)) as i32).to_ne_bytes()), UStr::new(&[]));
        test_core::TestCore::test_core_equals_int(35i32, i32::from_ne_bytes(((SwitchCaseScopeOps::switch_case_scope_ops_mixed(ToneKind::Ru, 5)) as i32).to_ne_bytes()), UStr::new(&[]));
    });
}
