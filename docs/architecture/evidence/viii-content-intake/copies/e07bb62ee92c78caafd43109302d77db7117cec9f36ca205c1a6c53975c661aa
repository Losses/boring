package boring

object JvmFieldPrivateOps {
    @JvmField
    var publicTag: Int = 1
    private var privateTag: Int = 2
    @JvmField
    internal var allowTag: Int = 3

    fun resolve(): String {
        return (JvmFieldPrivateOps.privateTag).toString() + ":" + JvmFieldPrivateOps.publicTag + ":" + JvmFieldPrivateOps.allowTag
    }
}
