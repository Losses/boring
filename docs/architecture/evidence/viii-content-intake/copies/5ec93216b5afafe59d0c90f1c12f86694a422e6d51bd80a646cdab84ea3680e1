package tests

import boring.NumericWidenOps
import boring.SwitchMergeValue
import boring.runtime.test.Test

class NumericWidenTests {
@boring.test.Test
    fun testOperands() {
        Test.run("tests.NumericWidenTests.testOperands", "tests.NumericWidenTests.testOperands: Int operands widen for Float arithmetic") {
                Test.equals(3.5, NumericWidenOps.operandFloat(), null)
                Test.equals(3.5, NumericWidenOps.operandDouble(), null)
        }
    }

@boring.test.Test
    fun testReturns() {
        Test.run("tests.NumericWidenTests.testReturns", "tests.NumericWidenTests.testReturns: Int returns widen for Float results") {
                Test.equals(2.0, NumericWidenOps.returnFloat(), null)
                Test.equals(2.0, NumericWidenOps.returnDouble(), null)
        }
    }

@boring.test.Test
    fun testAssignments() {
        Test.run("tests.NumericWidenTests.testAssignments", "tests.NumericWidenTests.testAssignments: Int assignments widen for Float locals") {
                Test.equals(2.0, NumericWidenOps.assignFloat(), null)
                Test.equals(2.0, NumericWidenOps.assignDouble(), null)
                Test.equals(2.5, NumericWidenOps.appliedFloat(), null)
                Test.equals(1.0, NumericWidenOps.appliedDouble(), null)
        }
    }

@boring.test.Test
    fun testNullableConditional() {
        Test.run("tests.NumericWidenTests.testNullableConditional", "tests.NumericWidenTests.testNullableConditional: Nullable conditional arms widen for Float results") {
                Test.equals(2.5, NumericWidenOps.nullableConditional(2.5), null)
                Test.equals(0.0, NumericWidenOps.nullableConditional(null), null)
        }
    }

@boring.test.Test
    fun testBranchMerges() {
        Test.run("tests.NumericWidenTests.testBranchMerges", "tests.NumericWidenTests.testBranchMerges: Conditional and switch arms widen for Float results") {
                Test.equals(1.5, NumericWidenOps.conditionalMerge(true), null)
                Test.equals(2.0, NumericWidenOps.conditionalMerge(false), null)
                Test.equals(1.5, NumericWidenOps.switchMerge(SwitchMergeValue.First(1)), null)
                Test.equals(2.0, NumericWidenOps.switchMerge(SwitchMergeValue.Second(1)), null)
                Test.equals(0.5, NumericWidenOps.switchMerge(SwitchMergeValue.Third), null)
        }
    }
}
