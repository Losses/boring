        return Err(E2Fault::Two { tag: tag.to_ustring() });
    }

    pub fn two_emit_probe_must_throw_e1(tag: &UStr) -> Result<(), E1Fault> {
        return Err(E1Fault::One { tag: tag.to_ustring() });
    }

