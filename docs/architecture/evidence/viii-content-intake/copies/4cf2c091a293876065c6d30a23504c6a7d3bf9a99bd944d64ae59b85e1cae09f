            Ok(())
        })();
        match __outcome {
            Ok(_) => {}
            Err(e) => {
                let h: u32 = match (|| -> Result<u32, E1Fault> {
                    return Err(E1Fault::E1Fault(E1::new(e)));
                })() {
                    Ok(__value) => __value,
                    Err(e2) => 5,
                };
                v = h;
            }
        }
        return v;
    }

