use crate::runtime::u_string::UStr;
use crate::runtime::u_string::UString;


#[derive(Debug, Clone, PartialEq)]
pub enum E2Fault {
    Two { tag: UString },
}

impl std::fmt::Display for E2Fault {
    fn fmt(&self, formatter: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        match self {
            E2Fault::Two { tag } => {
                write!(formatter, "{}", tag)
            }
        }
    }
}

impl std::error::Error for E2Fault {}

#[derive(Debug, Clone, PartialEq)]
pub enum E1Fault {
    One { tag: UString },
}

impl std::fmt::Display for E1Fault {
