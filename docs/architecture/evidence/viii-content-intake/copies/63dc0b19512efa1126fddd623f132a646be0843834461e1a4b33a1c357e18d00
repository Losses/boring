#![cfg(test)]

use crate::boring::capture_switch_ops::CaptureSwitchOps;
use crate::boring::capture_switch_ops::CaptureSwitchValue;
use crate::boring::capture_switch_ops::NoSuchElementError;
use crate::runtime::test as testlib;
use crate::runtime::test_core;
use crate::runtime::u_string::UStr;
use crate::runtime::u_string::UString;


#[test]
fn test_describe() {
    testlib::run("tests.CaptureSwitchOpsTests.testDescribe", "tests.CaptureSwitchOpsTests.testDescribe: single captured switch forwards a return payload", || {
        test_core::TestCore::test_core_equals_string(UStr::new(&[103,111,110,101]), CaptureSwitchOps::capture_switch_ops_describe(NoSuchElementError::Message { text: UString::from("gone") }).as_ustr(), UStr::new(&[]));
    });
}

#[test]
fn test_initialized() {
    testlib::run("tests.CaptureSwitchOpsTests.testInitialized", "tests.CaptureSwitchOpsTests.testInitialized: single captured switch works in an initializer", || {
        test_core::TestCore::test_core_equals_string(UStr::new(&[114,101,97,100,121]), CaptureSwitchOps::capture_switch_ops_initialized(NoSuchElementError::Message { text: UString::from("ready") }).as_ustr(), UStr::new(&[]));
    });
}

#[test]
fn test_classify() {
    testlib::run("tests.CaptureSwitchOpsTests.testClassify", "tests.CaptureSwitchOpsTests.testClassify: multi-case captured switch remains available", || {
        test_core::TestCore::test_core_equals_int(3i32, i32::from_ne_bytes(((CaptureSwitchOps::capture_switch_ops_classify(CaptureSwitchValue::Text { value: UString::from("abc") })) as i32).to_ne_bytes()), UStr::new(&[]));
        test_core::TestCore::test_core_equals_int(8i32, i32::from_ne_bytes(((CaptureSwitchOps::capture_switch_ops_classify(CaptureSwitchValue::Number { value: 7 })) as i32).to_ne_bytes()), UStr::new(&[]));
    });
}

#[test]
fn test_message_length() {
    testlib::run("tests.CaptureSwitchOpsTests.testMessageLength", "tests.CaptureSwitchOpsTests.testMessageLength: single captured payload supports an operation", || {
        test_core::TestCore::test_core_equals_int(5i32, i32::from_ne_bytes(((CaptureSwitchOps::capture_switch_ops_message_length(NoSuchElementError::Message { text: UString::from("test") })) as i32).to_ne_bytes()), UStr::new(&[]));
    });
}
