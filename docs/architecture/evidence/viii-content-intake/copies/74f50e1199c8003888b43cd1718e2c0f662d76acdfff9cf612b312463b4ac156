package tests

import boring.UStringOps
import boring.runtime.UString
import boring.runtime.test.Test

class UStringTests {
@boring.test.Test
    fun testAsciiTier() {
        Test.run("tests.UStringTests.testAsciiTier", "tests.UStringTests.testAsciiTier: ascii content counts and reads through the general tier") {
                Test.equals(6, UStringOps.asciiCount(), null)
                Test.equals(116, UStringOps.codeAt("tiqian", 0), null)
                Test.equals(null, UStringOps.codeAt("tiqian", 6), null)
        }
    }

@boring.test.Test
    fun testBmpTier() {
        Test.run("tests.UStringTests.testBmpTier", "tests.UStringTests.testBmpTier: bmp cjk counts and reads by code point") {
                Test.equals(4, UStringOps.bmpCount(), null)
                Test.equals(25552, UStringOps.codeAt("提椠排版", 0), null)
                Test.equals(26912, UStringOps.codeAt("提椠排版", 1), null)
                Test.equals(29256, UStringOps.codeAt("提椠排版", 3), null)
                Test.equals(null, UStringOps.codeAt("提椠排版", 4), null)
        }
    }

@boring.test.Test
    fun testSupplementaryTier() {
        Test.run("tests.UStringTests.testSupplementaryTier", "tests.UStringTests.testSupplementaryTier: supplementary cjk occupies one character index") {
                Test.equals(3, UStringOps.supplementaryCount(), null)
                Test.equals(131072, UStringOps.codeAt("𠀀一𠀁", 0), null)
                Test.equals(19968, UStringOps.codeAt("𠀀一𠀁", 1), null)
                Test.equals(131073, UStringOps.codeAt("𠀀一𠀁", 2), null)
                Test.equals(null, UStringOps.codeAt("𠀀一𠀁", 3), null)
        }
    }

@boring.test.Test
    fun testSlice() {
        Test.run("tests.UStringTests.testSlice", "tests.UStringTests.testSlice: slice addresses characters on every storage") {
                Test.equals("椠排", UStringOps.middleSlice("提椠排版"), null)
                Test.equals("一𠀁", UStringOps.middleSlice("𠀀一𠀁"), null)
                Test.equals("提椠排版", UStringOps.clampedSlice("提椠排版"), null)
        }
    }

@boring.test.Test
    fun testRoundTrip() {
        Test.run("tests.UStringTests.testRoundTrip", "tests.UStringTests.testRoundTrip: code point round trip preserves content") {
                Test.equals("提椠排版", UStringOps.roundTrip("提椠排版"), null)
                Test.equals("𠀀一𠀁", UStringOps.roundTrip("𠀀一𠀁"), null)
                Test.equals("𠀀", UString.fromCodePoint(131072), null)
                Test.equals("一", UString.fromCodePoint(19968), null)
        }
    }

@boring.test.Test
    fun testReversal() {
        Test.run("tests.UStringTests.testReversal", "tests.UStringTests.testReversal: character reversal keeps supplementary characters whole") {
                Test.equals("版排椠提", UStringOps.reversedText("提椠排版"), null)
                Test.equals("𠀁一𠀀", UStringOps.reversedText("𠀀一𠀁"), null)
        }
    }

@boring.test.Test
    fun testSubstring() {
        Test.run("tests.UStringTests.testSubstring", "tests.UStringTests.testSubstring: substring addresses utf-16 unit positions on every target") {
                Test.equals("椠排", UStringOps.substringRange("提椠排版", 1, 3), null)
                Test.equals("𠀀", UStringOps.substringRange("𠀀一𠀁", 0, 2), null)
                Test.equals("一", UStringOps.substringRange("𠀀一𠀁", 2, 3), null)
                Test.equals("一𠀁", UStringOps.substringRange("𠀀一𠀁", 2, 5), null)
                Test.equals("𠀁", UStringOps.substringFrom("𠀀一𠀁", 3), null)
                Test.equals("iq", UStringOps.substringLiteral(), null)
        }
    }

@boring.test.Test
    fun testSubstringBounds() {
        Test.run("tests.UStringTests.testSubstringBounds", "tests.UStringTests.testSubstringBounds: substring clamps negative, long, reversed, and omitted bounds") {
                Test.equals("abc", UStringOps.substringNegativeStart(), null)
                Test.equals("cdef", UStringOps.substringLongEnd(), null)
                Test.equals("cde", UStringOps.substringSwappedBounds(), null)
                Test.equals("abcdef", UStringOps.substringOmittedEnd(), null)
        }
    }
}
