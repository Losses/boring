#!/usr/bin/env python3
"""Compare two unique-failing-name census files produced by parse-failures.py."""
import sys
from collections import OrderedDict


def names(path):
    out = []
    in_block = False
    for line in open(path, encoding="utf-8", errors="replace"):
        line = line.rstrip("\n")
        if line.startswith("=== unique failing test names"):
            in_block = True
            continue
        if in_block:
            if line.startswith("=== "):
                break
            if line.strip():
                out.append(line)
    return out


before, after = names(sys.argv[1]), names(sys.argv[2])
bs, as_ = set(before), set(after)
print(f"before file: {sys.argv[1]}")
print(f"after  file: {sys.argv[2]}")
print()
print(f"before unique failing names: {len(bs)}")
print(f"after  unique failing names: {len(as_)}")
print()
flipped = sorted(bs - as_)
new = sorted(as_ - bs)
common = sorted(bs & as_)
print(f"FIXED (failing before, passing after): {len(flipped)}")
for n in flipped:
    print(f"  - {n}")
print()
print(f"NEW (passing before, failing after): {len(new)}")
for n in new:
    print(f"  + {n}")
print()
print(f"UNCHANGED (failing in both): {len(common)}")
for n in common:
    print(f"  = {n}")
