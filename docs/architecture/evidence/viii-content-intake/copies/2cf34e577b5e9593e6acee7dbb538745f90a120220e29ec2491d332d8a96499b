#![cfg(test)]

use crate::boring::signed_int_argument_ops::SignedIntArgumentOps;
use crate::runtime::test as testlib;
use crate::runtime::test_core;
use crate::runtime::u_string::UStr;


#[test]
fn from_index() {
    testlib::run("tests.SignedIntArgumentTests.fromIndex", "tests.SignedIntArgumentTests.fromIndex: a negated signed index reinterprets into an owned u32 parameter", || {
        test_core::TestCore::test_core_equals_int(5i32, i32::from_ne_bytes(((SignedIntArgumentOps::signed_int_argument_ops_from_index(UStr::new(&[120,98,99]), 5)) as i32).to_ne_bytes()), UStr::new(&[]));
        test_core::TestCore::test_core_equals_int(6i32, i32::from_ne_bytes(((SignedIntArgumentOps::signed_int_argument_ops_from_index(UStr::new(&[97,98,99]), 5)) as i32).to_ne_bytes()), UStr::new(&[]));
    });
}

#[test]
fn shifted() {
    testlib::run("tests.SignedIntArgumentTests.shifted", "tests.SignedIntArgumentTests.shifted: a signed wrapping sum reinterprets into an owned u32 parameter", || {
        test_core::TestCore::test_core_equals_int(10i32, i32::from_ne_bytes(((SignedIntArgumentOps::signed_int_argument_ops_shifted(UStr::new(&[120,98,99]), 5)) as i32).to_ne_bytes()), UStr::new(&[]));
        test_core::TestCore::test_core_equals_int(9i32, i32::from_ne_bytes(((SignedIntArgumentOps::signed_int_argument_ops_shifted(UStr::new(&[97,98,99]), 5)) as i32).to_ne_bytes()), UStr::new(&[]));
    });
}
