#[derive(Clone, Copy)]
pub struct NumericConversionWidening;

impl NumericConversionWidening {
    pub fn numeric_conversion_widening_compare_equal(a: f32, b: u32) -> bool {
        return a == i32::from_ne_bytes(((b) as i32).to_ne_bytes()) as f32;
    }

    pub fn numeric_conversion_widening_compare_not_equal(a: f32, b: u32) -> bool {
        return a != i32::from_ne_bytes(((b) as i32).to_ne_bytes()) as f32;
    }

    pub fn numeric_conversion_widening_return_int_as_float(x: u32) -> f32 {
        return i32::from_ne_bytes(((x) as i32).to_ne_bytes()) as f32;
    }

    pub fn numeric_conversion_widening_init_float() -> f32 {
        let x = 16 as f32;
        return x;
    }

    pub fn numeric_conversion_widening_assign_int_to_float() -> f32 {
        let x = 42 as f32;
        return x;
    }

    pub fn numeric_conversion_widening_float_param(value: f32) -> f32 {
        return value + 1.0f32;
    }

    pub fn numeric_conversion_widening_call_float_param() -> f32 {
        return NumericConversionWidening::numeric_conversion_widening_float_param(8 as f32);
    }
}
