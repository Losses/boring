package tests

import boring.InlineDefaultOps
import boring.runtime.test.Test

class InlineDefaultTests {
@boring.test.Test
    fun testInlineDefaults() {
        Test.run("tests.InlineDefaultTests.testInlineDefaults", "tests.InlineDefaultTests.testInlineDefaults: inlined data-class defaults preserve static paths and parameter bindings") {
                val value = InlineDefaultOps(7)
                Test.equals(0, value.marker, null)
                Test.equals(7, value.count, null)
        }
    }
}
