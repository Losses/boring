#![cfg(test)]

use crate::boring::numeric_domain_ops::NumericDomainOps;
use crate::runtime::test as testlib;
use crate::runtime::test_core;
use crate::runtime::u_string::UStr;


#[test]
fn test_prefix_unit() {
    testlib::run("tests.NumericDomainTests.testPrefixUnit", "tests.NumericDomainTests.testPrefixUnit: A positive-checked index stays unsigned in charCodeAt", || {
        test_core::TestCore::test_core_equals_int(65i32, i32::from_ne_bytes(((NumericDomainOps::numeric_domain_ops_prefix_unit(UStr::new(&[65,66]), 1)) as i32).to_ne_bytes()), UStr::new(&[]));
        test_core::TestCore::test_core_equals_int(0i32, i32::from_ne_bytes(((NumericDomainOps::numeric_domain_ops_prefix_unit(UStr::new(&[65,66]), 0)) as i32).to_ne_bytes()), UStr::new(&[]));
    });
}

#[test]
fn test_offsets() {
    testlib::run("tests.NumericDomainTests.testOffsets", "tests.NumericDomainTests.testOffsets: Loop offsets stay in the u32 domain", || {
        test_core::TestCore::test_core_equals_int(3i32, i32::from_ne_bytes(((u32::try_from((NumericDomainOps::numeric_domain_ops_offsets(UStr::new(&[97,98,99,100])).len()) & 0xFFFF_FFFF).unwrap_or(0)) as i32).to_ne_bytes()), UStr::new(&[]));
        test_core::TestCore::test_core_equals_int(1i32, { let v: u32 = NumericDomainOps::numeric_domain_ops_offsets(UStr::new(&[97,98,99,100]))[0usize]; i32::from_ne_bytes(v.to_ne_bytes()) }, UStr::new(&[]));
        test_core::TestCore::test_core_equals_int(3i32, { let v: u32 = NumericDomainOps::numeric_domain_ops_offsets(UStr::new(&[97,98,99,100]))[2usize]; i32::from_ne_bytes(v.to_ne_bytes()) }, UStr::new(&[]));
    });
}

#[test]
fn test_find_index() {
    testlib::run("tests.NumericDomainTests.testFindIndex", "tests.NumericDomainTests.testFindIndex: A negative sentinel local assigns from a u32 loop index", || {
        test_core::TestCore::test_core_equals_int(30i32, i32::from_ne_bytes(((NumericDomainOps::numeric_domain_ops_find_index(&vec![10, 20, 30], 30)) as i32).to_ne_bytes()), UStr::new(&[]));
        test_core::TestCore::test_core_equals_int(0i32, i32::from_ne_bytes(((NumericDomainOps::numeric_domain_ops_find_index(&vec![10, 20, 30], 99)) as i32).to_ne_bytes()), UStr::new(&[]));
    });
}

#[test]
fn test_before_char() {
    testlib::run("tests.NumericDomainTests.testBeforeChar", "tests.NumericDomainTests.testBeforeChar: An i32 index reaches the u32 charCodeAt slot", || {
        test_core::TestCore::test_core_equals_int(65i32, i32::from_ne_bytes(((NumericDomainOps::numeric_domain_ops_before_char(UStr::new(&[65,66]), 2)) as i32).to_ne_bytes()), UStr::new(&[]));
    });
}

#[test]
fn test_colon_pair() {
    testlib::run("tests.NumericDomainTests.testColonPair", "tests.NumericDomainTests.testColonPair: An i32 indexOf result feeds a u32 vec literal", || {
        let pair = NumericDomainOps::numeric_domain_ops_colon_pair(UStr::new(&[97,58,98]), 0);
        test_core::TestCore::test_core_equals_int(2i32, i32::from_ne_bytes(((u32::try_from((pair.len()) & 0xFFFF_FFFF).unwrap_or(0)) as i32).to_ne_bytes()), UStr::new(&[]));
        test_core::TestCore::test_core_equals_int(0i32, { let v: u32 = pair[0usize]; i32::from_ne_bytes(v.to_ne_bytes()) }, UStr::new(&[]));
        test_core::TestCore::test_core_equals_int(2i32, { let v: u32 = pair[1usize]; i32::from_ne_bytes(v.to_ne_bytes()) }, UStr::new(&[]));
        test_core::TestCore::test_core_equals_int(0i32, i32::from_ne_bytes(((u32::try_from((NumericDomainOps::numeric_domain_ops_colon_pair(UStr::new(&[97,98]), 0).len()) & 0xFFFF_FFFF).unwrap_or(0)) as i32).to_ne_bytes()), UStr::new(&[]));
    });
}

#[test]
fn test_collect_offsets() {
    testlib::run("tests.NumericDomainTests.testCollectOffsets", "tests.NumericDomainTests.testCollectOffsets: An i32 offset pushes into a u32 array", || {
        test_core::TestCore::test_core_equals_int(3i32, i32::from_ne_bytes(((u32::try_from((NumericDomainOps::numeric_domain_ops_collect_offsets(UStr::new(&[97,98,99,100])).len()) & 0xFFFF_FFFF).unwrap_or(0)) as i32).to_ne_bytes()), UStr::new(&[]));
        test_core::TestCore::test_core_equals_int(1i32, { let v: u32 = NumericDomainOps::numeric_domain_ops_collect_offsets(UStr::new(&[97,98,99,100]))[0usize]; i32::from_ne_bytes(v.to_ne_bytes()) }, UStr::new(&[]));
    });
}
