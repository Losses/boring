package tests

import boring.Int64Ops
import boring.runtime.test.Test

class Int64Tests {
@boring.test.Test
    fun construction() {
        Test.run("tests.Int64Tests.construction", "tests.Int64Tests.construction: constructs and extracts 64-bit words") {
                val value = ((305419896L shl 32) or (-1698898192L and 0xFFFFFFFFL))
                Test.equals(305419896, Int64Ops.high(value), null)
                Test.equals(-1698898192, Int64Ops.low(value), null)
        }
    }

@boring.test.Test
    fun carry() {
        Test.run("tests.Int64Tests.carry", "tests.Int64Tests.carry: wraps addition across the low word") {
                val value = Int64Ops.carry()
                Test.equals(1, Int64Ops.high(value), null)
                Test.equals(0, Int64Ops.low(value), null)
        }
    }

@boring.test.Test
    fun multiplication() {
        Test.run("tests.Int64Tests.multiplication", "tests.Int64Tests.multiplication: wraps Int64 multiplication") {
                val value = Int64Ops.mulAnchors()
                Test.equals(-554476799, Int64Ops.high(value), null)
                Test.equals(259615913, Int64Ops.low(value), null)
                val negative = ((-1L shl 32) or (-1L and 0xFFFFFFFFL)) * ((-1L shl 32) or (-1L and 0xFFFFFFFFL))
                Test.equals(0, Int64Ops.high(negative), null)
                Test.equals(1, Int64Ops.low(negative), null)
                val mixed = Int64Ops.mulIntAnchor(((0L shl 32) or (5L and 0xFFFFFFFFL)))
                Test.equals(0, Int64Ops.high(mixed), null)
                Test.equals(15, Int64Ops.low(mixed), null)
                val direct = ((0L shl 32) or (3L and 0xFFFFFFFFL)) * ((0L shl 32) or (5L and 0xFFFFFFFFL))
                Test.equals(0, Int64Ops.high(direct), null)
                Test.equals(15, Int64Ops.low(direct), null)
        }
    }

@boring.test.Test
    fun ordering() {
        Test.run("tests.Int64Tests.ordering", "tests.Int64Tests.ordering: compares signed Int64 values at limits and across zero") {
                val negative = -1.toLong()
                val zero = 0.toLong()
                val equal = 7.toLong()
                val maximum = ((2147483647L shl 32) or (-1L and 0xFFFFFFFFL))
                val minimum = ((-2147483648L shl 32) or (0L and 0xFFFFFFFFL))
                Test.equals(true, Int64Ops.below(negative, zero), null)
                Test.equals(true, Int64Ops.atOrBelow(equal, equal), null)
                Test.equals(true, equal >= equal, null)
                Test.equals(true, Int64Ops.below(minimum, maximum), null)
                Test.equals(true, maximum >= minimum, null)
                Test.equals(true, maximum > minimum, null)
                Test.equals(true, Int64Ops.below(negative, zero), null)
                Test.equals(true, zero <= zero, null)
        }
    }

@boring.test.Test
    fun operations() {
        Test.run("tests.Int64Tests.operations", "tests.Int64Tests.operations: keeps rotate and bitwise operations at 64 bits") {
                val value = ((305419896L shl 32) or (-1698898192L and 0xFFFFFFFFL))
                val rotated = Int64Ops.rotate(value, 32)
                Test.equals(-1698898192, Int64Ops.high(rotated), null)
                Test.equals(305419896, Int64Ops.low(rotated), null)
                val mixed = Int64Ops.bitMix(value)
                Test.equals(-1197540142, Int64Ops.high(mixed), null)
                Test.equals(-806777947, Int64Ops.low(mixed), null)
        }
    }
}
