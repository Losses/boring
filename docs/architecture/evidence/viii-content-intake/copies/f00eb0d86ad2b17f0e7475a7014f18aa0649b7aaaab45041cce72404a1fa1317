#!/usr/bin/env bash
# Run a single bun test file inside a given execution root, same environment as
# the harness stage 4. Usage: run-one-test.sh <ABS-ROOT> <LABEL> <test-file...>
set -u
ROOT="${1:?}"; LABEL="${2:?}"; shift 2
ENVJSON=/home/losses/Development/tq-workspace/dc-warn/out/chainA-fixed-rerun/evidence/env.json
OUTDIR="$ROOT/out/targeted-$LABEL"
mkdir -p "$OUTDIR"
get() { sed -n "s|^$1=||p" "$ENVJSON" | head -1; }
export PATH="$(get PATH)"
export HAXELIB_PATH="$ROOT/.haxelib"
export XDG_CACHE_HOME="$ROOT/out/xdg-cache"
export GIT_CEILING_DIRECTORIES="$ROOT"
export BORING_SWIFT_SYSTEM_PACKAGE="$(get BORING_SWIFT_SYSTEM_PACKAGE)"
export BORING_SWIFT_LIBDISPATCH="$(get BORING_SWIFT_LIBDISPATCH)"
export BORING_SWIFT_DYNAMIC_LINKER="$(get BORING_SWIFT_DYNAMIC_LINKER)"
export SWIFT_SHIM_STATE="$(get SWIFT_SHIM_STATE)"
unset LD_LIBRARY_PATH HAXE_STD_PATH
export TMPDIR="$OUTDIR/tmpdir"; mkdir -p "$TMPDIR"
cd "$ROOT" || exit 90
{
  echo "root=$ROOT label=$LABEL utc=$(date -uIs)"
  echo "uptime-before: $(uptime)"
  echo "argv: bun test $*"
  echo "concurrent full suites: $(ps -eo args | grep -c '^bun test tests/ packages/registry/tests/')"
} >>"$OUTDIR/meta.txt"
bun test "$@" >"$OUTDIR/stdout" 2>"$OUTDIR/stderr"
rc=$?
echo "$rc" >"$OUTDIR/rc"
{ echo "rc=$rc"; echo "uptime-after: $(uptime)"; } >>"$OUTDIR/meta.txt"
echo "rc=$rc (see $OUTDIR/stdout)"
