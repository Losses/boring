#[test]
fn test_string_key_order() {
    testlib::run("tests.SortedKeyDomainTests.testStringKeyOrder", "tests.SortedKeyDomainTests.testStringKeyOrder: String keys UTF-16 code unit ordering with astral and high BMP", || {
        let expected = UString::from("ASCII=1; ퟿=2; 𐀀=3; 􏿿=4; =5; ￿=6").to_ustring();
        test_core::TestCore::test_core_equals_string(expected.as_ustr(), ScriptNames::script_names_describe_order().as_ustr(), UStr::new(&[83,116,114,105,110,103,32,107,101,121,32,116,114,97,118,101,114,115,97,108,32,109,97,116,99,104,101,115,32,85,84,70,45,49,54,32,99,111,100,101,32,117,110,105,116,32,111,114,100,101,114]));
    });
}

#[test]
fn test_string_key_lookup() {
    testlib::run("tests.SortedKeyDomainTests.testStringKeyLookup", "tests.SortedKeyDomainTests.testStringKeyLookup: String key lookup hits and misses", || {
        assert_equals_opt(&Some(1), &ScriptNames::script_names_code_of(UStr::new(&[65,83,67,73,73])), UStr::new(&[65,83,67,73,73,32,104,105,116]));
        assert_equals_opt(&Some(2), &ScriptNames::script_names_code_of(UStr::new(&[55295])), UStr::new(&[68,55,70,70,32,104,105,116]));
        assert_equals_opt(&Some(3), &ScriptNames::script_names_code_of(UStr::new(&[55296,56320])), UStr::new(&[49,48,48,48,48,32,104,105,116]));
        assert_equals_opt(&Some(4), &ScriptNames::script_names_code_of(UStr::new(&[56319,57343])), UStr::new(&[49,48,70,70,70,70,32,104,105,116]));
        assert_equals_opt(&Some(5), &ScriptNames::script_names_code_of(UStr::new(&[57344])), UStr::new(&[69,48,48,48,32,104,105,116]));
        assert_equals_opt(&Some(6), &ScriptNames::script_names_code_of(UStr::new(&[65535])), UStr::new(&[70,70,70,70,32,104,105,116]));
        assert_equals_opt(&None::<u32>, &ScriptNames::script_names_code_of(UStr::new(&[77,73,83,83,73,78,71])), UStr::new(&[117,110,109,97,112,112,101,100,32,65,83,67,73,73,32,107,101,121,32,109,105,115,115]));
        assert_equals_opt(&None::<u32>, &ScriptNames::script_names_code_of(UStr::new(&[55296,56321])), UStr::new(&[117,110,109,97,112,112,101,100,32,97,115,116,114,97,108,32,107,101,121,32,109,105,115,115]));
    });
}

