#[test]
fn test_structure_key_lookup() {
    testlib::run("tests.SortedKeyDomainTests.testStructureKeyLookup", "tests.SortedKeyDomainTests.testStructureKeyLookup: Structure key lookup hits and misses", || {
        let hit_tag = ClusterTag { name: UString::from("alpha").to_ustring(), score: 10, sub: SubTag { priority: 1 }, active: true };
        let miss_tag = ClusterTag { name: UString::from("alpha").to_ustring(), score: 10, sub: SubTag { priority: 99 }, active: true };
        assert_equals_opt(&Some(400), &ClusterTags::cluster_tags_tag_score((hit_tag).clone()), UStr::new(&[101,120,105,115,116,105,110,103,32,115,116,114,117,99,116,117,114,101,32,107,101,121,32,104,105,116]));
        assert_equals_opt(&None::<u32>, &ClusterTags::cluster_tags_tag_score((miss_tag).clone()), UStr::new(&[117,110,109,97,112,112,101,100,32,115,116,114,117,99,116,117,114,101,32,107,101,121,32,109,105,115,115]));
    });
}

#[test]
fn test_structure_map_last_wins() {
    testlib::run("tests.SortedKeyDomainTests.testStructureMapLastWins", "tests.SortedKeyDomainTests.testStructureMapLastWins: Structure key SortedMap duplicate key last-put-wins", || {
        let mut b: SortedMapTableBuilder<ClusterTag, UString> = SortedTable::sorted_table_map_builder::<ClusterTag, UString>(Arc::new(compare_cluster_tag));
        let tag_a = ClusterTag { name: UString::from("tag").to_ustring(), score: 1, sub: SubTag { priority: 10 }, active: true };
        let tag_b = ClusterTag { name: UString::from("tag").to_ustring(), score: 1, sub: SubTag { priority: 10 }, active: true };
        b.put(&(tag_a), &(UString::from("first")).to_ustring());
        b.put(&(tag_b), &(UString::from("second")).to_ustring());
        let map: SortedMapTable<ClusterTag, UString> = b.clone().build();
        test_core::TestCore::test_core_equals_int(1i32, i32::from_ne_bytes(((u32::from_ne_bytes(((map.size()) as u32).to_ne_bytes())) as i32).to_ne_bytes()), UStr::new(&[109,97,112,32,115,105,122,101,32,97,102,116,101,114,32,100,117,112,108,105,99,97,116,101,32,115,116,114,117,99,116,117,114,101,32,107,101,121,32,114,101,112,108,97,99,101,109,101,110,116]));
        assert_equals_opt_string(&Some(UString::from("second")), &map.get(&(tag_a)), UStr::new(&[108,97,115,116,45,112,117,116,45,119,105,110,115,32,118,97,108,117,101,32,114,101,116,117,114,110,101,100]));
    });
}

#[test]
fn test_structure_set_operations() {
    testlib::run("tests.SortedKeyDomainTests.testStructureSetOperations", "tests.SortedKeyDomainTests.testStructureSetOperations: Structure key SortedSet deduplication and ascending ordering", || {
        let expected = UString::from("alpha:10:1:F; alpha:20:2:F; beta:10:1:T").to_ustring();
        test_core::TestCore::test_core_equals_string(expected.as_ustr(), ClusterTags::cluster_tags_describe_set_order().as_ustr(), UStr::new(&[83,111,114,116,101,100,83,101,116,32,100,101,100,117,112,108,105,99,97,116,101,100,32,101,108,101,109,101,110,116,115,32,109,97,116,99,104,32,101,120,112,101,99,116,101,100,32,111,114,100,101,114]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[49,48,44,50,48,44,49,48]), ClusterTags::cluster_tags_describe_scores().as_ustr(), UStr::new(&[105,110,100,101,120,101,100,32,115,105,122,101,40,41,32,108,111,111,112,32,99,111,108,108,101,99,116,115,32,116,104,101,32,115,99,111,114,101,115,32,105,110,32,115,101,116,32,111,114,100,101,114]));
        test_core::TestCore::test_core_equals_int(3i32, i32::from_ne_bytes(((u32::try_from((ClusterTags::cluster_tags_set_scores().len()) & 0xFFFF_FFFF).unwrap_or(0)) as i32).to_ne_bytes()), UStr::new(&[115,99,111,114,101,32,97,114,114,97,121,32,108,101,110,103,116,104,32,109,97,116,99,104,101,115,32,115,101,116,32,115,105,122,101]));
        let set: SortedSetTable<ClusterTag> = ClusterTags::cluster_tags_create_set();
        test_core::TestCore::test_core_equals_int(3i32, i32::from_ne_bytes(((u32::from_ne_bytes(((set.size()) as u32).to_ne_bytes())) as i32).to_ne_bytes()), UStr::new(&[115,101,116,32,115,105,122,101,32,97,102,116,101,114,32,100,101,100,117,112,108,105,99,97,116,105,111,110]));
        test_core::TestCore::test_core_equals_bool(true, set.has(&(ClusterTag { name: UString::from("beta").to_ustring(), score: 10, sub: SubTag { priority: 1 }, active: true })), UStr::new(&[104,97,115,32,101,120,105,115,116,105,110,103,32,101,108,101,109,101,110,116]));
        test_core::TestCore::test_core_equals_bool(false, set.has(&(ClusterTag { name: UString::from("beta").to_ustring(), score: 10, sub: SubTag { priority: 1 }, active: false })), UStr::new(&[104,97,115,32,110,111,110,45,101,120,105,115,116,105,110,103,32,101,108,101,109,101,110,116]));
    });
}
