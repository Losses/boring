#![cfg(test)]

use crate::boring::dart_null_push_ops::DartNullPushOps;
use crate::runtime::test as testlib;
use crate::runtime::test_core;
use crate::runtime::u_string::UStr;
use crate::tests::test_helper::*;


#[test]
fn push_null_keeps_null() {
    testlib::run("tests.DartNullPushTests.pushNullKeepsNull", "tests.DartNullPushTests.pushNullKeepsNull: pushing null into Array<Null<T>> keeps null at the slot", || {
        test_core::TestCore::test_core_equals_bool(true, DartNullPushOps::dart_null_push_ops_push_null_into_nullable_array().is_none(), UStr::new(&[]));
    });
}

#[test]
fn push_value_keeps_value() {
    testlib::run("tests.DartNullPushTests.pushValueKeepsValue", "tests.DartNullPushTests.pushValueKeepsValue: pushing a value into Array<Null<T>> keeps the value", || {
        assert_equals_opt(&Some(2), &DartNullPushOps::dart_null_push_ops_push_value_into_nullable_array(), UStr::new(&[]));
    });
}

#[test]
fn closure_null_stays_null() {
    testlib::run("tests.DartNullPushTests.closureNullStaysNull", "tests.DartNullPushTests.closureNullStaysNull: nullable closure returning null keeps null", || {
        test_core::TestCore::test_core_equals_bool(true, DartNullPushOps::dart_null_push_ops_nullable_closure_returns_null().is_none(), UStr::new(&[]));
    });
}

#[test]
fn closure_value_stays_value() {
    testlib::run("tests.DartNullPushTests.closureValueStaysValue", "tests.DartNullPushTests.closureValueStaysValue: nullable closure returning a value keeps the value", || {
        assert_equals_opt(&Some(7), &DartNullPushOps::dart_null_push_ops_nullable_closure_returns_value(), UStr::new(&[]));
    });
}
