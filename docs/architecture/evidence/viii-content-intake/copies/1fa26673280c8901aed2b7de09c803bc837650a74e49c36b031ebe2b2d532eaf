use crate::runtime::sorted_table::SortedTable;
use crate::runtime::u_string::UStr;
use crate::runtime::u_string::UString;


#[derive(Debug, Clone, PartialEq)]
pub struct PrintedRecord {
    pub count: u32,
    pub ratio: f32,
    pub inner: PrintedInner,
    pub note: Option<PrintedInner>,
}

impl PrintedRecord {
    pub fn new(count: u32, ratio: f32, inner: PrintedInner, note: Option<PrintedInner>) -> Self {
        Self {
            count,
            ratio,
            inner,
            note,
        }
    }

    pub fn to_string(&self) -> UString {
        return UString::from(format!("{}", { let mut __s = UString::new(); __s += &(UString::from("PrintedRecord(")); __s += &(UString::from("count=")); __s += &(UString::from((self.count).to_string().as_str())); __s += &(UString::from(", ")); __s += &(UString::from("ratio=")); __s += &(crate::runtime::fp_helper::FPHelper::format_float_f32(self.ratio)); __s += &(UString::from(", ")); __s += &(UString::from("inner=")); __s += UString::from(format!("{}", (self.inner).clone().to_string()).as_str()).as_ustr(); __s += &(UString::from(", ")); __s += &(UString::from("note=")); __s += (match &(self.note) { None => UString::from("null"), Some(__option) => UString::from(format!("{}", __option.to_string()).as_str()) }).as_ustr(); __s += &(UString::from(")")); __s }).as_str());
    }
}

#[derive(Debug, Clone, PartialEq)]
pub struct PrintedInner {
    pub name: UString,
}

impl PrintedInner {
    pub fn new(name: &UStr) -> Self {
        Self {
            name: name.to_ustring(),
        }
    }

    pub fn to_string(&self) -> UString {
        return UString::from(format!("{}", { let mut __s = UString::new(); __s += &(UString::from("PrintedInner(")); __s += &(UString::from("name=")); __s += (self.name).to_ustring().as_ustr(); __s += &(UString::from(")")); __s }).as_str());
    }
}

pub fn compare_printed_inner(a: &PrintedInner, b: &PrintedInner) -> i32 {
    let cmp_name = SortedTable::sorted_table_compare_strings((&a.name).as_ustr(), (&b.name).as_ustr());
    if cmp_name != 0 { return cmp_name; }
    0
}
