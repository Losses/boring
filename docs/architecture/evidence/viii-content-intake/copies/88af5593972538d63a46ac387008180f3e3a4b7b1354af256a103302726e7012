#!/usr/bin/env bash
# Shared library for the roots-guard cross-check cases.
# Every case is a repo-shaped tree at $S/cases/<name>/repo so that
# $here/../.. discovery, -cp resolution and the haxelib lookup are all realistic.
set -u

WS=/home/losses/Development/tq-workspace
R=$WS/boring-wt-architecture
S=$WS/rgx-scratch
OUT=$WS/dc-warn/out/roots-guard-xcheck
EV=$OUT/evidence
HARD_SH=$S/patchcheck/tools/roots-guard/check-roots-guard.sh
HARD_ALW=$S/patchcheck/tools/roots-guard/roots-allowlist.json
ORIG_SH=$R/tools/roots-guard/check-roots-guard.sh
ORIG_ALW=$R/tools/roots-guard/roots-allowlist.json

mkdir -p "$EV"

# new_case NAME VARIANT [realsamples]
#   VARIANT = hard | orig
new_case() {
    local name="$1" variant="$2" real="${3:-}"
    CASE="$S/cases/$name/repo"
    rm -rf "$S/cases/$name"
    mkdir -p "$CASE/tools/roots-guard" "$CASE/examples"
    cp -a "$R/examples/." "$CASE/examples/"
    if [ "$real" != "realrepo" ]; then
        for d in haxelib.json defines.json boring.json packages tools .haxelib docs; do
            [ -e "$R/$d" ] && ln -s "$R/$d" "$CASE/$d"
        done
    else
        for d in haxelib.json defines.json boring.json .haxelib docs; do
            [ -e "$R/$d" ] && ln -s "$R/$d" "$CASE/$d"
        done
    fi
    case "$real" in
        realsamples) cp -a "$R/samples" "$CASE/samples" ;;
        realfull)    cp -a "$R/samples" "$CASE/samples"; cp -a "$R/tests" "$CASE/tests" ;;
        realrepo)    cp -a "$R/samples" "$CASE/samples"; cp -a "$R/tests" "$CASE/tests"; cp -a "$R/tools" "$CASE/tools"; cp -a "$R/packages" "$CASE/packages" ;;
        *)           ln -s "$R/samples" "$CASE/samples"; ln -s "$R/tests" "$CASE/tests" ;;
    esac
    if [ "$variant" = "hard" ]; then
        cp "$HARD_SH" "$CASE/tools/roots-guard/check-roots-guard.sh"
        cp "$HARD_ALW" "$CASE/tools/roots-guard/roots-allowlist.json"
    else
        cp "$ORIG_SH" "$CASE/tools/roots-guard/check-roots-guard.sh"
        cp "$ORIG_ALW" "$CASE/tools/roots-guard/roots-allowlist.json"
    fi
}

# run_case NAME [extra args...]  -> runs the guard, appends exit_code= to the log
run_case() {
    local name="$1"; shift
    local log="$EV/$name.txt"
    local rc
    ( cd "$CASE" && bash tools/roots-guard/check-roots-guard.sh "$@" ) > "$log" 2>&1
    rc=$?
    printf 'exit_code=%s\n' "$rc" >> "$log"
    printf '%s\trc=%s\n' "$name" "$rc" | tee -a "$EV/rc.tsv"
}
