#!/usr/bin/env bash
# Scenario matrix for the hardened roots guard. Each case is a full copy of the
# scratch tool tree (tools/roots-guard + examples) with one mutation applied.
# rc is measured directly (never through a pipe).
set -u
ROOT=/home/losses/Development/tq-workspace/boring-wt-architecture
S=/home/losses/Development/tq-workspace/dc-warn/scratch-roots-guard
OUT=/home/losses/Development/tq-workspace/dc-warn/out/roots-guard-hardening/evidence
CASES="$S/cases"
rm -rf "$CASES"; mkdir -p "$CASES"

prep() { rm -rf "$CASES/$1"; cp -r "$S/hardened" "$CASES/$1"; }

# ---- case setup (python does the text surgery) -------------------------------
prep current

prep prefix
for t in kotlin rust swift; do (cd "$ROOT" && git show e1c65975:examples/$t-f32.hxml) > "$CASES/prefix/examples/$t-f32.hxml"; done

prep defeatA
prep defeatB
prep defeatB-real
prep defeatC
prep wsreason
prep tinyreason
prep phantom
prep both-deleted
prep tamper-base
prep live-exempt
prep main-root
prep include
prep include-missing
prep main-broken
prep badkeys
prep badexempt-target
prep badexempt-module
python3 - <<'PY'
import json, os
C='/home/losses/Development/tq-workspace/dc-warn/scratch-roots-guard/cases'
def rd(p): return open(p).read()
def wr(p,s): open(p,'w').write(s)
def drop_root(p, mod):
    lines=rd(p).splitlines(True)
    assert any(l.strip()==mod for l in lines), (p,mod)
    wr(p, ''.join(l for l in lines if l.strip()!=mod))
def add_allow(case, entry, section='exempt'):
    p=f'{C}/{case}/tools/roots-guard/roots-allowlist.json'
    d=json.load(open(p)); d.setdefault(section,[]).append(entry)
    wr(p, json.dumps(d, indent=2)+'\n')

# DEFEAT A: delete a genuine root from swift-f32 + one-character exemption
drop_root(f'{C}/defeatA/examples/swift-f32.hxml','tests.EarlyReturnTests')
add_allow('defeatA', {"target":"swift","module":"tests.EarlyReturnTests","reason":"x"})
# DEFEAT B (reviewer's exact reproduction): phantom f32-only extra root
wr(f'{C}/defeatB/examples/swift-f32.hxml', rd(f'{C}/defeatB/examples/swift-f32.hxml')+'tests.F32OnlyDivergentTests\n')
# DEFEAT B (isolated): a REAL module that is a root of no pair
wr(f'{C}/defeatB-real/examples/swift-f32.hxml', rd(f'{C}/defeatB-real/examples/swift-f32.hxml')+'std.Graphemes\n')
# DEFEAT C: stale exemption for a module that is not missing
add_allow('defeatC', {"target":"swift","module":"boring.ArraySliceOps","reason":"stale entry left behind after an earlier fix; kept by accident."})
# whitespace-only reason (must stay rejected)
add_allow('wsreason', {"target":"swift","module":"tests.EarlyReturnTests","reason":"   "})
# one-word reason + real deleted root (same shape as A but reason "todo")
drop_root(f'{C}/tinyreason/examples/kotlin-f32.hxml','tests.EarlyReturnTests')
add_allow('tinyreason', {"target":"kotlin","module":"tests.EarlyReturnTests","reason":"todo"})
# phantom module added to f32 (nonexistent .hx)
wr(f'{C}/phantom/examples/swift-f32.hxml', rd(f'{C}/phantom/examples/swift-f32.hxml')+'tests.NoSuchModuleAaa\n')
# a @:test module deleted from BOTH files (previously invisible)
drop_root(f'{C}/both-deleted/examples/swift.hxml','tests.EarlyReturnTests')
drop_root(f'{C}/both-deleted/examples/swift-f32.hxml','tests.EarlyReturnTests')
# base loses a root -> f32-only divergence (opposite direction of A)
drop_root(f'{C}/tamper-base/examples/swift.hxml','tests.EarlyReturnTests')
# real f32-only module WITH a substantive exemption -> must PASS (no over-blocking)
wr(f'{C}/live-exempt/examples/swift-f32.hxml', rd(f'{C}/live-exempt/examples/swift-f32.hxml')+'std.Graphemes\n')
add_allow('live-exempt', {"target":"swift","module":"std.Graphemes","reason":"the swift f32 bundle intentionally pulls the grapheme runtime shim that the binary64 bundle reaches through a macro keep directive instead of a root line."})
# -main form of an existing root (must be parsed, so the sets still match)
for f in ['swift.hxml','swift-f32.hxml']:
    p=f'{C}/main-root/examples/{f}'; s=rd(p)
    s=s.replace('tests.EarlyReturnTests\n','-main tests.EarlyReturnTests\n')
    wr(p,s)
# nested include form of an existing root
wr(f'{C}/include/examples/swift-f32-extra.hxml','# included fragment\ntests.EarlyReturnTests\n')
drop_root(f'{C}/include/examples/swift-f32.hxml','tests.EarlyReturnTests')
wr(f'{C}/include/examples/swift-f32.hxml', rd(f'{C}/include/examples/swift-f32.hxml')+'swift-f32-extra.hxml\n')
# parsing failure paths: dangling include and a bare -main
wr(f'{C}/include-missing/examples/swift-f32.hxml', rd(f'{C}/include-missing/examples/swift-f32.hxml')+'fragment-that-does-not-exist.hxml\n')
wr(f'{C}/main-broken/examples/swift-f32.hxml', rd(f'{C}/main-broken/examples/swift-f32.hxml')+'-main\n')
# allowlist structural violations
add_allow('badkeys', {"target":"swift","module":"boring.ArraySliceOps","reason":"this entry carries an unknown key on purpose","expires":"2026-12-31"})
add_allow('badexempt-target', {"target":"dart","module":"registry.Main","reason":"target that this guard does not check, so the entry is inert."})
add_allow('badexempt-module', {"target":"swift","module":"not a module path!","reason":"module name does not have a plausible dotted shape."})
print('cases prepared')
PY

run() { # $1 = case name, $2... = extra flags
    local case="$1"; shift
    ( cd "$ROOT" && bash "$CASES/$case/tools/roots-guard/check-roots-guard.sh" "$@" ) > "$OUT/hard-$case.txt" 2>&1
    local rc=$?
    printf '%s\trc=%d\tFAIL=%d\tDUP=%d\tCOVER=%d\tEXEMPT=%d\n' "$case" "$rc" \
        "$(grep -c '^FAIL:' "$OUT/hard-$case.txt")" "$(grep -c '^DUP:' "$OUT/hard-$case.txt")" \
        "$(grep -c '^COVER:' "$OUT/hard-$case.txt")" "$(grep -c '^EXEMPT:' "$OUT/hard-$case.txt")" \
        | tee -a "$OUT/matrix.tsv"
    echo "  exit_code=$rc" >> "$OUT/hard-$case.txt"
}

: > "$OUT/matrix.tsv"
run current
run prefix
run defeatA
run defeatB
run defeatB-real
run defeatC
run wsreason
run tinyreason
run phantom
run both-deleted
run tamper-base
run live-exempt
run main-root
run include
run include-missing
run main-broken
run badkeys
run badexempt-target
run badexempt-module
# duplicate strictness: same tree, flag on
( cd "$ROOT" && bash "$CASES/current/tools/roots-guard/check-roots-guard.sh" --strict-duplicates ) > "$OUT/hard-dup-strict.txt" 2>&1
rc=$?
printf 'dup-strict\trc=%d\tFAIL=%d\tDUP=%d\n' "$rc" "$(grep -c '^FAIL:' "$OUT/hard-dup-strict.txt")" "$(grep -c '^DUP:' "$OUT/hard-dup-strict.txt")" | tee -a "$OUT/matrix.tsv"
echo "  exit_code=$rc" >> "$OUT/hard-dup-strict.txt"
# out-of-tree run with the documented repo-root override
( cd /tmp && ROOTS_GUARD_REPO_ROOT="$ROOT" bash "$CASES/current/tools/roots-guard/check-roots-guard.sh" ) > "$OUT/hard-current-envoverride.txt" 2>&1
rc=$?
printf 'current-envoverride\trc=%d\n' "$rc" | tee -a "$OUT/matrix.tsv"
echo "  exit_code=$rc" >> "$OUT/hard-current-envoverride.txt"
# the hardened guard against the UNCHANGED repository allowlist (shows which new
# declarations are load-bearing)
prep old-allowlist
cp "$ROOT/tools/roots-guard/roots-allowlist.json" "$CASES/old-allowlist/tools/roots-guard/roots-allowlist.json"
run old-allowlist
# usage / help
bash "$CASES/current/tools/roots-guard/check-roots-guard.sh" --help > "$OUT/hard-help.txt" 2>&1; echo "help exit_code=$?" >> "$OUT/hard-help.txt"
