use crate::runtime::u_string::UString;


#[derive(Clone, Copy)]
pub struct SwitchOps;

impl SwitchOps {
    pub fn switch_ops_statement(mark: SwitchMark) -> UString {
        let value = match mark {
    SwitchMark::Empty => UString::from("empty").to_ustring().to_ustring(),
    SwitchMark::Number { value: _p0 } => { let mut __s = UString::new(); __s += &(UString::from("number:")); __s += &(UString::from((_p0).to_string().as_str())); __s },
    SwitchMark::Text { value: _p0 } => { let mut __s = UString::new(); __s += &(UString::from("text:")); __s += _p0.as_ustr(); __s },
    SwitchMark::Other => UString::from("other").to_ustring().to_ustring(),
};
        return value;
    }

    pub fn switch_ops_initializer(mark: SwitchMark) -> UString {
        let value = match mark {
    SwitchMark::Empty => UString::from("empty").to_ustring().to_ustring(),
    SwitchMark::Number { value: _p0 } => { let mut __s = UString::new(); __s += &(UString::from("number:")); __s += &(UString::from((_p0).to_string().as_str())); __s },
    SwitchMark::Text { value: _p0 } => { let mut __s = UString::new(); __s += &(UString::from("text:")); __s += _p0.as_ustr(); __s },
    SwitchMark::Other => UString::from("other").to_ustring().to_ustring(),
};
        return value;
    }

    pub fn switch_ops_assign(mark: SwitchMark) -> UString {
        let value = match mark {
    SwitchMark::Empty => UString::from("empty").to_ustring().to_ustring(),
    SwitchMark::Number { value: _p0 } => { let mut __s = UString::new(); __s += &(UString::from("number:")); __s += &(UString::from((_p0).to_string().as_str())); __s },
    SwitchMark::Text { value: _p0 } => { let mut __s = UString::new(); __s += &(UString::from("text:")); __s += _p0.as_ustr(); __s },
    SwitchMark::Other => UString::from("other").to_ustring().to_ustring(),
};
        return value;
    }

    pub fn switch_ops_conditional(mark: SwitchMark, use_fallback: bool) -> UString {
        return if use_fallback { UString::from("fallback") } else { match mark {
    SwitchMark::Empty => UString::from("empty").to_ustring().to_ustring(),
    SwitchMark::Number { value: _p0 } => { let mut __s = UString::new(); __s += &(UString::from("number:")); __s += &(UString::from((_p0).to_string().as_str())); __s },
    SwitchMark::Text { value: _p0 } => { let mut __s = UString::new(); __s += &(UString::from("text:")); __s += _p0.as_ustr(); __s },
    SwitchMark::Other => UString::from("other").to_ustring().to_ustring(),
}.to_ustring() };
    }

    pub fn switch_ops_defaulted(mark: SwitchMark) -> UString {
        let value = match mark {
    SwitchMark::Empty => UString::from("empty").to_ustring().to_ustring(),
    SwitchMark::Number { .. } => UString::from("number").to_ustring(),
    SwitchMark::Text { .. } => UString::from("text").to_ustring(),
    SwitchMark::Other => UString::from("fallback").to_ustring().to_ustring(),
};
        return value;
    }
}

#[derive(Debug, Clone, PartialEq)]
pub enum SwitchMark {
    Empty,
    Number { value: u32 },
    Text { value: UString },
    Other,
}

impl SwitchMark {
    pub fn to_string(&self) -> String {
        match self {
            SwitchMark::Empty => "Empty".to_string(),
            SwitchMark::Number { value } => format!("Number(value={})", (value).to_string()),
            SwitchMark::Text { value } => format!("Text(value={})", (value).clone()),
            SwitchMark::Other => "Other".to_string(),
        }
    }
}
