package boring

import boring.runtime.SortedMapTable
import boring.runtime.SortedTable

object ScriptNames {
    private fun createTable(): SortedMapTable<String, Int> {
        val b = SortedTable.mapBuilder<String, Int>(SortedTable::compareStrings)
        b.put("￿", 6)
        b.put("𐀀", 3)
        b.put("ASCII", 1)
        b.put("", 5)
        b.put("퟿", 2)
        b.put("􏿿", 4)
        return b.build()
    }

    fun codeOf(name: String): Int? {
        val table = ScriptNames.createTable()
        return table.get(name)
    }

    fun describeOrder(): String {
        val table = ScriptNames.createTable()
        val parts = mutableListOf<String>()
        val count = table.size()
        for (i in 0 until count) {
            parts.add(table.keyAt(i) + "=" + table.valueAt(i))
        }
        return parts.joinToString("; ")
    }
}
