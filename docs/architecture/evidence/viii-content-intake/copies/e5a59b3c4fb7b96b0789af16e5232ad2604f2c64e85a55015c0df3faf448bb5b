package tests

import boring.NullArgsOps
import boring.runtime.test.Test

class NullArgsTests {
@boring.test.Test
    fun testExplicitNull() {
        Test.run("tests.NullArgsTests.testExplicitNull", "tests.NullArgsTests.testExplicitNull: explicit null materializes a registered default") {
                Test.equals("none", NullArgsOps.explicitNull(), null)
        }
    }

@boring.test.Test
    fun testNullableVariable() {
        Test.run("tests.NullArgsTests.testNullableVariable", "tests.NullArgsTests.testNullableVariable: nullable arguments use the default only when null") {
                Test.equals("none", NullArgsOps.nullableVariable(null), null)
                Test.equals("x", NullArgsOps.nullableVariable("x"), null)
        }
    }

@boring.test.Test
    fun testConditionalArg() {
        Test.run("tests.NullArgsTests.testConditionalArg", "tests.NullArgsTests.testConditionalArg: null-guard conditional argument wraps in the Option slot") {
                Test.equals("none", NullArgsOps.conditionalArg(null), null)
                Test.equals("x", NullArgsOps.conditionalArg("x"), null)
        }
    }

@boring.test.Test
    fun testNullDefault() {
        Test.run("tests.NullArgsTests.testNullDefault", "tests.NullArgsTests.testNullDefault: null default keeps the nullable parameter in the Option domain") {
                Test.equals("null", NullArgsOps.nullDefaultAbsent(), null)
                Test.equals("set", NullArgsOps.nullDefaultPresent(), null)
        }
    }
}
