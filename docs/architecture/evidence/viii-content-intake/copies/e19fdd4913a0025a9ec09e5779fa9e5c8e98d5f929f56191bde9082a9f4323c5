#[derive(Clone, Copy)]
pub struct FunctionalOps;

impl FunctionalOps {
    pub fn functional_ops_lambda_sum(values: &Vec<f64>) -> f64 {
        let mut total = 0.0f64;
        for &value in values {
            total += value;
        }
        return total;
    }

    pub fn functional_ops_functional_sum(values: &Vec<f64>) -> f64 {
        let mut pipeline_result = 0.0f64;
        for &value in values {
            pipeline_result += value;
        }
        return pipeline_result;
    }

    pub fn functional_ops_lambda_iter(values: &Vec<u32>) -> u32 {
        let mut total = 0u32;
        for &value in values {
            total = u32::wrapping_add(total, value);
        }
        return total;
    }

    pub fn functional_ops_functional_for_each(values: &Vec<u32>) -> u32 {
        let mut total = 0u32;
        for &value in values {
            total = u32::wrapping_add(total, value);
        }
        return total;
    }

    pub fn functional_ops_verify() -> bool {
        let ints = vec![1, 2, 3, 4];
        return FunctionalOps::functional_ops_lambda_sum(&vec![1.5f64, 2.0f64, 3.5f64]) == 7.0f64 && FunctionalOps::functional_ops_functional_sum(&vec![1.5f64, 2.0f64, 3.5f64]) == 7.0f64 && FunctionalOps::functional_ops_lambda_iter(&ints) == 10 && FunctionalOps::functional_ops_functional_for_each(&ints) == 10;
    }
}
