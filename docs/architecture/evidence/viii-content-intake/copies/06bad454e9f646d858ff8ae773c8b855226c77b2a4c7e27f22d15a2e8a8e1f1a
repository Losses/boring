package tests

import boring.InterfaceGetterPropertyImpl
import boring.InterfaceGetterPropertyUse
import boring.runtime.test.Test

class InterfaceGetterPropertyTests {
@boring.test.Test
    fun testInterfaceGetterProperty() {
        Test.run("tests.InterfaceGetterPropertyTests.testInterfaceGetterProperty", "tests.InterfaceGetterPropertyTests.testInterfaceGetterProperty: reads a getter-only property through the interface type") {
                val iface = InterfaceGetterPropertyImpl("hello")
                val actual = iface.name
                Test.equals("hello", actual, null)
                Test.equals("hello", InterfaceGetterPropertyUse.nameOf(iface), null)
        }
    }
}
