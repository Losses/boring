#![cfg(test)]

use crate::boring::nullable_interface_branch_ops::NullableInterfaceBranchOps;
use crate::runtime::test as testlib;
use crate::runtime::test_core;
use crate::runtime::u_string::UStr;


#[test]
fn label() {
    testlib::run("tests.NullableInterfaceBranchOpsTests.label", "tests.NullableInterfaceBranchOpsTests.label: a nullable interface conditional boxes its concrete arm", || {
        test_core::TestCore::test_core_equals_string(UStr::new(&[97,108,112,104,97]), NullableInterfaceBranchOps::nullable_interface_branch_ops_label(true).as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[110,111,110,101]), NullableInterfaceBranchOps::nullable_interface_branch_ops_label(false).as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[97,108,112,104,97]), NullableInterfaceBranchOps::nullable_interface_branch_ops_assign(true).as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[110,111,110,101]), NullableInterfaceBranchOps::nullable_interface_branch_ops_assign(false).as_ustr(), UStr::new(&[]));
    });
}
