package boring

object VectorSort {
    fun byCodePoint(records: MutableList<GlyphMetrics>): MutableList<GlyphMetrics> {
        for (write in 1 until records.size) {
            val record = records[write]
            val key = record.codePoint
            var read = write - 1
            while ((read >= 0 && records[read].codePoint > key)) {
                val _growIndex1 = read + 1
                if (records.size <= _growIndex1) { records.addAll(java.util.Collections.nCopies<GlyphMetrics>(_growIndex1 + 1 - records.size, null)) }
                records[_growIndex1] = records[read]
                read -= 1
            }
            val _growIndex2 = read + 1
            if (records.size <= _growIndex2) { records.addAll(java.util.Collections.nCopies<GlyphMetrics>(_growIndex2 + 1 - records.size, null)) }
            records[_growIndex2] = record
        }
        return records
    }
}
