#![cfg(test)]

use crate::boring::math_na_n_ops::MathNaNOps;
use crate::boring::math_na_n_test_support::MathNaNTestSupport;
use crate::runtime::test as testlib;
use crate::runtime::test_core;
use crate::runtime::u_string::UStr;


#[test]
fn min_values() {
    testlib::run("tests.MathNaNOpsTests.minValues", "tests.MathNaNOpsTests.minValues: Math.min propagates NaN and handles finite and infinity edges", || {
        MathNaNTestSupport::math_na_n_test_support_assert_na_n(MathNaNOps::math_na_n_ops_min_of(f32::NAN, 2.0f32), UStr::new(&[109,105,110,32,78,97,78,44,32,102,105,110,105,116,101]));
        MathNaNTestSupport::math_na_n_test_support_assert_na_n(MathNaNOps::math_na_n_ops_min_of(2.0f32, f32::NAN), UStr::new(&[109,105,110,32,102,105,110,105,116,101,44,32,78,97,78]));
        MathNaNTestSupport::math_na_n_test_support_assert_na_n(MathNaNOps::math_na_n_ops_min_of(f32::NAN, f32::NAN), UStr::new(&[109,105,110,32,78,97,78,44,32,78,97,78]));
        test_core::TestCore::test_core_equals_float(-3.0f32, MathNaNOps::math_na_n_ops_min_of(-3.0f32, 4.0f32), UStr::new(&[]));
        test_core::TestCore::test_core_equals_float(-3.0f32, MathNaNOps::math_na_n_ops_min_of(4.0f32, -3.0f32), UStr::new(&[]));
        test_core::TestCore::test_core_equals_float(2.0f32, MathNaNOps::math_na_n_ops_min_of(2.0f32, f32::INFINITY), UStr::new(&[]));
        test_core::TestCore::test_core_equals_float(2.0f32, MathNaNOps::math_na_n_ops_min_of(f32::INFINITY, 2.0f32), UStr::new(&[]));
        test_core::TestCore::test_core_equals_float(f32::NEG_INFINITY, MathNaNOps::math_na_n_ops_min_of(f32::NEG_INFINITY, 2.0f32), UStr::new(&[]));
        test_core::TestCore::test_core_equals_float(f32::NEG_INFINITY, MathNaNOps::math_na_n_ops_min_of(2.0f32, f32::NEG_INFINITY), UStr::new(&[]));
        test_core::TestCore::test_core_equals_float(f32::NEG_INFINITY, MathNaNOps::math_na_n_ops_min_of(f32::INFINITY, f32::NEG_INFINITY), UStr::new(&[]));
        test_core::TestCore::test_core_equals_float(f32::NEG_INFINITY, MathNaNOps::math_na_n_ops_min_of(f32::NEG_INFINITY, f32::INFINITY), UStr::new(&[]));
        MathNaNTestSupport::math_na_n_test_support_assert_na_n(MathNaNOps::math_na_n_ops_min_of(f32::NAN, f32::INFINITY), UStr::new(&[109,105,110,32,78,97,78,44,32,105,110,102,105,110,105,116,121]));
        MathNaNTestSupport::math_na_n_test_support_assert_na_n(MathNaNOps::math_na_n_ops_min_of(f32::INFINITY, f32::NAN), UStr::new(&[109,105,110,32,105,110,102,105,110,105,116,121,44,32,78,97,78]));
        MathNaNTestSupport::math_na_n_test_support_assert_negative_zero(MathNaNOps::math_na_n_ops_min_of(-0.0f32, 0.0f32), UStr::new(&[109,105,110,32,45,48,44,32,43,48]));
        MathNaNTestSupport::math_na_n_test_support_assert_negative_zero(MathNaNOps::math_na_n_ops_min_of(0.0f32, -0.0f32), UStr::new(&[109,105,110,32,43,48,44,32,45,48]));
        test_core::TestCore::test_core_equals_float(f32::NEG_INFINITY, MathNaNOps::math_na_n_ops_min_of(-0.0f32, f32::NEG_INFINITY), UStr::new(&[]));
        test_core::TestCore::test_core_equals_float(f32::NEG_INFINITY, MathNaNOps::math_na_n_ops_min_of(f32::NEG_INFINITY, -0.0f32), UStr::new(&[]));
        test_core::TestCore::test_core_equals_float(f32::NEG_INFINITY, MathNaNOps::math_na_n_ops_min_of(0.0f32, f32::NEG_INFINITY), UStr::new(&[]));
        test_core::TestCore::test_core_equals_float(f32::NEG_INFINITY, MathNaNOps::math_na_n_ops_min_of(f32::NEG_INFINITY, 0.0f32), UStr::new(&[]));
        MathNaNTestSupport::math_na_n_test_support_assert_negative_zero(MathNaNOps::math_na_n_ops_min_of(-0.0f32, f32::INFINITY), UStr::new(&[109,105,110,32,45,48,44,32,43,105,110,102,105,110,105,116,121]));
        MathNaNTestSupport::math_na_n_test_support_assert_negative_zero(MathNaNOps::math_na_n_ops_min_of(f32::INFINITY, -0.0f32), UStr::new(&[109,105,110,32,43,105,110,102,105,110,105,116,121,44,32,45,48]));
        MathNaNTestSupport::math_na_n_test_support_assert_positive_zero(MathNaNOps::math_na_n_ops_min_of(0.0f32, f32::INFINITY), UStr::new(&[109,105,110,32,43,48,44,32,43,105,110,102,105,110,105,116,121]));
        MathNaNTestSupport::math_na_n_test_support_assert_positive_zero(MathNaNOps::math_na_n_ops_min_of(f32::INFINITY, 0.0f32), UStr::new(&[109,105,110,32,43,105,110,102,105,110,105,116,121,44,32,43,48]));
        test_core::TestCore::test_core_equals_float(4.0f32, MathNaNOps::math_na_n_ops_min_ints(4, 9), UStr::new(&[109,105,110,32,119,105,100,101,110,115,32,73,110,116,32,111,112,101,114,97,110,100,115]));
    });
}

#[test]
fn max_values() {
    testlib::run("tests.MathNaNOpsTests.maxValues", "tests.MathNaNOpsTests.maxValues: Math.max propagates NaN and handles finite and infinity edges", || {
        MathNaNTestSupport::math_na_n_test_support_assert_na_n(MathNaNOps::math_na_n_ops_max_of(f32::NAN, 2.0f32), UStr::new(&[109,97,120,32,78,97,78,44,32,102,105,110,105,116,101]));
        MathNaNTestSupport::math_na_n_test_support_assert_na_n(MathNaNOps::math_na_n_ops_max_of(2.0f32, f32::NAN), UStr::new(&[109,97,120,32,102,105,110,105,116,101,44,32,78,97,78]));
        MathNaNTestSupport::math_na_n_test_support_assert_na_n(MathNaNOps::math_na_n_ops_max_of(f32::NAN, f32::NAN), UStr::new(&[109,97,120,32,78,97,78,44,32,78,97,78]));
        test_core::TestCore::test_core_equals_float(4.0f32, MathNaNOps::math_na_n_ops_max_of(-3.0f32, 4.0f32), UStr::new(&[]));
        test_core::TestCore::test_core_equals_float(4.0f32, MathNaNOps::math_na_n_ops_max_of(4.0f32, -3.0f32), UStr::new(&[]));
        test_core::TestCore::test_core_equals_float(f32::INFINITY, MathNaNOps::math_na_n_ops_max_of(2.0f32, f32::INFINITY), UStr::new(&[]));
        test_core::TestCore::test_core_equals_float(f32::INFINITY, MathNaNOps::math_na_n_ops_max_of(f32::INFINITY, 2.0f32), UStr::new(&[]));
        test_core::TestCore::test_core_equals_float(2.0f32, MathNaNOps::math_na_n_ops_max_of(f32::NEG_INFINITY, 2.0f32), UStr::new(&[]));
        test_core::TestCore::test_core_equals_float(2.0f32, MathNaNOps::math_na_n_ops_max_of(2.0f32, f32::NEG_INFINITY), UStr::new(&[]));
        test_core::TestCore::test_core_equals_float(f32::INFINITY, MathNaNOps::math_na_n_ops_max_of(f32::INFINITY, f32::NEG_INFINITY), UStr::new(&[]));
        test_core::TestCore::test_core_equals_float(f32::INFINITY, MathNaNOps::math_na_n_ops_max_of(f32::NEG_INFINITY, f32::INFINITY), UStr::new(&[]));
        MathNaNTestSupport::math_na_n_test_support_assert_na_n(MathNaNOps::math_na_n_ops_max_of(f32::NAN, f32::NEG_INFINITY), UStr::new(&[109,97,120,32,78,97,78,44,32,105,110,102,105,110,105,116,121]));
        MathNaNTestSupport::math_na_n_test_support_assert_na_n(MathNaNOps::math_na_n_ops_max_of(f32::NEG_INFINITY, f32::NAN), UStr::new(&[109,97,120,32,105,110,102,105,110,105,116,121,44,32,78,97,78]));
        MathNaNTestSupport::math_na_n_test_support_assert_positive_zero(MathNaNOps::math_na_n_ops_max_of(-0.0f32, 0.0f32), UStr::new(&[109,97,120,32,45,48,44,32,43,48]));
        MathNaNTestSupport::math_na_n_test_support_assert_positive_zero(MathNaNOps::math_na_n_ops_max_of(0.0f32, -0.0f32), UStr::new(&[109,97,120,32,43,48,44,32,45,48]));
        test_core::TestCore::test_core_equals_float(f32::INFINITY, MathNaNOps::math_na_n_ops_max_of(-0.0f32, f32::INFINITY), UStr::new(&[]));
        test_core::TestCore::test_core_equals_float(f32::INFINITY, MathNaNOps::math_na_n_ops_max_of(f32::INFINITY, -0.0f32), UStr::new(&[]));
        test_core::TestCore::test_core_equals_float(f32::INFINITY, MathNaNOps::math_na_n_ops_max_of(0.0f32, f32::INFINITY), UStr::new(&[]));
        test_core::TestCore::test_core_equals_float(f32::INFINITY, MathNaNOps::math_na_n_ops_max_of(f32::INFINITY, 0.0f32), UStr::new(&[]));
        MathNaNTestSupport::math_na_n_test_support_assert_negative_zero(MathNaNOps::math_na_n_ops_max_of(-0.0f32, f32::NEG_INFINITY), UStr::new(&[109,97,120,32,45,48,44,32,45,105,110,102,105,110,105,116,121]));
        MathNaNTestSupport::math_na_n_test_support_assert_negative_zero(MathNaNOps::math_na_n_ops_max_of(f32::NEG_INFINITY, -0.0f32), UStr::new(&[109,97,120,32,45,105,110,102,105,110,105,116,121,44,32,45,48]));
        MathNaNTestSupport::math_na_n_test_support_assert_positive_zero(MathNaNOps::math_na_n_ops_max_of(0.0f32, f32::NEG_INFINITY), UStr::new(&[109,97,120,32,43,48,44,32,45,105,110,102,105,110,105,116,121]));
        MathNaNTestSupport::math_na_n_test_support_assert_positive_zero(MathNaNOps::math_na_n_ops_max_of(f32::NEG_INFINITY, 0.0f32), UStr::new(&[109,97,120,32,45,105,110,102,105,110,105,116,121,44,32,43,48]));
        test_core::TestCore::test_core_equals_float(9.0f32, MathNaNOps::math_na_n_ops_max_ints(4, 9), UStr::new(&[109,97,120,32,119,105,100,101,110,115,32,73,110,116,32,111,112,101,114,97,110,100,115]));
    });
}

#[test]
fn folded_constant_edges() {
    testlib::run("tests.MathNaNOpsTests.foldedConstantEdges", "tests.MathNaNOpsTests.foldedConstantEdges: literal constant edges keep NaN, both infinities, and the f32 flush values", || {
        MathNaNTestSupport::math_na_n_test_support_assert_na_n(MathNaNOps::math_na_n_ops_constant_nan(), UStr::new(&[48,46,48,32,47,32,48,46,48,32,105,115,32,78,97,78]));
        test_core::TestCore::test_core_equals_float(f32::INFINITY, MathNaNOps::math_na_n_ops_constant_pos_inf(), UStr::new(&[49,46,48,32,47,32,48,46,48,32,105,115,32,43,105,110,102,105,110,105,116,121]));
        test_core::TestCore::test_core_equals_float(f32::NEG_INFINITY, MathNaNOps::math_na_n_ops_constant_neg_inf(), UStr::new(&[45,49,46,48,32,47,32,48,46,48,32,105,115,32,45,105,110,102,105,110,105,116,121]));
        test_core::TestCore::test_core_equals_bool(true, (MathNaNOps::math_na_n_ops_constant_overflow()) > (3e38f32), UStr::new(&[49,101,51,48,48,32,101,120,99,101,101,100,115,32,116,104,101,32,98,105,110,97,114,121,51,50,32,114,97,110,103,101]));
        test_core::TestCore::test_core_equals_bool(true, (MathNaNOps::math_na_n_ops_constant_underflow()) >= 0.0f32, UStr::new(&[49,101,45,51,48,48,32,110,101,118,101,114,32,103,111,101,115,32,110,101,103,97,116,105,118,101]));
        test_core::TestCore::test_core_equals_bool(true, (MathNaNOps::math_na_n_ops_constant_underflow()) < (1e-38f32), UStr::new(&[49,101,45,51,48,48,32,115,116,97,121,115,32,98,101,108,111,119,32,116,104,101,32,98,105,110,97,114,121,51,50,32,110,111,114,109,97,108,32,114,97,110,103,101]));
    });
}
