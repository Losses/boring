// Probe A (xcheck): minimal standalone two-bad-arm closure. Both arms return
// TiqianArray where the closure result type is ReadOnlyArray. Question: does
// swiftc report one error (suppression) or two?
public final class TiqianArray<Element> {
    public var items: [Element]
    public init(_ items: [Element]) { self.items = items }
}
public final class ReadOnlyArray<Element> {
    private let backing: TiqianArray<Element>
    public init(_ backing: TiqianArray<Element>) { self.backing = backing }
}
public enum Choice {
    case values(values: TiqianArray<Int32>)
    case marker(m: Int32)
}
func fallbackArray() -> TiqianArray<Int32> { return TiqianArray<Int32>([9]) }
public enum ProbeOps {
    public static func bothArmsBad(_ flag: Bool) -> String {
        let choice = (flag ? Choice.values(values: TiqianArray<Int32>([1, 2])) : Choice.marker(m: 0))
        let view = ({ () -> ReadOnlyArray<Int32> in
            switch choice {
            case .values(let values):
                return values
            case .marker(_):
                return fallbackArray()
            }
        })()
        return "view-\(view.backing.items.count)"
    }
}
