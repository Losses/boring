#!/usr/bin/env bash
export PATH="$(grep -m1 '^PATH=' /home/losses/Development/tq-workspace/dc-warn/out/chainA-fixed-rerun/evidence/env.json | cut -d= -f2-)"
TREE=/tmp/verify-2aadcb69/wt-prefix
L=/tmp/verify-2aadcb69/logs; mkdir -p "$L"
F="$TREE/samples/boring/MathNaNTestSupport.hx"
rm -f "$L/stop.sampler"
echo "[prefix tree] head of pre-fix test harness:"
sed -n '44,96p' "$TREE/tests/ts/package-artifacts.test.ts"
{
  while [ ! -f "$L/stop.sampler" ]; do
    printf '%s %s %s %s\n' "$(date +%s.%N)" "$(sha256sum "$F" | cut -c1-16)" "$(grep -c 'Test.equals' "$F" 2>/dev/null || echo ERR)" "$(wc -c < "$F" 2>/dev/null || echo ERR)"
    sleep 0.05
  done
} > "$L/prefix-fixture-sampler.log" 2>&1 &
SAMP=$!
sleep 1
cd "$TREE"
echo "=== running the SHIPPED pre-fix test file (npm test only) ==="
timeout 600 bun test tests/ts/package-artifacts.test.ts -t "npm tarball" > "$L/prefix-npm-test.log" 2>&1
echo "bun-test-exit=$?" >> "$L/prefix-npm-test.log"
touch "$L/stop.sampler"
wait $SAMP
cat "$L/prefix-npm-test.log"
echo "=== sampler: distinct (sha16, tests.equals, bytes) states observed ==="
awk '{print $2, $3, $4}' "$L/prefix-fixture-sampler.log" | sort | uniq -c | sort -rn
echo "=== fixture after run ==="
sha256sum "$F"; grep -c 'Test.equals' "$F"
