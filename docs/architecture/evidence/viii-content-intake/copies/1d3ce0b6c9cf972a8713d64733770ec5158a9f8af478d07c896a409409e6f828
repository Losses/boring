package mx;

class MXBlock {
	inline static function two(a:Array<Int>):Array<Int> {
		final s = a.length;
		return a.slice(s, 0);
	}

	// return position
	public static function rRet():Array<Int> {
		final h = [1, 2, 3];
		return two(h);
	}

	// var initializer, no cast
	public static function rInit():Int {
		final h = [1, 2, 3];
		final arr:Array<Int> = two(h);
		return arr.length;
	}

	// plain argument, no cast
	public static function rArg():Int {
		final h = [1, 2, 3];
		return len(two(h));
	}

	static function len(a:Array<Int>):Int
		return a.length;
}
