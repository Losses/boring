#![cfg(test)]

use crate::boring::nullable_float_compare_ops::NullableFloatCompareOps;
use crate::runtime::test as testlib;
use crate::runtime::test_core;
use crate::runtime::u_string::UStr;


#[test]
fn structural_zero() {
    testlib::run("tests.NullableFloatCompareTests.structuralZero", "tests.NullableFloatCompareTests.structuralZero: a null-coalescing Float local compares zero in the Float domain", || {
        test_core::TestCore::test_core_equals_bool(true, NullableFloatCompareOps::nullable_float_compare_ops_structural_zero(Some(0.0f64), Some(0.0f64)), UStr::new(&[]));
        test_core::TestCore::test_core_equals_bool(false, NullableFloatCompareOps::nullable_float_compare_ops_structural_zero(Some(0.5f64), Some(0.0f64)), UStr::new(&[]));
        test_core::TestCore::test_core_equals_bool(false, NullableFloatCompareOps::nullable_float_compare_ops_structural_zero(None, Some(0.5f64)), UStr::new(&[]));
    });
}

#[test]
fn not_zero() {
    testlib::run("tests.NullableFloatCompareTests.notZero", "tests.NullableFloatCompareTests.notZero: a null-coalescing Float local inequality compares zero in the Float domain", || {
        test_core::TestCore::test_core_equals_bool(false, NullableFloatCompareOps::nullable_float_compare_ops_not_zero(Some(0.0f64)), UStr::new(&[]));
        test_core::TestCore::test_core_equals_bool(true, NullableFloatCompareOps::nullable_float_compare_ops_not_zero(Some(0.5f64)), UStr::new(&[]));
        test_core::TestCore::test_core_equals_bool(false, NullableFloatCompareOps::nullable_float_compare_ops_not_zero(None), UStr::new(&[]));
    });
}
