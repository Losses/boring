#![cfg(test)]

use crate::boring::array_slice_ops::ArraySliceOps;
use crate::runtime::test as testlib;
use crate::runtime::test_core;
use crate::runtime::u_string::UStr;


#[test]
fn test_end_past_length() {
    testlib::run("tests.ArraySliceTests.testEndPastLength", "tests.ArraySliceTests.testEndPastLength: an end past the length returns the elements the array carries", || {
        test_core::TestCore::test_core_equals_string(UStr::new(&[]), ArraySliceOps::array_slice_ops_slice_text(0, 0, 20).as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[49]), ArraySliceOps::array_slice_ops_slice_text(1, 0, 20).as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[49,44,50,44,51,44,52,44,53]), ArraySliceOps::array_slice_ops_slice_text(5, 0, 20).as_ustr(), UStr::new(&[]));
    });
}

#[test]
fn test_end_below_start() {
    testlib::run("tests.ArraySliceTests.testEndBelowStart", "tests.ArraySliceTests.testEndBelowStart: an end below the start returns the empty slice", || {
        test_core::TestCore::test_core_equals_string(UStr::new(&[]), ArraySliceOps::array_slice_ops_slice_text(0, 2, 1).as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[]), ArraySliceOps::array_slice_ops_slice_text(1, 2, 1).as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[]), ArraySliceOps::array_slice_ops_slice_text(5, 2, 1).as_ustr(), UStr::new(&[]));
    });
}

#[test]
fn test_negative_start() {
    testlib::run("tests.ArraySliceTests.testNegativeStart", "tests.ArraySliceTests.testNegativeStart: a negative start counts from the end of the array", || {
        test_core::TestCore::test_core_equals_string(UStr::new(&[]), ArraySliceOps::array_slice_ops_slice_text(0, 4294967293u32, 2).as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[49]), ArraySliceOps::array_slice_ops_slice_text(1, 4294967293u32, 2).as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[]), ArraySliceOps::array_slice_ops_slice_text(5, 4294967293u32, 2).as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[49,44,50,44,51]), ArraySliceOps::array_slice_ops_slice_text(5, 4294967287u32, 4294967294u32).as_ustr(), UStr::new(&[]));
    });
}

#[test]
fn test_omitted_end() {
    testlib::run("tests.ArraySliceTests.testOmittedEnd", "tests.ArraySliceTests.testOmittedEnd: an omitted end reaches the length of the array", || {
        test_core::TestCore::test_core_equals_string(UStr::new(&[51,44,52,44,53]), ArraySliceOps::array_slice_ops_from_text(5, 2).as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[52,44,53]), ArraySliceOps::array_slice_ops_from_text(5, 4294967294u32).as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[]), ArraySliceOps::array_slice_ops_from_text(5, 9).as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[]), ArraySliceOps::array_slice_ops_from_text(0, 0).as_ustr(), UStr::new(&[]));
    });
}

#[test]
fn test_nullable_receiver() {
    testlib::run("tests.ArraySliceTests.testNullableReceiver", "tests.ArraySliceTests.testNullableReceiver: a slice through an absent array returns null", || {
        let absent: Option<Vec<u32>> = None;
        test_core::TestCore::test_core_equals_string(UStr::new(&[110,111,110,101]), ArraySliceOps::array_slice_ops_nullable_text((absent).clone(), 0, 2).as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[51,44,52]), ArraySliceOps::array_slice_ops_nullable_text(Some(vec![3, 4]), 0, 20).as_ustr(), UStr::new(&[]));
    });
}

#[test]
fn test_null_init_local() {
    testlib::run("tests.ArraySliceTests.testNullInitLocal", "tests.ArraySliceTests.testNullInitLocal: a slice on a null-initialized array local clamps as well", || {
        test_core::TestCore::test_core_equals_string(UStr::new(&[]), ArraySliceOps::array_slice_ops_null_init_text(0).as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[49,44,50,44,51,44,52,44,53]), ArraySliceOps::array_slice_ops_null_init_text(5).as_ustr(), UStr::new(&[]));
    });
}

#[test]
fn test_empty_to_twenty() {
    testlib::run("tests.ArraySliceTests.testEmptyToTwenty", "tests.ArraySliceTests.testEmptyToTwenty: a fixed end of 20 on an empty array returns an empty slice", || {
        test_core::TestCore::test_core_equals_string(UStr::new(&[]), ArraySliceOps::array_slice_ops_empty_to_twenty_text().as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_int(0i32, i32::from_ne_bytes(((ArraySliceOps::array_slice_ops_empty_to_twenty_size()) as i32).to_ne_bytes()), UStr::new(&[]));
    });
}

#[test]
fn test_splice_empty_bounds() {
    testlib::run("tests.ArraySliceTests.testSpliceEmptyBounds", "tests.ArraySliceTests.testSpliceEmptyBounds: a negative length or a position past the length removes nothing", || {
        test_core::TestCore::test_core_equals_string(UStr::new(&[124]), ArraySliceOps::array_slice_ops_splice_text(0, 0, 1).as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[124,49]), ArraySliceOps::array_slice_ops_splice_text(1, 4294967293u32, 4294967295u32).as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[124,49]), ArraySliceOps::array_slice_ops_splice_text(1, 1, 2).as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[124,49,44,50,44,51,44,52,44,53]), ArraySliceOps::array_slice_ops_splice_text(5, 20, 1).as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[124,49,44,50,44,51,44,52,44,53]), ArraySliceOps::array_slice_ops_splice_text(5, 0, 4294967294u32).as_ustr(), UStr::new(&[]));
    });
}

#[test]
fn test_splice_negative_position() {
    testlib::run("tests.ArraySliceTests.testSpliceNegativePosition", "tests.ArraySliceTests.testSpliceNegativePosition: a negative position counts from the end and a long length stops at the tail", || {
        test_core::TestCore::test_core_equals_string(UStr::new(&[53,124,49,44,50,44,51,44,52]), ArraySliceOps::array_slice_ops_splice_text(5, 4294967295u32, 2).as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[51,44,52,124,49,44,50,44,53]), ArraySliceOps::array_slice_ops_splice_text(5, 4294967293u32, 2).as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[49,44,50,44,51,44,52,44,53,124]), ArraySliceOps::array_slice_ops_splice_text(5, 4294967287u32, 20).as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[51,44,52,44,53,124,49,44,50]), ArraySliceOps::array_slice_ops_splice_text(5, 4294967293u32, 20).as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[50,44,51,44,52,44,53,124,49]), ArraySliceOps::array_slice_ops_splice_text(5, 1, 20).as_ustr(), UStr::new(&[]));
    });
}

#[test]
fn test_insert_clamping() {
    testlib::run("tests.ArraySliceTests.testInsertClamping", "tests.ArraySliceTests.testInsertClamping: an insert clamps a negative position and a position past the length", || {
        test_core::TestCore::test_core_equals_string(UStr::new(&[57,57]), ArraySliceOps::array_slice_ops_insert_text(0, 0).as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[57,57]), ArraySliceOps::array_slice_ops_insert_text(0, 4294967287u32).as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[57,57]), ArraySliceOps::array_slice_ops_insert_text(0, 20).as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[57,57,44,49]), ArraySliceOps::array_slice_ops_insert_text(1, 0).as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[57,57,44,49]), ArraySliceOps::array_slice_ops_insert_text(1, 4294967295u32).as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[57,57,44,49]), ArraySliceOps::array_slice_ops_insert_text(1, 4294967287u32).as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[49,44,57,57]), ArraySliceOps::array_slice_ops_insert_text(1, 1).as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[49,44,57,57]), ArraySliceOps::array_slice_ops_insert_text(1, 4).as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[49,44,57,57]), ArraySliceOps::array_slice_ops_insert_text(1, 20).as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[57,57,44,49,44,50,44,51,44,52,44,53]), ArraySliceOps::array_slice_ops_insert_text(5, 0).as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[49,44,57,57,44,50,44,51,44,52,44,53]), ArraySliceOps::array_slice_ops_insert_text(5, 1).as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[49,44,50,44,57,57,44,51,44,52,44,53]), ArraySliceOps::array_slice_ops_insert_text(5, 4294967293u32).as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[49,44,50,44,51,44,52,44,57,57,44,53]), ArraySliceOps::array_slice_ops_insert_text(5, 4294967295u32).as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[49,44,50,44,51,44,52,44,57,57,44,53]), ArraySliceOps::array_slice_ops_insert_text(5, 4).as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[49,44,50,44,51,44,52,44,53,44,57,57]), ArraySliceOps::array_slice_ops_insert_text(5, 5).as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[49,44,50,44,51,44,52,44,53,44,57,57]), ArraySliceOps::array_slice_ops_insert_text(5, 6).as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[49,44,50,44,51,44,52,44,53,44,57,57]), ArraySliceOps::array_slice_ops_insert_text(5, 20).as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[57,57,44,49,44,50,44,51,44,52,44,53]), ArraySliceOps::array_slice_ops_insert_text(5, 4294967287u32).as_ustr(), UStr::new(&[]));
    });
}

#[test]
fn test_splice_negative_length() {
    testlib::run("tests.ArraySliceTests.testSpliceNegativeLength", "tests.ArraySliceTests.testSpliceNegativeLength: a negative length removes nothing and leaves the array alone", || {
        test_core::TestCore::test_core_equals_string(UStr::new(&[124]), ArraySliceOps::array_slice_ops_splice_text(0, 0, 4294967295u32).as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[124,49]), ArraySliceOps::array_slice_ops_splice_text(1, 0, 4294967295u32).as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[124,49,44,50,44,51,44,52,44,53]), ArraySliceOps::array_slice_ops_splice_text(5, 2, 4294967295u32).as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[124,49,44,50,44,51,44,52,44,53]), ArraySliceOps::array_slice_ops_splice_text(5, 4294967293u32, 4294967295u32).as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[124,49,44,50,44,51,44,52,44,53]), ArraySliceOps::array_slice_ops_splice_text(5, 20, 4294967295u32).as_ustr(), UStr::new(&[]));
    });
}

#[test]
fn test_splice_position_past_length() {
    testlib::run("tests.ArraySliceTests.testSplicePositionPastLength", "tests.ArraySliceTests.testSplicePositionPastLength: a position past the length removes nothing", || {
        test_core::TestCore::test_core_equals_string(UStr::new(&[124]), ArraySliceOps::array_slice_ops_splice_text(0, 1, 2).as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[124]), ArraySliceOps::array_slice_ops_splice_text(0, 20, 1).as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[124,49]), ArraySliceOps::array_slice_ops_splice_text(1, 2, 1).as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[124,49]), ArraySliceOps::array_slice_ops_splice_text(1, 20, 20).as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[124,49,44,50,44,51,44,52,44,53]), ArraySliceOps::array_slice_ops_splice_text(5, 6, 2).as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[124,49,44,50,44,51,44,52,44,53]), ArraySliceOps::array_slice_ops_splice_text(5, 20, 20).as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[124,49,44,50,44,51,44,52,44,53]), ArraySliceOps::array_slice_ops_splice_text(5, 5, 2).as_ustr(), UStr::new(&[]));
    });
}

#[test]
fn test_splice_length_past_end() {
    testlib::run("tests.ArraySliceTests.testSpliceLengthPastEnd", "tests.ArraySliceTests.testSpliceLengthPastEnd: a length past the end removes only the tail", || {
        test_core::TestCore::test_core_equals_string(UStr::new(&[124]), ArraySliceOps::array_slice_ops_splice_text(0, 0, 20).as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[49,124]), ArraySliceOps::array_slice_ops_splice_text(1, 0, 20).as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[50,44,51,44,52,44,53,124,49]), ArraySliceOps::array_slice_ops_splice_text(5, 1, 20).as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[51,44,52,44,53,124,49,44,50]), ArraySliceOps::array_slice_ops_splice_text(5, 2, 20).as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[51,44,52,44,53,124,49,44,50]), ArraySliceOps::array_slice_ops_splice_text(5, 4294967293u32, 20).as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[53,124,49,44,50,44,51,44,52]), ArraySliceOps::array_slice_ops_splice_text(5, 4294967295u32, 20).as_ustr(), UStr::new(&[]));
    });
}

