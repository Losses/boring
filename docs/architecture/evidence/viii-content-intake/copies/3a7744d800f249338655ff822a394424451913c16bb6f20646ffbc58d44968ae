#!/usr/bin/env bash
# Stage 1: reproduce the producer's "before" (original script) and "after" (hardened) controls.
set -u
. "$(dirname "$0")/xlib.sh"
: > "$EV/rc.tsv"

root_del() {  # root_del FILE MODULE
    python3 - "$1" "$2" <<'PY'
import sys
p, mod = sys.argv[1], sys.argv[2]
lines = open(p, encoding="utf-8").read().split("\n")
out = [l for l in lines if l.strip() != mod]
open(p, "w", encoding="utf-8").write("\n".join(out))
PY
}
alw_reason() { # alw_reason JSON MODULE TARGET REASON
    python3 - "$@" <<'PY'
import json, sys
p, mod, target, reason = sys.argv[1:5]
d = json.load(open(p, encoding="utf-8"))
d.setdefault("exempt", []).append({"target": target, "module": mod, "reason": reason})
json.dump(d, open(p, "w", encoding="utf-8"), indent=2)
PY
}

echo "########## group 1: ORIGINAL script ##########"

new_case orig-baseline orig
run_case orig-baseline

new_case orig-defeatA orig
root_del "$CASE/examples/swift-f32.hxml" tests.EarlyReturnTests
alw_reason "$CASE/tools/roots-guard/roots-allowlist.json" tests.EarlyReturnTests swift "x"
run_case orig-defeatA

new_case orig-defeatB orig
printf 'tests.F32OnlyDivergentTests\n' >> "$CASE/examples/swift-f32.hxml"
run_case orig-defeatB

new_case orig-defeatC orig
alw_reason "$CASE/tools/roots-guard/roots-allowlist.json" boring.ArraySliceOps swift "stale dead entry that nothing needs today"
run_case orig-defeatC

new_case orig-wsreason orig
alw_reason "$CASE/tools/roots-guard/roots-allowlist.json" something.Module swift "   "
run_case orig-wsreason

new_case orig-prefix orig
for t in kotlin rust swift; do
    ( cd "$R" && git show "e1c65975:examples/$t-f32.hxml" ) > "$CASE/examples/$t-f32.hxml"
done
run_case orig-prefix

echo "########## group 2: HARDENED script ##########"

new_case hard-baseline hard
run_case hard-baseline

new_case hard-oldallowlist hard
cp "$ORIG_ALW" "$CASE/tools/roots-guard/roots-allowlist.json"
run_case hard-oldallowlist

for d in A B C; do :; done
new_case hard-defeatA hard
root_del "$CASE/examples/swift-f32.hxml" tests.EarlyReturnTests
alw_reason "$CASE/tools/roots-guard/roots-allowlist.json" tests.EarlyReturnTests swift "x"
run_case hard-defeatA

new_case hard-defeatB hard
printf 'tests.F32OnlyDivergentTests\n' >> "$CASE/examples/swift-f32.hxml"
run_case hard-defeatB

new_case hard-defeatB-real hard
printf 'std.Graphemes\n' >> "$CASE/examples/swift-f32.hxml"
run_case hard-defeatB-real

new_case hard-defeatC hard
alw_reason "$CASE/tools/roots-guard/roots-allowlist.json" boring.ArraySliceOps swift "stale dead entry that nothing needs today"
run_case hard-defeatC

new_case hard-wsreason hard
alw_reason "$CASE/tools/roots-guard/roots-allowlist.json" something.Module swift "   "
run_case hard-wsreason

new_case hard-tinyreason hard
root_del "$CASE/examples/swift-f32.hxml" tests.EarlyReturnTests
alw_reason "$CASE/tools/roots-guard/roots-allowlist.json" tests.EarlyReturnTests swift "todo"
run_case hard-tinyreason

new_case hard-prefix hard
for t in kotlin rust swift; do
    ( cd "$R" && git show "e1c65975:examples/$t-f32.hxml" ) > "$CASE/examples/$t-f32.hxml"
done
run_case hard-prefix

echo "done"
