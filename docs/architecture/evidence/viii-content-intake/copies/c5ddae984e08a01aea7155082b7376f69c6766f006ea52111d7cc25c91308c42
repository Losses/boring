package boring;

import std.ReadOnlyArray;

class NegC2Ops {
    public static function switchReturnDest(flag:Bool):ReadOnlyArray<Int> {
        final choice = flag ? C2Choice.Values([1, 2]) : C2Choice.Marker(0);
        return switch (choice) {
            case Values(values): return values;
            case Marker(_): return fallbackArray();
        };
    }

    public static function switchBindingNoCross(flag:Bool):String {
        final choice = flag ? C2Choice.Values([1, 2]) : C2Choice.Marker(0);
        var values:Array<Int> = switch (choice) {
            case Values(v): v;
            case Marker(_): fallbackArray();
        };
        return values[0] + ":" + values.length;
    }

    public static function fallbackArray():Array<Int> {
        return [9];
    }

    public static function consumeView(values:ReadOnlyArray<Int>, marker:Int):String {
        return values[0] + ":" + marker + ":" + values.length;
    }
}
