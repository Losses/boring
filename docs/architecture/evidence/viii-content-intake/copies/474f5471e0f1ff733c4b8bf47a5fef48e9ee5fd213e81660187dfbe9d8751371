package xsxm;

class EnumProbe {
	public static function throwE1(t:String):Int {
		throw new E1(Faults.F1Fault.One(t));
	}

	public static function throwE2(t:String):Int {
		throw new E2(Faults.F2Fault.Two(t));
	}

	public static function rethrowE1():Int {
		var v = 0;
		try {
			throwE1("a");
		} catch (e:E1) {
			final h = try {
				throw new E1(e.fault);
				99;
			} catch (e2:E1) {
				5;
			}
			v = h;
		}
		return v;
	}

	public static function rethrowE2():Int {
		var v = 0;
		try {
			throwE2("b");
		} catch (e:E2) {
			final h = try {
				throw new E2(e.fault);
				99;
			} catch (e2:E2) {
				6;
			}
			v = h;
		}
		return v;
	}

	public static function main():Void {}
}
