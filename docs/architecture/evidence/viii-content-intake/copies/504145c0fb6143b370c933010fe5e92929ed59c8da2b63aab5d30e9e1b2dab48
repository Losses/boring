package boring

object VectorCodec {
    fun magicOf(width: FloatWidth): String {
        if ((width == FloatWidth.F64)) {
            return "BRG1"
        } else {
            if ((width == FloatWidth.F32)) {
                return "BRG2"
            } else {
                return "BRG3"
            }
        }
    }

    fun widthOfMagic(magic: String): FloatWidth? {
        if ((!VectorCodec.isKnownMagic(magic))) {
            return null
        }
        return VectorCodec.knownWidthOf(magic)
    }

    private fun isKnownMagic(magic: String): Boolean {
        return magic == "BRG1" || magic == "BRG2" || magic == "BRG3"
    }

    private fun knownWidthOf(magic: String): FloatWidth {
        if ((magic == "BRG1")) {
            return FloatWidth.F64
        }
        if ((magic == "BRG2")) {
            return FloatWidth.F32
        }
        return FloatWidth.F16
    }

    fun byteLength(recordCount: Int, width: FloatWidth): Int {
        if ((width == FloatWidth.F64)) {
            return 8 + recordCount * 44
        } else {
            if ((width == FloatWidth.F32)) {
                return 8 + recordCount * 24
            } else {
                return 8 + recordCount * 14
            }
        }
    }

    fun encode(records: List<GlyphMetrics>, width: FloatWidth = FloatWidth.F64): ByteArray {
        val writer = BinaryWriter()
        writer.writeAscii(VectorCodec.magicOf(width))
        writer.writeU32(records.size)
        for (record in records) {
            writer.writeU32(record.codePoint)
            if ((width == FloatWidth.F64)) {
                writer.writeF64(record.advanceEm)
            } else {
                if ((width == FloatWidth.F32)) {
                    writer.writeF32(record.advanceEm)
                } else {
                    writer.writeF16(record.advanceEm)
                }
            }
            if ((width == FloatWidth.F64)) {
                writer.writeF64(record.bounds.xMin)
            } else {
                if ((width == FloatWidth.F32)) {
                    writer.writeF32(record.bounds.xMin)
                } else {
                    writer.writeF16(record.bounds.xMin)
                }
            }
            if ((width == FloatWidth.F64)) {
                writer.writeF64(record.bounds.yMin)
            } else {
                if ((width == FloatWidth.F32)) {
                    writer.writeF32(record.bounds.yMin)
                } else {
                    writer.writeF16(record.bounds.yMin)
                }
            }
            if ((width == FloatWidth.F64)) {
                writer.writeF64(record.bounds.xMax)
            } else {
                if ((width == FloatWidth.F32)) {
                    writer.writeF32(record.bounds.xMax)
                } else {
                    writer.writeF16(record.bounds.xMax)
                }
            }
            if ((width == FloatWidth.F64)) {
                writer.writeF64(record.bounds.yMax)
            } else {
                if ((width == FloatWidth.F32)) {
                    writer.writeF32(record.bounds.yMax)
                } else {
                    writer.writeF16(record.bounds.yMax)
                }
            }
        }
        return writer.finish()
    }

    fun decode(bytes: ByteArray): List<GlyphMetrics> {
        val reader = BinaryReader(bytes)
        val magic = reader.readAscii(4)
        if ((!VectorCodec.isKnownMagic(magic))) {
            throw VectorException.BadMagic
        }
        val width = VectorCodec.knownWidthOf(magic)
        val count = reader.readU32()
        if ((count < 0)) {
            throw VectorException.CountOverflow
        }
        val records = Array(count) { index ->
            val codePoint = reader.readU32()
            val advanceEm = (if ((width == FloatWidth.F64)) reader.readF64() else (if ((width == FloatWidth.F32)) reader.readF32() else reader.readF16()))
            val xMin = (if ((width == FloatWidth.F64)) reader.readF64() else (if ((width == FloatWidth.F32)) reader.readF32() else reader.readF16()))
            val yMin = (if ((width == FloatWidth.F64)) reader.readF64() else (if ((width == FloatWidth.F32)) reader.readF32() else reader.readF16()))
            val xMax = (if ((width == FloatWidth.F64)) reader.readF64() else (if ((width == FloatWidth.F32)) reader.readF32() else reader.readF16()))
            val yMax = (if ((width == FloatWidth.F64)) reader.readF64() else (if ((width == FloatWidth.F32)) reader.readF32() else reader.readF16()))
            GlyphMetrics(codePoint = codePoint, advanceEm = advanceEm, bounds = BoundsEm(xMin = xMin, yMin = yMin, xMax = xMax, yMax = yMax))
        }
        if ((reader.remaining() != 0)) {
            throw VectorException.TrailingBytes(reader.remaining())
        }
        return records.asList()
    }
}
