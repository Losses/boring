use crate::runtime::u_string::UStr;
use crate::runtime::u_string::UString;


#[derive(Debug, Clone, PartialEq)]
pub enum F1Fault {
    One { t: UString },
}

impl std::fmt::Display for F1Fault {
    fn fmt(&self, formatter: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        match self {
            F1Fault::One { t } => {
                write!(formatter, "{}", t)
            }
        }
    }
}

impl std::error::Error for F1Fault {}

#[derive(Debug, Clone, PartialEq)]
pub struct E1 {
    pub fault: F1Fault,
}
impl E1 {
    pub fn new(fault: F1Fault) -> Self {
        E1 { fault }
    }
}
impl std::fmt::Display for E1 {
    fn fmt(&self, formatter: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        write!(formatter, "{}", self.fault)
    }
}

#[derive(Debug, Clone, PartialEq)]
pub enum F2Fault {
    Two { t: UString },
    E1Fault(Box<crate::xsxm::cross_probe::E1>),
    E2Fault(Box<crate::xsxm::cross_probe::E2>),
}

impl std::fmt::Display for F2Fault {
    fn fmt(&self, formatter: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        match self {
            F2Fault::Two { t } => {
                write!(formatter, "{}", t)
            }
            F2Fault::E1Fault(inner) => write!(formatter, "{:?}", inner),
            F2Fault::E2Fault(inner) => write!(formatter, "{:?}", inner),
        }
    }
}

impl std::error::Error for F2Fault {}

#[derive(Debug, Clone, PartialEq)]
pub struct E2 {
    pub fault: F2Fault,
}
impl E2 {
    pub fn new(fault: F2Fault) -> Self {
        E2 { fault }
    }
}
impl std::fmt::Display for E2 {
    fn fmt(&self, formatter: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        write!(formatter, "{}", self.fault)
    }
}

#[derive(Clone, Copy)]
pub struct CrossProbe;

impl CrossProbe {
    pub fn cross_probe_throw_e1(t: &UStr) -> Result<u32, F1Fault> {
        return Err(F1Fault::One { t: t.to_ustring() });
    }

    pub fn cross_probe_throw_e2(t: &UStr) -> Result<u32, F2Fault> {
        return Err(F2Fault::Two { t: t.to_ustring() });
    }

    pub fn cross_probe_rethrow_e1() -> Result<u32, F1Fault> {
        let mut v = 0u32;
        let __outcome: Result<u32, F2Fault> = (|| {
            return Ok(CrossProbe::cross_probe_throw_e1(UStr::new(&[97]))?);
        })();
        match __outcome {
            Ok(_) => {}
            Err(e) => {
                let h: u32 = match (|| -> Result<u32, F2Fault> {
                    return Err(F2Fault::E1Fault(Box::new(E1::new(e.fault))));
                })() {
                    Ok(__value) => __value,
                    Err(e2) => 5,
                };
                v = h;
            }
        }
        return Ok(v);
    }

    pub fn cross_probe_rethrow_e2() -> u32 {
        let mut v = 0u32;
        let __outcome1: Result<u32, F2Fault> = (|| {
            return Ok(CrossProbe::cross_probe_throw_e2(UStr::new(&[98]))?);
        })();
        match __outcome1 {
            Ok(_) => {}
            Err(e) => {
                let h: u32 = match (|| -> Result<u32, F2Fault> {
                    return Err(F2Fault::E2Fault(Box::new(E2::new(e))));
                })() {
                    Ok(__value1) => __value1,
                    Err(e2) => 6,
                };
                v = h;
            }
        }
        return v;
    }

    pub fn cross_probe_main() {
    }
}
