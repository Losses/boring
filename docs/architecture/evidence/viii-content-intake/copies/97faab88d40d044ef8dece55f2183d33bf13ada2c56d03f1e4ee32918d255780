#![cfg(test)]

use crate::boring::private_holder::PrivateHolder;
use crate::boring::value_record::ValueRecord;
use crate::runtime::test as testlib;
use crate::runtime::test_core;
use crate::runtime::u_string::UStr;
use crate::runtime::u_string::UString;
use crate::tests::value_record_probes::ValueRecordProbes;


#[test]
fn test_construction() {
    testlib::run("tests.ValueRecordTests.testConstruction", "tests.ValueRecordTests.testConstruction: constructor keeps the given fields and validates nothing in range", || {
        let record = ValueRecord::new(2u32, 7u32, &(UStr::new(&[115,112,97,110]))).unwrap();
        test_core::TestCore::test_core_equals_int(2i32, i32::from_ne_bytes(((record.start) as i32).to_ne_bytes()), UStr::new(&[]));
        test_core::TestCore::test_core_equals_int(7i32, i32::from_ne_bytes(((record.end) as i32).to_ne_bytes()), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[115,112,97,110]), (record.label).to_ustring().as_ustr(), UStr::new(&[]));
    });
}

#[test]
fn test_property() {
    testlib::run("tests.ValueRecordTests.testProperty", "tests.ValueRecordTests.testProperty: getter-only property computes per read", || {
        let record = ValueRecord::new(2u32, 7u32, &(UStr::new(&[115,112,97,110]))).unwrap();
        test_core::TestCore::test_core_equals_int(5i32, i32::from_ne_bytes(((record.get_length()) as i32).to_ne_bytes()), UStr::new(&[]));
    });
}

#[test]
fn test_start_after_end() {
    testlib::run("tests.ValueRecordTests.testStartAfterEnd", "tests.ValueRecordTests.testStartAfterEnd: constructor throws on start after end", || {
        test_core::TestCore::test_core_equals_bool(true, ValueRecordProbes::value_record_probes_ctor_rejected(8, 3), UStr::new(&[]));
    });
}

#[test]
fn test_negative_start() {
    testlib::run("tests.ValueRecordTests.testNegativeStart", "tests.ValueRecordTests.testNegativeStart: constructor throws on negative start", || {
        test_core::TestCore::test_core_equals_bool(true, ValueRecordProbes::value_record_probes_ctor_rejected(4294967295u32, 3), UStr::new(&[]));
    });
}

#[test]
fn test_accepted() {
    testlib::run("tests.ValueRecordTests.testAccepted", "tests.ValueRecordTests.testAccepted: in-range construction is accepted", || {
        test_core::TestCore::test_core_equals_bool(false, ValueRecordProbes::value_record_probes_ctor_rejected(0, 0), UStr::new(&[]));
    });
}

#[test]
fn test_copy_zero() {
    testlib::run("tests.ValueRecordTests.testCopyZero", "tests.ValueRecordTests.testCopyZero: copy without override keeps every field", || {
        let record = ValueRecord::new(2u32, 7u32, &(UStr::new(&[115,112,97,110]))).unwrap();
        let copy = ValueRecord::new(record.start, record.end, (record.label).to_ustring().as_ustr()).unwrap();
        test_core::TestCore::test_core_equals_int(2i32, i32::from_ne_bytes(((copy.start) as i32).to_ne_bytes()), UStr::new(&[]));
        test_core::TestCore::test_core_equals_int(7i32, i32::from_ne_bytes(((copy.end) as i32).to_ne_bytes()), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[115,112,97,110]), (copy.label).to_ustring().as_ustr(), UStr::new(&[]));
    });
}

#[test]
fn test_copy_one() {
    testlib::run("tests.ValueRecordTests.testCopyOne", "tests.ValueRecordTests.testCopyOne: copy with one override replaces the targeted field", || {
        let record = ValueRecord::new(2u32, 7u32, &(UStr::new(&[115,112,97,110]))).unwrap();
        let copy = ValueRecord::new(record.start, 9u32, (record.label).to_ustring().as_ustr()).unwrap();
        test_core::TestCore::test_core_equals_int(2i32, i32::from_ne_bytes(((copy.start) as i32).to_ne_bytes()), UStr::new(&[]));
        test_core::TestCore::test_core_equals_int(9i32, i32::from_ne_bytes(((copy.end) as i32).to_ne_bytes()), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[115,112,97,110]), (copy.label).to_ustring().as_ustr(), UStr::new(&[]));
    });
}

#[test]
fn test_copy_reordered() {
    testlib::run("tests.ValueRecordTests.testCopyReordered", "tests.ValueRecordTests.testCopyReordered: copy with reordered overrides keeps parameter order", || {
        let record = ValueRecord::new(2u32, 7u32, &(UStr::new(&[115,112,97,110]))).unwrap();
        let copy = ValueRecord::new(4u32, record.end, &(UStr::new(&[114,101,110,97,109,101,100]))).unwrap();
        test_core::TestCore::test_core_equals_int(4i32, i32::from_ne_bytes(((copy.start) as i32).to_ne_bytes()), UStr::new(&[]));
        test_core::TestCore::test_core_equals_int(7i32, i32::from_ne_bytes(((copy.end) as i32).to_ne_bytes()), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[114,101,110,97,109,101,100]), (copy.label).to_ustring().as_ustr(), UStr::new(&[]));
    });
}

#[test]
fn test_equality() {
    testlib::run("tests.ValueRecordTests.testEquality", "tests.ValueRecordTests.testEquality: structural equality compares constructor fields", || {
        let left = ValueRecord::new(2u32, 7u32, &(UStr::new(&[115,112,97,110]))).unwrap();
        let same = ValueRecord::new(2u32, 7u32, &(UStr::new(&[115,112,97,110]))).unwrap();
        let other = ValueRecord::new(2u32, 8u32, &(UStr::new(&[115,112,97,110]))).unwrap();
        test_core::TestCore::test_core_equals_bool(true, left.start == same.start && left.end == same.end && (left.label).to_ustring() == (same.label).to_ustring(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_bool(false, left.start == other.start && left.end == other.end && (left.label).to_ustring() == (other.label).to_ustring(), UStr::new(&[]));
    });
}

#[test]
fn test_printed_form() {
    testlib::run("tests.ValueRecordTests.testPrintedForm", "tests.ValueRecordTests.testPrintedForm: printed form names the class and constructor fields", || {
        let record = ValueRecord::new(2u32, 7u32, &(UStr::new(&[115,112,97,110]))).unwrap();
        test_core::TestCore::test_core_equals_string(UStr::new(&[86,97,108,117,101,82,101,99,111,114,100,40,115,116,97,114,116,61,50,44,32,101,110,100,61,55,44,32,108,97,98,101,108,61,115,112,97,110,41]), (UString::from(format!("{}", { let mut __s = UString::new(); __s += &(UString::from("ValueRecord(")); __s += &(UString::from("start=")); __s += &(UString::from((record.start).to_string().as_str())); __s += &(UString::from(", ")); __s += &(UString::from("end=")); __s += &(UString::from((record.end).to_string().as_str())); __s += &(UString::from(", ")); __s += &(UString::from("label=")); __s += (record.label).to_ustring().as_ustr(); __s += &(UString::from(")")); __s }).as_str())).as_ustr(), UStr::new(&[]));
    });
}

#[test]
fn test_private_holder() {
    testlib::run("tests.ValueRecordTests.testPrivateHolder", "tests.ValueRecordTests.testPrivateHolder: private constructor-parameter field survives construction", || {
        let holder = PrivateHolder::new(10u32, 20u32);
        test_core::TestCore::test_core_equals_int(10i32, i32::from_ne_bytes(((holder.shown) as i32).to_ne_bytes()), UStr::new(&[]));
        test_core::TestCore::test_core_equals_int(30i32, i32::from_ne_bytes(((holder.total()) as i32).to_ne_bytes()), UStr::new(&[]));
    });
}
