#!/usr/bin/env bash
# Option C per-stage wrapper. Invoked BY the plan (each plan stage line
# calls this wrapper), itself captured by run-exclusive.sh's run_stage:
# so this wrapper's stdout/stderr/rc ARE the sealed raw stage evidence.
#
# Sequence per invocation:
# 1. run the stage command with cwd at the Option C root, capturing its
#    stdout/stderr/rc exactly (original rc saved to <name>.rc);
# 2. stream the captured stdout and stderr to the wrapper's own stdout,
#    which run-exclusive.sh seals as the stage's evidence;
# 3. ALWAYS run the 1366-entry post-state check (also after a failed
#    command), writing the report into the sealed stdout and saving its
#    exit code separately so it can never overwrite the original rc;
# 4. exit with the original rc when nonzero (blocking downstream), else
#    with the post-state check's code when it failed (also blocking),
#    else 0.
set -u

NAME="${1:-}"
OPTION_C_ROOT="${2:-}"
SOURCE_MANIFEST="${3:-}"
POSTSTATE="${4:-}"
OUTDIR="${5:-}"
shift 5
if [ "${1:-}" = "--" ]; then
    shift
fi

if [ -z "$NAME" ] || [ -z "$OPTION_C_ROOT" ] || [ ! -f "$SOURCE_MANIFEST" ] || [ ! -f "$POSTSTATE" ] || [ -z "$OUTDIR" ] || [ "$#" -eq 0 ]; then
    printf '%s\n' "usage: option-c-stage-wrapper.sh NAME ROOT MANIFEST POSTSTATE OUTDIR -- command..." >&2
    exit 64
fi

mkdir -p "$OUTDIR" || exit 65

TMPDIR="$OUTDIR/tmpdir"
export TMPDIR
mkdir -p "$TMPDIR"

"$@" >"$OUTDIR/$NAME.stdout" 2>"$OUTDIR/$NAME.stderr"
rc=$?
printf '%s\n' "$rc" >"$OUTDIR/$NAME.rc"

cat "$OUTDIR/$NAME.stdout"
cat "$OUTDIR/$NAME.stderr"

python3 "$POSTSTATE" "$OPTION_C_ROOT" "$SOURCE_MANIFEST" "$OUTDIR/$NAME.poststate"
poststate_rc=$?
cat "$OUTDIR/$NAME.poststate"
printf '%s\n' "$poststate_rc" >"$OUTDIR/$NAME.poststate-rc"

if [ "$rc" -ne 0 ]; then
    exit "$rc"
fi
if [ "$poststate_rc" -ne 0 ]; then
    exit "$poststate_rc"
fi
exit 0
