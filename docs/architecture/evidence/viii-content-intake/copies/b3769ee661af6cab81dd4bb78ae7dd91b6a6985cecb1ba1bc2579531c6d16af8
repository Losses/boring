package tests

import boring.ComparatorGateOps
import boring.runtime.test.Test

class ComparatorGateTests {
@boring.test.Test
    fun comparable() {
        Test.run("tests.ComparatorGateTests.comparable", "tests.ComparatorGateTests.comparable: comparable data classes remain usable") {
                Test.equals("ok", ComparatorGateOps.comparable().value.name, null)
        }
    }

@boring.test.Test
    fun unsupported() {
        Test.run("tests.ComparatorGateTests.unsupported", "tests.ComparatorGateTests.unsupported: data classes with unsupported comparator fields remain usable") {
                Test.equals("ok", ComparatorGateOps.comparable().value.name, null)
        }
    }
}
