const checks = [
  ["1 ts", ts.includes("public static readonly readOnlyInts: readonly number[] = [10, 20, 30];")],
  ["2 kotlin", kotlin.includes("val readOnlyInts: List<Int> = listOf(10, 20, 30)")],
  ["3 kotlin", kotlin.includes("val mutableInts: MutableList<Int> = mutableListOf<Int>(40, 50)")],
