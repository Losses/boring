package boring

object NullableArrayOps {
    fun literalMixed(): MutableList<Int?> {
        return mutableListOf<Int?>(1, null, 3)
    }

    fun literalSingleNull(): MutableList<Int?> {
        return mutableListOf<Int?>(null)
    }

    fun fromNullableVar(value: Int?): MutableList<Int?> {
        return mutableListOf<Int?>(value, 5, null)
    }

    fun nullableStrings(): MutableList<String?> {
        return mutableListOf<String?>("a", null, "c")
    }

    fun elementMatches(value: MutableList<Int?>, index: Int, expected: Int?): Boolean {
        return value[index] == expected
    }

    fun stringElementMatches(value: MutableList<String?>, index: Int, expected: String?): Boolean {
        return value[index] == expected
    }
}
