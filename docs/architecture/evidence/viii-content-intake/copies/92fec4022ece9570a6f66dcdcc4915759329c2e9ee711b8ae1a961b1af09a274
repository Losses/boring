package tests

object CryptoTestSupport {
    fun data(name: String): ByteArray {
        if ((name == "empty")) {
            return ByteArray(0)
        }
        if ((name == "abc")) {
            return CryptoTestSupport.ascii(mutableListOf<Int>(97, 98, 99))
        }
        if ((name == "digits")) {
            return CryptoTestSupport.ascii(mutableListOf<Int>(49, 50, 51, 52, 53, 54, 55, 56, 57))
        }
        var length = 0
        if ((name == "bytes0to255")) {
            length = 256
        } else {
            if ((name == "len1")) {
                length = 1
            } else {
                if ((name == "len16")) {
                    length = 16
                } else {
                    if ((name == "len17")) {
                        length = 17
                    } else {
                        if ((name == "len63")) {
                            length = 63
                        } else {
                            if ((name == "len64")) {
                                length = 64
                            } else {
                                if ((name == "len65")) {
                                    length = 65
                                } else {
                                    if ((name == "len127")) {
                                        length = 127
                                    } else {
                                        if ((name == "len128")) {
                                            length = 128
                                        } else {
                                            if ((name == "len129")) {
                                                length = 129
                                            } else {
                                                if ((name == "len239")) {
                                                    length = 239
                                                } else {
                                                    if ((name == "len240")) {
                                                        length = 240
                                                    } else {
                                                        if ((name == "len241")) {
                                                            length = 241
                                                        } else {
                                                            if ((name == "len1003")) {
                                                                length = 1003
                                                            } else {
                                                                if ((name == "len1004")) {
                                                                    length = 1004
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        val bytes = ByteArray(length)
        for (i in 0 until length) {
            bytes[i] = (if ((name == "bytes0to255")) ((i) and (255)) else ((i * 31 + 7) and (255))).toByte()
        }
        return bytes
    }

    private fun ascii(values: MutableList<Int>): ByteArray {
        val bytes = ByteArray(values.size)
        for (i in 0 until values.size) {
            bytes[i] = values[i].toByte()
        }
        return bytes
    }

    fun signed32(raw: Float): Int {
        return (if ((raw >= 2147483648.0f)) (raw - 4294967296.0f).toInt() else (raw).toInt())
    }

    fun i64Hex(value: Long): String {
        return CryptoTestSupport.wordHex((value shr 32).toInt()) + CryptoTestSupport.wordHex(value.toInt())
    }

    private fun wordHex(value: Int): String {
        var s = (value).toUInt().toString(16).uppercase()
        while ((s.length < 8)) {
            s = "0" + s
        }
        return s.lowercase()
    }
}
