#!/usr/bin/env bash
# normalise.sh <tag> -- copy /tmp/bx/sweep/<tag> to a path-normalised mirror.
set -u
SW=/tmp/bx/sweep/$1
NORM=/tmp/bx/sweep/norm-$1
rm -rf "$NORM"; mkdir -p "$NORM"
cp -r "$SW"/. "$NORM"/
python3 - "$NORM" "$SW" <<'PY'
import os, sys
root, orig = sys.argv[1], sys.argv[2]
n = 0
for dirpath, dirnames, filenames in os.walk(root):
    for f in filenames:
        p = os.path.join(dirpath, f)
        try:
            with open(p, 'rb') as fh:
                data = fh.read()
            if b'\0' in data:
                continue
            text = data.decode('utf-8')
        except (UnicodeDecodeError, OSError):
            continue
        new = text.replace(orig, 'SWEEP').replace(root, 'SWEEP')
        if new != text:
            with open(p, 'w') as fh:
                fh.write(new)
            n += 1
print(f"normalised {n} file(s) under {root}")
PY
