#![cfg(test)]

use crate::boring::swift_literal_safety_ops::SwiftLiteralSafetyOps;
use crate::runtime::test as testlib;
use crate::runtime::test_core;
use crate::runtime::u_string::UStr;
use crate::runtime::u_string::UString;


#[test]
fn test_trailing_point() {
    testlib::run("tests.SwiftLiteralSafetyOpsTests.testTrailingPoint", "tests.SwiftLiteralSafetyOpsTests.testTrailingPoint: trailing-point float literal renders as zero", || {
        test_core::TestCore::test_core_equals_float(0.0f32, SwiftLiteralSafetyOps::swift_literal_safety_ops_trailing_point(), UStr::new(&[]));
    });
}

#[test]
fn test_control_text() {
    testlib::run("tests.SwiftLiteralSafetyOpsTests.testControlText", "tests.SwiftLiteralSafetyOpsTests.testControlText: control character in literal renders escaped", || {
        test_core::TestCore::test_core_equals_string((UString::from(format!("{}", { let mut __s = UString::new(); __s += &(UString::from("before")); __s += &(UString::from("")); __s += &(UString::from("after")); __s }).as_str())).as_ustr(), SwiftLiteralSafetyOps::swift_literal_safety_ops_control_text().as_ustr(), UStr::new(&[]));
    });
}
