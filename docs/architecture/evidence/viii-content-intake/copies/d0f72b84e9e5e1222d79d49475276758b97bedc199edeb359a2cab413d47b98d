#[test]
fn ctor_param_read_default() {
    testlib::run("tests.DefaultArgsTests.ctorParamReadDefault", "tests.DefaultArgsTests.ctorParamReadDefault: constructor coalescing default reading an earlier parameter resolves at the call site", || {
        let bopomofo = ParamReadSpan::new(ParamReadKind::Bopomofo, if ParamReadKind::Bopomofo == ParamReadKind::Bopomofo { Some(UString::from("zh-TW")) } else { None });
        assert_equals_opt_string(&Some(UString::from("zh-TW")), &bopomofo.locale, UStr::new(&[]));
        let pinyin = ParamReadSpan::new(ParamReadKind::Pinyin, if ParamReadKind::Pinyin == ParamReadKind::Bopomofo { Some(UString::from("zh-TW")) } else { None });
        assert_equals_opt_string(&None::<UString>, &pinyin.locale, UStr::new(&[]));
        let given = ParamReadSpan::new(ParamReadKind::Pinyin, Some(UString::from("zh-Latn")));
        assert_equals_opt_string(&Some(UString::from("zh-Latn")), &given.locale, UStr::new(&[]));
    });
}

