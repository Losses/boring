#[test]
fn test_coalescing_array_freshness() {
    testlib::run("tests.DefaultArgsTests.testCoalescingArrayFreshness", "tests.DefaultArgsTests.testCoalescingArrayFreshness: coalescing array defaults are fresh per constructor call", || {
        let mut first = (DefaultArgsOps::new(Some(vec![])).family_names).clone();
        let second = (DefaultArgsOps::new(Some(vec![])).family_names).clone();
        first.push(UString::from("serif").to_ustring());
        test_core::TestCore::test_core_equals_int(1i32, i32::from_ne_bytes(((u32::try_from((first.len()) & 0xFFFF_FFFF).unwrap_or(0)) as i32).to_ne_bytes()), UStr::new(&[]));
        test_core::TestCore::test_core_equals_int(0i32, i32::from_ne_bytes(((u32::try_from((second.len()) & 0xFFFF_FFFF).unwrap_or(0)) as i32).to_ne_bytes()), UStr::new(&[]));
    });
}

#[test]
fn test_coalescing_map_freshness() {
    testlib::run("tests.DefaultArgsTests.testCoalescingMapFreshness", "tests.DefaultArgsTests.testCoalescingMapFreshness: coalescing map defaults are fresh per function call", || {
        let mut first = DefaultArgsOps::default_args_ops_call_map_default();
        let second = DefaultArgsOps::default_args_ops_call_map_default();
        first.insert(UString::from("serif"), 1);
        test_core::TestCore::test_core_equals_bool(true, first.contains_key(&UString::from("serif")), UStr::new(&[]));
        test_core::TestCore::test_core_equals_bool(false, second.contains_key(&UString::from("serif")), UStr::new(&[]));
    });
}

