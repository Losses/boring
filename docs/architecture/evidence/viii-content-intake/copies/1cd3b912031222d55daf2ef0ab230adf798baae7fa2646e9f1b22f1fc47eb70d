use crate::runtime::u_string::UStr;
use crate::runtime::u_string::UString;


#[derive(Clone, PartialEq)]
pub struct PlainLabel {
    pub text: UString,
    pub width: u32,
}

impl PlainLabel {
    pub fn new(text: &UStr, width: u32) -> Self {
        Self {
            text: text.to_ustring(),
            width,
        }
    }

    pub fn to_string(&self) -> UString {
        return UString::from(format!("{}", { let mut __s = UString::new(); __s += &(UString::from("PlainLabel(text=")); __s += (self.text).to_ustring().as_ustr(); __s += &(UString::from(", width=")); __s += &(UString::from((self.width).to_string().as_str())); __s += &(UString::from(")")); __s }).as_str());
    }
}
