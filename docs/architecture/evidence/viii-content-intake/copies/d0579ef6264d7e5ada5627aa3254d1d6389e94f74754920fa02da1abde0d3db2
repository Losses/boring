package tests

import boring.SwiftLiteralSafetyOps
import boring.runtime.test.Test

class SwiftLiteralSafetyOpsTests {
@boring.test.Test
    fun testTrailingPoint() {
        Test.run("tests.SwiftLiteralSafetyOpsTests.testTrailingPoint", "tests.SwiftLiteralSafetyOpsTests.testTrailingPoint: trailing-point float literal renders as zero") {
                Test.equals(0.0, SwiftLiteralSafetyOps.trailingPoint(), null)
        }
    }

@boring.test.Test
    fun testControlText() {
        Test.run("tests.SwiftLiteralSafetyOpsTests.testControlText", "tests.SwiftLiteralSafetyOpsTests.testControlText: control character in literal renders escaped") {
                Test.equals("before" + "" + "after", SwiftLiteralSafetyOps.controlText(), null)
        }
    }
}
