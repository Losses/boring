package boring

sealed interface RichTextRole {
    override fun toString(): String
}

class Background : RichTextRole {

    override fun toString(): String {
        return "Background"
    }

    companion object {
        val instance: Background = Background()
    }
}

data class Link(val target: String) : RichTextRole {
}

fun compareLink(a: Link, b: Link): Int {
    var cmp = 0
    cmp = a.target.compareTo(b.target)
    if (cmp != 0) return cmp
    return 0
}

data class RichTextSpan(val role: RichTextRole, val note: RichTextRole?) {
}



object RecordInterfaceOps {
    fun singletonSpan(): RichTextSpan {
        return RichTextSpan(Background.instance, null)
    }

    fun recordSpan(): RichTextSpan {
        return RichTextSpan(Link("tiqian"), Background.instance)
    }
}
