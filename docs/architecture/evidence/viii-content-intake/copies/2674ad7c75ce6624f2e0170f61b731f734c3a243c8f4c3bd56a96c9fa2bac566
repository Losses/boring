package boring

object IntDivisionOps {
    fun quotient(numerator: Int, denominator: Int): Double {
        return (numerator).toDouble() / (denominator).toDouble()
    }

    fun offset(width: Int, index: Int, span: Int): Double {
        return (width * index).toDouble() / (span).toDouble()
    }

    fun scaled(width: Int, index: Int, span: Int, bias: Double): Double {
        return (width * index).toDouble() / (span).toDouble() * 2.0 + bias
    }

    fun truncated(numerator: Int, denominator: Int): Int {
        return (numerator / denominator)
    }

    fun remainder(numerator: Int, denominator: Int): Int {
        return numerator % denominator
    }

    fun floored(numerator: Int, denominator: Int): Double {
        return ((kotlin.math.floor((numerator).toDouble() / (denominator).toDouble())).toInt()).toDouble()
    }
}
