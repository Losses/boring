#!/usr/bin/env bash
# xc2-controls.sh -- INDEPENDENT re-run of the controls for the
# check-log-integrity.sh byte-view fix.  Written from scratch by the
# reviewer; it does not source or reuse the author's controls script.
#
# Discipline:
#   * the frozen artifact is only ever EXECUTED (read-only), never written;
#   * every tamper happens on a `cp -a` copy under $W;
#   * rc is read as $? immediately after the command, never through a pipe.
set -u
R=/home/losses/Development/tq-workspace
SRC="$R/boring-wt-architecture/out/integration-a3-evidence/exclusive-runner"
NEW="$SRC/check-log-integrity.sh"
OLD="$R/dc-warn/out/integrity-bytefix/backup/check-log-integrity.sh.orig"
BASE="attempt-20260929T180809-2918225"
W="$R/dc-warn/scratch-xcheck2"
C="$W/copy"
EV="$R/dc-warn/out/bytefix-xcheck2/evidence"
mkdir -p "$C" "$EV"

{
  echo "== environment =="
  echo "date            : $(date -Is)"
  echo "bash            : $BASH_VERSION"
  echo "grep            : $(grep --version | head -1)"
  echo "coreutils tail  : $(tail --version | head -1)"
  echo "NEW checker     : $NEW"
  echo "NEW sha256      : $(sha256sum "$NEW" | cut -d' ' -f1)  ($(wc -c <"$NEW") B)"
  echo "OLD checker     : $OLD"
  echo "OLD sha256      : $(sha256sum "$OLD" | cut -d' ' -f1)  ($(wc -c <"$OLD") B)"
  echo "base attempt    : $BASE"
  echo "base log bytes  : $(wc -c <"$SRC/$BASE/harness.log")"
} > "$EV/xc2-controls.env.txt"

rm -rf "$C/att-clean"
cp -a "$SRC/$BASE" "$C/att-clean"
chmod -R u+rwX "$C/att-clean"
PRIS=$(wc -c <"$C/att-clean/harness.log")
echo "pristine harness.log bytes: $PRIS" >> "$EV/xc2-controls.env.txt"

BIG=$(ls -S "$C/att-clean/stages"/*.stdout | head -1)
STATUS1=$(grep -l '^1$' "$C/att-clean/stages"/*.status | head -1)
ERR0=$(find "$C/att-clean/stages" -name '*.stderr' -size 0 | head -1)
{
  echo "negB2 target : $(basename "$BIG")  ($(wc -c <"$BIG") B)"
  echo "negB3 target : $(basename "$STATUS1")"
  echo "negB4 target : $(basename "$ERR0")"
} >> "$EV/xc2-controls.env.txt"

mk() { rm -rf "$C/$1"; cp -a "$C/att-clean" "$C/$1"; chmod -R u+rwX "$C/$1"; }

mk pos
mk negA1
mk negA6
mk negA5000
mk negB1
mk negB2
mk negB3
mk negB4
mk negC1
mk negC2
mk negD
mk negE

printf 'X'                     >> "$C/negA1/harness.log"
printf 'TAMPER'                >> "$C/negA6/harness.log"
head -c 5000 /dev/zero | tr '\0' 'A' >> "$C/negA5000/harness.log"
printf 'TAMPER\n'              >> "$C/negB1/harness.log"
python3 - "$BIG" <<'PY'
import sys
p = sys.argv[1]
b = bytearray(open(p, 'rb').read())
b[len(b)//2] ^= 0x01
open(p, 'wb').write(bytes(b))
PY
printf '0\n' > "$C/negB3/stages/$(basename "$STATUS1")"
rm -f "$C/negB4/stages/$(basename "$ERR0")"
head -c 1000 "$C/att-clean/harness.log" > "$C/negC1/harness.log"
moff=$(grep -abo '^harness end marker sha256=' "$C/att-clean/harness.log" | cut -d: -f1)
head -c $((moff + 25)) "$C/att-clean/harness.log" > "$C/negC2/harness.log"
printf 'harness end marker sha256=%064d\nFORGED-AFTER\n' 0 >> "$C/negD/harness.log"
python3 - "$C/negE/harness.log" <<'PY'
import sys, hashlib
p = sys.argv[1]
with open(p, 'ab') as f:
    f.write(b"FORGED-PAYLOAD-LINE\n")
prefix = open(p, 'rb').read()
with open(p, 'ab') as f:
    f.write(b"harness end marker sha256=" + hashlib.sha256(prefix).hexdigest().encode() + b"\n")
PY

printf '%-9s %5s %5s %8s %8s  %s\n' CTL OLD NEW LOG_BYTES DELTA VERDICT \
  > "$EV/xc2-controls.tsv"
: > "$EV/xc2-controls.detail.txt"
for c in pos negA1 negA6 negA5000 negB1 negB2 negB3 negB4 negC1 negC2 negD negE; do
  ob=$(bash "$OLD" "$C/$c" 2>&1); orc=$?
  nb=$(bash "$NEW" "$C/$c" 2>&1); nrc=$?
  nbytes=$(wc -c < "$C/$c/harness.log")
  printf '%-9s %5s %5s %8s %8s  %s\n' "$c" "$orc" "$nrc" "$nbytes" \
      "$((nbytes - PRIS))" "$(printf '%s' "$nb" | head -1)" >> "$EV/xc2-controls.tsv"
  {
    printf '===== %s  (harness.log %s bytes, pristine %s)\n' "$c" "$nbytes" "$PRIS"
    printf -- '-- OLD rc=%s\n%s\n' "$orc" "$ob"
    printf -- '-- NEW rc=%s\n%s\n' "$nrc" "$nb"
  } >> "$EV/xc2-controls.detail.txt"
done

python3 - "$C" "$PRIS" "$NEW" <<'PY' | tee "$EV/xc2-arithmetic.txt"
import os, re, sys, subprocess
C, pris, NEW = sys.argv[1], int(sys.argv[2]), sys.argv[3]
MK = b"harness end marker sha256="
print("ctl        pristine  total   exp_end  msg_end msg_total  arith")
for c in ["pos","negA1","negA6","negA5000","negB1","negB2","negB3","negB4",
          "negC1","negC2","negD","negE"]:
    log = os.path.join(C, c, "harness.log")
    data = open(log,'rb').read()
    offs = [i for i in range(len(data)) if data.startswith(MK, i)
            and (i == 0 or data[i-1:i] == b"\n")]
    msg = subprocess.run(["bash", NEW, os.path.join(C,c)],
                         capture_output=True, text=True)
    out = msg.stdout + msg.stderr
    if not offs:
        print(f"{c:<10} {pris:<9} {len(data):<7} {'-':<8} {'no marker at line start':<1}  n/a   rc={msg.returncode}")
        continue
    o = offs[-1]
    nl = data.find(b"\n", o)
    end = (nl + 1) if nl != -1 else len(data)
    m = re.search(r"byte (\d+) of (\d+)", out)
    if m:
        me, mt = int(m.group(1)), int(m.group(2))
        ok = (me == end and mt == len(data))
        print(f"{c:<10} {pris:<9} {len(data):<7} {end:<8} {me:<7} {mt:<10} {'MATCH' if ok else 'MISMATCH'}")
    else:
        print(f"{c:<10} {pris:<9} {len(data):<7} {end:<8} {'-':<7} {'-':<10} rc={msg.returncode} :: {out.strip()[:60]}")
PY

cat "$EV/xc2-controls.tsv"
