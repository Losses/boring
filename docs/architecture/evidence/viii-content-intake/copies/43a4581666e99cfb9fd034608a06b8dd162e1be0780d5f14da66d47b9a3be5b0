package tests

import boring.NoSuchElementFaultException
import boring.NoSuchElementMessageReader
import boring.NoSuchElementNoteException
import boring.NoSuchElementNoteOps
import boring.NoSuchElementThrower
import boring.runtime.test.Test

class NoSuchElementTests {
@boring.test.Test
    fun caught() {
        Test.run("tests.NoSuchElementTests.caught", "tests.NoSuchElementTests.caught: a module-listed exception class that only a catch references stays emitted") {
                var text = ""
                try {
                    NoSuchElementThrower.missing()
                } catch (error: NoSuchElementFaultException) {
                    text = error.message
                }
                Test.equals("no such element", text, null)
        }
    }

@boring.test.Test
    fun messageRead() {
        Test.run("tests.NoSuchElementTests.messageRead", "tests.NoSuchElementTests.messageRead: a message read off a folded exception value outside a catch lowers to the property") {
                val err = NoSuchElementFaultException.Missing
                Test.equals("no such element", NoSuchElementMessageReader.describe(err), null)
        }
    }

@boring.test.Test
    fun foldedVariantMessage() {
        Test.run("tests.NoSuchElementTests.foldedVariantMessage", "tests.NoSuchElementTests.foldedVariantMessage: a folded exception reports its variant message text") {
                Test.equals("gone", NoSuchElementNoteOps.describe(NoSuchElementNoteException.Note("gone")), null)
        }
    }
}
