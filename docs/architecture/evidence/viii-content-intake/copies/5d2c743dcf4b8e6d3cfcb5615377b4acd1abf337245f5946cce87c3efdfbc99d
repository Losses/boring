#[test]
fn test_element_only() {
    testlib::run("tests.ArrayIndexSearchTests.testElementOnly", "tests.ArrayIndexSearchTests.testElementOnly: an element-only array search reads the platform overload", || {
        test_core::TestCore::test_core_equals_bool(true, true, UStr::new(&[]));
    });
}

