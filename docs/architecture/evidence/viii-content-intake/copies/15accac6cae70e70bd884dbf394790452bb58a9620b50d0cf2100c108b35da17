import { readFileSync } from "node:fs";
const path = process.argv[2];
const lines = readFileSync(path, "utf8").split("\n");
// Top-level class members are indented exactly 4 spaces. Inner/nested
// functions are indented 8+ spaces, so they never match this pattern.
const memberRe = /^    (?:public |private |static |inline |override |final )*function\s+([A-Za-z0-9_]+)\s*\(/;
const starts = [];
for (let i = 0; i < lines.length; i++) {
  const m = memberRe.exec(lines[i]);
  if (m) starts.push({ name: m[1], line: i + 1 });
}
const targets = ["switchReturn", "switchAssign", "switchStatement", "switchExpression", "tryStatementLines", "arrayBoundaryText", "lowerArrayBoundary", "armLines"];
const needles = ["SwiftArrayBoundary", "lowerArrayBoundary", "arrayBoundaryText"];
for (const t of targets) {
  const idx = starts.findIndex((s) => s.name === t);
  if (idx < 0) { console.log(`${t}: NOT FOUND`); continue; }
  const from = starts[idx].line;
  const to = idx + 1 < starts.length ? starts[idx + 1].line - 1 : lines.length;
  const body = lines.slice(from - 1, to).map((l, k) => ({ n: from + k, l }));
  const hits = body.filter((b) => needles.some((nd) => b.l.includes(nd)));
  console.log(`${t}: extent lines ${from}-${to} (${to - from + 1} lines), direct refs = ${hits.length}`);
  for (const h of hits) console.log(`    ${h.n}: ${h.l.trim()}`);
}
console.log("--- all member function starts (name@line) ---");
console.log(starts.map((s) => `${s.name}@${s.line}`).join(", "));
