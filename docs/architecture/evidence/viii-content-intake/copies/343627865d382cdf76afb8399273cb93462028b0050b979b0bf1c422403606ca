use crate::runtime::console::Console;
use crate::runtime::u_string::UStr;
use crate::runtime::u_string::UString;


#[derive(Clone, Copy)]
pub struct ConsoleShimOps;

impl ConsoleShimOps {
    pub fn console_shim_ops_log_line(message: &UStr) -> UString {
        Console::log(message);
        return UString::from(format!("{}", { let mut __s = UString::new(); __s += &(UString::from("logged:")); __s += message; __s }).as_str());
    }
}
