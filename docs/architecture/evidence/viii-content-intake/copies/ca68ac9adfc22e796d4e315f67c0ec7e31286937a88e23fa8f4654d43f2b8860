#![cfg(test)]

use crate::haxe::crypto::sha512::Sha512;
use crate::runtime::test as testlib;
use crate::runtime::test_core;
use crate::runtime::u_string::UStr;
use crate::tests::sha512_test_support::Sha512TestSupport;


#[test]
fn empty() {
    testlib::run("tests.Sha512Tests.empty", "tests.Sha512Tests.empty: hashes the empty byte sequence", || {
        test_core::TestCore::test_core_equals_string(UStr::new(&[99,102,56,51,101,49,51,53,55,101,101,102,98,56,98,100,102,49,53,52,50,56,53,48,100,54,54,100,56,48,48,55,100,54,50,48,101,52,48,53,48,98,53,55,49,53,100,99,56,51,102,52,97,57,50,49,100,51,54,99,101,57,99,101,52,55,100,48,100,49,51,99,53,100,56,53,102,50,98,48,102,102,56,51,49,56,100,50,56,55,55,101,101,99,50,102,54,51,98,57,51,49,98,100,52,55,52,49,55,97,56,49,97,53,51,56,51,50,55,97,102,57,50,55,100,97,51,101]), Sha512TestSupport::sha512_test_support_hex(&Sha512::sha512_make(&vec![0u8; 0usize])).as_ustr(), UStr::new(&[]));
    });
}

#[test]
fn abc() {
    testlib::run("tests.Sha512Tests.abc", "tests.Sha512Tests.abc: hashes abc", || {
        let mut bytes = vec![0u8; 3usize];
        bytes[0usize] = 97u8;
        bytes[1usize] = 98u8;
        bytes[2usize] = 99u8;
        test_core::TestCore::test_core_equals_string(UStr::new(&[100,100,97,102,51,53,97,49,57,51,54,49,55,97,98,97,99,99,52,49,55,51,52,57,97,101,50,48,52,49,51,49,49,50,101,54,102,97,52,101,56,57,97,57,55,101,97,50,48,97,57,101,101,101,101,54,52,98,53,53,100,51,57,97,50,49,57,50,57,57,50,97,50,55,52,102,99,49,97,56,51,54,98,97,51,99,50,51,97,51,102,101,101,98,98,100,52,53,52,100,52,52,50,51,54,52,51,99,101,56,48,101,50,97,57,97,99,57,52,102,97,53,52,99,97,52,57,102]), Sha512TestSupport::sha512_test_support_hex(&Sha512::sha512_make(&bytes)).as_ustr(), UStr::new(&[]));
    });
}

#[test]
fn incremental() {
    testlib::run("tests.Sha512Tests.incremental", "tests.Sha512Tests.incremental: matches incremental updates", || {
        let bytes = vec![0u8; 128usize];
        let mut hash = Sha512::new();
        hash.update(&bytes[0usize..usize::try_from(0 + 31).unwrap_or(0)].to_vec());
        hash.update(&bytes[31usize..usize::try_from(31 + 64).unwrap_or(0)].to_vec());
        hash.update(&bytes[95usize..usize::try_from(95 + 33).unwrap_or(0)].to_vec());
        test_core::TestCore::test_core_equals_string(Sha512TestSupport::sha512_test_support_hex(&Sha512::sha512_make(&bytes)).as_ustr(), Sha512TestSupport::sha512_test_support_hex(&hash.digest()).as_ustr(), UStr::new(&[]));
    });
}
