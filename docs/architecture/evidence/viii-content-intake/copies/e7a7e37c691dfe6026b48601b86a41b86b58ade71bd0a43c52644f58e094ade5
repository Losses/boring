use crate::boring::probe_unit::ProbeUnit;


#[derive(Clone, PartialEq)]
pub struct AbstractStaticDefault {
    pub value: ProbeUnit,
}

impl AbstractStaticDefault {
    pub fn new(v: Option<ProbeUnit>) -> Self {
        Self {
            value: match &(v) { None => ProbeUnit::zero(), Some(__option) => (*__option).clone() },
        }
    }
}
