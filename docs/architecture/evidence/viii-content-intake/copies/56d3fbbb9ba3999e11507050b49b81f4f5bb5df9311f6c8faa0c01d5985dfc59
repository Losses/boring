use crate::runtime::u_string::UStr;
use crate::runtime::u_string::UString;


#[derive(Clone, Copy)]
pub struct FontIdImpl;

impl FontIdImpl {
    pub fn font_id_impl_of(face: &UStr) -> UString {
        return UString::from(format!("{}", { let mut __s = UString::new(); __s += &(UString::from("font:")); __s += face; __s }).as_str());
    }
}
