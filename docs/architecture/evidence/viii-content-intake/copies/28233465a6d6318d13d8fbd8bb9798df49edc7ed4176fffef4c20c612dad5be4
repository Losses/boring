package boring

object SwitchOps {
    fun statement(mark: SwitchMark): String {
        var value = "unset"
        when (mark) {
    is SwitchMark.Empty -> value = "empty"
    is SwitchMark.Number -> value = "number:" + mark.value
    is SwitchMark.Text -> value = "text:" + mark.value
    is SwitchMark.Other -> value = "other"
}
        return value
    }

    fun initializer(mark: SwitchMark): String {
        val value = when (mark) {
    is SwitchMark.Empty -> "empty"
    is SwitchMark.Number -> "number:" + mark.value
    is SwitchMark.Text -> "text:" + mark.value
    is SwitchMark.Other -> "other"
}
        return value
    }

    fun assign(mark: SwitchMark): String {
        var value = "unset"
        value = when (mark) {
    is SwitchMark.Empty -> "empty"
    is SwitchMark.Number -> "number:" + mark.value
    is SwitchMark.Text -> "text:" + mark.value
    is SwitchMark.Other -> "other"
}
        return value
    }

    fun conditional(mark: SwitchMark, useFallback: Boolean): String {
        return (if ((useFallback)) "fallback" else when (mark) {
    is SwitchMark.Empty -> "empty"
    is SwitchMark.Number -> "number:" + mark.value
    is SwitchMark.Text -> "text:" + mark.value
    is SwitchMark.Other -> "other"
})
    }

    fun defaulted(mark: SwitchMark): String {
        var value = "unset"
        when (mark) {
    is SwitchMark.Empty -> value = "empty"
    is SwitchMark.Number -> value = "number"
    is SwitchMark.Text -> value = "text"
    is SwitchMark.Other -> value = "fallback"
}
        return value
    }
}

sealed interface SwitchMark {
    data object Empty : SwitchMark
    data class Number(val value: Int) : SwitchMark
    data class Text(val value: String) : SwitchMark
    data object Other : SwitchMark
}
