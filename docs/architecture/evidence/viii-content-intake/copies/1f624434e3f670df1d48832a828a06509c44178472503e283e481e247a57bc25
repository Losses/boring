                Test.equals(3, result.size, "chained length")
                Test.equals(20, result[0], "chained 0")
                Test.equals(40, result[1], "chained 1")
                Test.equals(60, result[2], "chained 2")
                val items = mutableListOf<Item>(Item(id = 1, name = "Alice", score = 10), Item(id = 2, name = "Bob", score = 25), Item(id = 3, name = "Charlie", score = 40))
                val names = PipelineOps.highScorerNames(items, 20)
                Test.equals(2, names.size, "high scorer names length")
                Test.equals("Bob", names[0], "name 0")
                Test.equals("Charlie", names[1], "name 1")
        }
    }

@boring.test.Test
    fun testNestedLoop() {
        Test.run("tests.PipelineTests.testNestedLoop", "tests.PipelineTests.testNestedLoop: nested loops rebuild per-iteration pipeline temporaries") {
                val matrix = mutableListOf<MutableList<Int>>(mutableListOf<Int>(1, 2, 3), mutableListOf<Int>(4, 5, 6))
                val transformed = PipelineOps.nestedLoopMap(matrix, 100)
                Test.equals(2, transformed.size, "matrix length")
                Test.equals(3, transformed[0].size, "row 0 length")
                Test.equals(101, transformed[0][0], "row 0 elem 0")
                Test.equals(102, transformed[0][1], "row 0 elem 1")
                Test.equals(103, transformed[0][2], "row 0 elem 2")
                Test.equals(104, transformed[1][0], "row 1 elem 0")
                Test.equals(105, transformed[1][1], "row 1 elem 1")
                Test.equals(106, transformed[1][2], "row 1 elem 2")
        }
    }

@boring.test.Test
    fun testAny() {
        Test.run("tests.PipelineTests.testAny", "tests.PipelineTests.testAny: any checks predicate matches with early exit and returns false for empty") {
                val empty = mutableListOf<Item>()
                Test.equals(false, PipelineOps.hasHighScore(empty, 50), "empty any is false")
                val items = mutableListOf<Item>(Item(id = 1, name = "Alice", score = 10), Item(id = 2, name = "Bob", score = 25), Item(id = 3, name = "Charlie", score = 40))
                Test.equals(false, PipelineOps.hasHighScore(items, 50), "no match any is false")
                Test.equals(true, PipelineOps.hasHighScore(items, 25), "match any is true")
        }
    }

@boring.test.Test
    fun testAll() {
        Test.run("tests.PipelineTests.testAll", "tests.PipelineTests.testAll: all checks predicate matches all with early exit and returns true for empty") {
                val empty = mutableListOf<Item>()
                Test.equals(true, PipelineOps.allAboveScore(empty, 50), "empty all is true")
                val items = mutableListOf<Item>(Item(id = 1, name = "Alice", score = 10), Item(id = 2, name = "Bob", score = 25), Item(id = 3, name = "Charlie", score = 40))
