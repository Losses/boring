package tests

import boring.Item
import boring.PipelineOps
import boring.runtime.test.Test

class PipelineTests {
@boring.test.Test
    fun testMap() {
        Test.run("tests.PipelineTests.testMap", "tests.PipelineTests.testMap: map transforms elements and pre-allocates fill") {
                val empty = mutableListOf<Item>()
                val emptyDoubled = PipelineOps.doubleScores(empty)
                Test.equals(0, emptyDoubled.size, "empty map length")
                val items = mutableListOf<Item>(Item(id = 1, name = "Alice", score = 10), Item(id = 2, name = "Bob", score = 25), Item(id = 3, name = "Charlie", score = 40))
                val doubled = PipelineOps.doubleScores(items)
                Test.equals(3, doubled.size, "doubled length")
                Test.equals(20, doubled[0], "doubled 0")
                Test.equals(50, doubled[1], "doubled 1")
                Test.equals(80, doubled[2], "doubled 2")
        }
    }

@boring.test.Test
    fun testShadowing() {
        Test.run("tests.PipelineTests.testShadowing", "tests.PipelineTests.testShadowing: lambda parameter shadows outer local variable") {
                val items = mutableListOf<Item>(Item(id = 1, name = "Alice", score = 10), Item(id = 2, name = "Bob", score = 25))
                val shadowed = PipelineOps.shadowingMap(items)
                Test.equals(2, shadowed.size, "shadowed length")
                Test.equals(11, shadowed[0], "shadowed 0")
                Test.equals(27, shadowed[1], "shadowed 1")
        }
    }

