@boring.test.Test
    fun testAssociate() {
        Test.run("tests.PipelineTests.testAssociate", "tests.PipelineTests.testAssociate: associate builds sorted map with last-wins on duplicate keys") {
                val empty = mutableListOf<Item>()
                val emptyMap = PipelineOps.associateById(empty)
                Test.equals(0, emptyMap.size(), "empty map size")
                val items = mutableListOf<Item>(Item(id = 3, name = "Charlie", score = 40), Item(id = 1, name = "Alice", score = 10), Item(id = 2, name = "Bob", score = 25))
                val map = PipelineOps.associateById(items)
                Test.equals(3, map.size(), "map size")
                Test.equals("Alice", map.get(1), "get 1")
                Test.equals("Bob", map.get(2), "get 2")
                Test.equals("Charlie", map.get(3), "get 3")
                val itemsWithDup = mutableListOf<Item>(Item(id = 1, name = "First", score = 10), Item(id = 1, name = "Updated", score = 20))
                val mapDup = PipelineOps.associateById(itemsWithDup)
                Test.equals(1, mapDup.size(), "dup map size")
                Test.equals("Updated", mapDup.get(1), "dup overwrite")
        }
    }

@boring.test.Test
    fun testSortedBy() {
        Test.run("tests.PipelineTests.testSortedBy", "tests.PipelineTests.testSortedBy: sortedBy sorts ascending with platform stability on equal keys") {
                val empty = mutableListOf<Item>()
                val emptySorted = PipelineOps.sortByScore(empty)
                Test.equals(0, emptySorted.size, "empty sorted length")
                val single = mutableListOf<Item>(Item(id = 1, name = "Solo", score = 100))
                val singleSorted = PipelineOps.sortByScore(single)
                Test.equals(1, singleSorted.size, "single sorted length")
                Test.equals(100, singleSorted[0].score, "single sorted score")
                val items = mutableListOf<Item>(Item(id = 1, name = "Charlie", score = 40), Item(id = 2, name = "Alice", score = 10), Item(id = 3, name = "Bob", score = 25))
                val sorted = PipelineOps.sortByScore(items)
                Test.equals(3, sorted.size, "sorted length")
                Test.equals(10, sorted[0].score, "sorted 0")
                Test.equals(25, sorted[1].score, "sorted 1")
                Test.equals(40, sorted[2].score, "sorted 2")
                val itemsWithEqualKeys = mutableListOf<Item>(Item(id = 1, name = "First20", score = 20), Item(id = 2, name = "Ten", score = 10), Item(id = 3, name = "Second20", score = 20), Item(id = 4, name = "Third20", score = 20))
                val sortedStable = PipelineOps.sortByScore(itemsWithEqualKeys)
                Test.equals(4, sortedStable.size, "stable length")
                Test.equals(2, sortedStable[0].id, "stable item 0 (Ten)")
                Test.equals(1, sortedStable[1].id, "stable item 1 (First20)")
                Test.equals(3, sortedStable[2].id, "stable item 2 (Second20)")
                Test.equals(4, sortedStable[3].id, "stable item 3 (Third20)")
        }
    }

@boring.test.Test
    fun testChained() {
        Test.run("tests.PipelineTests.testChained", "tests.PipelineTests.testChained: chained pipeline methods expand in source order") {
                val nums = mutableListOf<Int>(1, 2, 3, 4, 5, 6)
