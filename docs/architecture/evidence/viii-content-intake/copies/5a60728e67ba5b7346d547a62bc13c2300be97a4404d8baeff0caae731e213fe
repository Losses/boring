impl Sha512TestSupport {
    pub fn sha512_test_support_hex(value: &[u8]) -> UString {
        let mut result = UString::new();
        for i in 0..match u32::try_from(value.len()) { Ok(value) => value, Err(_) => u32::MAX } {
            let byte = u32::from(value[usize::try_from(i).unwrap_or(0)]);
            let high = byte >> 4;
            let low = byte & 15;
            result += &(if (if i32::from_ne_bytes(((high) as i32).to_ne_bytes()) < (10) { u32::wrapping_add(48, high) } else { u32::wrapping_add(87, high) }) > 0xFFFF { u_string::from_units(&[0xD800 + (((if i32::from_ne_bytes(((high) as i32).to_ne_bytes()) < (10) { u32::wrapping_add(48, high) } else { u32::wrapping_add(87, high) }) - 0x10000) >> 10) as u16, 0xDC00 + (((if i32::from_ne_bytes(((high) as i32).to_ne_bytes()) < (10) { u32::wrapping_add(48, high) } else { u32::wrapping_add(87, high) }) - 0x10000) & 0x3FF) as u16]) } else { u_string::from_units(&[(if i32::from_ne_bytes(((high) as i32).to_ne_bytes()) < (10) { u32::wrapping_add(48, high) } else { u32::wrapping_add(87, high) }) as u16]) });
            result += &(if (if i32::from_ne_bytes(((low) as i32).to_ne_bytes()) < (10) { u32::wrapping_add(48, low) } else { u32::wrapping_add(87, low) }) > 0xFFFF { u_string::from_units(&[0xD800 + (((if i32::from_ne_bytes(((low) as i32).to_ne_bytes()) < (10) { u32::wrapping_add(48, low) } else { u32::wrapping_add(87, low) }) - 0x10000) >> 10) as u16, 0xDC00 + (((if i32::from_ne_bytes(((low) as i32).to_ne_bytes()) < (10) { u32::wrapping_add(48, low) } else { u32::wrapping_add(87, low) }) - 0x10000) & 0x3FF) as u16]) } else { u_string::from_units(&[(if i32::from_ne_bytes(((low) as i32).to_ne_bytes()) < (10) { u32::wrapping_add(48, low) } else { u32::wrapping_add(87, low) }) as u16]) });
        }
        return result;
    }
}
