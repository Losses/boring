#!/usr/bin/env python3
"""Apply one named mutation to the scratch worktree's rustcompiler sources."""
import shutil, sys, os
WT = "/home/losses/Development/tq-workspace/rust-keyfix-xcheck-wt/packages/compiler/reflaxe/rust/rustcompiler"
HERE = os.path.dirname(os.path.abspath(__file__))
FILES = ["Compiler.hx", "RustDecl.hx", "RustEmissionState.hx", "RustExpr.hx"]

def load(base):
    for f in FILES:
        shutil.copyfile(os.path.join(HERE, "mutations", base, f), os.path.join(WT, f))

def sub(fname, old, new):
    p = os.path.join(WT, fname)
    t = open(p, encoding="utf-8").read()
    n = t.count(old)
    assert n == 1, f"{fname}: expected 1 occurrence, found {n}"
    open(p, "w", encoding="utf-8").write(t.replace(old, new))

m = sys.argv[1]
if m == "M1":
    load("fixed")
    sub("Compiler.hx",
        "state.exceptionClassRefs.set(cls.module + \"::\" + cls.name, true);",
        "// MUTATION M1: class-ref registration disabled")
elif m == "M2":
    load("fixed")
    sub("Compiler.hx", """                final recorded = state.exceptionPayloadEnums.get(cls.module + "::" + cls.name);
                if (recorded == null || recorded.module != payloadEnum.module || recorded.name != payloadEnum.name)
                    return;
                final enumName = recorded.name;""",
        """                final enumName = state.payloadEnumNames.get(payloadEnum.module);
                if (enumName == null || enumName != payloadEnum.name)
                    return;""")
elif m == "M3":
    load("frozen")
    sub("Compiler.hx",
        "state.payloadEnumNames.set(payload.module, payload.name);",
        "if (!state.payloadEnumNames.exists(payload.module)) state.payloadEnumNames.set(payload.module, payload.name);")
elif m == "M4":
    load("fixed")
    sub("RustExpr.hx",
        'if (errorTypeName == null || !StringTools.endsWith(errorTypeName, "Fault"))',
        'if (errorTypeName == null)')
elif m == "M5":
    load("fixed")
    sub("RustExpr.hx", """                        final cls = c.get();
                        final enumModule = state.exceptionPayloads.get(cls.module);
                        if (enumModule != null) {
                            for (f in cls.fields.get()) {
                                if (f.name == name) {
                                    switch (f.type) {
                                        case TEnum(en, _):
                                            if (en.get().module == enumModule) {""",
        """                        final cls = c.get();
                        final classKeyed = state.exceptionPayloadEnums.get(cls.module + "::" + cls.name);
                        final enumModule = classKeyed != null ? classKeyed.module : state.exceptionPayloads.get(cls.module);
                        if (enumModule != null) {
                            for (f in cls.fields.get()) {
                                if (f.name == name) {
                                    switch (f.type) {
                                        case TEnum(en, _):
                                            if (en.get().module == enumModule) {""")
elif m in ("frozen", "fixed"):
    load(m)
else:
    raise SystemExit("unknown mutation " + m)
print("applied", m)
