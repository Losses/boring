#!/usr/bin/env bash
# Witnessed entry-set diff between the two input states, run on the pre-fix
# export (wt-prefix) whose artifact-affecting files are byte-identical to
# 2aadcb69's (only tests/ts/package-artifacts.test.ts differs between them).
export PATH="$(grep -m1 '^PATH=' /home/losses/Development/tq-workspace/dc-warn/out/chainA-fixed-rerun/evidence/env.json | cut -d= -f2-)"
TREE=/tmp/verify-2aadcb69/wt-prefix
F="$TREE/samples/boring/MathNaNTestSupport.hx"
E=/tmp/verify-2aadcb69/logs
cp /tmp/verify-2aadcb69/pristine-fixture.hx "$F"
KEEP=1 bun /tmp/verify-2aadcb69/scripts/repro-verify.mjs "$TREE" real 1 keep-real > "$E/E-real-keep.log" 2>&1
R=$(grep -o '"root":"[^"]*"' "$E/E-real-keep.log" | head -1 | cut -d'"' -f4)
cp "$R/ts/generated-0.1.0.tgz" /tmp/verify-2aadcb69/tgz-real.tgz
cp /tmp/verify-2aadcb69/pristine-fixture.hx "$F"
KEEP=1 bun /tmp/verify-2aadcb69/scripts/repro-verify.mjs "$TREE" stub 1 keep-stub > "$E/E-stub-keep.log" 2>&1
S=$(grep -o '"root":"[^"]*"' "$E/E-stub-keep.log" | head -1 | cut -d'"' -f4)
cp "$S/ts/generated-0.1.0.tgz" /tmp/verify-2aadcb69/tgz-stub.tgz
cp /tmp/verify-2aadcb69/pristine-fixture.hx "$F"
tar -tzf /tmp/verify-2aadcb69/tgz-real.tgz > "$E/entries-real-state.txt"
tar -tzf /tmp/verify-2aadcb69/tgz-stub.tgz > "$E/entries-stub-state.txt"
echo "real entries=$(wc -l < "$E/entries-real-state.txt") stub entries=$(wc -l < "$E/entries-stub-state.txt")"
echo "--- entry-list diff (real vs stub) ---"
diff "$E/entries-real-state.txt" "$E/entries-stub-state.txt" > "$E/entry-diff-real-vs-stub.txt"; echo "diff exit=$?"
cat "$E/entry-diff-real-vs-stub.txt"
sha256sum /tmp/verify-2aadcb69/tgz-real.tgz /tmp/verify-2aadcb69/tgz-stub.tgz
echo "[guard] count=$(grep -c 'Test.equals' "$F") $(sha256sum "$F")"
