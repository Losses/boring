#[test]
fn ascii_codecs_round_trip() {
    testlib::run("tests.VectorCodecTests.asciiCodecsRoundTrip", "tests.VectorCodecTests.asciiCodecsRoundTrip: ascii codecs round-trip through the Bytes APIs", || {
        let mut writer = BinaryWriter::new();
        writer.write_ascii(UString::from("BRG9").as_ustr());
        test_core::TestCore::test_core_equals_string(UStr::new(&[66,82,71,57]), BinaryReader::new(&writer.finish()).read_ascii(4).unwrap().as_ustr(), UStr::new(&[]));
        let mut wide = BinaryWriter::new();
        wide.write_ascii(UString::from("汉").as_ustr());
        test_core::TestCore::test_core_equals_string(UStr::new(&[27721]), BinaryReader::new(&wide.finish()).read_ascii(3).unwrap().as_ustr(), UStr::new(&[]));
    });
}
