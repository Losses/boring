#[test]
fn byte_lengths_per_width() {
    testlib::run("tests.VectorCodecTests.byteLengthsPerWidth", "tests.VectorCodecTests.byteLengthsPerWidth: block lengths follow the width marker", || {
        test_core::TestCore::test_core_equals_int(184i32, i32::from_ne_bytes(((VectorCodec::byte_length(4, FloatWidth::F64)) as i32).to_ne_bytes()), UStr::new(&[102,111,117,114,32,114,101,99,111,114,100,115,32,111,99,99,117,112,121,32,49,56,52,32,98,121,116,101,115,32,97,116,32,102,54,52]));
        test_core::TestCore::test_core_equals_int(104i32, i32::from_ne_bytes(((VectorCodec::byte_length(4, FloatWidth::F32)) as i32).to_ne_bytes()), UStr::new(&[102,111,117,114,32,114,101,99,111,114,100,115,32,111,99,99,117,112,121,32,49,48,52,32,98,121,116,101,115,32,97,116,32,102,51,50]));
        test_core::TestCore::test_core_equals_int(64i32, i32::from_ne_bytes(((VectorCodec::byte_length(4, FloatWidth::F16)) as i32).to_ne_bytes()), UStr::new(&[102,111,117,114,32,114,101,99,111,114,100,115,32,111,99,99,117,112,121,32,54,52,32,98,121,116,101,115,32,97,116,32,102,49,54]));
    });
}

#[test]
fn magic_width_mapping() {
    testlib::run("tests.VectorCodecTests.magicWidthMapping", "tests.VectorCodecTests.magicWidthMapping: magics map to widths, unknown magics answer null", || {
        test_core::TestCore::test_core_equals_string(UStr::new(&[66,82,71,49]), VectorCodec::magic_of(FloatWidth::F64).as_ustr(), UStr::new(&[70,54,52,32,116,114,97,118,101,108,115,32,117,110,100,101,114,32,66,82,71,49]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[66,82,71,50]), VectorCodec::magic_of(FloatWidth::F32).as_ustr(), UStr::new(&[70,51,50,32,116,114,97,118,101,108,115,32,117,110,100,101,114,32,66,82,71,50]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[66,82,71,51]), VectorCodec::magic_of(FloatWidth::F16).as_ustr(), UStr::new(&[70,49,54,32,116,114,97,118,101,108,115,32,117,110,100,101,114,32,66,82,71,51]));
        test_core::TestCore::test_core_ok(VectorCodec::width_of_magic(UStr::new(&[66,82,71,52])) == None, UStr::new(&[117,110,107,110,111,119,110,32,109,97,103,105,99,115,32,97,110,115,119,101,114,32,110,117,108,108]));
    });
}

