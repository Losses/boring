#[test]
fn roundtrip() {
    testlib::run("tests.VectorCodecTests.roundtrip", "tests.VectorCodecTests.roundtrip: encode then decode returns the input records", || {
        let records = TestData::test_data_glyph_samples();
        let decoded = VectorCodec::decode(&VectorCodec::encode(&records, FloatWidth::F64).unwrap()).unwrap();
        assert_equals_vec_glyph_metrics(&records, &decoded, UStr::new(&[100,101,99,111,100,101,40,101,110,99,111,100,101,40,114,101,99,111,114,100,115,41,41,32,109,117,115,116,32,101,113,117,97,108,32,116,104,101,32,105,110,112,117,116]));
    });
}

