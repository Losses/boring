#[test]
fn digest_is_idempotent() {
    testlib::run("tests.Xxh64Tests.digestIsIdempotent", "tests.Xxh64Tests.digestIsIdempotent: xxh64 digest remains usable", || {
        let mut h = Xxh64::new(2654435761i64 << 32 | 2246822535i64);
        h.update(&CryptoTestSupport::crypto_test_support_data(UStr::new(&[108,101,110,49])));
        let first = h.digest();
        test_core::TestCore::test_core_equals_string(CryptoTestSupport::crypto_test_support_i64_hex(first).as_ustr(), CryptoTestSupport::crypto_test_support_i64_hex(h.digest()).as_ustr(), UStr::new(&[]));
        h.update(&CryptoTestSupport::crypto_test_support_data(UStr::new(&[108,101,110,49,54])));
        test_core::TestCore::test_core_equals_string(UStr::new(&[48,51,53,53,56,97,51,53,48,99,100,101,52,102,99,56]), CryptoTestSupport::crypto_test_support_i64_hex(h.digest()).as_ustr(), UStr::new(&[]));
    });
}
