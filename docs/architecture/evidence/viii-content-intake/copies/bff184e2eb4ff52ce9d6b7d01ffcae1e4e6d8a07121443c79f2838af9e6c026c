#[test]
fn streaming_chunks() {
    testlib::run("tests.Xxh64Tests.streamingChunks", "tests.Xxh64Tests.streamingChunks: xxh64 streaming chunks", || {
        let data = CryptoTestSupport::crypto_test_support_data(UStr::new(&[108,101,110,50,52,48]));
        {
            {
                let step = 1u32;
                let mut h = Xxh64::new(2654435761i64 << 32 | 2246822535i64);
                let mut p = 0u32;
                while (i32::from_ne_bytes(((p) as i32).to_ne_bytes())) < (i32::from_ne_bytes(((u32::try_from((data.len()) & 0xFFFF_FFFF).unwrap_or(0)) as i32).to_ne_bytes())) {
                    let n = if i32::from_ne_bytes(((step) as i32).to_ne_bytes()) < (i32::from_ne_bytes(((u32::wrapping_sub(u32::try_from((data.len()) & 0xFFFF_FFFF).unwrap_or(0), p)) as i32).to_ne_bytes())) { step } else { u32::wrapping_sub(u32::try_from((data.len()) & 0xFFFF_FFFF).unwrap_or(0), p) };
                    h.update(&data[usize::try_from(p).unwrap_or(0)..usize::try_from(p + n).unwrap_or(0)].to_vec());
                    p = u32::wrapping_add(p, n);
                }
                test_core::TestCore::test_core_equals_string(CryptoTestSupport::crypto_test_support_i64_hex(Xxh64::xxh64_make(&data, 2654435761i64 << 32 | 2246822535i64)).as_ustr(), CryptoTestSupport::crypto_test_support_i64_hex(h.digest()).as_ustr(), UStr::new(&[]));
            }
            {
                let step = 3u32;
                let mut h = Xxh64::new(2654435761i64 << 32 | 2246822535i64);
                let mut p = 0u32;
                while (i32::from_ne_bytes(((p) as i32).to_ne_bytes())) < (i32::from_ne_bytes(((u32::try_from((data.len()) & 0xFFFF_FFFF).unwrap_or(0)) as i32).to_ne_bytes())) {
