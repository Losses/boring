use crate::runtime::u_string;
use crate::runtime::u_string::UStr;
use crate::runtime::u_string::UString;
use std::sync::Arc;


#[derive(Clone, Copy)]
pub struct ClosureStringViewOps;

impl ClosureStringViewOps {
    pub fn closure_string_view_ops_choose(items: &Vec<UString>, fallback: &UStr) -> UString {
        let pick: Arc<dyn Fn(&UStr) -> UString + Send + Sync + '_> = { let items = (items).to_vec(); Arc::new(move |value| {
        for i in 0..match u32::try_from(items.len()) { Ok(value) => value, Err(_) => u32::MAX } {
            if i32::from_ne_bytes(((u_string::unit_count(&((items[usize::try_from(i).unwrap_or(0)]).clone()))) as i32).to_ne_bytes()) > (0) {
                return (items[usize::try_from(i).unwrap_or(0)]).clone();
            }
        }
        return value.to_ustring();
}) };
        return pick(fallback);
    }

    pub(crate) fn closure_string_view_ops_wrap(value: &UStr) -> UString {
        return UString::from(format!("{}", { let mut __s = UString::new(); __s += &(UString::from("(")); __s += value; __s += &(UString::from(")")); __s }).as_str());
    }

    pub fn closure_string_view_ops_label(value: &UStr) -> UString {
        let apply: Arc<dyn Fn(&UStr) -> UString + Send + Sync + '_> = {  Arc::new(move |v| {
        return ClosureStringViewOps::closure_string_view_ops_wrap(v);
}) };
        return apply(value);
    }
}
