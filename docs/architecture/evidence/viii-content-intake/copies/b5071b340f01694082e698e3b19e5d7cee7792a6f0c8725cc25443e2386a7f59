use crate::runtime::fp_helper::FPHelper;


#[derive(Clone, Copy)]
pub struct FPHelperRustOps;

impl FPHelperRustOps {
    pub fn fp_helper_rust_ops_value_of(bits: u32) -> f32 {
        return FPHelper::i32_to_f32(i32::from_ne_bytes(((bits) as i32).to_ne_bytes()));
    }

    pub fn fp_helper_rust_ops_decompose(value: f32) -> FpHelperDecomposed {
        let bits = FPHelper::f32_to_i32(value);
        let raw_exponent = bits >> 23 & 255;
        let raw_mantissa = bits & 8388607;
        if u32::from_ne_bytes(((raw_exponent) as u32).to_ne_bytes()) == 0 {
            return FpHelperDecomposed { mant24: u32::from_ne_bytes(((raw_mantissa) as u32).to_ne_bytes()), exp2: 4294967147u32 };
        }
        return FpHelperDecomposed { mant24: u32::from_ne_bytes(((raw_mantissa) as u32).to_ne_bytes()) | 8388608, exp2: u32::from_ne_bytes(((i32::wrapping_sub(raw_exponent, 150)) as u32).to_ne_bytes()) };
    }
}

#[derive(Debug, Clone, Copy, PartialEq)]
pub struct FpHelperDecomposed {
    pub mant24: u32,
    pub exp2: u32,
}

pub fn compare_fp_helper_decomposed(a: &FpHelperDecomposed, b: &FpHelperDecomposed) -> i32 {
    let cmp_mant24 = match i32::from_ne_bytes((a.mant24).to_ne_bytes()).cmp(&i32::from_ne_bytes((b.mant24).to_ne_bytes())) { core::cmp::Ordering::Less => -1, core::cmp::Ordering::Equal => 0, core::cmp::Ordering::Greater => 1 };
    if cmp_mant24 != 0 { return cmp_mant24; }
    let cmp_exp2 = match i32::from_ne_bytes((a.exp2).to_ne_bytes()).cmp(&i32::from_ne_bytes((b.exp2).to_ne_bytes())) { core::cmp::Ordering::Less => -1, core::cmp::Ordering::Equal => 0, core::cmp::Ordering::Greater => 1 };
    if cmp_exp2 != 0 { return cmp_exp2; }
    0
}
