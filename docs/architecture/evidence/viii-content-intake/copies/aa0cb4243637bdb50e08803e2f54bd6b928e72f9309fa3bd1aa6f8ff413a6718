package lam;

import std.ReadOnlyArray;

class Lam {
    static function source(flag:Bool):ReadOnlyArray<Int> {
        var a:Array<Int> = [1, 2, 3];
        var b:Array<Int> = [4, 5];
        return flag ? a : b;
    }

    public static function use(f:Void->ReadOnlyArray<Int>):Int {
        return f().length;
    }

    public static function pick(flag:Bool):Int {
        // multi-statement lambda whose body returns a switch (P08 lambda-contract site)
        return use(function() {
            var tag = flag ? 1 : 0;
            var chosen = switch (tag) {
                case 1: source(true);
                case _: source(false);
            };
            return chosen;
        });
    }

    public static function bindToNullable(flag:Bool):Null<ReadOnlyArray<Int>> {
        var v = switch (flag) {
            case true: source(true);
            case false: source(false);
        };
        return v;
    }

}
