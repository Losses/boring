package mx;

import std.ReadOnlyArray;

enum MXChoice {
	One;
	Two;
}

enum MXKind {
	EOnly(tag:String);
}

class MXError extends haxe.Exception {
	public final kind:MXKind;

	public function new() {
		this.kind = EOnly("e");
		super("mx");
	}
}

class MXSource {
	public static function first():Array<Int>
		return [1, 2];

	public static function second():Array<Int>
		return [3];

	public static function texts():Array<String>
		return ["a", "b"];

	public static function view(values:ReadOnlyArray<Int>):Int
		return values.length;
}

class MXLambda {
	// (A) enclosing member returns Int; lambda returns ReadOnlyArray<Int>.
	//     try-return route -> tryReturnLines uses currentReturnType.
	public static function aTryReturn(flag:Bool):Int {
		var f = function(flag:Bool):ReadOnlyArray<Int> {
			if (flag) throw new MXError();
			return try {
				MXSource.first();
			} catch (e:MXError) {
				MXSource.second();
			}
		}
		return MXSource.view(f(flag));
	}

	// (B) enclosing member returns Int; lambda returns ReadOnlyArray<Int>.
	//     return-position switch -> stmtLines :810 -> armLines fallback :5675.
	public static function bSwitchReturn(c:MXChoice):Int {
		var f = function(c:MXChoice):ReadOnlyArray<Int> {
			return switch (c) {
				case One: MXSource.first();
				case Two: MXSource.second();
			}
		}
		return MXSource.view(f(c));
	}

	// (C) enclosing member returns ReadOnlyArray<String>; lambda returns
	//     ReadOnlyArray<Int>. The empty arm's element type is taken from the
	//     destination: if that is the member's ReadOnlyArray<String>, the
	//     emitted literal carries the wrong element type.
	public static function cWrongElement(c:MXChoice):ReadOnlyArray<String> {
		var f = function(c:MXChoice):ReadOnlyArray<Int> {
			return switch (c) {
				case One: [];
				case Two: MXSource.first();
			}
		}
		f(c);
		return MXSource.texts();
	}

	// (D) same mismatch on the try-return route with an empty body value.
	public static function dWrongElementTry(flag:Bool):ReadOnlyArray<String> {
		var f = function(flag:Bool):ReadOnlyArray<Int> {
			if (flag) throw new MXError();
			return try {
				[];
			} catch (e:MXError) {
				MXSource.second();
			}
		}
		f(flag);
		return MXSource.texts();
	}

	// (E) control: the binding route is handed the binding's declared type v.t.
	public static function eTryBinding(flag:Bool):Int {
		var f = function(flag:Bool):Int {
			if (flag) throw new MXError();
			var view:ReadOnlyArray<Int> = try {
				MXSource.first();
			} catch (e:MXError) {
				MXSource.second();
			}
			return MXSource.view(view);
		}
		return f(flag);
	}

	// (F) control: the enclosing member returns a read-only array of the SAME
	//     element type as the lambda, so borrowing it is not observable here.
	public static function fMatching(flag:Bool):ReadOnlyArray<Int> {
		var f = function(flag:Bool):ReadOnlyArray<Int> {
			if (flag) throw new MXError();
			return try {
				MXSource.first();
			} catch (e:MXError) {
				MXSource.second();
			}
		}
		return f(flag);
	}

	// (G) multi-statement lambda body, so `return switch` is lowered by
	//     stmtLines :810 -> switchReturn(destination=currentReturnType) and the
	//     armLines fallback :5675 decides the conversion.
	public static function gSwitchReturnMulti(c:MXChoice):Int {
		var f = function(c:MXChoice):ReadOnlyArray<Int> {
			var marker:Int = MXSource.view(MXSource.first());
			if (marker < 0) {
				MXSource.second();
			}
			return switch (c) {
				case One: MXSource.first();
				case Two: MXSource.second();
			}
		}
		return MXSource.view(f(c));
	}

	// (H) multi-statement body, member returns ReadOnlyArray<String>, lambda
	//     returns ReadOnlyArray<Int>, last arm is an empty literal: the
	//     destination element comes from the member.
	public static function hWrongElementMulti(c:MXChoice):ReadOnlyArray<String> {
		var f = function(c:MXChoice):ReadOnlyArray<Int> {
			var marker:Int = MXSource.view(MXSource.first());
			if (marker < 0) {
				MXSource.second();
			}
			return switch (c) {
				case One: [];
				case Two: MXSource.first();
			}
		}
		f(c);
		return MXSource.texts();
	}

	// (I) handler arm of tryReturnLines (:5310), member returns
	//     ReadOnlyArray<String>, lambda returns ReadOnlyArray<Int>, empty arm.
	public static function iWrongElementHandler(flag:Bool):ReadOnlyArray<String> {
		var f = function(flag:Bool):ReadOnlyArray<Int> {
			if (flag) throw new MXError();
			return try {
				MXSource.first();
			} catch (e:MXError) {
				[];
			}
		}
		f(flag);
		return MXSource.texts();
	}

	// (J) statement-position switch inside a lambda: switchStatement :5521
	//     passes no destination, so armLines :5675 falls back to
	//     currentReturnType (destination == null).
	public static function jSwitchStatement(c:MXChoice):Int {
		var f = function(c:MXChoice):ReadOnlyArray<Int> {
			switch (c) {
				case One:
					return MXSource.first();
				case Two:
					return MXSource.second();
			}
		}
		return MXSource.view(f(c));
	}

	// (K) named LOCAL FUNCTION inside a member: functionLiteralNamed :2376 ->
	//     functionLiteral :2338; currentReturnType is still the member's.
	public static function kNamedLocal(flag:Bool):Int {
		function view():ReadOnlyArray<Int> {
			if (flag) throw new MXError();
			return try {
				MXSource.first();
			} catch (e:MXError) {
				MXSource.second();
			}
		}
		return MXSource.view(view());
	}
}
