#[test]
fn test_payload_roundtrip() {
    testlib::run("tests.DataTableTests.testPayloadRoundtrip", "tests.DataTableTests.testPayloadRoundtrip: payload table decodes back to the file content", || {
        let expected = { let mut __s = UString::new(); __s += &(UString::from("synthetic payload for boring spec 20 raw payload tables")); __s += &(UString::from(concat!("\n",
""))); __s += &(UString::from("second line with \"quotes\" and \\ backslash")); __s += &(UString::from(concat!("\n",
""))); __s += &(UString::from("third line plain digits 0123456789")); __s += &(UString::from(concat!("\n",
""))); __s += &(UString::from("final line with latin small letter e with acute café")); __s += &(UString::from(concat!("\n",
""))); __s };
        test_core::TestCore::test_core_equals_string(expected.as_ustr(), PayloadTextTable::payload_text_table_text().unwrap().as_ustr(), UStr::new(&[100,101,99,111,100,101,100,32,112,97,121,108,111,97,100,32,101,113,117,97,108,115,32,102,105,108,101,32,99,111,110,116,101,110,116]));
    });
}
