    testlib::run("tests.DataTableTests.testWordMisses", "tests.DataTableTests.testWordMisses: word character table misses and gaps", || {
        test_core::TestCore::test_core_equals_bool(false, WordCharacterTable::word_character_table_contains(0), UStr::new(&[110,117,108,108,32,98,121,116,101,32,109,105,115,115]));
        test_core::TestCore::test_core_equals_bool(false, WordCharacterTable::word_character_table_contains(47), UStr::new(&[99,104,97,114,32,98,101,102,111,114,101,32,100,105,103,105,116,115,32,109,105,115,115]));
        test_core::TestCore::test_core_equals_bool(false, WordCharacterTable::word_character_table_contains(58), UStr::new(&[99,104,97,114,32,97,102,116,101,114,32,100,105,103,105,116,115,32,109,105,115,115]));
        test_core::TestCore::test_core_equals_bool(false, WordCharacterTable::word_character_table_contains(64), UStr::new(&[99,104,97,114,32,98,101,102,111,114,101,32,117,112,112,101,114,99,97,115,101,32,109,105,115,115]));
        test_core::TestCore::test_core_equals_bool(false, WordCharacterTable::word_character_table_contains(96), UStr::new(&[99,104,97,114,32,98,101,102,111,114,101,32,108,111,119,101,114,99,97,115,101,32,109,105,115,115]));
        test_core::TestCore::test_core_equals_bool(false, WordCharacterTable::word_character_table_contains(131104), UStr::new(&[99,104,97,114,32,97,98,111,118,101,32,108,97,115,116,32,114,101,99,111,114,100,32,109,105,115,115]));
    });
}

