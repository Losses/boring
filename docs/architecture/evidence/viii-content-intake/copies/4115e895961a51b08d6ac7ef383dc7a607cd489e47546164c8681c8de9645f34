#[test]
fn test_script_first_record() {
    testlib::run("tests.DataTableTests.testScriptFirstRecord", "tests.DataTableTests.testScriptFirstRecord: script table first record hits", || {
        test_core::TestCore::test_core_equals_int(1i32, i32::from_ne_bytes(((ScriptEvidenceTable::script_evidence_table_classify(32)) as i32).to_ne_bytes()), UStr::new(&[102,105,114,115,116,32,114,101,99,111,114,100,32,115,116,97,114,116,32,104,105,116]));
        test_core::TestCore::test_core_equals_int(1i32, i32::from_ne_bytes(((ScriptEvidenceTable::script_evidence_table_classify(80)) as i32).to_ne_bytes()), UStr::new(&[102,105,114,115,116,32,114,101,99,111,114,100,32,105,110,116,101,114,105,111,114,32,104,105,116]));
        test_core::TestCore::test_core_equals_int(1i32, i32::from_ne_bytes(((ScriptEvidenceTable::script_evidence_table_classify(126)) as i32).to_ne_bytes()), UStr::new(&[102,105,114,115,116,32,114,101,99,111,114,100,32,101,110,100,32,104,105,116]));
    });
}

