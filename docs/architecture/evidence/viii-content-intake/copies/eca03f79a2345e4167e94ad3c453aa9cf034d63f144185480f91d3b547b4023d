#[test]
fn first_entry() {
    testlib::run("tests.BorrowedLoopItemBoundaryTests.firstEntry", "tests.BorrowedLoopItemBoundaryTests.firstEntry: a borrowed loop item fills an owned Option return slot", || {
        let entries = vec![
    (BorrowedLoopItemEntry::Entry { label: UString::from("a") }).clone(),
    (BorrowedLoopItemEntry::Entry { label: UString::from("b") }).clone(),
];
        let first = BorrowedLoopItemBoundaryOps::borrowed_loop_item_boundary_ops_first_entry(&entries);
        test_core::TestCore::test_core_equals_bool(true, first != None, UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[97]), match &(first) { None => UString::from(""), Some(__option1) => BorrowedLoopItemBoundaryOps::borrowed_loop_item_boundary_ops_describe((*__option1).clone()).to_ustring() }.as_ustr(), UStr::new(&[]));
    });
}

#[test]
fn wrapped_entries() {
    testlib::run("tests.BorrowedLoopItemBoundaryTests.wrappedEntries", "tests.BorrowedLoopItemBoundaryTests.wrappedEntries: a borrowed loop item fills an owned constructor slot", || {
        let entries = vec![
    (BorrowedLoopItemEntry::Entry { label: UString::from("a") }).clone(),
    (BorrowedLoopItemEntry::Entry { label: UString::from("b") }).clone(),
];
        let holders = BorrowedLoopItemBoundaryOps::borrowed_loop_item_boundary_ops_wrapped_entries(&entries);
        test_core::TestCore::test_core_equals_int(2i32, i32::from_ne_bytes(((u32::try_from((holders.len()) & 0xFFFF_FFFF).unwrap_or(0)) as i32).to_ne_bytes()), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[97]), BorrowedLoopItemBoundaryOps::borrowed_loop_item_boundary_ops_describe(((holders[0usize]).clone().entry).clone()).as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[98]), BorrowedLoopItemBoundaryOps::borrowed_loop_item_boundary_ops_describe(((holders[1usize]).clone().entry).clone()).as_ustr(), UStr::new(&[]));
    });
}

