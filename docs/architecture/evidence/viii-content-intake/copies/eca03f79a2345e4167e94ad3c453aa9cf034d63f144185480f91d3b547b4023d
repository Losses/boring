#[test]
fn has_marker() {
    testlib::run("tests.BorrowedLoopItemBoundaryTests.hasMarker", "tests.BorrowedLoopItemBoundaryTests.hasMarker: a borrowed enum loop item compares against an owned value", || {
        let markers = vec![BorrowedLoopMarker::MarkerAlpha, BorrowedLoopMarker::MarkerBeta];
        test_core::TestCore::test_core_equals_bool(true, BorrowedLoopItemBoundaryOps::borrowed_loop_item_boundary_ops_has_marker(&markers, BorrowedLoopMarker::MarkerBeta), UStr::new(&[]));
        test_core::TestCore::test_core_equals_bool(false, BorrowedLoopItemBoundaryOps::borrowed_loop_item_boundary_ops_has_marker(&vec![BorrowedLoopMarker::MarkerAlpha], BorrowedLoopMarker::MarkerBeta), UStr::new(&[]));
    });
}

#[test]
fn index_of_nullable() {
    testlib::run("tests.BorrowedLoopItemBoundaryTests.indexOfNullable", "tests.BorrowedLoopItemBoundaryTests.indexOfNullable: a nullable array indexOf unwraps the receiver", || {
        test_core::TestCore::test_core_equals_int(1i32, i32::from_ne_bytes(((BorrowedLoopItemBoundaryOps::borrowed_loop_item_boundary_ops_index_of_nullable_ints(Some(vec![5, 7, 9]), 7)) as i32).to_ne_bytes()), UStr::new(&[]));
        test_core::TestCore::test_core_equals_int(-1i32, i32::from_ne_bytes(((BorrowedLoopItemBoundaryOps::borrowed_loop_item_boundary_ops_index_of_nullable_ints(Some(vec![5, 7, 9]), 3)) as i32).to_ne_bytes()), UStr::new(&[]));
        test_core::TestCore::test_core_equals_int(-1i32, i32::from_ne_bytes(((BorrowedLoopItemBoundaryOps::borrowed_loop_item_boundary_ops_index_of_nullable_ints(None, 3)) as i32).to_ne_bytes()), UStr::new(&[]));
        test_core::TestCore::test_core_equals_int(1i32, i32::from_ne_bytes(((BorrowedLoopItemBoundaryOps::borrowed_loop_item_boundary_ops_index_of_nullable_strings(Some(vec![UString::from("a").to_ustring(), UString::from("b").to_ustring()]), UStr::new(&[98]))) as i32).to_ne_bytes()), UStr::new(&[]));
    });
}
