#if macro
import haxe.macro.Context;
import haxe.macro.Expr.Field;
import haxe.macro.Type;
import SourceComparisonAnalysis;

/**
	Independent cross-check probe for Builder.sameTypeParameter.

	Question 1 (serial-key safety): does `parameterIdentity` really embed the
	owning DECLARATION, or only the module path? Two owners in one module with
	the same parameter short name are constructed here and their keys compared.

	Question 2 (over-merge): two records of the same nested declaration driven
	by two DIFFERENT parameter binders must stay two distinct nested nodes.

	Question 3 (under-merge): the same binder at deeper nesting must collapse.

	Observation only: reads public SourceComparisonAnalysis entry points and
	prints one line per case. No compiler decision is changed.
**/
class XCheck {
	static var once = false;

	macro public static function run():Array<Field> {
		final fields = Context.getBuildFields();
		final localRef = Context.getLocalClass();
		if (localRef == null)
			return fields;
		final local = localRef.get();
		if (local.name != "Trigger" || local.pack.length != 1 || local.pack[0] != "xct")
			return fields;
		if (once)
			return fields;
		once = true;

		identities();
		collisionMatrix();
		slotNegatives();
		overMerge();
		underMerge();
		recursiveGraph();
		methodSeen = true;
		return fields;
	}

	// ------------------------------------------------------------------
	// A. What does the key actually contain?
	// ------------------------------------------------------------------

	static function identities():Void {
		final a = cls("xc.CrossOwner", "OwnerA");
		final b = cls("xc.CrossOwner", "OwnerB");
		final c = cls("xc.CrossOwner", "OwnerC");
		final s = cls("xc.Solo", "Solo");
		final boxed = cls("revp9.Boxed", "Boxed");
		final generic = cls("revp9.Generic", "Generic");
		final pair = cls("revp9.Pair", "Pair");
		dump("OwnerA.T", a.params[0].t);
		dump("OwnerB.T", b.params[0].t);
		dump("OwnerC.U", c.params[0].t);
		dump("Solo.T", s.params[0].t);
		dump("Boxed.T", boxed.params[0].t);
		dump("Generic.T", generic.params[0].t);
		dump("Pair.S", pair.params[0].t);
	}

	static function realDump(label:String, t:Type):Void {
		switch (t) {
			case TInst(reference, _):
				final cls = reference.get();
				Sys.println('ID $label pack=[${cls.pack.join(".")}] module=${cls.module} name=${cls.name} key=${SourceComparisonAnalysis.parameterIdentity(t)}');
			case _:
				Sys.println('ID $label NOT-TInst');
		}
	}

	// ------------------------------------------------------------------
	// B. Serial-key collisions across distinct owners.
	// ------------------------------------------------------------------

	static function collisionMatrix():Void {
		final cases:Array<{label:String, t:Type}> = [
			{label: "OwnerA.T", t: cls("xc.CrossOwner", "OwnerA").params[0].t},
			{label: "OwnerB.T", t: cls("xc.CrossOwner", "OwnerB").params[0].t},
			{label: "OwnerC.U", t: cls("xc.CrossOwner", "OwnerC").params[0].t},
			{label: "Solo.T", t: cls("xc.Solo", "Solo").params[0].t},
			{label: "Boxed.T", t: cls("revp9.Boxed", "Boxed").params[0].t},
			{label: "Generic.T", t: cls("revp9.Generic", "Generic").params[0].t},
			{label: "Pair.S", t: cls("revp9.Pair", "Pair").params[0].t},
		];
		var collisions = 0;
		for (i in 0...cases.length)
			for (j in (i + 1)...cases.length) {
				final li = SourceComparisonAnalysis.parameterIdentity(cases[i].t);
				final lj = SourceComparisonAnalysis.parameterIdentity(cases[j].t);
				final same = li != null && li == lj;
				if (same)
					collisions++;
				Sys.println('COLLIDE ${cases[i].label} vs ${cases[j].label} sameKey:$same');
			}
		Sys.println('COLLIDE total:$collisions (expected 0: every pair is a distinct declaration)');
	}

	// ------------------------------------------------------------------
	// C. Pre-existing consumers of the same key: cross-owner slot lookup.
	// ------------------------------------------------------------------

	static function slotNegatives():Void {
		final a = cls("xc.CrossOwner", "OwnerA");
		final b = cls("xc.CrossOwner", "OwnerB");
		final slot = SourceComparisonAnalysis.ownParameterSlot(b.params[0].t, RecordDeclaration(refOf("xc.CrossOwner", "OwnerA")));
		Sys.println('SLOT ownParameterSlot(OwnerB.T, owner=OwnerA) = ${slot} (expected null)');
		final index = SourceComparisonAnalysis.schemaParameterIndex(b.params[0].t, [a.params[0].t]);
		Sys.println('SLOT schemaParameterIndex(OwnerB.T, [OwnerA.T]) = ${index} (expected null)');
		final positive = SourceComparisonAnalysis.ownParameterSlot(a.params[0].t, RecordDeclaration(refOf("xc.CrossOwner", "OwnerA")));
		Sys.println('SLOT ownParameterSlot(OwnerA.T, owner=OwnerA) = ${positive} (expected 0)');
	}

	// ------------------------------------------------------------------
	// D. Over-merge: distinct binders in the same nested declaration.
	// ------------------------------------------------------------------

	static function overMerge():Void {
		final dual = cls("xc.Shapes", "Dual");
		final a = cls("xc.CrossOwner", "OwnerA").params[0].t;
		final b = cls("xc.CrossOwner", "OwnerB").params[0].t;
		final node = SourceComparisonAnalysis.analyzeRecord(refOf("xc.Shapes", "Dual"), [a, b]);
		final va = nested(node, "va");
		final vb = nested(node, "vb");
		Sys.println('OVER distinct-binders shared:${va != null && va == vb} (expected false) va:${va != null} vb:${vb != null}');
		final node2 = SourceComparisonAnalysis.analyzeRecord(refOf("xc.Shapes", "Dual"), [Context.getType("Int"), Context.getType("String")]);
		final ca = nested(node2, "va");
		final cb = nested(node2, "vb");
		Sys.println('OVER concrete Int/String shared:${ca != null && ca == cb} (expected false)');
		final mix = SourceComparisonAnalysis.analyzeRecord(refOf("xc.Shapes", "Mix"), [a, b]);
		final mx = nested(mix, "x");
		final my = nested(mix, "y");
		Sys.println('OVER Mix<OwnerA.T,OwnerB.T> shared:${mx != null && mx == my} (expected false)');
	}

	// ------------------------------------------------------------------
	// E. Under-merge: one binder repeated across nesting depths.
	// ------------------------------------------------------------------

	static function underMerge():Void {
		final t = cls("xc.CrossOwner", "OwnerA").params[0].t;
		final same = SourceComparisonAnalysis.analyzeRecord(refOf("xc.Shapes", "Same"), [t]);
		final sx = nested(same, "x");
		final sy = nested(same, "y");
		Sys.println('UNDER Same<OwnerA.T> shared:${sx != null && sx == sy} (expected true)');

		final diamond = SourceComparisonAnalysis.analyzeRecord(refOf("xc.Shapes", "Diamond"), [t]);
		final da = nested(diamond, "a");
		final db = nested(diamond, "b");
		final dc = nestedThrough(diamond, "c");
		Sys.println('UNDER Diamond<OwnerA.T> a==b:${da != null && da == db} (expected true)');
		Sys.println('UNDER Diamond<OwnerA.T> a==c-depth2:${da != null && da == dc} (expected true)');
		var allComplete = true;
		for (f in diamond.fields)
			switch (f.shape) {
				case RecordShape(n):
					if (!isComplete(n.state)) allComplete = false;
				case _:
			}
		Sys.println('UNDER Diamond nested allComplete:$allComplete (expected true)');
	}


	// ------------------------------------------------------------------
	// F. Self-recursive generic record: does the graph close?
	// ------------------------------------------------------------------

	static function recursiveGraph():Void {
		final t = cls("xc.CrossOwner", "OwnerA").params[0].t;
		final budget = 8;
		final root = SourceComparisonAnalysis.analyzeRecord(refOf("xc.Shapes", "Rec"), [t], budget);
		final chain:Array<SourceRecordNode> = [];
		var current:Null<SourceRecordNode> = root;
		var links = 0;
		var repeated = false;
		while (current != null && links < 40) {
			if (chain.indexOf(current) >= 0) {
				repeated = true;
				break;
			}
			chain.push(current);
			links++;
			current = nested(current, "next");
		}
		Sys.println('REC budget=$budget distinctNextChainNodes:${chain.length} closedOnRepeat:$repeated reachedCap:${links >= 40} (expected 1 distinct + closed)');
		var complete = 0;
		for (n in chain)
			if (isComplete(n.state))
				complete++;
		Sys.println('REC chain completeStates:$complete of ${chain.length} (expected all)');
		final unlimited = SourceComparisonAnalysis.analyzeRecord(refOf("xc.Shapes", "Rec"), [t], 3);
		final d1 = nested(unlimited, "next");
		Sys.println('REC budget3 nested state:${d1 == null ? "none" : Std.string(d1.state)}');
		final concrete = SourceComparisonAnalysis.analyzeRecord(refOf("xc.Shapes", "Rec"), [Context.getType("Int")], 3);
		final c1 = nested(concrete, "next");
		Sys.println('REC concrete-Int budget3 nested state:${c1 == null ? "none" : Std.string(c1.state)} (concrete control)');

		// Production callers pass no node budget. Opt in only when asked:
		// without the fix this recursion has no closing condition.
		if (Sys.getEnv("XCHECK_UNBOUNDED") == "1") {
			Sys.println('UNBOUNDED start budget=null');
			final unbounded = SourceComparisonAnalysis.analyzeRecord(refOf("xc.Shapes", "Rec"), [t]);
			Sys.println('UNBOUNDED returned state:${Std.string(unbounded.state)}');
		}
	}


	// ------------------------------------------------------------------
	// G. Same class, two distinct method-level binders with one name.
	// Observed after typing, when method signatures exist.
	// ------------------------------------------------------------------

	/** Called with every module fully typed. */
	public static function afterTyping(types:Array<haxe.macro.ModuleType>):Void {
		if (!methodSeen) return;
		for (type in Context.getModule("xc.MethodParams"))
			collectMethodBinders(type);
		final hfSameName = lastKey("Host2.f<");
		final gf = lastKey(".g<");
		final hf = lastKey(".h<");
		final ff = lastKey("Host.f<");
		Sys.println('METH observable:${gf != null && hf != null && ff != null} Host.f=${ff} Host2.g=${gf} Host2.h=${hf}');
		Sys.println('METH two method binders named T in one class collide:${gf != null && gf == hf} (expected false)');
		Sys.println('METH same method name+module, different class (Host.f vs Host2.f):${ff} vs ${hfSameName} collide:${ff != null && ff == hfSameName}');
	}

	static function collectMethodBinders(type:Type):Void {
		switch (type) {
			case TInst(reference, _):
				final cls = reference.get();
				if (cls.module != "xc.MethodParams") return;
				for (field in cls.fields.get())
					switch (field.type) {
						case TFun(args, _) if (args.length > 0): dump('${cls.name}.${field.name}<T> arg', args[0].t);
						case _:
					}
				if (cls.params.length > 0) dump('${cls.name} class binder', cls.params[0].t);
			case _:
		}
	}

	static var methodSeen = false;


	static function methodParams():Void {
		Sys.println('METH observed fields Host=${cls("xc.MethodParams", "Host").fields.get().length} Host2=${cls("xc.MethodParams", "Host2").fields.get().length}');
		for (field in cls("xc.MethodParams", "Host").fields.get())
			if (field.name == "f")
				switch (field.type) {
					case TFun(args, _): dump("Host.f<T> arg", args[0].t);
					case _:
				}
		for (field in cls("xc.MethodParams", "Host2").fields.get())
			if (field.name == "g" || field.name == "h")
				switch (field.type) {
					case TFun(args, _): dump('Host2.${field.name}<T> arg', args[0].t);
					case _:
				}
		final gf = lastKey("Host2.g");
		final hf = lastKey("Host2.h");
		final observable = gf != null && hf != null;
		Sys.println('METH two method binders named T in one class collide:${observable && gf == hf} observable:$observable keys:$gf / $hf (expected observable:true, collide:false)');
	}

	static final seenKeys:Map<String, String> = [];

	static function dump(label:String, t:Type):Void {
		final k = SourceComparisonAnalysis.parameterIdentity(t);
		seenKeys.set(label, k == null ? "<null>" : k);
		realDump(label, t);
	}

	static function lastKey(fragment:String):Null<String> {
		for (label => key in seenKeys)
			if (label.indexOf(fragment) >= 0)
				return key;
		return null;
	}

	// ------------------------------------------------------------------

	/** Resolve one class inside an explicit module: secondary module-level
	    classes are not reachable through Context.getType by their short path. */
	static function refOf(modulePath:String, name:String):Ref<ClassType> {
		for (type in Context.getModule(modulePath))
			switch (type) {
				case TInst(reference, _):
					if (reference.get().name == name)
						return reference;
				case _:
			}
		throw "no class " + modulePath + "." + name;
	}

	static function cls(modulePath:String, name:String):ClassType {
		return refOf(modulePath, name).get();
	}

	static function isComplete(state:SourceRecordState):Bool {
		return switch (state) {
			case Complete: true;
			case _: false;
		}
	}

	static function nested(node:SourceRecordNode, fieldName:String):Null<SourceRecordNode> {
		for (f in node.fields)
			if (f.field.name == fieldName)
				return unwrap(f.shape);
		return null;
	}

	/** Reaches the Mid node inside a field shaped Vec<Mid<T>> (Vec stores `x`). */
	static function nestedThrough(node:SourceRecordNode, fieldName:String):Null<SourceRecordNode> {
		for (f in node.fields)
			if (f.field.name == fieldName)
				switch (unwrap(f.shape)) {
					case null: return null;
					case outer: return nested(outer, "x");
				}
		return null;
	}

	static function unwrap(shape:SourceComparisonShape):Null<SourceRecordNode> {
		return switch (shape) {
			case NullableShape(inner): unwrap(inner);
			case RecordShape(n): n;
			case RecordUseShape(n, _): n;
			case _: null;
		}
	}
}
#end
