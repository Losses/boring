package boring

object NullableCallOps2 {
    fun nullableToStringResult(value: NullableReceiver?): String? {
        val v = value
        return v?.toString()
    }

    fun normalizedToStringResult(value: NullableReceiver?): String {
        val v = value ?: NullableReceiver()
        return v.toString()
    }

    fun guardedToStringResult(value: NullableReceiver?): String {
        if ((value == null)) {
            return "missing receiver"
        }
        return value.toString()
    }
}
