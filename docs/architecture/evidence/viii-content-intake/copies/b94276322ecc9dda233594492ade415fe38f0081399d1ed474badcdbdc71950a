use crate::runtime::u_string;
use crate::runtime::u_string::UStr;
use crate::runtime::u_string::UString;


#[derive(Clone, Copy)]
pub struct SignedIntAssignOps;

impl SignedIntAssignOps {
    pub fn signed_int_assign_ops_advance(text: &UStr) -> u32 {
        let found = u_string::find_from(&(text), UString::from("x").as_ustr(), 0);
        let start = u32::from_ne_bytes(((i32::wrapping_add(found, 1)) as u32).to_ne_bytes());
        return start;
    }
}
