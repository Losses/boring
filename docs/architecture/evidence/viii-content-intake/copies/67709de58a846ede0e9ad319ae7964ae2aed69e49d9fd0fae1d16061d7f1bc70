#[test]
fn test_local_step() {
    testlib::run("tests.LocalThrowTests.testLocalStep", "tests.LocalThrowTests.testLocalStep: a local throwing function call carries the try marker", || {
        test_core::TestCore::test_core_equals_bool(true, true, UStr::new(&[]));
    });
}

