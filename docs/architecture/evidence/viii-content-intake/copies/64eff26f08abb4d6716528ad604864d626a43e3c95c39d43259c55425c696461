package boring

object NumericWidenOps {
    private fun intExpr(): Int {
        return 2
    }

    fun operandFloat(): Double {
        return 1.5 + (NumericWidenOps.intExpr()).toDouble()
    }

    fun operandDouble(): Double {
        return (NumericWidenOps.intExpr()).toDouble() + 1.5
    }

    fun returnFloat(): Double {
        return (NumericWidenOps.intExpr()).toDouble()
    }

    fun returnDouble(): Double {
        return (NumericWidenOps.intExpr()).toDouble()
    }

    fun assignFloat(): Double {
        var value = 0.5
        value = (NumericWidenOps.intExpr()).toDouble()
        return value
    }

    fun assignDouble(): Double {
        var value = 0.5
        value = (NumericWidenOps.intExpr()).toDouble()
        return value
    }

    fun appliedFloat(): Double {
        var value = 0.5
        value += (NumericWidenOps.intExpr()).toDouble()
        return value
    }

    fun appliedDouble(): Double {
        var value = 0.5
        value *= (NumericWidenOps.intExpr()).toDouble()
        return value
    }

    fun conditionalMerge(useFloat: Boolean): Double {
        return (if ((useFloat)) 1.5 else 2.0)
    }

    fun nullableConditional(value: Double?): Double {
        return (if ((value != null)) value else (0).toDouble())
    }

    fun switchMerge(value: SwitchMergeValue): Double {
        return when (value) {
            is SwitchMergeValue.First -> 1.5
            is SwitchMergeValue.Second -> 2.0
            is SwitchMergeValue.Third -> 0.5
        }
    }
}
