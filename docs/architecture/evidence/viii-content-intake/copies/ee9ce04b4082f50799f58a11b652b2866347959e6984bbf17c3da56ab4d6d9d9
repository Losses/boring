package tests

import java.nio.file.Files
import java.nio.file.Paths

object PlatformModulesTestSupport {
    const val DIR: String = "out/platform-modules"

    fun textPath(name: String): String {
        return PlatformModulesTestSupport.DIR + "/" + name + ".txt"
    }

    fun ensureDir() {
        Files.createDirectories(Paths.get(PlatformModulesTestSupport.DIR))
    }

    fun hasEntry(dir: String, name: String): Boolean {
        val names = Files.newDirectoryStream(Paths.get(dir)).use { s -> s.map { it.fileName.toString() }.toMutableList() }
        for (i in 0 until names.size) {
            if ((names[i] == name)) {
                return true
            }
        }
        return false
    }

    fun noDotEntries(dir: String): Boolean {
        val names = Files.newDirectoryStream(Paths.get(dir)).use { s -> s.map { it.fileName.toString() }.toMutableList() }
        for (i in 0 until names.size) {
            if ((names[i] == "." || names[i] == "..")) {
                return false
            }
        }
        return true
    }
}
