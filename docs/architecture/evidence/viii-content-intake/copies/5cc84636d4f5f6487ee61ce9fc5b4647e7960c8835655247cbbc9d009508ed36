#!/usr/bin/env bash
# boundaries.sh -- reproduces the four KNOWN BOUNDARIES of the seal.
# Read-only with respect to the real attempt tree: all mutation happens in
# `cp -a` copies under $W/copy. Run:  bash boundaries.sh
set -u
W=${W:-/home/losses/Development/tq-workspace/out/integrity-bytefix-work}
SRC=${SRC:-/home/losses/Development/tq-workspace/boring-wt-architecture/out/integration-a3-evidence/exclusive-runner}
CHK=${CHK:-$SRC/check-log-integrity.sh}
C="$W/copy"
A="$C/att-clean"

run() { local d="$1"; local o; o=$(bash "$CHK" "$d" 2>&1); printf 'rc=%s :: %s\n' "$?" "$(printf '%s' "$o" | head -1)"; }

echo "### BOUNDARY 1 -- no key: a tamperer can re-seal and still get exit 0"
rm -rf "$C/resealed"; cp -a "$A" "$C/resealed"
R="$C/resealed"; LOG="$R/harness.log"; ST="$R/stages"
python3 - "$ST/step-2320672395.stdout" <<'PY'
import sys
p = sys.argv[1]; b = bytearray(open(p, 'rb').read()); b[len(b)//2] ^= 1
open(p, 'wb').write(bytes(b))
PY
printf '  after tampering one sealed .stdout byte: '; run "$R"
first=$(grep -n '^stage-evidence ' "$LOG" | head -1 | cut -d: -f1)
[ -n "$first" ] || first=$(grep -n '^harness end marker sha256=' "$LOG" | head -1 | cut -d: -f1)
head -n $((first - 1)) "$LOG" > "$LOG.new"
sha256sum "$ST"/* | sed "s#  $ST/#  #" | sed 's/^/stage-evidence /' >> "$LOG.new"
sealed_sha=$(sha256sum "$LOG.new" | cut -d' ' -f1)
printf 'harness end marker sha256=%s\n' "$sealed_sha" >> "$LOG.new"
mv "$LOG.new" "$LOG"
printf '  after re-sealing with the writer algorithm: '; run "$R"

echo
echo "### BOUNDARY 2 -- the attempt is not bound to its absolute path"
mkdir -p "$C/moved/somewhere/else"; rm -rf "$C/moved/somewhere/else/att-relocated"
cp -a "$A" "$C/moved/somewhere/else/att-relocated"
printf '  same bytes at an unrelated path: '; run "$C/moved/somewhere/else/att-relocated"

echo
echo "### BOUNDARY 3 -- child-evidence/** and \$RUN/option-c/** are outside the seal"
rm -rf "$C/unsealed"; cp -a "$A" "$C/unsealed"
CE="$C/unsealed/child-evidence/run-1790719690459-2918293/0009/stdout.bin"
printf '  child-evidence sha before: %s\n' "$(sha256sum "$CE" | cut -d' ' -f1)"
printf 'TAMPERED-CHILD-EVIDENCE' >> "$CE"
printf 'TAMPERED-OPTION-C' >> "$C/unsealed/option-c/identity.stdout"
printf '0\n' > "$C/unsealed/option-c/identity.rc"
printf '  child-evidence sha after : %s\n' "$(sha256sum "$CE" | cut -d' ' -f1)"
printf '  after mutating both trees : '; run "$C/unsealed"

echo
echo "### BOUNDARY 4 -- plan claims toolchain-resolution.txt is sealed; it is not"
printf '  plan claim (option-c-plan.md):\n'
grep -n 'toolchain record' "$SRC/option-c-plan.md" | head -2 | sed 's/^/    /'
printf '  files matching *toolchain* under integration-a3-evidence: %s\n' \
  "$(find "$SRC/.." -name '*toolchain*' 2>/dev/null | wc -l)"
printf '  files matching *toolchain* at the execution root (publication-staging/execution-option-c-2159c657): %s\n' \
  "$(find /home/losses/Development/tq-workspace/publication-staging/execution-option-c-2159c657 -maxdepth 3 -name '*toolchain*' 2>/dev/null | wc -l)"
printf '  sealed Stage 0 (env-guard) stage stdout: %s bytes\n' "$(wc -c < "$A/stages/step-2119220958.stdout")"
printf '  that entire sealed stdout is:\n'; sed 's/^/    /' "$A/stages/step-2119220958.stdout"
printf '  the stage command own captured stdout option-c/env-guard.stdout: %s bytes\n' "$(wc -c < "$A/option-c/env-guard.stdout")"
printf '  harness.log lines mentioning toolchain/resolved: %s\n' "$(grep -c -i 'toolchain\|resolved' "$A/harness.log")"
