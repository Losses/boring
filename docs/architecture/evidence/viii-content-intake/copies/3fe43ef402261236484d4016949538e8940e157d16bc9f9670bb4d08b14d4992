package boring

object DartNullPushOps {
    fun pushNullIntoNullableArray(): Int? {
        val xs = mutableListOf<Int?>()
        xs.add(1)
        xs.add(null)
        return xs[1]
    }

    fun pushValueIntoNullableArray(): Int? {
        val xs = mutableListOf<Int?>()
        xs.add(1)
        xs.add(2)
        return xs[1]
    }

    fun nullableClosureReturnsNull(): Int? {
        val f = fun(): Int? {
    return null
}
        return f()
    }

    fun nullableClosureReturnsValue(): Int? {
        val f = fun(): Int? {
    return 7
}
        return f()
    }
}
