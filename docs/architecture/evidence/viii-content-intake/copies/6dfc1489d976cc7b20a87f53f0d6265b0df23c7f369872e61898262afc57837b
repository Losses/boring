package lam;

import std.ReadOnlyArray;

class Lam {
	static function src():Array<Int> return [1, 2];
	static function src2():Array<Int> return [3];

	public static function use(f:Void->ReadOnlyArray<Int>):Int return f().length;

	// P-LAM-SINGLE: lambda whose body is EXACTLY one `return` of a mutable array,
	// against a declared ReadOnlyArray return contract.
	public static function singleReturn(flag:Bool):Int {
		return use(function():ReadOnlyArray<Int> {
			return flag ? src() : src2();
		});
	}

	// P-LAM-MULTI: multi-statement lambda body; a local then a return.
	public static function multiReturn(flag:Bool):Int {
		return use(function():ReadOnlyArray<Int> {
			var local = flag ? src() : src2();
			return local;
		});
	}

}
