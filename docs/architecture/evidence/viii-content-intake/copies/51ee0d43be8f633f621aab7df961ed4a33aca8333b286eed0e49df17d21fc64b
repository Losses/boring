#!/usr/bin/env python3
"""Independent reviewer: check 3 (in-progress changes not folded in) + baseline purity.

(a) For all 1398 baseline paths: manifest sha256 vs committed bytes at e1c65975 (git cat-file).
    Any mismatch => the 17:50 snapshot baked in then-dirty working-tree bytes.
(b) For every currently-dirty tracked file in the coord tree (git status):
    - present in execution root?
    - exec-root bytes == committed(e1c65975)?  == coord-tree dirty bytes?
    - manifest entry sha256 matches which side?
"""
import hashlib, json, os, subprocess

WS = "/home/losses/Development/tq-workspace"
GIT = os.path.join(WS, "boring")
COORD = os.path.join(WS, "boring-wt-architecture")
EXEC = os.path.join(WS, "publication-staging", "execution-option-c-coord")
MANIFEST = os.path.join(WS, "publication-staging", "p09-coord-state", "option-c-source-before.json")
COMMIT = "e1c65975"

def sha256_file(p):
    h = hashlib.sha256()
    with open(p, "rb") as f:
        for c in iter(lambda: f.read(1 << 20), b""):
            h.update(c)
    return h.hexdigest()

baseline = subprocess.run(["git", "-C", GIT, "ls-tree", "-r", "--name-only", COMMIT],
                          check=True, capture_output=True, text=True).stdout.splitlines()
manifest = {e["path"]: e for e in json.load(open(MANIFEST))}

# (a) baseline purity: manifest sha vs git blob content sha
mismatch = []
for p in baseline:
    blob = subprocess.run(["git", "-C", GIT, "cat-file", "blob", f"{COMMIT}:{p}"],
                          check=True, capture_output=True).stdout
    h = hashlib.sha256(blob).hexdigest()
    me = manifest.get(p)
    if me is None:
        mismatch.append((p, "not in manifest")); continue
    if me["sha256"] != h:
        mismatch.append((p, f"manifest {me['sha256'][:12]} != committed {h[:12]}"))
print(f"(a) baseline entries with manifest-sha != committed(e1c65975) sha: {len(mismatch)}")
for p, why in mismatch: print("  ", p, why)

# also verify exec-root bytes vs committed for the mismatched subset is covered by (b) below for dirty files.

# (b) dirty tracked files in coord tree
status = subprocess.run(["git", "-C", COORD, "status", "--porcelain", "-z"],
                        check=True, capture_output=True, text=True).stdout
dirty = []
for rec in status.split("\0"):
    if not rec: continue
    code, path = rec[:2], rec[3:]
    if code.startswith("M"):
        dirty.append(path)
print(f"(b) dirty tracked files in coord tree: {len(dirty)}")
for p in sorted(dirty):
    cpath = os.path.join(COORD, p)
    epath = os.path.join(EXEC, p)
    blob = subprocess.run(["git", "-C", GIT, "cat-file", "blob", f"{COMMIT}:{p}"],
                          check=True, capture_output=True).stdout
    committed = hashlib.sha256(blob).hexdigest()
    dirty_bytes = sha256_file(cpath)
    in_exec = os.path.isfile(epath)
    in_manifest = p in manifest
    exec_sha = sha256_file(epath) if in_exec else None
    m_sha = manifest[p]["sha256"] if in_manifest else None
    vs_committed = "YES" if exec_sha == committed else "no"
    vs_dirty = "YES" if exec_sha == dirty_bytes else "no"
    m_side = []
    if m_sha == committed: m_side.append("committed")
    if m_sha == dirty_bytes: m_side.append("dirty")
    print(f"  {p}")
    print(f"     in exec-root: {in_exec} | in manifest: {in_manifest}")
    print(f"     exec==committed(e1c65975): {vs_committed} | exec==coord-dirty: {vs_dirty}")
    print(f"     manifest sha matches: {m_side if m_side else 'NEITHER'}")
