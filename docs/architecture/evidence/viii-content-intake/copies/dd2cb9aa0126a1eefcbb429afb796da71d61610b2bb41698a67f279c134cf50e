package boring

import boring.runtime.SortedMapTable
import boring.runtime.SortedSetTable
import boring.runtime.SortedTable

object ClusterTags {
    fun createMap(): SortedMapTable<ClusterTag, Int> {
        val b = SortedTable.mapBuilder<ClusterTag, Int>(::compare)
        b.put(ClusterTag(name = "beta", score = 10, sub = SubTag(priority = 1), active = true), 100)
        b.put(ClusterTag(name = "alpha", score = 20, sub = SubTag(priority = 2), active = false), 200)
        b.put(ClusterTag(name = "alpha", score = 10, sub = SubTag(priority = 3), active = true), 300)
        b.put(ClusterTag(name = "alpha", score = 10, sub = SubTag(priority = 1), active = true), 400)
        b.put(ClusterTag(name = "alpha", score = 10, sub = SubTag(priority = 1), active = false), 500)
        return b.build()
    }

    fun createSet(): SortedSetTable<ClusterTag> {
        val b = SortedTable.setBuilder<ClusterTag>(::compare)
        b.put(ClusterTag(name = "beta", score = 10, sub = SubTag(priority = 1), active = true))
        b.put(ClusterTag(name = "alpha", score = 10, sub = SubTag(priority = 1), active = false))
        b.put(ClusterTag(name = "beta", score = 10, sub = SubTag(priority = 1), active = true))
        b.put(ClusterTag(name = "alpha", score = 20, sub = SubTag(priority = 2), active = false))
        return b.build()
    }

    fun tagScore(tag: ClusterTag): Int? {
        val map = ClusterTags.createMap()
        return map.get(tag)
    }

    fun describeOrder(): String {
        val map = ClusterTags.createMap()
        val parts = mutableListOf<String>()
        val count = map.size()
        for (i in 0 until count) {
            val k = map.keyAt(i)
            var act = "F"
            if ((k.active)) {
                act = "T"
            }
            parts.add(k.name + ":" + k.score + ":" + k.sub.priority + ":" + act + "=" + map.valueAt(i))
        }
        return parts.joinToString("; ")
    }

    fun describeSetOrder(): String {
        val set = ClusterTags.createSet()
        val parts = mutableListOf<String>()
        val count = set.size()
        for (i in 0 until count) {
            val k = set.at(i)
            var act = "F"
            if ((k.active)) {
                act = "T"
            }
            parts.add(k.name + ":" + k.score + ":" + k.sub.priority + ":" + act)
        }
        return parts.joinToString("; ")
    }

    fun setScores(): MutableList<Int> {
        val set = ClusterTags.createSet()
        val scores = mutableListOf<Int>()
        for (i in 0 until set.size()) {
            scores.add(set.at(i).score)
        }
        return scores
    }

    fun describeScores(): String {
        val scores = ClusterTags.setScores()
        val parts = mutableListOf<String>()
        for (i in 0 until scores.size) {
            parts.add((scores[i]).toString())
        }
        return parts.joinToString(",")
    }
}

data class SubTag(
    var priority: Int
)

fun compare(a: SubTag, b: SubTag): Int {
    if (a === b) return 0
    var cmp = 0
    cmp = a.priority.compareTo(b.priority)
    if (cmp != 0) return cmp
    return 0
}

data class ClusterTag(
    var name: String,
    var score: Int,
    var sub: SubTag,
    var active: Boolean
)

fun compare(a: ClusterTag, b: ClusterTag): Int {
    if (a === b) return 0
    var cmp = 0
    cmp = a.name.compareTo(b.name)
    if (cmp != 0) return cmp
    cmp = a.score.compareTo(b.score)
    if (cmp != 0) return cmp
    cmp = compare(a.sub, b.sub)
    if (cmp != 0) return cmp
    cmp = a.active.compareTo(b.active)
    if (cmp != 0) return cmp
    return 0
}
