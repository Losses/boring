o);\n}\n\nfn main() {\n    // Calling the method is still fine, as i32 implements Debug.\n    some_func(5i32);\n\n    // This would fail to compile now:\n    // struct WithoutDebug;\n    // some_func(WithoutDebug);\n}\n```\n\nRust only looks at the signature of the called function, as such it must\nalready specify all requirements that will be used for every type parameter.\n"},"level":"error","spans":[{"file_name":"xsxm/cross_probe.rs","byte_start":2196,"byte_end":2246,"line_start":88,"line_end":88,"column_start":23,"column_end":73,"is_primary":false,"text":[{"text":"            return Ok(CrossProbe::cross_probe_throw_e1(UStr::new(&[97]))?);","highlight_start":23,"highlight_end":73}],"label":"this can't be annotated with `?` because it has type `Result<_, F1Fault>`","suggested_replacement":null,"suggestion_applicability":null,"expansion":null},{"file_name":"xsxm/cross_probe.rs","byte_start":2246,"byte_end":2247,"line_start":88,"line_end":88,"column_start":73,"column_end":74,"is_primary":true,"text":[{"text":"            return Ok(CrossProbe::cross_probe_throw_e1(UStr::new(&[97]))?);","highlight_start":73,"highlight_end":74}],"label":"the trait `From<F1Fault>` is not implemented for `F2Fault`","suggested_replacement":null,"suggestion_applicability":null,"expansion":{"span":{"file_name":"xsxm/cross_probe.rs","byte_start":2246,"byte_end":2247,"line_start":88,"line_end":88,"column_start":73,"column_end":74,"is_primary":false,"text":[{"text":"            return Ok(CrossProbe::cross_probe_throw_e1(UStr::new(&[97]))?);","highlight_start":73,"highlight_end":74}],"label":null,"suggested_replacement":null,"suggestion_applicability":null,"expansion":null},"macro_decl_name":"desugaring of operator `?`","def_site_span":{"file_name":"lib.rs","byte_start":0,"byte_end":0,"line_start":1,"line_end":1,"column_start":1,"column_end":1,"is_primary":false,"text":[],"label":null,"suggested_replacement":null,"suggestion_applicability":null,"expansion":null}}}],"children":[{"message":"`F2Fa