package xsxm;

/** ATTACK FIXTURE 2: a message-only exception and a payload exception in ONE
    module. `messageOnlyExceptions` / `exceptionPayloads` are both keyed by the
    CLASS module; RustType.hx branch 1 gates on `messageOnlyExceptions.exists(
    cls.module)` — a module-keyed exists() — so the payload class sharing the
    module can be misrouted into the message-only branch. */
class MsgOnly extends haxe.Exception {
	public function new(message:String) {
		super(message);
	}
}

class WithPayload extends haxe.Exception {
	public final fault:Faults.F1Fault;

	public function new(fault:Faults.F1Fault) {
		this.fault = fault;
		super(describe(fault));
	}

	public static function describe(f:Faults.F1Fault):String {
		return switch (f) {
			case One(t): t;
		};
	}
}
