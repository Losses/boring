package tests

import boring.ToStringOps
import boring.runtime.test.Test

class ToStringTests {
@boring.test.Test
    fun explicitToString() {
        Test.run("tests.ToStringTests.explicitToString", "tests.ToStringTests.explicitToString: an explicit toString method renders and runs on every target") {
                val label = ToStringOps.makeLabel("body", 12)
                Test.equals("PlainLabel(text=body, width=12)", ToStringOps.describe(label), "describe must return the explicit printed form")
        }
    }
}
