#[derive(Clone, Copy)]
pub struct NegIntSlotOps;

impl NegIntSlotOps {
    pub fn neg_int_slot_ops_negate(value: u32) -> u32 {
        return u32::from_ne_bytes(((-(value as i32)) as u32).to_ne_bytes());
    }

    pub fn neg_int_slot_ops_negate_argument(value: u32) -> u32 {
        return NegIntSlotOps::neg_int_slot_ops_identity(u32::from_ne_bytes(((-(value as i32)) as u32).to_ne_bytes()));
    }

    pub fn neg_int_slot_ops_negate_conditional(negative: bool, value: u32) -> u32 {
        return if negative { u32::from_ne_bytes(((-(value as i32)) as u32).to_ne_bytes()) } else { value };
    }

    pub(crate) fn neg_int_slot_ops_identity(value: u32) -> u32 {
        return value;
    }
}
