use crate::runtime::u_string::UString;


#[derive(Clone, PartialEq)]
pub struct BranchedOptionalFieldHolder {
    pub penalty: u32,
    pub rate: f64,
}

impl BranchedOptionalFieldHolder {
    pub fn new(penalty: Option<u32>, rate: Option<f64>) -> Self {
    let mut _field_rate = 0.0;
    let mut _field_penalty = 0;
        match &(penalty) {
            None => {
                _field_penalty = 2u32;
            }
            Some(__option) => {
                _field_penalty = *__option;
            }
        }
        match &(rate) {
            None => {
                _field_rate = 0.5f64;
            }
            Some(__option1) => {
                _field_rate = *__option1;
            }
        }
        Self {
            penalty: _field_penalty,
            rate: _field_rate,
        }
    }
}

pub trait BranchedOptionalRule: Send + Sync {
    fn __haxe_type_name(&self) -> &'static str;
    fn as_any(&self) -> &dyn std::any::Any;
    fn clone_box(&self) -> Box<dyn BranchedOptionalRule>;
    fn tag(&self) -> UString;
}

impl Clone for Box<dyn BranchedOptionalRule> {
    fn clone(&self) -> Self {
        self.clone_box()
    }
}

impl std::fmt::Debug for dyn BranchedOptionalRule {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        write!(f, "{}", self.__haxe_type_name())
    }
}

#[derive(Clone, PartialEq)]
pub struct BranchedOptionalConcreteRule {
}

impl BranchedOptionalConcreteRule {
    pub const fn new() -> Self {
        Self {
        }
    }

    pub fn tag(&self) -> UString {
        return UString::from("concrete").to_ustring();
    }
}

impl BranchedOptionalRule for BranchedOptionalConcreteRule {
    fn __haxe_type_name(&self) -> &'static str {
        "boring.BranchedOptionalFieldOps.BranchedOptionalConcreteRule"
    }
    fn as_any(&self) -> &dyn std::any::Any {
        self
    }
    fn clone_box(&self) -> Box<dyn BranchedOptionalRule> {
        Box::new(self.clone())
    }

    fn tag(&self) -> UString {
        return UString::from("concrete").to_ustring();
    }
}

#[derive(Clone)]
pub struct BranchedOptionalRuleHolder {
    pub rule: Box<dyn BranchedOptionalRule>,
}

impl BranchedOptionalRuleHolder {
    pub fn new(rule: Option<Box<dyn BranchedOptionalRule>>) -> Self {
    let mut _field_rule: Box<dyn BranchedOptionalRule>;
        match &(rule) {
            None => {
                _field_rule = Box::new(BranchedOptionalConcreteRule::new());
            }
            Some(__option2) => {
                _field_rule = __option2.clone();
            }
        }
        Self {
            rule: _field_rule,
        }
    }
}

#[derive(Clone, Copy)]
pub struct BranchedOptionalFieldOps;

impl BranchedOptionalFieldOps {
    pub fn branched_optional_field_ops_penalty() -> u32 {
        return BranchedOptionalFieldHolder::new(None, None).penalty;
    }

    pub fn branched_optional_field_ops_rate() -> f64 {
        return BranchedOptionalFieldHolder::new(None, None).rate;
    }

    pub fn branched_optional_field_ops_explicit() -> u32 {
        return BranchedOptionalFieldHolder::new(Some(9), Some(1.5f64)).penalty;
    }

    pub fn branched_optional_field_ops_rule_tag() -> UString {
        return BranchedOptionalRuleHolder::new(None).rule.tag();
    }
}
