#![cfg(test)]

use crate::boring::numeric_widen_ops::NumericWidenOps;
use crate::boring::switch_merge_ops::SwitchMergeValue;
use crate::runtime::test as testlib;
use crate::runtime::test_core;
use crate::runtime::u_string::UStr;


#[test]
fn test_operands() {
    testlib::run("tests.NumericWidenTests.testOperands", "tests.NumericWidenTests.testOperands: Int operands widen for Float arithmetic", || {
        test_core::TestCore::test_core_equals_float(3.5f32, NumericWidenOps::numeric_widen_ops_operand_float(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_float(3.5f32, NumericWidenOps::numeric_widen_ops_operand_double(), UStr::new(&[]));
    });
}

#[test]
fn test_returns() {
    testlib::run("tests.NumericWidenTests.testReturns", "tests.NumericWidenTests.testReturns: Int returns widen for Float results", || {
        test_core::TestCore::test_core_equals_float(2.0f32, NumericWidenOps::numeric_widen_ops_return_float(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_float(2.0f32, NumericWidenOps::numeric_widen_ops_return_double(), UStr::new(&[]));
    });
}

#[test]
fn test_assignments() {
    testlib::run("tests.NumericWidenTests.testAssignments", "tests.NumericWidenTests.testAssignments: Int assignments widen for Float locals", || {
        test_core::TestCore::test_core_equals_float(2.0f32, NumericWidenOps::numeric_widen_ops_assign_float(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_float(2.0f32, NumericWidenOps::numeric_widen_ops_assign_double(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_float(2.5f32, NumericWidenOps::numeric_widen_ops_applied_float(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_float(1.0f32, NumericWidenOps::numeric_widen_ops_applied_double(), UStr::new(&[]));
    });
}

#[test]
fn test_nullable_conditional() {
    testlib::run("tests.NumericWidenTests.testNullableConditional", "tests.NumericWidenTests.testNullableConditional: Nullable conditional arms widen for Float results", || {
        test_core::TestCore::test_core_equals_float(2.5f32, NumericWidenOps::numeric_widen_ops_nullable_conditional(Some(2.5f32)), UStr::new(&[]));
        test_core::TestCore::test_core_equals_float(0.0f32, NumericWidenOps::numeric_widen_ops_nullable_conditional(None), UStr::new(&[]));
    });
}

#[test]
fn test_branch_merges() {
    testlib::run("tests.NumericWidenTests.testBranchMerges", "tests.NumericWidenTests.testBranchMerges: Conditional and switch arms widen for Float results", || {
        test_core::TestCore::test_core_equals_float(1.5f32, NumericWidenOps::numeric_widen_ops_conditional_merge(true), UStr::new(&[]));
        test_core::TestCore::test_core_equals_float(2.0f32, NumericWidenOps::numeric_widen_ops_conditional_merge(false), UStr::new(&[]));
        test_core::TestCore::test_core_equals_float(1.5f32, NumericWidenOps::numeric_widen_ops_switch_merge(SwitchMergeValue::First { value: 1 }), UStr::new(&[]));
        test_core::TestCore::test_core_equals_float(2.0f32, NumericWidenOps::numeric_widen_ops_switch_merge(SwitchMergeValue::Second { value: 1 }), UStr::new(&[]));
        test_core::TestCore::test_core_equals_float(0.5f32, NumericWidenOps::numeric_widen_ops_switch_merge((SwitchMergeValue::Third).clone()), UStr::new(&[]));
    });
}
