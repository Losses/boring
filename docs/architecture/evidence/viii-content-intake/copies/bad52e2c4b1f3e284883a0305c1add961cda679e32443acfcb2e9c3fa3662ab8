use crate::runtime::u_string::UString;
use crate::std::u_string_exception::UStringFault;


#[derive(Clone, Copy)]
pub struct StringBufThrowOps;

impl StringBufThrowOps {
    pub(crate) fn string_buf_throw_ops_checked_label(count: u32) -> Result<UString, UStringFault> {
        if count == 0 {
            return Err(UStringFault::InvalidCodePoint { code: 11 });
        }
        return Ok(UString::from(format!("{}", { let mut __s = UString::new(); __s += &(UString::from("item-")); __s += &(UString::from((count).to_string().as_str())); __s }).as_str()));
    }

    pub(crate) fn string_buf_throw_ops_classify_fault(fault: UStringFault) -> u32 {
        return match fault {
            UStringFault::InvalidCodePoint { code: _p0 } => u32::wrapping_add(3000, _p0),
            UStringFault::UnpairedSurrogate { unit: _p0 } => u32::wrapping_add(4000, _p0),
        };
    }

    pub fn string_buf_throw_ops_build_from_checked(count: u32) -> Result<UString, UStringFault> {
        let mut buf = Vec::<u16>::new();
        if let Some(&unit) = buf.last() {
            if unit >= 55296 && unit <= 56319 && !StringBufThrowOps::string_buf_throw_ops_checked_label(count)?.is_empty() {
                if !match (StringBufThrowOps::string_buf_throw_ops_checked_label(count)?).encode_utf16().next() { Some(head) => head >= 56320 && head <= 57343, None => false } {
                    return Err(UStringFault::UnpairedSurrogate { unit: u32::from(unit) });
                }
            }
        }
        buf.extend(StringBufThrowOps::string_buf_throw_ops_checked_label(count)?.encode_utf16());
        return Ok(UString::from_utf16(buf.as_slice()).map_err(|_| UStringFault::UnpairedSurrogate { unit: u32::from(buf[buf.len() - 1]) })?);
    }

    pub fn string_buf_throw_ops_caught_checked(count: u32) -> u32 {
        let value: u32 = match (|| -> Result<u32, UStringFault> {
            let mut buf = Vec::<u16>::new();
            if let Some(&unit) = buf.last() {
                if unit >= 55296 && unit <= 56319 && !StringBufThrowOps::string_buf_throw_ops_checked_label(count)?.is_empty() {
                    if !match (StringBufThrowOps::string_buf_throw_ops_checked_label(count)?).encode_utf16().next() { Some(head) => head >= 56320 && head <= 57343, None => false } {
                        return Err(UStringFault::UnpairedSurrogate { unit: u32::from(unit) });
                    }
                }
            }
            buf.extend(StringBufThrowOps::string_buf_throw_ops_checked_label(count)?.encode_utf16());
            return Ok(0);
        })() {
            Ok(__value) => __value,
            Err(error) => StringBufThrowOps::string_buf_throw_ops_classify_fault((error).clone()),
        };
        return value;
    }

    pub(crate) fn string_buf_throw_ops_checked_unit(count: u32) -> Result<u32, UStringFault> {
        if count == 0 {
            return Err(UStringFault::InvalidCodePoint { code: 13 });
        }
        return Ok(65);
    }

    pub fn string_buf_throw_ops_build_char_from_checked(count: u32) -> Result<UString, UStringFault> {
        let mut buf = Vec::<u16>::new();
        if StringBufThrowOps::string_buf_throw_ops_checked_unit(count)? >= 56320 && StringBufThrowOps::string_buf_throw_ops_checked_unit(count)? <= 57343 {
            match buf.last() {
                Some(&last) if last >= 55296 && last <= 56319 => {}
                _ => return Err(UStringFault::UnpairedSurrogate { unit: StringBufThrowOps::string_buf_throw_ops_checked_unit(count)? }),
            }
        } else if let Some(&last) = buf.last() {
            if last >= 55296 && last <= 56319 {
                return Err(UStringFault::UnpairedSurrogate { unit: u32::from(last) });
            }
        }
        buf.push(u16::try_from((StringBufThrowOps::string_buf_throw_ops_checked_unit(count)?) & 0xFFFF).unwrap_or(0));
        return Ok(UString::from_utf16(buf.as_slice()).map_err(|_| UStringFault::UnpairedSurrogate { unit: u32::from(buf[buf.len() - 1]) })?);
    }
}
