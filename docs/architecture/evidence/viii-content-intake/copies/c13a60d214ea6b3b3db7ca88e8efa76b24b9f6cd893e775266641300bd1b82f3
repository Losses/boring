package mx;

import std.ReadOnlyArray;
import mx.MXSupport.QChoice;
import mx.MXSupport.QSource;

/**
	P7: multi-statement statement-position switch inside a lambda, member Int /
	    lambda ReadOnlyArray<Int>, arms carrying several statements.
**/
class MXStmt {
	public static function pSwitchArmsMultiStmt(c:QChoice):Int {
		var f = function(c:QChoice):ReadOnlyArray<Int> {
			var marker:Int = QSource.view(QSource.first());
			if (marker < 0) {
				QSource.second();
			}
			switch (c) {
				case QOne:
					var first = QSource.first();
					return first;
				case QTwo:
					return QSource.second();
			}
		}
		return QSource.view(f(c));
	}
}
