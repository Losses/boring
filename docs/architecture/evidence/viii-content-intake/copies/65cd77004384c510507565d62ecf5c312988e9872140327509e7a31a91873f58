#!/usr/bin/env python3
"""Line-level audit of PATCH.diff: prove no test logic/assertion line was touched.

Every +line must be a comment or a bare `}, <number>);` parameter line.
Every -line must be a bare `});` or `}, <number>);` parameter line.
"""
import re, sys, collections

add_ok = re.compile(r"^\+\s*(//.*|\},[ \t]*[0-9_]+\);\s*|\},[ \t]*[0-9_]+\);.*)$")
del_ok = re.compile(r"^-\s*(\}\);|\},[ \t]*[0-9_]+\);\s*)$")
added = collections.Counter(); removed = collections.Counter(); bad = []
files = set()
cur = None
for line in open(sys.argv[1], encoding="utf-8"):
    line = line.rstrip("\n")
    if line.startswith("+++ "):
        cur = line[6:]
        files.add(cur)
        continue
    if line.startswith("--- ") or line.startswith("@@") or line.startswith("diff "):
        continue
    if line.startswith("+"):
        kind = "comment" if line[1:].lstrip().startswith("//") else "budget-arg"
        if not add_ok.match(line): bad.append(("ADD", cur, line))
        else: added[kind] += 1
    elif line.startswith("-"):
        if not del_ok.match(line): bad.append(("DEL", cur, line))
        else: removed["budget-arg-or-close"] += 1

print("files touched:", len(files))
print("added lines   :", dict(added), "total", sum(added.values()))
print("removed lines :", dict(removed), "total", sum(removed.values()))
print("lines that are NOT a comment / NOT a bare timeout-arg change:", len(bad))
for b in bad:
    print("  ", b)
sys.exit(1 if bad else 0)
