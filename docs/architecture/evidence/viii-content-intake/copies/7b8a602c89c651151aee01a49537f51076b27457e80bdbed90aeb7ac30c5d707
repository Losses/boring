use crate::runtime::u_string::UStr;
use crate::runtime::u_string::UString;


pub trait TextShaper: Send + Sync {
    fn __haxe_type_name(&self) -> &'static str;
    fn as_any(&self) -> &dyn std::any::Any;
    fn clone_box(&self) -> Box<dyn TextShaper>;
    fn shape(&self, text: &UStr) -> UString;
}

impl Clone for Box<dyn TextShaper> {
    fn clone(&self) -> Self {
        self.clone_box()
    }
}

impl std::fmt::Debug for dyn TextShaper {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        write!(f, "{}", self.__haxe_type_name())
    }
}

#[derive(Clone, Copy)]
pub struct ShapeTextOps;

impl ShapeTextOps {
    pub fn shape_text_ops_render(shaper: Box<dyn TextShaper>, text: &UStr) -> UString {
        return shaper.shape(text);
    }
}
