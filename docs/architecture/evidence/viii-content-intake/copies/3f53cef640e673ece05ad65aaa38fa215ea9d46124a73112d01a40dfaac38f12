#!/usr/bin/env bash
# Independent criterion-3 xcheck driver (reviewer-owned, separate model).
# Task t-mun5d99p-op76. Own worktree swift-rt-xcheck; own attempt dirs.
# Usage: NAME=<prefix|postfix|negctl> EV=<evidence dir> bash xcheck.sh
# Phases are driven by the caller (git state transitions), not by this script:
#   prefix  = pristine worktree (no patch)
#   postfix = PATCH.diff applied
#   negctl  = patch applied then SwiftDecl.hx reverted via git checkout
# Each phase: gen + swiftc for try-tail (std+trytail), probe, plain.
set -uo pipefail
NAME="${NAME:?NAME required}"
EV="${EV:?EV required}"
ROOT="/home/losses/Development/tq-workspace/dc-warn/worktrees/swift-rt-xcheck"
PATCH="/home/losses/Development/tq-workspace/dc-warn/out/swift-rt/PATCH.diff"
F="packages/compiler/reflaxe/swift/swiftcompiler/SwiftDecl.hx"
STAGES="$EV/stages"
TREES="$EV/trees"
OFFFUSE="/home/losses/Development/tq-workspace/out/swift-rt-xcheck"
mkdir -p "$STAGES" "$TREES" "$OFFFUSE"
TAB="$(printf '\t')"

record() {
	printf '%s%s%s%s%s\n' "$1" "$TAB" "$TAB$2" "$TAB" "$3" >>"$EV/status.tsv"
	printf '%s observed=%s\n' "$1" "$2"
}

SWIFTROOT="/nix/store/j1bfa7mw323wmp6pfrn1qkchxv61wk2n-swift-toolchain-6.2.4-al2"
FHS="/nix/store/xq9k8vi7gqw0wn592p95wzvzf3wzn4kh-swift-6.2.4-fhs-fhsenv-rootfs"
GLIBC_LIB="$(dirname "$(readlink -f "$FHS/usr/lib64/Scrt1.o")")"
GCCRT_DIR="$(gcc -print-libgcc-file-name | sed 's#/[^/]*$##')"
LIBGCCS_DIR="$(gcc -print-file-name=libgcc_s.so.1 | sed 's#/[^/]*$##')"
LDRT="$FHS/usr/lib64:$FHS/lib64:$SWIFTROOT/usr/lib/swift/linux:/usr/lib64:/usr/lib"
SHIM="$EV/swift-shim"
mkdir -p "$SHIM"
for f in Scrt1.o crti.o crtn.o; do cp "$GLIBC_LIB/$f" "$SHIM/$f" 2>/dev/null || true; done
for f in crtbeginS.o crtendS.o; do cp "$GCCRT_DIR/$f" "$SHIM/$f" 2>/dev/null || true; done

input_hashes() {
	( cd "$ROOT" && sha256sum tests/haxe/try-tail/oracle.hxml tests/haxe/try-tail/expected.txt tests/haxe/try-tail/trytail/TryTailOracle.hx tests/haxe/try-tail/gen/*.hxml tests/haxe/try-tail/native/* tests/haxe/try-tail/run-stages.sh tests/haxe/swift-rt-probe/probe/Probe.hx tests/haxe/swift-rt-probe/gen/swift.hxml tests/haxe/swift-rt-probe/native/native-main.swift tests/haxe/swift-rt-probe/expected.txt tests/haxe/swift-rt-plain/plain/Plain.hx tests/haxe/swift-rt-plain/gen/swift.hxml tests/haxe/swift-rt-plain/native/native-main.swift tests/haxe/swift-rt-plain/expected.txt )
}

echo "xcheck $NAME at $(date -u +%Y-%m-%dT%H:%M:%SZ)" >"$EV/identity.txt"
git -C "$ROOT" log --oneline -1 >>"$EV/identity.txt"
git -C "$ROOT" status --short >>"$EV/identity.txt"
sha256sum "$ROOT/$F" | sed "s#$ROOT/##" >>"$EV/identity.txt"
{
	printf 'swiftc %s\n' "$SWIFTROOT/usr/bin/swiftc"
	printf 'fhs-rootfs %s\n' "$FHS"
	printf 'glibc-lib %s\n' "$GLIBC_LIB"
	printf 'gccrt-dir %s\n' "$GCCRT_DIR"
	printf 'libgccs-dir %s\n' "$LIBGCCS_DIR"
} >"$EV/swift-toolchain.txt"
input_hashes >"$EV/input-hashes.txt"

gen() { # <fixture> <genrel>
	local fix=$1 genrel=$2 dir
	dir="$STAGES/gen-$1"
	mkdir -p "$dir"
	{
		printf 'cwd %s\n' "$ROOT"
		printf 'argv haxe tests/haxe/%s/gen/swift.hxml -D swift-output=%s -D swift-test-output=out/swift-rt-xcheck/gen/%s-test\n' "$(gen_dir "$1")" "$genrel" "$1"
	} >"$dir/argv"
	local fdir
	fdir="$(gen_dir "$1")"
	( cd "$ROOT" && rm -rf "$genrel" && haxe "tests/haxe/$fdir/gen/swift.hxml" -D "swift-output=$genrel" -D "swift-test-output=out/swift-rt-xcheck/gen/$1-test" ) >"$dir/stdout" 2>"$dir/stderr"
	printf '%s\n' "$?" >"$dir/status"
	record "gen-$1" "$(cat "$dir/status")" "zero"
	( cd "$ROOT" && find "$genrel" -type f | sort | sed "s#^$genrel/##" ) >"$TREES/$1.files" 2>&1
	( cd "$ROOT" && find "$genrel" -type f \( -name '*.swift' -o -name '_GeneratedFiles.txt' \) | sort | sed "s#^$genrel/##" | while read -r f; do
			printf '%s  %s\n' "$(sha256sum "$genrel/$f" | cut -d' ' -f1)" "$f"
		done ) >"$TREES/$1.sha256" 2>&1
	record "tree-$1" "$(wc -l <"$TREES/$1.files")" "file-count"
}

compile() { # <fixture> <genrel> <modules...>
	local fix=$1 genrel=$2
	shift 2
	local dir AGEN RT="" FILES="" m
	dir="$STAGES/compile-$fix"
	AGEN="$ROOT/$genrel"
	mkdir -p "$dir"
	for m in "$@"; do
		FILES="$FILES $(find "$AGEN/$m" -name '*.swift' | tr '\n' ' ')"
	done
	[ -f "$AGEN/Runtime.swift" ] && RT="$AGEN/Runtime.swift "
	if [ "$fix" = "plain" ]; then
		# Boundary recipe (mirrors executor boundary.sh): the whole emitted
		# tree, every .swift except the SwiftPM manifest, the authored
		# harness and Runtime.swift itself (which enters via $RT once).
		FILES=" $(find "$AGEN" -name '*.swift' ! -name 'Package.swift' ! -name 'native-main.swift' ! -name 'Runtime.swift' | tr '\n' ' ')"
	fi
	( cd "$ROOT" && cp "tests/haxe/$(gen_dir "$fix")/native/native-main.swift" "$AGEN/native-main.swift" )
	{
		printf 'cwd %s\n' "$ROOT"
		printf 'argv'
		printf ' %q' bash -c "cd $SHIM && LD_LIBRARY_PATH='$LDRT' timeout 1800 $SWIFTROOT/usr/bin/swiftc -o $AGEN/run-bin $RT$FILES $AGEN/native-main.swift -Xcc -I$FHS/usr/include -L$FHS/usr/lib64 -L$GCCRT_DIR -L$LIBGCCS_DIR -L$GLIBC_LIB"
		printf '\n'
	} >"$dir/argv"
	( cd "$SHIM" && LD_LIBRARY_PATH="$LDRT" timeout 1800 "$SWIFTROOT/usr/bin/swiftc" -o "$AGEN/run-bin" $RT$FILES "$AGEN/native-main.swift" -Xcc -I"$FHS/usr/include" -L"$FHS/usr/lib64" -L"$GCCRT_DIR" -L"$LIBGCCS_DIR" -L"$GLIBC_LIB" ) >"$dir/stdout" 2>"$dir/stderr"
	printf '%s\n' "$?" >"$dir/status"
	record "compile-$fix" "$(cat "$dir/status")" "data"
	local n
	n=$(grep -c "warning: libc not found" "$dir/stderr" 2>/dev/null || true)
	record "libc-warning-count-$fix" "${n:-0}" "environment-noise-count"
}

gen_dir() { # <fixture> -> fixture dir
	case "$1" in
	try-tail) printf 'try-tail' ;;
	probe) printf 'swift-rt-probe' ;;
	plain) printf 'swift-rt-plain' ;;
	esac
}
gen try-tail out/swift-rt-xcheck/gen/swift
compile try-tail out/swift-rt-xcheck/gen/swift std trytail
gen probe out/swift-rt-xcheck/gen/probe
compile probe out/swift-rt-xcheck/gen/probe probe
gen plain out/swift-rt-xcheck/gen/plain
compile plain out/swift-rt-xcheck/gen/plain

# Off-fuse supplementary runs: fuse.rclone strips exec bits, so the
# on-mount run-bin cannot execute; copy the same binary to local /home
# and run it there. Only meaningful when the compile produced a binary.
for fix in try-tail probe plain; do
	AGEN="$ROOT/out/swift-rt-xcheck/gen/$fix"
	[ -f "$AGEN/run-bin" ] || {
		record "run-$fix-from-tmp" "no-binary-compile-status-$(cat "$STAGES/compile-$fix/status")" "not-reached"
		continue
	}
	dir="$STAGES/run-$fix-from-tmp"
	mkdir -p "$dir"
	tb="$OFFFUSE/$fix-$NAME-bin"
	cp "$AGEN/run-bin" "$tb" && chmod +x "$tb"
	{
		printf 'cwd /tmp\nargv'
		printf ' %q' cp "$AGEN/run-bin" "$tb"
		printf ' %q' chmod +x "$tb"
		printf ' %q' env "LD_LIBRARY_PATH=$LDRT" timeout 300 "$tb"
		printf '\n'
	} >"$dir/argv"
	( cd /tmp && LD_LIBRARY_PATH="$LDRT" timeout 300 "$tb" ) >"$dir/stdout" 2>"$dir/stderr"
	printf '%s\n' "$?" >"$dir/status"
	record "run-$fix-from-tmp" "$(cat "$dir/status")" "supplementary: off-fuse same binary"
	case "$fix" in
	try-tail)
		diff -u "$ROOT/tests/haxe/try-tail/expected.txt" "$dir/stdout" >"$dir/compare.stdout" 2>"$dir/compare.stderr"
		record "compare-try-tail-from-tmp" "$?" "0-identical-nonzero-differs" ;;
	plain)
		diff -u "$ROOT/tests/haxe/swift-rt-plain/expected.txt" "$dir/stdout" >"$dir/compare.stdout" 2>"$dir/compare.stderr"
		record "compare-plain-from-tmp" "$?" "0-identical-nonzero-differs" ;;
	*)
		printf 'concrete=1\n' >"$dir/expected.stdout"
		diff -u "$dir/expected.stdout" "$dir/stdout" >"$dir/compare.stdout" 2>"$dir/compare.stderr"
		record "compare-probe-from-tmp" "$?" "0-identical-nonzero-differs" ;;
	esac
done

input_hashes >"$EV/input-hashes-after.txt"
