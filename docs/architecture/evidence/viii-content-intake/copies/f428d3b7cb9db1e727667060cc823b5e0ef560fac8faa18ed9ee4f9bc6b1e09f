use crate::runtime::u_string::UStr;
use crate::runtime::u_string::UString;


#[derive(Clone, PartialEq)]
pub struct BorrowedReceiverState {
    pub owner: BorrowedReceiverHolder,
}

impl BorrowedReceiverState {
    pub fn new(owner: BorrowedReceiverHolder) -> Self {
        Self {
            owner,
        }
    }
}

#[derive(Clone, PartialEq)]
pub struct BorrowedReceiverHolder {
    pub label: UString,
}

impl BorrowedReceiverHolder {
    pub fn new(label: &UStr) -> Self {
        Self {
            label: label.to_ustring(),
        }
    }

    pub fn snapshot(&self) -> BorrowedReceiverState {
        return BorrowedReceiverState::new((self).clone());
    }

    pub fn pick(&self, flag: bool) -> BorrowedReceiverHolder {
        return if flag { (self).clone() } else { BorrowedReceiverHolder::new(&(UStr::new(&[111,116,104,101,114]))) };
    }
}

#[derive(Clone, Copy)]
pub struct BorrowedReceiverBoundaryOps;

impl BorrowedReceiverBoundaryOps {
    pub fn borrowed_receiver_boundary_ops_snapshot_label() -> UString {
        let holder = BorrowedReceiverHolder::new(&(UStr::new(&[114,111,111,116])));
        return ((holder.snapshot().owner.label).to_ustring()).clone();
    }

    pub fn borrowed_receiver_boundary_ops_pick_label(flag: bool) -> UString {
        let holder = BorrowedReceiverHolder::new(&(UStr::new(&[114,111,111,116])));
        return ((holder.pick(flag).label).to_ustring()).clone();
    }
}
