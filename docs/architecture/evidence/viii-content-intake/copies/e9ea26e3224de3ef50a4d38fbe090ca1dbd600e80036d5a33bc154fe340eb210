use crate::boring::vector_exception::VectorError;
use crate::runtime::u_string::UString;
use crate::std::u_string_exception::UStringFault;


#[derive(Clone, Copy)]
pub struct TryOps;

impl TryOps {
    pub(crate) fn try_ops_throwing_codec(count: u32) -> Result<u32, VectorError> {
        if i32::from_ne_bytes(((count) as i32).to_ne_bytes()) > (10) {
            return Err(VectorError::CountOverflow);
        }
        return Ok(u32::wrapping_mul(count, 2));
    }

    pub fn try_ops_classify_fault(error: VectorError) -> u32 {
        return match error {
            VectorError::BadMagic => 11,
            VectorError::CountOverflow => 12,
            VectorError::UnexpectedEof => 13,
            VectorError::TrailingBytes { .. } => 24,
        };
    }

    pub(crate) fn try_ops_classify_code(fault: UStringFault) -> u32 {
        return match fault {
            UStringFault::InvalidCodePoint { code: _p0 } => u32::wrapping_add(30, _p0),
            UStringFault::UnpairedSurrogate { unit: _p0 } => u32::wrapping_add(40, _p0),
        };
    }

    pub fn try_ops_caught_statement(count: u32) -> u32 {
        let mut total = 0u32;
        let __outcome: Result<(), VectorError> = (|| {
            total = u32::wrapping_add(total, TryOps::try_ops_throwing_codec(count)?);
            Ok(())
        })();
        match __outcome {
            Ok(_) => {}
            Err(error) => {
                total = u32::wrapping_add(total, TryOps::try_ops_classify_fault((error).clone()));
            }
        }
        return total;
    }

    pub fn try_ops_region_return(count: u32) -> u32 {
        return match (|| -> Result<u32, VectorError> {
            return Ok(TryOps::try_ops_throwing_codec(count)?);
        })() {
            Ok(__value) => __value,
            Err(error) => TryOps::try_ops_classify_fault((error).clone()),
        };
    }

    pub fn try_ops_region_value(count: u32) -> u32 {
        let value: u32 = match (|| -> Result<u32, VectorError> {
            return Ok(TryOps::try_ops_throwing_codec(count)?);
        })() {
            Ok(__value1) => __value1,
            Err(error) => TryOps::try_ops_classify_fault((error).clone()),
        };
        return u32::wrapping_add(value, 1);
    }

    pub fn try_ops_handler_return(count: u32) -> u32 {
        let mut total = 0u32;
        let __outcome1: Result<(), VectorError> = (|| {
            total = u32::wrapping_add(total, TryOps::try_ops_throwing_codec(count)?);
            Ok(())
        })();
        match __outcome1 {
            Ok(_) => {}
            Err(error) => {
                return TryOps::try_ops_classify_fault((error).clone());
            }
        }
        return total;
    }

    pub fn try_ops_region_message(count: u32) -> UString {
        let text: UString = match (|| -> Result<UString, VectorError> {
            TryOps::try_ops_throwing_codec(count)?;
            return Ok(UString::from("no fault").to_ustring());
        })() {
            Ok(__value2) => __value2,
            Err(error) => UString::from(format!("{}", format!("{}", error)).as_str()),
        };
        return text;
    }

    pub fn try_ops_fault_payload(code: u32) -> u32 {
        let value: u32 = match (|| -> Result<u32, UStringFault> {
            return Err(UStringFault::InvalidCodePoint { code: code });
        })() {
            Ok(__value3) => __value3,
            Err(error) => TryOps::try_ops_classify_code((error).clone()),
        };
        return value;
    }
}
