use crate::runtime::u_string::UStr;
use crate::runtime::u_string::UString;


#[derive(Clone, PartialEq)]
pub struct DefaultArgShiftProbe {
    pub tag: UString,
}

impl DefaultArgShiftProbe {
    pub fn new(tag: Option<UString>) -> Self {
        let tag = tag.unwrap_or_else(|| UString::from("probe"));
        Self {
            tag: tag,
        }
    }

    pub fn label(&self) -> UString {
        return ((self.tag).to_ustring()).clone();
    }
}

#[derive(Clone, Copy)]
pub struct DefaultArgShiftOps;

impl DefaultArgShiftOps {
    pub fn default_arg_shift_ops_pick(a: &UStr, b: Option<UString>) -> UString {
        let b = b.unwrap_or_else(|| a.to_ustring());
        let normalized = b;
        return normalized;
    }

    pub fn default_arg_shift_ops_call_explicit_null() -> UString {
        return DefaultArgShiftOps::default_arg_shift_ops_pick(UStr::new(&[97,108,112,104,97]), None.clone());
    }

    pub fn default_arg_shift_ops_call_later_given() -> UString {
        return DefaultArgShiftOps::default_arg_shift_ops_pick(UStr::new(&[97,108,112,104,97]), Some(UString::from("beta")));
    }

    pub fn default_arg_shift_ops_chained_fallback(fallback: Option<f64>, value: Option<f64>) -> f64 {
        let fallback = fallback.unwrap_or_else(|| 2.5);
        let value = value.unwrap_or_else(|| fallback);
        let resolved_fallback = fallback;
        let resolved_value = value;
        return resolved_fallback + resolved_value;
    }

    pub fn default_arg_shift_ops_call_chained_later_null() -> f64 {
        return DefaultArgShiftOps::default_arg_shift_ops_chained_fallback(Some(4.5f64), None);
    }

    pub fn default_arg_shift_ops_call_chained_both_omitted() -> f64 {
        return DefaultArgShiftOps::default_arg_shift_ops_chained_fallback(None, None);
    }

    pub fn default_arg_shift_ops_call_chained_later_omitted() -> f64 {
        return DefaultArgShiftOps::default_arg_shift_ops_chained_fallback(Some(3.5f64), None);
    }

    pub fn default_arg_shift_ops_call_chained_both_given() -> f64 {
        return DefaultArgShiftOps::default_arg_shift_ops_chained_fallback(Some(1.5f64), Some(8.0f64));
    }

    pub fn default_arg_shift_ops_call_instance_null() -> UString {
        let probe = DefaultArgShiftInstance::new();
        return probe.decorate(UStr::new(&[99,111,114,101]), None.clone());
    }

    pub fn default_arg_shift_ops_run(base: u32, probe: Option<DefaultArgShiftProbe>, count: Option<u32>) -> UString {
        let probe = probe.unwrap_or_else(|| DefaultArgShiftProbe::new(Some(UString::from("fresh"))));
        let count = count.unwrap_or_else(|| 7);
        let normalized = probe;
        let slots = count;
        return UString::from(format!("{}", { let mut __s = UString::new(); __s += normalized.label().as_ustr(); __s += &(UString::from(":")); __s += &(UString::from((base).to_string().as_str())); __s += &(UString::from(":")); __s += &(UString::from((slots).to_string().as_str())); __s }).as_str());
    }

    pub fn default_arg_shift_ops_call_middle_null() -> UString {
        return DefaultArgShiftOps::default_arg_shift_ops_run(3, None, Some(9));
    }

    pub fn default_arg_shift_ops_call_middle_skipped() -> UString {
        return DefaultArgShiftOps::default_arg_shift_ops_run(3, Some(DefaultArgShiftProbe::new(Some(UString::from("given")))), None);
    }

    pub fn default_arg_shift_ops_ctor_explicit_null() -> f64 {
        let cut = DefaultArgShiftCut::new(2.0f64, Some(2.0f64), Some(8));
        return cut.height + format!("{}", (i32::from_ne_bytes(((cut.count) as i32).to_ne_bytes()))).parse::<f64>().unwrap_or(0.0);
    }

    pub fn default_arg_shift_ops_ctor_later_given() -> f64 {
        let cut = DefaultArgShiftCut::new(2.0f64, Some(4.5f64), Some(8));
        return cut.height;
    }
}

#[derive(Clone, PartialEq)]
pub struct DefaultArgShiftInstance {
}

impl DefaultArgShiftInstance {
    pub const fn new() -> Self {
        Self {
        }
    }

    pub fn decorate(&self, text: &UStr, suffix: Option<UString>) -> UString {
        let suffix = suffix.unwrap_or_else(|| text.to_ustring());
        let normalized = suffix;
        return normalized;
    }
}

#[derive(Clone, PartialEq)]
pub struct DefaultArgShiftCut {
    pub width: f64,
    pub height: f64,
    pub count: u32,
}

impl DefaultArgShiftCut {
    pub fn new(width: f64, height: Option<f64>, count: Option<u32>) -> Self {
        let height = height.unwrap_or_else(|| width);
        let count = count.unwrap_or_else(|| 5);
        Self {
            width,
            height: height,
            count: count,
        }
    }

    pub fn describe(&self) -> UString {
        return UString::from(format!("{}", { let mut __s = UString::new(); __s += &(crate::runtime::fp_helper::FPHelper::format_float(self.width)); __s += &(UString::from(":")); __s += &(crate::runtime::fp_helper::FPHelper::format_float(self.height)); __s += &(UString::from(":")); __s += &(UString::from((self.count).to_string().as_str())); __s }).as_str());
    }
}
