package tests

import boring.runtime.test.Test

class EarlyReturnTests {
@boring.test.Test
    fun conditionalReturn() {
        Test.run("tests.EarlyReturnTests.conditionalReturn", "tests.EarlyReturnTests.conditionalReturn: conditional early return exits the test body") {
                val shouldStop = true
                if ((shouldStop)) {
                    return@run
                }
                Test.fail("unreachable assertion")
        }
    }

@boring.test.Test
    fun fallThrough() {
        Test.run("tests.EarlyReturnTests.fallThrough", "tests.EarlyReturnTests.fallThrough: fall-through path continues after the conditional") {
                val shouldStop = false
                if ((shouldStop)) {
                    return@run
                }
                Test.ok(true, null)
        }
    }
}
