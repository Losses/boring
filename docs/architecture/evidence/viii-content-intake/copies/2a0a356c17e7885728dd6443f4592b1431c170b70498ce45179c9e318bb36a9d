#![cfg(test)]

use crate::registry::core::Core;
use crate::registry::core::InputRecord;
use crate::registry::core::OutputFile;
use crate::registry::core::RegistryConfig;
use crate::runtime::test as testlib;
use crate::runtime::test_core;
use crate::runtime::u_string::UStr;
use crate::runtime::u_string::UString;


#[test]
fn generates_files() {
    testlib::run("tests.RegistryPipelineTests.generatesFiles", "tests.RegistryPipelineTests.generatesFiles: pipeline generates literal registry files", || {
        let records = vec![
    (InputRecord { path: UString::from("alice/one/README.md").to_ustring(), content: UString::from(concat!("One package\n",
"")).to_ustring(), input_record: 1 }).clone(),
    (InputRecord { path: UString::from("alice/one/1.0.0/npm/metadata.json").to_ustring(), content: UString::from("{\"name\":\"one\",\"version\":\"1.0.0\",\"url\":\"https://example.test/one.tgz\",\"sha512\":\"digest\"}").to_ustring(), input_record: 1 }).clone(),
    (InputRecord { path: UString::from("bob/two/README.md").to_ustring(), content: UString::from(concat!("Two package\n",
"")).to_ustring(), input_record: 1 }).clone(),
    (InputRecord { path: UString::from("bob/two/2.0.0/cargo/metadata.json").to_ustring(), content: UString::from("{\"name\":\"two\",\"version\":\"2.0.0\",\"url\":\"https://example.test/two.crate\",\"sha256\":\"checksum\"}").to_ustring(), input_record: 1 }).clone(),
];
        let config = RegistryConfig { tree: UString::from("tree").to_ustring(), output: UString::from("site").to_ustring(), base_url: UString::from("https://registry.test").to_ustring(), swift_scope: UString::from("scope").to_ustring(),
archive_base: UString::from("https://archive.test").to_ustring(), config_record: 1 };
        let files = Core::core_generate(&records, (config).clone()).unwrap();
        let expected = vec![
    (OutputFile { path: UString::from("npm/one").to_ustring(), content: UString::from(concat!("{\n",
"  \"name\": \"one\",\n",
"  \"dist-tags\": {\n",
"    \"latest\": \"1.0.0\"\n",
"  },\n",
"  \"versions\": {\n",
"    \"1.0.0\": {\n",
"      \"name\": \"one\",\n",
"      \"version\": \"1.0.0\",\n",
"      \"dist\": {\n",
"        \"tarball\": \"https://example.test/one.tgz\",\n",
"        \"integrity\": \"sha512-digest\"\n",
"      }\n",
"    }\n",
"  },\n",
"  \"readme\": \"One package\\n\"\n",
"}\n",
"")).to_ustring(), output_file: 1 }).clone(),
    (OutputFile { path: UString::from("cargo/index/config.json").to_ustring(), content: UString::from(concat!("{\n",
"  \"dl\": \"https://registry.test/cargo/dl/{crate}-{version}.crate\"\n",
"}\n",
"")).to_ustring(), output_file: 1 }).clone(),
    (OutputFile { path: UString::from("cargo/index/3/t/two").to_ustring(), content: UString::from(concat!("{\"name\":\"two\",\"vers\":\"2.0.0\",\"deps\":[],\"cksum\":\"checksum\",\"features\":{},\"yanked\":false,\"v\":2}\n",
"")).to_ustring(), output_file: 1 }).clone(),
    (OutputFile { path: UString::from("swift/identifiers").to_ustring(), content: UString::from(concat!("[]\n",
"")).to_ustring(), output_file: 1 }).clone(),
    (OutputFile { path: UString::from("_headers").to_ustring(), content: UString::from(concat!("/*\n",
"  Content-Version: 1\n",
"/swift/:scope/:name\n",
"  Content-Type: application/json\n",
"/swift/:scope/:name/:version\n",
"  Content-Type: application/json\n",
"/swift/:scope/:name/:version/Package.swift\n",
"  Content-Type: text/x-swift\n",
"/pub/api/packages/*\n",
"  Content-Type: application/vnd.pub.v2+json\n",
"/swift/identifiers\n",
"  Content-Type: application/json\n",
"")).to_ustring(), output_file: 1 }).clone(),
    (OutputFile { path: UString::from("_redirects").to_ustring(), content: UString::from(concat!("/swift/:scope/:name/*.zip  https://archive.test/swift/:scope/:name/:splat.zip  303\n",
"/cargo/dl/two-:version.crate  https://github.com/bob/two/releases/download/v:version/two-:version.crate  302\n",
"")).to_ustring(), output_file: 1 }).clone(),
];
        test_core::TestCore::test_core_equals_int(i32::from_ne_bytes(((u32::try_from((expected.len()) & 0xFFFF_FFFF).unwrap_or(0)) as i32).to_ne_bytes()), i32::from_ne_bytes(((u32::try_from((files.len()) & 0xFFFF_FFFF).unwrap_or(0)) as i32).to_ne_bytes()), UStr::new(&[]));
        for i in 0..match u32::try_from(expected.len()) { Ok(value) => value, Err(_) => u32::MAX } {
            test_core::TestCore::test_core_equals_string(((expected[usize::try_from(i).unwrap_or(0)]).clone().path).to_ustring().as_ustr(), ((files[usize::try_from(i).unwrap_or(0)]).clone().path).to_ustring().as_ustr(), UStr::new(&[]));
            test_core::TestCore::test_core_equals_string(((expected[usize::try_from(i).unwrap_or(0)]).clone().content).to_ustring().as_ustr(), ((files[usize::try_from(i).unwrap_or(0)]).clone().content).to_ustring().as_ustr(), UStr::new(&[]));
        }
    });
}
