    fun mulAnchors(): Long {
        return ((-1640531535L shl 32) or (-2048144761L and 0xFFFFFFFFL)) * ((-1028477379L shl 32) or (668265295L and 0xFFFFFFFFL))
    }

    fun mulIntAnchor(value: Long): Long {
        return value * 3.toLong()
    }

    fun rotate(value: Long, distance: Int): Long {
        return ((((value) ushr ((distance) and 63))) or (((value) shl ((64 - distance) and 63))))
    }

    fun bitMix(value: Long): Long {
        val upperMask = ((-1431655766L shl 32) or (1431655765L and 0xFFFFFFFFL))
        val lowerMask = ((1431655765L shl 32) or (-1431655766L and 0xFFFFFFFFL))
        return ((((value) xor (upperMask))) or (((value) and (lowerMask))))
