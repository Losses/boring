package tests

import boring.CaptureSwitchOps
import boring.CaptureSwitchValue
import boring.NoSuchElementError
import boring.runtime.test.Test

class CaptureSwitchOpsTests {
@boring.test.Test
    fun testDescribe() {
        Test.run("tests.CaptureSwitchOpsTests.testDescribe", "tests.CaptureSwitchOpsTests.testDescribe: single captured switch forwards a return payload") {
                Test.equals("gone", CaptureSwitchOps.describe(NoSuchElementError.Message("gone")), null)
        }
    }

@boring.test.Test
    fun testInitialized() {
        Test.run("tests.CaptureSwitchOpsTests.testInitialized", "tests.CaptureSwitchOpsTests.testInitialized: single captured switch works in an initializer") {
                Test.equals("ready", CaptureSwitchOps.initialized(NoSuchElementError.Message("ready")), null)
        }
    }

@boring.test.Test
    fun testClassify() {
        Test.run("tests.CaptureSwitchOpsTests.testClassify", "tests.CaptureSwitchOpsTests.testClassify: multi-case captured switch remains available") {
                Test.equals(3, CaptureSwitchOps.classify(CaptureSwitchValue.Text("abc")), null)
                Test.equals(8, CaptureSwitchOps.classify(CaptureSwitchValue.Number(7)), null)
        }
    }

@boring.test.Test
    fun testMessageLength() {
        Test.run("tests.CaptureSwitchOpsTests.testMessageLength", "tests.CaptureSwitchOpsTests.testMessageLength: single captured payload supports an operation") {
                Test.equals(5, CaptureSwitchOps.messageLength(NoSuchElementError.Message("test")), null)
        }
    }
}
