#![cfg(test)]

use crate::boring::override_member_ops::OverrideMemberOps;
use crate::runtime::test as testlib;
use crate::runtime::test_core;
use crate::runtime::u_string::UStr;


#[test]
fn hash_member() {
    testlib::run("tests.OverrideMemberTests.hashMember", "tests.OverrideMemberTests.hashMember: a handwritten zero-argument hashCode is emitted as an Any override", || {
        test_core::TestCore::test_core_equals_int(17i32, i32::from_ne_bytes(((OverrideMemberOps::override_member_ops_hash(17)) as i32).to_ne_bytes()), UStr::new(&[]));
    });
}

#[test]
fn ordinary() {
    testlib::run("tests.OverrideMemberTests.ordinary", "tests.OverrideMemberTests.ordinary: ordinary members remain ordinary", || {
        test_core::TestCore::test_core_equals_string(UStr::new(&[111,114,100,105,110,97,114,121]), OverrideMemberOps::override_member_ops_ordinary().as_ustr(), UStr::new(&[]));
    });
}

#[test]
fn message() {
    testlib::run("tests.OverrideMemberTests.message", "tests.OverrideMemberTests.message: message payloads retain their value", || {
        test_core::TestCore::test_core_equals_string(UStr::new(&[112,97,121,108,111,97,100]), OverrideMemberOps::override_member_ops_message(UStr::new(&[112,97,121,108,111,97,100])).as_ustr(), UStr::new(&[]));
    });
}
