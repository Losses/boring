package mx;
import std.ReadOnlyArray;
import mx.MXSupport.QError;
import mx.MXSupport.QSource;
// Attack B: inline helper block at RETURN position INSIDE a lambda whose own
// contract is ReadOnlyArray<Int>; enclosing member returns Int.
class AttB {
	inline static function two(a:Array<Int>):Array<Int> {
		final s = a.length;
		return a.slice(s, 0);
	}
	public static function run(flag:Bool):Int {
		var f = function():ReadOnlyArray<Int> {
			if (flag) throw new QError();
			final h = [1, 2, 3];
			return two(h);
		}
		return QSource.view(f());
	}
}
