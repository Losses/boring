use crate::runtime::sorted_table::SortedTable;
use crate::runtime::u_string::UStr;
use crate::runtime::u_string::UString;


#[derive(Clone, Copy)]
pub struct RecordOps;

impl RecordOps {
    pub fn record_ops_make_item(id: u32, name: &UStr, score: u32, active: bool) -> ItemRecord {
        return ItemRecord { id: id, name: name.to_ustring(), score: score, active: active };
    }

    pub fn record_ops_copy_no_override(item: ItemRecord) -> ItemRecord {
        return ItemRecord { id: item.id, name: (item.name).to_ustring().clone(), score: item.score, active: item.active };
    }

    pub fn record_ops_copy_single_override(item: ItemRecord, new_score: u32) -> ItemRecord {
        return ItemRecord { id: item.id, name: (item.name).to_ustring().clone(), score: new_score, active: item.active };
    }

    pub fn record_ops_copy_reordered(item: ItemRecord, new_active: bool, new_name: &UStr) -> ItemRecord {
        return ItemRecord { id: item.id, name: new_name.to_ustring(), score: item.score, active: new_active };
    }

    pub fn record_ops_copy_multiple(item: ItemRecord, new_id: u32, new_name: &UStr, new_score: u32) -> ItemRecord {
        return ItemRecord { id: new_id, name: new_name.to_ustring(), score: new_score, active: item.active };
    }
}

#[derive(Debug, Clone, PartialEq)]
pub struct ItemRecord {
    pub id: u32,
    pub name: UString,
    pub score: u32,
    pub active: bool,
}

pub fn compare_item_record(a: &ItemRecord, b: &ItemRecord) -> i32 {
    let cmp_id = match i32::from_ne_bytes((a.id).to_ne_bytes()).cmp(&i32::from_ne_bytes((b.id).to_ne_bytes())) { core::cmp::Ordering::Less => -1, core::cmp::Ordering::Equal => 0, core::cmp::Ordering::Greater => 1 };
    if cmp_id != 0 { return cmp_id; }
    let cmp_name = SortedTable::sorted_table_compare_strings(a.name.as_ustr(), b.name.as_ustr());
    if cmp_name != 0 { return cmp_name; }
    let cmp_score = match i32::from_ne_bytes((a.score).to_ne_bytes()).cmp(&i32::from_ne_bytes((b.score).to_ne_bytes())) { core::cmp::Ordering::Less => -1, core::cmp::Ordering::Equal => 0, core::cmp::Ordering::Greater => 1 };
    if cmp_score != 0 { return cmp_score; }
    let cmp_active = if a.active < b.active { -1 } else if a.active > b.active { 1 } else { 0 };
    if cmp_active != 0 { return cmp_active; }
    0
}
