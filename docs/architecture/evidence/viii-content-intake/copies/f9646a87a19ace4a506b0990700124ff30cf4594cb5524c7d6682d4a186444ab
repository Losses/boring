package boring

data class RangeMark(val start: Int, val end: Int) {
}

fun compareRangeMark(a: RangeMark, b: RangeMark): Int {
    var cmp = 0
    cmp = a.start.compareTo(b.start)
    if (cmp != 0) return cmp
    cmp = a.end.compareTo(b.end)
    if (cmp != 0) return cmp
    return 0
}

data class SpanQuery(val range: RangeMark, val label: String) {
}

fun compareSpanQuery(a: SpanQuery, b: SpanQuery): Int {
    var cmp = 0
    cmp = boring.compareRangeMark(a.range, b.range)
    if (cmp != 0) return cmp
    cmp = a.label.compareTo(b.label)
    if (cmp != 0) return cmp
    return 0
}

object DataClassRangeEqOps {
    fun rangesEqual(): Boolean {
        val a = SpanQuery(RangeMark(1, 5), "alpha")
        val b = SpanQuery(RangeMark(1, 5), "alpha")
        val c = SpanQuery(RangeMark(1, 6), "alpha")
        val equal = a.range.start == b.range.start && a.range.end == b.range.end && a.label == b.label
        val different = a.range.start != c.range.start || a.range.end != c.range.end || a.label != c.label
        return equal && different
    }
}
