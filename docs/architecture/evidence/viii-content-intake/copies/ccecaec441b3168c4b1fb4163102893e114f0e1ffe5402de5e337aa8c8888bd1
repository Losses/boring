use crate::runtime::u_string::UStr;
use crate::runtime::u_string::UString;
use std::sync::LazyLock;


#[derive(Clone, Copy)]
pub struct StaticLazyDefaultOps;

impl StaticLazyDefaultOps {
    pub fn static_lazy_default_ops_read_default() -> SomeStruct {
        return StaticLazyDefaultOps::static_lazy_default_ops_consume((*SOME_STRUCT_DEFAULT_POLICY).clone());
    }

    pub fn static_lazy_default_ops_read_lazy_values() -> Vec<UString> {
        return ((*STATIC_LAZY_ALIAS_DEFAULT_VALUES).clone()).clone();
    }

    pub(crate) fn static_lazy_default_ops_consume(policy: SomeStruct) -> SomeStruct {
        return policy;
    }
}

pub static STATIC_LAZY_ALIAS_DEFAULT_VALUES: LazyLock<Vec<UString>> = LazyLock::new(|| vec![UString::from("default").to_ustring()]);

#[derive(Clone, Copy)]
pub struct StaticLazyAlias;

impl StaticLazyAlias {
}

pub static SOME_STRUCT_DEFAULT_POLICY: LazyLock<SomeStruct> = LazyLock::new(|| SomeStruct::new(&(UStr::new(&[100,101,102,97,117,108,116]))));

#[derive(Clone, PartialEq)]
pub struct SomeStruct {
    pub name: UString,
}

impl SomeStruct {
    pub fn new(name: &UStr) -> Self {
        Self {
            name: name.to_ustring(),
        }
    }
}
