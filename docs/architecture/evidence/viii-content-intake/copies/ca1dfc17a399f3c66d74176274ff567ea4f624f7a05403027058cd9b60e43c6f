package tests

import boring.AbstractStaticDefault
import boring.ProbeUnit
import boring.runtime.test.Test

class AbstractStaticDefaultTests {
@boring.test.Test
    fun testAbstractStaticDefault() {
        Test.run("tests.AbstractStaticDefaultTests.testAbstractStaticDefault", "tests.AbstractStaticDefaultTests.testAbstractStaticDefault: omitted optional parameter falls back to the abstract static default") {
                val d = AbstractStaticDefault(null)
                Test.equals(true, d.value == ProbeUnit.ZERO, null)
        }
    }
}
