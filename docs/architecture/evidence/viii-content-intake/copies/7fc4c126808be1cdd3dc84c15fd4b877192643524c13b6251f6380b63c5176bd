#!/usr/bin/env bash
# controls-bytefix.sh -- positive/negative controls for the byte-view fix.
#
#   OLD=<original checker>  NEW=<patched checker>  bash controls-bytefix.sh
#
# Builds every control as a `cp -a` copy of one untouched, currently-passing
# attempt, then runs BOTH checkers on each and prints old-rc / new-rc.
# Exit codes are read directly (never through a pipe). Nothing here touches
# the real attempts: all mutation happens under $W/copy/.
set -u
W=${W:-/home/losses/Development/tq-workspace/out/integrity-bytefix-work}
SRC=${SRC:-/home/losses/Development/tq-workspace/boring-wt-architecture/out/integration-a3-evidence/exclusive-runner}
OLD=${OLD:-$W/check-log-integrity.orig.sh}
NEW=${NEW:-$SRC/check-log-integrity.sh}
BASE=${BASE:-attempt-20260929T180809-2918225}   # passing attempt, harness.log 2622 B
C="$W/copy"
EV=${EV:-$W/evidence}
mkdir -p "$EV"

rm -rf "$C/att-clean"
cp -a "$SRC/$BASE" "$C/att-clean"
printf '%s\n' "$BASE" > "$EV/base-attempt.txt"

mk() { rm -rf "$C/$1"; cp -a "$C/att-clean" "$C/$1"; }
BIG="$C/att-clean/stages/step-2320672395.stdout"   # 242015 B
ST1="$C/att-clean/stages/step-737716045.status"    # the one stage that is "1"
ERR="$C/att-clean/stages/step-2119220958.stderr"   # 0 B

mk pos      # positive control: untouched copy
mk negA     # append bytes WITHOUT a trailing newline  (the blind spot)
mk negB1    # append bytes WITH a trailing newline
mk negB2    # flip one byte inside a sealed .stdout
mk negB3    # flip a .status from 1 to 0
mk negB4    # delete a sealed .stderr

printf 'TAMPERED-NO-NEWLINE'      >> "$C/negA/harness.log"
printf 'TAMPERED-WITH-NEWLINE\n'  >> "$C/negB1/harness.log"
python3 - "$C/negB2/stages/step-2320672395.stdout" <<'PY'
import sys
p = sys.argv[1]
b = bytearray(open(p, 'rb').read())
i = len(b) // 2
b[i] ^= 0x01                      # same length, one byte differs
open(p, 'wb').write(bytes(b))
PY
printf '0\n' > "$C/negB3/stages/$(basename "$ST1")"
rm -f "$C/negB4/stages/$(basename "$ERR")"

{
  printf 'base attempt          : %s\n' "$BASE"
  printf 'base harness.log bytes: %s\n' "$(wc -c < "$C/att-clean/harness.log")"
  printf 'negB2 mutated file    : %s\n' "$(basename "$BIG")"
  printf 'negB3 flipped         : %s 1 -> 0\n' "$(basename "$ST1")"
  printf 'negB4 deleted         : %s\n' "$(basename "$ERR")"
} > "$EV/controls.env.txt"

printf '%-6s %-4s %-4s %-9s %s\n' CTL OLD NEW LOG_BYTES VERDICT > "$EV/controls.tsv"
: > "$EV/controls.detail.txt"
for c in pos negA negB1 negB2 negB3 negB4; do
  ob=$(bash "$OLD" "$C/$c" 2>&1); orc=$?
  nb=$(bash "$NEW" "$C/$c" 2>&1); nrc=$?
  nbytes=$(wc -c < "$C/$c/harness.log")
  printf '%-6s %-4s %-4s %-9s %s\n' "$c" "$orc" "$nrc" "$nbytes" "$(printf '%s' "$nb" | head -1)" >> "$EV/controls.tsv"
  {
    printf '===== %s (harness.log %s bytes)\n' "$c" "$nbytes"
    printf -- '-- OLD rc=%s\n%s\n' "$orc" "$ob"
    printf -- '-- NEW rc=%s\n%s\n' "$nrc" "$nb"
  } >> "$EV/controls.detail.txt"
done
cat "$EV/controls.tsv"
