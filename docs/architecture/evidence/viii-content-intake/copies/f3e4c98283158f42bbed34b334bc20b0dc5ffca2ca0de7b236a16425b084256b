#![cfg(test)]

use crate::boring::number_classify_ops::NumberClassifyOps;
use crate::runtime::test as testlib;
use crate::runtime::test_core;
use crate::runtime::u_string::UStr;


#[test]
fn finite_classification() {
    testlib::run("tests.NumberClassifyTests.finiteClassification", "tests.NumberClassifyTests.finiteClassification: isFinite accepts finite values and rejects NaN and infinities", || {
        test_core::TestCore::test_core_equals_bool(true, NumberClassifyOps::number_classify_ops_finite(0.0f32), UStr::new(&[]));
        test_core::TestCore::test_core_equals_bool(true, NumberClassifyOps::number_classify_ops_finite(-1.5f32), UStr::new(&[]));
        test_core::TestCore::test_core_equals_bool(true, NumberClassifyOps::number_classify_ops_finite(3.0e38f32), UStr::new(&[]));
        test_core::TestCore::test_core_equals_bool(false, NumberClassifyOps::number_classify_ops_finite(f32::NAN), UStr::new(&[]));
        test_core::TestCore::test_core_equals_bool(false, NumberClassifyOps::number_classify_ops_finite(f32::INFINITY), UStr::new(&[]));
        test_core::TestCore::test_core_equals_bool(false, NumberClassifyOps::number_classify_ops_finite(f32::NEG_INFINITY), UStr::new(&[]));
    });
}

#[test]
fn nan_classification() {
    testlib::run("tests.NumberClassifyTests.nanClassification", "tests.NumberClassifyTests.nanClassification: isNaN accepts NaN and rejects finite values and infinities", || {
        test_core::TestCore::test_core_equals_bool(true, NumberClassifyOps::number_classify_ops_nan(f32::NAN), UStr::new(&[]));
        test_core::TestCore::test_core_equals_bool(false, NumberClassifyOps::number_classify_ops_nan(0.0f32), UStr::new(&[]));
        test_core::TestCore::test_core_equals_bool(false, NumberClassifyOps::number_classify_ops_nan(-1.5f32), UStr::new(&[]));
        test_core::TestCore::test_core_equals_bool(false, NumberClassifyOps::number_classify_ops_nan(f32::INFINITY), UStr::new(&[]));
        test_core::TestCore::test_core_equals_bool(false, NumberClassifyOps::number_classify_ops_nan(f32::NEG_INFINITY), UStr::new(&[]));
    });
}
