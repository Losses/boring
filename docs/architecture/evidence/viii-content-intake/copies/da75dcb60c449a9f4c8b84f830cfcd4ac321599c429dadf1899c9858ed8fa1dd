#!/usr/bin/env python3
"""Extract the UNIQUE failing-test-name set from a `bun test` log.

bun prints every failure twice (once inline, once in the trailing failure
list), so counting `(fail)` lines over-counts by ~2x. This script counts
unique names only.
"""
import re
import sys
from collections import Counter

TIME = re.compile(r"\s*\[\d+(?:\.\d+)?ms\]\s*$")


def parse(path: str):
    names = Counter()
    errors = 0
    summary = []
    for line in open(path, encoding="utf-8", errors="replace"):
        line = line.rstrip("\n")
        if line.startswith("(fail) "):
            names[TIME.sub("", line[len("(fail) "):])] += 1
        if line.strip() == "# Unhandled error between tests":
            errors += 1
        if re.match(r"^\s*\d+ (pass|fail|errors?)\s*$", line) or line.startswith("Ran ") \
                or line.startswith("error: script"):
            summary.append(line.strip())
    return names, errors, summary


def main() -> int:
    path = sys.argv[1]
    names, errors, summary = parse(path)
    out = sys.argv[2] if len(sys.argv) > 2 else None
    text = []
    text.append(f"log: {path}")
    text.append(f"unique failing test names: {len(names)}")
    text.append(f"raw (fail) lines: {sum(names.values())}  (2x trap: unique != raw)")
    text.append(f"unhandled-error blocks: {errors}")
    text.append("summary lines:")
    text.extend("  " + s for s in summary)
    text.append("")
    text.append("=== unique failing test names (sorted) ===")
    text.extend(sorted(names))
    text.append("")
    text.append("=== occurrence counts (a value of 2 is bun's duplicate print) ===")
    for name, count in sorted(names.items()):
        text.append(f"  {count}  {name}")
    blob = "\n".join(text) + "\n"
    if out:
        open(out, "w", encoding="utf-8").write(blob)
    print(blob)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
