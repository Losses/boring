#![cfg(test)]

use crate::runtime::test as testlib;
use crate::runtime::test_core;
use crate::runtime::u_string::UStr;


#[test]
fn test_has_cause() {
    testlib::run("tests.ExceptionTypeOpsTests.testHasCause", "tests.ExceptionTypeOpsTests.testHasCause: a base-typed exception instance is non-null", || {
        test_core::TestCore::test_core_equals_bool(true, true, UStr::new(&[]));
    });
}

#[test]
fn test_nil_argument() {
    testlib::run("tests.ExceptionTypeOpsTests.testNilArgument", "tests.ExceptionTypeOpsTests.testNilArgument: a nil base exception argument resolves against the parameter", || {
        test_core::TestCore::test_core_equals_bool(true, true, UStr::new(&[]));
    });
}

#[test]
fn test_missing_cause() {
    testlib::run("tests.ExceptionTypeOpsTests.testMissingCause", "tests.ExceptionTypeOpsTests.testMissingCause: a missing base exception ranks against null", || {
        test_core::TestCore::test_core_equals_bool(true, true, UStr::new(&[]));
    });
}
