#!/usr/bin/env python3
"""Emit the markdown body of REPORT.md section 6 from the raw before/after transcripts."""
import json, re, os, sys
from collections import Counter

E = "/home/losses/Development/tq-workspace/dc-warn/out/test-timeout-budget"
BEFORE = f"{E}/runs/before"
AFTER = f"{E}/runs/after"

fail_re = re.compile(r"^\(fail\) (.+?)(?: \[([0-9.]+)ms\])?$")
pass_re = re.compile(r"^\(pass\) (.+?)(?: \[([0-9.]+)ms\])?$")
to_re = re.compile(r"^  \^ this test timed out after (\d+)ms\.")
ran_re = re.compile(r"^Ran (\d+) tests across (\d+) files\. \[([0-9.]+)s\]")
stat_re = re.compile(r"^\s*(\d+) (pass|fail|errors?)$")

def parse(d):
    p = os.path.join(d, "stdout.txt")
    lines = open(p, encoding="utf-8", errors="replace").read().split("\n")
    sum_start = next((i for i, l in enumerate(lines) if re.match(r"^\d+ tests failed:$", l)), None)
    fails, passes, stats = {}, {}, {}
    for i, l in enumerate(lines):
        sec = "summary" if (sum_start is not None and i > sum_start) else "live"
        m = fail_re.match(l)
        if m:
            t = to_re.match(lines[i+1]) if i+1 < len(lines) else None
            r = fails.setdefault(m.group(1), {"timeout": False, "elapsed": None, "budget": None})
            if m.group(2) and r["elapsed"] is None: r["elapsed"] = float(m.group(2))
            if t: r["timeout"] = True; r["budget"] = int(t.group(1))
            continue
        m = pass_re.match(l)
        if m and sec == "live" and m.group(2):
            passes.setdefault(m.group(1), float(m.group(2)))
        m = ran_re.match(l)
        if m: stats.update(ran_tests=int(m.group(1)), ran_files=int(m.group(2)), wall_s=float(m.group(3)))
        m = stat_re.match(l)
        if m: stats[m.group(2)] = int(m.group(1))
    env = {}
    for line in open(os.path.join(d, "env.txt"), encoding="utf-8", errors="replace"):
        if "=" in line:
            k, v = line.rstrip("\n").split("=", 1)
            if k in ("tree", "utc_start", "utc_end", "load_start", "load_end", "rc", "wall_seconds"):
                env[k] = v
    return dict(fails=fails, passes=passes, stats=stats, env=env)

b, a = parse(BEFORE), parse(AFTER)
B, A = set(b["fails"]), set(a["fails"])
tset = {t["name"]: t for t in json.load(open(f"{E}/evidence/timeout-set.json"))}
fixed = set(tset)

def cls(d, n):
    return "timeout" if d["fails"][n]["timeout"] else "assert"

print("### 6.1 Raw runs\n")
print("| | before (`runs/before`) | after (`runs/after`) |")
print("|---|---|---|")
for label, key in [("tree", "tree"), ("utc start", "utc_start"), ("utc end", "utc_end"),
                   ("wall (s, self-reported)", "wall_seconds"), ("load at start", "load_start"),
                   ("load at end", "load_end"), ("exit code", "rc")]:
    print(f"| {label} | {b['env'].get(key,'?')} | {a['env'].get(key,'?')} |")
for label, key in [("pass", "pass"), ("fail", "failro"), ("Ran tests", "ran_tests"), ("files", "ran_files")]:
    pass
print(f"| pass | {b['stats'].get('pass','?')} | {a['stats'].get('pass','?')} |")
print(f"| fail | {b['stats'].get('fail','?')} | {a['stats'].get('fail','?')} |")
print(f"| errors | {b['stats'].get('errors','?')} | {a['stats'].get('errors','?')} |")
print(f"| `Ran ... [s]` | {b['stats'].get('wall_s','?')} | {a['stats'].get('wall_s','?')} |")
print(f"| unique failing names | **{len(B)}** | **{len(A)}** |")
print(f"|   of which timed out | {sum(1 for n in B if b['fails'][n]['timeout'])} | {sum(1 for n in A if a['fails'][n]['timeout'])} |")
print()
print("### 6.2 Unique-failing-name set difference\n")
print("| set | count |")
print("|---|---|")
print(f"| only in BEFORE (cleared) | {len(B-A)} |")
print(f"| only in AFTER (new) | {len(A-B)} |")
print(f"| in both | {len(A&B)} |")
print()
if B - A:
    print("**Cleared** (present before, absent after):\n")
    for n in sorted(B - A):
        el = a["passes"].get(n)
        print(f"- `{n}` — before: {cls(b,n)} at {b['fails'][n]['elapsed']} ms; after: **pass** at {el} ms")
    print()
else:
    print("**Cleared: none.**\n")
if A - B:
    print("**New** (absent before, present after):\n")
    for n in sorted(A - B):
        print(f"- `{n}` — after: {cls(a,n)} at {a['fails'][n]['elapsed']} ms")
    print()
else:
    print("**New: none.**\n")
print("### 6.3 The 24 budget-changed tests, one by one\n")
print("| # | test | before | after |")
print("|---|---|---|---|")
still_t, still_a, passed = [], [], []
for i, n in enumerate(sorted(fixed), 1):
    if n not in a["fails"] and n in a["passes"]:
        verdict = f"**pass** at {a['passes'][n]} ms"; passed.append((n, a["passes"][n]))
    elif n in a["fails"]:
        if a["fails"][n]["timeout"]:
            verdict = f"still timed out at {a['fails'][n]['elapsed']} ms"; still_t.append(n)
        else:
            verdict = f"**assert failure** at {a['fails'][n]['elapsed']} ms"; still_a.append(n)
    else:
        verdict = "NOT SEEN in the after transcript"; still_t.append(n)
    print(f"| {i} | `{n}` | {cls(b,n)} at {b['fails'][n]['elapsed']} ms | {verdict} |")
print()
print(f"- passed after the budget change: **{len(passed)}**")
print(f"- still timed out: **{len(still_t)}** {still_t if still_t else ''}")
print(f"- now failing on an assertion instead: **{len(still_a)}** {still_a if still_a else ''}")
print()
print("### 6.4 Remaining failures after the change\n")
rem = sorted(A)
print(f"{len(rem)} unique failing names remain. Classes: "
      f"{sum(1 for n in rem if a['fails'][n]['timeout'])} timeout, "
      f"{sum(1 for n in rem if not a['fails'][n]['timeout'])} assertion.\n")
print("| # | remaining failure | class |")
print("|---|---|---|")
for i, n in enumerate(rem, 1):
    print(f"| {i} | `{n}` | {cls(a,n)} |")
