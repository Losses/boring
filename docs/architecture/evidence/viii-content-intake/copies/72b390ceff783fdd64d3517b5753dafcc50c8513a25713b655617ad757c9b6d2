#[test]
fn test_code_point_names_lookup() {
    testlib::run("tests.SortedTableTests.testCodePointNamesLookup", "tests.SortedTableTests.testCodePointNamesLookup: CodePointNames lookup hits and misses", || {
        assert_equals_opt_string(&Some(UString::from("LINE FEED")), &CodePointNames::code_point_names_name_of(10), UStr::new(&[76,70,32,104,105,116]));
        assert_equals_opt_string(&Some(UString::from("SPACE")), &CodePointNames::code_point_names_name_of(32), UStr::new(&[83,112,97,99,101,32,104,105,116]));
        assert_equals_opt_string(&Some(UString::from("DIGIT ZERO")), &CodePointNames::code_point_names_name_of(48), UStr::new(&[68,105,103,105,116,32,48,32,104,105,116]));
        assert_equals_opt_string(&Some(UString::from("LATIN CAPITAL LETTER A")), &CodePointNames::code_point_names_name_of(65), UStr::new(&[76,101,116,116,101,114,32,65,32,104,105,116]));
        assert_equals_opt_string(&Some(UString::from("LATIN CAPITAL LETTER B")), &CodePointNames::code_point_names_name_of(66), UStr::new(&[76,101,116,116,101,114,32,66,32,104,105,116]));
        assert_equals_opt_string(&None::<UString>, &CodePointNames::code_point_names_name_of(0), UStr::new(&[78,117,108,108,32,99,104,97,114,97,99,116,101,114,32,109,105,115,115]));
        assert_equals_opt_string(&None::<UString>, &CodePointNames::code_point_names_name_of(39321), UStr::new(&[85,110,109,97,112,112,101,100,32,99,111,100,101,32,112,111,105,110,116,32,109,105,115,115]));
    });
}

#[test]
fn test_code_point_names_order() {
    testlib::run("tests.SortedTableTests.testCodePointNamesOrder", "tests.SortedTableTests.testCodePointNamesOrder: CodePointNames ascending traversal order", || {
        let expected = UString::from("10=LINE FEED; 32=SPACE; 48=DIGIT ZERO; 65=LATIN CAPITAL LETTER A; 66=LATIN CAPITAL LETTER B").to_ustring();
        test_core::TestCore::test_core_equals_string(expected.as_ustr(), CodePointNames::code_point_names_describe_order().as_ustr(), UStr::new(&[97,115,99,101,110,100,105,110,103,32,116,114,97,118,101,114,115,97,108,32,109,97,116,99,104,101,115,32,101,120,112,101,99,116,101,100,32,111,114,100,101,114]));
    });
}

#[test]
fn test_map_duplicate_keys() {
    testlib::run("tests.SortedTableTests.testMapDuplicateKeys", "tests.SortedTableTests.testMapDuplicateKeys: SortedMap duplicate key last-put-wins semantics", || {
        let mut b: SortedMapTableBuilder<u32, UString> = SortedTable::sorted_table_map_builder::<u32, UString>(Arc::new(|a, b| SortedTable::sorted_table_compare_ints(i32::from_ne_bytes(((*a) as i32).to_ne_bytes()), i32::from_ne_bytes(((*b) as i32).to_ne_bytes()))));
        b.put(&(100), &(UString::from("hundred-first")).to_ustring());
        b.put(&(50), &(UString::from("fifty")).to_ustring());
        b.put(&(100), &(UString::from("hundred-final")).to_ustring());
        b.put(&(20), &(UString::from("twenty")).to_ustring());
        b.put(&(50), &(UString::from("fifty-final")).to_ustring());
        let map: SortedMapTable<u32, UString> = b.clone().build();
        test_core::TestCore::test_core_equals_int(3i32, i32::from_ne_bytes(((u32::from_ne_bytes(((map.size()) as u32).to_ne_bytes())) as i32).to_ne_bytes()), UStr::new(&[115,105,122,101,32,97,102,116,101,114,32,100,117,112,108,105,99,97,116,101,32,114,101,112,108,97,99,101,109,101,110,116,115]));
        assert_equals_opt_string(&Some(UString::from("twenty")), &map.get(&(20)), UStr::new(&[107,101,121,32,50,48,32,118,97,108,117,101]));
        assert_equals_opt_string(&Some(UString::from("fifty-final")), &map.get(&(50)), UStr::new(&[107,101,121,32,53,48,32,114,101,112,108,97,99,101,100,32,118,97,108,117,101]));
        assert_equals_opt_string(&Some(UString::from("hundred-final")), &map.get(&(100)), UStr::new(&[107,101,121,32,49,48,48,32,114,101,112,108,97,99,101,100,32,118,97,108,117,101]));
        assert_equals_opt_string(&None::<UString>, &map.get(&(99)), UStr::new(&[117,110,109,97,112,112,101,100,32,107,101,121,32,114,101,116,117,114,110,115,32,110,117,108,108]));
        test_core::TestCore::test_core_equals_bool(true, map.has(&(20)), UStr::new(&[104,97,115,32,50,48]));
        test_core::TestCore::test_core_equals_bool(true, map.has(&(50)), UStr::new(&[104,97,115,32,53,48]));
        test_core::TestCore::test_core_equals_bool(true, map.has(&(100)), UStr::new(&[104,97,115,32,49,48,48]));
        test_core::TestCore::test_core_equals_bool(false, map.has(&(10)), UStr::new(&[104,97,115,32,49,48,32,105,115,32,102,97,108,115,101]));
        test_core::TestCore::test_core_equals_int(20i32, i32::from_ne_bytes(((map.key_at(0i32)) as i32).to_ne_bytes()), UStr::new(&[107,101,121,32,97,116,32,48]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[116,119,101,110,116,121]), map.value_at(0i32).as_ustr(), UStr::new(&[118,97,108,117,101,32,97,116,32,48]));
        test_core::TestCore::test_core_equals_int(50i32, i32::from_ne_bytes(((map.key_at(1i32)) as i32).to_ne_bytes()), UStr::new(&[107,101,121,32,97,116,32,49]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[102,105,102,116,121,45,102,105,110,97,108]), map.value_at(1i32).as_ustr(), UStr::new(&[118,97,108,117,101,32,97,116,32,49]));
        test_core::TestCore::test_core_equals_int(100i32, i32::from_ne_bytes(((map.key_at(2i32)) as i32).to_ne_bytes()), UStr::new(&[107,101,121,32,97,116,32,50]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[104,117,110,100,114,101,100,45,102,105,110,97,108]), map.value_at(2i32).as_ustr(), UStr::new(&[118,97,108,117,101,32,97,116,32,50]));
    });
}

#[test]
fn test_empty_map() {
    testlib::run("tests.SortedTableTests.testEmptyMap", "tests.SortedTableTests.testEmptyMap: SortedMap empty builder produces empty map", || {
        let b: SortedMapTableBuilder<u32, UString> = SortedTable::sorted_table_map_builder::<u32, UString>(Arc::new(|a, b| SortedTable::sorted_table_compare_ints(i32::from_ne_bytes(((*a) as i32).to_ne_bytes()), i32::from_ne_bytes(((*b) as i32).to_ne_bytes()))));
        let map: SortedMapTable<u32, UString> = b.clone().build();
        test_core::TestCore::test_core_equals_int(0i32, i32::from_ne_bytes(((u32::from_ne_bytes(((map.size()) as u32).to_ne_bytes())) as i32).to_ne_bytes()), UStr::new(&[101,109,112,116,121,32,109,97,112,32,115,105,122,101,32,105,115,32,48]));
        test_core::TestCore::test_core_equals_bool(false, map.has(&(1)), UStr::new(&[101,109,112,116,121,32,109,97,112,32,104,97,115,32,114,101,116,117,114,110,115,32,102,97,108,115,101]));
        assert_equals_opt_string(&None::<UString>, &map.get(&(1)), UStr::new(&[101,109,112,116,121,32,109,97,112,32,103,101,116,32,114,101,116,117,114,110,115,32,110,117,108,108]));
    });
}

#[test]
fn test_sorted_set_operations() {
    testlib::run("tests.SortedTableTests.testSortedSetOperations", "tests.SortedTableTests.testSortedSetOperations: SortedSet duplicate key deduplication and ascending ordering", || {
        let mut b: SortedSetTableBuilder<u32> = SortedTable::sorted_table_set_builder::<u32>(Arc::new(|a, b| SortedTable::sorted_table_compare_ints(i32::from_ne_bytes(((*a) as i32).to_ne_bytes()), i32::from_ne_bytes(((*b) as i32).to_ne_bytes()))));
        b.put(&(300));
        b.put(&(100));
        b.put(&(300));
        b.put(&(200));
        b.put(&(100));
        let set: SortedSetTable<u32> = b.clone().build();
        test_core::TestCore::test_core_equals_int(3i32, i32::from_ne_bytes(((u32::from_ne_bytes(((set.size()) as u32).to_ne_bytes())) as i32).to_ne_bytes()), UStr::new(&[115,101,116,32,115,105,122,101,32,97,102,116,101,114,32,100,117,112,108,105,99,97,116,101,115]));
        test_core::TestCore::test_core_equals_bool(true, set.has(&(100)), UStr::new(&[104,97,115,32,49,48,48]));
        test_core::TestCore::test_core_equals_bool(true, set.has(&(200)), UStr::new(&[104,97,115,32,50,48,48]));
        test_core::TestCore::test_core_equals_bool(true, set.has(&(300)), UStr::new(&[104,97,115,32,51,48,48]));
        test_core::TestCore::test_core_equals_bool(false, set.has(&(150)), UStr::new(&[104,97,115,32,49,53,48,32,105,115,32,102,97,108,115,101]));
        test_core::TestCore::test_core_equals_bool(false, set.has(&(400)), UStr::new(&[104,97,115,32,52,48,48,32,105,115,32,102,97,108,115,101]));
        test_core::TestCore::test_core_equals_int(100i32, i32::from_ne_bytes(((set.at(0i32)) as i32).to_ne_bytes()), UStr::new(&[101,108,101,109,101,110,116,32,48]));
        test_core::TestCore::test_core_equals_int(200i32, i32::from_ne_bytes(((set.at(1i32)) as i32).to_ne_bytes()), UStr::new(&[101,108,101,109,101,110,116,32,49]));
        test_core::TestCore::test_core_equals_int(300i32, i32::from_ne_bytes(((set.at(2i32)) as i32).to_ne_bytes()), UStr::new(&[101,108,101,109,101,110,116,32,50]));
    });
}

