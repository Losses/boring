package tests

import boring.OptionalParamNull
import boring.runtime.test.Test

class OptionalParamNullTests {
@boring.test.Test
    fun testIntDefault() {
        Test.run("tests.OptionalParamNullTests.testIntDefault", "tests.OptionalParamNullTests.testIntDefault: omitted Int optional parameter falls back to its null default") {
                Test.equals(0, OptionalParamNull.intDefault(null), null)
        }
    }

@boring.test.Test
    fun testClassDefault() {
        Test.run("tests.OptionalParamNullTests.testClassDefault", "tests.OptionalParamNullTests.testClassDefault: omitted class optional parameter falls back to its null default") {
                Test.equals("default", OptionalParamNull.classDefault(null), null)
        }
    }
}
