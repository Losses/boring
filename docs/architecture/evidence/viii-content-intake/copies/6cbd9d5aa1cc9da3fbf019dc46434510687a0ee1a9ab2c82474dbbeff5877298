label: mutate-gradle
cwd: /home/losses/Development/tq-workspace/boring/dc-warn/worktrees/kotlin-manifest
argv:
  bash
  -c
  
    set -eu
    dst=/home/losses/Development/tq-workspace/dc-warn/out/kotlin-manifest/20260929T192808Z-2698141/05-mutate-gradle/copy
    mkdir -p "$dst"
    cp out/dc-kotlin-manifest-version/kotlin/gen/build.gradle.kts "$dst/build.gradle.kts"
    cp out/dc-kotlin-manifest-version/kotlin/maven/dev/boring/generated/0.1.0/generated-0.1.0.pom "$dst/generated-0.1.0.pom"
    sha256sum "$dst/build.gradle.kts" "$dst/generated-0.1.0.pom" > "$dst/before.sha256"
    line=$(grep -n "kotlin(\"jvm\") version" "$dst/build.gradle.kts" | head -n 1 | cut -d: -f1)
    [ -n "$line" ] || { echo "mutate: no kotlin(jvm) plugin line" >&2; exit 2; }
    before=$(sed -n "${line}p" "$dst/build.gradle.kts")
    # the single-sided change: only the Gradle plugin version, on its own line
    sed -i "${line}s#version \"[0-9][0-9.]*\"#version \"2.5.99\"#" "$dst/build.gradle.kts"
    after=$(sed -n "${line}p" "$dst/build.gradle.kts")
    sha256sum "$dst/build.gradle.kts" "$dst/generated-0.1.0.pom" > "$dst/after.sha256"
    diff -u "$dst/before.sha256" "$dst/after.sha256" > "$dst/mutation.diff" || true
    echo "mutated shell line $line:"
    echo "  before: $before"
    echo "  after:  $after"
    [ "$before" != "$after" ] || { echo "mutate: the version line did not change" >&2; exit 2; }
  
