#!/usr/bin/env bash
# Batch agreement: run OLD and NEW checkers over every attempt-* dir.
# Exit codes captured directly (no pipes around the checkers).
SRC=/home/losses/Development/tq-workspace/boring-wt-architecture/out/integration-a3-evidence/exclusive-runner
T=/home/losses/Development/tq-workspace/dc-warn/out/bytefix-verify/scratch
EV=/home/losses/Development/tq-workspace/dc-warn/out/bytefix-verify/evidence
OLD="$T/old.sh"
NEW="$T/new.sh"
OUT="$EV/04-batch.tsv"
: > "$OUT"
printf 'attempt_dir\told_rc\tnew_rc\told_msg\tnew_msg\n' > "$OUT"
count=0
skipped=0
for d in "$SRC"/attempt-*/; do
  d="${d%/}"
  name=$(basename "$d")
  if [ ! -d "$d" ]; then
    printf '%s\tNA\tNA\t(symlink to non-dir)\t(symlink to non-dir)\n' "$name" >> "$OUT"
    skipped=$((skipped+1))
    continue
  fi
  om=$(bash "$OLD" "$d" 2>&1); orc=$?
  nm=$(bash "$NEW" "$d" 2>&1); nrc=$?
  om1=$(printf '%s' "$om" | head -1)
  nm1=$(printf '%s' "$nm" | head -1)
  printf '%s\t%s\t%s\t%s\t%s\n' "$name" "$orc" "$nrc" "$om1" "$nm1" >> "$OUT"
  count=$((count+1))
done
{
  printf 'batch: %s dirs checked, %s skipped (non-dir)\n' "$count" "$skipped"
  printf 'agreement (old_rc == new_rc): '
  awk -F'\t' 'NR>1 && $2==$3 {a++} END {print a+0}' "$OUT"
  printf 'disagreements: '
  awk -F'\t' 'NR>1 && $2!=$3 {d++} END {print d+0}' "$OUT"
  printf 'old rc=0: '; awk -F'\t' 'NR>1 && $2==0 {c++} END {print c+0}' "$OUT"
  printf 'new rc=0: '; awk -F'\t' 'NR>1 && $3==0 {c++} END {print c+0}' "$OUT"
  printf 'old rc=1: '; awk -F'\t' 'NR>1 && $2==1 {c++} END {print c+0}' "$OUT"
  printf 'new rc=1: '; awk -F'\t' 'NR>1 && $3==1 {c++} END {print c+0}' "$OUT"
  printf 'old-pass/new-fail: '; awk -F'\t' 'NR>1 && $2==0 && $3==1 {c++} END {print c+0}' "$OUT"
  printf 'old-fail/new-pass: '; awk -F'\t' 'NR>1 && $2==1 && $3==0 {c++} END {print c+0}' "$OUT"
} > "$EV/04-batch-summary.txt"
cat "$EV/04-batch-summary.txt"
