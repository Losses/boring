use crate::boring::value_exception::ValueError;
use crate::boring::value_record::ValueRecord;
use crate::runtime::u_string::UStr;


#[derive(Clone, Copy)]
pub struct ValueRecordProbes;

impl ValueRecordProbes {
    pub fn value_record_probes_ctor_rejected(start: u32, end: u32) -> bool {
        let mut rejected = false;
        let __outcome: Result<ValueRecord, ValueError> = (|| {
            return Ok(ValueRecord::new(start, end, &(UStr::new(&[112,114,111,98,101])))?);
        })();
        match __outcome {
            Ok(_) => {}
            Err(_) => {
                rejected = true;
            }
        }
        return rejected;
    }
}
