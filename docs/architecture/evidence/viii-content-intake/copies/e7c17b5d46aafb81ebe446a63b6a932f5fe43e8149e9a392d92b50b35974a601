#!/usr/bin/env bash
# Boundary-render census over one generated Swift tree (gen + gen-tests + f32).
# Counts the text each SwiftArrayBoundary render case can produce.
set -u
R="$1"
echo "== tree: $R"
scan() { # scan <label> <fixed-string>
  local n
  n=$(grep -rF --include=*.swift -c "$2" "$R" 2>/dev/null | awk -F: '{s+=$NF} END{print s+0}')
  printf '%-46s %s\n' "$1" "$n"
}
scan 'KeepPreparedArray/PreserveNull (bare operand)'        'n/a-not-textual'
scan 'WrapMutableArrayView: ReadOnlyArray('                 'ReadOnlyArray('
scan 'MapOptionalMutableArrayView: { ReadOnlyArray($0) }'   '{ ReadOnlyArray($0) }'
scan 'ContextualReadOnlyEmpty: ReadOnlyArray<'              'ReadOnlyArray<'
scan 'BUGGY CopyReadOnly: TiqianArray(X.toMutableArray())'  '.toMutableArray())'
scan 'FIXED CopyReadOnly: bare .toMutableArray()'           '.toMutableArray()'
scan 'BUGGY MapOptional: { TiqianArray($0.toMutableArray()' '{ TiqianArray($0.toMutableArray()'
scan 'FIXED MapOptional: { $0.toMutableArray() }'           '{ $0.toMutableArray() }'
