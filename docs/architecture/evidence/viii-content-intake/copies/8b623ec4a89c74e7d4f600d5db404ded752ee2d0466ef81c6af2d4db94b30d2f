#![cfg(test)]

use crate::boring::mutating_counter_ops::MutatingCounterOps;
use crate::runtime::test as testlib;
use crate::runtime::test_core;
use crate::runtime::u_string::UStr;


#[test]
fn bump_twice() {
    testlib::run("tests.MutatingCounterTests.bumpTwice", "tests.MutatingCounterTests.bumpTwice: a mutating interface method forces the mutable receiver on the trait object", || {
        test_core::TestCore::test_core_equals_int(3i32, i32::from_ne_bytes(((MutatingCounterOps::mutating_counter_ops_bump_twice()) as i32).to_ne_bytes()), UStr::new(&[]));
    });
}

#[test]
fn read_only() {
    testlib::run("tests.MutatingCounterTests.readOnly", "tests.MutatingCounterTests.readOnly: a read-only implementation keeps the aggregated mutable trait shape", || {
        test_core::TestCore::test_core_equals_int(0i32, i32::from_ne_bytes(((MutatingCounterOps::mutating_counter_ops_read_only()) as i32).to_ne_bytes()), UStr::new(&[]));
    });
}

#[test]
fn concrete_bump() {
    testlib::run("tests.MutatingCounterTests.concreteBump", "tests.MutatingCounterTests.concreteBump: a concrete receiver accumulates through a compound field update", || {
        test_core::TestCore::test_core_equals_int(3i32, i32::from_ne_bytes(((MutatingCounterOps::mutating_counter_ops_bump_thrice_concrete()) as i32).to_ne_bytes()), UStr::new(&[]));
    });
}
