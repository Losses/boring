use crate::boring::shape_text_ops::TextShaper;
use crate::runtime::u_string::UStr;
use crate::runtime::u_string::UString;


#[derive(Clone, PartialEq)]
pub struct InkTextShaper {
}

impl InkTextShaper {
    pub const fn new() -> Self {
        Self {
        }
    }

    pub fn shape(&self, text: &UStr) -> UString {
        return UString::from(format!("{}", { let mut __s = UString::new(); __s += &(UString::from("ink:")); __s += text; __s }).as_str());
    }
}

