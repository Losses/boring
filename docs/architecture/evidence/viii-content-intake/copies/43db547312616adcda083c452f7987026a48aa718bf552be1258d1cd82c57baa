package boring

class DefaultArgShiftProbe(var tag: String = "probe") {

    fun label(): String {
        return this.tag
    }
}

object DefaultArgShiftOps {
    fun pick(a: String, b: String = a): String {
        val normalized = b
        return normalized!!
    }

    fun callExplicitNull(): String {
        return DefaultArgShiftOps.pick("alpha", "alpha")
    }

    fun callLaterGiven(): String {
        return DefaultArgShiftOps.pick("alpha", "beta")
    }

    fun chainedFallback(fallback: Double = 2.5, value: Double = fallback): Double {
        val resolvedFallback = fallback
        val resolvedValue = value
        return resolvedFallback + resolvedValue!!
    }

    fun callChainedLaterNull(): Double {
        return DefaultArgShiftOps.chainedFallback(4.5, 4.5)
    }

    fun callChainedBothOmitted(): Double {
        return DefaultArgShiftOps.chainedFallback()
    }

    fun callChainedLaterOmitted(): Double {
        return DefaultArgShiftOps.chainedFallback(3.5)
    }

    fun callChainedBothGiven(): Double {
        return DefaultArgShiftOps.chainedFallback(1.5, 8.0)
    }

    fun callInstanceNull(): String {
        val probe = DefaultArgShiftInstance()
        return probe.decorate("core", "core")
    }

    fun run(base: Int, probe: DefaultArgShiftProbe = DefaultArgShiftProbe("fresh"), count: Int = 7): String {
        val normalized = probe
        val slots = count
        return normalized.label() + ":" + base + ":" + slots
    }

    fun callMiddleNull(): String {
        return DefaultArgShiftOps.run(3, DefaultArgShiftProbe("fresh"), 9)
    }

    fun callMiddleSkipped(): String {
        return DefaultArgShiftOps.run(3, DefaultArgShiftProbe("given"))
    }

    fun ctorExplicitNull(): Double {
        val cut = DefaultArgShiftCut(2.0, 2.0, 8)
        return cut.height + (cut.count).toDouble()
    }

    fun ctorLaterGiven(): Double {
        val cut = DefaultArgShiftCut(2.0, 4.5, 8)
        return cut.height
    }
}

class DefaultArgShiftInstance {
    fun decorate(text: String, suffix: String = text): String {
        val normalized = suffix
        return normalized!!
    }
}

class DefaultArgShiftCut(val width: Double, val height: Double = width, val count: Int = 5) {

    fun describe(): String {
        return (this.width).toString() + ":" + this.height + ":" + this.count
    }
}
