#![cfg(test)]

use crate::boring::payload_self_map_ops::PayloadSelfMapException;
use crate::runtime::test as testlib;
use crate::runtime::test_core;
use crate::runtime::u_string::UStr;


#[test]
fn self_mapped_payload() {
    testlib::run("tests.PayloadSelfMapOpsTests.selfMappedPayload", "tests.PayloadSelfMapOpsTests.selfMappedPayload: keeps a payload enum and exception declared in one module", || {
        let error = PayloadSelfMapException::payload_self_map_exception_make();
        test_core::TestCore::test_core_equals_string(UStr::new(&[112,97,121,108,111,97,100,32,115,101,108,102,45,109,97,112]), (error.message).to_ustring().as_ustr(), UStr::new(&[]));
    });
}
