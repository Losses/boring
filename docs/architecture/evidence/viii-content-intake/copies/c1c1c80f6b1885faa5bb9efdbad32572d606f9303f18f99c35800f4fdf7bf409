use crate::runtime::fs::Fs;
use crate::runtime::u_string::UStr;
use crate::runtime::u_string::UString;


#[derive(Clone, Copy)]
pub struct NodeFsBorrowOps;

impl NodeFsBorrowOps {
    pub fn node_fs_borrow_ops_write_probe(name: &UStr, text: &UStr) -> UString {
        let directory = UString::from("target/boring-node-fs-probe").to_ustring();
        Fs::make_dirs(directory.as_ustr());
        Fs::write_text((UString::from(format!("{}", { let mut __s = UString::new(); __s += directory.as_ustr(); __s += &(UString::from("/")); __s += name; __s += &(UString::from(".txt")); __s }).as_str())).as_ustr(), text);
        return directory;
    }
}

#[derive(Debug, Clone, Copy, PartialEq)]
pub struct NodeFsMkdirOptions {
    pub recursive: bool,
}

pub fn compare_node_fs_mkdir_options(a: &NodeFsMkdirOptions, b: &NodeFsMkdirOptions) -> i32 {
    let cmp_recursive = if a.recursive < b.recursive { -1 } else if a.recursive > b.recursive { 1 } else { 0 };
    if cmp_recursive != 0 { return cmp_recursive; }
    0
}
