package tests

import boring.runtime.test.Test

class LocalThrowTests {
@boring.test.Test
    fun testLocalStep() {
        Test.run("tests.LocalThrowTests.testLocalStep", "tests.LocalThrowTests.testLocalStep: a local throwing function call carries the try marker") {
                Test.equals(true, true, null)
        }
    }

@boring.test.Test
    fun testLocalNested() {
        Test.run("tests.LocalThrowTests.testLocalNested", "tests.LocalThrowTests.testLocalNested: a local function throwing through another local function call") {
                Test.equals(true, true, null)
        }
    }

@boring.test.Test
    fun testLocalCondition() {
        Test.run("tests.LocalThrowTests.testLocalCondition", "tests.LocalThrowTests.testLocalCondition: a local call in a condition carries the try marker") {
                Test.equals(true, true, null)
        }
    }

@boring.test.Test
    fun testLocalArray() {
        Test.run("tests.LocalThrowTests.testLocalArray", "tests.LocalThrowTests.testLocalArray: a local call inside an array literal carries the try marker") {
                Test.equals(true, true, null)
        }
    }

@boring.test.Test
    fun testCaughtLocal() {
        Test.run("tests.LocalThrowTests.testCaughtLocal", "tests.LocalThrowTests.testCaughtLocal: the local fault is caught by the caller") {
                Test.equals(true, true, null)
        }
    }
}
