#![cfg(test)]

use crate::boring::int64_ops::Int64Ops;
use crate::runtime::test as testlib;
use crate::runtime::test_core;
use crate::runtime::u_string::UStr;


#[test]
fn construction() {
    testlib::run("tests.Int64Tests.construction", "tests.Int64Tests.construction: constructs and extracts 64-bit words", || {
        let value = 305419896i64 << 32 | 2596069104i64;
        test_core::TestCore::test_core_equals_int(305419896i32, i32::from_ne_bytes(((Int64Ops::int64_ops_high(value)) as i32).to_ne_bytes()), UStr::new(&[]));
        test_core::TestCore::test_core_equals_int(-1698898192i32, i32::from_ne_bytes(((Int64Ops::int64_ops_low(value)) as i32).to_ne_bytes()), UStr::new(&[]));
    });
}

#[test]
fn carry() {
    testlib::run("tests.Int64Tests.carry", "tests.Int64Tests.carry: wraps addition across the low word", || {
        let value = Int64Ops::int64_ops_carry();
        test_core::TestCore::test_core_equals_int(1i32, i32::from_ne_bytes(((Int64Ops::int64_ops_high(value)) as i32).to_ne_bytes()), UStr::new(&[]));
        test_core::TestCore::test_core_equals_int(0i32, i32::from_ne_bytes(((Int64Ops::int64_ops_low(value)) as i32).to_ne_bytes()), UStr::new(&[]));
    });
}

#[test]
fn multiplication() {
    testlib::run("tests.Int64Tests.multiplication", "tests.Int64Tests.multiplication: wraps Int64 multiplication", || {
        let value = Int64Ops::int64_ops_mul_anchors();
        test_core::TestCore::test_core_equals_int(-554476799i32, i32::from_ne_bytes(((Int64Ops::int64_ops_high(value)) as i32).to_ne_bytes()), UStr::new(&[]));
        test_core::TestCore::test_core_equals_int(259615913i32, i32::from_ne_bytes(((Int64Ops::int64_ops_low(value)) as i32).to_ne_bytes()), UStr::new(&[]));
        let negative = (4294967295i64 << 32 | 4294967295i64).wrapping_mul(4294967295i64 << 32 | 4294967295i64);
        test_core::TestCore::test_core_equals_int(0i32, i32::from_ne_bytes(((Int64Ops::int64_ops_high(negative)) as i32).to_ne_bytes()), UStr::new(&[]));
        test_core::TestCore::test_core_equals_int(1i32, i32::from_ne_bytes(((Int64Ops::int64_ops_low(negative)) as i32).to_ne_bytes()), UStr::new(&[]));
        let mixed = Int64Ops::int64_ops_mul_int_anchor(0i64 << 32 | 5i64);
        test_core::TestCore::test_core_equals_int(0i32, i32::from_ne_bytes(((Int64Ops::int64_ops_high(mixed)) as i32).to_ne_bytes()), UStr::new(&[]));
        test_core::TestCore::test_core_equals_int(15i32, i32::from_ne_bytes(((Int64Ops::int64_ops_low(mixed)) as i32).to_ne_bytes()), UStr::new(&[]));
        let direct = (0i64 << 32 | 3i64).wrapping_mul(0i64 << 32 | 5i64);
        test_core::TestCore::test_core_equals_int(0i32, i32::from_ne_bytes(((Int64Ops::int64_ops_high(direct)) as i32).to_ne_bytes()), UStr::new(&[]));
        test_core::TestCore::test_core_equals_int(15i32, i32::from_ne_bytes(((Int64Ops::int64_ops_low(direct)) as i32).to_ne_bytes()), UStr::new(&[]));
    });
}

#[test]
fn ordering() {
    testlib::run("tests.Int64Tests.ordering", "tests.Int64Tests.ordering: compares signed Int64 values at limits and across zero", || {
        let negative = -1i64;
        let zero = 0i64;
        let equal = 7i64;
        let maximum = 2147483647i64 << 32 | 4294967295i64;
        let minimum = 2147483648i64 << 32 | 0i64;
        test_core::TestCore::test_core_equals_bool(true, Int64Ops::int64_ops_below(negative, zero), UStr::new(&[]));
        test_core::TestCore::test_core_equals_bool(true, Int64Ops::int64_ops_at_or_below(equal, equal), UStr::new(&[]));
        test_core::TestCore::test_core_equals_bool(true, equal >= equal, UStr::new(&[]));
        test_core::TestCore::test_core_equals_bool(true, Int64Ops::int64_ops_below(minimum, maximum), UStr::new(&[]));
        test_core::TestCore::test_core_equals_bool(true, maximum >= minimum, UStr::new(&[]));
        test_core::TestCore::test_core_equals_bool(true, maximum > minimum, UStr::new(&[]));
        test_core::TestCore::test_core_equals_bool(true, Int64Ops::int64_ops_below(negative, zero), UStr::new(&[]));
        test_core::TestCore::test_core_equals_bool(true, zero <= zero, UStr::new(&[]));
    });
}

#[test]
fn operations() {
    testlib::run("tests.Int64Tests.operations", "tests.Int64Tests.operations: keeps rotate and bitwise operations at 64 bits", || {
        let value = 305419896i64 << 32 | 2596069104i64;
        let rotated = Int64Ops::int64_ops_rotate(value, 32);
        test_core::TestCore::test_core_equals_int(-1698898192i32, i32::from_ne_bytes(((Int64Ops::int64_ops_high(rotated)) as i32).to_ne_bytes()), UStr::new(&[]));
        test_core::TestCore::test_core_equals_int(305419896i32, i32::from_ne_bytes(((Int64Ops::int64_ops_low(rotated)) as i32).to_ne_bytes()), UStr::new(&[]));
        let mixed = Int64Ops::int64_ops_bit_mix(value);
        test_core::TestCore::test_core_equals_int(-1197540142i32, i32::from_ne_bytes(((Int64Ops::int64_ops_high(mixed)) as i32).to_ne_bytes()), UStr::new(&[]));
        test_core::TestCore::test_core_equals_int(-806777947i32, i32::from_ne_bytes(((Int64Ops::int64_ops_low(mixed)) as i32).to_ne_bytes()), UStr::new(&[]));
    });
}
