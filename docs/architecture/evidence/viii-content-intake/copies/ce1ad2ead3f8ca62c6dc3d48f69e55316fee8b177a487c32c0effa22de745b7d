package boring

sealed class OverrideMemberException(override val message: String) : RuntimeException(message) {
    data class Payload(override val message: String) :
        OverrideMemberException(message)
}

data class OverrideMemberRecord(val value: Int) {

    override fun hashCode(): Int {
        return this.value
    }
}

fun compareOverrideMemberRecord(a: OverrideMemberRecord, b: OverrideMemberRecord): Int {
    var cmp = 0
    cmp = a.value.compareTo(b.value)
    if (cmp != 0) return cmp
    return 0
}

object OverrideMemberOps {
    fun hash(value: Int): Int {
        return value.hashCode()
    }

    fun ordinary(): String {
        return "ordinary"
    }

    fun message(value: String): String {
        return OverrideMemberException.Payload(value).message
    }
}
