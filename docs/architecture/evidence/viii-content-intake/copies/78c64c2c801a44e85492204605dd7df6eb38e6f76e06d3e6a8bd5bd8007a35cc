#!/usr/bin/env bash
# sweep.sh <tree-tag> -- regenerate the 20 pre-existing Swift drivers
set -u
export PATH="$(grep -m1 '^PATH=' /home/losses/Development/tq-workspace/dc-warn/out/chainA-fixed-rerun/evidence/env.json | cut -d= -f2-)"
TAG="$1"; TREE="/tmp/vc8/$TAG"; SW="/tmp/vc8/sweep/$TAG"
rm -rf "$SW"; mkdir -p "$SW/logs"
cd "$TREE" || exit 9
: > "$SW/summary.txt"
while read -r d; do
  [ -z "$d" ] && continue
  name=$(echo "$d" | tr '/' '_')
  o="$SW/gen/${name%.hxml}"
  mkdir -p "$o"
  haxe "$d" -D swift-output="$o/gen" -D swift-test-output="$o/tests" > "$SW/logs/$name.log" 2>&1
  rc=$?
  echo "$d rc=$rc" >> "$SW/summary.txt"
done < /tmp/vc8/drivers.txt
echo "--- $TAG summary ---"; cat "$SW/summary.txt"
