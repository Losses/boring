use crate::runtime::string_tools;
use crate::runtime::u_string::UStr;
use crate::runtime::u_string::UString;


#[derive(Clone, Copy)]
pub struct StringToolsOps;

impl StringToolsOps {
    pub fn string_tools_ops_pad_left(s: &UStr, len: u32) -> UString {
        return string_tools::StringTools::string_tools_lpad(s, UStr::new(&[48]), i32::from_ne_bytes(((len) as i32).to_ne_bytes()));
    }

    pub fn string_tools_ops_ltrim(s: &UStr) -> UString {
        return string_tools::StringTools::string_tools_ltrim(s);
    }

    pub fn string_tools_ops_rtrim(s: &UStr) -> UString {
        return string_tools::StringTools::string_tools_rtrim(s);
    }

    pub fn string_tools_ops_replace_delims(s: &UStr) -> UString {
        return string_tools::StringTools::string_tools_replace(s, UStr::new(&[59]), UStr::new(&[44]));
    }
}
