use crate::boring::glyph_cluster::GlyphCluster;
use crate::boring::glyph_cluster::compare_glyph_cluster;
use crate::runtime::u_string::UString;
use std::fmt::Write;


#[derive(Debug, Clone, PartialEq)]
pub struct GlyphClusterHolder {
    pub clusters: Vec<GlyphCluster>,
}

impl GlyphClusterHolder {
    pub fn new(clusters: Vec<GlyphCluster>) -> Self {
        Self {
            clusters,
        }
    }

    pub fn to_string(&self) -> UString {
        return UString::from(format!("{}", { let mut __s = UString::new(); __s += &(UString::from("GlyphClusterHolder(")); __s += &(UString::from("clusters=")); __s += UString::from(format!("{}", {
        let mut out = String::new();
        out.push('[');
        let n = (self.clusters).clone().len();
        let mut i = 0usize;
        while i < n {
            if i > 0 { out.push_str(", "); }
            let _ = write!(out, "{}", (self.clusters).clone()[i].to_string());
            i += 1;
        }
        out.push(']');
        out
    }).as_str()).as_ustr(); __s += &(UString::from(")")); __s }).as_str());
    }
}

pub fn compare_glyph_cluster_holder(a: &GlyphClusterHolder, b: &GlyphClusterHolder) -> i32 {
    let cmp_clusters = { let mut cmp = 0; for (av, bv) in (&a.clusters).iter().zip((&b.clusters).iter()) { cmp = compare_glyph_cluster(av, bv); if cmp != 0 { break; } } if cmp == 0 { cmp = match (&a.clusters).len().cmp(&(&b.clusters).len()) { core::cmp::Ordering::Less => -1,
core::cmp::Ordering::Equal => 0, core::cmp::Ordering::Greater => 1 }; } cmp };
    if cmp_clusters != 0 { return cmp_clusters; }
    0
}
