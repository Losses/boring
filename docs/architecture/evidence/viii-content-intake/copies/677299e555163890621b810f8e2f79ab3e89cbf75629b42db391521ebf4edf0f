package boring

object GlyphClusterReader {
    fun ranges(): List<GlyphCluster> {
        return mutableListOf<GlyphCluster>(GlyphCluster(3, 0, 4), GlyphCluster(7, 4, 8))
    }

    fun firstRange(holder: GlyphClusterHolder): Int {
        return holder.clusters[0].clusterRange
    }

    fun firstReturnedRange(): Int {
        val arr = GlyphClusterReader.ranges()
        return arr[0].clusterRange
    }

    fun firstWidth(holder: GlyphClusterHolder): Int {
        return holder.clusters[0].width
    }
}
