package boring

object WordCharacterTable {
    val RANGES = intArrayOf(
        0x30, 0x39, 0x41, 0x5a, 0x5f, 0x5f, 0x61, 0x7a,
        0xaa, 0xaa, 0xb5, 0xb5, 0xba, 0xba, 0xc0, 0xd6,
        0xd8, 0xf6, 0xf8, 0x2c1, 0x2c6, 0x2d1, 0x2e0, 0x2e4,
        0x2ec, 0x2ec, 0x2ee, 0x2ee, 0x370, 0x374, 0x376, 0x377,
        0x37a, 0x37d, 0x37f, 0x37f, 0x386, 0x386, 0x388, 0x38a,
        0x38c, 0x38c, 0x38e, 0x3a1, 0x3a3, 0x3f5, 0x3f7, 0x481,
        0x48a, 0x52f, 0x531, 0x556, 0x559, 0x559, 0x560, 0x588,
        0x58a, 0x58a, 0x591, 0x5bd, 0x5bf, 0x5bf, 0x5c1, 0x5c2,
        0x5c4, 0x5c5, 0x5c7, 0x5c7, 0x20000, 0x2001f
    )

    fun contains(codePoint: Int): Boolean {
        var low = 0
        var high = (WordCharacterTable.RANGES.toMutableList().size / 2)
        while ((low < high)) {
            val mid = ((low + high) shr (1))
            val start = WordCharacterTable.RANGES.toMutableList()[mid * 2]
            val end = WordCharacterTable.RANGES.toMutableList()[mid * 2 + 1]
            if ((codePoint < start)) {
                high = mid
            } else {
                if ((codePoint > end)) {
                    low = mid + 1
                } else {
                    return true
                }
            }
        }
        return false
    }
}
