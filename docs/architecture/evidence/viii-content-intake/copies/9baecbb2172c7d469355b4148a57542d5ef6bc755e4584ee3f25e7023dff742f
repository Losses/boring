#!/usr/bin/env bash
# gen.sh <tree-root> <probe-name>
# Writes drv-<probe>.hxml into the tree root and runs haxe with cwd = tree root.
# stdout+stderr -> $OUT/evidence/logs/gen-<treetag>-<probe>.log ; rc -> .rc
set -u
export PATH="$(grep -m1 '^PATH=' /home/losses/Development/tq-workspace/dc-warn/out/chainA-fixed-rerun/evidence/env.json | cut -d= -f2-)"
OUT=/home/losses/Development/tq-workspace/dc-warn/out/blockexpr-fix
T="$1"; P="$2"
tag="$(basename "$T")"
case "$P" in
  witness) FIXDIR=probe;  MAIN=mx.MXLambda;     GTS="mx.MXLambda.MXSource mx.MXLambda.MXError mx.MXLambda.MXChoice" ;;
  probe)   FIXDIR=probe2; MAIN=mx.MXProbe;      GTS="mx.MXSupport.QSource mx.MXSupport.QError mx.MXSupport.QChoice" ;;
  bm)      FIXDIR=probe2; MAIN=mx.MXBlockMember; GTS="mx.MXSupport.QSource mx.MXSupport.QError" ;;
  fast)    FIXDIR=probe2; MAIN=mx.MXFast;       GTS="mx.MXSupport.QSource mx.MXSupport.QError mx.MXSupport.QChoice" ;;
  stmt)    FIXDIR=probe2; MAIN=mx.MXStmt;       GTS="mx.MXSupport.QSource mx.MXSupport.QError mx.MXSupport.QChoice" ;;
  si)      FIXDIR=probe2; MAIN=mx.MXSwitchInit; GTS="mx.MXSupport.QSource mx.MXSupport.QError mx.MXSupport.QChoice" ;;
  gate)    FIXDIR=probe2; MAIN=mx.MXProbeGate;  GTS="mx.MXSupport.QSource mx.MXSupport.QError mx.MXSupport.QChoice" ;;
  block)   FIXDIR=probe3; MAIN=mx.MXBlock;      GTS="" ;;
  blockret) FIXDIR=probe2; MAIN=mx.MXBlockRet;  GTS="mx.MXSupport.QSource mx.MXSupport.QError" ;;
  blocklit) FIXDIR=probe2; MAIN=mx.MXBlockLit;  GTS="mx.MXSupport.QSource mx.MXSupport.QError" ;;
  *) echo "unknown probe $P" >&2; exit 2 ;;
esac
FD="$OUT/fixtures/$FIXDIR"
GEN="/tmp/bx/out/$tag-$P/gen"
mkdir -p "$GEN"
DRV="$T/drv-$P.hxml"
{
  echo "-lib reflaxe"
  echo "-lib boring"
  echo "-cp packages/compiler"
  echo "-cp packages/compiler/reflaxe/swift/std-shadow"
  echo "-cp packages/compiler/reflaxe/swift"
  echo "-cp samples"
  echo "-cp $FD"
  echo "--macro Intercept.run(['samples', '$FD'])"
  echo "--macro swiftcompiler.Compiler.use()"
  echo "-D swift-test-runner=native"
  echo "-D runtime-import=@boring/runtime"
  echo "-D runtime-emit=."
  echo "-D swift-output=$GEN"
  echo "$MAIN"
  for g in $GTS; do echo "--macro haxe.macro.Context.getType(\"$g\")"; done
} > "$DRV"
LOG="$OUT/evidence/logs/gen-$tag-$P.log"
( cd "$T" && haxe "drv-$P.hxml" ) > "$LOG" 2>&1
rc=$?
echo "$rc" > "$LOG.rc"
echo "gen $tag/$P rc=$rc -> $GEN"
exit 0
