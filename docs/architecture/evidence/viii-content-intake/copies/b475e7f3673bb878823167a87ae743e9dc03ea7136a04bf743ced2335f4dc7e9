use crate::runtime::graphemes;
use crate::runtime::graphemes::Graphemes;
use crate::runtime::u_string;
use crate::runtime::u_string::UStr;
use crate::runtime::u_string::UString;
use crate::std::u_string_exception::UStringFault;


#[derive(Clone, Copy)]
pub struct GraphemeOps;

impl GraphemeOps {
    pub fn grapheme_ops_grapheme_count(text: &UStr) -> u32 {
        return u32::from_ne_bytes(((Graphemes::graphemes_count(text)) as u32).to_ne_bytes());
    }

    pub fn grapheme_ops_code_point_count(text: &UStr) -> u32 {
        return u_string::count(text);
    }

    pub fn grapheme_ops_cluster_at(text: &UStr, index: u32) -> Option<UString> {
        return Graphemes::graphemes_at(text, i32::from_ne_bytes(((index) as i32).to_ne_bytes()));
    }

    pub fn grapheme_ops_cluster_slice(text: &UStr, from: u32, to: u32) -> UString {
        return Graphemes::graphemes_slice(text, i32::from_ne_bytes(((from) as i32).to_ne_bytes()), i32::from_ne_bytes(((to) as i32).to_ne_bytes()));
    }

    pub fn grapheme_ops_clamped_slice(text: &UStr) -> UString {
        return Graphemes::graphemes_slice(text, -2i32, 99i32);
    }

    pub fn grapheme_ops_part_count(text: &UStr) -> u32 {
        return u32::try_from((Graphemes::graphemes_parts(text).len()) & 0xFFFF_FFFF).unwrap_or(0);
    }

    pub fn grapheme_ops_first_part(text: &UStr) -> UString {
        return (Graphemes::graphemes_parts(text)[0usize]).clone();
    }

    pub fn grapheme_ops_last_part(text: &UStr) -> UString {
        let parts = Graphemes::graphemes_parts(text);
        return (parts[usize::try_from(u32::wrapping_sub(u32::try_from((parts.len()) & 0xFFFF_FFFF).unwrap_or(0), 1)).unwrap_or(0)]).clone();
    }

    pub fn grapheme_ops_grapheme_boundaries(text: &UStr) -> Vec<u32> {
        return graphemes::boundaries(text);
    }

    pub fn grapheme_ops_joined_parts(text: &UStr) -> Result<UString, UStringFault> {
        let parts = Graphemes::graphemes_parts(text);
        let mut buffer = Vec::<u16>::new();
        for index in 0..match u32::try_from(parts.len()) { Ok(value) => value, Err(_) => u32::MAX } {
            if let Some(&unit) = buffer.last() {
                if unit >= 55296 && unit <= 56319 && !(parts[usize::try_from(index).unwrap_or(0)]).clone().is_empty() {
                    if !match ((parts[usize::try_from(index).unwrap_or(0)]).clone()).encode_utf16().next() { Some(head) => head >= 56320 && head <= 57343, None => false } {
                        return Err(UStringFault::UnpairedSurrogate { unit: u32::from(unit) });
                    }
                }
            }
            buffer.extend((parts[usize::try_from(index).unwrap_or(0)]).clone().encode_utf16());
        }
        return Ok(UString::from_utf16(buffer.as_slice()).map_err(|_| UStringFault::UnpairedSurrogate { unit: u32::from(buffer[buffer.len() - 1]) })?);
    }
}
