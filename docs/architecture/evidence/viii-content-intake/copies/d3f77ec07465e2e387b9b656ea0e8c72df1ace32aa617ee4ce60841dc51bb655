#![cfg(test)]

use crate::boring::u_string_resident_ops::UStringResidentOps;
use crate::runtime::test as testlib;
use crate::runtime::test_core;
use crate::runtime::u_string::UStr;
use crate::tests::test_helper::*;


#[test]
fn test_resident_members() {
    testlib::run("tests.UStringResidentTests.testResidentMembers", "tests.UStringResidentTests.testResidentMembers: UString member calls resolve through the Dart runtime resident", || {
        test_core::TestCore::test_core_equals_int(6i32, i32::from_ne_bytes(((UStringResidentOps::u_string_resident_ops_count(UStr::new(&[116,105,113,105,97,110]))) as i32).to_ne_bytes()), UStr::new(&[]));
        assert_equals_opt(&Some(105), &UStringResidentOps::u_string_resident_ops_at(UStr::new(&[116,105,113,105,97,110]), 1), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[105,113]), UStringResidentOps::u_string_resident_ops_slice(UStr::new(&[116,105,113,105,97,110]), 1, 3).as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[19968]), UStringResidentOps::u_string_resident_ops_from_code_point(19968).as_ustr(), UStr::new(&[]));
    });
}
