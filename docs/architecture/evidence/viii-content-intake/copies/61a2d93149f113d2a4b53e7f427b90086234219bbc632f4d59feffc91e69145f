#!/usr/bin/env bash
set -u
export PATH="$(grep -m1 '^PATH=' /home/losses/Development/tq-workspace/dc-warn/out/chainA-fixed-rerun/evidence/env.json | cut -d= -f2-)"
TAG="$1"; NAME="$2"; FIX="$3"; MAIN="$4"; WANT="$5"; shift 5
TREE="/tmp/vc8/$TAG"; GEN="/tmp/vc8/out/$TAG-$NAME-tree/gen"; DRV="/tmp/vc8/drv/$TAG-$NAME-tree.hxml"
mkdir -p "$GEN"
{
  echo "-lib reflaxe"; echo "-lib boring"
  echo "-cp packages/compiler"; echo "-cp packages/compiler/reflaxe/swift/std-shadow"; echo "-cp packages/compiler/reflaxe/swift"
  echo "-cp samples"; echo "-cp $FIX"; echo "-cp /tmp/vc8/haxedump"
  echo "--macro Intercept.run(['samples', '$FIX'])"
  echo "--macro AuditTree.run()"
  echo "-D audittree=$WANT"
  echo "-D auditout=/tmp/vc8/logs/tree-$TAG-$NAME.txt"
  echo "--macro swiftcompiler.Compiler.use()"
  echo "-D swift-test-runner=native"; echo "-D runtime-import=@boring/runtime"; echo "-D runtime-emit=."
  echo "-D swift-output=$GEN"; echo "$MAIN"
  for g in "$@"; do echo "--macro haxe.macro.Context.getType(\"$g\")"; done
} > "$DRV"
( cd "$TREE" && haxe "$DRV" ) > "/tmp/vc8/logs/tree-$TAG-$NAME.log" 2>&1
echo "tree $TAG/$NAME rc=$? -> /tmp/vc8/logs/tree-$TAG-$NAME.txt"
