package tests

import boring.StringBufOps
import boring.runtime.test.Test

class StringBufTests {
@boring.test.Test
    fun testEmptyBuffer() {
        Test.run("tests.StringBufTests.testEmptyBuffer", "tests.StringBufTests.testEmptyBuffer: empty buffer has length zero and empty toString") {
                Test.equals("", StringBufOps.buildEmpty(), null)
                Test.equals(0, StringBufOps.measureLength(mutableListOf<String>()), null)
        }
    }

@boring.test.Test
    fun testAddStrings() {
        Test.run("tests.StringBufTests.testAddStrings", "tests.StringBufTests.testAddStrings: add appends strings and updates length") {
                val res = StringBufOps.buildParts("hello", " ", "world")
                Test.equals("hello world", res, null)
                Test.equals(11, StringBufOps.measureLength(mutableListOf<String>("hello", " ", "world")), null)
        }
    }

@boring.test.Test
    fun testSupplementaryCharacters() {
        Test.run("tests.StringBufTests.testSupplementaryCharacters", "tests.StringBufTests.testSupplementaryCharacters: add with supplementary characters counts UTF-16 code units") {
                Test.equals("hi🚀!", StringBufOps.buildSupplementary(), null)
                Test.equals(5, StringBufOps.measureSupplementaryLength(), null)
        }
    }

@boring.test.Test
    fun testAddChar() {
        Test.run("tests.StringBufTests.testAddChar", "tests.StringBufTests.testAddChar: addChar appends BMP characters") {
                val res = StringBufOps.buildWithChars("item-", 65, 66)
                Test.equals("item-AB", res, null)
        }
    }

@boring.test.Test
    fun testIncremental() {
        Test.run("tests.StringBufTests.testIncremental", "tests.StringBufTests.testIncremental: buffer extends after toString calls") {
                val steps = StringBufOps.buildIncremental()
                Test.equals("step1", steps[0], null)
                Test.equals("step1-step2", steps[1], null)
        }
    }

@boring.test.Test
    fun testCompletePair() {
        Test.run("tests.StringBufTests.testCompletePair", "tests.StringBufTests.testCompletePair: a lead completed by the immediately following addChar reads as one character") {
                Test.equals("😀", StringBufOps.completePair(55357, 56832), null)
        }
    }

@boring.test.Test
    fun testTrailWithoutLead() {
        Test.run("tests.StringBufTests.testTrailWithoutLead", "tests.StringBufTests.testTrailWithoutLead: a trail without a preceding lead faults with the argument unit") {
                Test.equals(58320, StringBufOps.caughtTrailUnit(56320), null)
        }
    }

@boring.test.Test
    fun testDanglingLead() {
        Test.run("tests.StringBufTests.testDanglingLead", "tests.StringBufTests.testDanglingLead: a dangling lead observed by toString faults with the held unit") {
                Test.equals(57296, StringBufOps.caughtDanglingUnit(55296), null)
        }
    }

@boring.test.Test
    fun testAddAfterLead() {
        Test.run("tests.StringBufTests.testAddAfterLead", "tests.StringBufTests.testAddAfterLead: an add stranding a held lead faults with the held unit") {
                Test.equals(57423, StringBufOps.caughtAddAfterLeadUnit(55423), null)
        }
    }
}
