#!/usr/bin/env bash
# Run the classifier body (extracted/derived from the workflow step) on one log,
# the way GitHub Actions runs a `run:` step: `bash -e <script>`, cwd = repo root,
# GITHUB_STEP_SUMMARY pointed at a file. Exit codes are captured directly.
set -u
SRC="${1:?usage: harness.sh <log> <label>}"
LABEL="${2:?}"
OUTDIR="$(cd "$(dirname "$0")" && pwd)"
SCRIPT="$OUTDIR/attr-body.sh"
WORK="$OUTDIR/work-$LABEL"
rm -rf "$WORK"; mkdir -p "$WORK"
export GITHUB_STEP_SUMMARY="$OUTDIR/summary-$LABEL.md"
: > "$GITHUB_STEP_SUMMARY"
LOG="$SRC"
printf '#!/usr/bin/env bash\nLOG=%q\n' "$LOG" > "$WORK/step.sh"
cat >> "$WORK/step.sh" < "$SCRIPT"
echo "===== label=$LABEL log=$SRC ====="
bash -e "$WORK/step.sh"
rc=$?
echo "----- exit=$rc -----"
