use crate::runtime::sorted_table::SortedMapTable;
use crate::runtime::sorted_table::SortedSetTable;
use crate::runtime::u_string::UStr;
use crate::runtime::u_string::UString;


#[derive(Clone, Copy)]
pub struct NarrowedSortedReceiverOps;

impl NarrowedSortedReceiverOps {
    pub fn narrowed_sorted_receiver_ops_has_key(values: Option<SortedMapTable<UString, u32>>, key: &UStr) -> bool {
        return match &(values) { Some(__option) => __option.has(&(key).to_ustring()), None => false };
    }

    pub fn narrowed_sorted_receiver_ops_size_or_zero(values: Option<SortedSetTable<u32>>) -> u32 {
        return match &(values) { Some(__option1) => u32::from_ne_bytes(((__option1.size()) as u32).to_ne_bytes()), None => 0 };
    }
}
