#![cfg(test)]

use crate::boring::string_tools_ops::StringToolsOps;
use crate::runtime::test as testlib;
use crate::runtime::test_core;
use crate::runtime::u_string::UStr;


#[test]
fn pad_left() {
    testlib::run("tests.StringToolsTests.padLeft", "tests.StringToolsTests.padLeft: lpad pads on the left through the runtime module", || {
        test_core::TestCore::test_core_equals_string(UStr::new(&[48,48,48,48,97,98]), StringToolsOps::string_tools_ops_pad_left(UStr::new(&[97,98]), 6).as_ustr(), UStr::new(&[]));
    });
}

#[test]
fn trims() {
    testlib::run("tests.StringToolsTests.trims", "tests.StringToolsTests.trims: ltrim and rtrim strip whitespace through the runtime module", || {
        test_core::TestCore::test_core_equals_string(UStr::new(&[97,98,32,32]), StringToolsOps::string_tools_ops_ltrim(UStr::new(&[32,32,97,98,32,32])).as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[32,32,97,98]), StringToolsOps::string_tools_ops_rtrim(UStr::new(&[32,32,97,98,32,32])).as_ustr(), UStr::new(&[]));
    });
}

#[test]
fn replace() {
    testlib::run("tests.StringToolsTests.replace", "tests.StringToolsTests.replace: replace swaps substrings through the runtime module", || {
        test_core::TestCore::test_core_equals_string(UStr::new(&[97,44,98,44,99]), StringToolsOps::string_tools_ops_replace_delims(UStr::new(&[97,59,98,59,99])).as_ustr(), UStr::new(&[]));
    });
}
