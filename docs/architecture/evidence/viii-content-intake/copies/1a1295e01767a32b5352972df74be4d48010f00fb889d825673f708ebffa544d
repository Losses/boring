#[derive(Debug, Clone, PartialEq)]
pub enum ValueError {
    StartAfterEnd,
    NegativeStart,
    BlankValue,
    ValueExceptionFault(Box<crate::boring::value_exception::ValueException>),
}

impl std::fmt::Display for ValueError {
    fn fmt(&self, formatter: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        match self {
            ValueError::StartAfterEnd => write!(formatter, "{}", "start exceeds end"),
            ValueError::NegativeStart => write!(formatter, "{}", "start is negative"),
            ValueError::BlankValue => write!(formatter, "{}", "value is blank"),
            ValueError::ValueExceptionFault(inner) => write!(formatter, "{:?}", inner),
        }
    }
}

impl std::error::Error for ValueError {}

#[derive(Debug, Clone, PartialEq)]
pub struct ValueException {
    pub error: ValueError,
}
impl ValueException {
    pub fn new(error: ValueError) -> Self {
        ValueException { error }
    }
}
impl std::fmt::Display for ValueException {
    fn fmt(&self, formatter: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        write!(formatter, "{}", self.error)
    }
}
