}

#[test]
fn test_handler_return() {
    testlib::run("tests.TryTests.testHandlerReturn", "tests.TryTests.testHandlerReturn: handler return leaves the region through the handler", || {
        test_core::TestCore::test_core_equals_int(12i32, i32::from_ne_bytes(((TryOps::try_ops_handler_return(12)) as i32).to_ne_bytes()), UStr::new(&[]));
        test_core::TestCore::test_core_equals_int(16i32, i32::from_ne_bytes(((TryOps::try_ops_handler_return(8)) as i32).to_ne_bytes()), UStr::new(&[]));
