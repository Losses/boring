#[test]
fn test_region_message() {
    testlib::run("tests.TryTests.testRegionMessage", "tests.TryTests.testRegionMessage: message accessor derives from the variant", || {
        test_core::TestCore::test_core_equals_string(UStr::new(&[110,111,32,102,97,117,108,116]), TryOps::try_ops_region_message(7).as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[114,101,99,111,114,100,32,99,111,117,110,116,32,101,120,99,101,101,100,115,32,117,51,50]), TryOps::try_ops_region_message(12).as_ustr(), UStr::new(&[]));
    });
}

#[test]
fn test_fault_payload() {
    testlib::run("tests.TryTests.testFaultPayload", "tests.TryTests.testFaultPayload: payload capture flows through the catch variable", || {
        test_core::TestCore::test_core_equals_int(35i32, i32::from_ne_bytes(((TryOps::try_ops_fault_payload(5)) as i32).to_ne_bytes()), UStr::new(&[]));
    });
}

#[test]
fn test_classify_fault() {
    testlib::run("tests.TryTests.testClassifyFault", "tests.TryTests.testClassifyFault: classify fault maps every variant", || {
        test_core::TestCore::test_core_equals_int(11i32, i32::from_ne_bytes(((TryOps::try_ops_classify_fault((VectorError::BadMagic).clone())) as i32).to_ne_bytes()), UStr::new(&[]));
        test_core::TestCore::test_core_equals_int(12i32, i32::from_ne_bytes(((TryOps::try_ops_classify_fault((VectorError::CountOverflow).clone())) as i32).to_ne_bytes()), UStr::new(&[]));
        test_core::TestCore::test_core_equals_int(13i32, i32::from_ne_bytes(((TryOps::try_ops_classify_fault((VectorError::UnexpectedEof).clone())) as i32).to_ne_bytes()), UStr::new(&[]));
        test_core::TestCore::test_core_equals_int(24i32, i32::from_ne_bytes(((TryOps::try_ops_classify_fault(VectorError::TrailingBytes { remaining: 4 })) as i32).to_ne_bytes()), UStr::new(&[]));
    });
}
