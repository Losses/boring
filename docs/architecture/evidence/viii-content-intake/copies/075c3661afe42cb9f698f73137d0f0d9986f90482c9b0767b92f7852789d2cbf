#![cfg(test)]

use crate::boring::try_ops::TryOps;
use crate::boring::vector_exception::VectorError;
use crate::runtime::test as testlib;
use crate::runtime::test_core;
use crate::runtime::u_string::UStr;


#[test]
fn test_caught_statement() {
    testlib::run("tests.TryTests.testCaughtStatement", "tests.TryTests.testCaughtStatement: statement region catches overflow into the handler", || {
        test_core::TestCore::test_core_equals_int(12i32, i32::from_ne_bytes(((TryOps::try_ops_caught_statement(12)) as i32).to_ne_bytes()), UStr::new(&[]));
        test_core::TestCore::test_core_equals_int(14i32, i32::from_ne_bytes(((TryOps::try_ops_caught_statement(7)) as i32).to_ne_bytes()), UStr::new(&[]));
    });
}

#[test]
fn test_region_return() {
    testlib::run("tests.TryTests.testRegionReturn", "tests.TryTests.testRegionReturn: return region yields the handler value on fault", || {
        test_core::TestCore::test_core_equals_int(12i32, i32::from_ne_bytes(((TryOps::try_ops_region_return(12)) as i32).to_ne_bytes()), UStr::new(&[]));
        test_core::TestCore::test_core_equals_int(16i32, i32::from_ne_bytes(((TryOps::try_ops_region_return(8)) as i32).to_ne_bytes()), UStr::new(&[]));
    });
}

#[test]
fn test_region_value() {
    testlib::run("tests.TryTests.testRegionValue", "tests.TryTests.testRegionValue: initializer region binds the region value", || {
        test_core::TestCore::test_core_equals_int(13i32, i32::from_ne_bytes(((TryOps::try_ops_region_value(12)) as i32).to_ne_bytes()), UStr::new(&[]));
        test_core::TestCore::test_core_equals_int(17i32, i32::from_ne_bytes(((TryOps::try_ops_region_value(8)) as i32).to_ne_bytes()), UStr::new(&[]));
