package boring

import boring.runtime.test.Test

object MathNaNTestSupport {
    fun assertNaN(value: Double, message: String) {
        Test.equals(true, value != value, message)
    }

    fun assertNegativeZero(value: Double, message: String) {
        Test.equals(0.0, value, message)
        Test.equals(true, 1.0 / value < 0.0, message + " (sign)")
    }

    fun assertPositiveZero(value: Double, message: String) {
        Test.equals(0.0, value, message)
        Test.equals(true, 1.0 / value > 0.0, message + " (sign)")
    }
}
