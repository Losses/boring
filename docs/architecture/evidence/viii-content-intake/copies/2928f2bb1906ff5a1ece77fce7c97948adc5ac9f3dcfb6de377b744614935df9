#![cfg(test)]

use crate::boring::compare_gate_ops::CompareGateOps;
use crate::runtime::test as testlib;
use crate::runtime::test_core;
use crate::runtime::u_string::UStr;


#[test]
fn bool_nested_is_ungated() {
    testlib::run("tests.CompareGateTests.boolNestedIsUngated", "tests.CompareGateTests.boolNestedIsUngated: nested data class with Bool remains constructible", || {
        test_core::TestCore::test_core_equals_bool(true, (CompareGateOps::compare_gate_ops_bool_nested().inner).clone().enabled, UStr::new(&[]));
    });
}

#[test]
fn safe_nested_remains_comparable() {
    testlib::run("tests.CompareGateTests.safeNestedRemainsComparable", "tests.CompareGateTests.safeNestedRemainsComparable: nested data class with supported keys remains constructible", || {
        test_core::TestCore::test_core_equals_string(UStr::new(&[97]), (((CompareGateOps::compare_gate_ops_safe_nested().value).clone().inner).clone().label).to_ustring().as_ustr(), UStr::new(&[]));
    });
}
