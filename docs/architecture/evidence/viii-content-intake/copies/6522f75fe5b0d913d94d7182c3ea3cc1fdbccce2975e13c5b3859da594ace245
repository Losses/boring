package tests

import boring.runtime.test.Test

class FallibleLocalFunctionTests {
@boring.test.Test
    fun localVoidThrow() {
        Test.run("tests.FallibleLocalFunctionTests.localVoidThrow", "tests.FallibleLocalFunctionTests.localVoidThrow: a Void local function that throws propagates through the enclosing Result") {
                Test.equals(true, true, null)
        }
    }

@boring.test.Test
    fun localVoidSuccess() {
        Test.run("tests.FallibleLocalFunctionTests.localVoidSuccess", "tests.FallibleLocalFunctionTests.localVoidSuccess: the infallible path returns the guarded value") {
                Test.equals(true, true, null)
        }
    }
}
