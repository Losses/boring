use crate::boring::value_exception::ValueError;
use crate::runtime::u_string::UStr;
use crate::runtime::u_string::UString;


#[derive(Debug, Clone, PartialEq)]
pub struct Ic(pub f32);

impl Ic {
    pub fn new(value: f32) -> Self {
        return Self(value);
    }

    pub fn to_px(&self, em_px: f32) -> f32 {
        return self.0 * em_px;
    }

    pub fn zero() -> Ic { Ic(0.0f32) }
}

impl std::ops::Add for Ic {
    type Output = Ic;
    fn add(self, rhs: Ic) -> Ic {
        return Ic(self.0 + rhs.0);
    }
}

impl std::ops::Neg for Ic {
    type Output = Ic;
    fn neg(self) -> Ic {
        return Ic(-self.0);
    }
}

impl std::fmt::Display for Ic {
    fn fmt(&self, formatter: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        write!(formatter, "{}", self.0)
    }
}

#[derive(Debug, Clone, PartialEq, Eq, Hash)]
pub struct FontFaceId(pub UString);

impl FontFaceId {
    pub fn new(value: &UStr) -> Result<Self, ValueError> {
        if value.trim() == UString::from("") {
            return Err(ValueError::BlankValue);
        }
        return Ok(Self(value.to_ustring()));
    }

    fn to_string(&self) -> UString {
        return self.0.clone();
    }
}

impl std::fmt::Display for FontFaceId {
    fn fmt(&self, formatter: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        write!(formatter, "{}", self.to_string())
    }
}
