#[derive(Clone, Copy)]
pub struct LoopWriteOps;

impl LoopWriteOps {
    pub fn loop_write_ops_tail_increment(n: u32) -> u32 {
        let mut total = 0u32;
        let mut i = 1u32;
        let bound = n;
        while (i32::from_ne_bytes(((i) as i32).to_ne_bytes())) < (i32::from_ne_bytes(((bound) as i32).to_ne_bytes())) {
            total = u32::wrapping_add(total, i);
            i = u32::wrapping_add(i, 1);
        }
        return total;
    }

    pub fn loop_write_ops_branch_increment(n: u32) -> u32 {
        let mut total = 0u32;
        let mut i = 1u32;
        let bound = n;
        while (i32::from_ne_bytes(((i) as i32).to_ne_bytes())) < (i32::from_ne_bytes(((bound) as i32).to_ne_bytes())) {
            total = u32::wrapping_add(total, i);
            if i == 2 {
                i = u32::wrapping_add(i, 1);
            }
            i = u32::wrapping_add(i, 1);
        }
        return total;
    }

    pub fn loop_write_ops_non_unit_increment(n: u32) -> u32 {
        let mut total = 0u32;
        let mut i = 1u32;
        let bound = n;
        while (i32::from_ne_bytes(((i) as i32).to_ne_bytes())) < (i32::from_ne_bytes(((bound) as i32).to_ne_bytes())) {
            total = u32::wrapping_add(total, i);
            i = u32::wrapping_add(i, 2);
        }
        return total;
    }

    pub fn loop_write_ops_closure_increment(n: u32) -> u32 {
        let mut total = 0u32;
        let mut i = 1u32;
        let bound = n;
        while (i32::from_ne_bytes(((i) as i32).to_ne_bytes())) < (i32::from_ne_bytes(((bound) as i32).to_ne_bytes())) {
            total = u32::wrapping_add(total, i);
            i = u32::wrapping_add(i, 2);
        }
        return total;
    }
}
