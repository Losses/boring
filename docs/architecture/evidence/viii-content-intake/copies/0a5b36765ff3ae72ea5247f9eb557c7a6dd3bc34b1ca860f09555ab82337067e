package tests

import boring.InstanceDefaults
import boring.runtime.test.Test

class InstanceDefaultsTests {
@boring.test.Test
    fun defaults() {
        Test.run("tests.InstanceDefaultsTests.defaults", "tests.InstanceDefaultsTests.defaults: instance field defaults initialize every field") {
                val d = InstanceDefaults()
                Test.equals(0, d.count, null)
                Test.equals("none", d.label, null)
                Test.equals(1.0, d.ratio, null)
                Test.equals(false, d.ready, null)
                Test.equals(3, d.tool.level, null)
                Test.equals(7, d.plain, null)
        }
    }

@boring.test.Test
    fun perInstance() {
        Test.run("tests.InstanceDefaultsTests.perInstance", "tests.InstanceDefaultsTests.perInstance: instance field defaults evaluate per instance") {
                val a = InstanceDefaults()
                val b = InstanceDefaults()
                a.tool.level = 9
                Test.equals(3, b.tool.level, null)
        }
    }
}
