#![cfg(test)]

use crate::boring::parse_int_push_ops::ParseIntPushOps;
use crate::runtime::test as testlib;
use crate::runtime::test_core;
use crate::runtime::u_string::UStr;
use crate::runtime::u_string::UString;


#[test]
fn parse_all() {
    testlib::run("tests.ParseIntPushTests.parseAll", "tests.ParseIntPushTests.parseAll: a direct Std.parseInt result pushes into a u32 array", || {
        let values = ParseIntPushOps::parse_int_push_ops_parse_all(&vec![
    UString::from("1").to_ustring(),
    UString::from("2").to_ustring(),
    UString::from("3").to_ustring(),
]);
        test_core::TestCore::test_core_equals_int(3i32, i32::from_ne_bytes(((u32::try_from((values.len()) & 0xFFFF_FFFF).unwrap_or(0)) as i32).to_ne_bytes()), UStr::new(&[]));
        test_core::TestCore::test_core_equals_int(1i32, { let v: u32 = values[0usize]; i32::from_ne_bytes(v.to_ne_bytes()) }, UStr::new(&[]));
        test_core::TestCore::test_core_equals_int(2i32, { let v: u32 = values[1usize]; i32::from_ne_bytes(v.to_ne_bytes()) }, UStr::new(&[]));
        test_core::TestCore::test_core_equals_int(3i32, { let v: u32 = values[2usize]; i32::from_ne_bytes(v.to_ne_bytes()) }, UStr::new(&[]));
    });
}

#[test]
fn parse_local() {
    testlib::run("tests.ParseIntPushTests.parseLocal", "tests.ParseIntPushTests.parseLocal: a local Std.parseInt result pushes into a u32 array", || {
        let values = ParseIntPushOps::parse_int_push_ops_parse_local(&vec![UString::from("4").to_ustring(), UString::from("5").to_ustring()]);
        test_core::TestCore::test_core_equals_int(2i32, i32::from_ne_bytes(((u32::try_from((values.len()) & 0xFFFF_FFFF).unwrap_or(0)) as i32).to_ne_bytes()), UStr::new(&[]));
        test_core::TestCore::test_core_equals_int(4i32, { let v: u32 = values[0usize]; i32::from_ne_bytes(v.to_ne_bytes()) }, UStr::new(&[]));
        test_core::TestCore::test_core_equals_int(5i32, { let v: u32 = values[1usize]; i32::from_ne_bytes(v.to_ne_bytes()) }, UStr::new(&[]));
    });
}
