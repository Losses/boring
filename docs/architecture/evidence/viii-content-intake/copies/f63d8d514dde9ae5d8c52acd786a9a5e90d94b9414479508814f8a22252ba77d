#!/usr/bin/env bash
# Consolidates the per-scenario step summaries into one table. Reads only the
# summaries the report step itself wrote (step extracted verbatim from ci.yml).
cd "$(dirname "$0")" || exit 1
printf 'scenario\texit\treal-assertion\tenv-timeout\tnpm-artifact-flake\ttimeout-cascade\tunattributed\tattributed/total\n'
for f in summary-*.md; do
  lab="${f#summary-}"; lab="${lab%.md}"
  rc=$(cat "exit-$lab.txt" 2>/dev/null || echo "-")
  n() { grep -E "^\| $1 " "$f" | head -1 | awk -F'|' '{gsub(/ /,"",$3); print $3}'; }
  a=$(n 'real assertion failure'); t=$(n 'environment / timeout')
  fl=$(n 'npm-artifact non-determinism'); c=$(n 'timeout cascade'); u=$(n 'unattributed error')
  [ -z "$a" ] && { a=-; t=-; fl=-; c=-; u=-; }
  rec=$(sed -n "s/^Reconciliation: \([0-9][0-9]*\) failed.*/\1/p" "$f")
  tot=$(grep -oE '` ?[0-9]+ fail`' "$f" | grep -oE '[0-9]+')
  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s/%s\n' \
    "$lab" "$rc" "$a" "$t" "$fl" "$c" "$u" "${rec:-?}" "${tot:-?}"
done
