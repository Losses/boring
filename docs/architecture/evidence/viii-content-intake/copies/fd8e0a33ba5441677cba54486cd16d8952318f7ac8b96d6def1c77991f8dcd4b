use crate::runtime::u_string;
use crate::runtime::u_string::UString;


#[derive(Clone, Copy)]
pub struct CaptureSwitchOps;

impl CaptureSwitchOps {
    pub fn capture_switch_ops_describe(error: NoSuchElementError) -> UString {
        return UString::from(format!("{}", {
    let _g = match error { NoSuchElementError::Message { text, .. } => text };
    let text = (_g).clone();
    text
}).as_str());
    }

    pub fn capture_switch_ops_initialized(error: NoSuchElementError) -> UString {
        let text = UString::from(format!("{}", {
    let _g = match error { NoSuchElementError::Message { text, .. } => text };
    let value = (_g).clone();
    value
}).as_str());
        return text;
    }

    pub fn capture_switch_ops_classify(value: CaptureSwitchValue) -> u32 {
        return match value {
            CaptureSwitchValue::Text { value: _p0 } => u_string::unit_count(&(_p0)),
            CaptureSwitchValue::Number { value: _p0 } => u32::wrapping_add(_p0, 1),
        };
    }

    pub fn capture_switch_ops_message_length(error: NoSuchElementError) -> u32 {
        return {
    let _g = match error { NoSuchElementError::Message { text, .. } => text };
    let text = (_g).clone();
    u32::wrapping_add(u_string::unit_count(&(text)), 1)
};
    }
}

#[derive(Debug, Clone, PartialEq)]
pub enum NoSuchElementError {
    Message { text: UString },
}

impl NoSuchElementError {
    pub fn to_string(&self) -> String {
        match self {
            NoSuchElementError::Message { text } => format!("Message(text={})", (text).clone()),
        }
    }
}

#[derive(Debug, Clone, PartialEq)]
pub enum CaptureSwitchValue {
    Text { value: UString },
    Number { value: u32 },
}

impl CaptureSwitchValue {
    pub fn to_string(&self) -> String {
        match self {
            CaptureSwitchValue::Text { value } => format!("Text(value={})", (value).clone()),
            CaptureSwitchValue::Number { value } => format!("Number(value={})", (value).to_string()),
        }
    }
}
