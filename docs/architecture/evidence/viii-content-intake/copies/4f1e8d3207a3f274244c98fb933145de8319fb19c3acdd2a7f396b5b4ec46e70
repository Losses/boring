-lib reflaxe
-lib boring
-cp packages/compiler
-cp packages/compiler/reflaxe/swift/std-shadow
-cp packages/compiler/reflaxe/swift
-cp samples
-cp tests/swift-gap-boundary
--macro Intercept.run(['samples', 'tests/swift-gap-boundary'])
--macro swiftcompiler.Compiler.use()
-D swift-test-runner=native
-D runtime-import=@boring/runtime
-D runtime-emit=.
-D swift-output=/tmp/rev1-run/gen
gap.Gap
--macro haxe.macro.Context.getType("gap.Gap.GapExtra")
--macro haxe.macro.Context.getType("gap.Gap.GapStatics")
--macro haxe.macro.Context.getType("gap.Gap.GapExplicitReturn")
--macro haxe.macro.Context.getType("gap.Gap.GapPaths")
--macro haxe.macro.Context.getType("gap.Gap.GapPaths2")
