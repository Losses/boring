#![cfg(test)]

use crate::registry::core::Core;
use crate::registry::core::RegistryConfig;
use crate::registry::core_exception::CoreFault;
use crate::runtime::test as testlib;
use crate::runtime::test_core;
use crate::runtime::u_string::UStr;
use crate::runtime::u_string::UString;


#[derive(Clone, Copy)]
pub struct RegistryParseArgsSupport;

impl RegistryParseArgsSupport {
    pub fn registry_parse_args_support_message(argv: &Vec<UString>) -> UString {
        let mut text = UString::new();
        let __outcome: Result<RegistryConfig, CoreFault> = (|| {
            return Ok(Core::core_parse_args(&argv)?);
        })();
        match __outcome {
            Ok(_) => {}
            Err(e) => {
                text = UString::from(format!("{}", format!("{}", e)).as_str());
            }
        }
        return text;
    }
}

#[test]
fn missing_required() {
    testlib::run("tests.RegistryParseArgsTests.missingRequired", "tests.RegistryParseArgsTests.missingRequired: parseArgs reports missing required flags", || {
        let text = RegistryParseArgsSupport::registry_parse_args_support_message(&vec![
    UString::from("--tree").to_ustring(),
    UString::from("tree").to_ustring(),
    UString::from("--output").to_ustring(),
    UString::from("site").to_ustring(),
]);
        test_core::TestCore::test_core_equals_bool(true, (text).starts_with(&UString::from("required flags missing")), UStr::new(&[]));
    });
}

#[test]
fn help() {
    testlib::run("tests.RegistryParseArgsTests.help", "tests.RegistryParseArgsTests.help: parseArgs reports help usage", || {
        let text = RegistryParseArgsSupport::registry_parse_args_support_message(&vec![UString::from("--help").to_ustring(), UString::from("value").to_ustring()]);
        test_core::TestCore::test_core_equals_string(UStr::new(&[117,115,97,103,101,58,32,103,101,110,101,114,97,116,101,32,45,45,116,114,101,101,32,60,100,105,114,62,32,45,45,111,117,116,112,117,116,32,60,115,105,116,101,62,32,45,45,98,97,115,101,45,117,114,108,32,60,117,114,108,62,32,91,45,45,115,119,105,102,116,45,115,99,111,112,101,32,60,115,99,111,112,101,62,93,32,91,45,45,97,114,99,104,105,118,101,45,98,97,115,101,32,60,117,114,108,62,93]), text.as_ustr(), UStr::new(&[]));
    });
}

#[test]
fn unknown() {
    testlib::run("tests.RegistryParseArgsTests.unknown", "tests.RegistryParseArgsTests.unknown: parseArgs reports unknown flags", || {
        let text = RegistryParseArgsSupport::registry_parse_args_support_message(&vec![UString::from("--wat").to_ustring(), UString::from("value").to_ustring()]);
        test_core::TestCore::test_core_equals_bool(true, (text).starts_with(&UString::from("unknown flag")), UStr::new(&[]));
    });
}
