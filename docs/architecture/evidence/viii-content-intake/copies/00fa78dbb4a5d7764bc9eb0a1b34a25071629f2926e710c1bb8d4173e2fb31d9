use crate::runtime::sorted_table::SortedTable;
use crate::runtime::u_string::UString;
use std::sync::Arc;


#[derive(Clone, Copy)]
pub struct ResidentBuilderInferOps;

impl ResidentBuilderInferOps {
    pub fn resident_builder_infer_ops_sum() -> u32 {
        let mut b = SortedTable::sorted_table_map_builder::<UString, u32>(Arc::new(|a, b| SortedTable::sorted_table_compare_strings(a.as_ustr(), b.as_ustr())));
        b.put(&(UString::from("a")).to_ustring().to_ustring(), &(1));
        b.put(&(UString::from("b")).to_ustring().to_ustring(), &(2));
        let m = b.clone().build();
        let mut total = 0u32;
        let mut i = 0u32;
        while (i32::from_ne_bytes(((i) as i32).to_ne_bytes())) < (i32::from_ne_bytes(((m.size()) as i32).to_ne_bytes())) {
            total = u32::wrapping_add(total, m.value_at(i32::from_ne_bytes(((i) as i32).to_ne_bytes())));
            i = u32::wrapping_add(i, 1);
        }
        return total;
    }
}
