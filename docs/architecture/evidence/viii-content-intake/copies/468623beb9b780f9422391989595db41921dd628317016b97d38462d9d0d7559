#!/usr/bin/env bash
# exp-d.sh -- does the subshell isolation change the process-group boundary
# that run-exclusive.sh relies on (setsid group leader + cleanup_reap)?
# Replicates run_stage's invocation exactly: setsid bash -c 'cd "$1" && eval "$2"'
set -u
XS="/home/losses/Development/tq-workspace/out/option-c-xcheck"
FROZ="/home/losses/Development/tq-workspace/boring-wt-architecture/out/integration-a3-evidence/exclusive-runner"
EXP="$XS/experiments"; ROOT="$EXP/root"; MAN="$EXP/manifest.json"
PS="$FROZ/option-c-poststate.py"
CMP="$XS/cmp"
A="$CMP/a-pris/option-c-stage-wrapper.sh"
B="$CMP/b-fixd/option-c-stage-wrapper.sh"

probe() { # probe <wrapper> <outdir-abs> <label>
  local w="$1" od="$2" label="$3"
  local line
  line="$(printf '%s' "$w") pgidprobe \"$ROOT\" \"$MAN\" \"$PS\" \"$od\" -- bash -c 'echo \"cmd_pid=\$\$ cmd_pgid=\$(ps -o pgid= -p \$\$ | tr -d \" \")\"; sleep 25 & echo \"bg_pid=\$! bg_pgid=\$(ps -o pgid= -p \$! | tr -d \" \")\"; echo \"bg_alive_before=\$(kill -0 \$! 2>/dev/null && echo yes || echo no)\"'"
  local out="$od/probe.out"
  mkdir -p "$od"
  setsid bash -c 'cd "$1" && eval "$2"' _ "$ROOT" "$line" >"$out" 2>&1 &
  local leader=$!                       # == new session/group leader id
  wait "$leader"; local rc=$?
  echo "[$label] group_leader_pid=$leader wrapper_rc=$rc"
  grep -E 'cmd_pid|cmd_pgid|bg_pid|bg_pgid|bg_alive_before' "$out" | sed 's/^/    /'
  # simulate cleanup_reap: TERM then KILL the recorded group
  kill -TERM -- "-$leader" 2>/dev/null
  sleep 0.3
  local bg
  bg="$(sed -n 's/.*bg_pid=\([0-9]*\).*/\1/p' "$out" | head -1)"
  if [ -n "$bg" ]; then
    if kill -0 "$bg" 2>/dev/null; then echo "    after group-TERM: bg_pid=$bg STILL ALIVE"; else echo "    after group-TERM: bg_pid=$bg reaped (kill -0 fails)"; fi
  fi
  kill -KILL -- "-$leader" 2>/dev/null
}

echo "=== PRISTINE wrapper ==="
probe "$A" "$CMP/out-a/pr" pristine
echo "=== FIXED wrapper ==="
probe "$B" "$CMP/out-b/pr" fixed
echo
echo "writer of the same experiment run by run-exclusive: plan-D (late writer) already covers this in selftest."
