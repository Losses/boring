#![cfg(test)]

use crate::boring::switch_merge_ops::SwitchMergeOps;
use crate::boring::switch_merge_ops::SwitchMergeValue;
use crate::runtime::test as testlib;
use crate::runtime::test_core;
use crate::runtime::u_string::UStr;


#[test]
fn grouped() {
    testlib::run("tests.SwitchMergeTests.grouped", "tests.SwitchMergeTests.grouped: grouped variant arms preserve both constructors", || {
        test_core::TestCore::test_core_equals_string(UStr::new(&[103,114,111,117,112,101,100,58,51]), SwitchMergeOps::switch_merge_ops_grouped(SwitchMergeValue::First { value: 3 }).as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[103,114,111,117,112,101,100,58,52]), SwitchMergeOps::switch_merge_ops_grouped(SwitchMergeValue::Second { value: 4 }).as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[116,104,105,114,100]), SwitchMergeOps::switch_merge_ops_grouped((SwitchMergeValue::Third).clone()).as_ustr(), UStr::new(&[]));
    });
}

#[test]
fn single() {
    testlib::run("tests.SwitchMergeTests.single", "tests.SwitchMergeTests.single: single variant arms remain distinct", || {
        test_core::TestCore::test_core_equals_string(UStr::new(&[102,105,114,115,116,58,49]), SwitchMergeOps::switch_merge_ops_single(SwitchMergeValue::First { value: 1 }).as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[115,101,99,111,110,100,58,50]), SwitchMergeOps::switch_merge_ops_single(SwitchMergeValue::Second { value: 2 }).as_ustr(), UStr::new(&[]));
    });
}

#[test]
fn grouped_plain_matches() {
    testlib::run("tests.SwitchMergeTests.groupedPlainMatches", "tests.SwitchMergeTests.groupedPlainMatches: grouped plain arms match without payload bindings", || {
        test_core::TestCore::test_core_equals_string(UStr::new(&[112,108,97,105,110]), SwitchMergeOps::switch_merge_ops_grouped_plain(SwitchMergeValue::First { value: 1 }).as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[112,108,97,105,110]), SwitchMergeOps::switch_merge_ops_grouped_plain(SwitchMergeValue::Second { value: 2 }).as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[116,104,105,114,100]), SwitchMergeOps::switch_merge_ops_grouped_plain((SwitchMergeValue::Third).clone()).as_ustr(), UStr::new(&[]));
    });
}
