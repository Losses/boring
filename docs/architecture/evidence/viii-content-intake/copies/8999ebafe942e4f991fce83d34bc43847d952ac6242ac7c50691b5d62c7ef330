#[derive(Clone, Copy)]
pub struct UnionChainOps;

impl UnionChainOps {
    pub fn union_chain_ops_pair(value: u32) -> Result<u32, UnionChainOpsPairFault> {
        if value > 2147483647 {
            return Err(UnionChainOpsPairFault::HaxeExceptionFaultFault(HaxeExceptionFault::new("pair-alpha")));
        }
        if i32::from_ne_bytes(((value) as i32).to_ne_bytes()) > (10) {
            return Err(UnionChainOpsPairFault::ValueErrorFault(ValueError::StartAfterEnd));
        }
        return Ok(value);
    }

    pub fn union_chain_ops_adopt(value: u32) -> Result<u32, UnionChainOpsPairFault> {
        return Ok(UnionChainOps::union_chain_ops_pair(value)?);
    }

    pub fn union_chain_ops_outer(value: u32) -> Result<u32, UnionChainOpsPairFault> {
        return Ok(UnionChainOps::union_chain_ops_adopt(value)?);
    }
