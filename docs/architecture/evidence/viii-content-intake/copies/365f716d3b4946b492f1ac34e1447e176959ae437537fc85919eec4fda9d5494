// charcodeat/CharCodeAtOracle.ts
class CharCodeAtOracle {
  static subRev() {
    return "abcdef".substring(4, 2);
  }
  static subHigh() {
    return "abcdef".substring(4, 100);
  }
  static subNeg() {
    return "abcdef".substring(-1, 3);
  }
  static codeNull() {
    const c = Number.isNaN("abcdef".charCodeAt(100)) ? null : "abcdef".charCodeAt(100);
    return c;
  }
  static codeNeg() {
    const c = Number.isNaN("abcdef".charCodeAt(-1)) ? null : "abcdef".charCodeAt(-1);
    return c;
  }
  static codeInt() {
    const c = Number.isNaN("abcdef".charCodeAt(100)) ? null : "abcdef".charCodeAt(100);
    return c;
  }
  static codeLine(label, c) {
    if (c === null) {
      return label + "null";
    }
    return label + c;
  }
  static main() {}
}

// charcodeat-run.js
var text = (v) => v === null || v === undefined ? "null" : String(v);
var lines = [
  "subRev=" + CharCodeAtOracle.subRev(),
  "subHigh=" + CharCodeAtOracle.subHigh(),
  "subNeg=" + CharCodeAtOracle.subNeg(),
  "codeNull=" + text(CharCodeAtOracle.codeNull()),
  "codeNeg=" + text(CharCodeAtOracle.codeNeg()),
  "codeInt=" + text(CharCodeAtOracle.codeInt())
];
for (const line of lines) {
  console.log(line);
}
