#![cfg(test)]

use crate::boring::value_exception::ValueError;
use crate::boring::value_exception::ValueException;
use crate::runtime::test as testlib;


#[derive(Clone, Copy)]
pub struct ProdRethrowOps;

impl ProdRethrowOps {
    pub fn prod_rethrow_ops_must_throw() -> Result<(), ValueError> {
        return Err(ValueError::NegativeStart);
    }
}

#[test]
fn rethrow_production() {
    testlib::run("xcheckscope.ProdRethrowTests.rethrowProduction", "xcheckscope.ProdRethrowTests.rethrowProduction: rethrow of a production exception value from a test module", || {
        let __outcome: Result<(), ValueError> = (|| {
            let _ = ProdRethrowOps::prod_rethrow_ops_must_throw()?;
            Ok(())
        })();
        match __outcome {
            Ok(_) => {}
            Err(e) => {
                let __outcome1: Result<(), ValueError> = (|| {
                    return Err(ValueException::new(e));
                })();
                match __outcome1 {
                    Ok(_) => {}
                    Err(_) => {
                    }
                }
            }
        }
    });
}
