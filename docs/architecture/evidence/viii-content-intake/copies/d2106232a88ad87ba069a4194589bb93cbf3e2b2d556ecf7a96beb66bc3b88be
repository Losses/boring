#[derive(Clone, PartialEq)]
pub struct CtorOmitTarget {
    pub width: f32,
    pub height: f32,
    pub count: u32,
}

impl CtorOmitTarget {
    pub fn new(width: f32, height: Option<f32>, count: Option<u32>) -> Self {
        let height = height.unwrap_or_else(|| 100.0f32);
        let count = count.unwrap_or_else(|| 5);
        Self {
            width,
            height: height,
            count: count,
        }
    }
}

#[derive(Clone, Copy)]
pub struct CtorOmitOps;

impl CtorOmitOps {
    pub fn ctor_omit_ops_make() -> f32 {
        let t = CtorOmitTarget::new(10.0f32, Some(100.0f32), Some(5));
        return t.width + t.height;
    }
}
