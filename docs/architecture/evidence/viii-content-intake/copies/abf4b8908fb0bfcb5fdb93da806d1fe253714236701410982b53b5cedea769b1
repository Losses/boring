class BareFieldProbe(private val fallbackCount: Int) {

    fun make(p: Int? = null, q: Int? = null): Int {
        val v = p ?: this.fallbackCount
        val w = q ?: this.fallbackCount
        return v!! + w!!
    }
}

class ParamReadSpan(val kind: ParamReadKind, val locale: String? = if (kind == ParamReadKind.Bopomofo) "zh-TW" else null) {
