interface IGreeter {
    fun say(name: String, title: String = "User"): String
}

class GreeterImpl : IGreeter {
    override fun say(name: String, title: String): String {
        return title + ":" + name
    }
}

class DefaultArgsOps(var familyNames: MutableList<String> = mutableListOf<String>()) {
    var normalizationField: String
    init {
    this.normalizationField = "field"
    }

    fun formatLabel(label: String? = null, sep: String = "-"): String {
        if ((label == null)) {
            return "none" + sep + "default"
        }
        return label + sep + "formatted"
    }

    fun instanceFieldNormalization(p: String? = null): String {
        val v = p ?: this.normalizationField
        return v!!
    }

    fun earlierLocalNormalization(seed: String, q: String? = null): String {
        val loc = seed
        val w = q ?: loc
        return w!!
    }

    companion object {
        fun greet(name: String, prefix: String = "Hello"): String {
            return prefix + " " + name
        }

        fun configure(base: Int, offset: Int = 10, scale: Float = 2.5f, flag: Boolean = true): Float {
            val sum = ((base + offset)).toFloat() * scale
            return (if ((flag)) sum else -sum)
        }

        fun describeTag(tag: String, detail: String? = null): String {
            if ((detail == null)) {
                return tag + ":none"
            }
            return tag + ":" + detail
        }

        fun openMode(id: Int, mode: Mode = Mode.Read): String {
            if ((mode == Mode.Write)) {
                return "write:" + id
            }
            return "read:" + id
        }

        fun adjust(value: Float, step: Float = -5.0f): Float {
            return value + step
        }

        fun infinityDefault(value: Float = Float.POSITIVE_INFINITY): Float {
            val normalized = value
            return normalized!!
        }

        fun mapDefault(value: MutableMap<String, Int> = mutableMapOf()): MutableMap<String, Int> {
            val normalized = value
            return normalized
        }

        fun computeWithLocal(x: Int): Int {
            val localAdd = fun(a: Int, b: Int): Int {
    return a + b
}
            return localAdd(x, 100)
        }

        fun computeWithLocalB(x: Int): Int {
            val localAdd = fun(a: Int, b: Int): Int {
    return a + b
}
            return localAdd(x, 200)
        }

        fun callGreet0(): String {
            return DefaultArgsOps.greet("Ada", "Greetings")
        }

        fun callGreet1(): String {
            return DefaultArgsOps.greet("Ada", "Hello")
        }

        fun callConfigure0(): Float {
            return DefaultArgsOps.configure(100, 20, 1.5f, false)
        }

        fun callConfigure1(): Float {
            return DefaultArgsOps.configure(100, 20, 1.5f, true)
        }

        fun callConfigure2(): Float {
            return DefaultArgsOps.configure(100, 20, 2.5f, true)
        }

        fun callConfigure3(): Float {
            return DefaultArgsOps.configure(100, 10, 2.5f, true)
        }

        fun callFormatLabel0(): String {
            val ops = DefaultArgsOps(mutableListOf<String>())
            return ops.formatLabel("item", ":")
        }

        fun callFormatLabel1(): String {
            val ops = DefaultArgsOps(mutableListOf<String>())
            return ops.formatLabel("item", "-")
        }

        fun callFormatLabel2(): String {
            val ops = DefaultArgsOps(mutableListOf<String>())
            return ops.formatLabel(null, "-")
        }

        fun callDescribeTag0(): String {
            return DefaultArgsOps.describeTag("alpha", "extra")
        }

        fun callDescribeTag1(): String {
            return DefaultArgsOps.describeTag("alpha", null)
        }

        fun callOpenMode0(): String {
            return DefaultArgsOps.openMode(1, Mode.Write)
        }

        fun callOpenMode1(): String {
            return DefaultArgsOps.openMode(1, Mode.Read)
        }

        fun callAdjust0(): Float {
            return DefaultArgsOps.adjust(20.0f, 10.0f)
        }

        fun callAdjust1(): Float {
            return DefaultArgsOps.adjust(20.0f, -5.0f)
        }

        fun callInfinity0(): Float {
            return DefaultArgsOps.infinityDefault()
        }

        fun callInfinity1(): Float {
            return DefaultArgsOps.infinityDefault(1.25f)
        }

        fun callMapDefault(): MutableMap<String, Int> {
            return DefaultArgsOps.mapDefault()
        }

        fun callLocal(): Int {
            return DefaultArgsOps.computeWithLocal(7)
        }

        fun callLocalB(): Int {
            return DefaultArgsOps.computeWithLocalB(7)
        }

        fun callInterface0(): String {
            val greeter = GreeterImpl()
            return greeter.say("Sam", "Admin")
        }

        fun callInterface1(): String {
            val greeter = GreeterImpl()
            return greeter.say("Sam", "User")
        }

        fun greetWithPrefix(name: String, prefix: String = name): String {
            val normalized = prefix
            return normalized!!
        }

        fun sizeLabel(items: MutableList<String>? = null): String {
            val count = (if ((items == null)) 0 else items.size)
            return "size:" + count
        }

        fun fieldAccessSample(items: MutableList<String>, count: Int = items.size): Int {
            val normalized = count
            return normalized!!
        }

        fun localeSample(lang: String, fallback: String = if (lang == "en") "English" else "Other"): String {
            val normalized = fallback
            return normalized!!
        }

        fun methodCallSample(text: String, normalized: String = text.uppercase()): String {
            val value = normalized
            return value!!
        }

        fun sortedSetNormalization(fallback: SortedSetTable<Int>? = null): SortedSetTable<Int> {
            val normalized = fallback ?: SortedTable.setBuilder<Int>(SortedTable::compareInts).build()
            return normalized!!
        }

        fun clampBase(value: Int): Int {
            return (if ((value > 0)) value else 0)
        }

        fun staticCallSample(value: Int, clamped: Int = DefaultArgsOps.clampBase(value)): Int {
            val result = clamped
            return result!!
        }

        fun staticFieldSample(value: Int, bound: Int = StaticStateOps.limit): Int {
            val normalized = bound
            return value + normalized!!
        }

        fun binarySample(value: Int, offset: Int = value + 1): Int {
            val result = offset
            return result
        }

        fun dependenceEarlier(a: String, b: String = a): String {
            val normalized = b
            return normalized!!
        }

        fun callDependenceA(): String {
            return DefaultArgsOps.dependenceEarlier("alpha")
        }

        fun callDependenceB(): String {
            return DefaultArgsOps.dependenceEarlier("beta")
        }

        fun chainedCoalescing(fallback: Float = 2.5f, value: Float = fallback): Float {
            val resolvedFallback = fallback
            val resolvedValue = value
            return resolvedFallback + resolvedValue!!
        }

        fun callChainedBothOmitted(): Float {
            return DefaultArgsOps.chainedCoalescing()
        }

        fun callChainedLaterOmitted(): Float {
            return DefaultArgsOps.chainedCoalescing(3.5f)
        }

        fun callChainedBothGiven(): Float {
            return DefaultArgsOps.chainedCoalescing(1.5f, 8.0f)
        }
    }
}

