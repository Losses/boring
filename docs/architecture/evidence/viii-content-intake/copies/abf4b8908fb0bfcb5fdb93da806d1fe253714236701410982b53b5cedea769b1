object GluePlacements {
    fun forRegion(region: ParamReadKind): String {
        return (if ((region == ParamReadKind.Bopomofo)) "bopo" else "pinyin")
    }
}

class RegionProfile(val region: ParamReadKind, val gluePlacement: String = GluePlacements.forRegion(region)) {
}

enum class Mode {
    Read,
    Write
}
fun compareMode(a: Mode, b: Mode): Int = a.ordinal - b.ordinal

enum class ParamReadKind {
    Pinyin,
    Bopomofo
}
fun compareParamReadKind(a: ParamReadKind, b: ParamReadKind): Int = a.ordinal - b.ordinal
