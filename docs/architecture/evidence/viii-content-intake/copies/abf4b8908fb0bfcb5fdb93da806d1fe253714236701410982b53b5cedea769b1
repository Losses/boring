object KeywordNameOps {
    fun clampVal(`val`: Int, min: Int, max: Int): Int {
        return (if ((`val` < min)) min else (if ((`val` > max)) max else `val`))
    }

    fun localKeywordRead(): Int {
        val `val` = 7
        return `val` + 1
    }
}

