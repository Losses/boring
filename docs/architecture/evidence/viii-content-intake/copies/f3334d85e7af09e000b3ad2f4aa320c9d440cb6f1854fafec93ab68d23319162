use crate::runtime::u_string::UString;


#[derive(Debug, Clone, PartialEq)]
pub struct MsgOnly {
    pub message: String,
}
impl MsgOnly {
    pub fn new(message: &str) -> Self {
        Self { message: message.to_string() }
    }
}
impl std::fmt::Display for MsgOnly {
    fn fmt(&self, formatter: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        write!(formatter, "{}", self.message)
    }
}
impl std::error::Error for MsgOnly {}

#[derive(Debug, Clone, PartialEq)]
pub enum F1Fault {
    One { t: UString },
    WithPayloadFault(Box<crate::xsxm::sib::WithPayload>),
}

impl std::fmt::Display for F1Fault {
    fn fmt(&self, formatter: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        match self {
            F1Fault::One { t } => {
                write!(formatter, "{}", t)
            }
            F1Fault::WithPayloadFault(inner) => write!(formatter, "{:?}", inner),
        }
    }
}

impl std::error::Error for F1Fault {}

#[derive(Debug, Clone, PartialEq)]
pub struct WithPayload {
    pub fault: F1Fault,
}
impl WithPayload {
    pub fn new(fault: F1Fault) -> Self {
        WithPayload { fault }
    }
}
impl std::fmt::Display for WithPayload {
    fn fmt(&self, formatter: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        write!(formatter, "{}", self.fault)
    }
}
