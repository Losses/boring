use crate::runtime::u_string::UStr;
use crate::runtime::u_string::UString;


pub trait RenderShape: Send + Sync {
    fn __haxe_type_name(&self) -> &'static str;
    fn as_any(&self) -> &dyn std::any::Any;
    fn clone_box(&self) -> Box<dyn RenderShape>;
    fn render(&self, text: &UStr) -> UString;
}

impl Clone for Box<dyn RenderShape> {
    fn clone(&self) -> Self {
        self.clone_box()
    }
}

impl std::fmt::Debug for dyn RenderShape {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        write!(f, "{}", self.__haxe_type_name())
    }
}
