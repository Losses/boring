package boring

import std.UStringException

object ArrayAccessOps {
    fun writeSplit(text: String): String {
        var parts = text.split(",").toMutableList()
        if (parts.size <= 0) { parts.addAll(java.util.Collections.nCopies<String>(0 + 1 - parts.size, null)) }
        parts[0] = "x"
        return parts[0]
    }

    fun readSplit(text: String): String {
        val parts = text.split(",")
        return parts[0]
    }

    fun compositeStringBufPart(value: String): Int {
        val buffer = StringBuilder()
        val tail = buffer.lastOrNull()?.code ?: -1
        if (tail >= 55296 && tail <= 56319 && ("" + value).length > 0 && !(("" + value)[0].code >= 56320 && ("" + value)[0].code <= 57343)) {
            throw UStringException.UnpairedSurrogate(tail)
        }
        buffer.append(("" + value))
        val tail2 = buffer.lastOrNull()?.code ?: -1
        if (tail2 >= 55296 && tail2 <= 56319) {
            throw UStringException.UnpairedSurrogate(tail2)
        }
        val rendered = buffer.toString()
        return (run { val _s = rendered; val _i = 0; if (_i >= 0 && _i < _s.length) _s[_i].code else null })!!
    }

    fun simpleStringBufPart(value: String): Int {
        val buffer = StringBuilder()
        val tail3 = buffer.lastOrNull()?.code ?: -1
        if (tail3 >= 55296 && tail3 <= 56319 && value.length > 0 && !(value[0].code >= 56320 && value[0].code <= 57343)) {
            throw UStringException.UnpairedSurrogate(tail3)
        }
        buffer.append(value)
        val tail4 = buffer.lastOrNull()?.code ?: -1
        if (tail4 >= 55296 && tail4 <= 56319) {
            throw UStringException.UnpairedSurrogate(tail4)
        }
        val rendered = buffer.toString()
        return (run { val _s = rendered; val _i = 0; if (_i >= 0 && _i < _s.length) _s[_i].code else null })!!
    }

    fun growNullableSlots(): MutableList<Int?> {
        var slots = mutableListOf<Int?>()
        while (slots.size <= 3) { slots.add(null) }
        slots[3] = 7
        return slots
    }

    fun growValueSlots(): MutableList<Int> {
        var slots = mutableListOf<Int>()
        while (slots.size <= 2) { slots.add(0) }
        slots[2] = 5
        return slots
    }

    fun writeInsideSlots(): MutableList<Int> {
        var slots = mutableListOf<Int>(1, 2, 3, 4)
        while (slots.size <= 1) { slots.add(0) }
        slots[1] = 20
        while (slots.size <= 3) { slots.add(0) }
        slots[3] = 40
        val _growIndex1 = slots.size
        while (slots.size <= _growIndex1) { slots.add(0) }
        slots[_growIndex1] = 50
        return slots
    }

    fun filledHolder(count: Int): MutableList<Int?> {
        val holder = ArrayGrowthHolder(count)
        return holder.readAll()
    }

    fun growFloatSlots(): MutableList<Double> {
        var slots = mutableListOf<Double>()
        while (slots.size <= 2) { slots.add(0.0) }
        slots[2] = 1.5
        return slots
    }

    fun filledFloatHolder(count: Int): MutableList<Double> {
        val holder = FloatGrowthHolder(count)
        return holder.readAll()
    }
}

class FloatGrowthHolder(count: Int) {
    var slots: MutableList<Double>
    init {
    this.slots = mutableListOf<Double>()
    var i = 0
    while ((i <= count)) {
        while (this.slots.size <= i) { this.slots.add(0.0) }
        this.slots[i] = (i).toDouble() * 1.5
        i++
    }
    }

    fun readAll(): MutableList<Double> {
        return this.slots
    }
}

class ArrayGrowthHolder(count: Int) {
    var slots: MutableList<Int?>
    init {
    this.slots = mutableListOf<Int?>()
    var i = 0
    while ((i <= count)) {
        while (this.slots.size <= i) { this.slots.add(null) }
        this.slots[i] = i * 10
        i++
    }
    }

    fun readAll(): MutableList<Int?> {
        return this.slots
    }
}
