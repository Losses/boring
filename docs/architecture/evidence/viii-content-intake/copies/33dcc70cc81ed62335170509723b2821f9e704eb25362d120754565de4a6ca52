#[test]
fn enum_elements() {
    testlib::run("tests.PrintedCollectionTests.enumElements", "tests.PrintedCollectionTests.enumElements: payload enum elements render through the labeled form", || {
        let v = PrintedEnumCollection::new(vec![(PrintedFlag::Silent).clone(), (PrintedFlag::Steps { count: 2 }).clone()]);
        test_core::TestCore::test_core_equals_string(UStr::new(&[80,114,105,110,116,101,100,69,110,117,109,67,111,108,108,101,99,116,105,111,110,40,102,108,97,103,115,61,91,83,105,108,101,110,116,44,32,83,116,101,112,115,40,99,111,117,110,116,61,50,41,93,41]), (UString::from(format!("{}", v.to_string()).as_str())).as_ustr(), UStr::new(&[]));
    });
}

#[test]
fn nullable_collection_print() {
    testlib::run("tests.PrintedCollectionTests.nullableCollectionPrint", "tests.PrintedCollectionTests.nullableCollectionPrint: nullable collection fields print null and present forms", || {
        let none = PrintedNullableCollection::new(None);
        test_core::TestCore::test_core_equals_string(UStr::new(&[80,114,105,110,116,101,100,78,117,108,108,97,98,108,101,67,111,108,108,101,99,116,105,111,110,40,119,111,114,100,115,61,110,117,108,108,41]), (UString::from(format!("{}", none.to_string()).as_str())).as_ustr(), UStr::new(&[]));
        let present = PrintedNullableCollection::new(Some(vec![UString::from("alpha").to_ustring(), UString::from("beta").to_ustring()]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[80,114,105,110,116,101,100,78,117,108,108,97,98,108,101,67,111,108,108,101,99,116,105,111,110,40,119,111,114,100,115,61,91,97,108,112,104,97,44,32,98,101,116,97,93,41]), (UString::from(format!("{}", present.to_string()).as_str())).as_ustr(), UStr::new(&[]));
    });
}

#[test]
fn nullable_collection_keys() {
    testlib::run("tests.PrintedCollectionTests.nullableCollectionKeys", "tests.PrintedCollectionTests.nullableCollectionKeys: nullable collection keys order null, elements, then length", || {
        let mut double_null: SortedMapTableBuilder<PrintedNullableCollection, UString> = SortedTable::sorted_table_map_builder::<PrintedNullableCollection, UString>(Arc::new(compare_printed_nullable_collection));
        double_null.put(&(PrintedNullableCollection::new(None)), &(UString::from("first")).to_ustring());
        double_null.put(&(PrintedNullableCollection::new(None)), &(UString::from("second")).to_ustring());
        let double_null_map: SortedMapTable<PrintedNullableCollection, UString> = double_null.clone().build();
        test_core::TestCore::test_core_equals_int(1i32, i32::from_ne_bytes(((u32::from_ne_bytes(((double_null_map.size()) as u32).to_ne_bytes())) as i32).to_ne_bytes()), UStr::new(&[116,119,111,32,110,117,108,108,32,107,101,121,115,32,99,111,108,108,97,112,115,101,32,116,111,32,111,110,101,32,101,110,116,114,121]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[115,101,99,111,110,100]), double_null_map.value_at(0i32).as_ustr(), UStr::new(&[116,104,101,32,108,97,116,101,114,32,110,117,108,108,45,107,101,121,101,100,32,112,117,116,32,115,117,114,118,105,118,101,115]));
        let mut null_first: SortedMapTableBuilder<PrintedNullableCollection, UString> = SortedTable::sorted_table_map_builder::<PrintedNullableCollection, UString>(Arc::new(compare_printed_nullable_collection));
        null_first.put(&(PrintedNullableCollection::new(Some(vec![UString::from("alpha").to_ustring()]))), &(UString::from("value")).to_ustring());
        null_first.put(&(PrintedNullableCollection::new(None)), &(UString::from("null")).to_ustring());
        let null_first_map: SortedMapTable<PrintedNullableCollection, UString> = null_first.clone().build();
        test_core::TestCore::test_core_equals_int(2i32, i32::from_ne_bytes(((u32::from_ne_bytes(((null_first_map.size()) as u32).to_ne_bytes())) as i32).to_ne_bytes()), UStr::new(&[110,117,108,108,32,97,110,100,32,118,97,108,117,101,32,107,101,121,115,32,115,116,97,121,32,100,105,115,116,105,110,99,116]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[110,117,108,108]), null_first_map.value_at(0i32).as_ustr(), UStr::new(&[110,117,108,108,32,115,111,114,116,115,32,98,101,102,111,114,101,32,97,32,112,114,101,115,101,110,116,32,97,114,114,97,121]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[118,97,108,117,101]), null_first_map.value_at(1i32).as_ustr(), UStr::new(&[116,104,101,32,112,114,101,115,101,110,116,32,107,101,121,32,102,111,108,108,111,119,115,32,116,104,101,32,110,117,108,108,32,107,101,121]));
        let mut same_elements: SortedMapTableBuilder<PrintedNullableCollection, UString> = SortedTable::sorted_table_map_builder::<PrintedNullableCollection, UString>(Arc::new(compare_printed_nullable_collection));
        same_elements.put(&(PrintedNullableCollection::new(Some(vec![UString::from("alpha").to_ustring(), UString::from("beta").to_ustring()]))), &(UString::from("first")).to_ustring());
        same_elements.put(&(PrintedNullableCollection::new(Some(vec![UString::from("alpha").to_ustring(), UString::from("beta").to_ustring()]))), &(UString::from("second")).to_ustring());
        let same_elements_map: SortedMapTable<PrintedNullableCollection, UString> = same_elements.clone().build();
        test_core::TestCore::test_core_equals_int(1i32, i32::from_ne_bytes(((u32::from_ne_bytes(((same_elements_map.size()) as u32).to_ne_bytes())) as i32).to_ne_bytes()), UStr::new(&[101,113,117,97,108,32,97,114,114,97,121,32,107,101,121,115,32,99,111,108,108,97,112,115,101,32,116,111,32,111,110,101,32,101,110,116,114,121]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[115,101,99,111,110,100]), same_elements_map.value_at(0i32).as_ustr(), UStr::new(&[116,104,101,32,108,97,116,101,114,32,101,113,117,97,108,45,107,101,121,101,100,32,112,117,116,32,115,117,114,118,105,118,101,115]));
        let mut prefix_length: SortedMapTableBuilder<PrintedNullableCollection, UString> = SortedTable::sorted_table_map_builder::<PrintedNullableCollection, UString>(Arc::new(compare_printed_nullable_collection));
        prefix_length.put(&(PrintedNullableCollection::new(Some(vec![UString::from("alpha").to_ustring(), UString::from("beta").to_ustring()]))), &(UString::from("long")).to_ustring());
        prefix_length.put(&(PrintedNullableCollection::new(Some(vec![UString::from("alpha").to_ustring()]))), &(UString::from("short")).to_ustring());
        let prefix_length_map: SortedMapTable<PrintedNullableCollection, UString> = prefix_length.clone().build();
