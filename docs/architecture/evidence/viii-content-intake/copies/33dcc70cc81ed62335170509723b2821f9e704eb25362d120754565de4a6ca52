        test_core::TestCore::test_core_equals_string(UStr::new(&[115,104,111,114,116]), prefix_length_map.value_at(0i32).as_ustr(), UStr::new(&[97,32,112,114,101,102,105,120,32,97,114,114,97,121,32,115,111,114,116,115,32,98,101,102,111,114,101,32,105,116,115,32,101,120,116,101,110,115,105,111,110]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[108,111,110,103]), prefix_length_map.value_at(1i32).as_ustr(), UStr::new(&[116,104,101,32,108,111,110,103,101,114,32,97,114,114,97,121,32,102,111,108,108,111,119,115,32,105,116,115,32,112,114,101,102,105,120]));
    });
}
