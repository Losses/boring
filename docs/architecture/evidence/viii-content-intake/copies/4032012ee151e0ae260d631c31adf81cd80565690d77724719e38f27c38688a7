#![cfg(test)]

use crate::boring::string_buf_ops::StringBufOps;
use crate::runtime::test as testlib;
use crate::runtime::test_core;
use crate::runtime::u_string::UStr;
use crate::runtime::u_string::UString;


#[test]
fn test_empty_buffer() {
    testlib::run("tests.StringBufTests.testEmptyBuffer", "tests.StringBufTests.testEmptyBuffer: empty buffer has length zero and empty toString", || {
        test_core::TestCore::test_core_equals_string(UStr::new(&[]), StringBufOps::string_buf_ops_build_empty().unwrap().as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_int(0i32, i32::from_ne_bytes(((StringBufOps::string_buf_ops_measure_length(&vec![]).unwrap()) as i32).to_ne_bytes()), UStr::new(&[]));
    });
}

#[test]
fn test_add_strings() {
    testlib::run("tests.StringBufTests.testAddStrings", "tests.StringBufTests.testAddStrings: add appends strings and updates length", || {
        let res = StringBufOps::string_buf_ops_build_parts(UStr::new(&[104,101,108,108,111]), UStr::new(&[32]), UStr::new(&[119,111,114,108,100])).unwrap();
        test_core::TestCore::test_core_equals_string(UStr::new(&[104,101,108,108,111,32,119,111,114,108,100]), res.as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_int(11i32, i32::from_ne_bytes(((StringBufOps::string_buf_ops_measure_length(&vec![
    UString::from("hello").to_ustring(),
    UString::from(" ").to_ustring(),
    UString::from("world").to_ustring(),
]).unwrap()) as i32).to_ne_bytes()), UStr::new(&[]));
    });
}

#[test]
fn test_supplementary_characters() {
    testlib::run("tests.StringBufTests.testSupplementaryCharacters", "tests.StringBufTests.testSupplementaryCharacters: add with supplementary characters counts UTF-16 code units", || {
        test_core::TestCore::test_core_equals_string(UStr::new(&[104,105,55357,56960,33]), StringBufOps::string_buf_ops_build_supplementary().unwrap().as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_int(5i32, i32::from_ne_bytes(((StringBufOps::string_buf_ops_measure_supplementary_length().unwrap()) as i32).to_ne_bytes()), UStr::new(&[]));
    });
}

#[test]
fn test_add_char() {
    testlib::run("tests.StringBufTests.testAddChar", "tests.StringBufTests.testAddChar: addChar appends BMP characters", || {
        let res = StringBufOps::string_buf_ops_build_with_chars(UStr::new(&[105,116,101,109,45]), 65, 66).unwrap();
        test_core::TestCore::test_core_equals_string(UStr::new(&[105,116,101,109,45,65,66]), res.as_ustr(), UStr::new(&[]));
    });
}

#[test]
fn test_incremental() {
    testlib::run("tests.StringBufTests.testIncremental", "tests.StringBufTests.testIncremental: buffer extends after toString calls", || {
        let steps = StringBufOps::string_buf_ops_build_incremental().unwrap();
        test_core::TestCore::test_core_equals_string(UStr::new(&[115,116,101,112,49]), (steps[0usize]).clone().as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[115,116,101,112,49,45,115,116,101,112,50]), (steps[1usize]).clone().as_ustr(), UStr::new(&[]));
    });
}

#[test]
fn test_complete_pair() {
    testlib::run("tests.StringBufTests.testCompletePair", "tests.StringBufTests.testCompletePair: a lead completed by the immediately following addChar reads as one character", || {
        test_core::TestCore::test_core_equals_string(UStr::new(&[55357,56832]), StringBufOps::string_buf_ops_complete_pair(55357, 56832).unwrap().as_ustr(), UStr::new(&[]));
    });
}

#[test]
fn test_trail_without_lead() {
    testlib::run("tests.StringBufTests.testTrailWithoutLead", "tests.StringBufTests.testTrailWithoutLead: a trail without a preceding lead faults with the argument unit", || {
        test_core::TestCore::test_core_equals_int(58320i32, i32::from_ne_bytes(((StringBufOps::string_buf_ops_caught_trail_unit(56320)) as i32).to_ne_bytes()), UStr::new(&[]));
    });
}

#[test]
fn test_dangling_lead() {
    testlib::run("tests.StringBufTests.testDanglingLead", "tests.StringBufTests.testDanglingLead: a dangling lead observed by toString faults with the held unit", || {
        test_core::TestCore::test_core_equals_int(57296i32, i32::from_ne_bytes(((StringBufOps::string_buf_ops_caught_dangling_unit(55296)) as i32).to_ne_bytes()), UStr::new(&[]));
    });
}

#[test]
fn test_add_after_lead() {
    testlib::run("tests.StringBufTests.testAddAfterLead", "tests.StringBufTests.testAddAfterLead: an add stranding a held lead faults with the held unit", || {
        test_core::TestCore::test_core_equals_int(57423i32, i32::from_ne_bytes(((StringBufOps::string_buf_ops_caught_add_after_lead_unit(55423)) as i32).to_ne_bytes()), UStr::new(&[]));
    });
}
