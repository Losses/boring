#[test]
fn path_normalize() {
    testlib::run("tests.PlatformModulesTests.pathNormalize", "tests.PlatformModulesTests.pathNormalize: std.Path normalizes mixed separators and dot segments", || {
        test_core::TestCore::test_core_equals_string(UStr::new(&[97,47,98,47,99]), PlatformOps::platform_ops_normalize(UStr::new(&[97,92,98,47,99])).as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[97,47,99]), PlatformOps::platform_ops_normalize(UStr::new(&[97,47,46,47,98,47,46,46,47,99])).as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[46,46,47,98]), PlatformOps::platform_ops_normalize(UStr::new(&[97,47,46,46,47,46,46,47,98])).as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[47,98]), PlatformOps::platform_ops_normalize(UStr::new(&[47,97,47,46,46,47,98])).as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[67,58,47,98]), PlatformOps::platform_ops_normalize(UStr::new(&[67,58,92,97,92,46,46,92,98])).as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[67,58,47]), PlatformOps::platform_ops_normalize(UStr::new(&[67,58,92,97,92,46,46,92])).as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[97,47,98]), PlatformOps::platform_ops_join(UStr::new(&[97]), UStr::new(&[98])).as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[47,97,98,115]), PlatformOps::platform_ops_join(UStr::new(&[97]), UStr::new(&[47,97,98,115])).as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[67,58,47,119,105,110]), PlatformOps::platform_ops_join(UStr::new(&[97]), UStr::new(&[67,58,47,119,105,110])).as_ustr(), UStr::new(&[]));
    });
}

#[test]
fn path_dirname() {
    testlib::run("tests.PlatformModulesTests.pathDirname", "tests.PlatformModulesTests.pathDirname: std.Path dirname follows the kind table", || {
        test_core::TestCore::test_core_equals_string(UStr::new(&[46]), PlatformOps::platform_ops_dirname(UStr::new(&[46])).as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[46]), PlatformOps::platform_ops_dirname(UStr::new(&[])).as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[47]), PlatformOps::platform_ops_dirname(UStr::new(&[47])).as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[67,58,47]), PlatformOps::platform_ops_dirname(UStr::new(&[67,58,47,97])).as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[97,47,98]), PlatformOps::platform_ops_dirname(UStr::new(&[97,47,98,47,99])).as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[46]), PlatformOps::platform_ops_dirname(UStr::new(&[97])).as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[47,47,115,47,115,104,97,114,101]), PlatformOps::platform_ops_dirname(UStr::new(&[47,47,115,47,115,104,97,114,101,47,97])).as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[47,47,115,47,115,104,97,114,101]), PlatformOps::platform_ops_dirname(UStr::new(&[92,92,115,92,115,104,97,114,101,92,97])).as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[47]), PlatformOps::platform_ops_dirname(UStr::new(&[47,97])).as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[47,47,115,47,115,104,97,114,101]), PlatformOps::platform_ops_dirname(UStr::new(&[47,47,115,47,115,104,97,114,101])).as_ustr(), UStr::new(&[]));
    });
}

