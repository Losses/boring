#[test]
fn path_expand_home() {
    testlib::run("tests.PlatformModulesTests.pathExpandHome", "tests.PlatformModulesTests.pathExpandHome: std.Path expandHome reads HOME through std.Env", || {
        let original = Env::get(UStr::new(&[72,79,77,69]));
        Env::set(UStr::new(&[72,79,77,69]), UStr::new(&[47,104,111,109,101,47,112,114,111,98,101]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[47,104,111,109,101,47,112,114,111,98,101]), Path::path_expand_home(UStr::new(&[126])).as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[47,104,111,109,101,47,112,114,111,98,101,47,120]), Path::path_expand_home(UStr::new(&[126,47,120])).as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[47,104,111,109,101,47,112,114,111,98,101]), Path::path_expand_home(UStr::new(&[126,92])).as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[47,97,98,115]), Path::path_expand_home(UStr::new(&[47,97,98,115])).as_ustr(), UStr::new(&[]));
        match &(original) {
            Some(__option) => {
                Env::set(UStr::new(&[72,79,77,69]), __option.as_ustr());
            }
            None => {
                Env::remove(UStr::new(&[72,79,77,69]));
            }
        }
    });
}
