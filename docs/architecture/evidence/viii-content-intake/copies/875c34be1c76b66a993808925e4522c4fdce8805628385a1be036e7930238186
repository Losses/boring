#[test]
fn fs_round_trip() {
    testlib::run("tests.PlatformModulesTests.fsRoundTrip", "tests.PlatformModulesTests.fsRoundTrip: std.Fs write append and read round-trip", || {
        PlatformModulesTestSupport::platform_modules_test_support_ensure_dir();
        let path = PlatformModulesTestSupport::platform_modules_test_support_text_path(UStr::new(&[114,111,117,110,100,116,114,105,112]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[102,105,114,115,116,115,101,99,111,110,100]), PlatformOps::platform_ops_write_append_read(path.as_ustr(), UStr::new(&[102,105,114,115,116]), UStr::new(&[115,101,99,111,110,100])).as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_bool(true, Fs::exists(path.as_ustr()), UStr::new(&[]));
        test_core::TestCore::test_core_equals_bool(true, Fs::is_directory(PlatformModulesTestSupport::PLATFORM_MODULES_TEST_SUPPORT_DIR.to_ustring().as_ustr()), UStr::new(&[]));
    });
}

#[test]
fn fs_make_dirs() {
    testlib::run("tests.PlatformModulesTests.fsMakeDirs", "tests.PlatformModulesTests.fsMakeDirs: std.Fs makeDirs creates a nested directory", || {
        PlatformModulesTestSupport::platform_modules_test_support_ensure_dir();
        let nested = { let mut __s = UString::new(); __s += PlatformModulesTestSupport::PLATFORM_MODULES_TEST_SUPPORT_DIR.to_ustring().as_ustr(); __s += &(UString::from("/a/b/c")); __s };
        test_core::TestCore::test_core_equals_bool(true, PlatformOps::platform_ops_make_dirs_check(nested.as_ustr()), UStr::new(&[]));
        test_core::TestCore::test_core_equals_bool(true, Fs::is_directory(UString::from(format!("{}", { let mut __s = UString::new(); __s += PlatformModulesTestSupport::PLATFORM_MODULES_TEST_SUPPORT_DIR.to_ustring().as_ustr(); __s += &(UString::from("/a/b")); __s }).as_str()).as_ustr()), UStr::new(&[]));
    });
}

