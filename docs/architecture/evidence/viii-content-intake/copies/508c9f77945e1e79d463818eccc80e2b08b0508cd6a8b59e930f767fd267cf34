package boring

import boring.runtime.SortedMapTable
import boring.runtime.SortedTable

object IntFloatSignOps {
    fun delta(a: Int, b: Int): Int {
        return a - b
    }

    fun belowHalf(a: Int, b: Int): Boolean {
        val d = a - b
        return (d).toFloat() < 0.5f
    }

    fun equalsCollapsed(a: Int, b: Int): Boolean {
        val c = 0.0f
        if ((c == null)) {
            return false
        }
        val d = a - b
        return c > (d).toFloat()
    }

    fun compoundSum(a: Int, b: Int): Float {
        var f = 0.5f
        f += (a - b).toFloat()
        return f
    }

    fun firstElem(a: Int, b: Int): Float {
        val arr_1 = 2.5f
        val arr_0 = (a - b).toFloat()
        return arr_0
    }

    fun asOptional(a: Int, b: Int): Float? {
        if ((a != b)) {
            return (a - b).toFloat()
        }
        return null
    }

    fun ternaryFallback(m: SortedMapTable<Int, Float>, a: Int, b: Int): Float {
        return (if ((m.has(7))) m.get(7) else (a - b).toFloat())!!
    }

    fun sampleMap(): SortedMapTable<Int, Float> {
        val b = SortedTable.mapBuilder<Int, Float>(SortedTable::compareInts)
        b.put(4, 0.5f)
        return b.build()
    }
}
