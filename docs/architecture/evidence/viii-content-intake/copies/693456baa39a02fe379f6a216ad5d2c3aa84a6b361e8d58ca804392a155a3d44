package boring

object StringSearchFromOps {
    fun twoBlocks(): String {
        return "\\patterns{\na1b\n}\n\\hyphenation{\ntable\n}"
    }

    fun findFrom(text: String, sub: String, from: Int): Int {
        return text.indexOf(sub, from)
    }

    fun findLastFrom(text: String, sub: String, from: Int): Int {
        return text.lastIndexOf(sub, from)
    }

    fun blockBody(text: String, name: String): String {
        val start = text.indexOf(name)
        val open = text.indexOf("{", start)
        val close = text.indexOf("}", open + 1)
        return run { val _s = text; val _from = open + 1; val _to = close; val _start = if (_from < 0) 0 else if (_from > _s.length) _s.length else _from; val _end = if (_to < 0) 0 else if (_to > _s.length) _s.length else _to; if (_start > _end) _s.substring(_end, _start) else _s.substring(_start, _end) }
    }
}
