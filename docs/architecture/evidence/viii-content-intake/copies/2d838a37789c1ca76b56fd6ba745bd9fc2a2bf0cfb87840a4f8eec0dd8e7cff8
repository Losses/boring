class TypeProbe {
    static function coalesced(values:Null<Array<Int>>):String {
        final ternary = values == null ? [] : values;
        // Force Haxe to reveal the inferred type:
        // If ternary were Null<Array<Int>>, assigning to Array<Int> would error.
        final asRequired:Array<Int> = ternary; // line: requires non-null type
        return asRequired.length + ":" + ternary;
    }
    static function main() {
        trace(coalesced(null));
        trace(coalesced([9]));
    }
}
