#![cfg(test)]

use crate::boring::switch_ops::SwitchMark;
use crate::boring::switch_ops::SwitchOps;
use crate::runtime::test as testlib;
use crate::runtime::test_core;
use crate::runtime::u_string::UStr;
use crate::runtime::u_string::UString;


#[test]
fn test_assign() {
    testlib::run("tests.SwitchOpsTests.testAssign", "tests.SwitchOpsTests.testAssign: switch assign position lowers", || {
        test_core::TestCore::test_core_equals_string(UStr::new(&[101,109,112,116,121]), SwitchOps::switch_ops_assign((SwitchMark::Empty).clone()).as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[116,101,120,116,58,121]), SwitchOps::switch_ops_assign(SwitchMark::Text { value: UString::from("y") }).as_ustr(), UStr::new(&[]));
    });
}

#[test]
fn test_statement() {
    testlib::run("tests.SwitchOpsTests.testStatement", "tests.SwitchOpsTests.testStatement: switch statement assignment lowers", || {
        test_core::TestCore::test_core_equals_string(UStr::new(&[101,109,112,116,121]), SwitchOps::switch_ops_statement((SwitchMark::Empty).clone()).as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[110,117,109,98,101,114,58,51]), SwitchOps::switch_ops_statement(SwitchMark::Number { value: 3 }).as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[116,101,120,116,58,120]), SwitchOps::switch_ops_statement(SwitchMark::Text { value: UString::from("x") }).as_ustr(), UStr::new(&[]));
    });
}

#[test]
fn test_initializer() {
    testlib::run("tests.SwitchOpsTests.testInitializer", "tests.SwitchOpsTests.testInitializer: switch initializer lowers", || {
        test_core::TestCore::test_core_equals_string(UStr::new(&[110,117,109,98,101,114,58,52]), SwitchOps::switch_ops_initializer(SwitchMark::Number { value: 4 }).as_ustr(), UStr::new(&[]));
    });
}

#[test]
fn test_default() {
    testlib::run("tests.SwitchOpsTests.testDefault", "tests.SwitchOpsTests.testDefault: switch default lowers", || {
        test_core::TestCore::test_core_equals_string(UStr::new(&[101,109,112,116,121]), SwitchOps::switch_ops_defaulted((SwitchMark::Empty).clone()).as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[102,97,108,108,98,97,99,107]), SwitchOps::switch_ops_defaulted((SwitchMark::Other).clone()).as_ustr(), UStr::new(&[]));
    });
}

#[test]
fn test_conditional() {
    testlib::run("tests.SwitchOpsTests.testConditional", "tests.SwitchOpsTests.testConditional: switch inside a conditional arm lowers", || {
        test_core::TestCore::test_core_equals_string(UStr::new(&[102,97,108,108,98,97,99,107]), SwitchOps::switch_ops_conditional((SwitchMark::Empty).clone(), true).as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[101,109,112,116,121]), SwitchOps::switch_ops_conditional((SwitchMark::Empty).clone(), false).as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[110,117,109,98,101,114,58,51]), SwitchOps::switch_ops_conditional(SwitchMark::Number { value: 3 }, false).as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[116,101,120,116,58,120]), SwitchOps::switch_ops_conditional(SwitchMark::Text { value: UString::from("x") }, false).as_ustr(), UStr::new(&[]));
    });
}
