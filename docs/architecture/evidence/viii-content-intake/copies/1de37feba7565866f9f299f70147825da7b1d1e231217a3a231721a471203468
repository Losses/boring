#[test]
fn test_map() {
    testlib::run("tests.PipelineTests.testMap", "tests.PipelineTests.testMap: map transforms elements and pre-allocates fill", || {
        let empty: Vec<Item> = Vec::new();
        let empty_doubled = PipelineOps::pipeline_ops_double_scores(&empty);
        test_core::TestCore::test_core_equals_int(0i32, i32::from_ne_bytes(((u32::try_from((empty_doubled.len()) & 0xFFFF_FFFF).unwrap_or(0)) as i32).to_ne_bytes()), UStr::new(&[101,109,112,116,121,32,109,97,112,32,108,101,110,103,116,104]));
        let items = vec![
    (Item { id: 1, name: UString::from("Alice").to_ustring(), score: 10 }).clone(),
    (Item { id: 2, name: UString::from("Bob").to_ustring(), score: 25 }).clone(),
    (Item { id: 3, name: UString::from("Charlie").to_ustring(), score: 40 }).clone(),
];
        let doubled = PipelineOps::pipeline_ops_double_scores(&items);
        test_core::TestCore::test_core_equals_int(3i32, i32::from_ne_bytes(((u32::try_from((doubled.len()) & 0xFFFF_FFFF).unwrap_or(0)) as i32).to_ne_bytes()), UStr::new(&[100,111,117,98,108,101,100,32,108,101,110,103,116,104]));
        test_core::TestCore::test_core_equals_int(20i32, { let v: u32 = doubled[0usize]; i32::from_ne_bytes(v.to_ne_bytes()) }, UStr::new(&[100,111,117,98,108,101,100,32,48]));
        test_core::TestCore::test_core_equals_int(50i32, { let v: u32 = doubled[1usize]; i32::from_ne_bytes(v.to_ne_bytes()) }, UStr::new(&[100,111,117,98,108,101,100,32,49]));
        test_core::TestCore::test_core_equals_int(80i32, { let v: u32 = doubled[2usize]; i32::from_ne_bytes(v.to_ne_bytes()) }, UStr::new(&[100,111,117,98,108,101,100,32,50]));
    });
}

