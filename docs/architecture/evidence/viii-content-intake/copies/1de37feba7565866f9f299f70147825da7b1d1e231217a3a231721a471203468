#[test]
fn test_associate() {
    testlib::run("tests.PipelineTests.testAssociate", "tests.PipelineTests.testAssociate: associate builds sorted map with last-wins on duplicate keys", || {
        let empty: Vec<Item> = Vec::new();
        let empty_map: SortedMapTable<u32, UString> = PipelineOps::pipeline_ops_associate_by_id(&empty);
        test_core::TestCore::test_core_equals_int(0i32, i32::from_ne_bytes(((u32::from_ne_bytes(((empty_map.size()) as u32).to_ne_bytes())) as i32).to_ne_bytes()), UStr::new(&[101,109,112,116,121,32,109,97,112,32,115,105,122,101]));
        let items = vec![
    (Item { id: 3, name: UString::from("Charlie").to_ustring(), score: 40 }).clone(),
    (Item { id: 1, name: UString::from("Alice").to_ustring(), score: 10 }).clone(),
    (Item { id: 2, name: UString::from("Bob").to_ustring(), score: 25 }).clone(),
];
        let map: SortedMapTable<u32, UString> = PipelineOps::pipeline_ops_associate_by_id(&items);
        test_core::TestCore::test_core_equals_int(3i32, i32::from_ne_bytes(((u32::from_ne_bytes(((map.size()) as u32).to_ne_bytes())) as i32).to_ne_bytes()), UStr::new(&[109,97,112,32,115,105,122,101]));
        assert_equals_opt_string(&Some(UString::from("Alice")), &map.get(&(1)), UStr::new(&[103,101,116,32,49]));
        assert_equals_opt_string(&Some(UString::from("Bob")), &map.get(&(2)), UStr::new(&[103,101,116,32,50]));
        assert_equals_opt_string(&Some(UString::from("Charlie")), &map.get(&(3)), UStr::new(&[103,101,116,32,51]));
        let items_with_dup = vec![
    (Item { id: 1, name: UString::from("First").to_ustring(), score: 10 }).clone(),
    (Item { id: 1, name: UString::from("Updated").to_ustring(), score: 20 }).clone(),
];
        let map_dup: SortedMapTable<u32, UString> = PipelineOps::pipeline_ops_associate_by_id(&items_with_dup);
        test_core::TestCore::test_core_equals_int(1i32, i32::from_ne_bytes(((u32::from_ne_bytes(((map_dup.size()) as u32).to_ne_bytes())) as i32).to_ne_bytes()), UStr::new(&[100,117,112,32,109,97,112,32,115,105,122,101]));
        assert_equals_opt_string(&Some(UString::from("Updated")), &map_dup.get(&(1)), UStr::new(&[100,117,112,32,111,118,101,114,119,114,105,116,101]));
    });
}

