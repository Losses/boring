#[test]
fn test_first_or_null() {
    testlib::run("tests.PipelineTests.testFirstOrNull", "tests.PipelineTests.testFirstOrNull: firstOrNull finds first matching element or returns null", || {
        let empty: Vec<Item> = Vec::new();
        let empty_result = PipelineOps::pipeline_ops_find_first_high_score(&empty, 20);
        test_core::TestCore::test_core_equals_bool(true, empty_result.is_none(), UStr::new(&[101,109,112,116,121,32,102,105,114,115,116,79,114,78,117,108,108,32,105,115,32,110,117,108,108]));
        let items = vec![
    (Item { id: 1, name: UString::from("Alice").to_ustring(), score: 10 }).clone(),
    (Item { id: 2, name: UString::from("Bob").to_ustring(), score: 25 }).clone(),
    (Item { id: 3, name: UString::from("Charlie").to_ustring(), score: 40 }).clone(),
];
        let no_match = PipelineOps::pipeline_ops_find_first_high_score(&items, 50);
        test_core::TestCore::test_core_equals_bool(true, no_match.is_none(), UStr::new(&[110,111,32,109,97,116,99,104,32,102,105,114,115,116,79,114,78,117,108,108,32,105,115,32,110,117,108,108]));
        let matched_item = PipelineOps::pipeline_ops_find_first_high_score(&items, 20);
        test_core::TestCore::test_core_equals_bool(true, matched_item.is_some(), UStr::new(&[109,97,116,99,104,32,105,115,32,110,111,116,32,110,117,108,108]));
