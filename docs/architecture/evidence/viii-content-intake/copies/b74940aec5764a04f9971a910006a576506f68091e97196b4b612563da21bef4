#![cfg(test)]

use crate::boring::neg_int_slot_ops::NegIntSlotOps;
use crate::runtime::test as testlib;
use crate::runtime::test_core;
use crate::runtime::u_string::UStr;


#[test]
fn negate() {
    testlib::run("tests.NegIntSlotOpsTests.negate", "tests.NegIntSlotOpsTests.negate: a negated Int reinterprets at the u32 return and argument slots", || {
        test_core::TestCore::test_core_equals_int(-5i32, i32::from_ne_bytes(((NegIntSlotOps::neg_int_slot_ops_negate(5)) as i32).to_ne_bytes()), UStr::new(&[100,105,114,101,99,116,32,110,101,103,97,116,105,111,110]));
        test_core::TestCore::test_core_equals_int(-7i32, i32::from_ne_bytes(((NegIntSlotOps::neg_int_slot_ops_negate_argument(7)) as i32).to_ne_bytes()), UStr::new(&[110,101,103,97,116,101,100,32,97,114,103,117,109,101,110,116]));
        test_core::TestCore::test_core_equals_int(0i32, i32::from_ne_bytes(((NegIntSlotOps::neg_int_slot_ops_negate(0)) as i32).to_ne_bytes()), UStr::new(&[122,101,114,111,32,110,101,103,97,116,105,111,110]));
    });
}

#[test]
fn negate_conditional() {
    testlib::run("tests.NegIntSlotOpsTests.negateConditional", "tests.NegIntSlotOpsTests.negateConditional: a negated conditional arm carries the u32 slot type", || {
        test_core::TestCore::test_core_equals_int(-3i32, i32::from_ne_bytes(((NegIntSlotOps::neg_int_slot_ops_negate_conditional(true, 3)) as i32).to_ne_bytes()), UStr::new(&[110,101,103,97,116,105,118,101,32,97,114,109]));
        test_core::TestCore::test_core_equals_int(4i32, i32::from_ne_bytes(((NegIntSlotOps::neg_int_slot_ops_negate_conditional(false, 4)) as i32).to_ne_bytes()), UStr::new(&[112,111,115,105,116,105,118,101,32,97,114,109]));
    });
}
