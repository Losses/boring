package tests

import boring.StaticFnOps
import boring.runtime.test.Test

class StaticFnTests {
@boring.test.Test
    fun testFunctionStatic() {
        Test.run("tests.StaticFnTests.testFunctionStatic", "tests.StaticFnTests.testFunctionStatic: static function values can be called") {
                Test.equals("ok!", StaticFnOps.apply("ok"), null)
        }
    }

@boring.test.Test
    fun testIntStatic() {
        Test.run("tests.StaticFnTests.testIntStatic", "tests.StaticFnTests.testIntStatic: ordinary mutable static remains shared") {
                Test.equals(1, StaticFnOps.increment(), null)
                Test.equals(2, StaticFnOps.increment(), null)
        }
    }
}
