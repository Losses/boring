        Self {
            role,
            note,
        }
    }

    pub fn to_string(&self) -> UString {
        return UString::from(format!("{}", { let mut __s = UString::new(); __s += &(UString::from("RichTextSpan(")); __s += &(UString::from("role=")); __s += UString::from(format!("{}", self.role.to_string()).as_str()).as_ustr(); __s += &(UString::from(", ")); __s += &(UString::from("note=")); __s += (match &(self.note) { None => UString::from("null"), Some(__option) => UString::from(format!("{}", __option.to_string()).as_str()) }).as_ustr(); __s += &(UString::from(")")); __s }).as_str());
