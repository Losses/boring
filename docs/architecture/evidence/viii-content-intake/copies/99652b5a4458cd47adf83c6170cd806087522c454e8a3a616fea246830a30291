    fn large_start(&self) -> i64 {
        let mut h = Xxh64::xxh64_rotl(self.v1, 1).wrapping_add(Xxh64::xxh64_rotl(self.v2, 7)).wrapping_add(Xxh64::xxh64_rotl(self.v3, 12)).wrapping_add(Xxh64::xxh64_rotl(self.v4, 18));
        h = Xxh64::xxh64_merge(h, self.v1);
        h = Xxh64::xxh64_merge(h, self.v2);
        h = Xxh64::xxh64_merge(h, self.v3);
        h = Xxh64::xxh64_merge(h, self.v4);
        return h;
    }

    fn consume_mem(&mut self) {
        self.v1 = Xxh64::xxh64_round(self.v1, self.read_mem(0));
        self.v2 = Xxh64::xxh64_round(self.v2, self.read_mem(8));
        self.v3 = Xxh64::xxh64_round(self.v3, self.read_mem(16));
        self.v4 = Xxh64::xxh64_round(self.v4, self.read_mem(24));
    }

    fn read_mem(&self, p: u32) -> i64 {
        return i64::from(self.read32_mem(u32::wrapping_add(p, 4))) << 32 | i64::from(self.read32_mem(p));
    }

    fn read32_mem(&self, p: u32) -> u32 {
        return self.mem[usize::try_from(p).unwrap_or(0)] | (self.mem[usize::try_from(u32::wrapping_add(p, 1)).unwrap_or(0)]) << (8) | (self.mem[usize::try_from(u32::wrapping_add(p, 2)).unwrap_or(0)]) << (16) | (self.mem[usize::try_from(u32::wrapping_add(p, 3)).unwrap_or(0)]) << (24);
    }

    pub(crate) fn xxh64_p1() -> i64 {
        return 2654435761i64 << 32 | 2246822535i64;
    }

    pub(crate) fn xxh64_p2() -> i64 {
        return 3266489917i64 << 32 | 668265295i64;
    }

    pub(crate) fn xxh64_p3() -> i64 {
        return 374761393i64 << 32 | 2654435833i64;
    }

    pub(crate) fn xxh64_p4() -> i64 {
        return 2246822519i64 << 32 | 3266489955i64;
    }

    pub(crate) fn xxh64_p5() -> i64 {
        return 668265263i64 << 32 | 374761413i64;
    }

    pub fn xxh64_make(data: &[u8], seed: i64) -> i64 {
        let mut x = Xxh64::new(seed);
        x.update(&data);
        return x.digest();
    }

    pub(crate) fn xxh64_read(data: &[u8], p: u32) -> i64 {
        return i64::from(Xxh64::xxh64_read32(&data, u32::wrapping_add(p, 4))) << 32 | i64::from(Xxh64::xxh64_read32(&data, p));
    }

    pub(crate) fn xxh64_read32(data: &[u8], p: u32) -> u32 {
        return u32::from(data[usize::try_from(p).unwrap_or(0)]) | (u32::from(data[usize::try_from(u32::wrapping_add(p, 1)).unwrap_or(0)])) << (8) | (u32::from(data[usize::try_from(u32::wrapping_add(p, 2)).unwrap_or(0)])) << (16) | (u32::from(data[usize::try_from(u32::wrapping_add(p, 3)).unwrap_or(0)])) << (24);
    }

    pub(crate) fn xxh64_round(acc: i64, input: i64) -> i64 {
        let mut x = acc.wrapping_add((input).wrapping_mul(Xxh64::xxh64_p2()));
        x = Xxh64::xxh64_rotl(x, 31);
        return (x).wrapping_mul(Xxh64::xxh64_p1());
    }

    pub(crate) fn xxh64_merge(acc: i64, v: i64) -> i64 {
        let x = Xxh64::xxh64_round(0i64, v);
        return (acc ^ x).wrapping_mul(Xxh64::xxh64_p1()).wrapping_add(Xxh64::xxh64_p4());
    }

    pub(crate) fn xxh64_rotl(x: i64, n: u32) -> i64 {
        return x.wrapping_shl(n) | i64::from_ne_bytes(u64::from_ne_bytes((x).to_ne_bytes()).wrapping_shr(u32::wrapping_sub(64, n)).to_ne_bytes());
    }

    pub(crate) fn xxh64_avalanche(x: i64) -> i64 {
        let mut h = x;
        h = h ^ i64::from_ne_bytes(u64::from_ne_bytes((h).to_ne_bytes()).wrapping_shr(33u32).to_ne_bytes());
        h = (h).wrapping_mul(Xxh64::xxh64_p2());
        h = h ^ i64::from_ne_bytes(u64::from_ne_bytes((h).to_ne_bytes()).wrapping_shr(29u32).to_ne_bytes());
        h = (h).wrapping_mul(Xxh64::xxh64_p3());
        h = h ^ i64::from_ne_bytes(u64::from_ne_bytes((h).to_ne_bytes()).wrapping_shr(32u32).to_ne_bytes());
