pub struct Xxh64 {
    pub(crate) seed: i64,
    pub(crate) v1: i64,
    pub(crate) v2: i64,
    pub(crate) v3: i64,
    pub(crate) v4: i64,
    pub(crate) mem: Vec<u32>,
    pub(crate) total_len: i64,
    pub(crate) large: bool,
}

impl Xxh64 {
    pub fn new(seed: i64) -> Self {
        Self {
            seed,
            v1: seed.wrapping_add(Xxh64::xxh64_p1()).wrapping_add(Xxh64::xxh64_p2()),
            v2: seed.wrapping_add(Xxh64::xxh64_p2()),
            v3: seed,
            v4: seed.wrapping_sub(Xxh64::xxh64_p1()),
            mem: vec![],
            total_len: 0i64,
            large: false,
        }
    }

    pub fn update(&mut self, data: &[u8]) {
        self.total_len = self.total_len.wrapping_add(i64::from((u32::try_from((data.len()) & 0xFFFF_FFFF).unwrap_or(0)) ^ 0x8000_0000u32).wrapping_sub(0x8000_0000i64));
        let mut p = 0;
        if i32::from_ne_bytes(((u32::wrapping_add(u32::try_from((self.mem.len()) & 0xFFFF_FFFF).unwrap_or(0), u32::try_from((data.len()) & 0xFFFF_FFFF).unwrap_or(0))) as i32).to_ne_bytes()) < (32) {
            for i in 0..match u32::try_from(data.len()) { Ok(value) => value, Err(_) => u32::MAX } {
                self.mem.push(u32::from(data[usize::try_from(i).unwrap_or(0)]));
            }
            return;
        }
        if i32::from_ne_bytes(((u32::try_from((self.mem.len()) & 0xFFFF_FFFF).unwrap_or(0)) as i32).to_ne_bytes()) > (0) {
            while (i32::from_ne_bytes(((u32::try_from((self.mem.len()) & 0xFFFF_FFFF).unwrap_or(0)) as i32).to_ne_bytes())) < (32) {
                self.mem.push(u32::from(data[usize::try_from({ let t = p; p = i32::wrapping_add(p, 1); t }).unwrap_or(0)]));
            }
            self.consume_mem();
            self.mem = vec![];
            self.large = true;
        }
        while (p) <= i32::wrapping_sub(i32::from_ne_bytes(((i32::from_ne_bytes(u32::try_from(((data).len()) & 4294967295).unwrap_or(0).to_ne_bytes())) as i32).to_ne_bytes()), 32) {
            self.v1 = Xxh64::xxh64_round(self.v1, Xxh64::xxh64_read(&data, u32::from_ne_bytes(((p) as u32).to_ne_bytes())));
            self.v2 = Xxh64::xxh64_round(self.v2, Xxh64::xxh64_read(&data, u32::from_ne_bytes(((i32::wrapping_add(p, 8)) as u32).to_ne_bytes())));
            self.v3 = Xxh64::xxh64_round(self.v3, Xxh64::xxh64_read(&data, u32::from_ne_bytes(((i32::wrapping_add(p, 16)) as u32).to_ne_bytes())));
            self.v4 = Xxh64::xxh64_round(self.v4, Xxh64::xxh64_read(&data, u32::from_ne_bytes(((i32::wrapping_add(p, 24)) as u32).to_ne_bytes())));
            p = i32::wrapping_add(p, 32);
            self.large = true;
        }
        while (p) < (i32::from_ne_bytes(u32::try_from(((data).len()) & 4294967295).unwrap_or(0).to_ne_bytes())) {
            self.mem.push(u32::from(data[usize::try_from({ let t = p; p = i32::wrapping_add(p, 1); t }).unwrap_or(0)]));
        }
    }

    pub fn digest(&self) -> i64 {
        let mut h = if self.large { self.large_start() } else { self.seed.wrapping_add(Xxh64::xxh64_p5()) };
        h = h.wrapping_add(self.total_len);
        let mut p = 0;
        while (p) <= i32::wrapping_sub(i32::from_ne_bytes(((i32::from_ne_bytes(u32::try_from((((self.mem).clone()).len()) & 4294967295).unwrap_or(0).to_ne_bytes())) as i32).to_ne_bytes()), 8) {
            h = h ^ Xxh64::xxh64_round(0i64, self.read_mem(u32::from_ne_bytes(((p) as u32).to_ne_bytes())));
            h = (Xxh64::xxh64_rotl(h, 27)).wrapping_mul(Xxh64::xxh64_p1()).wrapping_add(Xxh64::xxh64_p4());
            p = i32::wrapping_add(p, 8);
        }
        if p <= i32::wrapping_sub(i32::from_ne_bytes(((i32::from_ne_bytes(u32::try_from((((self.mem).clone()).len()) & 4294967295).unwrap_or(0).to_ne_bytes())) as i32).to_ne_bytes()), 4) {
            h = h ^ (0i64 << 32 | i64::from(self.read32_mem(u32::from_ne_bytes(((p) as u32).to_ne_bytes())))).wrapping_mul(Xxh64::xxh64_p1());
            h = (Xxh64::xxh64_rotl(h, 23)).wrapping_mul(Xxh64::xxh64_p2()).wrapping_add(Xxh64::xxh64_p3());
            p = i32::wrapping_add(p, 4);
        }
        while (p) < (i32::from_ne_bytes(u32::try_from((((self.mem).clone()).len()) & 4294967295).unwrap_or(0).to_ne_bytes())) {
            h = h ^ (i64::from((self.mem[usize::try_from(p).unwrap_or(0)]) ^ 0x8000_0000u32).wrapping_sub(0x8000_0000i64)).wrapping_mul(Xxh64::xxh64_p5());
            h = (Xxh64::xxh64_rotl(h, 11)).wrapping_mul(Xxh64::xxh64_p1());
            p = i32::wrapping_add(p, 1);
