package tests

import boring.runtime.test.Test
import haxe.crypto.Sha512

class Sha512Tests {
@boring.test.Test
    fun empty() {
        Test.run("tests.Sha512Tests.empty", "tests.Sha512Tests.empty: hashes the empty byte sequence") {
                Test.equals("cf83e1357eefb8bdf1542850d66d8007d620e4050b5715dc83f4a921d36ce9ce47d0d13c5d85f2b0ff8318d2877eec2f63b931bd47417a81a538327af927da3e", Sha512TestSupport.hex(Sha512.make(ByteArray(0))), null)
        }
    }

@boring.test.Test
    fun abc() {
        Test.run("tests.Sha512Tests.abc", "tests.Sha512Tests.abc: hashes abc") {
                val bytes = ByteArray(3)
                bytes[0] = 97.toByte()
                bytes[1] = 98.toByte()
                bytes[2] = 99.toByte()
                Test.equals("ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f", Sha512TestSupport.hex(Sha512.make(bytes)), null)
        }
    }

@boring.test.Test
    fun incremental() {
        Test.run("tests.Sha512Tests.incremental", "tests.Sha512Tests.incremental: matches incremental updates") {
                val bytes = ByteArray(128)
                val hash = Sha512()
                hash.update(bytes.copyOfRange(0, 0 + 31))
                hash.update(bytes.copyOfRange(31, 31 + 64))
                hash.update(bytes.copyOfRange(95, 95 + 33))
                Test.equals(Sha512TestSupport.hex(Sha512.make(bytes)), Sha512TestSupport.hex(hash.digest()), null)
        }
    }
}
