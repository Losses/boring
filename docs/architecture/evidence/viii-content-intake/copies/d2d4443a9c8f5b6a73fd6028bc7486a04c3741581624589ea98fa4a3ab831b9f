object PromotedSubjectOracle {
    fun promotedSubject(holder: KindHolder): Int {
        var acc = 0
        run {
            val _g = holder.state
            when (_g) {
    is Kind.A -> acc = 1
    is Kind.B -> acc = _g.value
    is Kind.C -> acc = 3
}
        }
        return acc
    }

    fun main() {
    }
}
