#!/usr/bin/env bash
# Regression-fix verification runner.
# usage: bash run-one.sh <state:pristine|postfix|fixed> <key> <mode:gen|build|full>
# Evidence: dc-warn/out/rust-regression-fix/<label>-<key>/  (label = prefix for
# pristine, negctl for the as-reviewed patch, postfix for the fix)
set -uo pipefail
TOP=/home/losses/Development/tq-workspace
WT=$TOP/dc-warn/worktrees/rust-regression-fix
SRC=$WT/packages/compiler/reflaxe/rust/rustcompiler
EV=$TOP/dc-warn/out/rust-regression-fix
STATE=$1; KEY=$2; MODE=$3
case $STATE in
  pristine) LABEL=prefix ;;
  postfix)  LABEL=negctl ;;   # the as-reviewed patch that failed review
  fixed)    LABEL=postfix ;;  # this correction
esac
SRCDIR=$TOP/dc-warn/out/rust-regression-fix/src-$STATE
case $STATE in
  pristine)
    mkdir -p "$SRCDIR"
    for f in Compiler.hx RustDecl.hx RustExpr.hx RustEmissionState.hx; do
      git -C "$WT" show e1c65975:packages/compiler/reflaxe/rust/rustcompiler/$f > "$SRCDIR/$f"
    done ;;
  postfix|fixed)
    SRCDIR=$TOP/dc-warn/out/rust-regression-fix/src-postfix
    mkdir -p "$SRCDIR"
    for f in RustDecl.hx RustExpr.hx RustEmissionState.hx; do
      cp "$TOP/boring-wt-architecture/packages/compiler/reflaxe/rust/rustcompiler/$f" "$SRCDIR/$f"
    done
    if [ $STATE = postfix ]; then
      cp "$TOP/boring-wt-architecture/packages/compiler/reflaxe/rust/rustcompiler/Compiler.hx" "$SRCDIR/Compiler.hx"
    else
      cp "$EV/src-fixed/Compiler.hx" "$SRCDIR/Compiler.hx"
    fi ;;
esac
cp "$SRCDIR"/*.hx "$SRC/"
export XDG_CACHE_HOME=/tmp/rustreg-nix-cache
EV="$EV/$LABEL-$KEY"; GEN=/tmp/rustreg-gen-$STATE-$KEY; TGT=/tmp/rustreg-tgt-$STATE
rm -rf "$EV" "$GEN"; mkdir -p "$EV" "$GEN"
( cd "$WT" && sha256sum "$SRCDIR"/Compiler.hx "$SRCDIR"/RustDecl.hx "$SRCDIR"/RustExpr.hx "$SRCDIR"/RustEmissionState.hx > "$EV/src-hashes.txt" )
record() { printf '%s\t%s\n' "$1" "$2" >>"$EV/status.tsv"; }
: >"$EV/status.tsv"
stage() {
  local name=$1; shift
  local d="$EV/$name"; mkdir -p "$d"
  { printf 'cwd %s\nargv' "$WT"; printf ' %q' "$@"; printf '\n'; } >"$d/argv"
  ( cd "$WT" && "$@" ) >"$d/stdout" 2>"$d/stderr"
  local rc=$?
  printf '%s\n' "$rc" >"$d/status"
  record "$name" "$rc"
  return $rc
}
stage gen-rust nix develop -c haxe "tests/haxe/$KEY/gen/rust.hxml" -D rust-output="$GEN"
GS=$?
[ "$MODE" = gen ] && exit $GS
( cd "$GEN" && find . -type f -not -path './target/*' -print0 | sort -z | xargs -0 sha256sum ) >"$EV/gen-tree.sha256"
mkdir -p "$GEN/src"
if [ -f "$WT/tests/haxe/$KEY/native/harness.rs" ]; then
  cp "$WT/tests/haxe/$KEY/native/harness.rs" "$GEN/src/main.rs"
elif [ -f "$GEN/src/main.rs" ]; then
  : # generator emitted its own entry
else
  printf 'fn main() {}\n' >"$GEN/src/main.rs"
fi
CARGO_TARGET_DIR="$TGT" stage compile-rust nix develop -c bash -c "cd '$GEN' && timeout 1800 cargo build --offline"
CS=$?
[ "$MODE" = build ] && exit $CS
stage run-rust timeout 120 "$TGT/debug/generated"
RS=$?
stage compare-rust diff -u "$WT/tests/haxe/$KEY/expected.txt" "$EV/run-rust/stdout"
exit $?
