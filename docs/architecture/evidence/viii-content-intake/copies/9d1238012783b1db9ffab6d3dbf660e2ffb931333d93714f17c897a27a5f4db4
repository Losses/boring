#!/usr/bin/env bash
# Builds the three crafted logs used to prove the classifier discriminates.
# Provenance, per crafted log, is recorded in the log header comment and in REPORT.md:
#  - crafted-assertion.log: the assertion block is the RETAINED block from
#    dc-warn/out/ci-wire/evidence/recorded-baseline-proof-run.log (arithmetic-helpers
#    Rust inlining, tests/ts/arithmetic-helpers.test.ts:54), the only change being
#    that the log is reduced to that one failure and a consistent summary/recap.
#  - crafted-timeout.log: the timeout + "# Unhandled error between tests" cascade is
#    the RETAINED block from the same log (sealed-variants.test.ts), reduced the same
#    way.
#  - crafted-flake.log: the error block is bun 1.3.13's real rendering for
#    expect(Buffer).toEqual(Buffer), captured in scratch/bufshape.test.ts (see
#    bufshape.log), re-pointed at tests/ts/package-artifacts.test.ts:338 and at the
#    byte-identity test's real name. No retained log of the flake exists in this
#    workspace (see REPORT.md "unverified").
set -eu
B="$(cd "$(dirname "$0")" && pwd)"
RET=/home/losses/Development/tq-workspace/dc-warn/out/ci-wire/evidence/recorded-baseline-proof-run.log
: > "$B/crafted-assertion.log"
{
  printf '$ bun test tests/ packages/registry/tests/\n'
  printf 'bun test v1.3.13 (bf2e2cec)\n\n'
  sed -n '36,54p' "$RET"
  printf '\n'
  printf 'tests/ts/right-int.test.ts:\n'
  printf '(pass) right-int helpers generated tree > folds through the native operator [1.00ms]\n'
  printf '(pass) right-int helpers generated tree > keeps the comparison in the target type\n'
  printf '\n'
  printf '1 tests failed:\n'
  sed -n '54p' "$RET"
  printf '\n'
  printf ' 2 pass\n 1 fail\n 1 expect() calls\nRan 3 tests across 2 files. [120.00ms]\n'
  printf 'error: script "test" exited with code 1\n'
} > "$B/crafted-assertion.log"

: > "$B/crafted-timeout.log"
{
  printf '$ bun test tests/ packages/registry/tests/\n'
  printf 'bun test v1.3.13 (bf2e2cec)\n\n'
  printf 'tests/ts/sealed-variants.test.ts:\n'
  printf '(pass) @:sealed on a class reports the interface-only error setup [2.00ms]\n'
  sed -n '362,387p' "$RET"
  printf '\n'
  printf 'tests/ts/vector.test.ts:\n'
  printf '(pass) committed cross-language vector > decoded binary matches the JSON description [3.00ms]\n'
  printf '\n'
  printf '2 tests failed:\n'
  sed -n '383,384p' "$RET"
  sed -n '404,405p' "$RET"
  printf '\n'
  printf ' 1 pass\n 2 fail\n 8 errors\n 2 expect() calls\nRan 3 tests across 2 files. [20120.00ms]\n'
  printf 'error: script "test" exited with code 1\n'
} > "$B/crafted-timeout.log"

: > "$B/crafted-flake.log"
{
  printf '$ bun test tests/ packages/registry/tests/\n'
  printf 'bun test v1.3.13 (bf2e2cec)\n\n'
  printf 'tests/ts/package-artifacts.test.ts:\n'
  printf '(pass) package artifact emission > the npm tarball carries the compiled entries [30210.00ms]\n'
  printf '(pass) package artifact emission > the cargo crate and the Pub archive keep the tree at the root [15500.00ms]\n'
  printf '320 |   test("two generations of the same inputs produce byte-identical artifacts", async () => {\n'
  printf '...\n'
  printf '338 |         expect(fs.readFileSync(path.join(second, pkg.file))).toEqual(fs.readFileSync(path.join(first, pkg.file)));\n'
  printf '                                                                     ^\n'
  printf 'error: expect(received).toEqual(expected)\n\n'
  printf '  {\n    "data": [\n      80,\n      75,\n      3,\n      4,\n      20,\n      0,\n'
  printf -- '-     77,\n-     97,\n-     116,\n-     104,\n-     78,\n-     97,\n-     78,\n'
  printf '       1,\n       0,\n'
  printf -- '+     32,\n+     32,\n+     32,\n+     32,\n+     32,\n+     32,\n+     32,\n'
  printf '      0,\n    ],\n    "type": "Buffer",\n  }\n\n'
  printf -- '- Expected  - 7\n+ Received  + 7\n\n'
  printf '      at <anonymous> (/home/losses/Development/tq-workspace/boring-wt-architecture/tests/ts/package-artifacts.test.ts:338:74)\n'
  printf '(fail) package artifact emission > two generations of the same inputs produce byte-identical artifacts [418900.00ms]\n'
  printf '\n'
  printf 'tests/ts/vector.test.ts:\n'
  printf '(pass) committed cross-language vector > re-encoding the decoded records reproduces the committed bytes [4.00ms]\n'
  printf '\n'
  printf '1 tests failed:\n'
  printf '(fail) package artifact emission > two generations of the same inputs produce byte-identical artifacts [418900.00ms]\n'
  printf '\n'
  printf ' 3 pass\n 1 fail\n 4 expect() calls\nRan 4 tests across 2 files. [465000.00ms]\n'
  printf 'error: script "test" exited with code 1\n'
} > "$B/crafted-flake.log"

for f in crafted-assertion crafted-timeout crafted-flake; do
  printf '=== %s ===\n' "$f"
  cat -n "$B/$f.log"
done
