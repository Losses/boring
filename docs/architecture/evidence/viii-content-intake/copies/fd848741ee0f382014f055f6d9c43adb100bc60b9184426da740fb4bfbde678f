#!/usr/bin/env python3
"""Independent order-symmetry check for the xs-twoexc / xs-twoexc-swapped pair.

Two criteria, both derived here rather than copied from the producer's notes:

 (A) STRUCTURAL: split each generated module into top-level items (a line that
     starts at column 0 with '#[derive', 'pub ' or 'impl ' opens an item),
     normalise each item's text, sort the items and diff the two orders.  If
     the multiset of items is identical the declaration order is the *only*
     remaining difference.

 (B) PROPERTY: read off, per order, which payload enums carry a growth
     variant, which exception classes carry a class-level struct, and which
     error type each `catch (e:Ex)` region is typed with.  These are the exact
     quantities the defect corrupts, so they are the right thing to compare.
"""
import re, sys

def items(path):
    out, cur = [], []
    for line in open(path, encoding="utf-8"):
        if re.match(r'^(#\[derive|pub |impl )', line) and cur:
            out.append("\n".join(cur).rstrip("\n"))
            cur = [line.rstrip("\n")]
        else:
            cur.append(line.rstrip("\n"))
    if cur:
        out.append("\n".join(cur).rstrip("\n"))
    return [i for i in out if i.strip()]

def props(path):
    txt = open(path, encoding="utf-8").read()
    grow  = sorted(set(re.findall(r'^\s{4}([A-Za-z0-9_]+)\(Box<', txt, re.M)))
    enums = re.findall(r'^pub enum (\w+)', txt, re.M)
    structs = [s for s in re.findall(r'^pub struct (\w+)', txt, re.M) if not s.endswith("Probe") and s != "TwoProbe"]
    regions = sorted(re.findall(r'pub fn (\w+)_rethrow_\w+\(\)[\s\S]*?Result<\w+, (\w+)>', txt))
    return grow, enums, structs, regions

a, b = sys.argv[1], sys.argv[2]
ia, ib = items(a), items(b)
print("== (A) structural: sorted top-level items ==")
print(f"{a}: {len(ia)} items, {b}: {len(ib)} items")
sa, sb = sorted(ia), sorted(ib)
if sa == sb:
    print("VERDICT A: IDENTICAL item multiset -> declaration order is the only difference")
else:
    print("VERDICT A: DIFFERENT item multiset")
    only_a = [i for i in sa if i not in sb]
    only_b = [i for i in sb if i not in sa]
    for i in only_a: print("  ONLY-IN-A:", i.replace("\n", " | ")[:160])
    for i in only_b: print("  ONLY-IN-B:", i.replace("\n", " | ")[:160])

print("== (B) property ==")
for label, p in (("A", a), ("B", b)):
    g, e, s, r = props(p)
    print(f"{label} {p}")
    print(f"   growth variants on payload enums : {g}")
    print(f"   payload enums                    : {e}")
    print(f"   class-level structs              : {s}")
    print(f"   catch-region error types         : {r}")
ga, ea, sa_, ra = props(a)
gb, eb, sb_, rb = props(b)
ok = (sorted(ga) == sorted(gb) and sorted(ea) == sorted(eb)
      and sorted(sa_) == sorted(sb_) and sorted(ra) == sorted(rb))
print("VERDICT B:", "SYMMETRIC (same properties in both orders)" if ok else "ASYMMETRIC (order-dependent)")
