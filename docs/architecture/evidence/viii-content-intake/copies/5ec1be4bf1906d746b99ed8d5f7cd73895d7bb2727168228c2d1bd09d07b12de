#![cfg(test)]

use crate::boring::fp32::Fp32;
use crate::runtime::test as testlib;
use crate::runtime::test_core;
use crate::runtime::u_string::UStr;


#[test]
fn halves_to_bits() {
    testlib::run("tests.Fp32Tests.halvesToBits", "tests.Fp32Tests.halvesToBits: binary64 halves round to binary32 bits with ties to even", || {
        test_core::TestCore::test_core_equals_int(1065353218i32, i32::from_ne_bytes(((Fp32::fp32_f64_halves_to_f32_bits(805306368, 1072693248)) as i32).to_ne_bytes()), UStr::new(&[111,100,100,32,115,105,103,110,105,102,105,99,97,110,100,32,114,111,117,110,100,115,32,117,112,32,97,116,32,116,104,101,32,104,97,108,102]));
        test_core::TestCore::test_core_equals_int(1065353216i32, i32::from_ne_bytes(((Fp32::fp32_f64_halves_to_f32_bits(268435456, 1072693248)) as i32).to_ne_bytes()), UStr::new(&[101,118,101,110,32,115,105,103,110,105,102,105,99,97,110,100,32,115,116,97,121,115,32,97,116,32,116,104,101,32,104,97,108,102]));
        test_core::TestCore::test_core_equals_int(8388608i32, i32::from_ne_bytes(((Fp32::fp32_f64_halves_to_f32_bits(3758096384u32, 940572671)) as i32).to_ne_bytes()), UStr::new(&[114,111,117,110,100,105,110,103,32,112,97,115,116,32,116,104,101,32,108,97,114,103,101,115,116,32,115,117,98,110,111,114,109,97,108,32,112,114,111,100,117,99,101,115,32,116,104,101,32,115,109,97,108,108,101,115,116,32,110,111,114,109,97,108]));
    });
}

#[test]
fn bits_round_trip() {
    testlib::run("tests.Fp32Tests.bitsRoundTrip", "tests.Fp32Tests.bitsRoundTrip: binary32 bits widen exactly and round back", || {
        test_core::TestCore::test_core_equals_float(0.5f32, Fp32::fp32_from_bits(1056964608), UStr::new(&[48,120,51,70,48,48,48,48,48,48,32,119,105,100,101,110,115,32,116,111,32,48,46,53]));
        test_core::TestCore::test_core_equals_float(-0.21875f32, Fp32::fp32_from_bits(3193962496u32), UStr::new(&[48,120,66,69,54,48,48,48,48,48,32,119,105,100,101,110,115,32,116,111,32,45,48,46,50,49,56,55,53]));
        test_core::TestCore::test_core_equals_int(1056964608i32, i32::from_ne_bytes(((Fp32::fp32_to_bits(0.5f32)) as i32).to_ne_bytes()), UStr::new(&[48,46,53,32,114,111,117,110,100,115,32,116,111,32,48,120,51,70,48,48,48,48,48,48]));
        test_core::TestCore::test_core_equals_int(-1101004800i32, i32::from_ne_bytes(((Fp32::fp32_to_bits(-0.21875f32)) as i32).to_ne_bytes()), UStr::new(&[45,48,46,50,49,56,55,53,32,114,111,117,110,100,115,32,116,111,32,48,120,66,69,54,48,48,48,48,48]));
    });
}
