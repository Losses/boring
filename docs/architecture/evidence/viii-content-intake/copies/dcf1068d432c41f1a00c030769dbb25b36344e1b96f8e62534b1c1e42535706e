use crate::runtime::u_string::UStr;
use crate::runtime::u_string::UString;
use std::sync::Mutex;


#[derive(Clone, PartialEq)]
pub struct StaticStateClient {
}

impl StaticStateClient {
    pub const fn new() -> Self {
        Self {
        }
    }

    pub fn static_state_client_install(value: &UStr) {
        *STATIC_STATE_OPS_CURRENT.lock().unwrap_or_else(|e| e.into_inner()) = Some(value.to_ustring());
    }
}

pub static STATIC_STATE_OPS_CURRENT: Mutex<Option<UString>> = Mutex::new(None);
static STATIC_STATE_OPS_SECTIONS: Mutex<Vec<UString>> = Mutex::new(vec![]);

#[derive(Clone, Copy)]
pub struct StaticStateOps;

impl StaticStateOps {
    pub const STATIC_STATE_OPS_LIMIT: u32 = 4096;
    pub const STATIC_STATE_OPS_EMPTY_MARK: &UStr = unsafe { &*(&[0x0065u16, 0x006Du16, 0x0070u16, 0x0074u16, 0x0079u16] as *const [u16] as *const crate::runtime::u_string::UStr) };

    pub fn static_state_ops_set_current(value: &UStr) {
        *STATIC_STATE_OPS_CURRENT.lock().unwrap_or_else(|e| e.into_inner()) = Some(value.to_ustring());
    }

    pub fn static_state_ops_read_current() -> UString {
        let value = { let __guard = STATIC_STATE_OPS_CURRENT.lock().unwrap_or_else(|e| e.into_inner()); __guard.clone() };
        return match &(value) { None => UString::from("none"), Some(__option) => __option.to_ustring() };
    }

    pub fn static_state_ops_record(section: &UStr) {
        STATIC_STATE_OPS_SECTIONS.lock().unwrap_or_else(|e| e.into_inner()).push(section.to_ustring());
    }

    pub fn static_state_ops_section_count() -> u32 {
        return match u32::try_from(STATIC_STATE_OPS_SECTIONS.lock().unwrap_or_else(|e| e.into_inner()).len()) { Ok(value) => value, Err(_) => u32::MAX };
    }

    pub fn static_state_ops_first_section() -> UString {
        if match u32::try_from(STATIC_STATE_OPS_SECTIONS.lock().unwrap_or_else(|e| e.into_inner()).len()) { Ok(value) => value, Err(_) => u32::MAX } == 0 {
            return (StaticStateOps::STATIC_STATE_OPS_EMPTY_MARK.to_ustring()).clone();
        }
        return (STATIC_STATE_OPS_SECTIONS.lock().unwrap_or_else(|e| e.into_inner())[0usize]).clone();
    }
}
