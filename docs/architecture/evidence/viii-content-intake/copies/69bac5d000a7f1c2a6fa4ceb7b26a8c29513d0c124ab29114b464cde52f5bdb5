package tests

import boring.IntFloatSignOps
import boring.runtime.test.Test

class IntFloatSignTests {
@boring.test.Test
    fun testComparison() {
        Test.run("tests.IntFloatSignTests.testComparison", "tests.IntFloatSignTests.testComparison: a wrapped Int stays -1.0 through an Int-vs-Float comparison widening") {
                Test.equals(true, IntFloatSignOps.belowHalf(3, 4), null)
                Test.equals(false, IntFloatSignOps.belowHalf(4, 3), null)
        }
    }

@boring.test.Test
    fun testCollapsedComparison() {
        Test.run("tests.IntFloatSignTests.testCollapsedComparison", "tests.IntFloatSignTests.testCollapsedComparison: a wrapped Int stays -1.0 through a collapsed-local comparison widening") {
                Test.equals(true, IntFloatSignOps.equalsCollapsed(3, 4), null)
        }
    }

@boring.test.Test
    fun testCompoundAssign() {
        Test.run("tests.IntFloatSignTests.testCompoundAssign", "tests.IntFloatSignTests.testCompoundAssign: a wrapped Int stays -1.0 through a Float compound assignment") {
                Test.equals(-0.5f, IntFloatSignOps.compoundSum(3, 4), null)
                Test.equals(1.5f, IntFloatSignOps.compoundSum(4, 3), null)
        }
    }

@boring.test.Test
    fun testArrayElem() {
        Test.run("tests.IntFloatSignTests.testArrayElem", "tests.IntFloatSignTests.testArrayElem: a wrapped Int stays -1.0 through an array-literal Float element") {
                Test.equals(-1.0f, IntFloatSignOps.firstElem(3, 4), null)
                Test.equals(1.0f, IntFloatSignOps.firstElem(4, 3), null)
        }
    }

@boring.test.Test
    fun testOptionalReturn() {
        Test.run("tests.IntFloatSignTests.testOptionalReturn", "tests.IntFloatSignTests.testOptionalReturn: a wrapped Int stays -1.0 through an Option<Float> return boundary") {
                val v = IntFloatSignOps.asOptional(3, 4)
                Test.equals(true, v != null, null)
                if ((v != null)) {
                    Test.equals(-1.0f, v, null)
                }
        }
    }

@boring.test.Test
    fun testTernaryFallback() {
        Test.run("tests.IntFloatSignTests.testTernaryFallback", "tests.IntFloatSignTests.testTernaryFallback: a wrapped Int stays -1.0 through a guarded ternary fallback") {
                val m = IntFloatSignOps.sampleMap()
                Test.equals(-1.0f, IntFloatSignOps.ternaryFallback(m, 3, 4), null)
                Test.equals(1.0f, IntFloatSignOps.ternaryFallback(m, 4, 3), null)
                Test.equals(0.0f, IntFloatSignOps.ternaryFallback(m, 9, 9), null)
        }
    }
}
