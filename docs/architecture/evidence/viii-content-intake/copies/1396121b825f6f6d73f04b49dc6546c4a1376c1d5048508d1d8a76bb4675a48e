pub fn equals_vec_u32(a: &[u32], b: &[u32]) -> bool {
    if a.len() != b.len() { return false; }
    for i in 0..a.len() { if !equals_u32(&a[i], &b[i]) { return false; } }
    true
}
pub fn format_vec_u32(v: &[u32]) -> String {
    let mut parts: Vec<String> = Vec::new();
    for item in v { parts.push(format_u32(item)); }
    format!("[{}]", parts.join(", "))
}
