#![cfg(test)]

use crate::boring::private_class_ops::PrivateClassOps;
use crate::boring::private_class_peer_ops::PrivateClassPeerOps;
use crate::runtime::test as testlib;
use crate::runtime::test_core;
use crate::runtime::u_string::UStr;


#[test]
fn distinct_resolutions() {
    testlib::run("tests.PrivateClassTests.distinctResolutions", "tests.PrivateClassTests.distinctResolutions: file-private classes remain private and distinct", || {
        test_core::TestCore::test_core_equals_string(UStr::new(&[102,105,114,115,116]), PrivateClassOps::private_class_ops_resolve().as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[115,101,99,111,110,100]), PrivateClassPeerOps::private_class_peer_ops_resolve().as_ustr(), UStr::new(&[]));
    });
}
