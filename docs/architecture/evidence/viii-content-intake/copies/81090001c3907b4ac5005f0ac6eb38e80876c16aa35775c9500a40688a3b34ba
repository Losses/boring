#!/usr/bin/env bash
set -u

# Self-test for run-exclusive.sh (launcher) and the Option C aux files,
# using dummy commands only. No verify, no compilation, no tracked
# writes, no Swift. Prints one line per check and a final count; exits
# nonzero when any check fails. Full output retained as last-selftest.log
# by the invoking wrapper.

HERE="$(cd "$(dirname "$0")" && pwd)"
ROOT="/home/losses/Development/tq-workspace/boring-wt-architecture"
E="$HERE"
pass=0
fail=0
check() {
    if [ "$2" = "$3" ]; then
        printf 'PASS %s\n' "$1"
        pass=$((pass + 1))
    else
        printf 'FAIL %s (got %s, want %s)\n' "$1" "$2" "$3"
        fail=$((fail + 1))
    fi
}

PLAN_A="$E/plan-a.txt"
PLAN_B="$E/plan-b.txt"
PLAN_C="$E/plan-c.txt"
PLAN_D="$E/plan-d.txt"
PLAN_F="$E/plan-f.txt"
PLAN_G="$E/plan-g.txt"

cat >"$PLAN_A" <<'EOF'
mkdir -p gendir-a
echo ok > artifact-a.txt
echo one > gendir-a/f1.txt
echo two > gendir-a/f2.txt
echo captured > "$CHILD_EVIDENCE_DIR/capture.bin"
require-file:artifact-a.txt
require-dir:gendir-a:2
require-file:child-evidence/capture.bin
EOF

cat >"$PLAN_B" <<'EOF'
echo before > before-b.txt
exit 3
echo after > after-b.txt
EOF

cat >"$PLAN_C" <<'EOF'
true
require-file:never-created.txt
EOF

cat >"$PLAN_D" <<'EOF'
( sleep 1; echo late > "$CHILD_EVIDENCE_DIR/late.txt" ) &
sleep 0.2
echo done > done-d.txt
require-file:done-d.txt
EOF

cat >"$PLAN_F" <<'EOF'
echo x > f-start.txt
require-file:../escape.txt
EOF

cat >"$PLAN_G" <<'EOF'
mkdir -p linkdir
ln -s /tmp linkdir/inner
echo v > linkdir/inner-file.txt
require-file:linkdir/inner-file.txt
EOF

run_case() {
    local name="$1" plan="$2" want="$3"
    local out
    out=$(bash "$E/run-exclusive.sh" "$ROOT" "$plan" 2>&1)
    local rc=$?
    check "$name exit" "$rc" "$want"
    printf '%s\n' "$out" | sed 's/^/  /'
}

run_case "plan-A" "$PLAN_A" 0
latest_a=$(cat "$E/.latest-run")
check "plan-A stage file count" "$(ls "$latest_a/stages" | wc -l)" 20
check "plan-A child capture wired" "$([ -s "$latest_a/child-evidence/capture.bin" ] && echo yes || echo no)" "yes"
check "plan-A statuses all zero" "$(cat "$latest_a"/stages/*.status | sort -u | tr -d '\n')" "0"
bash "$E/check-log-integrity.sh" "$latest_a" >/dev/null 2>&1
check "plan-A attempt sealed and stage evidence verified" "$?" 0

run_case "plan-B" "$PLAN_B" 3
latest_b=$(cat "$E/.latest-run")
check "plan-B failing status recorded" "$(cat "$latest_b"/stages/*.status | grep -c '^3$')" 1
check "plan-B downstream skipped" "$(grep -l 'blocked-by' "$latest_b"/stages/*.status | wc -l)" 1
check "plan-B skipped stage produced no artifact" "$([ -e "$latest_b/after-b.txt" ] && echo yes || echo no)" "no"
check "plan-B blocker named in sealed log" "$(grep -c 'failed_stage=step-' "$latest_b/harness.log")" 1
bash "$E/check-log-integrity.sh" "$latest_b" >/dev/null 2>&1
check "plan-B attempt sealed and stage evidence verified" "$?" 0

run_case "plan-C" "$PLAN_C" 65
latest_c=$(cat "$E/.latest-run")
check "plan-C records plan errors" "$([ -s "$latest_c/plan-errors.txt" ] && echo yes || echo no)" "yes"
grep -q "missing or empty file" "$latest_c/plan-errors.txt"
check "plan-C specific error text" "$?" 0

# Real stale rejection: pre-create the exact override path.
stale="$E/attempt-stale-real"
rm -rf "$stale"
mkdir -p "$stale/stale-marker"
out=$(EXCLUSIVE_ATTEMPT_DIR="$stale" bash "$E/run-exclusive.sh" "$ROOT" "$PLAN_A" 2>&1)
check "stale attempt path rejected" "$?" 65
printf '%s\n' "$out" | grep -q "stale or symlink path rejected"
check "stale rejection names the reason" "$?" 0

# Symlink rejection: dangling symlink at the override path.
link="$E/attempt-link"
rm -rf "$link"
ln -s "$E/attempt-nonexistent-target" "$link"
out=$(EXCLUSIVE_ATTEMPT_DIR="$link" bash "$E/run-exclusive.sh" "$ROOT" "$PLAN_A" 2>&1)
check "symlink attempt path rejected" "$?" 65

# Traversal rejection: a require path escaping the attempt directory.
run_case "plan-F traversal" "$PLAN_F" 65
latest_f=$(cat "$E/.latest-run")
grep -q "path traversal via .." "$latest_f/plan-errors.txt"
check "plan-F traversal error text" "$?" 0

# Internal symlink: on this host the redirected write stays inside the
# attempt, so the invariant is containment of every attempt file. The
# rejection path is exercised by plan-F above.
run_case "plan-G internal symlink" "$PLAN_G" 0
latest_g=$(cat "$E/.latest-run")
escape=0
while IFS= read -r f; do
    case "$(readlink -f "$f")" in
        "$latest_g"/*|"$latest_g") ;;
        *) escape=1 ;;
    esac
done < <(find "$latest_g" -type f)
check "plan-G no attempt file resolves outside" "$escape" 0
bash "$E/check-log-integrity.sh" "$latest_g" >/dev/null 2>&1
check "plan-G attempt sealed and stage evidence verified" "$?" 0

# Late-writer control: the detached child is reaped with its stage group,
# so its artifact never appears and the sealed log stays intact.
run_case "plan-D" "$PLAN_D" 0
latest_d=$(cat "$E/.latest-run")
check "late writer reaped before seal" "$([ -e "$latest_d/child-evidence/late.txt" ] && echo yes || echo no)" "no"
bash "$E/check-log-integrity.sh" "$latest_d" >/dev/null 2>&1
check "plan-D attempt sealed and stage evidence verified" "$?" 0

# Sealed-log integrity: detect a post-end zombie append.
printf 'zombie writer append\n' >>"$latest_a/harness.log"
bash "$E/check-log-integrity.sh" "$latest_a" >/dev/null 2>&1
check "post-end append detected" "$?" 1

# Sealed-log integrity, byte view: the same post-end append WITHOUT a
# trailing newline must be caught too. A fresh sealed attempt is used so
# that the only difference from the control above is the missing LF: the
# 6 appended bytes form no new line, so the line count is unchanged and a
# line-view check sees nothing, while the byte-offset check sees exactly
# 6 bytes past the marker line.
run_case "plan-A no-LF append" "$PLAN_A" 0
latest_nolf=$(cat "$E/.latest-run")
printf 'abcdef' >>"$latest_nolf/harness.log"
bash "$E/check-log-integrity.sh" "$latest_nolf" >/dev/null 2>&1
check "post-end append without trailing newline detected" "$?" 1

# ---- Option C aux files: wrapper + post-state + record inspector ----
OC="$E/option-c-dummy"
rm -rf "$OC"
mkdir -p "$OC/root/tests/vectors" "$OC/root/sub"
echo lock-content >"$OC/root/Cargo.lock"
echo bin >"$OC/root/tests/vectors/roundtrip.bin"
echo f16 >"$OC/root/tests/vectors/roundtrip-f16.bin"
echo f32 >"$OC/root/tests/vectors/roundtrip-f32.bin"
echo app >"$OC/root/app.txt"
printf '#!/bin/sh\necho tool-ran\nexit ${1:-0}\n' >"$OC/root/tool.sh"
chmod +x "$OC/root/tool.sh"
python3 - "$OC" <<'PYBUILD'
import hashlib, json, os, stat, sys
root = sys.argv[1] + "/root"
entries = []
for base, dirs, files in os.walk(root):
    for name in sorted(files):
        p = os.path.join(base, name)
        rel = os.path.relpath(p, root)
        mode = "100755" if os.stat(p).st_mode & stat.S_IXUSR else "100644"
        entries.append({"path": rel, "sha256": hashlib.sha256(open(p, "rb").read()).hexdigest(), "mode": mode})
entries.sort(key=lambda e: e["path"])
json.dump(entries, open(sys.argv[1] + "/manifest.json", "w"), indent=1)
print("dummy manifest: %d entries" % len(entries))
PYBUILD

export EXCLUSIVE_RUNNER_DIR="$E"
export OPTION_C_ROOT="$OC/root"
export SOURCE_MANIFEST="$OC/manifest.json"
export ROOT_TOOL="$OC/root"

cat >"$E/oc-pass.plan" <<'EOF'
"$EXCLUSIVE_RUNNER_DIR/option-c-stage-wrapper.sh" oc-echo "$OPTION_C_ROOT" "$SOURCE_MANIFEST" "$EXCLUSIVE_RUNNER_DIR/option-c-poststate.py" "$RUN/option-c" -- "$ROOT_TOOL"/tool.sh
EOF
run_case "option-C pass" "$E/oc-pass.plan" 0
oc_pass=$(cat "$E/.latest-run")
check "option-C poststate report in sealed stdout" "$(grep -c 'post-state: 6 entries checked, 0 failures' "$oc_pass/stages"/*.stdout)" 2

cat >"$E/oc-fail.plan" <<'EOF'
"$EXCLUSIVE_RUNNER_DIR/option-c-stage-wrapper.sh" oc-fail "$OPTION_C_ROOT" "$SOURCE_MANIFEST" "$EXCLUSIVE_RUNNER_DIR/option-c-poststate.py" "$RUN/option-c" -- exit 7
EOF
run_case "option-C original failure" "$E/oc-fail.plan" 7
oc_fail=$(cat "$E/.latest-run")
check "option-C original rc preserved" "$(cat "$oc_fail/stages"/*.status | sort -u | tr -d '\n')" "7"
check "option-C poststate ran after failure" "$(grep -c 'post-state: 6 entries checked, 0 failures' "$oc_fail/stages"/*.stdout)" 2

# Option C post-state drift: root file modified after manifest build;
# original rc 0, post-state rc 91 blocks.
printf 'drifted\n' >"$OC/root/app.txt"
cat >"$E/oc-drift.plan" <<'EOF'
"$EXCLUSIVE_RUNNER_DIR/option-c-stage-wrapper.sh" oc-drift "$OPTION_C_ROOT" "$SOURCE_MANIFEST" "$EXCLUSIVE_RUNNER_DIR/option-c-poststate.py" "$RUN/option-c" -- "$ROOT_TOOL"/tool.sh
EOF
run_case "option-C poststate drift" "$E/oc-drift.plan" 91
oc_drift=$(cat "$E/.latest-run")
check "option-C drift poststate report retained" "$(grep -c 'FAIL sha256: app.txt' "$oc_drift/stages"/*.stdout)" 1

printf 'app\n' >"$OC/root/app.txt"

printf 'self-test: %d pass, %d fail\n' "$pass" "$fail"
[ "$fail" -eq 0 ]
