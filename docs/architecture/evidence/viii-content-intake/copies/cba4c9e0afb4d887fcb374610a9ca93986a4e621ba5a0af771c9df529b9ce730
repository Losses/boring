#!/usr/bin/env bash
# Decisive pre/post threshold test for the swift-rt-probe / swift-rt-plain fixtures.
# A = pre tree + fixture's own glob (std + <fixture>)   -> expected PRE-PATCH failure
# B = post tree + fixture's own glob                    -> the fixture's actual command
# C = post tree + Package.swift sources (Runtime.swift) -> post-patch fixed form
X=/home/losses/Development/tq-workspace/dc-warn/out/fixture-parity-xcheck
SWIFTC=/nix/store/j1bfa7mw323wmp6pfrn1qkchxv61wk2n-swift-toolchain-6.2.4-al2/usr/bin/swiftc
FHS=/nix/store/xq9k8vi7gqw0wn592p95wzvzf3wzn4kh-swift-6.2.4-fhs-fhsenv-rootfs
GLIBC=/nix/store/0d8g8n0a11v6f5m2h416ajyxmnkwc3md-glibc-2.42-67/lib
GCCRT=/nix/store/3wkpp7mjlh4qxij92iz99r43aifzgajd-gcc-15.2.0/lib/gcc/x86_64-unknown-linux-gnu/15.2.0
LIBGCCS=/nix/store/n35z8vvlr7c5k1406n5bwd0f8h2hgj1j-gcc-15.2.0-lib/lib
export LD_LIBRARY_PATH="$FHS/usr/lib64:$FHS/lib64:/usr/lib64:/usr/lib"
FLAGS="-Xcc -I$FHS/usr/include -L$FHS/usr/lib64 -L$GCCRT -L$LIBGCCS -L$GLIBC"

run() { # $1=tag $2=tree $3=fixture-dir $4=extra
	local tag=$1 tree=$2 fx=$3 extra=$4
	local G="$tree/gen/$fx"
	( cd "$G" && "$SWIFTC" -o "$G/run-bin-$tag" $extra $(find std "$fx" -name '*.swift') native-main.swift $FLAGS ) >"$X/run-$tag.log" 2>&1
	local rc=$?
	local bor typeerr linkerr
	bor=$(grep -F -c "cannot find type 'BoringException' in scope" "$X/run-$tag.log")
	typeerr=$(grep -cE 'error: (cannot find type|.super. cannot)' "$X/run-$tag.log")
	linkerr=$(grep -c 'link command failed' "$X/run-$tag.log")
	printf '%-20s exit=%-3s BoringException-missing=%s other-type-errors=%s link-failed=%s\n' "$tag" "$rc" "$bor" "$typeerr" "$linkerr"
}

echo "### swift-rt-probe (fixture command = glob std + probe)"
run A-pre-glob  /home/losses/Development/tq-workspace/dc-warn/out/fixture-parity-xcheck/pre  probe ""
run B-post-glob /home/losses/Development/tq-workspace/dc-warn/out/fixture-parity-xcheck/post probe ""
run C-post-pkg  /home/losses/Development/tq-workspace/dc-warn/out/fixture-parity-xcheck/post probe "Runtime.swift"
echo "### swift-rt-plain (fixture command = glob std + plain)"
run A-pre-glob-plain  /home/losses/Development/tq-workspace/dc-warn/out/fixture-parity-xcheck/pre  plain ""
run B-post-glob-plain /home/losses/Development/tq-workspace/dc-warn/out/fixture-parity-xcheck/post plain ""
run C-post-pkg-plain  /home/losses/Development/tq-workspace/dc-warn/out/fixture-parity-xcheck/post plain "Runtime.swift"
