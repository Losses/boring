#![cfg(test)]

use crate::boring::closure_string_view_ops::ClosureStringViewOps;
use crate::runtime::test as testlib;
use crate::runtime::test_core;
use crate::runtime::u_string::UStr;
use crate::runtime::u_string::UString;


#[test]
fn test_choose() {
    testlib::run("tests.ClosureStringViewOpsTests.testChoose", "tests.ClosureStringViewOpsTests.testChoose: a captured String parameter owns text on return", || {
        test_core::TestCore::test_core_equals_string(UStr::new(&[102,111,117,110,100]), ClosureStringViewOps::closure_string_view_ops_choose(&vec![UString::from("found").to_ustring()], UStr::new(&[102,97,108,108,98,97,99,107])).as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[102,97,108,108,98,97,99,107]), ClosureStringViewOps::closure_string_view_ops_choose(&vec![], UStr::new(&[102,97,108,108,98,97,99,107])).as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_bool(true, true, UStr::new(&[]));
    });
}

#[test]
fn test_label() {
    testlib::run("tests.ClosureStringViewOpsTests.testLabel", "tests.ClosureStringViewOpsTests.testLabel: a captured String parameter passes a str view through", || {
        test_core::TestCore::test_core_equals_string(UStr::new(&[40,103,97,109,109,97,41]), ClosureStringViewOps::closure_string_view_ops_label(UStr::new(&[103,97,109,109,97])).as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_bool(true, true, UStr::new(&[]));
    });
}
