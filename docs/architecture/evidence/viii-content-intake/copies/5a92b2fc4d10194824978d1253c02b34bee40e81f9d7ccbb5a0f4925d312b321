use crate::boring::value_exception::ValueError;
use crate::runtime::sorted_table::SortedTable;
use crate::runtime::u_string::UStr;
use crate::runtime::u_string::UString;


#[derive(Debug, Clone, PartialEq)]
pub struct ValueRecord {
    pub start: u32,
    pub end: u32,
    pub label: UString,
}

impl ValueRecord {
    pub fn new(start: u32, end: u32, label: &UStr) -> Result<Self, ValueError> {
        if i32::from_ne_bytes(((start) as i32).to_ne_bytes()) > (i32::from_ne_bytes(((end) as i32).to_ne_bytes())) {
            return Err(ValueError::StartAfterEnd);
        }
        if start > 2147483647 {
            return Err(ValueError::NegativeStart);
        }
        Ok(Self {
            start,
            end,
            label: label.to_ustring(),
        })
    }

    pub fn get_length(&self) -> u32 {
        return u32::wrapping_sub(self.end, self.start);
    }

    pub fn to_string(&self) -> UString {
        return UString::from(format!("{}", { let mut __s = UString::new(); __s += &(UString::from("ValueRecord(")); __s += &(UString::from("start=")); __s += &(UString::from((self.start).to_string().as_str())); __s += &(UString::from(", ")); __s += &(UString::from("end=")); __s += &(UString::from((self.end).to_string().as_str())); __s += &(UString::from(", ")); __s += &(UString::from("label=")); __s += (self.label).to_ustring().as_ustr(); __s += &(UString::from(")")); __s }).as_str());
    }
}

pub fn compare_value_record(a: &ValueRecord, b: &ValueRecord) -> i32 {
    let cmp_start = match i32::from_ne_bytes((*(&a.start)).to_ne_bytes()).cmp(&i32::from_ne_bytes((*(&b.start)).to_ne_bytes())) { core::cmp::Ordering::Less => -1, core::cmp::Ordering::Equal => 0, core::cmp::Ordering::Greater => 1 };
    if cmp_start != 0 { return cmp_start; }
    let cmp_end = match i32::from_ne_bytes((*(&a.end)).to_ne_bytes()).cmp(&i32::from_ne_bytes((*(&b.end)).to_ne_bytes())) { core::cmp::Ordering::Less => -1, core::cmp::Ordering::Equal => 0, core::cmp::Ordering::Greater => 1 };
    if cmp_end != 0 { return cmp_end; }
    let cmp_label = SortedTable::sorted_table_compare_strings((&a.label).as_ustr(), (&b.label).as_ustr());
    if cmp_label != 0 { return cmp_label; }
    0
}
