#![cfg(test)]

use crate::boring::abstract_static_default::AbstractStaticDefault;
use crate::boring::probe_unit::ProbeUnit;
use crate::runtime::test as testlib;
use crate::runtime::test_core;
use crate::runtime::u_string::UStr;


#[test]
fn test_abstract_static_default() {
    testlib::run("tests.AbstractStaticDefaultTests.testAbstractStaticDefault", "tests.AbstractStaticDefaultTests.testAbstractStaticDefault: omitted optional parameter falls back to the abstract static default", || {
        let d = AbstractStaticDefault::new(None);
        test_core::TestCore::test_core_equals_bool(true, d.value == ProbeUnit::zero(), UStr::new(&[]));
    });
}
