#!/usr/bin/env bash
# Independent control suite for the byte-view integrity checker fix.
# All mutations happen on cp -a copies under scratch/ctrl/. Exit codes are
# captured directly (command substitution; never through a pipe).
SRC=/home/losses/Development/tq-workspace/boring-wt-architecture/out/integration-a3-evidence/exclusive-runner
T=/home/losses/Development/tq-workspace/dc-warn/out/bytefix-verify/scratch
EV=/home/losses/Development/tq-workspace/dc-warn/out/bytefix-verify/evidence
OLD="$T/old.sh"
NEW="$T/new.sh"
B1=attempt-20260929T180809-2918225    # 2622 B log, marker_end 2622, line 30
B2=attempt-20260929T203318-3292330    # 3173 B log, marker_end 3173, line 36
C=$T/ctrl
EVLOG=$EV/02-controls-detail.txt
TSV=$EV/02-controls.tsv
rm -rf "$C"; mkdir -p "$C"
: > "$EVLOG"; : > "$TSV"

# 0. sanity: which checker bytes am I actually running?
o=$(sha256sum "$OLD" | cut -d' ' -f1)
n=$(sha256sum "$NEW" | cut -d' ' -f1)
printf 'OLD checker sha256 %s (expected bebd0cf9026ec97d7afdc1a5ebccf8a9213e04aedfa77e2b3be487d79580fe5a)\n' "$o" >> "$EVLOG"
printf 'NEW checker sha256 %s (expected 606cb4f391ba288137ef70caad989c848b96cbb78547efac12bd8527f534e3f7)\n\n' "$n" >> "$EVLOG"

mk() { rm -rf "$C/$1"; cp -a "$C/clean" "$C/$1"; }

cp -a "$SRC/$B1" "$C/clean"
B2DIR="$C/clean2"; rm -rf "$B2DIR"; cp -a "$SRC/$B2" "$B2DIR"

run() { # name dir
  local name=$1 dir=$2
  local om nm
  om=$(bash "$OLD" "$dir" 2>&1); local orc=$?
  nm=$(bash "$NEW" "$dir" 2>&1); local nrc=$?
  local lb=-
  [ -f "$dir/harness.log" ] && lb=$(wc -c < "$dir/harness.log")
  printf '%-14s old_rc=%s new_rc=%s log_bytes=%s\n' "$name" "$orc" "$nrc" "$lb" >> "$EVLOG"
  printf -- '  -- OLD:\n%s\n' "$om" >> "$EVLOG"
  printf -- '  -- NEW:\n%s\n' "$nm" >> "$EVLOG"
  printf '%s\t%s\t%s\t%s\n' "$name" "$orc" "$nrc" "$(printf '%s' "$nm" | head -1)" >> "$TSV"
}

# --- positive controls ---
run pos1 "$C/clean"          # B1 untampered
run pos2 "$C/clean2"         # B2 untampered

# --- negative: append without trailing newline (the blind spot) ---
mk negA1_b1;  printf 'X'      >> "$C/negA1_b1/harness.log"     # 1 byte
run negA1_b1 "$C/negA1_b1"
mk negA6_b1;  printf 'TAMPER' >> "$C/negA6_b1/harness.log"     # 6 bytes
run negA6_b1 "$C/negA6_b1"
mk negA6_b2;  cp -a "$C/clean2" "$C/negA6_b2"; printf 'TAMPER' >> "$C/negA6_b2/harness.log"
run negA6_b2 "$C/negA6_b2"
mk negA19_b1; printf 'TAMPERED-NO-NEWLINE' >> "$C/negA19_b1/harness.log"  # author's exact 19-byte append
run negA19_b1 "$C/negA19_b1"

# --- negative: append WITH trailing newline ---
mk negB1_b1;  printf 'TAMPERED-WITH-NEWLINE\n' >> "$C/negB1_b1/harness.log"
run negB1_b1 "$C/negB1_b1"
rm -rf "$C/negB1_b2"; cp -a "$C/clean2" "$C/negB1_b2"; printf 'TAMPERED-WITH-NEWLINE\n' >> "$C/negB1_b2/harness.log"
run negB1_b2 "$C/negB1_b2"

# --- negative: stage tampering (from the author's control set, re-run independently) ---
mk negB2;   # flip one byte in a sealed .stdout
python3 - "$C/negB2/stages/step-2320672395.stdout" <<'PY'
import sys
p = sys.argv[1]
b = bytearray(open(p,'rb').read())
b[len(b)//2] ^= 0x01
open(p,'wb').write(bytes(b))
PY
run negB2 "$C/negB2"
mk negB3    # flip the only .status that is "1" to "0"
printf '0\n' > "$C/negB3/stages/step-737716045.status"
run negB3 "$C/negB3"
mk negB4    # delete a sealed .stderr
rm -f "$C/negB4/stages/step-2119220958.stderr"
run negB4 "$C/negB4"

# --- synthetic edge cases (no real attempt involved) ---
mkedge() { rm -rf "$C/$1"; mkdir -p "$C/$1/stages"; }
mkedge e_nolf   # marker-only log, NO trailing LF; sha of empty prefix
printf 'harness end marker sha256=e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855' > "$C/e_nolf/harness.log"
run e_nolf "$C/e_nolf"
mkedge e_nomark # no marker at all
printf 'line one\nline two\n' > "$C/e_nomark/harness.log"
run e_nomark "$C/e_nomark"
mkedge e_prefix # recorded sha is wrong
{ printf 'line one\n'
  printf 'harness end marker sha256=deadbeef\n'
} > "$C/e_prefix/harness.log"
run e_prefix "$C/e_prefix"

# --- multi-marker cases (reviewer claim: last end marker wins) ---
python3 - "$C/negA6_b1/harness.log" /dev/null <<'PY' || true
# (no-op placeholder; real multi cases built below)
PY

# multi0: append a SECOND self-consistent marker (with LF), no forged content
rm -rf "$C/multi0"; cp -a "$C/clean" "$C/multi0"
python3 - "$C/multi0/harness.log" <<'PY'
import sys, hashlib
p = sys.argv[1]
b = open(p,'rb').read()
mk = b'harness end marker sha256='
sha = hashlib.sha256(b).hexdigest()
open(p,'ab').write(mk + sha.encode() + b'\n')
PY
run multi0 "$C/multi0"

# multi1: append FORGED-LINE + second self-consistent marker (with LF)
rm -rf "$C/multi1"; cp -a "$C/clean" "$C/multi1"
python3 - "$C/multi1/harness.log" <<'PY'
import sys, hashlib
p = sys.argv[1]
b = open(p,'rb').read() + b'FORGED-LINE\n'
mk = b'harness end marker sha256='
sha = hashlib.sha256(b).hexdigest()
open(p,'ab').write(mk + sha.encode() + b'\n')
PY
run multi1 "$C/multi1"

# multi2: append FORGED-LINE + second self-consistent marker WITHOUT trailing LF
rm -rf "$C/multi2"; cp -a "$C/clean" "$C/multi2"
python3 - "$C/multi2/harness.log" <<'PY'
import sys, hashlib
p = sys.argv[1]
b = open(p,'rb').read() + b'FORGED-LINE\n'
mk = b'harness end marker sha256='
sha = hashlib.sha256(b).hexdigest()
open(p,'ab').write(mk + sha.encode())   # no trailing newline
PY
run multi2 "$C/multi2"

# multi3: tamper a sealed .stdout byte, then re-seal with a fresh marker
rm -rf "$C/multi3"; cp -a "$C/clean" "$C/multi3"
python3 - "$C/multi3/stages/step-2320672395.stdout" <<'PY'
import sys
p = sys.argv[1]
b = bytearray(open(p,'rb').read())
b[len(b)//2] ^= 0x01
open(p,'wb').write(bytes(b))
PY
python3 - "$C/multi3/harness.log" <<'PY'
import sys, hashlib
p = sys.argv[1]
b = open(p,'rb').read()
mk = b'harness end marker sha256='
sha = hashlib.sha256(b).hexdigest()
open(p,'ab').write(mk + sha.encode() + b'\n')
PY
run multi3 "$C/multi3"

echo "=== controls.tsv ==="
cat "$TSV"
