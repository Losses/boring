                    return Err(UStringFault::UnpairedSurrogate { unit: u32::from(unit) });
                }
            }
        }
        buf.extend(UString::from("step1").encode_utf16());
        let s1 = UString::from_utf16(buf.as_slice()).map_err(|_| UStringFault::UnpairedSurrogate { unit: u32::from(buf[buf.len() - 1]) })?;
        if let Some(&unit) = buf.last() {
            if unit >= 55296 && unit <= 56319 && !UString::from("-step2").is_empty() {
                if !UString::from("-step2").encode_utf16().next().map_or(false, |head| head >= 56320 && head <= 57343) {
                    return Err(UStringFault::UnpairedSurrogate { unit: u32::from(unit) });
                }
            }
        }
        buf.extend(UString::from("-step2").encode_utf16());
        let s2 = UString::from_utf16(buf.as_slice()).map_err(|_| UStringFault::UnpairedSurrogate { unit: u32::from(buf[buf.len() - 1]) })?;
        return Ok(vec![s1.clone(), s2.clone()]);
    }

