use crate::runtime::u_string;
use crate::runtime::u_string::UStr;
use crate::runtime::u_string::UString;
use crate::std::u_string_exception::UStringFault;


#[derive(Clone, Copy)]
pub struct StringBufOps;

impl StringBufOps {
    pub fn string_buf_ops_build_empty() -> Result<UString, UStringFault> {
        let buf = Vec::<u16>::new();
        return Ok(UString::from_utf16(buf.as_slice()).map_err(|_| UStringFault::UnpairedSurrogate { unit: u32::from(buf[buf.len() - 1]) })?);
    }

    pub fn string_buf_ops_build_parts(a: &UStr, b: &UStr, c: &UStr) -> Result<UString, UStringFault> {
        let mut buf = Vec::<u16>::new();
        if let Some(&unit) = buf.last() {
            if unit >= 55296 && unit <= 56319 && !a.is_empty() {
                if !a.encode_utf16().next().map_or(false, |head| head >= 56320 && head <= 57343) {
                    return Err(UStringFault::UnpairedSurrogate { unit: u32::from(unit) });
                }
            }
        }
        buf.extend(a.encode_utf16());
        if let Some(&unit) = buf.last() {
            if unit >= 55296 && unit <= 56319 && !b.is_empty() {
                if !b.encode_utf16().next().map_or(false, |head| head >= 56320 && head <= 57343) {
                    return Err(UStringFault::UnpairedSurrogate { unit: u32::from(unit) });
                }
            }
        }
        buf.extend(b.encode_utf16());
        if let Some(&unit) = buf.last() {
            if unit >= 55296 && unit <= 56319 && !c.is_empty() {
                if !c.encode_utf16().next().map_or(false, |head| head >= 56320 && head <= 57343) {
                    return Err(UStringFault::UnpairedSurrogate { unit: u32::from(unit) });
                }
            }
        }
        buf.extend(c.encode_utf16());
        return Ok(UString::from_utf16(buf.as_slice()).map_err(|_| UStringFault::UnpairedSurrogate { unit: u32::from(buf[buf.len() - 1]) })?);
    }

    pub fn string_buf_ops_build_with_chars(prefix: &UStr, code_a: u32, code_b: u32) -> Result<UString, UStringFault> {
        let mut buf = Vec::<u16>::new();
        if let Some(&unit) = buf.last() {
            if unit >= 55296 && unit <= 56319 && !prefix.is_empty() {
                if !prefix.encode_utf16().next().map_or(false, |head| head >= 56320 && head <= 57343) {
                    return Err(UStringFault::UnpairedSurrogate { unit: u32::from(unit) });
                }
            }
        }
        buf.extend(prefix.encode_utf16());
        if code_a >= 56320 && code_a <= 57343 {
            match buf.last() {
                Some(&last) if last >= 55296 && last <= 56319 => {}
                _ => return Err(UStringFault::UnpairedSurrogate { unit: code_a }),
            }
        } else if let Some(&last) = buf.last() {
            if last >= 55296 && last <= 56319 {
                return Err(UStringFault::UnpairedSurrogate { unit: u32::from(last) });
            }
        }
        buf.push(u16::try_from((code_a) & 0xFFFF).unwrap_or(0));
        if code_b >= 56320 && code_b <= 57343 {
            match buf.last() {
                Some(&last) if last >= 55296 && last <= 56319 => {}
                _ => return Err(UStringFault::UnpairedSurrogate { unit: code_b }),
            }
        } else if let Some(&last) = buf.last() {
            if last >= 55296 && last <= 56319 {
                return Err(UStringFault::UnpairedSurrogate { unit: u32::from(last) });
            }
        }
        buf.push(u16::try_from((code_b) & 0xFFFF).unwrap_or(0));
        return Ok(UString::from_utf16(buf.as_slice()).map_err(|_| UStringFault::UnpairedSurrogate { unit: u32::from(buf[buf.len() - 1]) })?);
    }

    pub fn string_buf_ops_measure_length(parts: &Vec<UString>) -> Result<u32, UStringFault> {
        let mut buf = Vec::<u16>::new();
        for i in 0..match u32::try_from(parts.len()) { Ok(value) => value, Err(_) => u32::MAX } {
            if let Some(&unit) = buf.last() {
                if unit >= 55296 && unit <= 56319 && !(parts[usize::try_from(i).unwrap_or(0)]).clone().is_empty() {
                    if !(parts[usize::try_from(i).unwrap_or(0)]).clone().encode_utf16().next().map_or(false, |head| head >= 56320 && head <= 57343) {
                        return Err(UStringFault::UnpairedSurrogate { unit: u32::from(unit) });
                    }
                }
            }
            buf.extend((parts[usize::try_from(i).unwrap_or(0)]).clone().encode_utf16());
        }
        return Ok(u32::try_from((buf.len()) & 0xFFFF_FFFF).unwrap_or(0));
    }

