    pub fn string_buf_ops_complete_pair(lead: u32, trail: u32) -> Result<UString, UStringFault> {
        let mut buf = Vec::<u16>::new();
        if lead >= 56320 && lead <= 57343 {
            match buf.last() {
                Some(&last) if last >= 55296 && last <= 56319 => {}
                _ => return Err(UStringFault::UnpairedSurrogate { unit: lead }),
            }
        } else if let Some(&last) = buf.last() {
            if last >= 55296 && last <= 56319 {
                return Err(UStringFault::UnpairedSurrogate { unit: u32::from(last) });
            }
        }
        buf.push(u16::try_from((lead) & 0xFFFF).unwrap_or(0));
        if trail >= 56320 && trail <= 57343 {
            match buf.last() {
                Some(&last) if last >= 55296 && last <= 56319 => {}
                _ => return Err(UStringFault::UnpairedSurrogate { unit: trail }),
            }
        } else if let Some(&last) = buf.last() {
            if last >= 55296 && last <= 56319 {
                return Err(UStringFault::UnpairedSurrogate { unit: u32::from(last) });
            }
        }
        buf.push(u16::try_from((trail) & 0xFFFF).unwrap_or(0));
        return Ok(UString::from_utf16(buf.as_slice()).map_err(|_| UStringFault::UnpairedSurrogate { unit: u32::from(buf[buf.len() - 1]) })?);
    }

    pub(crate) fn string_buf_ops_classify_fault(fault: UStringFault) -> u32 {
        return match fault {
            UStringFault::InvalidCodePoint { code: _p0 } => u32::wrapping_add(1000, _p0),
            UStringFault::UnpairedSurrogate { unit: _p0 } => u32::wrapping_add(2000, _p0),
        };
    }

    pub fn string_buf_ops_caught_trail_unit(trail: u32) -> u32 {
        let value: u32 = match (|| -> Result<u32, UStringFault> {
            let mut buf = Vec::<u16>::new();
            if trail >= 56320 && trail <= 57343 {
                match buf.last() {
                    Some(&last) if last >= 55296 && last <= 56319 => {}
                    _ => return Err(UStringFault::UnpairedSurrogate { unit: trail }),
                }
            } else if let Some(&last) = buf.last() {
                if last >= 55296 && last <= 56319 {
                    return Err(UStringFault::UnpairedSurrogate { unit: u32::from(last) });
                }
            }
            buf.push(u16::try_from((trail) & 0xFFFF).unwrap_or(0));
            return Ok(0);
        })() {
            Ok(__value) => __value,
            Err(error) => StringBufOps::string_buf_ops_classify_fault((error).clone()),
        };
        return value;
    }

    pub fn string_buf_ops_caught_dangling_unit(lead: u32) -> u32 {
        let value: u32 = match (|| -> Result<u32, UStringFault> {
            let mut buf = Vec::<u16>::new();
            if lead >= 56320 && lead <= 57343 {
                match buf.last() {
                    Some(&last) if last >= 55296 && last <= 56319 => {}
                    _ => return Err(UStringFault::UnpairedSurrogate { unit: lead }),
