package tests

import boring.SwitchMark
import boring.SwitchOps
import boring.runtime.test.Test

class SwitchOpsTests {
@boring.test.Test
    fun testAssign() {
        Test.run("tests.SwitchOpsTests.testAssign", "tests.SwitchOpsTests.testAssign: switch assign position lowers") {
                Test.equals("empty", SwitchOps.assign(SwitchMark.Empty), null)
                Test.equals("text:y", SwitchOps.assign(SwitchMark.Text("y")), null)
        }
    }

@boring.test.Test
    fun testStatement() {
        Test.run("tests.SwitchOpsTests.testStatement", "tests.SwitchOpsTests.testStatement: switch statement assignment lowers") {
                Test.equals("empty", SwitchOps.statement(SwitchMark.Empty), null)
                Test.equals("number:3", SwitchOps.statement(SwitchMark.Number(3)), null)
                Test.equals("text:x", SwitchOps.statement(SwitchMark.Text("x")), null)
        }
    }

@boring.test.Test
    fun testInitializer() {
        Test.run("tests.SwitchOpsTests.testInitializer", "tests.SwitchOpsTests.testInitializer: switch initializer lowers") {
                Test.equals("number:4", SwitchOps.initializer(SwitchMark.Number(4)), null)
        }
    }

@boring.test.Test
    fun testDefault() {
        Test.run("tests.SwitchOpsTests.testDefault", "tests.SwitchOpsTests.testDefault: switch default lowers") {
                Test.equals("empty", SwitchOps.defaulted(SwitchMark.Empty), null)
                Test.equals("fallback", SwitchOps.defaulted(SwitchMark.Other), null)
        }
    }

@boring.test.Test
    fun testConditional() {
        Test.run("tests.SwitchOpsTests.testConditional", "tests.SwitchOpsTests.testConditional: switch inside a conditional arm lowers") {
                Test.equals("fallback", SwitchOps.conditional(SwitchMark.Empty, true), null)
                Test.equals("empty", SwitchOps.conditional(SwitchMark.Empty, false), null)
                Test.equals("number:3", SwitchOps.conditional(SwitchMark.Number(3), false), null)
                Test.equals("text:x", SwitchOps.conditional(SwitchMark.Text("x"), false), null)
        }
    }
}
