package boring

object FunctionalOps {
    fun lambdaSum(values: MutableList<Float>): Float {
        var total = 0.0f
        for (value in values) {
            total += value
        }
        return total
    }

    fun functionalSum(values: MutableList<Float>): Float {
        var pipeline_result = 0.0f
        for (value in values) {
            pipeline_result += value
        }
        return pipeline_result
    }

    fun lambdaIter(values: MutableList<Int>): Int {
        var total = 0
        for (value in values) {
            total += value
        }
        return total
    }

    fun functionalForEach(values: MutableList<Int>): Int {
        var total = 0
        for (value in values) {
            total += value
        }
        return total
    }

    fun verify(): Boolean {
        val ints = mutableListOf<Int>(1, 2, 3, 4)
        return FunctionalOps.lambdaSum(mutableListOf<Float>(1.5f, 2.0f, 3.5f)) == 7.0f && FunctionalOps.functionalSum(mutableListOf<Float>(1.5f, 2.0f, 3.5f)) == 7.0f && FunctionalOps.lambdaIter(ints) == 10 && FunctionalOps.functionalForEach(ints) == 10
    }
}
