#!/usr/bin/env python3
"""Apply the *effective* stderr-drop mutation to ChildEvidence.hx.

This is the mutation 42c805d3's commit message names as the one that was
"silently green at 19 pass / 0 fail": make the outer outcome.stderr binding
mutable and null it on the ENOBUFS branch. The naive variant (a `final stderr`
shadow inside the `if` block) is deliberately NOT used: it is inert.

Run with the repository root as argv[1].
"""
import sys
from pathlib import Path

root = Path(sys.argv[1]).resolve()
target = root / "packages/driver/src/driver/ChildEvidence.hx"
text = target.read_text()

BEFORE_BIND = "        final stderr = outcome.stderr;\n"
AFTER_BIND = "        var stderr = outcome.stderr;\n"

BEFORE_BRANCH = """                captureError = errorCodeName == "ENOBUFS"
                    ? 'the host stopped the child at the $maxBufferBytes byte capture limit: $launchError'
                    : 'the host reported $errorCodeName while the child ran, so the capture is uncertain: $launchError';
"""
AFTER_BRANCH = """                if (errorCodeName == "ENOBUFS") {
                    stderr = null;
                    captureError = 'the host stopped the child at the $maxBufferBytes byte capture limit: $launchError';
                } else {
                    captureError = 'the host reported $errorCodeName while the child ran, so the capture is uncertain: $launchError';
                }
"""

if AFTER_BIND in text:
    raise SystemExit("mutation already applied; refusing to run twice")

for name, needle in (("binding", BEFORE_BIND), ("branch", BEFORE_BRANCH)):
    count = text.count(needle)
    if count != 1:
        raise SystemExit(f"anchor {name}: expected exactly 1 occurrence, found {count}")

text = text.replace(BEFORE_BIND, AFTER_BIND, 1).replace(BEFORE_BRANCH, AFTER_BRANCH, 1)
target.write_text(text)
print("mutation applied to", target)
