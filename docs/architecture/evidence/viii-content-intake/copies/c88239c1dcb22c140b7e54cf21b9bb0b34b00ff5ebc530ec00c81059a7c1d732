#[derive(Clone, Copy)]
pub struct BytesOps;

impl BytesOps {
    pub fn bytes_ops_build() -> Vec<u8> {
        let mut out = vec![0u8; 8usize];
        out[0usize] = 1u8;
        out[1usize] = 2u8;
        let mut source = vec![0u8; 4usize];
        source[0usize] = 10u8;
        source[1usize] = 11u8;
        source[2usize] = 12u8;
        source[3usize] = 13u8;
        out[2usize..usize::try_from(2 + 3).unwrap_or(0)].copy_from_slice(&source[1usize..usize::try_from(1 + 3).unwrap_or(0)]);
        out[5usize..usize::try_from(5 + 2).unwrap_or(0)].fill(165u8);
        return out;
    }
}
