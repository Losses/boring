package boring

object SumOfFloatLocalOps {
    fun total(values: MutableList<Double>): Double {
        val accumulate = fun(): Double {
    return values.sumOf { value -> (value).toDouble() }
}
        return accumulate()
    }

    fun weighted(values: MutableList<Double>, weight: Double): Double {
        val accumulate = fun(): Double {
    return values.sumOf { value -> (value * weight).toDouble() }
}
        return accumulate()
    }
}
