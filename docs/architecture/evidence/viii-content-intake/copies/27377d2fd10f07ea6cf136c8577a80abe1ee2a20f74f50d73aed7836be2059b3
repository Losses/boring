#![cfg(test)]

use crate::boring::guarded_box::GuardedBox;
use crate::boring::guarded_rect::GuardedRect;
use crate::boring::m2_option_vec_ops::M2OptionVecOps;
use crate::runtime::test as testlib;
use crate::runtime::test_core;
use crate::runtime::u_string::UStr;
use crate::runtime::u_string::UString;


#[test]
fn nullable_array_receiver() {
    testlib::run("tests.M2OptionVecTests.nullableArrayReceiver", "tests.M2OptionVecTests.nullableArrayReceiver: nullable array receiver pushes and joins", || {
        let mut ops = M2OptionVecOps::new();
        ops.tags = None;
        test_core::TestCore::test_core_equals_string(UStr::new(&[97]), ops.add_tag(UStr::new(&[97])).as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[97,44,98]), ops.add_tag(UStr::new(&[98])).as_ustr(), UStr::new(&[]));
    });
}

#[test]
fn nullable_set_receiver() {
    testlib::run("tests.M2OptionVecTests.nullableSetReceiver", "tests.M2OptionVecTests.nullableSetReceiver: nullable sorted set receiver queries membership", || {
        let mut ops = M2OptionVecOps::new();
        ops.seen = None;
        test_core::TestCore::test_core_equals_bool(false, ops.has_seen(5), UStr::new(&[]));
        test_core::TestCore::test_core_equals_int(0i32, i32::from_ne_bytes(((ops.count_seen()) as i32).to_ne_bytes()), UStr::new(&[]));
    });
}

#[test]
fn nullable_map_receiver() {
    testlib::run("tests.M2OptionVecTests.nullableMapReceiver", "tests.M2OptionVecTests.nullableMapReceiver: nullable sorted map receiver reads a stored value", || {
        let mut ops = M2OptionVecOps::new();
        ops.index = None;
        test_core::TestCore::test_core_equals_bool(true, ops.read_index(7), UStr::new(&[]));
    });
}

#[test]
fn vec_copy() {
    testlib::run("tests.M2OptionVecTests.vecCopy", "tests.M2OptionVecTests.vecCopy: Vec copy clones the array", || {
        test_core::TestCore::test_core_equals_string(UStr::new(&[49,44,50,44,51]), M2OptionVecOps::m2_option_vec_ops_copy_array(&vec![
    UString::from("1").to_ustring(),
    UString::from("2").to_ustring(),
    UString::from("3").to_ustring(),
]).as_ustr(), UStr::new(&[]));
    });
}

#[test]
fn vec_shift() {
    testlib::run("tests.M2OptionVecTests.vecShift", "tests.M2OptionVecTests.vecShift: Vec shift removes the first element", || {
        test_core::TestCore::test_core_equals_string(UStr::new(&[49,58,50,44,51]), M2OptionVecOps::m2_option_vec_ops_shift_array(&mut vec![
    UString::from("1").to_ustring(),
    UString::from("2").to_ustring(),
    UString::from("3").to_ustring(),
]).as_ustr(), UStr::new(&[]));
    });
}

#[test]
fn vec_unshift() {
    testlib::run("tests.M2OptionVecTests.vecUnshift", "tests.M2OptionVecTests.vecUnshift: Vec unshift inserts at the front", || {
        test_core::TestCore::test_core_equals_string(UStr::new(&[57,44,49,44,50]), M2OptionVecOps::m2_option_vec_ops_unshift_array(&mut vec![UString::from("1").to_ustring(), UString::from("2").to_ustring()], UStr::new(&[57])).as_ustr(), UStr::new(&[]));
    });
}

#[test]
fn vec_index_of() {
    testlib::run("tests.M2OptionVecTests.vecIndexOf", "tests.M2OptionVecTests.vecIndexOf: Vec indexOf finds the element position", || {
        test_core::TestCore::test_core_equals_string(UStr::new(&[49]), M2OptionVecOps::m2_option_vec_ops_index_of_array(&vec![
    UString::from("a").to_ustring(),
    UString::from("b").to_ustring(),
    UString::from("c").to_ustring(),
], UStr::new(&[98])).as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[45,49]), M2OptionVecOps::m2_option_vec_ops_index_of_array(&vec![
    UString::from("a").to_ustring(),
    UString::from("b").to_ustring(),
    UString::from("c").to_ustring(),
], UStr::new(&[122])).as_ustr(), UStr::new(&[]));
    });
}

#[test]
fn index_of_compared() {
    testlib::run("tests.M2OptionVecTests.indexOfCompared", "tests.M2OptionVecTests.indexOfCompared: Vec and String indexOf compared against -1 share the signed domain", || {
        test_core::TestCore::test_core_equals_bool(true, M2OptionVecOps::m2_option_vec_ops_has_index(&vec![UString::from("a").to_ustring(), UString::from("b").to_ustring()], UStr::new(&[98])), UStr::new(&[]));
        test_core::TestCore::test_core_equals_bool(false, M2OptionVecOps::m2_option_vec_ops_has_index(&vec![UString::from("a").to_ustring(), UString::from("b").to_ustring()], UStr::new(&[122])), UStr::new(&[]));
        test_core::TestCore::test_core_equals_bool(true, M2OptionVecOps::m2_option_vec_ops_has_text_index(UStr::new(&[97,98,99]), UStr::new(&[98])), UStr::new(&[]));
        test_core::TestCore::test_core_equals_bool(false, M2OptionVecOps::m2_option_vec_ops_has_text_index(UStr::new(&[97,98,99]), UStr::new(&[122])), UStr::new(&[]));
    });
}

#[test]
fn guarded_copy_local() {
    testlib::run("tests.M2OptionVecTests.guardedCopyLocal", "tests.M2OptionVecTests.guardedCopyLocal: guarded-copy local reads fields of the proven inner value", || {
        test_core::TestCore::test_core_equals_bool(true, M2OptionVecOps::m2_option_vec_ops_guarded_copy_width(Some(GuardedRect::new(1.5f64, 2.5f64))) == 4.0f64, UStr::new(&[]));
        test_core::TestCore::test_core_equals_bool(true, M2OptionVecOps::m2_option_vec_ops_guarded_copy_width(None) == 0.0f64, UStr::new(&[]));
        let mut r#box = GuardedBox::new();
        test_core::TestCore::test_core_equals_bool(true, M2OptionVecOps::m2_option_vec_ops_guarded_copy_field_width((r#box).clone()) == 0.0f64, UStr::new(&[]));
        r#box.rect = Some(GuardedRect::new(3.0f64, 4.0f64).clone());
        test_core::TestCore::test_core_equals_bool(true, M2OptionVecOps::m2_option_vec_ops_guarded_copy_field_width((r#box).clone()) == 7.0f64, UStr::new(&[]));
    });
}

#[test]
fn guarded_and_chain() {
    testlib::run("tests.M2OptionVecTests.guardedAndChain", "tests.M2OptionVecTests.guardedAndChain: guarded and-chain reads fields of the proven inner value", || {
        test_core::TestCore::test_core_equals_bool(true, M2OptionVecOps::m2_option_vec_ops_guarded_and_span(Some(GuardedRect::new(1.5f64, 2.5f64)), 2.0f64) == 2.5f64, UStr::new(&[]));
        test_core::TestCore::test_core_equals_bool(true, M2OptionVecOps::m2_option_vec_ops_guarded_and_span(Some(GuardedRect::new(5.0f64, 2.5f64)), 2.0f64) == 0.0f64, UStr::new(&[]));
        test_core::TestCore::test_core_equals_bool(true, M2OptionVecOps::m2_option_vec_ops_guarded_and_span(None, 2.0f64) == 0.0f64, UStr::new(&[]));
    });
}

#[test]
fn guarded_holder_field() {
    testlib::run("tests.M2OptionVecTests.guardedHolderField", "tests.M2OptionVecTests.guardedHolderField: guarded holder field copies the proven inner value", || {
        let mut r#box = GuardedBox::new();
        test_core::TestCore::test_core_equals_bool(true, M2OptionVecOps::m2_option_vec_ops_guarded_holder_span((r#box).clone()) == 0.0f64, UStr::new(&[]));
        r#box.rect = Some(GuardedRect::new(3.0f64, 4.0f64).clone());
        test_core::TestCore::test_core_equals_bool(true, M2OptionVecOps::m2_option_vec_ops_guarded_holder_span((r#box).clone()) == 7.0f64, UStr::new(&[]));
    });
}
