#![cfg(test)]

use crate::runtime::test as testlib;
use crate::runtime::u_string::UStr;
use crate::tests::hand_written_loop_position_support::HandWrittenLoopPositionSupport;
use crate::tests::test_helper::*;


#[test]
fn direct_loop() {
    testlib::run("tests.HandWrittenLoopPositionTests.directLoop", "tests.HandWrittenLoopPositionTests.directLoop: hand-written accumulation loop remains valid at direct position", || {
        assert_equals_vec_u32(&vec![2, 3, 4], &HandWrittenLoopPositionSupport::hand_written_loop_position_support_accumulate(&vec![1, 2, 3]), UStr::new(&[]));
    });
}

#[test]
fn loop_in_if() {
    testlib::run("tests.HandWrittenLoopPositionTests.loopInIf", "tests.HandWrittenLoopPositionTests.loopInIf: hand-written accumulation loop remains valid in if", || {
        assert_equals_vec_u32(&vec![2, 3, 4], &HandWrittenLoopPositionSupport::hand_written_loop_position_support_nested_if(&vec![1, 2, 3]), UStr::new(&[]));
    });
}

#[test]
fn loop_in_while() {
    testlib::run("tests.HandWrittenLoopPositionTests.loopInWhile", "tests.HandWrittenLoopPositionTests.loopInWhile: hand-written accumulation loop remains valid in while", || {
        assert_equals_vec_u32(&vec![2, 3, 4], &HandWrittenLoopPositionSupport::hand_written_loop_position_support_nested_while(&vec![1, 2, 3]), UStr::new(&[]));
    });
}

#[test]
fn nested_loop() {
    testlib::run("tests.HandWrittenLoopPositionTests.nestedLoop", "tests.HandWrittenLoopPositionTests.nestedLoop: nested hand-written loop does not synthesize a closure", || {
        assert_equals_vec_u32(&vec![2, 3, 4, 2, 3, 4], &HandWrittenLoopPositionSupport::hand_written_loop_position_support_outer_loop(&vec![1, 2, 3]), UStr::new(&[]));
    });
}
