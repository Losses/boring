package tests

import boring.runtime.test.Test
import registry.Core
import registry.CoreException

object RegistryParseArgsSupport {
    fun message(argv: MutableList<String>): String {
        var text = ""
        try {
            Core.parseArgs(argv)
        } catch (e: CoreException) {
            text = e.message
        }
        return text
    }
}

class RegistryParseArgsTests {
@boring.test.Test
    fun missingRequired() {
        Test.run("tests.RegistryParseArgsTests.missingRequired", "tests.RegistryParseArgsTests.missingRequired: parseArgs reports missing required flags") {
                val text = RegistryParseArgsSupport.message(mutableListOf<String>("--tree", "tree", "--output", "site"))
                Test.equals(true, text.startsWith("required flags missing"), null)
        }
    }

@boring.test.Test
    fun help() {
        Test.run("tests.RegistryParseArgsTests.help", "tests.RegistryParseArgsTests.help: parseArgs reports help usage") {
                val text = RegistryParseArgsSupport.message(mutableListOf<String>("--help", "value"))
                Test.equals("usage: generate --tree <dir> --output <site> --base-url <url> [--swift-scope <scope>] [--archive-base <url>]", text, null)
        }
    }

@boring.test.Test
    fun unknown() {
        Test.run("tests.RegistryParseArgsTests.unknown", "tests.RegistryParseArgsTests.unknown: parseArgs reports unknown flags") {
                val text = RegistryParseArgsSupport.message(mutableListOf<String>("--wat", "value"))
                Test.equals(true, text.startsWith("unknown flag"), null)
        }
    }
}
