#![cfg(test)]

use crate::boring::branched_optional_field_ops::BranchedOptionalFieldOps;
use crate::runtime::test as testlib;
use crate::runtime::test_core;
use crate::runtime::u_string::UStr;


#[test]
fn penalty() {
    testlib::run("tests.BranchedOptionalFieldOpsTests.penalty", "tests.BranchedOptionalFieldOpsTests.penalty: a branch-assigned optional field keeps the parameter null check", || {
        test_core::TestCore::test_core_equals_int(2i32, i32::from_ne_bytes(((BranchedOptionalFieldOps::branched_optional_field_ops_penalty()) as i32).to_ne_bytes()), UStr::new(&[]));
        test_core::TestCore::test_core_equals_int(9i32, i32::from_ne_bytes(((BranchedOptionalFieldOps::branched_optional_field_ops_explicit()) as i32).to_ne_bytes()), UStr::new(&[]));
    });
}

#[test]
fn rate() {
    testlib::run("tests.BranchedOptionalFieldOpsTests.rate", "tests.BranchedOptionalFieldOpsTests.rate: a branch-assigned optional float field keeps the parameter null check", || {
        test_core::TestCore::test_core_equals_float(0.5f32, BranchedOptionalFieldOps::branched_optional_field_ops_rate(), UStr::new(&[]));
    });
}

#[test]
fn rule_tag() {
    testlib::run("tests.BranchedOptionalFieldOpsTests.ruleTag", "tests.BranchedOptionalFieldOpsTests.ruleTag: a branch-assigned interface field declares its owned Rust type", || {
        test_core::TestCore::test_core_equals_string(UStr::new(&[99,111,110,99,114,101,116,101]), BranchedOptionalFieldOps::branched_optional_field_ops_rule_tag().as_ustr(), UStr::new(&[]));
    });
}
