#[derive(Clone, Copy)]
pub struct NullableFloatCompareOps;

impl NullableFloatCompareOps {
    pub fn nullable_float_compare_ops_structural_zero(leading: Option<f32>, trailing: Option<f32>) -> bool {
        let lead = match &(leading) { None => 0.0f32, Some(__option) => *__option };
        let trail = match &(trailing) { None => 0.0f32, Some(__option1) => *__option1 };
        let structural = lead + trail;
        return structural == 0 as f32 && lead == 0 as f32;
    }

    pub fn nullable_float_compare_ops_not_zero(value: Option<f32>) -> bool {
        let amount = match &(value) { None => 0.0f32, Some(__option2) => *__option2 };
        return amount != 0 as f32;
    }
}
