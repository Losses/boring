use std::sync::Arc;


#[derive(Clone, Copy)]
pub struct FallibleLocalFunctionOps;

impl FallibleLocalFunctionOps {
    pub fn fallible_local_function_ops_guard(value: u32, limit: u32) -> Result<u32, FallibleLocalFunctionFault> {
        let check: Arc<dyn Fn(u32) -> Result<(), FallibleLocalFunctionFault> + Send + Sync + 'static> = {  Arc::new(move |candidate| {
        if i32::from_ne_bytes(((candidate) as i32).to_ne_bytes()) > (i32::from_ne_bytes(((limit) as i32).to_ne_bytes())) {
            return Err(FallibleLocalFunctionFault::new("over limit"));
        }
        Ok(())
}) };
        check(value)?;
        return Ok(value);
    }
}

#[derive(Debug, Clone, PartialEq)]
pub struct FallibleLocalFunctionFault {
    pub message: String,
}
impl FallibleLocalFunctionFault {
    pub fn new(message: &str) -> Self {
        Self { message: message.to_string() }
    }
}
impl std::fmt::Display for FallibleLocalFunctionFault {
    fn fmt(&self, formatter: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        write!(formatter, "{}", self.message)
    }
}
impl std::error::Error for FallibleLocalFunctionFault {}
