#![cfg(test)]

use crate::boring::local_shadow_ops::LocalShadowOps;
use crate::runtime::test as testlib;
use crate::runtime::test_core;
use crate::runtime::u_string::UStr;


#[test]
fn arrays() {
    testlib::run("tests.LocalShadowTests.arrays", "tests.LocalShadowTests.arrays: array comprehensions preserve both local values", || {
        test_core::TestCore::test_core_equals_int(10i32, i32::from_ne_bytes(((LocalShadowOps::local_shadow_ops_arrays()) as i32).to_ne_bytes()), UStr::new(&[]));
    });
}

#[test]
fn shadow() {
    testlib::run("tests.LocalShadowTests.shadow", "tests.LocalShadowTests.shadow: shadowed locals retain their distinct values", || {
        test_core::TestCore::test_core_equals_string(UStr::new(&[97,98]), LocalShadowOps::local_shadow_ops_shadow().as_ustr(), UStr::new(&[]));
    });
}

#[test]
fn single() {
    testlib::run("tests.LocalShadowTests.single", "tests.LocalShadowTests.single: ordinary local remains unchanged", || {
        test_core::TestCore::test_core_equals_int(42i32, i32::from_ne_bytes(((LocalShadowOps::local_shadow_ops_single()) as i32).to_ne_bytes()), UStr::new(&[]));
    });
}
