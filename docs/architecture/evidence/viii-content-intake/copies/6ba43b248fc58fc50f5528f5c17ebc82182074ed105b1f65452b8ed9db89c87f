use crate::runtime::fs::Fs;
use crate::runtime::u_string::UStr;
use crate::runtime::u_string::UString;


#[derive(Clone, Copy)]
pub struct PlatformModulesTestSupport;

impl PlatformModulesTestSupport {
    pub const PLATFORM_MODULES_TEST_SUPPORT_DIR: &UStr = unsafe { &*(&[0x006Fu16, 0x0075u16, 0x0074u16, 0x002Fu16, 0x0070u16, 0x006Cu16, 0x0061u16, 0x0074u16, 0x0066u16, 0x006Fu16, 0x0072u16, 0x006Du16, 0x002Du16, 0x006Du16, 0x006Fu16, 0x0064u16, 0x0075u16, 0x006Cu16, 0x0065u16, 0x0073u16] as *const [u16] as *const crate::runtime::u_string::UStr) };

    pub fn platform_modules_test_support_text_path(name: &UStr) -> UString {
        return UString::from(format!("{}", { let mut __s = UString::new(); __s += PlatformModulesTestSupport::PLATFORM_MODULES_TEST_SUPPORT_DIR.to_ustring().as_ustr(); __s += &(UString::from("/")); __s += name; __s += &(UString::from(".txt")); __s }).as_str());
    }

    pub fn platform_modules_test_support_ensure_dir() {
        Fs::make_dirs(PlatformModulesTestSupport::PLATFORM_MODULES_TEST_SUPPORT_DIR.to_ustring().as_ustr());
    }

    pub fn platform_modules_test_support_has_entry(dir: &UStr, name: &UStr) -> bool {
        let names = Fs::read_dir(dir);
        for i in 0..match u32::try_from(names.len()) { Ok(value) => value, Err(_) => u32::MAX } {
            if names[usize::try_from(i).unwrap_or(0)].clone() == name {
                return true;
            }
        }
        return false;
    }

    pub fn platform_modules_test_support_no_dot_entries(dir: &UStr) -> bool {
        let names = Fs::read_dir(dir);
        for i in 0..match u32::try_from(names.len()) { Ok(value) => value, Err(_) => u32::MAX } {
            if names[usize::try_from(i).unwrap_or(0)].clone() == UString::from(".") || (names[usize::try_from(i).unwrap_or(0)]).clone() == UString::from("..") {
                return false;
            }
        }
        return true;
    }
}
