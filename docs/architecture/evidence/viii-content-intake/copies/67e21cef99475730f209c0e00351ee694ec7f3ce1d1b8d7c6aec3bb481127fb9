#![cfg(test)]

use crate::registry::json::Json;
use crate::runtime::test as testlib;
use crate::runtime::test_core;
use crate::runtime::u_string::UStr;


#[test]
fn round_trip() {
    testlib::run("tests.RegistryJsonTests.roundTrip", "tests.RegistryJsonTests.roundTrip: JSON preserves escaped nested values and formatting", || {
        let value = Json::json_read(UStr::new(&[123,34,116,101,120,116,34,58,34,97,92,110,92,34,98,34,44,34,110,101,115,116,101,100,34,58,91,49,44,50,46,53,44,116,114,117,101,44,110,117,108,108,93,125])).unwrap();
        test_core::TestCore::test_core_equals_string(UStr::new(&[123,10,32,32,34,116,101,120,116,34,58,32,34,97,92,110,92,34,98,34,44,10,32,32,34,110,101,115,116,101,100,34,58,32,91,10,32,32,32,32,49,44,10,32,32,32,32,50,46,53,44,10,32,32,32,32,116,114,117,101,44,10,32,32,32,32,110,117,108,108,10,32,32,93,10,125,10]), Json::json_write((value).clone()).as_ustr(), UStr::new(&[]));
    });
}
