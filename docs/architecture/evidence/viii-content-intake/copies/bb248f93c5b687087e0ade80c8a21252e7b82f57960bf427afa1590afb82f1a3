package boring

object StringUnitOps {
    fun codeInRange(text: String): Int? {
        return run { val _s = text; val _i = 1; if (_i >= 0 && _i < _s.length) _s[_i].code else null }
    }

    fun codeAtEnd(text: String): Int? {
        return run { val _s = text; val _i = text.length - 1; if (_i >= 0 && _i < _s.length) _s[_i].code else null }
    }

    fun codeOutOfRange(text: String): Int? {
        return run { val _s = text; val _i = text.length + 4; if (_i >= 0 && _i < _s.length) _s[_i].code else null }
    }

    fun isSpaceAt(text: String, index: Int): Boolean {
        val c = run { val _s = text; val _i = index; if (_i >= 0 && _i < _s.length) _s[_i].code else null }
        return c == 32
    }

    fun codeAtOrFallback(text: String, index: Int): Int {
        val c = run { val _s = text; val _i = index; if (_i >= 0 && _i < _s.length) _s[_i].code else null }
        return (if ((c == null)) -1 else c)
    }

    fun codeAt(text: String, index: Int): Int? {
        return run { val _s = text; val _i = index; if (_i >= 0 && _i < _s.length) _s[_i].code else null }
    }

    fun unitCut(text: String, pos: Int, len: Int): String {
        return run { val _s = text; val _pos = pos; val _len = len; val _start = if (_pos < 0) maxOf(0, _s.length + _pos) else minOf(_pos, _s.length); if (_len < 0) "" else { val _end = minOf(_s.length, _start + _len); _s.substring(_start, _end) } }
    }

    fun unitCutFrom(text: String, pos: Int): String {
        return run { val _s = text; val _pos = pos; val _start = if (_pos < 0) maxOf(0, _s.length + _pos) else minOf(_pos, _s.length); _s.substring(_start) }
    }

    fun splitCount(text: String): Int {
        return text.split(".").size
    }

    fun splitFirst(text: String): String {
        return text.split(".")[0]
    }

    fun splitEmptyParts(text: String): Int {
        return text.split("..").size
    }

    fun splitAbsent(text: String): Int {
        return text.split("|").size
    }

    fun splitUnitCount(text: String): Int {
        val parts = text.chunked(1).toMutableList()
        return parts.size
    }

    fun splitUnitAt(text: String, index: Int): String {
        val parts = text.chunked(1).toMutableList()
        return parts[index]
    }

    fun splitUnitCode(text: String, index: Int): Int? {
        val parts = text.chunked(1).toMutableList()
        return run { val _s = parts[index]; val _i = 0; if (_i >= 0 && _i < _s.length) _s[_i].code else null }
    }

    fun splitUnits(text: String): MutableList<String> {
        return text.chunked(1).toMutableList()
    }
}
