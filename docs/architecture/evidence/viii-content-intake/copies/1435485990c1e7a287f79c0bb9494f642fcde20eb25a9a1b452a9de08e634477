        test_core::TestCore::test_core_equals_string(UStr::new(&[80,114,105,110,116,101,100,82,101,99,111,114,100,40,99,111,117,110,116,61,55,44,32,114,97,116,105,111,61,49,46,53,44,32,105,110,110,101,114,61,80,114,105,110,116,101,100,73,110,110,101,114,40,110,97,109,101,61,78,97,109,101,41,44,32,110,111,116,101,61,80,114,105,110,116,101,100,73,110,110,101,114,40,110,97,109,101,61,78,111,116,101,41,41]), (UString::from(format!("{}", value.to_string()).as_str())).as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string((UString::from(format!("{}", { let mut __s = UString::new(); __s += &(UString::from("PrintedRecord(")); __s += &(UString::from("count=")); __s += &(UString::from((value.count).to_string().as_str())); __s += &(UString::from(", ")); __s += &(UString::from("ratio=")); __s += &(crate::runtime::fp_helper::FPHelper::format_float(value.ratio)); __s += &(UString::from(", ")); __s += &(UString::from("inner=")); __s += UString::from(format!("{}", (value.inner).clone().to_string()).as_str()).as_ustr(); __s += &(UString::from(", ")); __s += &(UString::from("note=")); __s += (match &(value.note) { None => UString::from("null"), Some(__option3) => UString::from(format!("{}", __option3.to_string()).as_str()) }).as_ustr(); __s += &(UString::from(")")); __s }).as_str())).as_ustr(), (UString::from(format!("{}", value.to_string()).as_str())).as_ustr(), UStr::new(&[]));
    });
