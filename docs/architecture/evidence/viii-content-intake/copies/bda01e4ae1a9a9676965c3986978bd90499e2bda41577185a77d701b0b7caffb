package tests

import boring.ConstructorStatementOps
import boring.runtime.test.Test

class ConstructorStatementTests {
@boring.test.Test
    fun testComprehension() {
        Test.run("tests.ConstructorStatementTests.testComprehension", "tests.ConstructorStatementTests.testComprehension: constructor lowers array comprehension fill") {
                val value = ConstructorStatementOps(2, mutableListOf<Int>())
                Test.equals(3, value.filled.size, "constructor fill length")
                Test.equals(0, value.filled[2], "constructor fill value")
        }
    }

@boring.test.Test
    fun testPipelineBlockLambda() {
        Test.run("tests.ConstructorStatementTests.testPipelineBlockLambda", "tests.ConstructorStatementTests.testPipelineBlockLambda: constructor lowers pipeline call with block lambda") {
                val value = ConstructorStatementOps(0, mutableListOf<Int>(1, 4))
                Test.equals(2, value.mapped.size, "constructor pipeline length")
                Test.equals(2, value.mapped[0], "constructor pipeline first")
                Test.equals(5, value.mapped[1], "constructor pipeline second")
        }
    }
}
