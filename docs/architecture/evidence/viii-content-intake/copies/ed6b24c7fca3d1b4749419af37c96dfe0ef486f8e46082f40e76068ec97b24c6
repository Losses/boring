#!/usr/bin/env python3
"""Transitive spawn census for the 24 timeout-class tests.

Categories:
  (1) direct     : Bun.spawn* literal inside the test body
  (2) local-help : reached through a function declared in the SAME file (recursive)
  (3) import-help: reached through an imported shared helper
  (4) no-spawn   : no heavy process reachable -> genuine extrinsic timeout

Also reports observed elapsed vs configured budget ("over_budget" = the runner
did not stop the body at the deadline).
"""
import json, os, re
from collections import Counter

REPO = "/home/losses/Development/tq-workspace/boring-wt-architecture"
OUT = "/home/losses/Development/tq-workspace/dc-warn/out/test-timeout-budget/evidence"
tset = json.load(open(os.path.join(OUT, "timeout-set.json")))

SPAWN = re.compile(r"Bun\.(?:spawn|spawnSync|spawns|\$)\s*\(")
CALL = re.compile(r"\b([A-Za-z_$][A-Za-z0-9_$]*)\s*\(")
FUNC_DECL = re.compile(r"(?:^|\n)[ \t]*(?:export\s+)?(?:async\s+)?function\s+([A-Za-z_$][A-Za-z0-9_$]*)\s*\(")
FUNC_CONST = re.compile(r"(?:^|\n)[ \t]*(?:export\s+)?(?:const|let|var)\s+([A-Za-z_$][A-Za-z0-9_$]*)\s*=\s*(?:async\s*)?(?:function\b|\()")
IMPORT = re.compile(r"import\s+(?:type\s+)?\{([^}]*)\}\s+from\s+[\"']([^\"']+)[\"']")
IMPORT_DEFAULT = re.compile(r"import\s+([A-Za-z_$][A-Za-z0-9_$]*)\s+from\s+[\"']([^\"']+)[\"']")

def read(p):
    return open(p, encoding="utf-8", errors="replace").read()

def match_delim(src, i):
    """src[i] is one of ( { [ -> index of the matching closer (quote/comment aware)."""
    pairs = {"(": ")", "{": "}", "[": "]"}
    opener = src[i]
    closer = pairs[opener]
    depth = 0
    n = len(src)
    while i < n:
        c = src[i]
        if c in "\"'`":
            q = c
            i += 1
            while i < n:
                if src[i] == "\\":
                    i += 1
                elif src[i] == q:
                    break
                i += 1
        elif c == "/" and i + 1 < n and src[i + 1] == "/":
            while i < n and src[i] != "\n":
                i += 1
        elif c == "/" and i + 1 < n and src[i + 1] == "*":
            i = src.find("*/", i + 2)
            if i < 0:
                return -1
            i += 1
        elif c == opener:
            depth += 1
        elif c == closer:
            depth -= 1
            if depth == 0:
                return i
        i += 1
    return -1

def local_funcs(src):
    out = {}
    for rx in (FUNC_DECL, FUNC_CONST):
        for m in rx.finditer(src):
            name = m.group(1)
            # first '{' at/after the parameter list
            p = src.find("(", m.start())
            pend = match_delim(src, p) if p >= 0 and src[p] == "(" else -1
            if pend < 0:
                continue
            brace = src.find("{", pend)
            if brace < 0:
                continue
            end = match_delim(src, brace)
            if end > 0:
                out.setdefault(name, src[brace:end + 1])
    return out

def imported_names(src):
    out = {}
    for m in IMPORT.finditer(src):
        for part in m.group(1).split(","):
            alias = part.strip().split(" as ")[-1].strip()
            if re.fullmatch(r"[A-Za-z_$][A-Za-z0-9_$]*", alias):
                out[alias] = m.group(2)
    for m in IMPORT_DEFAULT.finditer(src):
        out[m.group(1)] = m.group(2)
    return out

def spawn_commands(text):
    """Binaries of every Bun.spawn*([...]) literal in `text` (program first)."""
    cmds = []
    for m in SPAWN.finditer(text):
        # find the '[' of the argv array
        j = m.end()
        while j < len(text) and text[j] in " \n\t":
            j += 1
        if j >= len(text) or text[j] != "[":
            continue
        e = match_delim(text, j)
        if e < 0:
            continue
        arr = text[j + 1:e]
        lits = [x for x in re.findall(r'"([^"\n]*)"', arr) if x and not x.startswith("-")]
        if lits:
            cmds.append(lits[0])
    return cmds

def expand(name, funcs, seen, depth=0):
    if name in seen or depth > 8:
        return []
    seen.add(name)
    body = funcs.get(name)
    if body is None:
        return []
    found = list(spawn_commands(body))
    for c in CALL.finditer(body):
        if c.group(1) in funcs:
            found += expand(c.group(1), funcs, seen, depth + 1)
    return found

rows = []
for t in tset:
    path = os.path.join(REPO, t["file"])
    src = read(path)
    lines = src.split("\n")
    line = t["lines"][0]
    idx = "\n".join(lines[:line]).rfind("test(")
    p = src.index("(", idx)
    e = match_delim(src, p)
    body = src[p:e + 1]

    funcs = local_funcs(src)
    imports = imported_names(src)

    direct = sorted(set(spawn_commands(body)))
    via_local, local_chain = [], []
    for c in CALL.finditer(body):
        callee = c.group(1)
        if callee in funcs:
            got = expand(callee, funcs, set())
            if got:
                via_local += got
                local_chain.append(callee)
    via_import, import_chain = [], []
    for c in CALL.finditer(body):
        callee = c.group(1)
        if callee in imports and callee not in funcs:
            spec = imports[callee]
            cand = os.path.normpath(os.path.join(os.path.dirname(path), spec))
            for suffix in ("", ".ts", ".js", "/index.ts"):
                if os.path.isfile(cand + suffix):
                    got = spawn_commands(read(cand + suffix))
                    if got:
                        via_import += got
                        import_chain.append(f"{callee} <- {spec}")
                    break

    cat = "1 direct" if direct else "2 local-helper" if via_local else "3 imported-helper" if via_import else "4 NO-SPAWN"
    elapsed = max(t["elapsed"]) if t["elapsed"] else None
    rows.append(dict(name=t["name"], file=t["file"], line=line, budget=t["budget"], elapsed=elapsed,
                     over_budget=(elapsed is not None and elapsed > t["budget"] + 2), category=cat,
                     direct=direct, via_local=sorted(set(via_local)), local_chain=sorted(set(local_chain)),
                     via_import=sorted(set(via_import)), import_chain=sorted(set(import_chain))))

print(f"{'category':<17} {'budget':>8} {'elapsed':>11} {'over?':<6} {'spawns':<26} file:line")
for r in sorted(rows, key=lambda r: (r["category"], r["file"], r["line"])):
    sp = r["direct"] or r["via_local"] or r["via_import"] or []
    chain = f"  <- {r['local_chain'] or r['import_chain']}" if (r["local_chain"] or r["import_chain"]) else ""
    print(f"{r['category']:<17} {r['budget']:>8} {str(r['elapsed']):>11} {str(r['over_budget']):<6} {','.join(sp):<26} {r['file']}:{r['line']}{chain}")
print()
print("category counts:", dict(Counter(r["category"] for r in rows)))
print("over budget (elapsed > budget+2):", [r["name"] for r in rows if r["over_budget"]])
json.dump(rows, open(os.path.join(OUT, "transitive-census.json"), "w"), indent=1)
