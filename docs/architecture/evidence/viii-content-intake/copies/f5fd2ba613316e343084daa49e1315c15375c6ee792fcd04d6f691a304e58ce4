#!/usr/bin/env bash
# Independent cross-check: serial-key safety + nesting dedup bounds.
set -u
HERE="$(cd "$(dirname "$0")" && pwd)"
OUTDIR="${1:-$HERE/out-run}"
mkdir -p "$OUTDIR"
ROOT=/home/losses/Development/tq-workspace/dc-warn/worktrees/param-fix-xcheck
export XDG_CACHE_HOME=/tmp/param-xcheck-nix-cache
timeout 3000 nix develop "$ROOT" -c bash -lc "haxe $HERE/build.hxml" \
	>"$OUTDIR/probe.stdout" 2>"$OUTDIR/probe.stderr"
echo $? >"$OUTDIR/exit.txt"
cat "$OUTDIR/probe.stdout"
echo "--- stderr tail"; tail -5 "$OUTDIR/probe.stderr"
echo "haxe exit=$(cat "$OUTDIR/exit.txt")"
