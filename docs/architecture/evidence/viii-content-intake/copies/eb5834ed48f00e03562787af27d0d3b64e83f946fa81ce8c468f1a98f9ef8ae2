o);\n}\n\nfn main() {\n    // Calling the method is still fine, as i32 implements Debug.\n    some_func(5i32);\n\n    // This would fail to compile now:\n    // struct WithoutDebug;\n    // some_func(WithoutDebug);\n}\n```\n\nRust only looks at the signature of the called function, as such it must\nalready specify all requirements that will be used for every type parameter.\n"},"level":"error","spans":[{"file_name":"xsxm/sib_probe.rs","byte_start":495,"byte_end":537,"line_start":18,"line_end":18,"column_start":23,"column_end":65,"is_primary":false,"text":[{"text":"            return Ok(SibProbe::sib_probe_boom(UStr::new(&[97]))?);","highlight_start":23,"highlight_end":65}],"label":"this can't be annotated with `?` because it has type `Result<_, MsgOnly>`","suggested_replacement":null,"suggestion_applicability":null,"expansion":null},{"file_name":"xsxm/sib_probe.rs","byte_start":537,"byte_end":538,"line_start":18,"line_end":18,"column_start":65,"column_end":66,"is_primary":true,"text":[{"text":"            return Ok(SibProbe::sib_probe_boom(UStr::new(&[97]))?);","highlight_start":65,"highlight_end":66}],"label":"the trait `From<MsgOnly>` is not implemented for `F1Fault`","suggested_replacement":null,"suggestion_applicability":null,"expansion":{"span":{"file_name":"xsxm/sib_probe.rs","byte_start":537,"byte_end":538,"line_start":18,"line_end":18,"column_start":65,"column_end":66,"is_primary":false,"text":[{"text":"            return Ok(SibProbe::sib_probe_boom(UStr::new(&[97]))?);","highlight_start":65,"highlight_end":66}],"label":null,"suggested_replacement":null,"suggestion_applicability":null,"expansion":null},"macro_decl_name":"desugaring of operator `?`","def_site_span":{"file_name":"lib.rs","byte_start":0,"byte_end":0,"line_start":1,"line_end":1,"column_start":1,"column_end":1,"is_primary":false,"text":[],"label":null,"suggested_replacement":null,"suggestion_applicability":null,"expansion":null}}}],"children":[{"message":"`F1Fault` needs to implement `From<MsgOnl