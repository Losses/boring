#[derive(Clone, Copy)]
pub struct RecordOrderOps;

impl RecordOrderOps {
    pub fn record_order_ops_shifted_printed() -> UString {
        return UString::from(format!("{}", RecordOrderShifted::new(1u32, &(UStr::new(&[120])), Some(5)).to_string()).as_str());
    }

    pub fn record_order_ops_shifted_defaulted() -> UString {
        return UString::from(format!("{}", RecordOrderShifted::new(1u32, &(UStr::new(&[120])), Some(0)).to_string()).as_str());
    }

    pub fn record_order_ops_aligned_printed() -> UString {
        return UString::from(format!("{}", RecordOrderAligned::new(1u32, 5u32, &(UStr::new(&[120]))).to_string()).as_str());
    }

    pub fn record_order_ops_shifted_equal() -> bool {
        let left = RecordOrderShifted::new(1u32, &(UStr::new(&[120])), Some(5));
        let right = RecordOrderShifted::new(1u32, &(UStr::new(&[120])), Some(5));
        return left.a == right.a && left.b == right.b && (left.c).to_ustring() == (right.c).to_ustring();
    }
}
