use crate::runtime::sorted_table::SortedTable;
use crate::runtime::u_string::UStr;
use crate::runtime::u_string::UString;


#[derive(Debug, Clone, PartialEq)]
pub struct CompareGateBoolInner {
    pub enabled: bool,
}

impl CompareGateBoolInner {
    pub fn new(enabled: bool) -> Self {
        Self {
            enabled,
        }
    }

    pub fn to_string(&self) -> UString {
        return UString::from(format!("{}", { let mut __s = UString::new(); __s += &(UString::from("CompareGateBoolInner(")); __s += &(UString::from("enabled=")); __s += UString::from((self.enabled).to_string().as_str()).as_ustr(); __s += &(UString::from(")")); __s }).as_str());
    }
}

