#[derive(Debug, Clone, PartialEq)]
pub struct CompareGateSafeInner {
    pub rank: u32,
    pub label: UString,
}

impl CompareGateSafeInner {
    pub fn new(rank: u32, label: &UStr) -> Self {
        Self {
            rank,
            label: label.to_ustring(),
        }
    }

    pub fn to_string(&self) -> UString {
        return UString::from(format!("{}", { let mut __s = UString::new(); __s += &(UString::from("CompareGateSafeInner(")); __s += &(UString::from("rank=")); __s += &(UString::from((self.rank).to_string().as_str())); __s += &(UString::from(", ")); __s += &(UString::from("label=")); __s += (self.label).to_ustring().as_ustr(); __s += &(UString::from(")")); __s }).as_str());
    }
}

pub fn compare_compare_gate_safe_inner(a: &CompareGateSafeInner, b: &CompareGateSafeInner) -> i32 {
    let cmp_rank = match i32::from_ne_bytes((*(&a.rank)).to_ne_bytes()).cmp(&i32::from_ne_bytes((*(&b.rank)).to_ne_bytes())) { core::cmp::Ordering::Less => -1, core::cmp::Ordering::Equal => 0, core::cmp::Ordering::Greater => 1 };
    if cmp_rank != 0 { return cmp_rank; }
    let cmp_label = SortedTable::sorted_table_compare_strings((&a.label).as_ustr(), (&b.label).as_ustr());
    if cmp_label != 0 { return cmp_label; }
    0
}

#[derive(Debug, Clone, PartialEq)]
pub struct CompareGateSafeOuter {
    pub inner: CompareGateSafeInner,
}

impl CompareGateSafeOuter {
    pub fn new(inner: CompareGateSafeInner) -> Self {
