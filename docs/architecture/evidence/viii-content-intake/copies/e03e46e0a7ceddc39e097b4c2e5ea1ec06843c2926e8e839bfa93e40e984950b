        return UString::from(format!("{}", { let mut __s = UString::new(); __s += &(UString::from("CompareGateSafeOuter(")); __s += &(UString::from("inner=")); __s += UString::from(format!("{}", (self.inner).clone().to_string()).as_str()).as_ustr(); __s += &(UString::from(")")); __s }).as_str());
    }
}

pub fn compare_compare_gate_safe_outer(a: &CompareGateSafeOuter, b: &CompareGateSafeOuter) -> i32 {
    let cmp_inner = compare_compare_gate_safe_inner(&a.inner, &b.inner);
    if cmp_inner != 0 { return cmp_inner; }
    0
}

