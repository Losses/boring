    }

    pub fn to_string(&self) -> UString {
        return UString::from(format!("{}", { let mut __s = UString::new(); __s += &(UString::from("CompareGateBoolOuter(")); __s += &(UString::from("inner=")); __s += UString::from(format!("{}", (self.inner).clone().to_string()).as_str()).as_ustr(); __s += &(UString::from(")")); __s }).as_str());
