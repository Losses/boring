#!/usr/bin/env python3
"""Check 3b: every dirty tracked file in coord tree — where do the bytes live?"""
import hashlib, json, os, subprocess

WS = "/home/losses/Development/tq-workspace"
GIT = os.path.join(WS, "boring")
COORD = os.path.join(WS, "boring-wt-architecture")
EXEC = os.path.join(WS, "publication-staging", "execution-option-c-coord")
MANIFEST = os.path.join(WS, "publication-staging", "p09-coord-state", "option-c-source-before.json")
COMMIT = "e1c65975"

def sha256_file(p):
    h = hashlib.sha256()
    with open(p, "rb") as f:
        for c in iter(lambda: f.read(1 << 20), b""):
            h.update(c)
    return h.hexdigest()

manifest = {e["path"]: e for e in json.load(open(MANIFEST))}
status = subprocess.run(["git", "-C", COORD, "status", "--porcelain"],
                        check=True, capture_output=True, text=True).stdout
dirty = [l[3:] for l in status.splitlines() if "M" in l[:2]]
untracked = [l[3:] for l in status.splitlines() if l.startswith("??")]
print(f"dirty tracked: {len(dirty)}; untracked entries: {len(untracked)}")
for p in sorted(dirty):
    cpath, epath = os.path.join(COORD, p), os.path.join(EXEC, p)
    blob = subprocess.run(["git", "-C", GIT, "cat-file", "blob", f"{COMMIT}:{p}"],
                          check=True, capture_output=True).stdout
    committed = hashlib.sha256(blob).hexdigest()
    dirty_bytes = sha256_file(cpath)
    in_exec = os.path.isfile(epath)
    in_manifest = p in manifest
    exec_sha = sha256_file(epath) if in_exec else None
    m_sha = manifest[p]["sha256"] if in_manifest else None
    m_side = [s for s, v in (("committed", committed), ("coord-dirty", dirty_bytes)) if m_sha == v]
    print(f"{p}")
    print(f"   in exec-root={in_exec}  in manifest={in_manifest} (mode {manifest[p]['mode'] if in_manifest else '-'})")
    print(f"   exec==committed: {exec_sha == committed}  exec==coord-dirty: {exec_sha == dirty_bytes}")
    print(f"   manifest matches: {m_side or 'NEITHER'}")
    import subprocess as sp
    mt = sp.run(["stat", "-c", "%y", cpath], check=True, capture_output=True, text=True).stdout.strip()
    mte = sp.run(["stat", "-c", "%y", epath], check=True, capture_output=True, text=True).stdout.strip() if in_exec else "-"
    print(f"   mtime coord={mt}  exec={mte}")
