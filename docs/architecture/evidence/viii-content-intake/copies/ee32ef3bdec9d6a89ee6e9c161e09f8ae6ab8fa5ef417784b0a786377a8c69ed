package tests

import boring.ArithmeticOps
import boring.runtime.test.Test

class ArithmeticTests {
@boring.test.Test
    fun testWithinInt() {
        Test.run("tests.ArithmeticTests.testWithinInt", "tests.ArithmeticTests.testWithinInt: within checks integer range inclusion") {
                Test.equals(true, ArithmeticOps.checkWithinInt(5, 1, 10), null)
                Test.equals(true, ArithmeticOps.checkWithinInt(1, 1, 10), null)
                Test.equals(true, ArithmeticOps.checkWithinInt(10, 1, 10), null)
                Test.equals(false, ArithmeticOps.checkWithinInt(0, 1, 10), null)
                Test.equals(false, ArithmeticOps.checkWithinInt(11, 1, 10), null)
        }
    }

@boring.test.Test
    fun testWithinFloat() {
        Test.run("tests.ArithmeticTests.testWithinFloat", "tests.ArithmeticTests.testWithinFloat: within checks float range inclusion") {
                Test.equals(true, ArithmeticOps.checkWithinFloat(5.5f, 1.0f, 10.0f), null)
                Test.equals(true, ArithmeticOps.checkWithinFloat(1.0f, 1.0f, 10.0f), null)
                Test.equals(true, ArithmeticOps.checkWithinFloat(10.0f, 1.0f, 10.0f), null)
                Test.equals(false, ArithmeticOps.checkWithinFloat(0.9f, 1.0f, 10.0f), null)
                Test.equals(false, ArithmeticOps.checkWithinFloat(10.1f, 1.0f, 10.0f), null)
        }
    }

@boring.test.Test
    fun testCoerceAtLeast() {
        Test.run("tests.ArithmeticTests.testCoerceAtLeast", "tests.ArithmeticTests.testCoerceAtLeast: coerceAtLeast clamps values to floor") {
                Test.equals(5, ArithmeticOps.clampLeastInt(3, 5), null)
                Test.equals(8, ArithmeticOps.clampLeastInt(8, 5), null)
                Test.equals(5.0f, ArithmeticOps.clampLeastFloat(3.2f, 5.0f), null)
                Test.equals(8.4f, ArithmeticOps.clampLeastFloat(8.4f, 5.0f), null)
        }
    }

@boring.test.Test
    fun testCoerceAtMost() {
        Test.run("tests.ArithmeticTests.testCoerceAtMost", "tests.ArithmeticTests.testCoerceAtMost: coerceAtMost clamps values to ceiling") {
                Test.equals(5, ArithmeticOps.clampMostInt(8, 5), null)
                Test.equals(3, ArithmeticOps.clampMostInt(3, 5), null)
                Test.equals(5.0f, ArithmeticOps.clampMostFloat(8.2f, 5.0f), null)
                Test.equals(3.4f, ArithmeticOps.clampMostFloat(3.4f, 5.0f), null)
        }
    }

@boring.test.Test
    fun testCoerceIn() {
        Test.run("tests.ArithmeticTests.testCoerceIn", "tests.ArithmeticTests.testCoerceIn: coerceIn clamps values to range") {
                Test.equals(10, ArithmeticOps.clampInInt(5, 10, 20), null)
                Test.equals(15, ArithmeticOps.clampInInt(15, 10, 20), null)
                Test.equals(20, ArithmeticOps.clampInInt(25, 10, 20), null)
                Test.equals(10.0f, ArithmeticOps.clampInFloat(5.5f, 10.0f, 20.0f), null)
                Test.equals(15.5f, ArithmeticOps.clampInFloat(15.5f, 10.0f, 20.0f), null)
                Test.equals(20.0f, ArithmeticOps.clampInFloat(25.5f, 10.0f, 20.0f), null)
        }
    }

@boring.test.Test
    fun testIntRange() {
        Test.run("tests.ArithmeticTests.testIntRange", "tests.ArithmeticTests.testIntRange: IntRange contains evaluates bounds") {
                Test.equals(true, ArithmeticOps.inRange(10, 20, 10), null)
                Test.equals(true, ArithmeticOps.inRange(10, 20, 15), null)
                Test.equals(true, ArithmeticOps.inRange(10, 20, 20), null)
                Test.equals(false, ArithmeticOps.inRange(10, 20, 9), null)
                Test.equals(false, ArithmeticOps.inRange(10, 20, 21), null)
        }
    }
}
