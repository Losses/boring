#!/usr/bin/env bash
# tmleak recheck runner: regenerate the xs-testmod fixture under ONE compiler
# state and archive fully-reviewable evidence.
# usage: bash tmleak-run-state.sh <state:pristine|as-reviewed|fixed>
set -uo pipefail
TOP=/home/losses/Development/tq-workspace
MW=/home/losses/Development/tq-workspace/dc-warn/worktrees/tmleak-recheck
FIX=$TOP/dc-warn/out/rust-regression-fix
EV=$TOP/dc-warn/out/testmod-leak-recheck/evidence
NIXENV="XDG_CACHE_HOME=/tmp/tmleak-nix-cache TMPDIR=/tmp/tmleak-nix-cache"
STATE=$1
case $STATE in
  pristine)    GEN=/tmp/tmleak-gen-pristine;    TGT=/tmp/tmleak-tgt-pristine ;;
  as-reviewed) GEN=/tmp/tmleak-gen-as-reviewed; TGT=/tmp/tmleak-tgt-as-reviewed ;;
  fixed)       GEN=/tmp/tmleak-gen-fixed;       TGT=/tmp/tmleak-tgt-fixed ;;
  *) echo "bad state: $STATE" >&2; exit 2 ;;
esac
D=$EV/$STATE
rm -rf "$D" "$GEN"
mkdir -p "$D/gen" "$D/measure" "$D/compile"

# --- install this state's compiler sources into the worktree (only rustcompiler/*.hx) ---
SRC=$MW/packages/compiler/reflaxe/rust/rustcompiler
case $STATE in
  pristine) : ;;
  as-reviewed)
    for f in Compiler.hx RustDecl.hx RustExpr.hx RustEmissionState.hx; do
      cp "$FIX/src-postfix/$f" "$SRC/$f"
    done ;;
  fixed)
    for f in RustDecl.hx RustExpr.hx RustEmissionState.hx; do
      cp "$FIX/src-postfix/$f" "$SRC/$f"
    done
    cp "$FIX/src-fixed/Compiler.hx" "$SRC/Compiler.hx" ;;
esac
( cd "$MW" && sha256sum "$SRC/Compiler.hx" "$SRC/RustDecl.hx" "$SRC/RustExpr.hx" "$SRC/RustEmissionState.hx" ) >"$D/src-hashes.txt"
( cd "$MW" && sha256sum tests/haxe/xs-testmod/gen/rust.hxml tests/haxe/xs-testmod/xcheckscope/ProdRethrowTests.hx ) >"$D/fixture-hashes.txt"

# --- stage 1: gen-rust ---
{
  printf 'cwd %s\n' "$MW"
  printf 'env %s\n' "$NIXENV"
  printf 'argv nix develop -c haxe %q %q %q\n' tests/haxe/xs-testmod/gen/rust.hxml -D "rust-output=$GEN"
} >"$D/gen/argv"
( cd "$MW" && env XDG_CACHE_HOME=/tmp/tmleak-nix-cache TMPDIR=/tmp/tmleak-nix-cache nix develop -c haxe tests/haxe/xs-testmod/gen/rust.hxml -D "rust-output=$GEN" ) >"$D/gen/stdout" 2>"$D/gen/stderr"
GS=$?
printf '%s\n' "$GS" >"$D/gen/status"
{ printf 'gen-rust\t%s\n' "$GS"; } >"$D/status.tsv"

# --- snapshot the gen tree + archive the production file ---
( cd "$GEN" && find . -type f -not -path './target/*' -print0 | sort -z | xargs -0 sha256sum ) >"$D/gen-tree.sha256"
VP=$GEN/boring/value_exception.rs
if [ -f "$VP" ]; then
  cp "$VP" "$D/value_exception.rs"
  head -n 100 "$VP" >"$D/value_exception.head"
  {
    printf 'measured-file %s\n' "$VP"
    printf 'cmd1 (cwd %s) sha256sum boring/value_exception.rs\n' "$GEN"
    printf 'cmd2 (cwd %s) grep -c "ValueExceptionFault" boring/value_exception.rs\n' "$GEN"
    printf 'cmd3 (cwd %s) grep -c "ExceptionFault" boring/value_exception.rs\n' "$GEN"
    printf 'cmd4 (cwd %s) grep -n "Fault" boring/value_exception.rs\n' "$GEN"
    printf 'cmd5 (cwd %s) grep -rn "ValueExceptionFault" .  -- whole gen tree (excl target)\n' "$GEN"
  } >"$D/measure/argv"
  ( cd "$GEN" && sha256sum boring/value_exception.rs ) >"$D/measure/stdout" 2>"$D/measure/stderr"
  ( cd "$GEN" && grep -c 'ValueExceptionFault' boring/value_exception.rs ) >"$D/measure/grep-ValueExceptionFault.out" 2>"$D/measure/grep-ValueExceptionFault.err"
  M1=$?
  ( cd "$GEN" && grep -c 'ExceptionFault' boring/value_exception.rs ) >"$D/measure/grep-ExceptionFault.out" 2>"$D/measure/grep-ExceptionFault.err"
  M2=$?
  ( cd "$GEN" && grep -n 'Fault' boring/value_exception.rs ) >"$D/measure/grep-n-Fault.out" 2>"$D/measure/grep-n-Fault.err"
  M3=$?
  {
    printf 'grep -c ValueExceptionFault rc=%s (grep exits 1 when count is 0)\n' "$M1"
    printf 'grep -c ExceptionFault rc=%s\n' "$M2"
    printf 'grep -n Fault rc=%s\n' "$M3"
  } >"$D/measure/rc"
  ( cd "$GEN" && grep -rn 'ValueExceptionFault' --exclude-dir=target . ) >"$D/measure/grep-tree-ValueExceptionFault.out" 2>&1
  MT=$?
  {
    printf 'gen-rust\t%s\n' "$GS"
    printf 'measure\t0\n'
    printf 'compile-rust\t%s\n' "--"
  } >"$D/status.tsv"
else
  printf 'MISSING: production file not generated at %s\n' "$VP" >"$D/measure/argv"
fi

# --- stage 2: compile-rust (same shape as deliverable run-one.sh) ---
mkdir -p "$GEN/src"
if [ -f "$MW/tests/haxe/xs-testmod/native/harness.rs" ]; then
  cp "$MW/tests/haxe/xs-testmod/native/harness.rs" "$GEN/src/main.rs"
else
  printf 'fn main() {}\n' >"$GEN/src/main.rs"
fi
{
  printf 'cwd %s\n' "$MW"
  printf 'env %s CARGO_TARGET_DIR=%s\n' "$NIXENV" "$TGT"
  printf 'argv nix develop -c bash -c "cd %q && timeout 1800 cargo build --offline"\n' "$GEN"
} >"$D/compile/argv"
( cd "$MW" && env XDG_CACHE_HOME=/tmp/tmleak-nix-cache TMPDIR=/tmp/tmleak-nix-cache CARGO_TARGET_DIR="$TGT" nix develop -c bash -c "cd '$GEN' && timeout 1800 cargo build --offline" ) >"$D/compile/stdout" 2>"$D/compile/stderr"
CS=$?
printf '%s\n' "$CS" >"$D/compile/status"
{
  printf 'gen-rust\t%s\n' "$GS"
  printf 'compile-rust\t%s\n' "$CS"
} >"$D/status.tsv"
printf 'state=%s gen=%s compile=%s value_exception=%s\n' "$STATE" "$GS" "$CS" "$([ -f "$D/value_exception.rs" ] && echo present || echo MISSING)" >&2

# --- haxelib dev-link sanity (coordinator caveat): archive .dev/.hxml contents ---
mkdir -p "$D/haxelib"
if [ -d "$MW/.haxelib" ]; then
  ( cd "$MW" && find .haxelib -maxdepth 2 -type f | sort ) >"$D/haxelib/listing" 2>&1 || true
  for lf in "$MW"/.haxelib/*/.dev "$MW"/.haxelib/*/.hxml; do
    [ -f "$lf" ] || continue
    lib=$(basename "$(dirname "$lf")")
    f=$(basename "$lf")
    { printf '=== %s ===\n' "$lib/$f"; sed 's|^|  |' "$lf"; printf '\n'; } >>"$D/haxelib/devlinks"
  done
fi

exit 0
