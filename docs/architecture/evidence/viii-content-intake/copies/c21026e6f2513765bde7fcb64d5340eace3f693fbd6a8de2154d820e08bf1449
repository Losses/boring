package tests

import boring.Fp32
import boring.runtime.test.Test

class Fp32Tests {
@boring.test.Test
    fun halvesToBits() {
        Test.run("tests.Fp32Tests.halvesToBits", "tests.Fp32Tests.halvesToBits: binary64 halves round to binary32 bits with ties to even") {
                Test.equals(1065353218, Fp32.f64HalvesToF32Bits(805306368, 1072693248), "odd significand rounds up at the half")
                Test.equals(1065353216, Fp32.f64HalvesToF32Bits(268435456, 1072693248), "even significand stays at the half")
                Test.equals(8388608, Fp32.f64HalvesToF32Bits(-536870912, 940572671), "rounding past the largest subnormal produces the smallest normal")
        }
    }

@boring.test.Test
    fun bitsRoundTrip() {
        Test.run("tests.Fp32Tests.bitsRoundTrip", "tests.Fp32Tests.bitsRoundTrip: binary32 bits widen exactly and round back") {
                Test.equals(0.5, Fp32.fromBits(1056964608), "0x3F000000 widens to 0.5")
                Test.equals(-0.21875, Fp32.fromBits(-1101004800), "0xBE600000 widens to -0.21875")
                Test.equals(1056964608, Fp32.toBits(0.5), "0.5 rounds to 0x3F000000")
                Test.equals(-1101004800, Fp32.toBits(-0.21875), "-0.21875 rounds to 0xBE600000")
        }
    }
}
