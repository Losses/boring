#![cfg(test)]

use crate::boring::no_such_element_fault_exception::NoSuchElementFault;
use crate::boring::no_such_element_message_reader::NoSuchElementMessageReader;
use crate::boring::no_such_element_thrower::NoSuchElementThrower;
use crate::runtime::test as testlib;
use crate::runtime::test_core;
use crate::runtime::u_string::UStr;
use crate::runtime::u_string::UString;


#[test]
fn caught() {
    testlib::run("tests.NoSuchElementTests.caught", "tests.NoSuchElementTests.caught: a module-listed exception class that only a catch references stays emitted", || {
        let mut text = UString::new();
        let __outcome: Result<u32, NoSuchElementFault> = (|| {
            return Ok(NoSuchElementThrower::no_such_element_thrower_missing()?);
        })();
        match __outcome {
            Ok(_) => {}
            Err(error) => {
                text = UString::from(format!("{}", format!("{}", error)).as_str());
            }
        }
        test_core::TestCore::test_core_equals_string(UStr::new(&[110,111,32,115,117,99,104,32,101,108,101,109,101,110,116]), text.as_ustr(), UStr::new(&[]));
    });
}

#[test]
fn message_read() {
    testlib::run("tests.NoSuchElementTests.messageRead", "tests.NoSuchElementTests.messageRead: a message read off a folded exception value outside a catch lowers to the property", || {
        let err = NoSuchElementFault::Missing;
        test_core::TestCore::test_core_equals_string(UStr::new(&[110,111,32,115,117,99,104,32,101,108,101,109,101,110,116]), NoSuchElementMessageReader::no_such_element_message_reader_describe((err).clone()).as_ustr(), UStr::new(&[]));
    });
}

#[test]
fn folded_variant_message() {
    testlib::run("tests.NoSuchElementTests.foldedVariantMessage", "tests.NoSuchElementTests.foldedVariantMessage: a folded exception reports its variant message text", || {
        test_core::TestCore::test_core_equals_string(UStr::new(&[110,111,32,115,117,99,104,32,101,108,101,109,101,110,116]), (UString::from(format!("{}", format!("{}", NoSuchElementFault::Missing)).as_str())).as_ustr(), UStr::new(&[]));
    });
}
