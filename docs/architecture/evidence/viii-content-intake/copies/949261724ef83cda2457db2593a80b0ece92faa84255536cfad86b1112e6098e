def sha256(p):
    h = hashlib.sha256()
    with open(p, 'rb') as f:
        for b in iter(lambda: f.read(1 << 20), b''):
            h.update(b)
    return h.hexdigest()

def git(*a):
    return subprocess.check_output(['git', '-C', BORING] + list(a)).decode()

def tree_map(rev):
    m = {}
    for line in git('ls-tree', '-r', rev).splitlines():
        meta, path = line.split('\t', 1)
        mode, typ, s1 = meta.split()
        p = path.replace('"', '')
        if p != path:
            p = p.encode().decode('unicode_escape')
        m[p] = (mode, s1)
    return m

def blobs_sha256(pairs):
    """pairs: iterable of (path, sha1) -> {path: sha256 of blob}"""
    pairs = list(pairs)
    pr = subprocess.Popen(['git', '-C', BORING, 'cat-file', '--batch'],
                          stdin=subprocess.PIPE, stdout=subprocess.PIPE)
    res = {}
    for path, s1 in pairs:
        pr.stdin.write((s1 + '\n').encode()); pr.stdin.flush()
        hdr = pr.stdout.readline().decode().split()
        size = int(hdr[2])
        data = pr.stdout.read(size)
        pr.stdout.read(1)
        res[path] = hashlib.sha256(data).hexdigest()
    pr.stdin.close(); pr.wait()
    return res

def walk_files(root):
    files, links, dirs = [], [], []
    for dp, dn, fn in os.walk(root):
        for n in fn:
            p = os.path.join(dp, n)
            (links if os.path.islink(p) else files).append(os.path.relpath(p, root))
        for n in dn:
            p = os.path.join(dp, n)
            if os.path.islink(p): links.append(os.path.relpath(p, root))
            else: dirs.append(os.path.relpath(p, root))
    return files, links, dirs

