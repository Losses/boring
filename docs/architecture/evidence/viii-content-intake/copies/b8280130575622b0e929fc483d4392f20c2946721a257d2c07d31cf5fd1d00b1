#[derive(Clone, PartialEq)]
pub struct ProbeChain {
    pub parent: Option<Box<ProbeChain>>,
    pub tag: u32,
}

impl ProbeChain {
    pub fn new(parent: Option<ProbeChain>, tag: u32) -> Self {
        Self {
            parent: match parent { Some(v) => Some(Box::new(v)), None => None },
            tag,
        }
    }

    pub fn depth(&self) -> u32 {
        let p = (self.parent).as_ref();
        if p.is_none() {
            return 0;
        }
        return u32::wrapping_add(1, p.as_ref().unwrap().depth());
    }
}
