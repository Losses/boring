    private fun scan(tree: String, records: MutableList<InputRecord>): MutableList<Release> {
        val out = mutableListOf<Release>()
        if ((records.size == 0)) {
            Core.fail(tree + ": missing tree")
        }
        val owners = Core.children(records, "")
        for (owner in owners) {
            val op = owner
            if ((Core.record(records, op) != null)) {
                Core.fail(tree + "/" + op + ": stray file")
            }
            val repos = Core.children(records, op)
            for (repo in repos) {
                val rp = op + "/" + repo
                if ((Core.record(records, rp) != null || Core.record(records, rp + "/README.md") == null)) {
                    Core.fail(tree + "/" + rp + ": missing README.md")
                }
                var count = 0
                val versions = Core.children(records, rp)
                for (v in versions) {
                    if ((v == "README.md")) {
                        continue
                    }
                    count = count + 1
                    val vp = rp + "/" + v
                    if ((Core.record(records, vp) != null)) {
                        Core.fail(tree + "/" + vp + ": stray file")
                    }
                    val platforms = Core.children(records, vp)
                    for (p in platforms) {
                        val pp = vp + "/" + p
                        if ((!mutableListOf<String>("npm", "cargo", "pub", "swift", "maven").contains(p))) {
                            Core.fail(tree + "/" + pp + ": unknown platform")
                        }
                        val files = Core.children(records, pp)
                        if ((Core.record(records, pp) != null || files.size != 1 || files[0] != "metadata.json")) {
                            Core.fail(tree + "/" + pp + ": expected metadata.json")
                        }
                        val j = Core.readMetadata(Core.contentOf(records, pp + "/metadata.json"), tree + "/" + pp)
                        val r = Release(owner, repo, v, p, Core.str(j, "name"), Core.opt(j, "license"), Core.contentOf(records, rp + "/README.md"))
                        if ((Core.str(j, "version") != v)) {
                            Core.fail(tree + "/" + pp + ": version disagreement")
                        }
                        if ((Semver.parse(v) == null)) {
                            Core.fail(tree + "/" + pp + ": invalid version")
                        }
                        if ((p == "npm")) {
                            r.url = Core.str(j, "url")
                            r.digest = Core.str(j, "sha512")
                        } else {
                            if ((p == "cargo" || p == "pub")) {
                                r.url = Core.str(j, "url")
                                r.digest = Core.str(j, "sha256")
                                if ((p == "pub")) {
                                    r.pubspec = Core.get(j, "pubspec")
                                }
                            } else {
                                if ((p == "swift")) {
                                    r.archive = Core.str(j, "archive")
                                    r.digest = Core.str(j, "sha256")
                                    r.packageSwift = Core.str(j, "packageSwift")
                                } else {
                                    r.groupId = Core.str(j, "groupId")
                                    Core.readArtifacts(Core.get(j, "artifacts"), r, tree + "/" + pp)
                                }
                            }
                        }
                        val ru2 = r.url
                        if ((ru2 != null && !Core.urlOk(ru2))) {
                            Core.fail(tree + "/" + pp + ": invalid URL")
                        }
                        out.add(r)
                    }
                }
                if ((count == 0)) {
                    Core.fail(tree + "/" + rp + ": repository has no versions")
                }
            }
        }
        return out
    }

