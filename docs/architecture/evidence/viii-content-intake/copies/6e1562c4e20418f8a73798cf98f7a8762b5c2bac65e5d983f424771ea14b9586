        var o: String? = null
        var b: String? = null
        var s: String? = null
        var ar: String? = null
        var i = 0
        while ((i < argv.size)) {
            if ((i + 1 >= argv.size)) {
                Core.configFail(Core.USAGE)
            }
            val flag = argv[i]
            val value = argv[i + 1]
            if ((value == "")) {
                Core.configFail("empty value for " + flag)
            }
            if ((flag == "--tree")) {
                t = value
            } else {
                if ((flag == "--output")) {
                    o = value
                } else {
                    if ((flag == "--base-url")) {
                        b = value
                    } else {
                        if ((flag == "--swift-scope")) {
                            s = value
                        } else {
                            if ((flag == "--archive-base")) {
                                ar = value
                            } else {
                                if ((flag == "--help" || flag == "-h")) {
                                    Core.configFail(Core.USAGE)
                                } else {
                                    Core.configFail("unknown flag " + flag)
                                }
                            }
                        }
                    }
                }
            }
            i += 2
        }
        if ((t == null || o == null || b == null)) {
            Core.configFail("required flags missing\n" + Core.USAGE)
        }
        val treeStr = (if ((t == null)) "" else t)
        val outputStr = (if ((o == null)) "" else o)
        val baseUrlStr = (if ((b == null)) "" else b)
        if ((!Core.urlOk(baseUrlStr))) {
            Core.configFail("invalid base URL (http or https required)")
        }
        val swiftStr = (if ((s == null)) "" else s)
        val archiveStr = (if ((ar == null)) "" else ar)
        if ((ar != null && !Core.urlOk(archiveStr))) {
            Core.configFail("invalid archive-base URL (http or https required)")
        }
        val config = RegistryConfig(tree = treeStr, output = outputStr, baseUrl = baseUrlStr, swiftScope = swiftStr, archiveBase = archiveStr, configRecord = 1)
        return config
    }

    fun generate(records: MutableList<InputRecord>, config: RegistryConfig): MutableList<OutputFile> {
        Core.files = mutableListOf<OutputFile>()
        val all = Core.scan(config.tree, records)
        if ((Core.names(all, "swift").size > 0 && config.swiftScope == "")) {
            Core.fail("Swift requires --swift-scope")
        }
        if ((Core.names(all, "swift").size > 0 && config.archiveBase == "")) {
            Core.fail("Swift requires --archive-base")
        }
        Core.validate(all, config.swiftScope)
        Core.writeNpm(config.output, all)
        Core.writePub(config.output, all)
        Core.writeCargo(config.output, config.baseUrl, all)
        if ((Core.names(all, "swift").size > 0)) {
            Core.writeSwift(config.output, config.swiftScope, all)
        }
        Core.writeMaven(config.output, all)
        Core.emit(config.output, "swift/identifiers", Json.write(Core.A(mutableListOf<JsonValue>())))
        Core.emit(config.output, "_headers", Core.headers())
        Core.emit(config.output, "_redirects", Core.redirects(config.swiftScope, config.archiveBase, all))
        return Core.files
    }
}

data class InputRecord(
    var path: String,
    var content: String,
    var inputRecord: Int
)

fun compare(a: InputRecord, b: InputRecord): Int {
    if (a === b) return 0
    var cmp = 0
    cmp = a.path.compareTo(b.path)
    if (cmp != 0) return cmp
    cmp = a.content.compareTo(b.content)
    if (cmp != 0) return cmp
    cmp = a.inputRecord.compareTo(b.inputRecord)
    if (cmp != 0) return cmp
    return 0
}

data class OutputFile(
    var path: String,
    var content: String,
    var outputFile: Int
)

fun compare(a: OutputFile, b: OutputFile): Int {
    if (a === b) return 0
    var cmp = 0
    cmp = a.path.compareTo(b.path)
    if (cmp != 0) return cmp
    cmp = a.content.compareTo(b.content)
    if (cmp != 0) return cmp
    cmp = a.outputFile.compareTo(b.outputFile)
    if (cmp != 0) return cmp
    return 0
}

data class RegistryConfig(
    var tree: String,
    var output: String,
    var baseUrl: String,
    var swiftScope: String,
    var archiveBase: String,
    var configRecord: Int
)

fun compare(a: RegistryConfig, b: RegistryConfig): Int {
    if (a === b) return 0
    var cmp = 0
    cmp = a.tree.compareTo(b.tree)
    if (cmp != 0) return cmp
    cmp = a.output.compareTo(b.output)
    if (cmp != 0) return cmp
    cmp = a.baseUrl.compareTo(b.baseUrl)
    if (cmp != 0) return cmp
    cmp = a.swiftScope.compareTo(b.swiftScope)
    if (cmp != 0) return cmp
    cmp = a.archiveBase.compareTo(b.archiveBase)
    if (cmp != 0) return cmp
    cmp = a.configRecord.compareTo(b.configRecord)
    if (cmp != 0) return cmp
    return 0
}
