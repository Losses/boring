package mx;
import std.ReadOnlyArray;
import mx.MXSupport.QSource;
// Restore probe: after a lambda whose contract is ReadOnlyArray<Int>, the
// ENCLOSING member's own return sites must still use the MEMBER's contract
// (Array<Int>). If functionLiteral failed to restore currentReturnType, the
// trailing return of an Array value would be wrapped as ReadOnlyArray(...)
// inside a function declared to return TiqianArray<Int32>.
class AttK {
	public static function run(flag:Bool):Array<Int> {
		var f = function():ReadOnlyArray<Int> {
			if (flag) throw new mx.MXSupport.QError();
			return QSource.first();
		}
		f();
		return QSource.first();
	}
}
