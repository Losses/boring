package tests

import boring.PlainClassRecord
import boring.PlainPoint
import boring.runtime.test.Test

class StdStringPlainClassTests {
@boring.test.Test
    fun plainClassAndRecord() {
        Test.run("tests.StdStringPlainClassTests.plainClassAndRecord", "tests.StdStringPlainClassTests.plainClassAndRecord: Std.string accepts ordinary classes with toString") {
                val point = PlainPoint(2, 3)
                val plainText = point.toString()
                val record = PlainClassRecord(point, mutableListOf<PlainPoint>(PlainPoint(4, 5), PlainPoint(6, 7)))
                Test.equals("Point(2,3)", plainText, null)
                Test.equals("PlainClassRecord(point=Point(2,3), points=[Point(4,5), Point(6,7)])", record.toString(), null)
                Test.equals("plain=Point(2,3); record=PlainClassRecord(point=Point(2,3), points=[Point(4,5), Point(6,7)])", "plain=" + plainText + "; record=" + record.toString(), null)
        }
    }
}
