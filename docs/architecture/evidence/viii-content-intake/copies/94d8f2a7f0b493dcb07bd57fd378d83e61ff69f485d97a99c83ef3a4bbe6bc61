#![cfg(test)]

use crate::boring::haxe_exception_ops::HaxeExceptionFault;
use crate::boring::haxe_exception_ops::HaxeExceptionOps;
use crate::runtime::test as testlib;
use crate::runtime::test_core;
use crate::runtime::u_string::UStr;
use crate::runtime::u_string::UString;


#[test]
fn thrown_message() {
    testlib::run("tests.HaxeExceptionTests.thrownMessage", "tests.HaxeExceptionTests.thrownMessage: haxe.Exception subclasses preserve message values when thrown and caught", || {
        let message = UString::from("haxe exception message").to_ustring();
        let mut caught = UString::new();
        let __outcome: Result<(), HaxeExceptionFault> = (|| {
            let _ = HaxeExceptionOps::haxe_exception_ops_throw_fault(message.as_ustr())?;
            Ok(())
        })();
        match __outcome {
            Ok(_) => {}
            Err(error) => {
                caught = UString::from(format!("{}", format!("{}", error)).as_str());
            }
        }
        test_core::TestCore::test_core_equals_string(message.as_ustr(), caught.as_ustr(), UStr::new(&[]));
    });
}

#[test]
fn joined_message() {
    testlib::run("tests.HaxeExceptionTests.joinedMessage", "tests.HaxeExceptionTests.joinedMessage: a concatenated exception message crosses the constructor as a str view", || {
        let mut caught = UString::new();
        let __outcome1: Result<(), HaxeExceptionFault> = (|| {
            let _ = HaxeExceptionOps::haxe_exception_ops_throw_joined(UStr::new(&[97,98]), UStr::new(&[99,100]))?;
            Ok(())
        })();
        match __outcome1 {
            Ok(_) => {}
            Err(error) => {
                caught = UString::from(format!("{}", format!("{}", error)).as_str());
            }
        }
        test_core::TestCore::test_core_equals_string(UStr::new(&[97,98,99,100]), caught.as_ustr(), UStr::new(&[]));
    });
}

#[test]
fn mixed_message() {
    testlib::run("tests.HaxeExceptionTests.mixedMessage", "tests.HaxeExceptionTests.mixedMessage: a direct message-only throw joins the callee fault union", || {
        let mut caught = UString::new();
        let __outcome2: Result<(), HaxeExceptionFault> = (|| {
            let _ = HaxeExceptionOps::haxe_exception_ops_throw_mixed(UStr::new(&[])).map_err(|e| HaxeExceptionFault::new(&format!("{}", e)))?;
            Ok(())
        })();
        match __outcome2 {
            Ok(_) => {}
            Err(error) => {
                caught = UString::from(format!("{}", format!("{}", error)).as_str());
            }
        }
        test_core::TestCore::test_core_equals_string(UStr::new(&[100,105,114,101,99,116]), caught.as_ustr(), UStr::new(&[]));
    });
}
