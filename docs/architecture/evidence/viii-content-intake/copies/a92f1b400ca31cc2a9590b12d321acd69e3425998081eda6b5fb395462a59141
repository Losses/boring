+#!/usr/bin/env bash
+# Observation-only TS and Swift legs for the place fixtures.
+#
+# Companion to run.sh: same authored module (place/PlaceObserveStatic.hx),
+# same case defines, one fresh run directory per invocation, one directory
+# per case. Stages: generation (haxe -> reflaxe ts/swift), compile
+# (tsc / swiftc), run (node / compiled binary). Every stage records
+# shell-quoted argv, cwd, raw stdout/stderr, exit status, and sha256 of its
+# inputs and outputs. A stage runs only when its producer exited zero in
+# the same attempt; every downstream stage of a failed producer receives
+# an explicit not-reached row naming that producer. No authored fixture,
+# compiler, or specification file is edited, and no write-back ruling is
+# asserted: the recorded numbers are observations on the pinned tools.
+#
+# The Swift toolchain in this flake is a bwrap-wrapped FHS env. On hosts
+# where bwrap cannot set up its uid map the swiftc stage fails with that
+# raw diagnostic; the leg is then recorded as environment-not-reached and
+# the runtime stays not-reached. No Swift number is fabricated.
+set -u
+
+HERE="$(cd "$(dirname "$0")" && pwd)"
+ROOT="$(cd "$HERE/../../.." && pwd)"
+cd "$ROOT" || exit 1
+if [ "${IN_NIX_SHELL:-}" = "" ]; then
+	printf 'run this runner through: nix develop -c bash tests/haxe/place/run-ts-swift.sh\n'
+	exit 1
+fi
+# shellcheck disable=SC1091
+. "$HERE/../../support/stage-check.sh"
+EVIDENCE=out/place
+ALLOC_PARENT="$EVIDENCE/runs"
+mkdir -p "$ALLOC_PARENT" || exit 1
+if ! RUN="$(mktemp -d "$ALLOC_PARENT/place-ts-swift-XXXXXX")"; then
+	printf 'run directory allocation failed\n'
+	exit 1
+fi
+
+# The pinned shell carries node but no tsc; the compiler rides in from the
+# recorded host path. Its digest is captured in identity.txt so a runtime
+# result traces to the exact compiler input.
+TSC_JS="${TSC_JS:-/home/losses/Development/tq-workspace/tiqian-pin-advance/node_modules/typescript/bin/tsc}"
+
+STATUS="$RUN/status.tsv"
+TAB="$(printf '\t')"
+printf 'stage%sexpected%sobserved%sproducer\n' "$TAB" "$TAB" "$TAB" >"$STATUS"
+DIAGNOSTICS="$RUN/diagnostics.txt"
+printf 'stage%sexpected-diagnostic%sfound\n' "$TAB" "$TAB" >"$DIAGNOSTICS"
+EXPECTED_FILE="$RUN/expected-stages.txt"
+: >"$EXPECTED_FILE"
+VERDICT=recorded
+ANY_UNREACHED=0
+IDENTITY_FAILURES=0
+
+expect_stage() {
+	printf '%s\n' "$1" >>"$EXPECTED_FILE"
+}
+
+log() {
+	printf '%s\n' "$1"
+}
+
+record() {
+	printf '%s%s%s%s%s%s%s\n' "$1" "$TAB" "$2" "$TAB" "$3" "$TAB" "$4" >>"$STATUS"
+	log "$1 expected=$2 observed=$3 producer=$4"
+}
+
+attempt() {
+	local stage=$1 expected=$2
+	shift 2
+	{
+		printf 'interpreter bash inside the invoking nix develop environment\n'
+		printf 'cwd %s\n' "$ROOT"
+		printf 'argv'
+		printf ' %q' "$@"
+		printf '\n'
+	} >"$RUN/$stage.argv"
+	"$@" >"$RUN/$stage.stdout" 2>"$RUN/$stage.stderr"
+	local observed=$?
+	record "$stage" "$expected" "$observed" "$stage"
+	return "$observed"
+}
+
+mark_unreached() {
+	local producer=$1 observed=$2
+	shift 2
+	local stage
+	for stage in "$@"; do
+		record "$stage" not-reached "producer-$producer-status-$observed" "$producer"
+	done
+}
+
+expect_diagnostic() {
+	local stage=$1 fragment=$2
+	if grep -qF -- "$fragment" "$RUN/$stage.stderr"; then
+		printf '%s%s%s%syes\n' "$stage" "$TAB" "$fragment" "$TAB" >>"$DIAGNOSTICS"
+		return 0
+	fi
+	printf '%s%s%s%sNO\n' "$stage" "$TAB" "$fragment" "$TAB" >>"$DIAGNOSTICS"
+	VERDICT=harness-defect
+	log "$stage did not report the expected diagnostic: $fragment"
+	return 1
+}
+
+hash_file() {
+	local stage=$1 role=$2 path=$3
+	local line
+	if ! line="$(sha256sum "$path" 2>&1)"; then
+		printf 'hash failed stage=%s role=%s path=%s detail=%s\n' "$stage" "$role" "$path" "$line" \
+			>>"$RUN/hash-failures.txt"
+		VERDICT=harness-defect
+		log "hash failed for $stage $role $path"
+		return 1
+	fi
+	printf '%s %s %s\n' "$stage" "$role" "$line" >>"$RUN/hashes.txt"
+	return 0
+}
+
+identity_step() {
+	local label=$1
+	shift
+	printf '%s\n' "$label" >>"$RUN/identity.txt"
+	if ! "$@" >>"$RUN/identity.txt" 2>&1; then
+		printf 'identity step failed: %s\n' "$label" >>"$RUN/identity-failures.txt"
+		IDENTITY_FAILURES=$((IDENTITY_FAILURES + 1))
+		return 1
+	fi
+	return 0
+}
+
+identity() {
+	identity_step utc date -u +%Y-%m-%dT%H:%M:%SZ
+	printf 'worktree %s\n' "$ROOT" >>"$RUN/identity.txt"
+	identity_step base git rev-parse HEAD
+	identity_step changed git status --porcelain
+	identity_step haxe-version haxe --version
+	identity_step node-version node --version
+	identity_step tsc-version node "$TSC_JS" --version
+	identity_step tsc-digest sha256sum "$TSC_JS"
+	# The flake-wrapped swiftc is probed, not assumed: its raw stderr stays
+	# in the run directory whatever the answer is.
+	identity_step swiftc-version swiftc --version
+	identity_step authored-source-hashes sha256sum tests/support/stage-check.sh \
+		tests/haxe/place/*.hxml \
+		tests/haxe/place/*.sh tests/haxe/place/native/*.rs \
+		tests/haxe/place/native/*.ts \
+		tests/haxe/place/place/*.hx tests/haxe/place/place/rejected/*.hx
+	if [ "$IDENTITY_FAILURES" != "0" ]; then
+		{
+			printf 'verdict recorded-with-identity-losses\n'
+			printf 'identity failures %s\n' "$IDENTITY_FAILURES"
+			cat "$RUN/identity-failures.txt"
+			cat "$RUN/identity.txt"
+		} >"$RUN/summary.txt"
+		log "identity capture recorded failures; see $RUN/identity-failures.txt"
+	fi
+}
+
+# paired_case <define|none> <label>
+paired_case() {
+	local define=$1 label=$2
+	local dir="$RUN/case-$label"
+	mkdir -p "$dir" || {
+		VERDICT=harness-defect
+		return 1
+	}
+	local tsgen="ts-gen-$label"
+	local tsc="tsc-$label"
+	local tsrun="ts-run-$label"
+	local swgen="swift-gen-$label"
+	local swc="swiftc-$label"
+	local swrun="swift-run-$label"
+	local defines=()
+	[ "$define" != "none" ] && defines=(-D placeSplit -D "place$define")
+
+	local st=0
+	# --- TypeScript leg -------------------------------------------------
+	attempt "$tsgen" data haxe tests/haxe/place/ts-gen.hxml \
+		"${defines[@]+"${defines[@]}"}" -D "ts-output=$dir/ts-gen"
+	st=$?
+	if [ "$st" != "0" ]; then
+		mark_unreached "$tsgen" "$st" "$tsc" "$tsrun" "$swgen" "$swc" "$swrun"
+		return 1
+	fi
+	hash_file "$tsgen" input tests/haxe/place/place/PlaceObserveStatic.hx
+	hash_file "$tsgen" output "$dir/ts-gen/place/PlaceObserveStatic.ts"
+	# Stage the harness driver next to the generated tree; its digest is
+	# recorded so the runtime traces to this exact driver.
+	cp tests/haxe/place/native/ts-main.ts "$dir/ts-gen/ts-main.ts"
+	hash_file "$tsgen" harness "$dir/ts-gen/ts-main.ts"
+
+	attempt "$tsc" data node "$TSC_JS" --strict --noFallthroughCasesInSwitch \
+		--target es2022 --module nodenext --moduleResolution nodenext \
+		--rewriteRelativeImportExtensions --outDir "$dir/ts-out" \
+		"$dir/ts-gen/place/PlaceObserveStatic.ts" "$dir/ts-gen/ts-main.ts"
+	st=$?
+	if [ "$st" != "0" ]; then
+		mark_unreached "$tsc" "$st" "$tsrun" "$swgen" "$swc" "$swrun"
+		return 1
+	fi
+	hash_file "$tsc" input "$dir/ts-gen/place/PlaceObserveStatic.ts"
+	hash_file "$tsc" output "$dir/ts-out/ts-main.js"
+	# The generated package.json carries "type": "module"; the compiled
+	# tree needs it so node executes the emitted .js as ESM.
+	cp "$dir/ts-gen/package.json" "$dir/ts-out/package.json"
+	hash_file "$tsc" package-json "$dir/ts-out/package.json"
+
+	attempt "$tsrun" data node "$dir/ts-out/ts-main.js"
+	st=$?
+	hash_file "$tsrun" input "$dir/ts-out/ts-main.js"
+	if [ "$st" != "0" ]; then
+		mark_unreached "$tsrun" "$st" "$swgen" "$swc" "$swrun"
+		return 1
+	fi
+
+	# --- Swift leg ------------------------------------------------------
+	attempt "$swgen" data haxe tests/haxe/place/swift-gen.hxml \
+		"${defines[@]+"${defines[@]}"}" -D "swift-output=$dir/swift-gen"
+	st=$?
+	if [ "$st" != "0" ]; then
+		mark_unreached "$swgen" "$st" "$swc" "$swrun"
+		return 1
+	fi
+	hash_file "$swgen" input tests/haxe/place/place/PlaceObserveStatic.hx
+	hash_file "$swgen" output "$dir/swift-gen/place/PlaceObserveStatic.swift"
+
+	attempt "$swc" env-denied swiftc "$dir/swift-gen/place/PlaceObserveStatic.swift" \
+		-o "$dir/place-observe"
+	st=$?
+	if [ "$st" != "0" ]; then
+		# The raw stderr names the blocker; when it is the bwrap denial the
+		# leg is recorded as environment-not-reached and nothing past it
+		# is claimed.
+		if grep -qF 'bwrap: setting up uid map: Permission denied' "$RUN/$swc.stderr"; then
+			record "env-not-reached-$label" environment-not-reached bwrap-denied "$swc"
+			mark_unreached "$swc" "$st" "$swrun"
+		else
+			mark_unreached "$swc" "$st" "$swrun"
+		fi
+		return 1
+	fi
+	hash_file "$swc" input "$dir/swift-gen/place/PlaceObserveStatic.swift"
+	hash_file "$swc" output "$dir/place-observe"
+
+	attempt "$swrun" data "$dir/place-observe"
+	hash_file "$swrun" input "$dir/place-observe"
+	return 0
+}
+
+identity
+
+case_stages() {
+	local label=$1
+	expect_stage "ts-gen-$label"
+	expect_stage "tsc-$label"
+	expect_stage "ts-run-$label"
+	expect_stage "swift-gen-$label"
+	expect_stage "swiftc-$label"
+	expect_stage "env-not-reached-$label"
+	expect_stage "swift-run-$label"
+}
+case_stages all
+for case in R1 R2 R3 R5 R5rec R6; do
+	case_stages "$case"
+done
+
+for case in R1 R2 R3 R5 R5rec R6 all; do
+	paired_case "$case" "$case" || true
+done
+
+FINDINGS="$RUN/findings.txt"
+MEMBERSHIP="$RUN/membership-findings.txt"
+
+stage_check "$STATUS" "$EXPECTED_FILE" "$MEMBERSHIP" || VERDICT=harness-defect
+cp "$MEMBERSHIP" "$FINDINGS"
+
+while IFS="$TAB" read -r stage expected observed producer; do
+	[ "$stage" = "stage" ] && continue
+	[ -z "$stage" ] && continue
+	case "$expected" in
+	zero)
+		if [ "$observed" != "0" ]; then
+			printf 'unexpected failure %s (%s)\n' "$stage" "$observed" >>"$FINDINGS"
+			VERDICT=harness-defect
+		fi
+		;;
+	not-reached)
+		ANY_UNREACHED=1
+		printf 'stage %s not reached through %s (%s)\n' "$stage" "$producer" "$observed" >>"$FINDINGS"
+		;;
+	esac
+done <"$STATUS"
+
+for failure in "$RUN/identity-failures.txt" "$RUN/hash-failures.txt"; do
+	if [ -f "$failure" ]; then
+		while IFS= read -r line; do
+			printf '%s\n' "$line" >>"$FINDINGS"
+		done <"$failure"
+	fi
+done
+
+FINAL_VERDICT="$VERDICT"
+QUALIFIER=""
+if [ "$ANY_UNREACHED" != "0" ] && [ "$FINAL_VERDICT" = "recorded" ]; then
+	QUALIFIER="recorded-with-not-reached-stages"
+fi
+
+{
+	printf 'run directory %s\n' "$RUN"
+	printf 'verdict %s\n' "$FINAL_VERDICT"
+	[ -z "$QUALIFIER" ] || printf 'verdict qualifier %s\n' "$QUALIFIER"
+	printf 'stages declared %s recorded %s\n' "$(wc -l <"$EXPECTED_FILE")" "$(( $(wc -l <"$STATUS") - 1 ))"
+	printf 'findings\n'
+	cat "$FINDINGS"
+	printf 'status rows\n'
+	cat "$STATUS"
+	printf 'diagnostic checks\n'
+	cat "$DIAGNOSTICS"
+} >"$RUN/summary.txt"
+
+cat "$FINDINGS"
+log "run directory $RUN"
+log "verdict $FINAL_VERDICT"
+[ -z "$QUALIFIER" ] || log "verdict qualifier $QUALIFIER"
+exit 0
