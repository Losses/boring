use crate::runtime::u_string::UStr;
use crate::runtime::u_string::UString;
use crate::std::render_shape::RenderShape;


#[derive(Clone, Copy)]
pub struct RenderShapeTextOps;

impl RenderShapeTextOps {
    pub fn render_shape_text_ops_print(shape: Box<dyn RenderShape>, text: &UStr) -> UString {
        return shape.render(text);
    }
}
