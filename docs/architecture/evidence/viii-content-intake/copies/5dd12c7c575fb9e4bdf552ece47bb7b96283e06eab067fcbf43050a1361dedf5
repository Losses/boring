enum GapChoice { case one, two }
final class ReadOnlyArray<Element> {
    var backing: [Element]
    init(_ backing: [Element]) { self.backing = backing }
}
final class TiqianArray<Element> {
    var items: [Element]
    init(_ items: [Element]) { self.items = items }
}
enum GapExplicitReturn {
    static func sourceFirst() -> TiqianArray<Int32> { TiqianArray([1, 2]) }
    static func sourceSecond() -> TiqianArray<Int32> { TiqianArray([3]) }
    // W1 fixed shape: all arms return; trailing return after exhaustive switch
    static func switchExplicitReturn(_ choice: GapChoice) -> ReadOnlyArray<Int32> {
        switch choice {
            case .one:
                return ReadOnlyArray(sourceFirst().items)
            case .two:
                return ReadOnlyArray(sourceSecond().items)
        }
        return ReadOnlyArray(sourceFirst().items)
    }
    // control: all arms return, NO trailing return
    static func switchStatementOnly(_ choice: GapChoice) -> ReadOnlyArray<Int32> {
        switch choice {
            case .one:
                return ReadOnlyArray(sourceFirst().items)
            case .two:
                return ReadOnlyArray(sourceSecond().items)
        }
    }
    // control: mixed arms (one returns, one is a plain statement) + trailing return
    static func mixed(_ choice: GapChoice) -> ReadOnlyArray<Int32> {
        switch choice {
            case .one:
                return ReadOnlyArray(sourceFirst().items)
            case .two:
                ()
        }
        return ReadOnlyArray(sourceFirst().items)
    }
}
