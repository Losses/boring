#![cfg(test)]

use crate::boring::instance_defaults::InstanceDefaults;
use crate::runtime::test as testlib;
use crate::runtime::test_core;
use crate::runtime::u_string::UStr;


#[test]
fn defaults() {
    testlib::run("tests.InstanceDefaultsTests.defaults", "tests.InstanceDefaultsTests.defaults: instance field defaults initialize every field", || {
        let d = InstanceDefaults::new();
        test_core::TestCore::test_core_equals_int(0i32, i32::from_ne_bytes(((d.count) as i32).to_ne_bytes()), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[110,111,110,101]), (d.label).to_ustring().as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_float(1.0f64, d.ratio, UStr::new(&[]));
        test_core::TestCore::test_core_equals_bool(false, d.ready, UStr::new(&[]));
        test_core::TestCore::test_core_equals_int(3i32, i32::from_ne_bytes(((d.tool.level) as i32).to_ne_bytes()), UStr::new(&[]));
        test_core::TestCore::test_core_equals_int(7i32, i32::from_ne_bytes(((d.plain) as i32).to_ne_bytes()), UStr::new(&[]));
    });
}

#[test]
fn per_instance() {
    testlib::run("tests.InstanceDefaultsTests.perInstance", "tests.InstanceDefaultsTests.perInstance: instance field defaults evaluate per instance", || {
        let mut a = InstanceDefaults::new();
        let b = InstanceDefaults::new();
        a.tool.level = 9u32;
        test_core::TestCore::test_core_equals_int(3i32, i32::from_ne_bytes(((b.tool.level) as i32).to_ne_bytes()), UStr::new(&[]));
    });
}
