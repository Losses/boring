#!/usr/bin/env python3
"""xc2-fuzz.py -- differential fuzz: OLD vs NEW checker vs an independent
oracle, over randomly mangled copies of one sealed harness.log.

Oracle (implemented from the stated property, NOT from the script source):
  P1 "nothing follows the end marker" : total bytes == offset just past the
     LAST line that starts with the marker text (including its LF if present)
  P2 "its sha256 covers every byte before it" : recorded value == sha256 of
     the bytes before that marker line
  expected rc = 0 iff P1 and P2 (the stage tree is never touched).
"""
import hashlib, os, random, shutil, subprocess, sys

R = "/home/losses/Development/tq-workspace"
SRC = f"{R}/boring-wt-architecture/out/integration-a3-evidence/exclusive-runner"
NEW = f"{SRC}/check-log-integrity.sh"
OLD = f"{R}/dc-warn/out/integrity-bytefix/backup/check-log-integrity.sh.orig"
BASE = "attempt-20260929T180809-2918225"
W = f"{R}/dc-warn/scratch-xcheck2/fuzz"
MK = b"harness end marker sha256="

shutil.rmtree(W, ignore_errors=True)
shutil.copytree(f"{SRC}/{BASE}", f"{W}/att", symlinks=True)
os.system(f"chmod -R u+rwX {W}/att")
LOG = f"{W}/att/harness.log"
PRISTINE = open(LOG, "rb").read()


def oracle(data: bytes):
    offs = [i for i in range(len(data)) if data.startswith(MK, i)
            and (i == 0 or data[i-1:i] == b"\n")]
    if not offs:
        return None, "no marker line"
    o = offs[-1]
    nl = data.find(b"\n", o)
    end = (nl + 1) if nl != -1 else len(data)
    p1 = (len(data) == end)
    body = data[o+len(MK): nl if nl != -1 else len(data)]
    recorded = body.decode("latin1")
    p2 = (recorded == hashlib.sha256(data[:o]).hexdigest())
    return (p1 and p2), f"P1={p1} P2={p2} off={o} end={end} total={len(data)}"


def run(checker, d):
    p = subprocess.run(["bash", checker, d], capture_output=True, text=True)
    return p.returncode, (p.stdout + p.stderr).strip().splitlines()[:1]


def mutate(data: bytes, rng: random.Random) -> bytes:
    d = bytearray(data)
    for _ in range(rng.randint(1, 3)):
        op = rng.choice(["append", "append_nl", "truncate", "flip", "insert_marker",
                         "dup_marker", "insert_mk_partial", "append_forged_marker",
                         "reseal", "chomp_lf", "nothing"])
        if op == "append":
            d += bytes(rng.randrange(256) for _ in range(rng.randint(1, 300)))
        elif op == "append_nl":
            d += bytes(rng.randrange(256) for _ in range(rng.randint(1, 100))) + b"\n"
        elif op == "truncate":
            if len(d) > 1:
                del d[rng.randrange(len(d)):]
        elif op == "flip":
            if d:
                d[rng.randrange(len(d))] ^= 1 << rng.randrange(8)
        elif op == "insert_marker":
            o = rng.randrange(len(d) + 1)
            d[o:o] = MK + b"a"*64 + b"\n"
        elif op == "dup_marker":
            offs = [i for i in range(len(d)) if d.startswith(MK, i)]
            if offs:
                o = rng.choice(offs); nl = d.find(b"\n", o)
                end = nl+1 if nl != -1 else len(d)
                d[len(d):] = d[o:end]
        elif op == "insert_mk_partial":
            o = rng.randrange(len(d) + 1)
            d[o:o] = MK[:rng.randint(1, len(MK))]
        elif op == "append_forged_marker":
            d += MK + bytes(rng.choice(b"0123456789abcdef") for _ in range(64)) + b"\n"
        elif op == "reseal":
            pre = bytes(d)
            d += b"PAYLOAD\n" + MK + hashlib.sha256(pre + b"PAYLOAD\n").hexdigest().encode() + b"\n"
        elif op == "chomp_lf":
            while d and d[-1:] == b"\n":
                d = d[:-1]; break
        return bytes(d) if op == "nothing" else bytes(d)
    return bytes(d)


def main():
    n = int(sys.argv[1]) if len(sys.argv) > 1 else 400
    rng = random.Random(20260929)
    bad_model = 0; loosen = 0; fixclass = 0; rows = []
    for i in range(n):
        data = mutate(PRISTINE, rng)
        with open(LOG, "wb") as f:
            f.write(data)
        exp, why = oracle(data)
        orc, omsg = run(OLD, f"{W}/att")
        nrc, nmsg = run(NEW, f"{W}/att")
        model_rc = 0 if exp else 1
        tag = []
        if exp is None:
            tag.append("nomarker")
        if nrc != model_rc:
            bad_model += 1; tag.append("MODEL-MISMATCH")
        if orc != 0 and nrc == 0:
            loosen += 1; tag.append("LOOSENED")
        if orc == 0 and nrc != 0:
            fixclass += 1; tag.append("FIX-CLASS")
        if tag:
            rows.append((i, len(data), orc, nrc, model_rc, ",".join(tag), why,
                         (nmsg[0] if nmsg else "")[:70]))
    with open(os.path.join(os.path.dirname(NEW), "..", "..", "..", "..", "dc-warn",
              "out", "bytefix-xcheck2", "evidence", "xc2-fuzz-findings.txt"), "w") as f:
        f.write(f"iterations           : {n}\n")
        f.write(f"model mismatches     : {bad_model}\n")
        f.write(f"old!=0 & new==0 LOOSENED : {loosen}\n")
        f.write(f"old==0 & new!=0 FIX-CLASS: {fixclass}\n")
        f.write("\niter bytes old new model tags why msg\n")
        for r in rows[:200]:
            f.write(f"{r[0]} {r[1]} {r[2]} {r[3]} {r[4]} {r[5]} {r[6]} {r[7]}\n")
    print(f"iterations={n} model_mismatch={bad_model} loosened={loosen} fixclass={fixclass}")
    for r in rows[:15]:
        print(" ", r)


main()
