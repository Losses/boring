package boring

class ArrayRootStateOps {

    companion object {
        val readOnlyInts: List<Int> = listOf(10, 20, 30)

        val mutableInts: MutableList<Int> = mutableListOf<Int>(40, 50)

        val words: MutableList<String> = mutableListOf<String>("alpha", "beta")

        const val marker: Int = 7

        val mixed: MutableList<ArrayRootKind> = mutableListOf<ArrayRootKind>(ArrayRootKind.Weighted(ArrayRootStateOps.marker), ArrayRootKind.Plain)

        val nested: MutableList<MutableList<Int>> = mutableListOf<MutableList<Int>>(mutableListOf<Int>(1, 2), mutableListOf<Int>(3, 4))

        fun readOnlyLength(): Int {
            return ArrayRootStateOps.readOnlyInts.size
        }

        fun readOnlyElement(index: Int): Int {
            return ArrayRootStateOps.readOnlyInts[index]
        }

        fun mutableLength(): Int {
            return ArrayRootStateOps.mutableInts.size
        }

        fun mutableElement(index: Int): Int {
            return ArrayRootStateOps.mutableInts[index]
        }

        fun wordsLength(): Int {
            return ArrayRootStateOps.words.size
        }

        fun word(index: Int): String {
            return ArrayRootStateOps.words[index]
        }

        fun mixedLength(): Int {
            return ArrayRootStateOps.mixed.size
        }

        fun mixedIsWeighted(): Boolean {
            val kind = ArrayRootStateOps.mixed[0]
            return when (kind) {
                is ArrayRootKind.Plain -> false
                is ArrayRootKind.Weighted -> true
            }
        }

        fun mixedWeight(): Int {
            val kind = ArrayRootStateOps.mixed[0]
            return when (kind) {
                is ArrayRootKind.Plain -> 0
                is ArrayRootKind.Weighted -> kind.value
            }
        }

        fun nestedLength(): Int {
            return ArrayRootStateOps.nested.size
        }

        fun nestedInnerLength(index: Int): Int {
            return ArrayRootStateOps.nested[index].size
        }

        fun nestedElement(outer: Int, inner: Int): Int {
            return ArrayRootStateOps.nested[outer][inner]
        }
    }
}

sealed interface ArrayRootKind {
    data object Plain : ArrayRootKind
    data class Weighted(val value: Int) : ArrayRootKind
}
