package boring

object BytesOps {
    fun build(): ByteArray {
        val out = ByteArray(8)
        out[0] = 1.toByte()
        out[1] = 2.toByte()
        val source = ByteArray(4)
        source[0] = 10.toByte()
        source[1] = 11.toByte()
        source[2] = 12.toByte()
        source[3] = 13.toByte()
        (source).copyInto(out, 2, 1, 1 + 3)
        out.fill(165.toByte(), 5, 5 + 2)
        return out
    }
}
