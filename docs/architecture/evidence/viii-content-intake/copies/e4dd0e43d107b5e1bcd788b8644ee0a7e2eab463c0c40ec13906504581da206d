use crate::runtime::sorted_table::SortedTable;
use crate::runtime::u_string::UString;


#[derive(Debug, Clone, PartialEq)]
pub struct PayloadSelfMapException {
    pub error: PayloadSelfMapError,
    pub message: UString,
}

impl PayloadSelfMapException {
    pub fn new(error: PayloadSelfMapError) -> Self {
        Self {
            error,
            message: UString::from("payload self-map"),
        }
    }

    pub fn to_string(&self) -> UString {
        return UString::from(format!("{}", { let mut __s = UString::new(); __s += &(UString::from("PayloadSelfMapException(")); __s += &(UString::from("error=")); __s += UString::from(self.error.name()).as_ustr(); __s += &(UString::from(")")); __s }).as_str());
    }

    pub fn payload_self_map_exception_make() -> PayloadSelfMapException {
        return PayloadSelfMapException::new(PayloadSelfMapError::Missing);
    }
}

fn payload_self_map_exception_order_0(v: &PayloadSelfMapError) -> i32 {
    match v {
        PayloadSelfMapError::Missing => 0,
    }
}

pub fn compare_payload_self_map_exception(a: &PayloadSelfMapException, b: &PayloadSelfMapException) -> i32 {
    let cmp_error = match payload_self_map_exception_order_0(&a.error).cmp(&payload_self_map_exception_order_0(&b.error)) { core::cmp::Ordering::Less => -1, core::cmp::Ordering::Equal => 0, core::cmp::Ordering::Greater => 1 };
    if cmp_error != 0 { return cmp_error; }
    let cmp_message = SortedTable::sorted_table_compare_strings((&a.message).as_ustr(), (&b.message).as_ustr());
    if cmp_message != 0 { return cmp_message; }
    0
}

#[derive(Debug, Clone, Copy, PartialEq)]
pub enum PayloadSelfMapError {
    Missing,
}

pub fn compare_payload_self_map_error(a: &PayloadSelfMapError, b: &PayloadSelfMapError) -> i32 {
    if a == b { return 0; }
    fn rank(v: &PayloadSelfMapError) -> i32 {
        match v {
            PayloadSelfMapError::Missing => 0,
        }
    }
    rank(a) - rank(b)
}

impl PayloadSelfMapError {
    pub fn to_string(&self) -> String {
        match self {
            PayloadSelfMapError::Missing => "Missing".to_string(),
        }
    }
}

impl PayloadSelfMapError {
    pub fn name(&self) -> &'static str {
        match self {
            PayloadSelfMapError::Missing => "Missing",
        }
    }
}
