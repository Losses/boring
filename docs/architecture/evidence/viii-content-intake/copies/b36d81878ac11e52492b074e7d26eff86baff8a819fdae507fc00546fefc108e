package boring

object MathNaNOps {
    fun minOf(a: Double, b: Double): Double {
        return Math.min(a, b)
    }

    fun maxOf(a: Double, b: Double): Double {
        return Math.max(a, b)
    }

    fun minInts(a: Int, b: Int): Double {
        return Math.min((a).toDouble(), (b).toDouble())
    }

    fun maxInts(a: Int, b: Int): Double {
        return Math.max((a).toDouble(), (b).toDouble())
    }

    fun constantNan(): Double {
        return Double.NaN
    }

    fun constantPosInf(): Double {
        return Double.POSITIVE_INFINITY
    }

    fun constantNegInf(): Double {
        return Double.NEGATIVE_INFINITY
    }

    fun constantOverflow(): Double {
        return 1e300
    }

    fun constantUnderflow(): Double {
        return 1e-300
    }
}
