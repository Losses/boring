#![cfg(test)]

use crate::boring::fn_values_ops::BuiltInNameResolver;
use crate::boring::fn_values_ops::FN_VALUES_OPS_DEFAULT_TAG;
use crate::boring::fn_values_ops::FnValuesOps;
use crate::runtime::test as testlib;
use crate::runtime::test_core;
use crate::runtime::u_string::UStr;
use crate::runtime::u_string::UString;
use std::sync::Arc;


#[test]
fn test_field_invocation() {
    testlib::run("tests.FnValuesTests.testFieldInvocation", "tests.FnValuesTests.testFieldInvocation: function-typed fields stored and invoked", || {
        let ops = FnValuesOps::new({  Arc::new(move |index| {
        return UString::from(format!("{}", { let mut __s = UString::new(); __s += &(UString::from("s")); __s += &(UString::from((index).to_string().as_str())); __s }).as_str());
}) }, Box::new(BuiltInNameResolver::new()));
        test_core::TestCore::test_core_equals_string(UStr::new(&[115,51]), ops.style_label(3).as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[98,117,105,108,116,45,105,110,58,99,106,107]), ops.resolve_label(UStr::new(&[99,106,107])).as_ustr(), UStr::new(&[]));
    });
}

#[test]
fn test_parameter_invocation() {
    testlib::run("tests.FnValuesTests.testParameterInvocation", "tests.FnValuesTests.testParameterInvocation: function-typed parameter invoked inside the callee", || {
        test_core::TestCore::test_core_equals_string(UStr::new(&[105,49]), FnValuesOps::fn_values_ops_apply_picker(&vec![UString::from("a").to_ustring(), UString::from("b").to_ustring()], {  Arc::new(move |index| {
        return UString::from(format!("{}", { let mut __s = UString::new(); __s += &(UString::from("i")); __s += &(UString::from((index).to_string().as_str())); __s }).as_str());
}) }).as_ustr(), UStr::new(&[]));
    });
}

#[test]
fn test_generic_parameter() {
    testlib::run("tests.FnValuesTests.testGenericParameter", "tests.FnValuesTests.testGenericParameter: generic function-typed parameter", || {
        test_core::TestCore::test_core_equals_int(6i32, { let v: u32 = FnValuesOps::fn_values_ops_map_one(&(5), {  Arc::new(move |item| {
        return item + 1;
}) }); i32::from_ne_bytes(v.to_ne_bytes()) }, UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[120,33]), FnValuesOps::fn_values_ops_map_one(&(UString::from("x")).to_ustring(), {  Arc::new(move |item| {
        return UString::from(format!("{}", { let mut __s = UString::new(); __s += item; __s += &(UString::from("!")); __s }).as_str());
}) }).as_ustr(), UStr::new(&[]));
    });
}

#[test]
fn test_stored_local() {
    testlib::run("tests.FnValuesTests.testStoredLocal", "tests.FnValuesTests.testStoredLocal: local function value stored and invoked", || {
        test_core::TestCore::test_core_equals_string(UStr::new(&[117,49,57,57,54,56]), FnValuesOps::fn_values_ops_stored_local().as_ustr(), UStr::new(&[]));
    });
}

#[test]
fn test_returned_function() {
    testlib::run("tests.FnValuesTests.testReturnedFunction", "tests.FnValuesTests.testReturnedFunction: function value returned from a function", || {
        let prefixed: Arc<dyn Fn(&UStr) -> UString + Send + Sync + '_> = FnValuesOps::fn_values_ops_make_prefixer(UStr::new(&[112,114,101,45]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[112,114,101,45,115,117,102,102,105,120]), prefixed(UStr::new(&[115,117,102,102,105,120])).as_ustr(), UStr::new(&[]));
    });
}

#[test]
fn test_static_field() {
    testlib::run("tests.FnValuesTests.testStaticField", "tests.FnValuesTests.testStaticField: static function-typed field invoked", || {
        test_core::TestCore::test_core_equals_string(UStr::new(&[116,97,103,55]), FN_VALUES_OPS_DEFAULT_TAG(7).as_ustr(), UStr::new(&[]));
    });
}
