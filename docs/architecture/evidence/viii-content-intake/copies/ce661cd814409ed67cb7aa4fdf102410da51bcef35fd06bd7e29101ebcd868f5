package tests

import boring.runtime.test.Test

class StringCodecTests {
@boring.test.Test
    fun asciiRoundTrip() {
        Test.run("tests.StringCodecTests.asciiRoundTrip", "tests.StringCodecTests.asciiRoundTrip: encodes and decodes ASCII") {
                val bytes = "abc".toByteArray(Charsets.UTF_8)
                Test.equals(3, bytes.size, null)
                Test.equals(97, (( bytes[0].toInt() and 0xFF )), null)
                Test.equals("abc", String(bytes, 0, 3, Charsets.UTF_8), null)
        }
    }

@boring.test.Test
    fun cjkRoundTrip() {
        Test.run("tests.StringCodecTests.cjkRoundTrip", "tests.StringCodecTests.cjkRoundTrip: encodes and decodes a two-byte character") {
                val bytes = "汉".toByteArray(Charsets.UTF_8)
                Test.equals(3, bytes.size, null)
                Test.equals(230, (( bytes[0].toInt() and 0xFF )), null)
                Test.equals("汉", String(bytes, 0, 3, Charsets.UTF_8), null)
        }
    }

@boring.test.Test
    fun astralRoundTrip() {
        Test.run("tests.StringCodecTests.astralRoundTrip", "tests.StringCodecTests.astralRoundTrip: encodes and decodes an astral character") {
                val bytes = "𠮷".toByteArray(Charsets.UTF_8)
                Test.equals(4, bytes.size, null)
                Test.equals("𠮷", String(bytes, 0, 4, Charsets.UTF_8), null)
        }
    }

@boring.test.Test
    fun emptyEncode() {
        Test.run("tests.StringCodecTests.emptyEncode", "tests.StringCodecTests.emptyEncode: empty string encodes to zero bytes") {
                val bytes = "".toByteArray(Charsets.UTF_8)
                Test.equals(0, bytes.size, null)
                Test.equals("", String(bytes, 0, 0, Charsets.UTF_8), null)
        }
    }

@boring.test.Test
    fun invalidDecodesToReplacement() {
        Test.run("tests.StringCodecTests.invalidDecodesToReplacement", "tests.StringCodecTests.invalidDecodesToReplacement: invalid bytes decode to U+FFFD") {
                val bytes = ByteArray(2)
                bytes[0] = 195.toByte()
                bytes[1] = 195.toByte()
                Test.equals("��", String(bytes, 0, 2, Charsets.UTF_8), null)
        }
    }

@boring.test.Test
    fun truncatedSequence() {
        Test.run("tests.StringCodecTests.truncatedSequence", "tests.StringCodecTests.truncatedSequence: a truncated multi-byte sequence decodes to U+FFFD") {
                val bytes = "汉".toByteArray(Charsets.UTF_8)
                Test.equals("�", String(bytes, 0, 2, Charsets.UTF_8), null)
        }
    }

@boring.test.Test
    fun subRangeDecode() {
        Test.run("tests.StringCodecTests.subRangeDecode", "tests.StringCodecTests.subRangeDecode: getString decodes a middle sub-range") {
                val bytes = "a汉b".toByteArray(Charsets.UTF_8)
                Test.equals("汉", String(bytes, 1, 3, Charsets.UTF_8), null)
        }
    }

@boring.test.Test
    fun concatJoins() {
        Test.run("tests.StringCodecTests.concatJoins", "tests.StringCodecTests.concatJoins: concat joins both operands in order") {
                val left = "ab".toByteArray(Charsets.UTF_8)
                val right = "汉".toByteArray(Charsets.UTF_8)
                val joined = left + right
                Test.equals(5, joined.size, null)
                Test.equals(97, (( joined[0].toInt() and 0xFF )), null)
                Test.equals("ab汉", String(joined, 0, 5, Charsets.UTF_8), null)
        }
    }

@boring.test.Test
    fun concatEmpty() {
        Test.run("tests.StringCodecTests.concatEmpty", "tests.StringCodecTests.concatEmpty: concat with an empty operand still copies") {
                val left = "ab".toByteArray(Charsets.UTF_8)
                val right = ByteArray(0)
                val joined = left + right
                Test.equals(2, joined.size, null)
                Test.equals("ab", String(joined, 0, 2, Charsets.UTF_8), null)
        }
    }

@boring.test.Test
    fun concatNoAlias() {
        Test.run("tests.StringCodecTests.concatNoAlias", "tests.StringCodecTests.concatNoAlias: concat never shares storage with its operands") {
                val left = "ab".toByteArray(Charsets.UTF_8)
                val right = "cd".toByteArray(Charsets.UTF_8)
                val joined = left + right
                left[0] = 122.toByte()
                Test.equals(97, (( joined[0].toInt() and 0xFF )), null)
        }
    }
}
