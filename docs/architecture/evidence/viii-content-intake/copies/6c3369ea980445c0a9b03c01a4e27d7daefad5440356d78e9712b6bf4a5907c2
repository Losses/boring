package boring

import boring.runtime.Graphemes
import boring.runtime.UString
import std.UStringException

object GraphemeOps {
    fun graphemeCount(text: String): Int {
        return Graphemes.count(text)
    }

    fun codePointCount(text: String): Int {
        return UString.count(text)
    }

    fun clusterAt(text: String, index: Int): String? {
        return Graphemes.at(text, index)
    }

    fun clusterSlice(text: String, from: Int, to: Int): String {
        return Graphemes.slice(text, from, to)
    }

    fun clampedSlice(text: String): String {
        return Graphemes.slice(text, -2, 99)
    }

    fun partCount(text: String): Int {
        return Graphemes.parts(text).size
    }

    fun firstPart(text: String): String {
        return Graphemes.parts(text)[0]
    }

    fun lastPart(text: String): String {
        val parts = Graphemes.parts(text)
        return parts[parts.size - 1]
    }

    fun graphemeBoundaries(text: String): MutableList<Int> {
        return Graphemes.boundaries(text)
    }

    fun joinedParts(text: String): String {
        val parts = Graphemes.parts(text)
        val buffer = StringBuilder()
        for (index in 0 until parts.size) {
            val tail = buffer.lastOrNull()?.code ?: -1
            if (tail >= 55296 && tail <= 56319 && (parts[index]).length > 0 && !((parts[index])[0].code >= 56320 && (parts[index])[0].code <= 57343)) {
                throw UStringException.UnpairedSurrogate(tail)
            }
            buffer.append((parts[index]))
        }
        val tail2 = buffer.lastOrNull()?.code ?: -1
        if (tail2 >= 55296 && tail2 <= 56319) {
            throw UStringException.UnpairedSurrogate(tail2)
        }
        return buffer.toString()
    }
}
