package tests

import boring.DartCharNullOps
import boring.runtime.test.Test

class DartCharNullTests {
@boring.test.Test
    fun charNullNarrowing() {
        Test.run("tests.DartCharNullTests.charNullNarrowing", "tests.DartCharNullTests.charNullNarrowing: charCodeAt results narrow correctly at consumer boundaries") {
                Test.equals(97, DartCharNullOps.argShape("abc"), null)
                Test.equals(97, DartCharNullOps.boundArgShape("abc"), null)
                Test.equals(true, DartCharNullOps.compareShape("ba"), null)
                Test.equals(99, DartCharNullOps.returnShape("abc"), null)
                Test.equals(true, DartCharNullOps.annotatedCompareShape("ba"), null)
                Test.equals(97, DartCharNullOps.annotatedBoundArgShape("abc"), null)
        }
    }

@boring.test.Test
    fun charNullOutOfRange() {
        Test.run("tests.DartCharNullTests.charNullOutOfRange", "tests.DartCharNullTests.charNullOutOfRange: charCodeAt preserves null for out-of-range indices") {
                val outOfRange = run { val _s = ""; val _i = 5; if (_i >= 0 && _i < _s.length) _s[_i].code else null }
                Test.equals(true, outOfRange == null, null)
        }
    }
}
