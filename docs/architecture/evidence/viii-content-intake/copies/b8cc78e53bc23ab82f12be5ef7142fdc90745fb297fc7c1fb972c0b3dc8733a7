package boring

object NumericDomainOps {
    fun prefixUnit(text: String, start: Int): Int {
        if ((start > 0)) {
            return (run { val _s = text; val _i = start - 1; if (_i >= 0 && _i < _s.length) _s[_i].code else null })!!
        }
        return 0
    }

    fun offsets(word: String): MutableList<Int> {
        val result = mutableListOf<Int>()
        var m = 0
        while ((m < word.length - 1)) {
            val offset = m + 1
            if ((offset >= 1 && offset <= word.length - 1)) {
                result.add(offset)
            }
            m++
        }
        return result
    }

    fun findIndex(values: MutableList<Int>, key: Int): Int {
        var found = -1
        var i = 0
        while ((i < values.size)) {
            if ((values[i] == key)) {
                found = i
                break
            }
            i++
        }
        if ((found < 0)) {
            return 0
        }
        return values[found]
    }

    fun beforeChar(text: String, end: Int): Int {
        val lastIndex = end - 1
        if ((lastIndex > 0)) {
            return (run { val _s = text; val _i = lastIndex - 1; if (_i >= 0 && _i < _s.length) _s[_i].code else null })!!
        }
        return (run { val _s = text; val _i = lastIndex; if (_i >= 0 && _i < _s.length) _s[_i].code else null })!!
    }

    fun colonPair(token: String, close: Int): MutableList<Int> {
        val colon = token.indexOf(":", close + 1)
        if ((colon != close + 1)) {
            return mutableListOf<Int>()
        }
        return mutableListOf<Int>(close, colon + 1)
    }

    fun collectOffsets(word: String): MutableList<Int> {
        val result = mutableListOf<Int>()
        var m = 0
        while ((m < word.length - 1)) {
            val offset = m + 1
            result.add(offset)
            m++
        }
        return result
    }
}
