package boring

import boring.runtime.FPHelper

object StdStringOps {
    fun concatString(value: String): String {
        return "string=" + value
    }

    fun concatInt(value: Int): String {
        return "int=" + value
    }

    fun concatFloat(value: Float): String {
        return "float=" + boring.runtime.FPHelper.formatFloat(value)
    }

    fun concatBool(value: Boolean): String {
        return "bool=" + value
    }

    fun concatEnum(value: FloatWidth): String {
        return "enum=" + value
    }

    fun stringValue(value: String): String {
        return value
    }

    fun intValue(value: Int): String {
        return (value).toString()
    }

    fun floatValue(value: Float): String {
        return boring.runtime.FPHelper.formatFloat(value)
    }

    fun floatForms(): MutableList<String> {
        return mutableListOf<String>(boring.runtime.FPHelper.formatFloat(2.0f), boring.runtime.FPHelper.formatFloat(0.0f), boring.runtime.FPHelper.formatFloat(-0.0f), boring.runtime.FPHelper.formatFloat(2.5f), boring.runtime.FPHelper.formatFloat(-1.25f), boring.runtime.FPHelper.formatFloat(1e20f), boring.runtime.FPHelper.formatFloat(1e21f), boring.runtime.FPHelper.formatFloat(1e-6f), boring.runtime.FPHelper.formatFloat(1e-7f))
    }

    fun boolValue(value: Boolean): String {
        return (value).toString()
    }

    fun enumValue(value: FloatWidth): String {
        return value.name
    }

    fun enumMatchesConstructor(): Boolean {
        return FloatWidth.F32.name == "F32"
    }

    fun intArray(): String {
        val values = mutableListOf<Int>(1, 2, 3)
        return run { val sb = StringBuilder(); sb.append('['); val n = values.size; var i = 0; while (i < n) { if (i > 0) { sb.append(", "); }; sb.append(values[i]); i += 1; }; sb.append(']'); sb.toString() }
    }

    fun stringArray(): String {
        val values = mutableListOf<String>("alpha", "beta")
        return run { val sb = StringBuilder(); sb.append('['); val n = values.size; var i = 0; while (i < n) { if (i > 0) { sb.append(", "); }; sb.append(values[i]); i += 1; }; sb.append(']'); sb.toString() }
    }

    fun floatArray(): String {
        val values = mutableListOf<Float>(1.5f, 2.25f)
        return run { val sb = StringBuilder(); sb.append('['); val n = values.size; var i = 0; while (i < n) { if (i > 0) { sb.append(", "); }; sb.append(boring.runtime.FPHelper.formatFloat(values[i])); i += 1; }; sb.append(']'); sb.toString() }
    }

    fun boolArray(): String {
        val values = mutableListOf<Boolean>(true, false)
        return run { val sb = StringBuilder(); sb.append('['); val n = values.size; var i = 0; while (i < n) { if (i > 0) { sb.append(", "); }; sb.append(values[i]); i += 1; }; sb.append(']'); sb.toString() }
    }

    fun enumArray(): String {
        val values = mutableListOf<FloatWidth>(FloatWidth.F64, FloatWidth.F16)
        return run { val sb = StringBuilder(); sb.append('['); val n = values.size; var i = 0; while (i < n) { if (i > 0) { sb.append(", "); }; sb.append(values[i]); i += 1; }; sb.append(']'); sb.toString() }
    }

    fun emptyArray(): String {
        return StdStringOps.emptyArrayValue(mutableListOf<Int>())
    }

    private fun emptyArrayValue(values: MutableList<Int>): String {
        return run { val sb = StringBuilder(); sb.append('['); val n = values.size; var i = 0; while (i < n) { if (i > 0) { sb.append(", "); }; sb.append(values[i]); i += 1; }; sb.append(']'); sb.toString() }
    }

    fun nestedArray(): String {
        val values = mutableListOf<MutableList<Int>>(mutableListOf<Int>(1, 2), mutableListOf<Int>(3))
        return run { val sb = StringBuilder(); sb.append('['); val n = values.size; var i = 0; while (i < n) { if (i > 0) { sb.append(", "); }; sb.append(run { val sb = StringBuilder(); sb.append('['); val n = values[i].size; var i1 = 0; while (i1 < n) { if (i1 > 0) { sb.append(", "); }; sb.append(values[i][i1]); i1 += 1; }; sb.append(']'); sb.toString() }); i += 1; }; sb.append(']'); sb.toString() }
    }

    fun readOnlyArray(): String {
        val values = mutableListOf<String>("alpha", "beta")
        return run { val sb = StringBuilder(); sb.append('['); val n = values.size; var i = 0; while (i < n) { if (i > 0) { sb.append(", "); }; sb.append(values[i]); i += 1; }; sb.append(']'); sb.toString() }
    }
}
