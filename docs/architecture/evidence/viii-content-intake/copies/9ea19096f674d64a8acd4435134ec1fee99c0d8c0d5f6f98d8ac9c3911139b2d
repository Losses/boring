#![cfg(test)]

use crate::boring::knull_init_narrowing::KnullInitNarrowing;
use crate::boring::knull_init_narrowing::Nested;
use crate::runtime::test as testlib;
use crate::runtime::test_core;
use crate::runtime::u_string::UStr;


#[test]
fn field_off_nullable_receiver() {
    testlib::run("tests.KnullInitNarrowingTests.fieldOffNullableReceiver", "tests.KnullInitNarrowingTests.fieldOffNullableReceiver: reads a field off a nullable receiver bound to a non-null local", || {
        let k = KnullInitNarrowing::new();
        let nested = Nested::new(5u32);
        test_core::TestCore::test_core_equals_int(5i32, i32::from_ne_bytes(((k.field_off_nullable_receiver(Some((nested).clone()))) as i32).to_ne_bytes()), UStr::new(&[]));
    });
}

#[test]
fn ternary_with_nullable_arm() {
    testlib::run("tests.KnullInitNarrowingTests.ternaryWithNullableArm", "tests.KnullInitNarrowingTests.ternaryWithNullableArm: binds a non-null local from a ternary whose else arm is nullable", || {
        let k = KnullInitNarrowing::new();
        test_core::TestCore::test_core_equals_int(1i32, i32::from_ne_bytes(((k.ternary_with_nullable_arm(true, None)) as i32).to_ne_bytes()), UStr::new(&[]));
    });
}

#[test]
fn chained_field_access() {
    testlib::run("tests.KnullInitNarrowingTests.chainedFieldAccess", "tests.KnullInitNarrowingTests.chainedFieldAccess: chains two field accesses off a nullable receiver", || {
        let k = KnullInitNarrowing::new();
        let nested = Nested::new(7u32);
        test_core::TestCore::test_core_equals_string(UStr::new(&[118,55]), k.chained_field_access(Some((nested).clone())).as_ustr(), UStr::new(&[]));
    });
}
