package boring

class CloneDeriveRange(val start: Int, val end: Int) {

    override fun toString(): String {
        return (this.start).toString() + ".." + this.end
    }
}

data class CloneDeriveResult(val range: CloneDeriveRange, val label: String) {
}



class CloneDeriveAbstractResult(val label: String, val size: Int) {
}

object CloneDeriveGapOps {
    fun resolve(results: MutableList<CloneDeriveResult>): String {
        val r = results[0]
        return r.range.toString() + ":" + r.label
    }

    fun resolveAbstract(results: MutableList<CloneDeriveAbstractResult>): String {
        val r = results[0]
        val label = r.label
        return label + ":" + r.size
    }
}
