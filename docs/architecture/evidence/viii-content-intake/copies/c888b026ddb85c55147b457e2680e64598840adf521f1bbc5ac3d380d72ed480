package boring

object NullableLocalOps {
    fun intLocalMatches(value: MutableList<Int?>): Boolean {
        val one = 1
        return value[0] == one
    }

    fun floatLocalMatches(value: MutableList<Float?>): Boolean {
        val half = 0.5f
        return value[0] == half
    }

    fun boolLocalIsNull(): Boolean {
        val flag: Boolean? = null
        return flag == null
    }

    fun stringLocalMatches(value: MutableList<String?>): Boolean {
        val tag = "a"
        return value[0] == tag
    }

    fun nullableInitPassesThrough(source: MutableList<Int?>): Boolean {
        val carried = source[0]
        return carried == source[0]
    }

    fun lookupLocalPassesThrough(mode: LocalProbe): Boolean {
        val back = LocalProbe.entries.firstOrNull { it.name == mode.name }
        return back == mode
    }
}

enum class LocalProbe {
    Alpha,
    Beta
}
fun compareLocalProbe(a: LocalProbe, b: LocalProbe): Int = a.ordinal - b.ordinal
