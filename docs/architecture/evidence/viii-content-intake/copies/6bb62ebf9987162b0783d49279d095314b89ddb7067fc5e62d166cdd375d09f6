#![cfg(test)]

use crate::boring::signed_int_assign_ops::SignedIntAssignOps;
use crate::runtime::test as testlib;
use crate::runtime::test_core;
use crate::runtime::u_string::UStr;


#[test]
fn advance() {
    testlib::run("tests.SignedIntAssignOpsTests.advance", "tests.SignedIntAssignOpsTests.advance: a u32 local assigned an i32-domain sum reinterprets the result", || {
        test_core::TestCore::test_core_equals_int(3i32, i32::from_ne_bytes(((SignedIntAssignOps::signed_int_assign_ops_advance(UStr::new(&[97,98,120]))) as i32).to_ne_bytes()), UStr::new(&[]));
        test_core::TestCore::test_core_equals_int(0i32, i32::from_ne_bytes(((SignedIntAssignOps::signed_int_assign_ops_advance(UStr::new(&[97,98,99]))) as i32).to_ne_bytes()), UStr::new(&[]));
    });
}
