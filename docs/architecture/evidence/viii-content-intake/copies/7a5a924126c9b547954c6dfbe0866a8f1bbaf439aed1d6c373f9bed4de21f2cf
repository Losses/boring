#[derive(Clone, Copy)]
pub struct UnderscoreParamOps;

impl UnderscoreParamOps {
    pub fn underscore_param_ops_resolve(value: u32) -> u32 {
        return u32::wrapping_add(value, 1);
    }

    pub fn underscore_param_ops_pair(first: u32, second: u32) -> u32 {
        return u32::wrapping_add(first, second);
    }
}
