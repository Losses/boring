use crate::runtime::u_string;
use crate::runtime::u_string::UStr;
use crate::runtime::u_string::UString;
use crate::std::u_string_exception::UStringFault;


#[derive(Clone, Copy)]
pub struct UStringOps;

impl UStringOps {
    pub fn u_string_ops_ascii_count() -> u32 {
        return u_string::count(UStr::new(&[116,105,113,105,97,110]));
    }

    pub fn u_string_ops_bmp_count() -> u32 {
        return u_string::count(UStr::new(&[25552,26912,25490,29256]));
    }

    pub fn u_string_ops_supplementary_count() -> u32 {
        return u_string::count(UStr::new(&[55360,56320,19968,55360,56321]));
    }

    pub fn u_string_ops_code_at(text: &UStr, index: u32) -> Option<u32> {
        return u_string::at(text, index);
    }

    pub fn u_string_ops_middle_slice(text: &UStr) -> UString {
        return u_string::slice(text, 1i32, 3i32);
    }

    pub fn u_string_ops_clamped_slice(text: &UStr) -> UString {
        return u_string::slice(text, -2i32, 99i32);
    }

    pub fn u_string_ops_reversed_text(text: &UStr) -> Result<UString, UStringFault> {
        let codes = u_string::to_code_points(text);
        let capacity = codes.len();
        let mut reversed = Vec::with_capacity(capacity);
        for index in 0..match u32::try_from(codes.len()) { Ok(value) => value, Err(_) => u32::MAX } {
            reversed.push(codes[usize::try_from(u32::wrapping_sub(u32::wrapping_sub(u32::try_from((codes.len()) & 0xFFFF_FFFF).unwrap_or(0), 1), index)).unwrap_or(0)]);
        }
        for &code in &reversed {
            if code > 2147483647 || (i32::from_ne_bytes(((code) as i32).to_ne_bytes())) > (1114111) || (i32::from_ne_bytes(((code) as i32).to_ne_bytes())) >= 55296 && (i32::from_ne_bytes(((code) as i32).to_ne_bytes())) <= 57343 {
                return Err(UStringFault::InvalidCodePoint { code: code });
            }
        }
        return Ok(u_string::from_code_points(&reversed));
    }

    pub fn u_string_ops_round_trip(text: &UStr) -> Result<UString, UStringFault> {
        let codes = u_string::to_code_points(text);
        for &code in &codes {
            if code > 2147483647 || (i32::from_ne_bytes(((code) as i32).to_ne_bytes())) > (1114111) || (i32::from_ne_bytes(((code) as i32).to_ne_bytes())) >= 55296 && (i32::from_ne_bytes(((code) as i32).to_ne_bytes())) <= 57343 {
                return Err(UStringFault::InvalidCodePoint { code: code });
            }
        }
        return Ok(u_string::from_code_points(&codes));
    }

    pub fn u_string_ops_substring_range(text: &UStr, from: u32, to: u32) -> UString {
        return u_string::substring(&text, i32::from_ne_bytes(((from) as i32).to_ne_bytes()), i32::from_ne_bytes(((to) as i32).to_ne_bytes()));
    }

    pub fn u_string_ops_substring_from(text: &UStr, from: u32) -> UString {
        return u_string::substring_from(&text, i32::from_ne_bytes(((from) as i32).to_ne_bytes()));
    }

    pub fn u_string_ops_substring_literal() -> UString {
        return u_string::substring(&UString::from("tiqian"), 1i32, 3i32);
    }

    pub fn u_string_ops_substring_negative_start() -> UString {
        return u_string::substring(&UString::from("abcdef"), -2i32, 3i32);
    }

    pub fn u_string_ops_substring_long_end() -> UString {
        return u_string::substring(&UString::from("abcdef"), 2i32, 20i32);
    }

    pub fn u_string_ops_substring_swapped_bounds() -> UString {
        return u_string::substring(&UString::from("abcdef"), 5i32, 2i32);
    }

    pub fn u_string_ops_substring_omitted_end() -> UString {
        return u_string::substring_from(&UString::from("abcdef"), -3i32);
    }
}
