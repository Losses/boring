#![cfg(test)]

use crate::boring::loop_write_ops::LoopWriteOps;
use crate::runtime::test as testlib;
use crate::runtime::test_core;
use crate::runtime::u_string::UStr;


#[test]
fn tail_increment() {
    testlib::run("tests.LoopWriteTests.tailIncrement", "tests.LoopWriteTests.tailIncrement: tail counter increment remains a counted loop", || {
        test_core::TestCore::test_core_equals_int(15i32, i32::from_ne_bytes(((LoopWriteOps::loop_write_ops_tail_increment(6)) as i32).to_ne_bytes()), UStr::new(&[]));
    });
}

