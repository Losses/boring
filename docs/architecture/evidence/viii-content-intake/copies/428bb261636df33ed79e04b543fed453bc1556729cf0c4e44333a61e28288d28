package tests

import boring.ClashCount
import boring.PlainCount
import boring.runtime.test.Test

class ValueTypeClashTests {
@boring.test.Test
    fun clashDoubled() {
        Test.run("tests.ValueTypeClashTests.clashDoubled", "tests.ValueTypeClashTests.clashDoubled: clashing wrapper reads through the colliding member") {
                Test.equals(4.0, ClashCount(2.0).doubled(), null)
        }
    }

@boring.test.Test
    fun controlMember() {
        Test.run("tests.ValueTypeClashTests.controlMember", "tests.ValueTypeClashTests.controlMember: clash-free wrapper reads its representation") {
                Test.equals(3.0, PlainCount(3.0).read(), null)
        }
    }
}
