#!/usr/bin/env python3
"""Generate the fixed-rerun input manifest from the execution root and verify
that the same anchor holds for the coordination tree (no drift in the window).

Usage: gen-manifest.py <path-list-source.json> <root> <coord-tree> <manifest-out>
"""
import hashlib, json, os, stat, sys

paths_src, root, coord, out = sys.argv[1:5]
base = json.load(open(paths_src))
paths = [e["path"] for e in base]

def digest(path):
    with open(path, "rb") as fh:
        return hashlib.sha256(fh.read()).hexdigest()

def mode_of(path):
    return "100755" if (os.stat(path).st_mode & stat.S_IXUSR) else "100644"

entries = []
missing = []
for p in paths:
    fp = os.path.join(root, p)
    if not os.path.isfile(fp):
        missing.append(p)
        continue
    entries.append({"path": p, "sha256": digest(fp), "mode": mode_of(fp)})

if missing:
    print("MISSING in root:", missing)
    sys.exit(70)

with open(out, "w") as fh:
    json.dump(entries, fh, indent=2)
    fh.write("\n")

print("manifest entries: %d" % len(entries))
print("manifest sha256: %s" % digest(out))

# --- cross-check 1: root vs newly written manifest ---
def check(tree, label):
    fails = []
    for e in entries:
        fp = os.path.join(tree, e["path"])
        if not os.path.isfile(fp):
            fails.append("missing: " + e["path"]); continue
        d = digest(fp)
        if d != e["sha256"]:
            fails.append("sha256: %s actual=%s want=%s" % (e["path"], d, e["sha256"]))
        if mode_of(fp) != e["mode"]:
            fails.append("mode: %s actual=%s want=%s" % (e["path"], mode_of(fp), e["mode"]))
    print("CHECK %-28s entries=%d failures=%d" % (label, len(entries), len(fails)))
    for f in fails:
        print("   FAIL " + f)
    return len(fails)

f1 = check(root, "execution-root")
f2 = check(coord, "coordination-tree")

# --- cross-check 2: named fixes as stated in the task ---
named = [
    ("packages/compiler/reflaxe/swift/swiftcompiler/SwiftArrayBoundary.hx", "b522865c7b7c3882"),
    ("packages/compiler/reflaxe/rust/rustcompiler/Compiler.hx", "07896d15a5b718b8"),
]
by = {e["path"]: e for e in entries}
for p, pref in named:
    got = by[p]["sha256"]
    print("NAMED-FIX %-70s %s expect-prefix=%s %s" % (p, got[:16], pref, "OK" if got.startswith(pref) else "MISMATCH"))

sys.exit(1 if (f1 or f2) else 0)
