use crate::boring::glyph_metrics::GlyphMetrics;


#[derive(Clone, Copy)]
pub struct VectorSort;

impl VectorSort {
    pub fn by_code_point(records: &mut Vec<GlyphMetrics>) -> &Vec<GlyphMetrics> {
        for write in 1..match u32::try_from(records.len()) { Ok(value) => value, Err(_) => u32::MAX } {
            let record = records[usize::try_from(write).unwrap_or(0)];
            let key = record.code_point;
            let mut read = write;
            while (read) > (0) && (i32::from_ne_bytes(((records[usize::try_from(u32::wrapping_sub(read, 1)).unwrap_or(0)].code_point) as i32).to_ne_bytes())) > (i32::from_ne_bytes(((key) as i32).to_ne_bytes())) {
                records[usize::try_from(read).unwrap_or(0)] = records[usize::try_from(u32::wrapping_sub(read, 1)).unwrap_or(0)];
                read = u32::wrapping_sub(read, 1);
            }
            records[usize::try_from(read).unwrap_or(0)] = record;
        }
        return records;
    }
}
