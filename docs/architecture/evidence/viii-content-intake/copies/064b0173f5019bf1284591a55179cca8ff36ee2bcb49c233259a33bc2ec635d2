use crate::runtime::u_string::UStr;
use crate::runtime::u_string::UString;


#[derive(Clone, Copy)]
pub struct NullableLocalOps;

impl NullableLocalOps {
    pub fn nullable_local_ops_int_local_matches(value: &Vec<Option<u32>>) -> bool {
        let one = Some(1u32);
        return value[0usize] == one;
    }

    pub fn nullable_local_ops_float_local_matches(value: &Vec<Option<f32>>) -> bool {
        let half = Some(0.5f32);
        return value[0usize] == half;
    }

    pub fn nullable_local_ops_bool_local_is_null() -> bool {
        let flag: Option<bool> = None;
        return flag.is_none();
    }

    pub fn nullable_local_ops_string_local_matches(value: &Vec<Option<UString>>) -> bool {
        let tag = Some(UString::from("a").to_ustring());
        return (value[0usize]).clone() == tag;
    }

    pub fn nullable_local_ops_nullable_init_passes_through(source: &Vec<Option<u32>>) -> bool {
        let carried = source[0usize];
        return carried == source[0usize];
    }

    pub fn nullable_local_ops_lookup_local_passes_through(mode: LocalProbe) -> bool {
        let back = LocalProbe::from_name(UString::from(mode.name()).as_ustr());
        return back == Some(mode);
    }
}

#[derive(Debug, Clone, Copy, PartialEq)]
pub enum LocalProbe {
    Alpha,
    Beta,
}

pub fn compare_local_probe(a: &LocalProbe, b: &LocalProbe) -> i32 {
    if a == b { return 0; }
    fn rank(v: &LocalProbe) -> i32 {
        match v {
            LocalProbe::Alpha => 0,
            LocalProbe::Beta => 1,
        }
    }
    rank(a) - rank(b)
}

impl LocalProbe {
    pub fn to_string(&self) -> String {
        match self {
            LocalProbe::Alpha => "Alpha".to_string(),
            LocalProbe::Beta => "Beta".to_string(),
        }
    }
}

impl LocalProbe {
    pub fn name(&self) -> &'static str {
        match self {
            LocalProbe::Alpha => "Alpha",
            LocalProbe::Beta => "Beta",
        }
    }
    pub fn from_name(name: &UStr) -> Option<LocalProbe> {
        match name.to_utf8_lossy().as_str() {
            "Alpha" => Some(LocalProbe::Alpha),
            "Beta" => Some(LocalProbe::Beta),
            _ => None,
        }
    }
}
