#[derive(Debug, Clone, Copy, PartialEq)]
pub enum Mode {
    Read,
    Write,
}

pub fn compare_mode(a: &Mode, b: &Mode) -> i32 {
    if a == b { return 0; }
    fn rank(v: &Mode) -> i32 {
        match v {
            Mode::Read => 0,
            Mode::Write => 1,
        }
    }
    rank(a) - rank(b)
}

impl Mode {
    pub fn to_string(&self) -> String {
        match self {
            Mode::Read => "Read".to_string(),
            Mode::Write => "Write".to_string(),
        }
    }
}

#[derive(Debug, Clone, Copy, PartialEq)]
pub enum ParamReadKind {
    Pinyin,
    Bopomofo,
}

pub fn compare_param_read_kind(a: &ParamReadKind, b: &ParamReadKind) -> i32 {
    if a == b { return 0; }
    fn rank(v: &ParamReadKind) -> i32 {
        match v {
            ParamReadKind::Pinyin => 0,
            ParamReadKind::Bopomofo => 1,
        }
    }
    rank(a) - rank(b)
}

impl ParamReadKind {
    pub fn to_string(&self) -> String {
        match self {
            ParamReadKind::Pinyin => "Pinyin".to_string(),
            ParamReadKind::Bopomofo => "Bopomofo".to_string(),
        }
    }
}
