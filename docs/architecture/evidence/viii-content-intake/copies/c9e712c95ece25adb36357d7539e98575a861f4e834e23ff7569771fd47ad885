use crate::boring::extension_ops::ExtensionMode;
use crate::boring::extension_ops::string_label;
use crate::runtime::u_string::UStr;
use crate::runtime::u_string::UString;


#[derive(Clone, Copy)]
pub struct ExtensionConsumer;

impl ExtensionConsumer {
    pub fn extension_consumer_enum_result() -> UString {
        return ExtensionMode::Hot.mode_label(UStr::new(&[33]));
    }

    pub fn extension_consumer_string_result() -> UString {
        return string_label(UStr::new(&[99,111,114,101]), UStr::new(&[64]));
    }

    pub fn extension_consumer_private_result() -> UString {
        return ExtensionMode::Cold.mode_with_private();
    }
}
