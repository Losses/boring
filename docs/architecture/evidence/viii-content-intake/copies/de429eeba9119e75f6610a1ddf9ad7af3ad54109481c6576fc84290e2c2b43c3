#!/usr/bin/env python3
"""Map each unique stage-4 failure to its test file and class."""
import collections, re, sys
src, out = sys.argv[1], sys.argv[2]
txt = open(src, encoding='utf-8', errors='replace').read()
blocks = re.split(r'(?m)^(?=\(fail\) )', txt)
seen, rows = {}, []
for b in blocks:
    if not b.startswith('(fail) '):
        continue
    first = b.splitlines()[0]
    m = re.match(r'\(fail\) (.*?)(?: \[([0-9.]+)ms\])?$', first)
    name, dur = m.group(1), m.group(2)
    tmo = re.search(r'this test timed out after (\d+)ms', b)
    kind = 'TIMEOUT' if tmo else 'ASSERT'
    budget = (tmo.group(1) + 'ms') if tmo else '-'
    files = re.findall(r'(?m)^([\w/.-]+\.(?:ts|tsx|js)):', b)
    f = files[0] if files else '?'
    if name in seen:
        continue
    seen[name] = 1
    rows.append((kind, f, name, dur or '-', budget))
lines = ["%d unique failures" % len(rows), ""]
by = collections.defaultdict(list)
for r in rows:
    by[r[1]].append(r)
for f in sorted(by):
    lines.append("%s  (%d)" % (f, len(by[f])))
    for r in sorted(by[f], key=lambda x: x[2]):
        lines.append("    %-8s %-9s %-10s %s" % (r[0], r[4], r[3], r[2]))
    lines.append("")
open(out, 'w').write("\n".join(lines) + "\n")
print("\n".join(lines))
