#[derive(Clone, PartialEq)]
pub struct ConstructorStatementOps {
    pub filled: Vec<u32>,
    pub mapped: Vec<u32>,
}

impl ConstructorStatementOps {
    pub fn new(count: u32, values: Vec<u32>) -> Self {
        let mut _g: Vec<u32> = vec![];
        for _ in 0..u32::wrapping_add(count, 1) {
            _g.push(0);
        }
        let capacity = values.len();
        let mut pipeline_result = Vec::with_capacity(capacity);
        for pipeline_index in 0..match u32::try_from(values.len()) { Ok(value) => value, Err(_) => u32::MAX } {
            let v = values[usize::try_from(pipeline_index).unwrap_or(0)];
            let incremented = u32::wrapping_add(v, 1);
            pipeline_result.push(incremented);
        }
        let mapped = pipeline_result;
        Self {
            filled: _g,
            mapped: mapped,
        }
    }
}
