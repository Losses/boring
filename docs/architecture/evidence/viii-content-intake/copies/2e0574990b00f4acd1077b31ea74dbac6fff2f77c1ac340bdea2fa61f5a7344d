#!/usr/bin/env bash
# Boundary experiment (t-mun5d99p-op76): plain module, no exceptions.
# Usage: EV=<dir> bash boundary.sh
# Phase A: fixed tree (current worktree). Phase B: reverted (old manifest
# logic via git checkout), then the fix is re-applied.
set -uo pipefail
EV="${EV:?EV required}"
ROOT="/home/losses/Development/tq-workspace/dc-warn/worktrees/swift-rt"
F="packages/compiler/reflaxe/swift/swiftcompiler/SwiftDecl.hx"
PATCH="/home/losses/Development/tq-workspace/dc-warn/out/swift-rt/PATCH.diff"
GEN="out/swift-rt/gen/plain"
FIX="tests/haxe/swift-rt-plain"
STAGES="$EV/stages"
mkdir -p "$STAGES" "$EV/trees"
TAB="$(printf '\t')"
record() { printf '%s%s%s%s%s\n' "$1" "$TAB" "$TAB$2" "$TAB" "$3" >>"$EV/status.tsv"; printf '%s observed=%s\n' "$1" "$2"; }

SWIFTROOT="/nix/store/j1bfa7mw323wmp6pfrn1qkchxv61wk2n-swift-toolchain-6.2.4-al2"
FHS="/nix/store/xq9k8vi7gqw0wn592p95wzvzf3wzn4kh-swift-6.2.4-fhs-fhsenv-rootfs"
GLIBC_LIB="$(dirname "$(readlink -f "$FHS/usr/lib64/Scrt1.o")")"
GCCRT_DIR="$(gcc -print-libgcc-file-name | sed 's#/[^/]*$##')"
LIBGCCS_DIR="$(gcc -print-file-name=libgcc_s.so.1 | sed 's#/[^/]*$##')"
LDRT="$FHS/usr/lib64:$FHS/lib64:$SWIFTROOT/usr/lib/swift/linux:/usr/lib64:/usr/lib"
SHIM="$EV/swift-shim"; mkdir -p "$SHIM"
for f in Scrt1.o crti.o crtn.o; do cp "$GLIBC_LIB/$f" "$SHIM/$f" 2>/dev/null || true; done
for f in crtbeginS.o crtendS.o; do cp "$GCCRT_DIR/$f" "$SHIM/$f" 2>/dev/null || true; done

run_phase() { # <phase>
	local phase=$1
	local dir="$STAGES/$phase"
	mkdir -p "$dir"
	{ printf 'cwd %s\nargv haxe %s/gen/swift.hxml -D swift-output=%s\n' "$ROOT" "$FIX" "$GEN"; } >"$dir/argv"
	( cd "$ROOT" && rm -rf "$GEN" && haxe "$FIX/gen/swift.hxml" -D "swift-output=$GEN" -D "swift-test-output=out/swift-rt/gen/plain-test" ) >"$dir/gen.stdout" 2>"$dir/gen.stderr"
	printf '%s\n' "$?" >"$dir/gen.status"
	record "$phase-gen" "$(cat "$dir/gen.status")" "zero"
	( cd "$ROOT" && find "$GEN" -type f | sort | sed "s#^$GEN/##" ) >"$EV/trees/$phase.files" 2>&1
	( cd "$ROOT" && find "$GEN" -name '*.swift' | sort | sed "s#^$GEN/##" | while read -r f; do printf '%s  %s\n' "$(sha256sum "$GEN/$f" | cut -d' ' -f1)" "$f"; done ) >"$EV/trees/$phase.sha256" 2>&1
	record "$phase-tree" "$(wc -l <"$EV/trees/$phase.files")" "file-count"
	( cd "$ROOT" && cp "$FIX/native/native-main.swift" "$GEN/native-main.swift" )
	local AGEN="$ROOT/$GEN"
	# Whole tree: every emitted .swift except the SwiftPM manifest.
	# (Runtime.swift enters through $RT below, exactly once.)
	local FILES=$( cd "$ROOT" && find "$AGEN" -name '*.swift' ! -name 'Package.swift' ! -name 'native-main.swift' ! -name 'Runtime.swift' | tr '\n' ' ' )
	local RT=""
	[ -f "$AGEN/Runtime.swift" ] && RT="$AGEN/Runtime.swift "
	{ printf 'cwd %s\nargv' "$ROOT"; printf ' %q' bash -c "cd $SHIM && LD_LIBRARY_PATH='$LDRT' timeout 1800 $SWIFTROOT/usr/bin/swiftc -o $AGEN/run-bin $RT$FILES $AGEN/native-main.swift -Xcc -I$FHS/usr/include -L$FHS/usr/lib64 -L$GCCRT_DIR -L$LIBGCCS_DIR -L$GLIBC_LIB"; printf '\n'; } >"$dir/compile.argv"
	( cd "$SHIM" && LD_LIBRARY_PATH="$LDRT" timeout 1800 "$SWIFTROOT/usr/bin/swiftc" -o "$AGEN/run-bin" $RT$FILES "$AGEN/native-main.swift" -Xcc -I"$FHS/usr/include" -L"$FHS/usr/lib64" -L"$GCCRT_DIR" -L"$LIBGCCS_DIR" -L"$GLIBC_LIB" ) >"$dir/compile.stdout" 2>"$dir/compile.stderr"
	printf '%s\n' "$?" >"$dir/compile.status"
	record "$phase-compile" "$(cat "$dir/compile.status")" "data"
	if [ "$(cat "$dir/compile.status")" = "0" ]; then
		local tb=/tmp/swift-rt-plain-$phase-bin
		cp "$ROOT/$GEN/run-bin" "$tb" && chmod +x "$tb"
		{ printf 'cwd /tmp\nargv'; printf ' %q' cp "$ROOT/$GEN/run-bin" $tb; printf ' %q' chmod +x $tb; printf ' %q' env "LD_LIBRARY_PATH=$LDRT" timeout 300 $tb; printf '\n'; } >"$dir/run.argv"
		( cd /tmp && LD_LIBRARY_PATH="$LDRT" timeout 300 "$tb" ) >"$dir/run.stdout" 2>"$dir/run.stderr"
		printf '%s\n' "$?" >"$dir/run.status"
		record "$phase-run-from-tmp" "$(cat "$dir/run.status")" "supplementary: fuse exec-bit loss; same binary off-fuse"
		diff -u "$ROOT/$FIX/expected.txt" "$dir/run.stdout" >"$dir/compare.stdout" 2>"$dir/compare.stderr"
		record "$phase-compare-from-tmp" "$?" "0-identical-nonzero-differs"
	fi
}

echo "boundary $(date -u +%Y-%m-%dT%H:%M:%SZ)" >"$EV/identity.txt"
git -C "$ROOT" log --oneline -1 >>"$EV/identity.txt"

run_phase fixed
git -C "$ROOT" checkout -- "$F"
run_phase reverted
git -C "$ROOT" apply "$PATCH"
sha256sum "$ROOT/$F" >>"$EV/identity.txt"
