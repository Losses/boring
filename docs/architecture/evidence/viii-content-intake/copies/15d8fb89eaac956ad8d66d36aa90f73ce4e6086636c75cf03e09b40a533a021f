#![cfg(test)]

use crate::boring::int_float_sign_ops::IntFloatSignOps;
use crate::runtime::sorted_table::SortedMapTable;
use crate::runtime::test as testlib;
use crate::runtime::test_core;
use crate::runtime::u_string::UStr;
use crate::tests::test_helper::*;


#[test]
fn test_comparison() {
    testlib::run("tests.IntFloatSignTests.testComparison", "tests.IntFloatSignTests.testComparison: a wrapped Int stays -1.0 through an Int-vs-Float comparison widening", || {
        test_core::TestCore::test_core_equals_bool(true, IntFloatSignOps::int_float_sign_ops_below_half(3, 4), UStr::new(&[]));
        test_core::TestCore::test_core_equals_bool(false, IntFloatSignOps::int_float_sign_ops_below_half(4, 3), UStr::new(&[]));
    });
}

#[test]
fn test_collapsed_comparison() {
    testlib::run("tests.IntFloatSignTests.testCollapsedComparison", "tests.IntFloatSignTests.testCollapsedComparison: a wrapped Int stays -1.0 through a collapsed-local comparison widening", || {
        test_core::TestCore::test_core_equals_bool(true, IntFloatSignOps::int_float_sign_ops_equals_collapsed(3, 4), UStr::new(&[]));
    });
}

#[test]
fn test_compound_assign() {
    testlib::run("tests.IntFloatSignTests.testCompoundAssign", "tests.IntFloatSignTests.testCompoundAssign: a wrapped Int stays -1.0 through a Float compound assignment", || {
        test_core::TestCore::test_core_equals_float(-0.5f32, IntFloatSignOps::int_float_sign_ops_compound_sum(3, 4), UStr::new(&[]));
        test_core::TestCore::test_core_equals_float(1.5f32, IntFloatSignOps::int_float_sign_ops_compound_sum(4, 3), UStr::new(&[]));
    });
}

#[test]
fn test_array_elem() {
    testlib::run("tests.IntFloatSignTests.testArrayElem", "tests.IntFloatSignTests.testArrayElem: a wrapped Int stays -1.0 through an array-literal Float element", || {
        test_core::TestCore::test_core_equals_float(-1.0f32, IntFloatSignOps::int_float_sign_ops_first_elem(3, 4), UStr::new(&[]));
        test_core::TestCore::test_core_equals_float(1.0f32, IntFloatSignOps::int_float_sign_ops_first_elem(4, 3), UStr::new(&[]));
    });
}

#[test]
fn test_optional_return() {
    testlib::run("tests.IntFloatSignTests.testOptionalReturn", "tests.IntFloatSignTests.testOptionalReturn: a wrapped Int stays -1.0 through an Option<Float> return boundary", || {
        let v = IntFloatSignOps::int_float_sign_ops_as_optional(3, 4);
        test_core::TestCore::test_core_equals_bool(true, v.is_some(), UStr::new(&[]));
        match &(v) {
            Some(__option) => {
                test_core::TestCore::test_core_equals_float(-1.0f32, *__option, UStr::new(&[]));
            }
            None => {
            }
        }
    });
}

#[test]
fn test_ternary_fallback() {
    testlib::run("tests.IntFloatSignTests.testTernaryFallback", "tests.IntFloatSignTests.testTernaryFallback: a wrapped Int stays -1.0 through a guarded ternary fallback", || {
        let m: SortedMapTable<u32, f32> = IntFloatSignOps::int_float_sign_ops_sample_map();
        test_core::TestCore::test_core_equals_float(-1.0f32, IntFloatSignOps::int_float_sign_ops_ternary_fallback((m).clone(), 3, 4), UStr::new(&[]));
        test_core::TestCore::test_core_equals_float(1.0f32, IntFloatSignOps::int_float_sign_ops_ternary_fallback((m).clone(), 4, 3), UStr::new(&[]));
        test_core::TestCore::test_core_equals_float(0.0f32, IntFloatSignOps::int_float_sign_ops_ternary_fallback((m).clone(), 9, 9), UStr::new(&[]));
    });
}
