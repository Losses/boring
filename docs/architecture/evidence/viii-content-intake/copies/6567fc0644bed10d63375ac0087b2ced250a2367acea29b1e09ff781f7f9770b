package boring

object ValuePassingOps {
    fun readTwoFields(card: ValueCard): String {
        val first = card.title
        val second = card.title
        return first + "|" + second
    }

    fun passTwice(card: ValueCard): Int {
        val a = ValuePassingOps.tagCount(card)
        val b = ValuePassingOps.tagCount(card)
        return a + b
    }

    private fun tagCount(card: ValueCard): Int {
        return card.tags.size
    }

    fun forwardParameter(tags: MutableList<String>): Int {
        return ValuePassingOps.countAll(tags)
    }

    private fun countAll(tags: MutableList<String>): Int {
        var total = 0
        for (i in 0 until tags.size) {
            total = total + tags[i].length
        }
        return total
    }

    fun pushThrough(tags: MutableList<String>): String {
        ValuePassingOps.appendOne(tags)
        return tags[tags.size - 1]
    }

    private fun appendOne(tags: MutableList<String>) {
        tags.add("added")
    }

    fun lengthArithmetic(text: String): Int {
        val n = text.length
        return n * 2 + 1
    }

    fun buildCard(): ValueCard {
        val inner = InnerNote(label = "note", weight = 2)
        return ValueCard(title = "card", tags = mutableListOf<String>("alpha", "beta"), note = inner)
    }
}

data class InnerNote(
    var label: String,
    var weight: Int
)

fun compare(a: InnerNote, b: InnerNote): Int {
    if (a === b) return 0
    var cmp = 0
    cmp = a.label.compareTo(b.label)
    if (cmp != 0) return cmp
    cmp = a.weight.compareTo(b.weight)
    if (cmp != 0) return cmp
    return 0
}

data class ValueCard(
    var title: String,
    var tags: MutableList<String>,
    var note: InnerNote
)
