#[derive(Clone, PartialEq)]
pub struct DeferredLocalsOps {
}

impl DeferredLocalsOps {
    pub const fn new() -> Self {
        Self {
        }
    }

    pub fn deferred_locals_ops_tier_of(value: u32) -> u32 {
        let tier: u32;
        if i32::from_ne_bytes(((value) as i32).to_ne_bytes()) > (2) {
            tier = 2u32;
        } else {
            tier = value;
        }
        return tier;
    }

    pub fn deferred_locals_ops_nullable_value(value: Option<u32>) -> u32 {
        let result: u32;
        match &(value) {
            Some(__option) => {
                result = *__option;
            }
            None => {
                result = 0u32;
            }
        }
        return result;
    }

    pub fn deferred_locals_ops_loop_value(count: u32) -> u32 {
        let mut result = 0u32;
        let mut i = 0u32;
        while (i32::from_ne_bytes(((i) as i32).to_ne_bytes())) < (i32::from_ne_bytes(((count) as i32).to_ne_bytes())) {
            result = i;
            i = u32::wrapping_add(i, 1);
        }
        return result;
    }
}
