package mx;
import std.ReadOnlyArray;
import mx.MXSupport.QSource;
// Attack J: inline helper block as a RETURN-position SWITCH arm value.
class AttJ {
	inline static function two(a:Array<Int>):Array<Int> {
		final s = a.length;
		return a.slice(s, 0);
	}
	public static function run(flag:Bool):ReadOnlyArray<Int> {
		final h = [1, 2, 3];
		return switch (flag) {
			case true: two(h);
			case false: QSource.second();
		}
	}
}
