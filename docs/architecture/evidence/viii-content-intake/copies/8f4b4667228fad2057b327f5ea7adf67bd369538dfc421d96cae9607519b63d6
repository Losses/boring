#!/usr/bin/env bash
# EXACT chain-A invocation for the fixed rerun.  Run inside the nix develop shell
# with cwd = boring-wt-architecture (the flake source), as in the previous rerun.
#
# Reused recipe (dc-warn/out/p09-chainA-rerun/run-rerun.sh) with three documented
# additions, each justified in evidence/preflight-in-shell.txt and REPORT.md:
#   * HAXELIB_PATH -> $OPTION_C_ROOT/.haxelib  (the flake shellHook sets it to $PWD/.haxelib,
#     i.e. the LIVE coordination tree; without the override the driver would compile the
#     coordination tree instead of the manifest-anchored root under test)
#   * EXCLUSIVE_ATTEMPT_DIR -> uniquely named attempt directory
#   * a fresh SWIFT_SHIM_STATE directory
set -u
WS=/home/losses/Development/tq-workspace
OUT=$WS/dc-warn/out/chainA-fixed-rerun
ROOT=$WS/p09-chainA-work/execution-option-c-chainA-fixed3
RUNNER=$WS/boring-wt-architecture/out/integration-a3-evidence/exclusive-runner
PLAN=$WS/p09-chainA-work/plan/option-c.plan

export OPTION_C_ROOT="$ROOT"
export SOURCE_MANIFEST="$OUT/manifest-fixed2.json"
export EXCLUSIVE_RUNNER_DIR="$RUNNER"
export GIT_CEILING_DIRECTORIES="$OPTION_C_ROOT"
export XDG_CACHE_HOME="$OPTION_C_ROOT/out/xdg-cache"
export HAXELIB_PATH="$OPTION_C_ROOT/.haxelib"
export EXPECTED_MANIFEST_ENTRIES=1433
export BORING_SWIFT_SYSTEM_PACKAGE=/nix/store/0svbxvdamgqh4jdlnp48yvyn4v6cvfpk-boring-swift-system-1.6.6
export SWIFT_SHIM_STATE="$WS/p09-chainA-work/swift-shim-state-fixed3"
export PATH="$WS/p09-chainA-work/swift-shim-bin:$PATH"
export EXCLUSIVE_ATTEMPT_DIR="$OPTION_C_ROOT/out/integration-a3-evidence/exclusive-runner/attempt-chainA-fixed3-$(date -u +%Y%m%dT%H%M%S)-$$"

mkdir -p "$XDG_CACHE_HOME" || exit 90
touch "$XDG_CACHE_HOME/.probe" && rm "$XDG_CACHE_HOME/.probe" || exit 90
mkdir -p "$SWIFT_SHIM_STATE" || exit 90

{
echo "utc_start=$(date -uIs)"
echo "invoker_argv: bash $RUNNER/run-exclusive.sh $OPTION_C_ROOT $PLAN"
echo "invoker_cwd=$PWD"
echo "OPTION_C_ROOT=$OPTION_C_ROOT"
echo "SOURCE_MANIFEST=$SOURCE_MANIFEST"
echo "source_manifest_sha256=$(sha256sum "$SOURCE_MANIFEST" | cut -d' ' -f1)"
echo "EXCLUSIVE_RUNNER_DIR=$EXCLUSIVE_RUNNER_DIR"
echo "GIT_CEILING_DIRECTORIES=$GIT_CEILING_DIRECTORIES"
echo "XDG_CACHE_HOME=$XDG_CACHE_HOME"
echo "HAXELIB_PATH=$HAXELIB_PATH"
echo "EXPECTED_MANIFEST_ENTRIES=$EXPECTED_MANIFEST_ENTRIES"
echo "BORING_SWIFT_SYSTEM_PACKAGE=$BORING_SWIFT_SYSTEM_PACKAGE"
echo "SWIFT_SHIM_STATE=$SWIFT_SHIM_STATE"
echo "EXCLUSIVE_ATTEMPT_DIR=$EXCLUSIVE_ATTEMPT_DIR"
echo "BORING_SWIFT_LIBDISPATCH=${BORING_SWIFT_LIBDISPATCH:-<unset>}"
echo "BORING_SWIFT_DYNAMIC_LINKER=${BORING_SWIFT_DYNAMIC_LINKER:-<unset>}"
echo "PATH=$PATH"
} > "$OUT/evidence/env.json" 2>&1

echo "START $(date -uIs)"
bash "$RUNNER/run-exclusive.sh" "$OPTION_C_ROOT" "$PLAN"
rc=$?
echo "$rc" > "$OUT/evidence/runner.rc"
echo "RUNNER_RC=$rc $(date -uIs)"
cat "$OPTION_C_ROOT/out/integration-a3-evidence/exclusive-runner/.latest-run" \
    > "$OUT/evidence/attempt-dir.txt"
echo "attempt_dir=$(cat "$OUT/evidence/attempt-dir.txt")"
bash "$RUNNER/check-log-integrity.sh" "$EXCLUSIVE_ATTEMPT_DIR" 2>&1 | tee "$OUT/evidence/integrity.txt"
echo "${PIPESTATUS[0]}" > "$OUT/evidence/integrity.rc"
echo "INTEGRITY_RC=$(cat "$OUT/evidence/integrity.rc") $(date -uIs)"
echo "END $(date -uIs)"
