#!/bin/bash
cd /home/losses/Development/tq-workspace/boring-wt-architecture
EV=/home/losses/Development/tq-workspace/dc-warn/out/verify-timeouts/evidence
export PATH="$(grep -m1 '^PATH=' /home/losses/Development/tq-workspace/dc-warn/out/chainA-fixed-rerun/evidence/env.json | cut -d= -f2-)"
guard() { grep -c 'Test.equals' samples/boring/MathNaNTestSupport.hx; }
run() { # name file
  local n=$1 f=$2
  echo "pre-guard=$(guard) start=$(date -u +%FT%TZ)" > $EV/V-$n.rc
  bun test "$f" > $EV/V-$n.log 2>&1
  local rc=$?
  echo "rc=$rc post-guard=$(guard) end=$(date -u +%FT%TZ)" >> $EV/V-$n.rc
  if [ "$(guard)" = "0" ]; then git checkout HEAD -- samples/boring/MathNaNTestSupport.hx; echo RESTORED >> $EV/V-$n.rc; fi
}
run extern-bindings tests/ts/extern-bindings.test.ts
run static-state    tests/ts/static-state.test.ts
run sealed-variants tests/ts/sealed-variants.test.ts
run std-string      tests/ts/std-string.test.ts
run pkg-artifacts   tests/ts/package-artifacts.test.ts
run swift-readonly  tests/swift-readonly-boundary/readonly-boundary.test.ts
run ctrl-bundle     tests/bundle-child-evidence/bundle-child-evidence.test.ts
run ctrl-vector     tests/ts/vector.test.ts
echo ALLDONE $(date -u +%FT%TZ)
