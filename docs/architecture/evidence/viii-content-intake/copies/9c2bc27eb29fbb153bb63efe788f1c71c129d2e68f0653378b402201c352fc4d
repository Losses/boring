#!/usr/bin/env bash
# cc.sh <tree-tag> <name> -- swiftc -c (SILGen) over the generated tree
set -u
export PATH="$(grep -m1 '^PATH=' /home/losses/Development/tq-workspace/dc-warn/out/chainA-fixed-rerun/evidence/env.json | cut -d= -f2-)"
TAG="$1"; NAME="$2"
GEN="/tmp/vc8/out/$TAG-$NAME/gen"
OBJ="/tmp/vc8/obj/$TAG-$NAME"
if [ ! -d "$GEN" ]; then echo "no gen dir $GEN" >&2; exit 2; fi
mkdir -p "$OBJ"; rm -f "$OBJ"/*.o
FILES=$(find "$GEN" -name '*.swift' ! -name 'Package.swift' | sort)
LOG="/tmp/vc8/logs/cc-$TAG-$NAME.log"
( cd "$OBJ" && swiftc -c $FILES ) > "$LOG" 2>&1
rc=$?
echo "$rc" > "$LOG.rc"
echo "cc $TAG/$NAME rc=$rc ($(grep -c 'error:' "$LOG") errors) -> $LOG"
