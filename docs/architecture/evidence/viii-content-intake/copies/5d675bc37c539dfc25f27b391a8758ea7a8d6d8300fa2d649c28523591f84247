use crate::boring::float_width::FloatWidth;
use crate::runtime::u_string::UStr;
use crate::runtime::u_string::UString;
use std::fmt::Write;


#[derive(Clone, Copy)]
pub struct StdStringOps;

impl StdStringOps {
    pub fn std_string_ops_concat_string(value: &UStr) -> UString {
        return UString::from(format!("{}", { let mut __s = UString::new(); __s += &(UString::from("string=")); __s += UString::from(format!("{}", value.to_string()).as_str()).as_ustr(); __s }).as_str());
    }

    pub fn std_string_ops_concat_int(value: u32) -> UString {
        return UString::from(format!("{}", { let mut __s = UString::new(); __s += &(UString::from("int=")); __s += UString::from((value).to_string().as_str()).as_ustr(); __s }).as_str());
    }

    pub fn std_string_ops_concat_float(value: f32) -> UString {
        return UString::from(format!("{}", { let mut __s = UString::new(); __s += &(UString::from("float=")); __s += UString::from(format!("{}", crate::runtime::fp_helper::FPHelper::format_float_f32(value)).as_str()).as_ustr(); __s }).as_str());
    }

    pub fn std_string_ops_concat_bool(value: bool) -> UString {
        return UString::from(format!("{}", { let mut __s = UString::new(); __s += &(UString::from("bool=")); __s += UString::from((value).to_string().as_str()).as_ustr(); __s }).as_str());
    }

    pub fn std_string_ops_concat_enum(value: FloatWidth) -> UString {
        return UString::from(format!("{}", { let mut __s = UString::new(); __s += &(UString::from("enum=")); __s += UString::from(value.name()).as_ustr(); __s }).as_str());
    }

    pub fn std_string_ops_string_value(value: &UStr) -> UString {
        return UString::from(format!("{}", value.to_string()).as_str());
    }

    pub fn std_string_ops_int_value(value: u32) -> UString {
        return UString::from((value).to_string().as_str());
    }

    pub fn std_string_ops_float_value(value: f32) -> UString {
        return UString::from(format!("{}", crate::runtime::fp_helper::FPHelper::format_float_f32(value)).as_str());
    }

    pub fn std_string_ops_float_forms() -> Vec<UString> {
        return vec![
    crate::runtime::fp_helper::FPHelper::format_float_f32(2.0f32).clone(),
    crate::runtime::fp_helper::FPHelper::format_float_f32(0.0f32).clone(),
    crate::runtime::fp_helper::FPHelper::format_float_f32(-0.0f32).clone(),
    crate::runtime::fp_helper::FPHelper::format_float_f32(2.5f32).clone(),
    crate::runtime::fp_helper::FPHelper::format_float_f32(-1.25f32).clone(),
    crate::runtime::fp_helper::FPHelper::format_float_f32(1e20f32).clone(),
    crate::runtime::fp_helper::FPHelper::format_float_f32(1e21f32).clone(),
    crate::runtime::fp_helper::FPHelper::format_float_f32(1e-6f32).clone(),
    crate::runtime::fp_helper::FPHelper::format_float_f32(1e-7f32).clone(),
];
    }

    pub fn std_string_ops_bool_value(value: bool) -> UString {
        return UString::from((value).to_string().as_str());
    }

    pub fn std_string_ops_enum_value(value: FloatWidth) -> UString {
        return UString::from(value.name());
    }

    pub fn std_string_ops_enum_matches_constructor() -> bool {
        return UString::from(FloatWidth::F32.name()) == UString::from("F32");
    }

    pub fn std_string_ops_int_array() -> UString {
        let values = vec![1, 2, 3];
        return UString::from(format!("{}", {
        let mut out = String::new();
        out.push('[');
        let n = values.len();
        let mut i = 0usize;
        while i < n {
            if i > 0 { out.push_str(", "); }
            let _ = write!(out, "{}", i32::from_ne_bytes(((values[i]) as i32).to_ne_bytes()));
            i += 1;
        }
        out.push(']');
        out
    }).as_str());
    }

    pub fn std_string_ops_string_array() -> UString {
        let values = vec![UString::from("alpha").to_ustring(), UString::from("beta").to_ustring()];
        return UString::from(format!("{}", {
        let mut out = String::new();
        out.push('[');
        let n = values.len();
        let mut i = 0usize;
        while i < n {
            if i > 0 { out.push_str(", "); }
            let _ = write!(out, "{}", values[i]);
            i += 1;
        }
        out.push(']');
        out
    }).as_str());
    }

    pub fn std_string_ops_float_array() -> UString {
        let values = vec![1.5f32, 2.25f32];
        return UString::from(format!("{}", {
        let mut out = String::new();
        out.push('[');
        let n = values.len();
        let mut i = 0usize;
        while i < n {
            if i > 0 { out.push_str(", "); }
            let _ = write!(out, "{}", values[i]);
            i += 1;
        }
        out.push(']');
        out
    }).as_str());
    }

    pub fn std_string_ops_bool_array() -> UString {
        let values = vec![true, false];
