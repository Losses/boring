    pub fn std_string_ops_enum_array() -> UString {
        let values = vec![FloatWidth::F64, FloatWidth::F16];
        return UString::from(format!("{}", {
        let mut out = String::new();
        out.push('[');
        let n = values.len();
        let mut i = 0usize;
        while i < n {
            if i > 0 { out.push_str(", "); }
            let _ = write!(out, "{}", values[i].name());
            i += 1;
        }
        out.push(']');
        out
    }).as_str());
    }

    pub fn std_string_ops_empty_array() -> UString {
        return StdStringOps::std_string_ops_empty_array_value(&vec![]);
    }

    pub(crate) fn std_string_ops_empty_array_value(values: &Vec<u32>) -> UString {
        return UString::from(format!("{}", {
        let mut out = String::new();
        out.push('[');
        let n = values.len();
        let mut i = 0usize;
        while i < n {
            if i > 0 { out.push_str(", "); }
            let _ = write!(out, "{}", i32::from_ne_bytes(((values[i]) as i32).to_ne_bytes()));
            i += 1;
        }
        out.push(']');
        out
    }).as_str());
    }

    pub fn std_string_ops_nested_array() -> UString {
        let values = vec![(vec![1, 2]).clone(), (vec![3]).clone()];
        return UString::from(format!("{}", {
        let mut out = String::new();
        out.push('[');
        let n = values.len();
        let mut i = 0usize;
        while i < n {
            if i > 0 { out.push_str(", "); }
            let _ = write!(out, "{}", {
        let mut out = String::new();
        out.push('[');
        let n = values[i].len();
        let mut i1 = 0usize;
        while i1 < n {
            if i1 > 0 { out.push_str(", "); }
            let _ = write!(out, "{}", i32::from_ne_bytes(((values[i][i1]) as i32).to_ne_bytes()));
            i1 += 1;
        }
        out.push(']');
        out
    });
            i += 1;
        }
        out.push(']');
        out
    }).as_str());
    }

    pub fn std_string_ops_read_only_array() -> UString {
        let values = vec![UString::from("alpha").to_ustring(), UString::from("beta").to_ustring()];
        return UString::from(format!("{}", {
        let mut out = String::new();
        out.push('[');
        let n = values.len();
        let mut i = 0usize;
        while i < n {
            if i > 0 { out.push_str(", "); }
            let _ = write!(out, "{}", values[i]);
            i += 1;
        }
        out.push(']');
        out
    }).as_str());
    }
}
