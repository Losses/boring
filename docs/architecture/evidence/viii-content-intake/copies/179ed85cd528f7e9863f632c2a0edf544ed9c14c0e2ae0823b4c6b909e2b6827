#!/usr/bin/env bash
set -u
E=/tmp/swiftarr/execroot
cd "$E"
export BORING_TEST_RESULTS_DIR=$E/out/test-results
run() { # run <label> <targets>
  echo "===== $1 : --targets=$2"
  node out/test-consistency/manager.js --targets="$2" --baseline=kotlin >/tmp/swiftarr/ev/$1.out 2>/tmp/swiftarr/ev/$1.err
  echo "RC=$?"
  echo "--- divergences:"; grep -cE '^  \* ' /tmp/swiftarr/ev/$1.err || true
  head -5 /tmp/swiftarr/ev/$1.err
}
run A_nonswift_nof32 "haxe,ts,kotlin,dart,rust"
run B_noswift_incl_f32 "haxe,ts,kotlin,dart,rust,haxe-f32,kotlin-f32,rust-f32"
run C_all "haxe,ts,kotlin,dart,rust,swift,haxe-f32,kotlin-f32,rust-f32,swift-f32"
