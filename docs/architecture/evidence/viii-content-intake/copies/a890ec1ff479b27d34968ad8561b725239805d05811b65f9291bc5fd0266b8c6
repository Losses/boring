#![cfg(test)]

use crate::boring::borrowed_string_return_ops::BorrowedStringReturnOps;
use crate::runtime::test as testlib;
use crate::runtime::test_core;
use crate::runtime::u_string::UStr;


#[test]
fn require_text() {
    testlib::run("tests.BorrowedStringReturnTests.requireText", "tests.BorrowedStringReturnTests.requireText: a borrowed String parameter returns through an owned abstract String", || {
        let id = BorrowedStringReturnOps::borrowed_string_return_ops_require_text(UStr::new(&[111,107])).unwrap();
        test_core::TestCore::test_core_equals_string(UStr::new(&[111,107]), id.as_ustr(), UStr::new(&[]));
    });
}
