        Self {
            words,
        }
    }

    pub fn to_string(&self) -> UString {
        return UString::from(format!("{}", { let mut __s = UString::new(); __s += &(UString::from("PrintedNullableCollection(")); __s += &(UString::from("words=")); __s += UString::from(format!("{}", (match &(self.words) { None => UString::from("null"), Some(__option) => UString::from(format!("{}", {
        let mut out = String::new();
        out.push('[');
        let n = (*__option).clone().len();
        let mut i1 = 0usize;
        while i1 < n {
            if i1 > 0 { out.push_str(", "); }
            let _ = write!(out, "{}", (*__option).clone()[i1]);
            i1 += 1;
        }
        out.push(']');
        out
    }).as_str()) })).as_str()).as_ustr(); __s += &(UString::from(")")); __s }).as_str());
    }
}

pub fn compare_printed_nullable_collection(a: &PrintedNullableCollection, b: &PrintedNullableCollection) -> i32 {
    let cmp_words = match (&a.words, &b.words) { (None, None) => 0, (None, Some(_)) => -1, (Some(_), None) => 1,
(Some(av), Some(bv)) => { let mut cmp = 0; for (av, bv) in (av).iter().zip((bv).iter()) { cmp = SortedTable::sorted_table_compare_strings((av).as_ustr(), (bv).as_ustr()); if cmp != 0 { break; } } if cmp == 0 { cmp = match (av).len().cmp(&(bv).len()) { core::cmp::Ordering::Less => -1, core::cmp::Ordering::Equal => 0, core::cmp::Ordering::Greater => 1 }; } cmp } };
    if cmp_words != 0 { return cmp_words; }
    0
}

#[derive(Debug, Clone, PartialEq)]
pub enum PrintedFlag {
    Silent,
    Steps { count: u32 },
}

impl PrintedFlag {
    pub fn to_string(&self) -> String {
        match self {
            PrintedFlag::Silent => "Silent".to_string(),
            PrintedFlag::Steps { count } => format!("Steps(count={})", (count).to_string()),
        }
    }
}
