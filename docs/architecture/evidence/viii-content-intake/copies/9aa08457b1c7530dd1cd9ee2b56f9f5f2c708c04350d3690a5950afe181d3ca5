}

impl PrintedEnumCollection {
    pub fn new(flags: Vec<PrintedFlag>) -> Self {
        Self {
            flags,
        }
    }

    pub fn to_string(&self) -> UString {
        return UString::from(format!("{}", { let mut __s = UString::new(); __s += &(UString::from("PrintedEnumCollection(")); __s += &(UString::from("flags=")); __s += UString::from(format!("{}", {
        let mut out = String::new();
        out.push('[');
        let n = (self.flags).clone().len();
        let mut i = 0usize;
        while i < n {
            if i > 0 { out.push_str(", "); }
            let _ = write!(out, "{}", (self.flags).clone()[i].to_string());
            i += 1;
        }
        out.push(']');
        out
    }).as_str()).as_ustr(); __s += &(UString::from(")")); __s }).as_str());
    }
}

fn printed_enum_collection_order_0(v: &PrintedFlag) -> i32 {
    match v {
        PrintedFlag::Silent => 0,
        PrintedFlag::Steps { .. } => 1,
    }
}

pub fn compare_printed_enum_collection(a: &PrintedEnumCollection, b: &PrintedEnumCollection) -> i32 {
    let cmp_flags = { let mut cmp = 0; for (av, bv) in (&a.flags).iter().zip((&b.flags).iter()) { cmp = match printed_enum_collection_order_0(av).cmp(&printed_enum_collection_order_0(bv)) { core::cmp::Ordering::Less => -1, core::cmp::Ordering::Equal => 0,
core::cmp::Ordering::Greater => 1 }; if cmp != 0 { break; } } if cmp == 0 { cmp = match (&a.flags).len().cmp(&(&b.flags).len()) { core::cmp::Ordering::Less => -1, core::cmp::Ordering::Equal => 0, core::cmp::Ordering::Greater => 1 }; } cmp };
    if cmp_flags != 0 { return cmp_flags; }
    0
}

#[derive(Debug, Clone, PartialEq)]
pub struct PrintedPoint {
    pub x: u32,
    pub y: u32,
}

impl PrintedPoint {
    pub fn new(x: u32, y: u32) -> Self {
        Self {
            x,
            y,
        }
    }

    pub fn to_string(&self) -> UString {
        return UString::from(format!("{}", { let mut __s = UString::new(); __s += &(UString::from("PrintedPoint(")); __s += &(UString::from("x=")); __s += &(UString::from((self.x).to_string().as_str())); __s += &(UString::from(", ")); __s += &(UString::from("y=")); __s += &(UString::from((self.y).to_string().as_str())); __s += &(UString::from(")")); __s }).as_str());
    }
}

pub fn compare_printed_point(a: &PrintedPoint, b: &PrintedPoint) -> i32 {
    let cmp_x = match i32::from_ne_bytes((*(&a.x)).to_ne_bytes()).cmp(&i32::from_ne_bytes((*(&b.x)).to_ne_bytes())) { core::cmp::Ordering::Less => -1, core::cmp::Ordering::Equal => 0, core::cmp::Ordering::Greater => 1 };
    if cmp_x != 0 { return cmp_x; }
    let cmp_y = match i32::from_ne_bytes((*(&a.y)).to_ne_bytes()).cmp(&i32::from_ne_bytes((*(&b.y)).to_ne_bytes())) { core::cmp::Ordering::Less => -1, core::cmp::Ordering::Equal => 0, core::cmp::Ordering::Greater => 1 };
    if cmp_y != 0 { return cmp_y; }
    0
}

