#![cfg(test)]

use crate::boring::u_string_ops::UStringOps;
use crate::runtime::test as testlib;
use crate::runtime::test_core;
use crate::runtime::u_string;
use crate::runtime::u_string::UStr;
use crate::tests::test_helper::*;


#[test]
fn test_ascii_tier() {
    testlib::run("tests.UStringTests.testAsciiTier", "tests.UStringTests.testAsciiTier: ascii content counts and reads through the general tier", || {
        test_core::TestCore::test_core_equals_int(6i32, i32::from_ne_bytes(((UStringOps::u_string_ops_ascii_count()) as i32).to_ne_bytes()), UStr::new(&[]));
        assert_equals_opt(&Some(116), &UStringOps::u_string_ops_code_at(UStr::new(&[116,105,113,105,97,110]), 0), UStr::new(&[]));
        assert_equals_opt(&None::<u32>, &UStringOps::u_string_ops_code_at(UStr::new(&[116,105,113,105,97,110]), 6), UStr::new(&[]));
    });
}

#[test]
fn test_bmp_tier() {
    testlib::run("tests.UStringTests.testBmpTier", "tests.UStringTests.testBmpTier: bmp cjk counts and reads by code point", || {
        test_core::TestCore::test_core_equals_int(4i32, i32::from_ne_bytes(((UStringOps::u_string_ops_bmp_count()) as i32).to_ne_bytes()), UStr::new(&[]));
        assert_equals_opt(&Some(25552), &UStringOps::u_string_ops_code_at(UStr::new(&[25552,26912,25490,29256]), 0), UStr::new(&[]));
        assert_equals_opt(&Some(26912), &UStringOps::u_string_ops_code_at(UStr::new(&[25552,26912,25490,29256]), 1), UStr::new(&[]));
        assert_equals_opt(&Some(29256), &UStringOps::u_string_ops_code_at(UStr::new(&[25552,26912,25490,29256]), 3), UStr::new(&[]));
        assert_equals_opt(&None::<u32>, &UStringOps::u_string_ops_code_at(UStr::new(&[25552,26912,25490,29256]), 4), UStr::new(&[]));
    });
}

#[test]
fn test_supplementary_tier() {
    testlib::run("tests.UStringTests.testSupplementaryTier", "tests.UStringTests.testSupplementaryTier: supplementary cjk occupies one character index", || {
        test_core::TestCore::test_core_equals_int(3i32, i32::from_ne_bytes(((UStringOps::u_string_ops_supplementary_count()) as i32).to_ne_bytes()), UStr::new(&[]));
        assert_equals_opt(&Some(131072), &UStringOps::u_string_ops_code_at(UStr::new(&[55360,56320,19968,55360,56321]), 0), UStr::new(&[]));
        assert_equals_opt(&Some(19968), &UStringOps::u_string_ops_code_at(UStr::new(&[55360,56320,19968,55360,56321]), 1), UStr::new(&[]));
        assert_equals_opt(&Some(131073), &UStringOps::u_string_ops_code_at(UStr::new(&[55360,56320,19968,55360,56321]), 2), UStr::new(&[]));
        assert_equals_opt(&None::<u32>, &UStringOps::u_string_ops_code_at(UStr::new(&[55360,56320,19968,55360,56321]), 3), UStr::new(&[]));
    });
}

#[test]
fn test_slice() {
    testlib::run("tests.UStringTests.testSlice", "tests.UStringTests.testSlice: slice addresses characters on every storage", || {
        test_core::TestCore::test_core_equals_string(UStr::new(&[26912,25490]), UStringOps::u_string_ops_middle_slice(UStr::new(&[25552,26912,25490,29256])).as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[19968,55360,56321]), UStringOps::u_string_ops_middle_slice(UStr::new(&[55360,56320,19968,55360,56321])).as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[25552,26912,25490,29256]), UStringOps::u_string_ops_clamped_slice(UStr::new(&[25552,26912,25490,29256])).as_ustr(), UStr::new(&[]));
    });
}

#[test]
fn test_round_trip() {
    testlib::run("tests.UStringTests.testRoundTrip", "tests.UStringTests.testRoundTrip: code point round trip preserves content", || {
        test_core::TestCore::test_core_equals_string(UStr::new(&[25552,26912,25490,29256]), UStringOps::u_string_ops_round_trip(UStr::new(&[25552,26912,25490,29256])).unwrap().as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[55360,56320,19968,55360,56321]), UStringOps::u_string_ops_round_trip(UStr::new(&[55360,56320,19968,55360,56321])).unwrap().as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[55360,56320]), u_string::from_code_point(131072).as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[19968]), u_string::from_code_point(19968).as_ustr(), UStr::new(&[]));
    });
}

#[test]
fn test_reversal() {
    testlib::run("tests.UStringTests.testReversal", "tests.UStringTests.testReversal: character reversal keeps supplementary characters whole", || {
        test_core::TestCore::test_core_equals_string(UStr::new(&[29256,25490,26912,25552]), UStringOps::u_string_ops_reversed_text(UStr::new(&[25552,26912,25490,29256])).unwrap().as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[55360,56321,19968,55360,56320]), UStringOps::u_string_ops_reversed_text(UStr::new(&[55360,56320,19968,55360,56321])).unwrap().as_ustr(), UStr::new(&[]));
    });
}

#[test]
fn test_substring() {
    testlib::run("tests.UStringTests.testSubstring", "tests.UStringTests.testSubstring: substring addresses utf-16 unit positions on every target", || {
        test_core::TestCore::test_core_equals_string(UStr::new(&[26912,25490]), UStringOps::u_string_ops_substring_range(UStr::new(&[25552,26912,25490,29256]), 1, 3).as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[55360,56320]), UStringOps::u_string_ops_substring_range(UStr::new(&[55360,56320,19968,55360,56321]), 0, 2).as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[19968]), UStringOps::u_string_ops_substring_range(UStr::new(&[55360,56320,19968,55360,56321]), 2, 3).as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[19968,55360,56321]), UStringOps::u_string_ops_substring_range(UStr::new(&[55360,56320,19968,55360,56321]), 2, 5).as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[55360,56321]), UStringOps::u_string_ops_substring_from(UStr::new(&[55360,56320,19968,55360,56321]), 3).as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[105,113]), UStringOps::u_string_ops_substring_literal().as_ustr(), UStr::new(&[]));
    });
}

#[test]
fn test_substring_bounds() {
    testlib::run("tests.UStringTests.testSubstringBounds", "tests.UStringTests.testSubstringBounds: substring clamps negative, long, reversed, and omitted bounds", || {
        test_core::TestCore::test_core_equals_string(UStr::new(&[97,98,99]), UStringOps::u_string_ops_substring_negative_start().as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[99,100,101,102]), UStringOps::u_string_ops_substring_long_end().as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[99,100,101]), UStringOps::u_string_ops_substring_swapped_bounds().as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[97,98,99,100,101,102]), UStringOps::u_string_ops_substring_omitted_end().as_ustr(), UStr::new(&[]));
    });
}
