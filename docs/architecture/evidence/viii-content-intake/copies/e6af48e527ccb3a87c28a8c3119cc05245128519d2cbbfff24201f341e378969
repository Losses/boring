#!/usr/bin/env bash
# run.sh <treetag> -- build + run the witness fixture (mx.MXLambda) executable.
set -u
export PATH="$(grep -m1 '^PATH=' /home/losses/Development/tq-workspace/dc-warn/out/chainA-fixed-rerun/evidence/env.json | cut -d= -f2-)"
OUT=/home/losses/Development/tq-workspace/dc-warn/out/blockexpr-fix
TAG="$1"
GENS="/tmp/bx/out/$TAG-witness/gen"
RUN="/tmp/bx/run/$TAG-witness"
if [ ! -d "$GENS" ]; then echo "no gen dir $GENS" >&2; exit 2; fi
rm -rf "$RUN"; mkdir -p "$RUN"
cp -r "$GENS"/. "$RUN"/
cp "$OUT/fixtures/main.swift" "$RUN/main.swift"
( cd "$RUN" && swiftc -o mxdemo mx/MXLambda.swift Runtime.swift std/UStringException.swift std/UStringFault.swift main.swift ) > "$OUT/evidence/logs/build-$TAG-witness.log" 2>&1
brc=$?
echo "$brc" > "$OUT/evidence/logs/build-$TAG-witness.rc"
if [ "$brc" -ne 0 ]; then echo "build $TAG/witness rc=$brc (FAILED)"; exit 0; fi
( cd "$RUN" && ./mxdemo ) > "$OUT/evidence/logs/run-$TAG-witness.log" 2>&1
rrc=$?
echo "$rrc" > "$OUT/evidence/logs/run-$TAG-witness.rc"
echo "run $TAG/witness build_rc=$brc run_rc=$rrc"
exit 0
