        assert_equals_opt(&None::<u32>, &ResidentModuleImportOps::resident_module_import_ops_map_lookup(), UStr::new(&[114,101,115,105,100,101,110,116,32,115,116,97,121,115,32,111,102,102,32,116,104,101,32,109,111,100,117,108,101,32,112,97,116,104,32,111,117,116,115,105,100,101,32,116,115]));
    });
}
