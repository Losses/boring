use crate::boring::fp32::Fp32;
use crate::runtime::u_string;
use crate::runtime::u_string::UStr;
use crate::runtime::u_string::UString;
use crate::std::u_string_exception::UStringFault;


#[derive(Clone, Copy)]
pub struct RuntimeExportOps;

impl RuntimeExportOps {
    pub fn runtime_export_ops_float_to_bits(value: f32) -> u32 {
        return Fp32::fp32_to_bits(value);
    }

    pub fn runtime_export_ops_bits_to_float(bits: u32) -> f32 {
        return Fp32::fp32_from_bits(bits);
    }

    pub fn runtime_export_ops_round_trip_float(value: f32) -> f32 {
        return Fp32::fp32_from_bits(Fp32::fp32_to_bits(value));
    }

    pub fn runtime_export_ops_ascii_count() -> u32 {
        return u_string::count(UStr::new(&[116,105,113,105,97,110]));
    }

    pub fn runtime_export_ops_code_at(text: &UStr, index: u32) -> Option<u32> {
        return u_string::at(text, index);
    }

    pub fn runtime_export_ops_code_points_round_trip(text: &UStr) -> Result<UString, UStringFault> {
        let codes = u_string::to_code_points(text);
        for &code in &codes {
            if code > 2147483647 || (i32::from_ne_bytes(((code) as i32).to_ne_bytes())) > (1114111) || (i32::from_ne_bytes(((code) as i32).to_ne_bytes())) >= 55296 && (i32::from_ne_bytes(((code) as i32).to_ne_bytes())) <= 57343 {
                return Err(UStringFault::InvalidCodePoint { code: code });
            }
        }
        return Ok(u_string::from_code_points(&codes));
    }
}
