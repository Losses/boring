use crate::runtime::u_string;
use crate::runtime::u_string::UStr;
use crate::runtime::u_string::UString;
use std::sync::Arc;


#[derive(Clone, Copy)]
pub struct StaticRefStatics;

impl StaticRefStatics {
    pub fn static_ref_statics_compare_strings(a: &UStr, b: &UStr) -> u32 {
        return u32::wrapping_sub(u_string::unit_count(&(a)), u_string::unit_count(&(b)));
    }
}

#[derive(Clone, Copy)]
pub struct StaticRefOps;

impl StaticRefOps {
    pub fn static_ref_ops_render(code: u32) -> UString {
        return UString::from(format!("{}", { let mut __s = UString::new(); __s += &(UString::from("code:")); __s += &(UString::from((code).to_string().as_str())); __s }).as_str());
    }

    pub fn static_ref_ops_take_fn(callback: Arc<dyn Fn(u32) -> UString + Send + Sync>) -> UString {
        return callback(42);
    }

    pub fn static_ref_ops_pass_to_param() -> UString {
        return StaticRefOps::static_ref_ops_take_fn((Arc::new(StaticRefOps::static_ref_ops_render)).clone());
    }

    pub fn static_ref_ops_store_local() -> UString {
        let r#fn: Arc<dyn Fn(u32) -> UString + Send + Sync> = Arc::new(StaticRefOps::static_ref_ops_render);
        return r#fn(42);
    }

    pub fn static_ref_ops_return_fn() -> Arc<dyn Fn(u32) -> UString + Send + Sync + 'static> {
        return (Arc::new(StaticRefOps::static_ref_ops_render)).clone();
    }

    pub fn static_ref_ops_reassign_local() -> UString {
        let r#fn: Arc<dyn Fn(u32) -> UString + Send + Sync>;
        r#fn = Arc::new(StaticRefOps::static_ref_ops_render);
        return r#fn(42);
    }

    pub fn static_ref_ops_statics_only_value() -> u32 {
        let cmp: Arc<dyn Fn(&UStr, &UStr) -> u32 + Send + Sync> = Arc::new(StaticRefStatics::static_ref_statics_compare_strings);
        return cmp(UStr::new(&[97,98]), UStr::new(&[97]));
    }

    pub fn static_ref_ops_call_site() -> UString {
        return StaticRefOps::static_ref_ops_render(42);
    }
}
