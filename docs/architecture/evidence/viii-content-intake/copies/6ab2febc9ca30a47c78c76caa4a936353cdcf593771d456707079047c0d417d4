#!/usr/bin/env python3
"""Classify every toMutableArray occurrence in a generated Swift tree.

Categories (per PIT-255):
  DEF            declaration of the runtime method (not a call site)
  BUGGY-COPY     TiqianArray(<operand>.toMutableArray())            [CopyReadOnlyIntoMutableArray, double-wrapped]
  BUGGY-MAP      .map { TiqianArray($0.toMutableArray()) }          [MapOptionalReadOnlyIntoMutableArray, double-wrapped]
  FIXED-COPY     <operand>.toMutableArray()  (bare)                 [fixed render text]
  FIXED-MAP      .map { $0.toMutableArray() }                       [fixed render text]
"""
import os, re, sys

root = sys.argv[1]
pat = re.compile(r"toMutableArray")
buggy_map = re.compile(r"\.map\s*\{\s*TiqianArray\(\s*\$0\.toMutableArray\(\)\s*\)\s*\}")
fixed_map = re.compile(r"\.map\s*\{\s*\$0\.toMutableArray\(\)\s*\}")
buggy_copy = re.compile(r"TiqianArray\([^()]*(\(\))?[^()]*\.toMutableArray\(\)\)")
defn = re.compile(r"\bfunc\s+toMutableArray")
rows = []
for dirpath, _dirs, files in os.walk(root):
    for f in sorted(files):
        if not f.endswith(".swift"):
            continue
        p = os.path.join(dirpath, f)
        try:
            lines = open(p, encoding="utf-8", errors="replace").read().splitlines()
        except OSError:
            continue
        for i, ln in enumerate(lines, 1):
            if not pat.search(ln):
                continue
            if defn.search(ln):
                cat = "DEF"
            elif buggy_map.search(ln):
                cat = "BUGGY-MAP"
            elif fixed_map.search(ln):
                cat = "FIXED-MAP"
            elif buggy_copy.search(ln):
                cat = "BUGGY-COPY"
            elif ".toMutableArray()" in ln:
                cat = "FIXED-COPY"
            else:
                cat = "OTHER"
            rows.append((os.path.relpath(p, root), i, cat, ln.strip()))
counts = {}
for _f, _i, c, _t in rows:
    counts[c] = counts.get(c, 0) + 1
print(f"tree: {root}")
for k in sorted(counts):
    print(f"  {k:12s} {counts[k]}")
print("  --- occurrences ---")
for f, i, c, t in rows:
    print(f"  {c:12s} {f}:{i}: {t}")
