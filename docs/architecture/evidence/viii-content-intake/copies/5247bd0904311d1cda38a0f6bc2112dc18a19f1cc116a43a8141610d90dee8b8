use crate::runtime::sorted_table::SortedTable;
use crate::runtime::u_string::UStr;
use crate::runtime::u_string::UString;


#[derive(Debug, Clone, PartialEq)]
pub struct ComparatorBoolRecord {
    pub id: u32,
    pub enabled: bool,
}

impl ComparatorBoolRecord {
    pub fn new(id: u32, enabled: bool) -> Self {
        Self {
            id,
            enabled,
        }
    }

    pub fn to_string(&self) -> UString {
        return UString::from(format!("{}", { let mut __s = UString::new(); __s += &(UString::from("ComparatorBoolRecord(")); __s += &(UString::from("id=")); __s += &(UString::from((self.id).to_string().as_str())); __s += &(UString::from(", ")); __s += &(UString::from("enabled=")); __s += UString::from((self.enabled).to_string().as_str()).as_ustr(); __s += &(UString::from(")")); __s }).as_str());
    }
}

