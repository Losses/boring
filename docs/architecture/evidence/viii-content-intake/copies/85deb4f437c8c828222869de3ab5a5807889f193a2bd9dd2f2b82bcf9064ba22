use crate::runtime::u_string;
use crate::runtime::u_string::UStr;
use crate::runtime::u_string::UString;


#[derive(Clone, Copy)]
pub struct UStringResidentOps;

impl UStringResidentOps {
    pub fn u_string_resident_ops_count(text: &UStr) -> u32 {
        return u_string::count(text);
    }

    pub fn u_string_resident_ops_at(text: &UStr, index: u32) -> Option<u32> {
        return u_string::at(text, index);
    }

    pub fn u_string_resident_ops_slice(text: &UStr, from: u32, to: u32) -> UString {
        return u_string::slice(text, i32::from_ne_bytes(((from) as i32).to_ne_bytes()), i32::from_ne_bytes(((to) as i32).to_ne_bytes()));
    }

    pub fn u_string_resident_ops_from_code_point(code: u32) -> UString {
        return u_string::from_code_point(code);
    }
}
