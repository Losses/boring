package boring

object NumericConversionWidening {
    fun compareEqual(a: Double, b: Int): Boolean {
        return a == (b).toDouble()
    }

    fun compareNotEqual(a: Double, b: Int): Boolean {
        return a != (b).toDouble()
    }

    fun returnIntAsFloat(x: Int): Double {
        return (x).toDouble()
    }

    fun initFloat(): Double {
        val x = (16).toDouble()
        return x
    }

    fun assignIntToFloat(): Double {
        var x = (0).toDouble()
        x = (42).toDouble()
        return x
    }

    fun floatParam(value: Double): Double {
        return value + 1.0
    }

    fun callFloatParam(): Double {
        return NumericConversionWidening.floatParam((8).toDouble())
    }
}
