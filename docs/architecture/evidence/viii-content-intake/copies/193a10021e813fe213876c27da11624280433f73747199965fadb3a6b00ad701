package boring

import kotlin.math.pow

object MathMinMaxOps {
    fun smaller(a: Double, b: Double): Double {
        return Math.min(a, b)
    }

    fun larger(a: Double, b: Double): Double {
        return Math.max(a, b)
    }

    fun smallerOfInts(a: Int, b: Int): Double {
        return Math.min((a).toDouble(), (b).toDouble())
    }

    fun largerOfInts(a: Int, b: Int): Double {
        return Math.max((a).toDouble(), (b).toDouble())
    }

    fun absValue(a: Double): Double {
        return Math.abs(a)
    }

    fun absOfInts(a: Int): Double {
        return Math.abs((a).toDouble())
    }

    fun power(a: Double, b: Double): Double {
        return (a).pow(b)
    }

    fun powerOfInts(a: Int, b: Int): Double {
        return ((a).toDouble()).pow((b).toDouble())
    }

    fun rounded(a: Double): Int {
        return Math.round(a).toInt()
    }

    fun floored(a: Double): Int {
        return (kotlin.math.floor(a)).toInt()
    }

    fun ceiled(a: Double): Int {
        return (kotlin.math.ceil(a)).toInt()
    }
}
