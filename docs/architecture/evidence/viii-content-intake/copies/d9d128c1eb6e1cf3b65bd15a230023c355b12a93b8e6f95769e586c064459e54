// Extract the report step body VERBATIM from .github/workflows/ci.yml so the proof
// runs the committed artifact, not a scratch copy. Nothing is substituted: the real
// step reads `out/collected-suite.log` relative to the repo root, so the crafted logs
// are installed at exactly that path for each proof run.
const repo = process.argv[2];
const out = process.argv[3];
const workflow = await Bun.file(`${repo}/.github/workflows/ci.yml`).text();
const doc = Bun.YAML.parse(workflow) as any;
const steps = doc.jobs["collected-suite"].steps as Array<{ name?: string; run?: string }>;
const step = steps.find((s) => (s.name ?? "").startsWith("Report the counts"));
if (!step?.run) throw new Error("report step not found by name");
await Bun.write(`${out}/step-report-from-yaml.sh`, step.run + "\n");
console.log(`extracted report step (${step.run.length} chars) -> ${out}/step-report-from-yaml.sh`);
