#!/usr/bin/env bash
# Root-cause minimal experiments for the wrapper builtin-vs-external defect.
# Runs the PRISTINE and the FIXED wrapper directly (no $(...), no setsid,
# no run-exclusive) on identical inputs and tabulates the artifacts.
set -u
XS="/home/losses/Development/tq-workspace/out/option-c-xcheck"
FROZ="/home/losses/Development/tq-workspace/boring-wt-architecture/out/integration-a3-evidence/exclusive-runner"
EXP="$XS/experiments"
PW="$FROZ/option-c-stage-wrapper.sh"          # pristine wrapper (frozen sha d11801e5...)
FW="$XS/fixed/out/integration-a3-evidence/exclusive-runner/option-c-stage-wrapper.sh"  # fixed (c14043c0...)

rm -rf "$EXP"; mkdir -p "$EXP/root/tests/vectors"
echo lock-content >"$EXP/root/Cargo.lock"
echo bin >"$EXP/root/tests/vectors/roundtrip.bin"
echo app >"$EXP/root/app.txt"
printf '#!/bin/sh\necho tool-ran\nexit ${1:-0}\n' >"$EXP/root/tool.sh"
chmod +x "$EXP/root/tool.sh"
python3 - "$EXP" <<'PY'
import hashlib, json, os, stat, sys
base = sys.argv[1]; root = base + "/root"
entries = []
for b, d, fs in os.walk(root):
    for n in sorted(fs):
        p = os.path.join(b, n); rel = os.path.relpath(p, root)
        mode = "100755" if os.stat(p).st_mode & stat.S_IXUSR else "100644"
        entries.append({"path": rel, "sha256": hashlib.sha256(open(p,"rb").read()).hexdigest(), "mode": mode})
entries.sort(key=lambda e: e["path"])
json.dump(entries, open(base + "/manifest.json","w"), indent=1)
print("manifest entries:", len(entries))
PY

poststate="$FROZ/option-c-poststate.py"

run_one() { # run_one <label> <wrapper> <outdir> <cmd...>
    local label="$1" w="$2" od="$3"; shift 3
    mkdir -p "$od"
    local so="$od/$label.wrapper-stdout" se="$od/$label.wrapper-stderr"
    "$w" "$label" "$EXP/root" "$EXP/manifest.json" "$poststate" "$od" -- "$@" >"$so" 2>"$se"
    local rc=$?
    local rcfile="ABSENT" psfile="ABSENT" psrc="ABSENT"
    [ -f "$od/$label.rc" ] && rcfile="$(cat "$od/$label.rc")"
    [ -f "$od/$label.poststate" ] && psfile="$(wc -l <"$od/$label.poststate")L"
    [ -f "$od/$label.poststate-rc" ] && psrc="$(cat "$od/$label.poststate-rc")"
    local summary
    summary="$(grep -c 'post-state: 4 entries checked, 0 failures' "$so")"
    printf '%-6s %-26s wrapper_rc=%-4s .rc=%-7s .poststate=%-6s .poststate-rc=%-7s summary_lines_in_wrapper_stdout=%-3s sealed_stdout_bytes=%-4s stderr_bytes=%s\n' \
        "$label" "$(basename "$w" | sed 's/option-c-stage-wrapper.sh/'"$WRAPVER"'/')" "$rc" "$rcfile" "$psfile" "$psrc" "$summary" "$(stat -c %s "$so")" "$(stat -c %s "$se")"
}

WRAPVER="PRISTINE"
echo "=============== PRISTINE wrapper (sha d11801e5...) ==============="
run_one builtin_exit7   "$PW" "$EXP/out-pristine" exit 7
run_one external_exit7  "$PW" "$EXP/out-pristine" bash -c 'exit 7'
run_one external_exit0  "$PW" "$EXP/out-pristine" bash -c 'exit 0'
run_one external_out_err "$PW" "$EXP/out-pristine" bash -c 'echo O; echo E >&2; exit 5'
run_one notfound        "$PW" "$EXP/out-pristine" definitely-not-a-command-xyz
WRAPVER="FIXED"
echo "=============== FIXED wrapper (sha c14043c0...) ==============="
run_one builtin_exit7   "$FW" "$EXP/out-fixed" exit 7
run_one external_exit7  "$FW" "$EXP/out-fixed" bash -c 'exit 7'
run_one external_exit0  "$FW" "$EXP/out-fixed" bash -c 'exit 0'
run_one external_out_err "$FW" "$EXP/out-fixed" bash -c 'echo O; echo E >&2; exit 5'
run_one notfound        "$FW" "$EXP/out-fixed" definitely-not-a-command-xyz
