package tests

import boring.FloatWidth
import boring.PrintedBadge
import boring.PrintedEnumOps
import boring.PrintedMark
import boring.runtime.test.Test

class PrintedEnumTests {
@boring.test.Test
    fun forms() {
        Test.run("tests.PrintedEnumTests.forms", "tests.PrintedEnumTests.forms: enum constructor printed forms") {
                Test.equals("Plain", PrintedEnumOps.markValue(PrintedMark.Plain), null)
                Test.equals("mark=Ring(diameter=1.5)", PrintedEnumOps.markText(PrintedMark.Ring(1.5f)), null)
                val label = "x"
                Test.equals("Tag(text=x, weight=2)", PrintedEnumOps.markValue(PrintedMark.Tag(label, 2)), null)
                Test.equals("PrintedBadge(mark=Ring(diameter=1.5), width=F64)", PrintedEnumOps.badgeText(PrintedBadge(PrintedMark.Ring(1.5f), FloatWidth.F64)), null)
                Test.equals("Trail(steps=[1, 2])", PrintedEnumOps.markValue(PrintedMark.Trail(mutableListOf<Int>(1, 2))), null)
                Test.equals("Aliases(names=[alpha, beta])", PrintedEnumOps.markValue(PrintedMark.Aliases(mutableListOf<String>("alpha", "beta"))), null)
                Test.equals("[Plain, Ring(diameter=1.5)]", PrintedEnumOps.markList(mutableListOf<PrintedMark>(PrintedMark.Plain, PrintedMark.Ring(1.5f))), null)
        }
    }
}
