#![cfg(test)]

use crate::boring::narrowed_option_return_ops::NarrowedOptionReturnOps;
use crate::runtime::test as testlib;
use crate::runtime::test_core;
use crate::runtime::u_string::UStr;
use crate::runtime::u_string::UString;


#[test]
fn pick() {
    testlib::run("tests.NarrowedOptionReturnTests.pick", "tests.NarrowedOptionReturnTests.pick: a narrowed nullable value returns through a fallible owned String slot", || {
        test_core::TestCore::test_core_equals_string(UStr::new(&[115,104,111,119,110]), NarrowedOptionReturnOps::narrowed_option_return_ops_pick(Some(UString::from("shown"))).unwrap().as_ustr(), UStr::new(&[]));
    });
}
