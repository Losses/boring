#[derive(Clone, PartialEq)]
pub struct CtorOmitTarget {
    pub width: f64,
    pub height: f64,
    pub count: u32,
}

impl CtorOmitTarget {
    pub fn new(width: f64, height: Option<f64>, count: Option<u32>) -> Self {
        let height = height.unwrap_or_else(|| 100.0);
        let count = count.unwrap_or_else(|| 5);
        Self {
            width,
            height: height,
            count: count,
        }
    }
}

#[derive(Clone, Copy)]
pub struct CtorOmitOps;

impl CtorOmitOps {
    pub fn ctor_omit_ops_make() -> f64 {
        let t = CtorOmitTarget::new(10.0f64, Some(100.0), Some(5));
        return t.width + t.height;
    }
}
