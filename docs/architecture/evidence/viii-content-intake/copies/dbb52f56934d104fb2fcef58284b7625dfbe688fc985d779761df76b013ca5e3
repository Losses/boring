#!/usr/bin/env bash
# Runs the report step EXTRACTED VERBATIM from .github/workflows/ci.yml the way
# GitHub Actions runs a `run:` step: `bash -e <step>`, cwd = repo root, with
# GITHUB_STEP_SUMMARY set. Gate exits are measured directly from the step process,
# never through a pipe. The suite itself is NEVER run: every scenario replays a
# retained or crafted log through the report step only.
set -u
E="$(cd "$(dirname "$0")" && pwd)"
REPO=/home/losses/Development/tq-workspace/boring-wt-architecture
S="$E/step-report-from-yaml.sh"
export PATH="$(grep -m1 '^PATH=' /home/losses/Development/tq-workspace/dc-warn/out/chainA-fixed-rerun/evidence/env.json | cut -d= -f2-)"
LOG="$REPO/out/collected-suite.log"
SAVE="$E/pre-existing-collected-suite.log"
CRAFT="$E/../scratch"

mkdir -p "$REPO/out"
if [ -f "$LOG" ]; then cp "$LOG" "$SAVE"; echo "saved pre-existing $LOG -> $SAVE"; else echo "no pre-existing $LOG"; rm -f "$SAVE"; fi
echo "fixture guard before: Test.equals=$(grep -c 'Test.equals' "$REPO/samples/boring/MathNaNTestSupport.hx" || true)  (tracked fixture; the suite is what rewrites it, and no scenario here runs the suite)"

run_one() {
  local label="$1" kind="$2" logsrc="${3:-}"
  export GITHUB_STEP_SUMMARY="$E/summary-$label.md"
  : > "$GITHUB_STEP_SUMMARY"
  case "$kind" in
    install)       cp "$logsrc" "$LOG" ;;
    install+append) cp "$logsrc" "$LOG"; printf 'out/dup/tests/ts/synthetic-sweep.test.ts:\n' >> "$LOG" ;;
    absent)        rm -f "$LOG" ;;
  esac
  echo
  echo "================ scenario: $label ($kind) ================"
  ( cd "$REPO" && bash -e "$S" > "$E/step-$label.stdout.txt" 2>&1 )
  local rc=$?
  echo "step exit=$rc   (measured directly from the step process, no pipe)"
  printf '%s\n' "$rc" > "$E/exit-$label.txt"
  echo "--- ::error:: / ::warning:: lines ---"
  grep -E '::(error|warning)::' "$E/step-$label.stdout.txt" || echo "(none)"
  echo "--- step summary: class table ---"
  grep -E '^\| (class|real|environment|npm-artifact|timeout cascade|unattributed|---)' "$GITHUB_STEP_SUMMARY" || echo "(no class table)"
}

run_one crafted-assertion        install "$CRAFT/crafted-assertion.log"
run_one crafted-timeout          install "$CRAFT/crafted-timeout.log"
run_one crafted-flake            install "$CRAFT/crafted-flake.log"
run_one control-A-artifact-no-bytediff install "$CRAFT/control-A-artifact-test-fails-without-byte-diff.log"
run_one control-B-artifact-timeout     install "$CRAFT/control-B-artifact-test-times-out.log"
run_one control-C-cascade-no-timeout   install "$CRAFT/control-C-cascade-without-timeout.log"
run_one control-D-package-shell-249    install "$CRAFT/control-D-package-shell-spec-gap.log"
run_one control-E-died-before-summary  install "$CRAFT/control-E-died-before-summary.log"
run_one control-F-buffer-diff-other-file install "$CRAFT/control-F-buffer-diff-other-file.log"
run_one control-G-green-run install "$CRAFT/control-G-green-run.log"
run_one retained-baseline        install /home/losses/Development/tq-workspace/dc-warn/out/ci-wire/evidence/recorded-baseline-proof-run.log
run_one gate-missing-log         absent
run_one gate-domain-guard        install+append /home/losses/Development/tq-workspace/dc-warn/out/ci-wire/evidence/recorded-baseline-proof-run.log

# gate: unparseable warning count. `wc` is shimmed to emit a non-integer. The shim
# lives under $TMPDIR because dc-warn/ is a fuse.rclone mount that drops exec bits.
SHIM="$(mktemp -d)"
printf '#!/bin/sh\nprintf "not-a-number\\n"\n' > "$SHIM/wc"
chmod +x "$SHIM/wc"
echo "shim: $SHIM/wc (exec bit: $( [ -x "$SHIM/wc" ] && echo yes || echo no ))"
cp "$CRAFT/crafted-assertion.log" "$LOG"
export GITHUB_STEP_SUMMARY="$E/summary-gate-unparseable-count.md"
: > "$GITHUB_STEP_SUMMARY"
echo
echo "================ scenario: gate-unparseable-count (wc shimmed) ================"
( cd "$REPO" && PATH="$SHIM:$PATH" bash -e "$S" > "$E/step-gate-unparseable-count.stdout.txt" 2>&1 )
rc=$?
echo "step exit=$rc   (expected 1)"
printf '%s\n' "$rc" > "$E/exit-gate-unparseable-count.txt"
grep -E '::(error|warning)::' "$E/step-gate-unparseable-count.stdout.txt" || echo "(none)"
rm -rf "$SHIM"

# gate: warning count over baseline.
cp "$CRAFT/crafted-assertion.log" "$LOG"
printf 'warning: reference/ts/gen/tests/Synthetic.test.ts:1: unused\n' >> "$LOG"
export GITHUB_STEP_SUMMARY="$E/summary-gate-warn-over-baseline.md"
: > "$GITHUB_STEP_SUMMARY"
echo
echo "================ scenario: gate-warn-over-baseline ================"
( cd "$REPO" && bash -e "$S" > "$E/step-gate-warn-over-baseline.stdout.txt" 2>&1 )
rc=$?
echo "step exit=$rc   (expected 1)"
printf '%s\n' "$rc" > "$E/exit-gate-warn-over-baseline.txt"
grep -E '::(error|warning)::' "$E/step-gate-warn-over-baseline.stdout.txt" || echo "(none)"
echo "--- generated-tree warning block in the summary ---"
sed -n '/Generated-tree warning line count/,+6p' "$GITHUB_STEP_SUMMARY"

# restore
if [ -f "$SAVE" ]; then cp "$SAVE" "$LOG"; else rm -f "$LOG"; fi
echo
echo "restored $LOG; fixture guard after: Test.equals=$(grep -c 'Test.equals' "$REPO/samples/boring/MathNaNTestSupport.hx" || true)"
echo "SUITE WAS NEVER RUN: every scenario above replays a retained or crafted log through the report step only."
