#![cfg(test)]

use crate::boring::imp_host::ImpHost;
use crate::boring::imp_widget::ImpWidget;
use crate::runtime::test as testlib;
use crate::runtime::test_core;
use crate::runtime::u_string::UStr;


#[test]
fn defaults() {
    testlib::run("tests.ImpDefaultTests.defaults", "tests.ImpDefaultTests.defaults: materialized cross-package constructor default", || {
        test_core::TestCore::test_core_equals_string(UStr::new(&[119]), (ImpHost::new(Some(ImpWidget::new(UStr::new(&[119])))).widget.label).to_ustring().as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[120]), (ImpHost::new(Some(ImpWidget::new(&(UStr::new(&[120]))))).widget.label).to_ustring().as_ustr(), UStr::new(&[]));
    });
}
