#![cfg(test)]

use crate::boring::number_parsing_ops::NumberParsingOps;
use crate::runtime::test as testlib;
use crate::runtime::test_core;
use crate::runtime::u_string::UStr;
use crate::tests::test_helper::*;


#[test]
fn float_success() {
    testlib::run("tests.NumberParsingTests.floatSuccess", "tests.NumberParsingTests.floatSuccess: parseFloat accepts complete decimal tokens", || {
        test_core::TestCore::test_core_equals_float(1.0f64, NumberParsingOps::number_parsing_ops_parse_float(UStr::new(&[32,32,43,49,46,32,32])), UStr::new(&[]));
        test_core::TestCore::test_core_equals_float(0.5f64, NumberParsingOps::number_parsing_ops_parse_float(UStr::new(&[46,53])), UStr::new(&[]));
        test_core::TestCore::test_core_equals_float(-125.0f64, NumberParsingOps::number_parsing_ops_parse_float(UStr::new(&[45,49,46,50,53,69,43,50])), UStr::new(&[]));
    });
}

#[test]
fn float_failure() {
    testlib::run("tests.NumberParsingTests.floatFailure", "tests.NumberParsingTests.floatFailure: parseFloat rejects malformed and partial tokens as NaN", || {
        test_core::TestCore::test_core_equals_bool(true, NumberParsingOps::number_parsing_ops_failed_float(UStr::new(&[])), UStr::new(&[]));
        test_core::TestCore::test_core_equals_bool(true, NumberParsingOps::number_parsing_ops_failed_float(UStr::new(&[49,50,120])), UStr::new(&[]));
        test_core::TestCore::test_core_equals_bool(true, NumberParsingOps::number_parsing_ops_failed_float(UStr::new(&[49,101])), UStr::new(&[]));
        test_core::TestCore::test_core_equals_bool(true, NumberParsingOps::number_parsing_ops_failed_float(UStr::new(&[105,110,102])), UStr::new(&[]));
        test_core::TestCore::test_core_equals_bool(true, NumberParsingOps::number_parsing_ops_failed_float(UStr::new(&[73,110,102,105,110,105,116,121])), UStr::new(&[]));
        test_core::TestCore::test_core_equals_bool(true, NumberParsingOps::number_parsing_ops_failed_float(UStr::new(&[49,102])), UStr::new(&[]));
        test_core::TestCore::test_core_equals_bool(true, NumberParsingOps::number_parsing_ops_failed_float(UStr::new(&[48,120,49,48])), UStr::new(&[]));
        test_core::TestCore::test_core_equals_bool(true, NumberParsingOps::number_parsing_ops_failed_float(UStr::new(&[1,32,49,46,53])), UStr::new(&[]));
        test_core::TestCore::test_core_equals_bool(true, NumberParsingOps::number_parsing_ops_failed_float(UStr::new(&[8232,32,49,46,53])), UStr::new(&[]));
        test_core::TestCore::test_core_equals_float(0.5f64, NumberParsingOps::number_parsing_ops_parse_float(UStr::new(&[11,46,53])), UStr::new(&[]));
    });
}

#[test]
fn int_success() {
    testlib::run("tests.NumberParsingTests.intSuccess", "tests.NumberParsingTests.intSuccess: parseInt accepts decimal and hexadecimal tokens", || {
        assert_equals_opt(&Some(-42), &NumberParsingOps::number_parsing_ops_parse_int(UStr::new(&[32,45,52,50,32])), UStr::new(&[]));
        assert_equals_opt(&Some(16), &NumberParsingOps::number_parsing_ops_parse_int(UStr::new(&[48,120,49,48])), UStr::new(&[]));
        assert_equals_opt(&Some(31), &NumberParsingOps::number_parsing_ops_parse_int(UStr::new(&[48,88,49,102])), UStr::new(&[]));
        assert_equals_opt(&Some(12), &NumberParsingOps::number_parsing_ops_parse_int(UStr::new(&[32,49,50,32])), UStr::new(&[]));
        assert_equals_opt(&Some(26), &NumberParsingOps::number_parsing_ops_parse_int(UStr::new(&[43,48,88,49,97])), UStr::new(&[]));
        assert_equals_opt(&Some(-42), &NumberParsingOps::number_parsing_ops_parse_int(UStr::new(&[11,45,52,50])), UStr::new(&[]));
        assert_equals_opt(&Some(-2147483648), &NumberParsingOps::number_parsing_ops_parse_int(UStr::new(&[45,48,120,56,48,48,48,48,48,48,48])), UStr::new(&[]));
        assert_equals_opt(&Some(-2147483648), &NumberParsingOps::number_parsing_ops_parse_int(UStr::new(&[45,50,49,52,55,52,56,51,54,52,56])), UStr::new(&[]));
        assert_equals_opt(&Some(2147483647), &NumberParsingOps::number_parsing_ops_parse_int(UStr::new(&[48,120,55,70,70,70,70,70,70,70])), UStr::new(&[]));
        assert_equals_opt(&Some(2147483647), &NumberParsingOps::number_parsing_ops_parse_int(UStr::new(&[50,49,52,55,52,56,51,54,52,55])), UStr::new(&[]));
    });
}

#[test]
fn int_failure() {
    testlib::run("tests.NumberParsingTests.intFailure", "tests.NumberParsingTests.intFailure: parseInt rejects partial and overflowing tokens as null", || {
        test_core::TestCore::test_core_equals_bool(true, NumberParsingOps::number_parsing_ops_failed_int(UStr::new(&[49,50,120])), UStr::new(&[]));
        test_core::TestCore::test_core_equals_bool(true, NumberParsingOps::number_parsing_ops_failed_int(UStr::new(&[48,120,56,48,48,48,48,48,48,48])), UStr::new(&[]));
        test_core::TestCore::test_core_equals_bool(true, NumberParsingOps::number_parsing_ops_failed_int(UStr::new(&[48,120])), UStr::new(&[]));
        test_core::TestCore::test_core_equals_bool(true, NumberParsingOps::number_parsing_ops_failed_int(UStr::new(&[50,49,52,55,52,56,51,54,52,56])), UStr::new(&[]));
    });
}
