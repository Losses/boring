package boring

class StaticStateClient {
    companion object {
        fun install(value: String) {
            StaticStateOps.current = value
        }
    }
}

object StaticStateOps {
    @JvmField
    var current: String? = null
    private val sections: MutableList<String> = mutableListOf<String>()
    const val limit: Int = 4096
    const val emptyMark: String = "empty"

    fun setCurrent(value: String) {
        StaticStateOps.current = value
    }

    fun readCurrent(): String {
        val value = StaticStateOps.current
        return (if ((value == null)) "none" else value)
    }

    fun record(section: String) {
        StaticStateOps.sections.add(section)
    }

    fun sectionCount(): Int {
        return StaticStateOps.sections.size
    }

    fun firstSection(): String {
        if ((StaticStateOps.sections.size == 0)) {
            return StaticStateOps.emptyMark
        }
        return StaticStateOps.sections[0]
    }
}
