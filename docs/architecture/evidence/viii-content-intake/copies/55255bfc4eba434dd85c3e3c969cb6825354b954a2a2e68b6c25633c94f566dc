package tests

import boring.TryOps
import boring.VectorException
import boring.runtime.test.Test

class TryTests {
@boring.test.Test
    fun testCaughtStatement() {
        Test.run("tests.TryTests.testCaughtStatement", "tests.TryTests.testCaughtStatement: statement region catches overflow into the handler") {
                Test.equals(12, TryOps.caughtStatement(12), null)
                Test.equals(14, TryOps.caughtStatement(7), null)
        }
    }

@boring.test.Test
    fun testRegionReturn() {
        Test.run("tests.TryTests.testRegionReturn", "tests.TryTests.testRegionReturn: return region yields the handler value on fault") {
                Test.equals(12, TryOps.regionReturn(12), null)
                Test.equals(16, TryOps.regionReturn(8), null)
        }
    }

@boring.test.Test
    fun testRegionValue() {
        Test.run("tests.TryTests.testRegionValue", "tests.TryTests.testRegionValue: initializer region binds the region value") {
                Test.equals(13, TryOps.regionValue(12), null)
                Test.equals(17, TryOps.regionValue(8), null)
        }
    }

@boring.test.Test
    fun testHandlerReturn() {
        Test.run("tests.TryTests.testHandlerReturn", "tests.TryTests.testHandlerReturn: handler return leaves the region through the handler") {
                Test.equals(12, TryOps.handlerReturn(12), null)
                Test.equals(16, TryOps.handlerReturn(8), null)
        }
    }

@boring.test.Test
    fun testRegionMessage() {
        Test.run("tests.TryTests.testRegionMessage", "tests.TryTests.testRegionMessage: message accessor derives from the variant") {
                Test.equals("no fault", TryOps.regionMessage(7), null)
                Test.equals("record count exceeds u32", TryOps.regionMessage(12), null)
        }
    }

@boring.test.Test
    fun testFaultPayload() {
        Test.run("tests.TryTests.testFaultPayload", "tests.TryTests.testFaultPayload: payload capture flows through the catch variable") {
                Test.equals(35, TryOps.faultPayload(5), null)
        }
    }

@boring.test.Test
    fun testClassifyFault() {
        Test.run("tests.TryTests.testClassifyFault", "tests.TryTests.testClassifyFault: classify fault maps every variant") {
                Test.equals(11, TryOps.classifyFault(VectorException.BadMagic), null)
                Test.equals(12, TryOps.classifyFault(VectorException.CountOverflow), null)
                Test.equals(13, TryOps.classifyFault(VectorException.UnexpectedEof), null)
                Test.equals(24, TryOps.classifyFault(VectorException.TrailingBytes(4)), null)
        }
    }
}
