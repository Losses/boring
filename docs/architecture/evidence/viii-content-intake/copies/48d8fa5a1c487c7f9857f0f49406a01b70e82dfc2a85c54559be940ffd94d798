package boring

import boring.runtime.FPHelper

class RustCoalesceRecord(val fontFamilies: MutableList<String> = mutableListOf<String>(), val fontSize: Double = 16.0, val locale: String = "zh-Hans", val fontWeight: Int = 400, val italic: Boolean = false) {

    fun describe(): String {
        return this.locale + ":" + boring.runtime.FPHelper.formatFloat(this.fontSize) + ":" + this.fontWeight + ":" + this.italic + ":" + this.fontFamilies.size
    }
}

class RustCoalesceHolder(record: RustCoalesceRecord?) {
    val record: RustCoalesceRecord
    init {
    this.record = (if ((record == null)) RustCoalesceRecord(mutableListOf<String>(), 16.0, "zh-Hans", 400, false) else record)
    }

    fun describe(): String {
        return this.record.describe()
    }
}

object RustCoalesceOps {
    val INT_DEFAULTS: List<Int> = listOf(7, 8, 9)

    fun resolvedInts(): Int {
        return RustCoalesceIntRecord(RustCoalesceOps.INT_DEFAULTS).count()
    }

    fun localeFrom(value: String): String {
        return RustCoalesceRecord(mutableListOf<String>(), 16.0, value, 400, false).locale
    }

    fun displayDefault(text: String): String {
        return RustCoalesceTextRecord(text).display
    }

    fun tagFrom(value: String): Boolean {
        val name = value.uppercase()
        return RustCoalesceStringTagHolder(name).hasTag()
    }

    fun assignedLabel(value: String): Boolean {
        val holder = RustCoalesceStringHolder()
        holder.setLabel(value)
        return holder.hasLabel()
    }

    fun resolve(value: RustCoalesceRecord? = null): String {
        return RustCoalesceHolder(value).describe()
    }
}

class RustCoalesceTextRecord(text: String, val display: String = text) {
}

class RustCoalesceStringTagHolder(val tag: String) {

    fun hasTag(): Boolean {
        return true
    }
}

class RustCoalesceStringHolder {
    private var label: String?
    init {
    this.label = null
    }

    fun setLabel(value: String) {
        this.label = value
    }

    fun hasLabel(): Boolean {
        return this.label != null
    }
}

class RustCoalesceIntRecord(val values: List<Int> = mutableListOf<Int>()) {

    fun count(): Int {
        return this.values.size
    }
}
