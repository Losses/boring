use crate::boring::float_width::FloatWidth;
use crate::runtime::u_string::UStr;
use crate::runtime::u_string::UString;


#[derive(Clone, Copy)]
pub struct EnumQueriesOps;

impl EnumQueriesOps {
    pub fn enum_queries_ops_direct_count() -> u32 {
        return 3;
    }

    pub fn enum_queries_ops_alias_count() -> u32 {
        let widths = FloatWidth::ALL;
        return u32::wrapping_add(3, if widths[0usize] == FloatWidth::F64 { 0 } else { 1 });
    }

    pub fn enum_queries_ops_names() -> UString {
        let widths = FloatWidth::ALL;
        let count = 3;
        let mut result = UString::new();
        for index in 0..count {
            if i32::from_ne_bytes(((index) as i32).to_ne_bytes()) > (0) {
                result += &(UString::from(","));
            }
            result += &(UString::from(widths[usize::try_from(index).unwrap_or(0)].name()));
        }
        return result;
    }

    pub fn enum_queries_ops_round_trips() -> bool {
        let widths = FloatWidth::ALL;
        for index in 0..3 {
            let width = widths[usize::try_from(index).unwrap_or(0)];
            let back = FloatWidth::from_name(UString::from(width.name()).as_ustr());
            if back != Some(width) {
                return false;
            }
        }
        return true;
    }

    pub fn enum_queries_ops_unknown() -> UString {
        let value = FloatWidth::from_name(UStr::new(&[117,110,107,110,111,119,110]));
        return UString::from(format!("{}", { let mut __s = UString::new(); __s += &(UString::from("")); __s += (if value == None { UString::from("empty") } else { UString::from("value") }).as_ustr(); __s }).as_str());
    }

    pub fn enum_queries_ops_second_enum() -> UString {
        let modes = QueryMode::ALL;
        let first = QueryMode::from_name(UString::from(modes[0usize].name()).as_ustr());
        return UString::from(format!("{}", { let mut __s = UString::new(); __s += (if first == Some(modes[0usize]) { UString::from(modes[0usize].name()) } else { UString::from("bad") }).as_ustr(); __s += &(UString::from(",")); __s += UString::from(modes[1usize].name()).as_ustr(); __s }).as_str());
    }

    pub fn enum_queries_ops_lookup_name() -> UString {
        return UString::from("Read").to_ustring();
    }
}

#[derive(Debug, Clone, Copy, PartialEq)]
pub enum QueryMode {
    Read,
    Write,
}

pub fn compare_query_mode(a: &QueryMode, b: &QueryMode) -> i32 {
    if a == b { return 0; }
    fn rank(v: &QueryMode) -> i32 {
        match v {
            QueryMode::Read => 0,
            QueryMode::Write => 1,
        }
    }
    rank(a) - rank(b)
}

impl QueryMode {
    pub fn to_string(&self) -> String {
        match self {
            QueryMode::Read => "Read".to_string(),
            QueryMode::Write => "Write".to_string(),
        }
    }
}

impl QueryMode {
    pub const ALL: [QueryMode; 2] = [QueryMode::Read, QueryMode::Write];
    pub fn name(&self) -> &'static str {
        match self {
            QueryMode::Read => "Read",
            QueryMode::Write => "Write",
        }
    }
    pub fn from_name(name: &UStr) -> Option<QueryMode> {
        match name.to_utf8_lossy().as_str() {
            "Read" => Some(QueryMode::Read),
            "Write" => Some(QueryMode::Write),
            _ => None,
        }
    }
}
