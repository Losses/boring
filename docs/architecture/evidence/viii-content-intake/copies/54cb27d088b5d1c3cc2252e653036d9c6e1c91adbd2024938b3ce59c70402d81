use crate::runtime::u_string;
use crate::runtime::u_string::UStr;
use crate::runtime::u_string::UString;


#[derive(Clone, Copy)]
pub struct NullableStringViewOps;

impl NullableStringViewOps {
    pub fn nullable_string_view_ops_length_or_zero(value: Option<UString>) -> u32 {
        return NullableStringViewOps::nullable_string_view_ops_measure((value).as_deref().unwrap_or(UStr::new(&[])));
    }

    pub(crate) fn nullable_string_view_ops_measure(text: &UStr) -> u32 {
        return u_string::unit_count(&(text));
    }
}
