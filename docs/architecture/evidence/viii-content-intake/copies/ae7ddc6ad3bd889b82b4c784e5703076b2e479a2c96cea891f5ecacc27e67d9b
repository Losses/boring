package tests

import boring.DartNullPushOps
import boring.runtime.test.Test

class DartNullPushTests {
@boring.test.Test
    fun pushNullKeepsNull() {
        Test.run("tests.DartNullPushTests.pushNullKeepsNull", "tests.DartNullPushTests.pushNullKeepsNull: pushing null into Array<Null<T>> keeps null at the slot") {
                Test.equals(true, DartNullPushOps.pushNullIntoNullableArray() == null, null)
        }
    }

@boring.test.Test
    fun pushValueKeepsValue() {
        Test.run("tests.DartNullPushTests.pushValueKeepsValue", "tests.DartNullPushTests.pushValueKeepsValue: pushing a value into Array<Null<T>> keeps the value") {
                Test.equals(2, DartNullPushOps.pushValueIntoNullableArray(), null)
        }
    }

@boring.test.Test
    fun closureNullStaysNull() {
        Test.run("tests.DartNullPushTests.closureNullStaysNull", "tests.DartNullPushTests.closureNullStaysNull: nullable closure returning null keeps null") {
                Test.equals(true, DartNullPushOps.nullableClosureReturnsNull() == null, null)
        }
    }

@boring.test.Test
    fun closureValueStaysValue() {
        Test.run("tests.DartNullPushTests.closureValueStaysValue", "tests.DartNullPushTests.closureValueStaysValue: nullable closure returning a value keeps the value") {
                Test.equals(7, DartNullPushOps.nullableClosureReturnsValue(), null)
        }
    }
}
