package boring;

import std.ReadOnlyArray;

/** Class-1 fixtures: a try region (handoff absent) whose binding and whose
    return cross the Array -> ReadOnlyArray boundary. */
class C1TryOps {
    /** Binding route (tryBindingLines): the declared destination is
        ReadOnlyArray<Int>, the region value is Array<Int>. */
    public static function tryBindingDest(flag:Bool):String {
        var view:ReadOnlyArray<Int> = try throwingProduce(flag) catch (e:C1BoundaryError) {
            fallbackArray();
        };
        return consumeView(view, 1);
    }

    /** Return route (tryReturnLines): the function returns
        ReadOnlyArray<Int>, the region value is Array<Int>. */
    public static function tryReturnDest(flag:Bool):ReadOnlyArray<Int> {
        return try throwingProduce(flag) catch (e:C1BoundaryError) {
            fallbackArray();
        };
    }

    /** Negative control: same syntactic positions, same region, but the
        binding and the return type are Array<Int>, so no boundary is
        crossed. */
    public static function tryBindingNoCross(flag:Bool):String {
        var values:Array<Int> = try throwingProduce(flag) catch (e:C1BoundaryError) {
            fallbackArray();
        };
        return values[0] + ":" + values.length;
    }

    public static function tryReturnNoCross(flag:Bool):Array<Int> {
        return try throwingProduce(flag) catch (e:C1BoundaryError) {
            fallbackArray();
        };
    }

    public static function throwingProduce(flag:Bool):Array<Int> {
        if (flag)
            throw new C1BoundaryError("c1 boundary fixture error");
        return [4];
    }

    public static function fallbackArray():Array<Int> {
        return [9];
    }

    public static function consumeView(values:ReadOnlyArray<Int>, marker:Int):String {
        return values[0] + ":" + marker + ":" + values.length;
    }
}
