#[test]
fn test_zero() {
    testlib::run("tests.MathIntWideningOpsTests.testZero", "tests.MathIntWideningOpsTests.testZero: Math Int widening handles zero", || {
        test_core::TestCore::test_core_equals_int(0i32, i32::from_ne_bytes(((MathIntWideningOps::math_int_widening_ops_floor_of(0)) as i32).to_ne_bytes()), UStr::new(&[]));
        test_core::TestCore::test_core_equals_int(0i32, i32::from_ne_bytes(((MathIntWideningOps::math_int_widening_ops_ceil_of(0)) as i32).to_ne_bytes()), UStr::new(&[]));
        test_core::TestCore::test_core_equals_float(0.0f32, MathIntWideningOps::math_int_widening_ops_sqrt_of(0), UStr::new(&[]));
        test_core::TestCore::test_core_equals_bool(false, MathIntWideningOps::math_int_widening_ops_nan_of(0), UStr::new(&[]));
        test_core::TestCore::test_core_equals_bool(true, MathIntWideningOps::math_int_widening_ops_finite_of(0), UStr::new(&[]));
    });
}
