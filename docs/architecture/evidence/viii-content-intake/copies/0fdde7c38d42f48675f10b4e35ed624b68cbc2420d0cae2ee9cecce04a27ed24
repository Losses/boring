package tests

object HandWrittenLoopPositionSupport {
    fun accumulate(values: MutableList<Int>): MutableList<Int> {
        val result = mutableListOf<Int>()
        for (index in 0 until values.size) {
            result.add(values[index] + 1)
        }
        return result
    }

    fun nestedIf(values: MutableList<Int>): MutableList<Int> {
        val result = mutableListOf<Int>()
        if ((values.size > 0)) {
            val inner = mutableListOf<Int>()
            for (index in 0 until values.size) {
                inner.add(values[index] + 1)
            }
            for (value in inner) {
                result.add(value)
            }
        }
        return result
    }

    fun nestedWhile(values: MutableList<Int>): MutableList<Int> {
        val result = mutableListOf<Int>()
        for (pass in 0 until 1) {
            val inner = mutableListOf<Int>()
            for (index in 0 until values.size) {
                inner.add(values[index] + 1)
            }
            for (value in inner) {
                result.add(value)
            }
        }
        return result
    }

    fun outerLoop(values: MutableList<Int>): MutableList<Int> {
        val result = mutableListOf<Int>()
        run {
            run {
                val inner = mutableListOf<Int>()
                for (index in 0 until values.size) {
                    inner.add(values[index] + 1)
                }
                for (value in inner) {
                    result.add(value)
                }
            }
            run {
                val inner_2 = mutableListOf<Int>()
                for (index_2 in 0 until values.size) {
                    inner_2.add(values[index_2] + 1)
                }
                for (value_2 in inner_2) {
                    result.add(value_2)
                }
            }
        }
        return result
    }
}
