package dcguard

object DcGuard {
    fun p2FallThrough(flag: Boolean): Int {
        val s = (if ((flag)) "hello" else null)
        if ((s == null)) {
            val unused = 1
        }
        return s?.size!!
    }

    fun p7TerminatingGuard(flag: Boolean): Int {
        val t = (if ((flag)) "world" else null)
        if ((t == null)) {
            return -1
        }
        return t.size
    }

    fun run(): String {
        val a = DcGuard.p2FallThrough(true)
        val b = DcGuard.p7TerminatingGuard(true)
        return "p2=" + a + "\np7=" + b
    }

    private fun main() {
    }
}
