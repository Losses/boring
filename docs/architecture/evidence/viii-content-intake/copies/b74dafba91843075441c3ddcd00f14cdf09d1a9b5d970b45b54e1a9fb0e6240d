package boring

object DartCharNullOps {
    fun argShape(s: String): Int {
        return DartCharNullOps.clamp((run { val _s = s; val _i = 0; if (_i >= 0 && _i < _s.length) _s[_i].code else null }) ?: throw IllegalArgumentException("argument is null"))
    }

    private fun clamp(c: Int): Int {
        return (if ((c < 0)) 0 else c)
    }

    fun boundArgShape(s: String): Int {
        val code = run { val _s = s; val _i = 0; if (_i >= 0 && _i < _s.length) _s[_i].code else null }
        return DartCharNullOps.clamp(code ?: throw IllegalArgumentException("argument is null"))
    }

    fun compareShape(s: String): Boolean {
        val high = run { val _s = s; val _i = 1; if (_i >= 0 && _i < _s.length) _s[_i].code else null }
        val low = run { val _s = s; val _i = 0; if (_i >= 0 && _i < _s.length) _s[_i].code else null }
        return high!! < low!!
    }

    fun returnShape(s: String): Int {
        return (run { val _s = s; val _i = 2; if (_i >= 0 && _i < _s.length) _s[_i].code else null })!!
    }

    fun annotatedCompareShape(s: String): Boolean {
        val high = run { val _s = s; val _i = 1; if (_i >= 0 && _i < _s.length) _s[_i].code else null }!!
        val low = run { val _s = s; val _i = 0; if (_i >= 0 && _i < _s.length) _s[_i].code else null }!!
        return high < low
    }

    fun annotatedBoundArgShape(s: String): Int {
        val code = run { val _s = s; val _i = 0; if (_i >= 0 && _i < _s.length) _s[_i].code else null }!!
        return DartCharNullOps.clamp(code)
    }
}
