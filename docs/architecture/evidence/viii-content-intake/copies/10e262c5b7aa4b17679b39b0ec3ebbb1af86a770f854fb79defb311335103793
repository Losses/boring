package boring

import std.UStringException

object NullableBufFieldOps {
    private fun findHolder(present: Boolean): NullableBufHolder? {
        if ((!present)) {
            return null
        }
        return NullableBufHolder()
    }

    fun appendGuarded(present: Boolean, part: String): String {
        val holder = NullableBufFieldOps.findHolder(present)
        if ((holder == null)) {
            return ""
        }
        val tail2 = holder.text.lastOrNull()?.code ?: -1
        if (tail2 >= 55296 && tail2 <= 56319 && part.length > 0 && !(part[0].code >= 56320 && part[0].code <= 57343)) {
            throw UStringException.UnpairedSurrogate(tail2)
        }
        holder.text.append(part)
        return holder.render()
    }

    fun caughtFault(present: Boolean, lead: Int, part: String): String {
        val holder = NullableBufFieldOps.findHolder(present)
        if ((holder == null)) {
            return ""
        }
        try {
            val tail3 = holder.text.lastOrNull()?.code ?: -1
            if (lead >= 56320 && lead <= 57343) {
                if (!(tail3 >= 55296 && tail3 <= 56319)) {
                    throw UStringException.UnpairedSurrogate(lead)
                }
            } else if (tail3 >= 55296 && tail3 <= 56319) {
                throw UStringException.UnpairedSurrogate(tail3)
            }
            holder.text.append((lead).toChar())
            val tail4 = holder.text.lastOrNull()?.code ?: -1
            if (tail4 >= 55296 && tail4 <= 56319 && part.length > 0 && !(part[0].code >= 56320 && part[0].code <= 57343)) {
                throw UStringException.UnpairedSurrogate(tail4)
            }
            holder.text.append(part)
        } catch (error: UStringException) {
            return "fault"
        }
        return holder.render()
    }
    private class NullableBufHolder {
        val text: StringBuilder
        init {
        this.text = StringBuilder()
        }
    
        fun render(): String {
            val tail = this.text.lastOrNull()?.code ?: -1
            if (tail >= 55296 && tail <= 56319) {
                throw UStringException.UnpairedSurrogate(tail)
            }
            return this.text.toString()
        }
    }
}
