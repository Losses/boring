// Reproduces the ts-tgz iteration of the package-artifacts byte-identity
// test (same rewrite, same stub, same two generations) but keeps both roots
// and pinpoints where the artifacts differ. Run: bun identity-inspect.ts
import * as crypto from "node:crypto";
import * as fs from "node:fs";
import * as os from "node:os";
import * as path from "node:path";
import * as zlib from "node:zlib";

const REPO_ROOT = "/home/losses/Development/tq-workspace/boring-wt-architecture";
const TSC = path.join(REPO_ROOT, "node_modules/typescript/bin/tsc");

function rewriteHxml(name: string, root: string, extra: string[] = []): string {
  const source = fs.readFileSync(path.join(REPO_ROOT, "examples", name), "utf8");
  let out = source.replace(/reference\/[a-z0-9-]+(\/[a-z0-9-]+)*/g, (match) =>
    match.replace("reference", root),
  );
  out = out.replace("-D runtime-import=@boring/runtime", "-D runtime-import=./runtime");
  out = out.replace("-D package-shell=none\n", "");
  out = out.replaceAll("boring.MathNaNTestSupport\n", "");
  out += "-D package-artifacts=emit\n";
  for (const line of extra) out += line + "\n";
  return out;
}

async function runHaxe(hxmlName: string, content: string): Promise<{ exitCode: number | null; stderr: string }> {
  const hxmlPath = path.join(REPO_ROOT, "out", hxmlName);
  fs.mkdirSync(path.dirname(hxmlPath), { recursive: true });
  fs.writeFileSync(hxmlPath, content);
  const probe = path.join(REPO_ROOT, "samples/boring/MathNaNTestSupport.hx");
  const isTs = content.includes("ts-output") || hxmlName.includes("npm") || hxmlName.includes("tsc") || hxmlName.includes("id-");
  let hidden = false;
  let backup = "";
  const stub = "package boring;\nclass MathNaNTestSupport {\n    public static function assertNaN(value:Float, message:String):Void {}\n    public static function assertNegativeZero(value:Float, message:String):Void {}\n    public static function assertPositiveZero(value:Float, message:String):Void {}\n}\n";
  if (isTs && fs.existsSync(probe)) {
    backup = fs.readFileSync(probe, "utf8");
    fs.writeFileSync(probe, stub);
    hidden = true;
  }
  try {
    const proc = Bun.spawn(["haxe", path.relative(REPO_ROOT, hxmlPath)], {
      cwd: REPO_ROOT, stdout: "pipe", stderr: "pipe",
    });
    const [exitCode, stderr] = await Promise.all([proc.exited, new Response(proc.stderr).text()]);
    return { exitCode, stderr };
  } finally {
    if (hidden) fs.writeFileSync(probe, backup);
  }
}

function listTarEntries(tar: Buffer): { name: string; size: number; mtime: number; digest: string }[] {
  const out: { name: string; size: number; mtime: number; digest: string }[] = [];
  let off = 0;
  while (off + 512 <= tar.length) {
    const header = tar.subarray(off, off + 512);
    if (header.every((b) => b === 0)) break;
    const name = header.subarray(0, 100).toString("utf8").replace(/\0+$/, "");
    const size = parseInt(header.subarray(124, 136).toString("utf8").replace(/\0+$/g, "").trim() || "0", 8);
    const mtime = parseInt(header.subarray(136, 148).toString("utf8").replace(/\0+$/g, "").trim() || "0", 8);
    const body = tar.subarray(off + 512, off + 512 + size);
    out.push({ name, size, mtime, digest: crypto.createHash("sha256").update(body).digest("hex").slice(0, 16) });
    off += 512 + Math.ceil(size / 512) * 512;
  }
  return out;
}

const keepDir = fs.mkdtempSync(path.join(os.tmpdir(), "boring-identity-inspect-"));
const first = path.join(keepDir, "first");
const second = path.join(keepDir, "second");
fs.mkdirSync(first, { recursive: true });
fs.mkdirSync(second, { recursive: true });

const extra = [`-D package-tsc=${TSC}`];
const t0 = Date.now();
const a = await runHaxe("package-artifacts-id-inspect-a.hxml", rewriteHxml("ts.hxml", first, extra));
const t1 = Date.now();
const b = await runHaxe("package-artifacts-id-inspect-b.hxml", rewriteHxml("ts.hxml", second, extra));
const t2 = Date.now();
console.log(`gen A: rc=${a.exitCode} stderr="${a.stderr.slice(0, 200)}" (${t1 - t0} ms)`);
console.log(`gen B: rc=${b.exitCode} stderr="${b.stderr.slice(0, 200)}" (${t2 - t1} ms)`);

const fileA = path.join(first, "ts/generated-0.1.0.tgz");
const fileB = path.join(second, "ts/generated-0.1.0.tgz");
const bufA = fs.readFileSync(fileA);
const bufB = fs.readFileSync(fileB);
console.log(`sizes: A=${bufA.length} B=${bufB.length} diff=${bufB.length - bufA.length}`);
let firstDiff = -1;
for (let i = 0; i < Math.min(bufA.length, bufB.length); i++) {
  if (bufA[i] !== bufB[i]) { firstDiff = i; break; }
}
console.log(`first byte diff at offset: ${firstDiff}`);

const tarA = zlib.gunzipSync(bufA);
const tarB = zlib.gunzipSync(bufB);
console.log(`gunzip sizes: A=${tarA.length} B=${tarB.length}`);
const eA = listTarEntries(tarA);
const eB = listTarEntries(tarB);
console.log(`entries: A=${eA.length} B=${eB.length}`);
const namesA = eA.map((e) => e.name);
const namesB = eB.map((e) => e.name);
const onlyA = namesA.filter((n) => !namesB.includes(n));
const onlyB = namesB.filter((n) => !namesA.includes(n));
console.log(`entries only in A: ${JSON.stringify(onlyA)}`);
console.log(`entries only in B: ${JSON.stringify(onlyB)}`);
const mapA = new Map(eA.map((e) => [e.name, e]));
for (const eb of eB) {
  const ea = mapA.get(eb.name);
  if (!ea) continue;
  if (ea.size !== eb.size) console.log(`SIZE DIFF  ${eb.name}: A=${ea.size} B=${eb.size}`);
  else if (ea.digest !== eb.digest) console.log(`CONTENT DIFF ${eb.name} (${eb.size} bytes)`);
  if (ea.mtime !== eb.mtime) console.log(`MTIME DIFF ${eb.name}: A=${ea.mtime} (${new Date(ea.mtime * 1000).toISOString()}) B=${eb.mtime} (${new Date(eb.mtime * 1000).toISOString()})`);
}
console.log(`order same: ${namesA.join("\n") === namesB.join("\n")}`);
console.log(`KEEP: ${keepDir}`);
