use crate::boring::value_exception::ValueError;
use crate::boring::value_type_ops::FontFaceId;
use crate::boring::value_type_ops::Ic;
use crate::runtime::u_string::UStr;
use crate::runtime::u_string::UString;


#[derive(Debug, Clone, PartialEq)]
pub struct OptionalIcRecord {
    pub indent: Option<Ic>,
}

impl OptionalIcRecord {
    pub fn new(indent: Option<Ic>) -> Self {
        Self {
            indent,
        }
    }

    pub fn to_string(&self) -> UString {
        return UString::from(format!("{}", { let mut __s = UString::new(); __s += &(UString::from("OptionalIcRecord(")); __s += &(UString::from("indent=")); __s += &(match (self.indent).clone() { Some(ref v) => UString::from(v.0.to_string().as_str()), None => UString::from("null") }); __s += &(UString::from(")")); __s }).as_str());
    }
}

#[derive(Clone, Copy)]
pub struct ValueTypeConsumer;

impl ValueTypeConsumer {
    pub fn value_type_consumer_arithmetic() -> f64 {
        let first = Ic(2.0f64);
        let total = first + Ic::zero();
        return total.to_px(3.0f64);
    }

    pub fn value_type_consumer_equal_representations() -> bool {
        return Ic(2.0f64) == Ic(2.0f64);
    }

    pub fn value_type_consumer_static_value() -> f64 {
        return Ic::zero().to_px(5.0f64);
    }

    pub fn value_type_consumer_blank_rejected() -> bool {
        let mut rejected = false;
        let __outcome: Result<FontFaceId, ValueError> = (|| {
            return Ok(FontFaceId::new(UStr::new(&[32]))?);
        })();
        match __outcome {
            Ok(_) => {}
            Err(_) => {
                rejected = true;
            }
        }
        return rejected;
    }

    pub fn value_type_consumer_optional_ic_present() -> f64 {
        let record = OptionalIcRecord::new(Some(Ic(2.0f64)));
        let indent = record.indent.clone();
        if indent.is_none() {
            return -1.0f64;
        }
        return if indent.is_none() { -1.0f64 } else { 2.0f64 };
    }

    pub fn value_type_consumer_rendered_id() -> UString {
        let id = FontFaceId::new(UStr::new(&[102,97,99,101])).unwrap();
        return UString::from((id).to_string().as_str());
    }
}
