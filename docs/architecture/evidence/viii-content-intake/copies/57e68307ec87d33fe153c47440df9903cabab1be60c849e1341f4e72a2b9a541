#[test]
fn union_faults() {
    testlib::run("tests.RustUnionFaultTests.unionFaults", "tests.RustUnionFaultTests.unionFaults: union faults preserve deterministic source text", || {
        let text = UString::from("direct|edge|cascade").to_ustring();
        test_core::TestCore::test_core_equals_string(UStr::new(&[100,105,114,101,99,116,124,101,100,103,101,124,99,97,115,99,97,100,101]), text.as_ustr(), UStr::new(&[]));
        let __outcome: Result<u32, VectorError> = (|| {
            return Ok(RustUnionFaultSupport::rust_union_fault_support_direct_both(true)?);
        })();
        match __outcome {
            Ok(_) => {}
            Err(e) => {
                test_core::TestCore::test_core_equals_int(11i32, i32::from_ne_bytes(((TryOps::try_ops_classify_fault((e).clone())) as i32).to_ne_bytes()), UStr::new(&[]));
            }
        }
    });
}

#[derive(Clone, Copy)]
pub struct RustUnionFaultSupport;

impl RustUnionFaultSupport {
    pub fn rust_union_fault_support_direct_both(flag: bool) -> Result<u32, RustUnionFaultTestsDirectBothFault> {
        if flag {
            return Err(RustUnionFaultTestsDirectBothFault::VectorErrorFault(VectorError::BadMagic));
        }
        return Err(RustUnionFaultTestsDirectBothFault::CoreFaultFault(CoreFault::Config { text: UString::from("core") }));
    }

    pub fn rust_union_fault_support_vector_path() -> Result<u32, VectorError> {
        return Err(VectorError::UnexpectedEof);
    }

    pub fn rust_union_fault_support_core_path() -> Result<u32, CoreFault> {
        return Err(CoreFault::Tree { text: UString::from("tree") });
    }

    pub fn rust_union_fault_support_through_calls(flag: bool) -> Result<u32, RustUnionFaultTestsThroughCallsFault> {
        if flag {
            return Ok(RustUnionFaultSupport::rust_union_fault_support_vector_path().map_err(|e| RustUnionFaultTestsThroughCallsFault::VectorErrorFault(e))?);
        }
        return Ok(RustUnionFaultSupport::rust_union_fault_support_core_path().map_err(|e| RustUnionFaultTestsThroughCallsFault::CoreFaultFault(e))?);
    }

    pub fn rust_union_fault_support_second_caller(flag: bool) -> Result<u32, RustUnionFaultTestsThroughCallsFault> {
        return Ok(RustUnionFaultSupport::rust_union_fault_support_through_calls(flag)?);
    }

    pub fn rust_union_fault_support_mixed_caller(flag: bool) -> Result<u32, RustUnionFaultTestsMixedCallerFault> {
        if flag {
            return Ok(RustUnionFaultSupport::rust_union_fault_support_through_calls(flag).map_err(|e| RustUnionFaultTestsMixedCallerFault::ThroughCallsFault(e))?);
        }
        return Err(RustUnionFaultTestsMixedCallerFault::VectorErrorFault(VectorError::BadMagic));
    }
}
