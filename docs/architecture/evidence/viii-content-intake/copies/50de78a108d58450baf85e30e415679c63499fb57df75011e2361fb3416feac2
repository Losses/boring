                try Core.fail(x.name + ": cargo name must be lowercase")
            }
        }
        for i in stride(from: Int32(0), to: Int32(a.count), by: 1) {
            let x1 = a[Int(i)]
            for j in stride(from: Int32(0), to: i, by: 1) {
                let y = a[Int(j)]
                if x1.owner == y.owner && x1.repo == y.repo && x1.version == y.version && (x1.name != y.name || x1.license != y.license) {
                    try Core.fail({ let p0 = x1.owner; let p1 = "/"; let p2 = x1.repo; let p3 = "/"; let p4 = x1.version; let p5 = ": platform disagreement"; return p0 + p1 + p2 + p3 + p4 + p5 }())
                }
            }
        }
        for x2 in a {
            if x2.platform == "swift" && x2.archive != { let p0 = "swift/"; let p1 = scope; let p2 = "/"; let p3 = x2.name; let p4 = "/"; let p5 = x2.version; let p6 = ".zip"; return p0 + p1 + p2 + p3 + p4 + p5 + p6 }() {
                try Core.fail({ let p0 = x2.owner; let p1 = "/"; let p2 = x2.repo; let p3 = "/"; let p4 = x2.version; let p5 = ": invalid Swift archive"; return p0 + p1 + p2 + p3 + p4 + p5 }())
            }
        }
        for i1 in stride(from: Int32(0), to: Int32(a.count), by: 1) {
            let x3 = a[Int(i1)]
            for j1 in stride(from: Int32(0), to: i1, by: 1) {
                let y1 = a[Int(j1)]
                if x3.platform == y1.platform && x3.name == y1.name && x3.version == y1.version && x3.digest != y1.digest {
                    try Core.fail({ let p0 = x3.owner; let p1 = "/"; let p2 = x3.repo; let p3 = "/"; let p4 = x3.version; let p5 = ": digest conflict with "; let p6 = y1.owner; let p7 = "/"; let p8 = y1.repo; return p0 + p1 + p2 + p3 + p4 + p5 + p6 + p7 + p8 }())
                }
            }
        }
    }

    private static func headers() -> String {
        return "/*\n  Content-Version: 1\n/swift/:scope/:name\n  Content-Type: application/json\n/swift/:scope/:name/:version\n  Content-Type: application/json\n/swift/:scope/:name/:version/Package.swift\n  Content-Type: text/x-swift\n/pub/api/packages/*\n  Content-Type: application/vnd.pub.v2+json\n/swift/identifiers\n  Content-Type: application/json\n"
    }

    private static func emit(_ root: String, _ rel: String, _ data: String) -> Void {
        let file = OutputFile(path: rel, content: data, outputFile: 1)
        Core.files.append(file)
    }

    public static func parseArgs(_ argv: TiqianArray<String>) throws -> RegistryConfig {
        var t: String? = nil
        var o: String? = nil
        var b: String? = nil
        var s: String? = nil
        var ar: String? = nil
        var i: Int32 = 0
        while i < Int32(argv.count) {
            if i &+ 1 >= Int32(argv.count) {
                try Core.configFail(Core.USAGE)
            }
            let flag = argv[Int(i)]
            let value = argv[Int(i &+ 1)]
            if value == "" {
                try Core.configFail("empty value for " + flag)
            }
            if flag == "--tree" {
                t = value
            } else if flag == "--output" {
                o = value
            } else if flag == "--base-url" {
                b = value
            } else if flag == "--swift-scope" {
                s = value
            } else if flag == "--archive-base" {
                ar = value
            } else if flag == "--help" || flag == "-h" {
                try Core.configFail(Core.USAGE)
            } else {
                try Core.configFail("unknown flag " + flag)
            }
            i &+= 2
        }
        if t == nil || o == nil || b == nil {
            try Core.configFail("required flags missing\n" + Core.USAGE)
        }
        let treeStr = t ?? ""
        let outputStr = o ?? ""
        let baseUrlStr = b ?? ""
        if !Core.urlOk(baseUrlStr) {
            try Core.configFail("invalid base URL (http or https required)")
        }
        let swiftStr = s ?? ""
        let archiveStr = ar ?? ""
        if ar != nil && !Core.urlOk(archiveStr) {
            try Core.configFail("invalid archive-base URL (http or https required)")
        }
        let config = RegistryConfig(tree: treeStr, output: outputStr, baseUrl: baseUrlStr, swiftScope: swiftStr, archiveBase: archiveStr, configRecord: 1)
        return config
    }

    public static func generate(_ records: TiqianArray<InputRecord>, _ config: RegistryConfig) throws -> TiqianArray<OutputFile> {
        Core.files = TiqianArray<OutputFile>([])
        let all = try Core.scan(config.tree, records)
        if Int32(Core.names(all, "swift").count) > 0 && config.swiftScope == "" {
            try Core.fail("Swift requires --swift-scope")
        }
        if Int32(Core.names(all, "swift").count) > 0 && config.archiveBase == "" {
            try Core.fail("Swift requires --archive-base")
        }
        try Core.validate(all, config.swiftScope)
        try Core.writeNpm(config.output, all)
        try Core.writePub(config.output, all)
        try Core.writeCargo(config.output, config.baseUrl, all)
        if Int32(Core.names(all, "swift").count) > 0 {
            try Core.writeSwift(config.output, config.swiftScope, all)
        }
        try Core.writeMaven(config.output, all)
        Core.emit(config.output, "swift/identifiers", Json.write(Core.A(TiqianArray<JsonValue>([]))))
        Core.emit(config.output, "_headers", Core.headers())
        try Core.emit(config.output, "_redirects", Core.redirects(config.swiftScope, config.archiveBase, all))
        return Core.files
    }
}

public struct InputRecord: Equatable {
    public var path: String
    public var content: String
    public var inputRecord: Int32
    public init(path: String, content: String, inputRecord: Int32) {
        self.path = path
        self.content = content
        self.inputRecord = inputRecord
    }
}

public func compareInputRecord(_ a: InputRecord, _ b: InputRecord) -> Int32 {
    if a.path != b.path {
        return compareUnitOrder(a.path, b.path)
    }
    if a.content != b.content {
        return compareUnitOrder(a.content, b.content)
    }
    if a.inputRecord != b.inputRecord {
        return a.inputRecord - b.inputRecord
    }
    return 0
}

public struct OutputFile: Equatable {
    public var path: String
    public var content: String
    public var outputFile: Int32
    public init(path: String, content: String, outputFile: Int32) {
        self.path = path
        self.content = content
        self.outputFile = outputFile
    }
}

public func compareOutputFile(_ a: OutputFile, _ b: OutputFile) -> Int32 {
    if a.path != b.path {
        return compareUnitOrder(a.path, b.path)
    }
    if a.content != b.content {
        return compareUnitOrder(a.content, b.content)
    }
    if a.outputFile != b.outputFile {
        return a.outputFile - b.outputFile
    }
    return 0
}

public struct RegistryConfig: Equatable {
    public var tree: String
    public var output: String
    public var baseUrl: String
    public var swiftScope: String
    public var archiveBase: String
    public var configRecord: Int32
    public init(tree: String, output: String, baseUrl: String, swiftScope: String, archiveBase: String, configRecord: Int32) {
        self.tree = tree
        self.output = output
        self.baseUrl = baseUrl
        self.swiftScope = swiftScope
        self.archiveBase = archiveBase
        self.configRecord = configRecord
    }
}

public func compareRegistryConfig(_ a: RegistryConfig, _ b: RegistryConfig) -> Int32 {
    if a.tree != b.tree {
        return compareUnitOrder(a.tree, b.tree)
    }
    if a.output != b.output {
        return compareUnitOrder(a.output, b.output)
    }
    if a.baseUrl != b.baseUrl {
        return compareUnitOrder(a.baseUrl, b.baseUrl)
    }
    if a.swiftScope != b.swiftScope {
        return compareUnitOrder(a.swiftScope, b.swiftScope)
    }
    if a.archiveBase != b.archiveBase {
        return compareUnitOrder(a.archiveBase, b.archiveBase)
    }
    if a.configRecord != b.configRecord {
        return a.configRecord - b.configRecord
    }
    return 0
}
