use crate::boring::switch_merge_ops::SwitchMergeValue;


#[derive(Clone, Copy)]
pub struct NumericWidenOps;

impl NumericWidenOps {
    pub(crate) fn numeric_widen_ops_int_expr() -> u32 {
        return 2;
    }

    pub fn numeric_widen_ops_operand_float() -> f32 {
        return 3.5f32;
    }

    pub fn numeric_widen_ops_operand_double() -> f32 {
        return 3.5f32;
    }

    pub fn numeric_widen_ops_return_float() -> f32 {
        return 2.0f32;
    }

    pub fn numeric_widen_ops_return_double() -> f32 {
        return 2.0f32;
    }

    pub fn numeric_widen_ops_assign_float() -> f32 {
        let value = 2.0f32;
        return value;
    }

    pub fn numeric_widen_ops_assign_double() -> f32 {
        let value = 2.0f32;
        return value;
    }

    pub fn numeric_widen_ops_applied_float() -> f32 {
        let mut value: f64 = 0.5f64;
        value += 2.0f32 as f64;
        return value as f32;
    }

    pub fn numeric_widen_ops_applied_double() -> f32 {
        let mut value = 0.5f32;
        value *= 2.0f32;
        return value;
    }

    pub fn numeric_widen_ops_conditional_merge(use_float: bool) -> f32 {
        return if use_float { 1.5f32 } else { i32::from_ne_bytes(((NumericWidenOps::numeric_widen_ops_int_expr()) as i32).to_ne_bytes()) as f32 };
    }

    pub fn numeric_widen_ops_nullable_conditional(value: Option<f32>) -> f32 {
        return match &(value) { Some(__option) => *__option, None => 0 as f32 };
    }

    pub fn numeric_widen_ops_switch_merge(value: SwitchMergeValue) -> f32 {
        return match value {
            SwitchMergeValue::First { .. } => 1.5f32,
            SwitchMergeValue::Second { .. } => i32::from_ne_bytes(((NumericWidenOps::numeric_widen_ops_int_expr()) as i32).to_ne_bytes()) as f32,
            SwitchMergeValue::Third => 0.5f32,
        };
    }
}
