use crate::runtime::sorted_table::SortedMapTable;
use crate::runtime::sorted_table::SortedMapTableBuilder;
use crate::runtime::sorted_table::SortedTable;
use crate::runtime::u_string::UString;
use std::sync::Arc;


#[derive(Clone, Copy)]
pub struct PipelineOps;

impl PipelineOps {
    pub fn pipeline_ops_double_scores(items: &Vec<Item>) -> Vec<u32> {
        let capacity = items.len();
        let mut pipeline_result = Vec::with_capacity(capacity);
        for pipeline_index in 0..match u32::try_from(items.len()) { Ok(value) => value, Err(_) => u32::MAX } {
            let v = (items[usize::try_from(pipeline_index).unwrap_or(0)]).clone();
            pipeline_result.push(u32::wrapping_mul(v.score, 2));
        }
        return pipeline_result;
    }

    pub fn pipeline_ops_shadowing_map(items: &Vec<Item>) -> Vec<u32> {
        let mut item = 999u32;
        let capacity = items.len();
        let mut pipeline_result = Vec::with_capacity(capacity);
        for pipeline_index in 0..match u32::try_from(items.len()) { Ok(value) => value, Err(_) => u32::MAX } {
            let v = (items[usize::try_from(pipeline_index).unwrap_or(0)]).clone();
            pipeline_result.push(u32::wrapping_add(v.score, v.id));
        }
        let mapped = (pipeline_result).clone();
        if i32::from_ne_bytes(((u32::try_from((items.len()) & 0xFFFF_FFFF).unwrap_or(0)) as i32).to_ne_bytes()) > (100) {
            item = 1000u32;
        }
        if item != 999 {
            return vec![];
        }
        return mapped;
    }

    pub fn pipeline_ops_filter_high_score(items: &Vec<Item>, threshold: u32) -> Vec<Item> {
        let mut pipeline_result: Vec<Item> = Vec::new();
        for v in items {
            if i32::from_ne_bytes(((v.score) as i32).to_ne_bytes()) >= i32::from_ne_bytes(((threshold) as i32).to_ne_bytes()) {
                pipeline_result.push(v.clone());
            }
        }
        return pipeline_result;
    }

    pub fn pipeline_ops_mint_capture_filter(items: &Vec<Item>) -> Vec<Item> {
        let pipeline_threshold = 20u32;
        let mut pipeline_result: Vec<Item> = Vec::new();
        for v in items {
            if i32::from_ne_bytes(((v.score) as i32).to_ne_bytes()) >= i32::from_ne_bytes(((pipeline_threshold) as i32).to_ne_bytes()) {
                pipeline_result.push(v.clone());
            }
        }
        return pipeline_result;
    }

    pub fn pipeline_ops_sum_scores(items: &Vec<Item>) -> u32 {
        let mut total = 0u32;
        for item in items {
            total = u32::wrapping_add(total, item.score);
        }
        return total;
    }

    pub fn pipeline_ops_associate_by_id(items: &Vec<Item>) -> SortedMapTable<u32, UString> {
        let mut pipeline_builder: SortedMapTableBuilder<u32, UString> = SortedTable::sorted_table_map_builder::<u32,
UString>(Arc::new(|a, b| SortedTable::sorted_table_compare_ints(i32::from_ne_bytes(((*a) as i32).to_ne_bytes()), i32::from_ne_bytes(((*b) as i32).to_ne_bytes()))));
        for item in items {
            pipeline_builder.put(&(item.id), &(item.name).to_ustring());
        }
        let pipeline_result: SortedMapTable<u32, UString> = pipeline_builder.clone().build();
        return pipeline_result;
    }

    pub fn pipeline_ops_sort_by_score(items: &Vec<Item>) -> Vec<Item> {
        let pipeline_result = {
    let mut _sorted = items.to_vec();
    _sorted.sort_by_key(|item| item.score);
    _sorted
};
        return pipeline_result;
    }

    pub fn pipeline_ops_high_scorer_names(items: &Vec<Item>, min_score: u32) -> Vec<UString> {
        let mut pipeline_result: Vec<Item> = Vec::new();
        for v in items {
            if i32::from_ne_bytes(((v.score) as i32).to_ne_bytes()) >= i32::from_ne_bytes(((min_score) as i32).to_ne_bytes()) {
                pipeline_result.push(v.clone());
            }
        }
        let high_scorers = (pipeline_result).clone();
        let capacity = high_scorers.len();
        let mut pipeline_result1 = Vec::with_capacity(capacity);
        for pipeline_index1 in 0..match u32::try_from(high_scorers.len()) { Ok(value) => value, Err(_) => u32::MAX } {
            let v = (high_scorers[usize::try_from(pipeline_index1).unwrap_or(0)]).clone();
            pipeline_result1.push((v.name).to_ustring());
        }
        return pipeline_result1;
    }

    pub fn pipeline_ops_chained_filter_map(numbers: &Vec<u32>) -> Vec<u32> {
        let mut pipeline_result: Vec<u32> = Vec::new();
        for &v in numbers {
            if u32::from_ne_bytes((({ let v: u32 = v; i32::from_ne_bytes(v.to_ne_bytes()) } % 2i32) as u32).to_ne_bytes()) == 0 {
                pipeline_result.push(v);
            }
        }
        let _this = (pipeline_result).clone();
        let capacity = _this.len();
        let mut pipeline_result1 = Vec::with_capacity(capacity);
        for pipeline_index1 in 0..match u32::try_from(_this.len()) { Ok(value) => value, Err(_) => u32::MAX } {
            let v = _this[usize::try_from(pipeline_index1).unwrap_or(0)];
            pipeline_result1.push(u32::wrapping_mul(v, 10));
        }
        return pipeline_result1;
    }

    pub fn pipeline_ops_nested_loop_map(matrix: &Vec<Vec<u32>>, offset: u32) -> Vec<Vec<u32>> {
        let capacity = matrix.len();
        let mut result = Vec::with_capacity(capacity);
        for r in 0..match u32::try_from(matrix.len()) { Ok(value) => value, Err(_) => u32::MAX } {
            let row = (matrix[usize::try_from(r).unwrap_or(0)]).clone();
            let capacity = row.len();
            let mut pipeline_result = Vec::with_capacity(capacity);
            for pipeline_index in 0..match u32::try_from(row.len()) { Ok(value) => value, Err(_) => u32::MAX } {
                let v = row[usize::try_from(pipeline_index).unwrap_or(0)];
                pipeline_result.push(u32::wrapping_add(v, offset));
            }
            let mapped_row = (pipeline_result).clone();
            result.push(mapped_row.clone());
        }
        return result;
    }

    pub fn pipeline_ops_has_high_score(items: &Vec<Item>, threshold: u32) -> bool {
        let mut pipeline_result = false;
        for item in items {
            if i32::from_ne_bytes(((item.score) as i32).to_ne_bytes()) >= i32::from_ne_bytes(((threshold) as i32).to_ne_bytes()) {
                pipeline_result = true;
                break;
            }
        }
        return pipeline_result;
    }

    pub fn pipeline_ops_all_above_score(items: &Vec<Item>, threshold: u32) -> bool {
        let mut pipeline_result = true;
        for item in items {
            if !((i32::from_ne_bytes(((item.score) as i32).to_ne_bytes())) >= i32::from_ne_bytes(((threshold) as i32).to_ne_bytes())) {
                pipeline_result = false;
                break;
            }
        }
        return pipeline_result;
    }

    pub fn pipeline_ops_find_first_high_score(items: &Vec<Item>, threshold: u32) -> Option<Item> {
        let mut pipeline_result: Option<Item> = None;
        for item in items {
            if i32::from_ne_bytes(((item.score) as i32).to_ne_bytes()) >= i32::from_ne_bytes(((threshold) as i32).to_ne_bytes()) {
                pipeline_result = Some(item.clone());
                break;
            }
        }
        return pipeline_result;
    }

    pub fn pipeline_ops_total_score(items: &Vec<Item>) -> u32 {
        let mut pipeline_result = 0u32;
        for item in items {
            pipeline_result = u32::wrapping_add(pipeline_result, item.score);
        }
        return pipeline_result;
    }

    pub fn pipeline_ops_total_weighted_score(items: &Vec<Item>, weight: f32) -> f32 {
        let mut pipeline_result: f64 = 0.0f64;
        for item in items {
            pipeline_result += (format!("{}", (i32::from_ne_bytes(((item.score) as i32).to_ne_bytes()))).parse::<f32>().unwrap_or(0.0) * weight) as f64;
        }
        return pipeline_result as f32;
    }

    pub fn pipeline_ops_extract_valid_names(items: &Vec<Item>, min_score: u32) -> Vec<UString> {
        let mut pipeline_result: Vec<UString> = Vec::new();
        for item in items {
            let mut valid_name: Option<UString> = None;
            if i32::from_ne_bytes(((item.score) as i32).to_ne_bytes()) >= i32::from_ne_bytes(((min_score) as i32).to_ne_bytes()) {
                valid_name = Some((item.name).to_ustring());
            }
            {
                let pipeline_item = (valid_name).clone();
                match &(pipeline_item) {
                    Some(__option) => {
                        pipeline_result.push((__option).clone());
                    }
                    None => {
                    }
                }
            }
        }
        return pipeline_result;
    }

    pub fn pipeline_ops_duplicate_scores(items: &Vec<Item>) -> Vec<u32> {
        let mut pipeline_result: Vec<u32> = Vec::new();
        for item in items {
            let mut scores: Vec<u32> = Vec::new();
            if i32::from_ne_bytes(((item.score) as i32).to_ne_bytes()) > (0) {
                scores.push(item.score);
                scores.push(u32::wrapping_mul(item.score, 2));
            }
            {
                let pipeline_inner = (scores).clone();
                for pipeline_index1 in 0..match u32::try_from(pipeline_inner.len()) { Ok(value) => value, Err(_) => u32::MAX } {
                    pipeline_result.push(pipeline_inner[usize::try_from(pipeline_index1).unwrap_or(0)]);
                }
            }
        }
        return pipeline_result;
    }

    pub fn pipeline_ops_group_names_by_score(items: &Vec<Item>) -> SortedMapTable<u32, Vec<UString>> {
        let mut pipeline_builder: SortedMapTableBuilder<u32, Vec<UString>> = SortedTable::sorted_table_map_builder::<u32,
Vec<UString>>(Arc::new(|a, b| SortedTable::sorted_table_compare_ints(i32::from_ne_bytes(((*a) as i32).to_ne_bytes()), i32::from_ne_bytes(((*b) as i32).to_ne_bytes()))));
        for item in items {
            let pipeline_entry = ItemKeyVal { key: item.score, value: (item.name).to_ustring().clone() };
            let mut pipeline_bucket = match pipeline_builder.get(&(pipeline_entry.key)) {
                Some(b) => b,
                None => Vec::new(),
            };
            pipeline_bucket.push((pipeline_entry.value).to_ustring());
            pipeline_builder.put(&(pipeline_entry.key), &pipeline_bucket);
        }
        let pipeline_result: SortedMapTable<u32, Vec<UString>> = pipeline_builder.clone().build();
        return pipeline_result;
    }
}

#[derive(Debug, Clone, PartialEq)]
pub struct Item {
    pub id: u32,
    pub name: UString,
    pub score: u32,
}

pub fn compare_item(a: &Item, b: &Item) -> i32 {
    let cmp_id = match i32::from_ne_bytes((a.id).to_ne_bytes()).cmp(&i32::from_ne_bytes((b.id).to_ne_bytes())) { core::cmp::Ordering::Less => -1, core::cmp::Ordering::Equal => 0, core::cmp::Ordering::Greater => 1 };
    if cmp_id != 0 { return cmp_id; }
    let cmp_name = SortedTable::sorted_table_compare_strings(a.name.as_ustr(), b.name.as_ustr());
    if cmp_name != 0 { return cmp_name; }
    let cmp_score = match i32::from_ne_bytes((a.score).to_ne_bytes()).cmp(&i32::from_ne_bytes((b.score).to_ne_bytes())) { core::cmp::Ordering::Less => -1, core::cmp::Ordering::Equal => 0, core::cmp::Ordering::Greater => 1 };
    if cmp_score != 0 { return cmp_score; }
    0
}

#[derive(Debug, Clone, PartialEq)]
pub struct ItemKeyVal {
    pub key: u32,
    pub value: UString,
}

pub fn compare_item_key_val(a: &ItemKeyVal, b: &ItemKeyVal) -> i32 {
    let cmp_key = match i32::from_ne_bytes((a.key).to_ne_bytes()).cmp(&i32::from_ne_bytes((b.key).to_ne_bytes())) { core::cmp::Ordering::Less => -1, core::cmp::Ordering::Equal => 0, core::cmp::Ordering::Greater => 1 };
    if cmp_key != 0 { return cmp_key; }
    let cmp_value = SortedTable::sorted_table_compare_strings(a.value.as_ustr(), b.value.as_ustr());
    if cmp_value != 0 { return cmp_value; }
    0
}
