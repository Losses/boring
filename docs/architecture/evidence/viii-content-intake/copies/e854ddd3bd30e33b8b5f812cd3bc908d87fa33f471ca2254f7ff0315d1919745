package boring

import boring.runtime.test.Test

object MathNaNTestSupport {
    fun assertNaN(value: Float, message: String) {
        Test.equals(true, value != value, message)
    }

    fun assertNegativeZero(value: Float, message: String) {
        Test.equals(0.0f, value, message)
        Test.equals(true, 1.0f / value < 0.0f, message + " (sign)")
    }

    fun assertPositiveZero(value: Float, message: String) {
        Test.equals(0.0f, value, message)
        Test.equals(true, 1.0f / value > 0.0f, message + " (sign)")
    }
}
