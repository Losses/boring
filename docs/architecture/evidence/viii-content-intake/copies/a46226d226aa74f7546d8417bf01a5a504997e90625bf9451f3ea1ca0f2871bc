use crate::runtime::u_string::UStr;
use crate::runtime::u_string::UString;


#[derive(Clone, PartialEq)]
pub struct PrivateStaticCallHolder {
    pub value: UString,
}

impl PrivateStaticCallHolder {
    pub fn new(value: &UStr) -> Self {
        Self {
            value: value.to_ustring(),
        }
    }

    pub(crate) fn private_static_call_holder_empty() -> PrivateStaticCallHolder {
        return PrivateStaticCallHolder::new(&(UStr::new(&[101,109,112,116,121])));
    }

    pub fn private_static_call_holder_make(v: Option<UString>) -> PrivateStaticCallHolder {
        return match &(v) { None => PrivateStaticCallHolder::private_static_call_holder_empty(), Some(__option) => PrivateStaticCallHolder::new(__option) };
    }
}
