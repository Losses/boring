#![cfg(test)]

use crate::boring::haxe_exception_ops::HaxeExceptionFault;
use crate::boring::union_chain_ops::UnionChainOps;
use crate::boring::value_exception::ValueError;
use crate::runtime::test as testlib;
use crate::runtime::test_core;
use crate::runtime::u_string::UStr;


#[test]
fn chained_union() {
    testlib::run("tests.UnionChainTests.chainedUnion", "tests.UnionChainTests.chainedUnion: a repeated callee union stays convertible through a chained caller", || {
        test_core::TestCore::test_core_equals_int(5i32, i32::from_ne_bytes(((UnionChainOps::union_chain_ops_outer(5).unwrap()) as i32).to_ne_bytes()), UStr::new(&[]));
        let mut alpha_caught = false;
        let __outcome: Result<u32, HaxeExceptionFault> = (|| {
            return Ok(UnionChainOps::union_chain_ops_outer(4294967295u32).map_err(|e| HaxeExceptionFault::new(&format!("{}", e)))?);
        })();
        match __outcome {
            Ok(_) => {}
            Err(_) => {
                alpha_caught = true;
            }
        }
        test_core::TestCore::test_core_equals_bool(true, alpha_caught, UStr::new(&[]));
        let mut beta_caught = false;
        let __outcome1: Result<u32, ValueError> = (|| {
            return Ok(UnionChainOps::union_chain_ops_outer(11)?);
        })();
        match __outcome1 {
            Ok(_) => {}
            Err(_) => {
                beta_caught = true;
            }
        }
        test_core::TestCore::test_core_equals_bool(true, beta_caught, UStr::new(&[]));
    });
}
