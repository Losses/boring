package tests

import boring.PayloadTextTable
import boring.ScriptEvidenceTable
import boring.WordCharacterTable
import boring.runtime.test.Test

class DataTableTests {
@boring.test.Test
    fun testScriptFirstRecord() {
        Test.run("tests.DataTableTests.testScriptFirstRecord", "tests.DataTableTests.testScriptFirstRecord: script table first record hits") {
                Test.equals(1, ScriptEvidenceTable.classify(32), "first record start hit")
                Test.equals(1, ScriptEvidenceTable.classify(80), "first record interior hit")
                Test.equals(1, ScriptEvidenceTable.classify(126), "first record end hit")
        }
    }

@boring.test.Test
    fun testScriptLastRecord() {
        Test.run("tests.DataTableTests.testScriptLastRecord", "tests.DataTableTests.testScriptLastRecord: script table last record hits") {
                Test.equals(23, ScriptEvidenceTable.classify(195072), "last record start hit")
                Test.equals(23, ScriptEvidenceTable.classify(195088), "last record interior hit")
                Test.equals(23, ScriptEvidenceTable.classify(195103), "last record end hit")
        }
    }

@boring.test.Test
    fun testScriptMisses() {
        Test.run("tests.DataTableTests.testScriptMisses", "tests.DataTableTests.testScriptMisses: script table boundary misses") {
                Test.equals(0, ScriptEvidenceTable.classify(0), "below first record miss")
                Test.equals(0, ScriptEvidenceTable.classify(31), "immediately below first record miss")
                Test.equals(0, ScriptEvidenceTable.classify(127), "in gap between records miss")
                Test.equals(0, ScriptEvidenceTable.classify(128), "in gap between records miss")
                Test.equals(0, ScriptEvidenceTable.classify(159), "immediately before second record miss")
                Test.equals(0, ScriptEvidenceTable.classify(195104), "immediately above last record miss")
                Test.equals(0, ScriptEvidenceTable.classify(1114111), "far above last record miss")
        }
    }

@boring.test.Test
    fun testScriptIntermediateRecords() {
        Test.run("tests.DataTableTests.testScriptIntermediateRecords", "tests.DataTableTests.testScriptIntermediateRecords: script table intermediate record classifications") {
                Test.equals(2, ScriptEvidenceTable.classify(880), "Greek record start")
                Test.equals(3, ScriptEvidenceTable.classify(1024), "Cyrillic record start")
                Test.equals(21, ScriptEvidenceTable.classify(19968), "CJK Unified Ideographs start")
                Test.equals(21, ScriptEvidenceTable.classify(28672), "CJK Unified Ideographs mid")
                Test.equals(21, ScriptEvidenceTable.classify(40959), "CJK Unified Ideographs end")
                Test.equals(22, ScriptEvidenceTable.classify(44032), "Hangul Syllables start")
        }
    }

@boring.test.Test
    fun testWordFirstRecord() {
        Test.run("tests.DataTableTests.testWordFirstRecord", "tests.DataTableTests.testWordFirstRecord: word character table first record hits") {
                Test.equals(true, WordCharacterTable.contains(48), "digit 0 start hit")
                Test.equals(true, WordCharacterTable.contains(53), "digit 5 mid hit")
                Test.equals(true, WordCharacterTable.contains(57), "digit 9 end hit")
        }
    }

@boring.test.Test
    fun testWordLastRecord() {
        Test.run("tests.DataTableTests.testWordLastRecord", "tests.DataTableTests.testWordLastRecord: word character table last record hits") {
                Test.equals(true, WordCharacterTable.contains(131072), "last record start hit")
                Test.equals(true, WordCharacterTable.contains(131088), "last record mid hit")
                Test.equals(true, WordCharacterTable.contains(131103), "last record end hit")
        }
    }

@boring.test.Test
    fun testWordMisses() {
        Test.run("tests.DataTableTests.testWordMisses", "tests.DataTableTests.testWordMisses: word character table misses and gaps") {
                Test.equals(false, WordCharacterTable.contains(0), "null byte miss")
                Test.equals(false, WordCharacterTable.contains(47), "char before digits miss")
                Test.equals(false, WordCharacterTable.contains(58), "char after digits miss")
                Test.equals(false, WordCharacterTable.contains(64), "char before uppercase miss")
                Test.equals(false, WordCharacterTable.contains(96), "char before lowercase miss")
                Test.equals(false, WordCharacterTable.contains(131104), "char above last record miss")
        }
    }

@boring.test.Test
    fun testWordSingletons() {
        Test.run("tests.DataTableTests.testWordSingletons", "tests.DataTableTests.testWordSingletons: word character table singleton ranges") {
                Test.equals(true, WordCharacterTable.contains(95), "underscore singleton hit")
                Test.equals(false, WordCharacterTable.contains(94), "before underscore miss")
                Test.equals(false, WordCharacterTable.contains(96), "after underscore miss")
        }
    }

@boring.test.Test
    fun testPayloadUnits() {
        Test.run("tests.DataTableTests.testPayloadUnits", "tests.DataTableTests.testPayloadUnits: payload table unit count and edge units") {
                Test.equals(186, PayloadTextTable.unitCount(), "payload unit count")
                Test.equals(115, PayloadTextTable.unitAt(0), "first unit is s")
                Test.equals(10, PayloadTextTable.unitAt(185), "last unit is line feed")
                Test.equals(233, PayloadTextTable.unitAt(184), "latin small letter e with acute unit")
        }
    }

@boring.test.Test
    fun testPayloadRoundtrip() {
        Test.run("tests.DataTableTests.testPayloadRoundtrip", "tests.DataTableTests.testPayloadRoundtrip: payload table decodes back to the file content") {
                val expected = "synthetic payload for boring spec 20 raw payload tables" + "\n" + "second line with \"quotes\" and \\ backslash" + "\n" + "third line plain digits 0123456789" + "\n" + "final line with latin small letter e with acute café" + "\n"
                Test.equals(expected, PayloadTextTable.text(), "decoded payload equals file content")
        }
    }
}
