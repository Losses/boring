package boring

data class PrintedCustom(val value: Int) {

    override fun toString(): String {
        return "custom=" + this.value
    }
}

fun comparePrintedCustom(a: PrintedCustom, b: PrintedCustom): Int {
    var cmp = 0
    cmp = a.value.compareTo(b.value)
    if (cmp != 0) return cmp
    return 0
}
