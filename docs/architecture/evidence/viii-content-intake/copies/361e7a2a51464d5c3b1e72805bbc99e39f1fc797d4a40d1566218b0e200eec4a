package boring

class AllowGuest {
    fun useMethod(): String {
        val h = AllowHost()
        return h.secretMethod() + h.tag
    }

    companion object {
        fun useStatic(v: Int): Int {
            return AllowHost.secretStatic(v)
        }

        fun useCounter(): Int {
            AllowHost.counter = AllowHost.counter + 2
            return AllowHost.counter
        }
    }
}
