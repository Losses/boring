#![cfg(test)]

use crate::boring::borrowed_iteration_subject_ops::BorrowedIterationSubjectOps;
use crate::runtime::test as testlib;
use crate::runtime::test_core;
use crate::runtime::u_string::UStr;
use crate::runtime::u_string::UString;
use std::fmt::Write;


#[test]
fn unique() {
    testlib::run("tests.BorrowedIterationSubjectOpsTests.unique", "tests.BorrowedIterationSubjectOpsTests.unique: an element loop borrows an already-referenced subject once", || {
        let values = vec![3, 1, 3, 2, 1];
        test_core::TestCore::test_core_equals_string(UStr::new(&[51,44,49,44,50]), (UString::from(format!("{}", { let joined1 = BorrowedIterationSubjectOps::borrowed_iteration_subject_ops_unique(&values); let mut out = String::new(); let n = joined1.len(); let mut index1 = 0usize; while index1 < n { if index1 > 0 { out.push_str(","); } let _ = write!(out, "{}", joined1[index1]); index1 += 1; } UString::from(out.as_str()) }).as_str())).as_ustr(), UStr::new(&[112,97,114,97,109,101,116,101,114]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[51,44,49,44,50]), (UString::from(format!("{}", { let joined3 = BorrowedIterationSubjectOps::borrowed_iteration_subject_ops_unique_nullable(Some((values).clone())); let mut out = String::new(); let n = joined3.len(); let mut index3 = 0usize; while index3 < n { if index3 > 0 { out.push_str(","); } let _ = write!(out, "{}", joined3[index3]); index3 += 1; } UString::from(out.as_str()) }).as_str())).as_ustr(), UStr::new(&[110,117,108,108,97,98,108,101]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[51,44,49,44,50]), (UString::from(format!("{}", { let joined5 = BorrowedIterationSubjectOps::borrowed_iteration_subject_ops_unique_through_local(&values); let mut out = String::new(); let n = joined5.len(); let mut index5 = 0usize; while index5 < n { if index5 > 0 { out.push_str(","); } let _ = write!(out, "{}", joined5[index5]); index5 += 1; } UString::from(out.as_str()) }).as_str())).as_ustr(), UStr::new(&[108,111,99,97,108]));
    });
}
