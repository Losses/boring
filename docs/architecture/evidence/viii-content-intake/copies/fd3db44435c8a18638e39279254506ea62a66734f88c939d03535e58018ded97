#![cfg(test)]

use crate::boring::div_table_ops::DivTableOps;
use crate::runtime::test as testlib;
use crate::runtime::test_core;
use crate::runtime::u_string::UStr;


#[test]
fn test_div() {
    testlib::run("tests.DivTableTests.testDiv", "tests.DivTableTests.testDiv: length division by constant lowers to integer division", || {
        test_core::TestCore::test_core_equals_bool(true, (DivTableOps::div_table_ops_lookup(32)) <= 2147483647, UStr::new(&[]));
    });
}
