#[test]
fn test_nullable_comparison_argument() {
    testlib::run("tests.KotlinNullabilityTests.testNullableComparisonArgument", "tests.KotlinNullabilityTests.testNullableComparisonArgument: a nullable receiver comparison keeps its value at a Bool argument", || {
        test_core::TestCore::test_core_equals_bool(true, KotlinNullGuardArgOps::kotlin_null_guard_arg_ops_flag_present(KotlinNullGuardArgOps::kotlin_null_guard_arg_ops_present()), UStr::new(&[116,104,101,32,103,117,97,114,100,101,100,32,112,114,111,112,101,114,116,121,32,114,101,97,100,115,32,112,114,101,115,101,110,116]));
        test_core::TestCore::test_core_equals_bool(false, KotlinNullGuardArgOps::kotlin_null_guard_arg_ops_flag_present(KotlinNullGuardArgOps::kotlin_null_guard_arg_ops_null_flag()), UStr::new(&[97,32,110,117,108,108,32,112,114,111,112,101,114,116,121,32,107,101,101,112,115,32,116,104,101,32,103,117,97,114,100,32,102,97,108,115,101]));
        test_core::TestCore::test_core_equals_bool(true, KotlinNullGuardArgOps::kotlin_null_guard_arg_ops_count_is_three(KotlinNullGuardArgOps::kotlin_null_guard_arg_ops_present()), UStr::new(&[116,104,101,32,112,114,111,112,101,114,116,121,32,101,113,117,97,108,115,32,116,104,101,32,99,111,110,115,116,97,110,116]));
        test_core::TestCore::test_core_equals_bool(false, KotlinNullGuardArgOps::kotlin_null_guard_arg_ops_count_is_three(KotlinNullGuardArgOps::kotlin_null_guard_arg_ops_null_flag()), UStr::new(&[97,32,110,117,108,108,32,112,114,111,112,101,114,116,121,32,110,101,118,101,114,32,101,113,117,97,108,115,32,116,104,101,32,99,111,110,115,116,97,110,116]));
    });
}

#[test]
fn test_nullable_comparison_hardening() {
    testlib::run("tests.KotlinNullabilityTests.testNullableComparisonHardening", "tests.KotlinNullabilityTests.testNullableComparisonHardening: a nullable receiver comparison survives ctor and array element boundaries", || {
        test_core::TestCore::test_core_equals_bool(true, KotlinNullGuardArgOps::kotlin_null_guard_arg_ops_flag_present_ctor(KotlinNullGuardArgOps::kotlin_null_guard_arg_ops_present()), UStr::new(&[]));
        test_core::TestCore::test_core_equals_bool(false, KotlinNullGuardArgOps::kotlin_null_guard_arg_ops_flag_present_ctor(KotlinNullGuardArgOps::kotlin_null_guard_arg_ops_null_flag()), UStr::new(&[]));
        let present_flags = KotlinNullGuardArgOps::kotlin_null_guard_arg_ops_flag_presence_list(KotlinNullGuardArgOps::kotlin_null_guard_arg_ops_present());
        let absent_flags = KotlinNullGuardArgOps::kotlin_null_guard_arg_ops_flag_presence_list(KotlinNullGuardArgOps::kotlin_null_guard_arg_ops_null_flag());
        test_core::TestCore::test_core_equals_int(1i32, i32::from_ne_bytes(((u32::try_from((present_flags.len()) & 0xFFFF_FFFF).unwrap_or(0)) as i32).to_ne_bytes()), UStr::new(&[]));
        test_core::TestCore::test_core_equals_int(1i32, i32::from_ne_bytes(((u32::try_from((absent_flags.len()) & 0xFFFF_FFFF).unwrap_or(0)) as i32).to_ne_bytes()), UStr::new(&[]));
        test_core::TestCore::test_core_equals_bool(true, present_flags[0usize], UStr::new(&[]));
        test_core::TestCore::test_core_equals_bool(false, absent_flags[0usize], UStr::new(&[]));
    });
}

