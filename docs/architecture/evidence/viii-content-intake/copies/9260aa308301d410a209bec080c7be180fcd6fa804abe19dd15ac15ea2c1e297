#[derive(Clone, Copy)]
pub struct KotlinNestedNullReturnOps;

impl KotlinNestedNullReturnOps {
    pub fn kotlin_nested_null_return_ops_anonymous_lookup(key: u32) -> UString {
        let lookup: Arc<dyn Fn(u32) -> Option<UString> + Send + Sync + 'static> = {  Arc::new(move |k| {
        if k == 0 {
            return None;
        }
        return Some(UString::from("hit").to_ustring());
}) };
        let value = lookup(key);
        if value.is_none() {
            return UString::from("none").to_ustring();
        }
        return (value).as_deref().unwrap_or(UStr::new(&[])).to_ustring();
    }

    pub(crate) fn kotlin_nested_null_return_ops_apply_lookup(r#fn: Arc<dyn Fn(u32) -> Option<UString> + Send + Sync>, key: u32) -> UString {
        let value = r#fn(key);
        if value.is_none() {
            return UString::from("none").to_ustring();
        }
        return (value).as_deref().unwrap_or(UStr::new(&[])).to_ustring();
    }

    pub fn kotlin_nested_null_return_ops_applied_lookup(key: u32) -> UString {
        return KotlinNestedNullReturnOps::kotlin_nested_null_return_ops_apply_lookup({  Arc::new(move |k| {
        if k == 0 {
            return None;
        }
        return Some(UString::from("hit").to_ustring());
}) }, key);
    }

    pub fn kotlin_nested_null_return_ops_named_lookup(key: u32) -> UString {
        let lookup: Arc<dyn Fn(u32) -> Option<UString> + Send + Sync + 'static> = {  Arc::new(move |k| {
        if k == 0 {
            return None;
        }
        return Some(UString::from("hit").to_ustring());
}) };
        let value = lookup(key);
        if value.is_none() {
            return UString::from("none").to_ustring();
        }
        return (value).as_deref().unwrap_or(UStr::new(&[])).to_ustring();
    }
}

