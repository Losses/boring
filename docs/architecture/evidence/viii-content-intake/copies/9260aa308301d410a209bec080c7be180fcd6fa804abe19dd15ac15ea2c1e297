}

#[derive(Clone, Copy)]
pub struct KotlinNullGuardArgOps;

impl KotlinNullGuardArgOps {
    pub fn kotlin_null_guard_arg_ops_present() -> Option<KotlinNullGuardHolder> {
        return Some(KotlinNullGuardHolder::new(Some(UString::from("flag")), Some(3)));
    }

    pub fn kotlin_null_guard_arg_ops_absent() -> Option<KotlinNullGuardHolder> {
        return None;
    }

    pub fn kotlin_null_guard_arg_ops_null_flag() -> Option<KotlinNullGuardHolder> {
        return Some(KotlinNullGuardHolder::new(None.clone(), None));
    }

    pub fn kotlin_null_guard_arg_ops_accepts_flag(flag: bool) -> bool {
        return flag;
    }

    pub fn kotlin_null_guard_arg_ops_flag_present(holder: Option<KotlinNullGuardHolder>) -> bool {
        return KotlinNullGuardArgOps::kotlin_null_guard_arg_ops_accepts_flag((holder.as_ref().unwrap().flag).clone().is_some());
    }

    pub fn kotlin_null_guard_arg_ops_count_is_three(holder: Option<KotlinNullGuardHolder>) -> bool {
        return KotlinNullGuardArgOps::kotlin_null_guard_arg_ops_accepts_flag(holder.as_ref().unwrap().count.as_ref().map_or(false, |v| v == &(3)));
    }

    pub fn kotlin_null_guard_arg_ops_flag_present_ctor(holder: Option<KotlinNullGuardHolder>) -> bool {
        let wrapped = KotlinNullGuardBool::new((holder.as_ref().unwrap().flag).clone().is_some());
        return wrapped.value;
    }

    pub fn kotlin_null_guard_arg_ops_flag_presence_list(holder: Option<KotlinNullGuardHolder>) -> Vec<bool> {
        let flags = vec![(holder.as_ref().unwrap().flag).clone().is_some()];
        return flags;
    }
}

