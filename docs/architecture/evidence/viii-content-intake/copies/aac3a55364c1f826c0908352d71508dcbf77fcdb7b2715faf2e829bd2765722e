#[derive(Debug, Clone, PartialEq)]
pub enum NoSuchElementFault {
    Missing,
}

impl std::fmt::Display for NoSuchElementFault {
    fn fmt(&self, formatter: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        match self {
            NoSuchElementFault::Missing => write!(formatter, "{}", "no such element"),
        }
    }
}

impl std::error::Error for NoSuchElementFault {}
