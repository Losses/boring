    fn as_any(&self) -> &dyn std::any::Any;
    fn clone_box(&self) -> Box<dyn DrawKind>;
}

impl Clone for Box<dyn DrawKind> {
    fn clone(&self) -> Self {
        self.clone_box()
    }
}

impl std::fmt::Debug for dyn DrawKind {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        write!(f, "{}", self.__haxe_type_name())
    }
}

