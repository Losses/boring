#[derive(Clone, Copy)]
pub struct SealedVariantOps;

impl SealedVariantOps {
    pub fn sealed_variant_ops_label_of(kind: Box<dyn DrawKind>) -> UString {
        if kind.__haxe_type_name() == "boring.SealedVariantOps.NoneDrawKind" {
            return UString::from("none").to_ustring();
        }
        if kind.__haxe_type_name() == "boring.SealedVariantOps.StripeDrawKind" {
            return UString::from("stripe").to_ustring();
        }
        if kind.__haxe_type_name() == "boring.SealedVariantOps.DotDrawKind" {
            return UString::from("dot").to_ustring();
        }
        return UString::from("unknown").to_ustring();
    }

    pub fn sealed_variant_ops_none_label() -> UString {
        return UString::from(format!("{}", { let __guard = NONE_DRAW_KIND_INSTANCE.lock().unwrap_or_else(|e| e.into_inner()); __guard.clone() }.to_string()).as_str());
    }
}
