#![cfg(test)]

use crate::registry::semver::Semver;
use crate::runtime::test as testlib;
use crate::runtime::test_core;
use crate::runtime::u_string::UStr;


#[test]
fn ordering() {
    testlib::run("tests.RegistrySemverTests.ordering", "tests.RegistrySemverTests.ordering: semver orders prereleases before releases", || {
        test_core::TestCore::test_core_equals_int(-1i32, i32::from_ne_bytes(((Semver::semver_compare(UStr::new(&[49,46,48,46,48,45,97,108,112,104,97,46,49]), UStr::new(&[49,46,48,46,48,45,98,101,116,97]))) as i32).to_ne_bytes()), UStr::new(&[]));
        test_core::TestCore::test_core_equals_int(-1i32, i32::from_ne_bytes(((Semver::semver_compare(UStr::new(&[49,46,48,46,48,45,114,99,46,49]), UStr::new(&[49,46,48,46,48]))) as i32).to_ne_bytes()), UStr::new(&[]));
        test_core::TestCore::test_core_equals_bool(true, Semver::semver_is_prerelease(UStr::new(&[50,46,48,46,48,45,100,101,118])), UStr::new(&[]));
    });
}
