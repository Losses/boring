package tests

import boring.MathMinMaxOps
import boring.runtime.test.Test

class MathMinMaxTests {
@boring.test.Test
    fun minFloat() {
        Test.run("tests.MathMinMaxTests.minFloat", "tests.MathMinMaxTests.minFloat: Math.min returns the lesser float operand") {
                Test.equals(1.5, MathMinMaxOps.smaller(1.5, 2.5), null)
                Test.equals(1.5, MathMinMaxOps.smaller(2.5, 1.5), null)
                Test.equals(-3.0, MathMinMaxOps.smaller(-3.0, -1.0), null)
        }
    }

@boring.test.Test
    fun maxFloat() {
        Test.run("tests.MathMinMaxTests.maxFloat", "tests.MathMinMaxTests.maxFloat: Math.max returns the greater float operand") {
                Test.equals(2.5, MathMinMaxOps.larger(1.5, 2.5), null)
                Test.equals(2.5, MathMinMaxOps.larger(2.5, 1.5), null)
                Test.equals(-1.0, MathMinMaxOps.larger(-3.0, -1.0), null)
        }
    }

@boring.test.Test
    fun intOperands() {
        Test.run("tests.MathMinMaxTests.intOperands", "tests.MathMinMaxTests.intOperands: Math.min and Math.max accept int operands through the float signature") {
                Test.equals(4.0, MathMinMaxOps.smallerOfInts(4, 9), null)
                Test.equals(9.0, MathMinMaxOps.largerOfInts(4, 9), null)
        }
    }

@boring.test.Test
    fun intExpression() {
        Test.run("tests.MathMinMaxTests.intExpression", "tests.MathMinMaxTests.intExpression: Math.max widens an int expression against a literal zero") {
                Test.equals(true, true, null)
        }
    }

@boring.test.Test
    fun absFloat() {
        Test.run("tests.MathMinMaxTests.absFloat", "tests.MathMinMaxTests.absFloat: Math.abs returns the absolute value of the float operand") {
                Test.equals(2.5, MathMinMaxOps.absValue(-2.5), null)
                Test.equals(2.5, MathMinMaxOps.absValue(2.5), null)
                Test.equals(0.0, MathMinMaxOps.absValue(-0.0), null)
        }
    }

@boring.test.Test
    fun absInt() {
        Test.run("tests.MathMinMaxTests.absInt", "tests.MathMinMaxTests.absInt: Math.abs accepts an int operand through the float signature") {
                Test.equals(7.0, MathMinMaxOps.absOfInts(7), null)
        }
    }

@boring.test.Test
    fun powFloat() {
        Test.run("tests.MathMinMaxTests.powFloat", "tests.MathMinMaxTests.powFloat: Math.pow raises the base to the exponent") {
                Test.equals(8.0, MathMinMaxOps.power(2.0, 3.0), null)
                Test.equals(0.25, MathMinMaxOps.power(2.0, -2.0), null)
                Test.equals(1.0, MathMinMaxOps.power(5.0, 0.0), null)
        }
    }

@boring.test.Test
    fun powInt() {
        Test.run("tests.MathMinMaxTests.powInt", "tests.MathMinMaxTests.powInt: Math.pow accepts int operands through the float signature") {
                Test.equals(9.0, MathMinMaxOps.powerOfInts(3, 2), null)
        }
    }

@boring.test.Test
    fun roundFloat() {
        Test.run("tests.MathMinMaxTests.roundFloat", "tests.MathMinMaxTests.roundFloat: Math.round returns the nearest integer as an int") {
                Test.equals(3, MathMinMaxOps.rounded(2.5), null)
                Test.equals(2, MathMinMaxOps.rounded(2.4), null)
                Test.equals(0, MathMinMaxOps.rounded(0.4), null)
        }
    }

@boring.test.Test
    fun floorCeil() {
        Test.run("tests.MathMinMaxTests.floorCeil", "tests.MathMinMaxTests.floorCeil: Math.floor rounds down and Math.ceil rounds up as ints") {
                Test.equals(2, MathMinMaxOps.floored(2.7), null)
                Test.equals(3, MathMinMaxOps.ceiled(2.1), null)
                Test.equals(0, MathMinMaxOps.floored(0.4), null)
        }
    }
}
