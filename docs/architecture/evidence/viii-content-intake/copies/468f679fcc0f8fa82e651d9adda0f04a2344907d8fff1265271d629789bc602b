use crate::runtime::u_string::UString;


#[derive(Clone, Copy)]
pub struct NilContextOps;

impl NilContextOps {
    pub fn nil_context_ops_conditional(flag: bool) -> Option<UString> {
        return if flag { Some(UString::from("present")) } else { None };
    }

    pub fn nil_context_ops_null_argument() -> UString {
        return NilContextOps::nil_context_ops_choose(None.clone());
    }

    pub(crate) fn nil_context_ops_choose(value: Option<UString>) -> UString {
        return match &(value) { None => UString::from("empty"), Some(__option) => __option.to_ustring() };
    }
}
