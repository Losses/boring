#!/usr/bin/env bash
# P08 behaviour-matrix harness runner.
# NOTE: dc-warn is a fuse.rclone mount (no exec bits, no symlinks) - run as
#   bash harness/run-matrix.sh
# Exit codes are never read through pipes (recorded trap).
set -u
TREE=/home/losses/Development/tq-workspace/boring-wt-architecture
EV=/home/losses/Development/tq-workspace/dc-warn/out/p08-behaviour-matrix/evidence
FIX=/home/losses/Development/tq-workspace/dc-warn/out/p08-behaviour-matrix/harness/fixture
GAPFIX=/home/losses/Development/tq-workspace/dc-warn/out/gap-fixture-archive/fixture
export PATH="$(grep -m1 '^PATH=' /home/losses/Development/tq-workspace/dc-warn/out/chainA-fixed-rerun/evidence/env.json | cut -d= -f2-)"
cd "$TREE"   # haxe needs cwd = tree root (repo-local .haxelib)

echo "== identity"
git rev-parse HEAD; git status --porcelain | wc -l
sha256sum packages/compiler/reflaxe/swift/swiftcompiler/SwiftExpr.hx \
  tests/swift-readonly-boundary/boring/ReadOnlyBoundaryOps.hx \
  tests/swift-readonly-boundary/boring/ReadOnlyBoundaryOracle.hx \
  tests/swift-readonly-boundary/ReadOnlyBoundaryRuntimeTests.swift \
  $FIX/p8l/ClosureLazy.hx $FIX/p8l/ClosureLazyOracle.hx

echo "== input A: oracle + generation"
haxe tests/swift-readonly-boundary/oracle.hxml 2>&1 | sed 's/^[^ ]*\.hx:[0-9]*: //' > $EV/A-oracle.log
haxe tests/swift-readonly-boundary/swift.hxml > $EV/A-gen.log 2>&1; echo "gen rc=$?"

echo "== input A: L3 (swiftc -c, whole module) + L4 (build+run+diff)"
GEN=out/readonly-boundary/current/gen
SHIM_A=tests/swift-readonly-boundary/ReadOnlyBoundaryRuntimeTests.swift
mkdir -p /tmp/p08-obj-acc-c && ( cd /tmp/p08-obj-acc-c && rm -f *.o \
  && swiftc -c $GEN/boring/ReadOnlyBoundaryOps.swift $GEN/boring/ReadOnlyBoundaryOracle.swift \
       $GEN/Runtime.swift $GEN/std/UStringException.swift $GEN/std/UStringFault.swift $SHIM_A ) > $EV/A-swiftcc.log 2>&1
echo "swiftc -c rc=$?  (0-byte log = zero diagnostics)"
mkdir -p /tmp/p08-obj-acc && ( cd /tmp/p08-obj-acc \
  && swiftc -o bin-acc $GEN/boring/ReadOnlyBoundaryOps.swift $GEN/boring/ReadOnlyBoundaryOracle.swift \
       $GEN/Runtime.swift $GEN/std/UStringException.swift $GEN/std/UStringFault.swift $SHIM_A ) > $EV/A-build.log 2>&1
echo "build rc=$?"
timeout 60 /tmp/p08-obj-acc/bin-acc > $EV/A-run.log 2>&1; echo "run rc=$?"
diff $EV/A-oracle.log $EV/A-run.log > $EV/A-diff.log; echo "diff rc=$? (expect 0)"

echo "== input B: oracle + generation"
haxe $FIX/closure-oracle.hxml > $EV/B-oracle-raw.log 2>&1
sed 's/^[^ ]*\.hx:[0-9]*: //' $EV/B-oracle-raw.log > $EV/B-oracle.log
haxe $FIX/closure-swift.hxml > $EV/B-gen.log 2>&1; echo "gen rc=$?"

echo "== input B: L3 + L4"
CL=out/p8l-matrix/current/gen
SHIM_B=$FIX/ClosureLazyRuntimeMain.swift
mkdir -p /tmp/p08-obj-cl-c && ( cd /tmp/p08-obj-cl-c && rm -f *.o \
  && swiftc -c $CL/p8l/ClosureLazy.swift $CL/p8l/ClosureLazyOracle.swift \
       $CL/Runtime.swift $CL/std/UStringException.swift $CL/std/UStringFault.swift $SHIM_B ) > $EV/B-swiftcc.log 2>&1
echo "swiftc -c rc=$?  (expect 1 disclosed probe-origin warning: infinite recursion)"
mkdir -p /tmp/p08-obj-cl && ( cd /tmp/p08-obj-cl \
  && swiftc -o bin-closure $CL/p8l/ClosureLazy.swift $CL/p8l/ClosureLazyOracle.swift \
       $CL/Runtime.swift $CL/std/UStringException.swift $CL/std/UStringFault.swift $SHIM_B ) > $EV/B-build.log 2>&1
echo "build rc=$?"
timeout 60 /tmp/p08-obj-cl/bin-closure > $EV/B-run.log 2>&1; echo "run rc=$? (expect 0 - laziness: termProbe must terminate)"
diff $EV/B-oracle.log $EV/B-run.log > $EV/B-diff.log; echo "diff rc=$? (expect 0)"

echo "== gap fixture: L2 vs L3 trap demonstration"
haxe $GAPFIX/swift-archived.hxml -D swift-output=out/gap-matrix/current/gen > $EV/gap-gen.log 2>&1; echo "gen rc=$?"
G=out/gap-matrix/current/gen
swiftc -typecheck $G/gap/Gap.swift $G/Runtime.swift $G/std/UStringException.swift $G/std/UStringFault.swift > $EV/gap-typecheck.log 2>&1
echo "typecheck rc=$?  (expect 0, EMPTY log - the trap: build-phase diagnostics invisible here)"
mkdir -p /tmp/p08-obj-gap && ( cd /tmp/p08-obj-gap && rm -f *.o \
  && swiftc -c $G/gap/Gap.swift $G/Runtime.swift $G/std/UStringException.swift $G/std/UStringFault.swift ) > $EV/gap-c.log 2>&1
echo "c rc=$?  (expect 0 with 'will never be executed' warning at Gap.swift:117:9)"

echo "== L5 discrimination: six broken-backend variants (each must FAIL its check)"
L5=/tmp/p08-l5; rm -rf $L5
for d in baseline-acc branch-acc alias-acc singlev-acc reference-acc exit-acc eager-cl; do mkdir -p $L5/$d; done
for d in baseline-acc branch-acc alias-acc singlev-acc reference-acc exit-acc; do
  cp $GEN/boring/ReadOnlyBoundaryOps.swift $GEN/boring/ReadOnlyBoundaryOracle.swift \
     $GEN/Runtime.swift $GEN/std/UStringException.swift $GEN/std/UStringFault.swift $SHIM_A $L5/$d/
done
cp $CL/p8l/ClosureLazy.swift $CL/p8l/ClosureLazyOracle.swift $CL/Runtime.swift \
   $CL/std/UStringException.swift $CL/std/UStringFault.swift $SHIM_B $L5/eager-cl/
# mutations (line numbers verified against generated output; L5-BROKEN comments mark each site)
sed -i '230s|let view = flag ? ReadOnlyArray(first) : ReadOnlyArray(second)|let view = ReadOnlyArray(first) // L5-BROKEN: always takes the true branch|' $L5/branch-acc/ReadOnlyBoundaryOps.swift
sed -i '77s|ReadOnlyArray(mutable)|ReadOnlyArray(mutable.copy()) // L5-BROKEN: view is a copy, not an alias|' $L5/alias-acc/ReadOnlyBoundaryOps.swift
sed -i '90a\        let _p = ReadOnlyBoundaryOps.produce() // L5-BROKEN: producer re-evaluated' $L5/singlev-acc/ReadOnlyBoundaryOps.swift
sed -i '99s|var mutable = TiqianArray<ReadOnlyBoundaryBox>(\[box, second\])|var mutable = TiqianArray<ReadOnlyBoundaryBox>([ReadOnlyBoundaryBox(2), ReadOnlyBoundaryBox(5)]) // L5-BROKEN: array holds value copies|' $L5/reference-acc/ReadOnlyBoundaryOps.swift
sed -i '167d' $L5/exit-acc/ReadOnlyBoundaryOps.swift          # deletes the `view = nil` reassignment (stale guard)
# eager-cl (line-anchored; anchors pre-checked so a regenerated file with
# shifted lines fails loudly instead of corrupting the wrong closing brace)
E=$L5/eager-cl/ClosureLazy.swift
[ "$(sed -n '19p' $E)" = "}" ] && [ "$(sed -n '29p' $E)" = "}" ] && [ "$(sed -n '37p' $E)" = "}" ] \
  || { echo "eager-cl anchor lines moved - recompute expected line numbers"; exit 1; }
sed -i 's|_ = { () -> Void in|_ = ({ () -> Void in|' $E
sed -i '19a\        let _e = f() // L5-BROKEN: thunk evaluated at creation' $E
sed -i '30s|^}|})() // L5-BROKEN: never-called thunk evaluated at creation|' $E   # countProbe (post-insert)
sed -i '38s|^}|})() // L5-BROKEN: never-called thunk evaluated at creation|' $E   # termProbe (post-insert)
for d in baseline-acc branch-acc alias-acc singlev-acc reference-acc exit-acc eager-cl; do
  mkdir -p $L5/$d/build && ( cd $L5/$d/build \
    && swiftc -o bin $(ls /tmp/p08-l5/$d/*.swift | tr ' ' '\n' | sort | tr '\n' ' ') > build.log 2>&1 )
  echo "$d build rc=$?"
  ( cd $L5/$d/build && stdbuf -o0 -e0 timeout 60 ./bin > run.log 2> run-err.log )
  echo "$d run rc=$?"
  diff $EV/A-oracle.log $L5/$d/build/run.log > $L5/$d/build/diff.log 2>&1 || true
  diff $EV/B-oracle.log $L5/$d/build/run.log > $L5/$d/build/diff-b.log 2>&1 || true
done
# collect
for d in branch-acc alias-acc singlev-acc reference-acc exit-acc; do
  diff $L5/baseline-acc/ReadOnlyBoundaryOps.swift $L5/$d/ReadOnlyBoundaryOps.swift > $EV/l5/$d/mutation.diff
  cp $L5/$d/build/{build.log,run.log} $EV/l5/$d/ 2>/dev/null
done
diff $CL/p8l/ClosureLazy.swift $L5/eager-cl/ClosureLazy.swift > $EV/l5/eager-cl/mutation.diff
cp $L5/eager-cl/build/{build.log,run.log} $EV/l5/eager-cl/ 2>/dev/null
echo "L5 done - every non-baseline variant must show a failing diff and/or a non-zero run rc"
