#![cfg(test)]

use crate::boring::inherit_ctor_ops::InheritCtorOps;
use crate::runtime::test as testlib;
use crate::runtime::test_core;
use crate::runtime::u_string::UStr;


#[test]
fn message_value() {
    testlib::run("tests.InheritCtorTests.messageValue", "tests.InheritCtorTests.messageValue: inherited data-class constructors preserve message values", || {
        let value = InheritCtorOps::new(&(UStr::new(&[105,110,104,101,114,105,116,101,100,32,109,101,115,115,97,103,101])));
        test_core::TestCore::test_core_equals_string(UStr::new(&[105,110,104,101,114,105,116,101,100,32,109,101,115,115,97,103,101]), (value.message).to_ustring().as_ustr(), UStr::new(&[]));
    });
}

#[test]
fn construction_and_catch() {
    testlib::run("tests.InheritCtorTests.constructionAndCatch", "tests.InheritCtorTests.constructionAndCatch: inherited data-class construction preserves the second message", || {
        let value = InheritCtorOps::new(&(UStr::new(&[99,97,117,103,104,116,32,109,101,115,115,97,103,101])));
        test_core::TestCore::test_core_equals_string(UStr::new(&[99,97,117,103,104,116,32,109,101,115,115,97,103,101]), (value.message).to_ustring().as_ustr(), UStr::new(&[]));
    });
}
