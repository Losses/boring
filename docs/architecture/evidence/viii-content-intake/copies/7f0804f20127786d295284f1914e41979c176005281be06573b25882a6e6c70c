package tests

import boring.ClusterTag
import boring.ClusterTags
import boring.ScriptNames
import boring.SortedDataClassKeysOps
import boring.SubTag
import boring.compare
import boring.runtime.SortedTable
import boring.runtime.test.Test

class SortedKeyDomainTests {
@boring.test.Test
    fun testStringKeyOrder() {
        Test.run("tests.SortedKeyDomainTests.testStringKeyOrder", "tests.SortedKeyDomainTests.testStringKeyOrder: String keys UTF-16 code unit ordering with astral and high BMP") {
                val expected = "ASCII=1; ퟿=2; 𐀀=3; 􏿿=4; =5; ￿=6"
                Test.equals(expected, ScriptNames.describeOrder(), "String key traversal matches UTF-16 code unit order")
        }
    }

@boring.test.Test
    fun testStringKeyLookup() {
        Test.run("tests.SortedKeyDomainTests.testStringKeyLookup", "tests.SortedKeyDomainTests.testStringKeyLookup: String key lookup hits and misses") {
                Test.equals(1, ScriptNames.codeOf("ASCII"), "ASCII hit")
                Test.equals(2, ScriptNames.codeOf("퟿"), "D7FF hit")
                Test.equals(3, ScriptNames.codeOf("𐀀"), "10000 hit")
                Test.equals(4, ScriptNames.codeOf("􏿿"), "10FFFF hit")
                Test.equals(5, ScriptNames.codeOf(""), "E000 hit")
                Test.equals(6, ScriptNames.codeOf("￿"), "FFFF hit")
                Test.equals(null, ScriptNames.codeOf("MISSING"), "unmapped ASCII key miss")
                Test.equals(null, ScriptNames.codeOf("𐀁"), "unmapped astral key miss")
        }
    }

@boring.test.Test
    fun testStructureKeyOrder() {
        Test.run("tests.SortedKeyDomainTests.testStructureKeyOrder", "tests.SortedKeyDomainTests.testStructureKeyOrder: Structure key lexicographic ordering across field types") {
                val expected = "alpha:10:1:F=500; alpha:10:1:T=400; alpha:10:3:T=300; alpha:20:2:F=200; beta:10:1:T=100"
                Test.equals(expected, ClusterTags.describeOrder(), "Structure key traversal matches field declaration order")
        }
    }

@boring.test.Test
    fun testDataClassKeyEvidence() {
        Test.run("tests.SortedKeyDomainTests.testDataClassKeyEvidence", "tests.SortedKeyDomainTests.testDataClassKeyEvidence: DataClass array and nullable key evidence") {
                Test.equals("ab;dc;shortlong", SortedDataClassKeysOps.arrayMutations(), "array element and prefix ordering")
                Test.equals("null;value", SortedDataClassKeysOps.nullableMutation(), "null sorts before non-null")
        }
    }

@boring.test.Test
    fun testDataClassGeneratedEntries() {
        Test.run("tests.SortedKeyDomainTests.testDataClassGeneratedEntries", "tests.SortedKeyDomainTests.testDataClassGeneratedEntries: DataClass generated entries cover nested enum and arrays") {
                Test.equals("a,b;open,close;nested-first,nested", SortedDataClassKeysOps.read(), "dataClass maps read in key order")
        }
    }

@boring.test.Test
    fun testStructureKeyLookup() {
        Test.run("tests.SortedKeyDomainTests.testStructureKeyLookup", "tests.SortedKeyDomainTests.testStructureKeyLookup: Structure key lookup hits and misses") {
                val hitTag = ClusterTag(name = "alpha", score = 10, sub = SubTag(priority = 1), active = true)
                val missTag = ClusterTag(name = "alpha", score = 10, sub = SubTag(priority = 99), active = true)
                Test.equals(400, ClusterTags.tagScore(hitTag), "existing structure key hit")
                Test.equals(null, ClusterTags.tagScore(missTag), "unmapped structure key miss")
        }
    }

@boring.test.Test
    fun testStructureMapLastWins() {
        Test.run("tests.SortedKeyDomainTests.testStructureMapLastWins", "tests.SortedKeyDomainTests.testStructureMapLastWins: Structure key SortedMap duplicate key last-put-wins") {
                val b = SortedTable.mapBuilder<ClusterTag, String>(::compare)
                val tagA = ClusterTag(name = "tag", score = 1, sub = SubTag(priority = 10), active = true)
                val tagB = ClusterTag(name = "tag", score = 1, sub = SubTag(priority = 10), active = true)
                b.put(tagA, "first")
                b.put(tagB, "second")
                val map = b.build()
                Test.equals(1, map.size(), "map size after duplicate structure key replacement")
                Test.equals("second", map.get(tagA), "last-put-wins value returned")
        }
    }

@boring.test.Test
    fun testStructureSetOperations() {
        Test.run("tests.SortedKeyDomainTests.testStructureSetOperations", "tests.SortedKeyDomainTests.testStructureSetOperations: Structure key SortedSet deduplication and ascending ordering") {
                val expected = "alpha:10:1:F; alpha:20:2:F; beta:10:1:T"
                Test.equals(expected, ClusterTags.describeSetOrder(), "SortedSet deduplicated elements match expected order")
                Test.equals("10,20,10", ClusterTags.describeScores(), "indexed size() loop collects the scores in set order")
                Test.equals(3, ClusterTags.setScores().size, "score array length matches set size")
                val set = ClusterTags.createSet()
                Test.equals(3, set.size(), "set size after deduplication")
                Test.equals(true, set.has(ClusterTag(name = "beta", score = 10, sub = SubTag(priority = 1), active = true)), "has existing element")
                Test.equals(false, set.has(ClusterTag(name = "beta", score = 10, sub = SubTag(priority = 1), active = false)), "has non-existing element")
        }
    }
}
