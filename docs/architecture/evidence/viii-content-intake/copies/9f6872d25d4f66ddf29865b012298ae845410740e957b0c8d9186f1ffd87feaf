import hashlib, json, os, stat, subprocess, sys, collections

R = sys.argv[1]
OUT = sys.argv[2] if len(sys.argv) > 2 else os.path.join(R, "out/coord-xcheck")
ST = os.path.join(R, "publication-staging")
NEW = os.path.join(ST, "execution-option-c-coord")
OLD = os.path.join(ST, "execution-option-c-e1c65975")
COORD = os.path.join(R, "boring-wt-architecture")
MF = os.path.join(ST, "p09-coord-state/option-c-source-before.json")
MF_OLD = os.path.join(ST, "p09-e1c65975/option-c-source-before.json")
RA_NEW = os.path.join(ST, "p09-coord-state/runtime-assets.json")
RA_OLD = os.path.join(ST, "p09-e1c65975/runtime-assets.json")
REPO = os.path.join(R, "boring")
C1, C2 = "e1c65975", "2159c657"

fails = []
report = []


def say(s=""):
    print(s)
    report.append(s)


def sha256(p):
    h = hashlib.sha256()
    with open(p, "rb") as f:
        for b in iter(lambda: f.read(1 << 20), b""):
            h.update(b)
    return h.hexdigest()


def blobsha1(p):
    """git blob id: sha1('blob <len>\\0' + content) -- computed by hand."""
    size = os.path.getsize(p)
    h = hashlib.sha1()
    h.update(b"blob %d\0" % size)
    with open(p, "rb") as f:
        for b in iter(lambda: f.read(1 << 20), b""):
            h.update(b)
    return h.hexdigest()


def lstree(rev):
    out = subprocess.run(["git", "-C", REPO, "ls-tree", "-r", "-z", rev],
                         capture_output=True, check=True).stdout
    d = {}
    for rec in out.split(b"\0"):
        if not rec:
            continue
        meta, path = rec.split(b"\t", 1)
        mode, typ, sha = meta.split(b" ")
        assert typ == b"blob", (path, typ)
        d[path.decode()] = (mode.decode(), sha.decode())
    return d


def walk(root, skip_top=()):
    """relpath -> {'sha256','blob','exec'}; symlinks skipped, skip_top dirs pruned.

    Only S_ISREG files are hashed: the tree legitimately contains a FIFO
    (boring-wt-architecture/out/.../log.fifo) that would block an open().
    """
    d = {}
    skipped = []
    for dp, dn, fn in os.walk(root):
        rel = os.path.relpath(dp, root)
        if rel == ".":
            dn[:] = [x for x in dn if x not in skip_top]
        keep = []
        for x in dn:
            full = os.path.join(dp, x)
            if os.path.islink(full):
                skipped.append(os.path.relpath(full, root) + "/")
            else:
                keep.append(x)
        dn[:] = keep
        for f in fn:
            full = os.path.join(dp, f)
            r = os.path.relpath(full, root)
            st = os.lstat(full)
            if not stat.S_ISREG(st.st_mode):
                skipped.append(r + (" (symlink)" if stat.S_ISLNK(st.st_mode) else " (non-regular)"))
                continue
            d[r] = {"sha256": sha256(full), "blob": blobsha1(full),
                    "exec": bool(st.st_mode & 0o100)}
    return d, skipped


say("# Independent cross-check of P09 coordination-state inputs")
say()
say("## Stage A - git-side ground truth")
T1 = lstree(C1)
T2 = lstree(C2)
say("- git ls-tree -r %s = %d paths" % (C1, len(T1)))
say("- git ls-tree -r %s = %d paths" % (C2, len(T2)))
if len(T1) != 1398:
    fails.append("git ls-tree -r %s = %d, expected 1398" % (C1, len(T1)))
say("- e1c65975 100755 entries = %d" % sum(1 for m, _ in T1.values() if m == "100755"))
say()

say("## Stage B - disk snapshot")
NEWD, NEWL = walk(NEW, skip_top=("node_modules",))
OLDD, OLDL = walk(OLD, skip_top=("node_modules",))
say("- new root: %d real files (%d under .haxelib), symlinks skipped: %d %s"
    % (len(NEWD), sum(1 for p in NEWD if p.startswith(".haxelib/")), len(NEWL), NEWL))
say("- old root: %d real files (%d under .haxelib), symlinks skipped: %d %s"
    % (len(OLDD), sum(1 for p in OLDD if p.startswith(".haxelib/")), len(OLDL), OLDL))
newsrc = {p: v for p, v in NEWD.items() if not p.startswith(".haxelib/")}
oldsrc = {p: v for p, v in OLDD.items() if not p.startswith(".haxelib/")}
say("- new root source files (excl .haxelib, excl symlinks) = %d" % len(newsrc))
say("- old root source files (excl .haxelib, excl symlinks) = %d" % len(oldsrc))
say()

say("## Stage C - manifest vs disk (my own recompute)")
doc = json.load(open(MF))
say("- manifest entries = %d" % len(doc))
if not isinstance(doc, list):
    fails.append("manifest is not a JSON array")
paths = [e["path"] for e in doc]
dups = [p for p, n in collections.Counter(paths).items() if n > 1]
say("- duplicate paths in manifest = %d %s" % (len(dups), dups[:5]))
if dups:
    fails.append("duplicate manifest paths")
mm = collections.Counter(e["mode"] for e in doc)
say("- manifest mode histogram = %s" % dict(mm))
if set(mm) - {"100644", "100755"}:
    fails.append("unexpected mode values: %s" % (set(mm) - {"100644", "100755"}))

mismatch, missing = [], []
for e in doc:
    p = e["path"]
    v = newsrc.get(p)
    if v is None:
        missing.append(p)
        continue
    mode = "100755" if v["exec"] else "100644"
    if v["sha256"] != e["sha256"] or mode != e["mode"]:
        mismatch.append((p, e["sha256"][:12], v["sha256"][:12], e["mode"], mode))
say("- entries missing on disk = %d %s" % (len(missing), missing[:10]))
say("- sha256/mode mismatches = %d" % len(mismatch))
for m in mismatch[:10]:
    say("    %s manifest=%s disk=%s mode %s->%s" % m)
extras = sorted(set(newsrc) - set(paths))
GEN = ("out/", "reference/", "toolchain-resolution.txt")
gen_extra = [p for p in extras if p.startswith(GEN)]
unexplained = [p for p in extras if not p.startswith(GEN)]
say("- on-disk source files NOT in manifest = %d" % len(extras))
say("    of which post-freeze generated/verify artifacts (out/, reference/, toolchain-resolution.txt) = %d"
    % len(gen_extra))
say("    unexplained extras = %d %s" % (len(unexplained), unexplained[:10]))
import collections as _c, time as _t
say("- extras by top dir: %s" % dict(_c.Counter(p.split('/')[0] for p in extras)))
newest = sorted(extras, key=lambda p: newsrc[p]["sha256"] and __import__("os").path.getmtime(
    __import__("os").path.join(NEW, p)), reverse=True)[:3]
say("- newest extras: %s" % [(p, _t.strftime('%H:%M:%S', _t.localtime(
    __import__("os").path.getmtime(__import__("os").path.join(NEW, p))))) for p in newest])
if missing or mismatch or unexplained or dups:
    fails.append("manifest vs disk disagreement (missing=%d mismatch=%d unexplained-extras=%d dup=%d)"
                 % (len(missing), len(mismatch), len(unexplained), len(dups)))
else:
    say("- VERDICT: %d/%d entries recomputed, 0 mismatch, 0 missing, 0 unexplained extra"
        % (len(doc), len(doc)))
    if gen_extra:
        say("  NOTE: %d generated/verify artifacts sit in the root outside the frozen manifest" % len(gen_extra))
say()

say("## Stage D - set arithmetic (base tree + new fixtures)")
base = set(T1)
mfs = set(paths)
newpaths = sorted(mfs - base)
say("- base (ls-tree %s) = %d" % (C1, len(base)))
say("- manifest - base = %d new paths" % len(newpaths))
say("- base - manifest = %d %s" % (len(base - mfs), sorted(base - mfs)[:10]))
if base - mfs:
    fails.append("base paths absent from manifest")
by_dir = collections.Counter(os.path.dirname(p) for p in newpaths)
for d, n in sorted(by_dir.items()):
    say("    %-52s %d" % (d, n))
say("- expected arithmetic: %d + %d = %d ; manifest = %d -> %s"
    % (len(base), len(newpaths), len(base) + len(newpaths), len(mfs),
       "MATCH" if len(base) + len(newpaths) == len(mfs) else "MISMATCH"))
if len(base) + len(newpaths) != len(mfs):
    fails.append("set arithmetic mismatch")

replaced = sorted(p for p in base if newsrc[p]["blob"] != T1[p][1])
say("- base paths whose on-disk bytes differ from commit state = %d" % len(replaced))
for p in replaced:
    say("    %s\n      disk=%s commit=%s" % (p, newsrc[p]["sha256"][:16], ""))
added_vs_old = sorted(set(newsrc) - set(oldsrc))
added_fixtures = sorted(set(added_vs_old) - set(gen_extra))
say("- new-root source paths absent from old root = %d; excluding generated artifacts = %d (expect %d fixtures)"
    % (len(added_vs_old), len(added_fixtures), len(newpaths)))
if set(added_fixtures) != set(newpaths):
    fails.append("fixture delta != manifest-vs-base delta: %s"
                 % sorted(set(added_fixtures) ^ set(newpaths))[:10])
say()

say("## Stage E - cross-generation pollution scan")
poll = []
for p in sorted(base & set(T2)):
    if newsrc[p]["blob"] == T2[p][1] and newsrc[p]["blob"] != T1[p][1]:
        poll.append(p)
say("- new-root files matching 2159c657 bytes but NOT e1c65975 bytes: %d %s" % (len(poll), poll[:10]))
if poll:
    fails.append("cross-generation pollution: %s" % poll[:10])
# every base path: new root must equal commit state OR be one of the 6 known replacements
say("- new root == commit bytes for %d/%d base paths; the %d exceptions are listed above"
    % (len(base) - len(replaced), len(base), len(replaced)))
if len(replaced) != 6:
    fails.append("expected 6 replaced production files, found %d" % len(replaced))
# fixtures must equal coordination-tree bytes
fixture_diff, fixture_missing = [], []
for p in newpaths:
    cf = os.path.join(COORD, p)
    if not (os.path.isfile(cf) and not os.path.islink(cf)):
        fixture_missing.append(p)
        continue
    if sha256(cf) != newsrc[p]["sha256"]:
        fixture_diff.append(p)
say("- new fixtures not present in coordination tree = %d %s" % (len(fixture_missing), fixture_missing[:5]))
coord_present = sum(1 for p in base if os.path.isfile(os.path.join(COORD, p)))
say("- base paths present in coordination worktree = %d/%d" % (coord_present, len(base)))
say("- new fixtures whose bytes differ from coordination tree = %d %s" % (len(fixture_diff), fixture_diff[:5]))
if fixture_missing or fixture_diff:
    fails.append("fixtures not byte-identical to coordination tree")
# the 6 replacements must equal coordination tree current bytes
six_diff = [p for p in replaced if sha256(os.path.join(COORD, p)) != newsrc[p]["sha256"]]
say("- 6 replacements byte-identical to coordination tree: %s" % ("YES" if not six_diff else "NO %s" % six_diff))
# reverse direction: coordination-tree files inside the fixture dirs missing from the new root
fixdirs = sorted({os.path.dirname(p) for p in newpaths})
stale = []
for d in fixdirs:
    cd_ = os.path.join(COORD, d)
    if not os.path.isdir(cd_):
        continue
    for f in sorted(os.listdir(cd_)):
        full = os.path.join(cd_, f)
        rel = os.path.relpath(full, COORD)
        if os.path.isfile(full) and rel not in newsrc:
            stale.append(rel)
say("- coordination-tree fixture files ABSENT from the new root = %d %s" % (len(stale), stale))
if stale:
    fails.append("new root is stale vs coordination tree: %s" % stale)
if six_diff:
    fails.append("replacements differ from coordination tree: %s" % six_diff)
say()

say("## Stage F - old root integrity (commit-state preservation)")
old_bad, old_missing = [], []
for p in sorted(base):
    v = oldsrc.get(p)
    if v is None:
        old_missing.append(p)
    elif v["blob"] != T1[p][1]:
        old_bad.append(p)
say("- old-root base paths missing = %d %s" % (len(old_missing), old_missing[:5]))
say("- old-root base paths differing from commit state = %d %s" % (len(old_bad), old_bad[:5]))
if old_missing or old_bad:
    fails.append("old root no longer equals commit state")
dr = sorted(p for p in (set(newsrc) & set(oldsrc)) if newsrc[p]["sha256"] != oldsrc[p]["sha256"])
say("- paths differing between new root and old root = %d (expect exactly the 6)" % len(dr))
for p in dr:
    say("    %s" % p)
if set(dr) != set(replaced):
    fails.append("new/old root difference set != 6 replacements")
# old-root extras beyond commit tree (runtime assets, git metadata)
old_extra = sorted(set(oldsrc) - base)
say("- old-root source files beyond the commit tree = %d, top-level groups: %s"
    % (len(old_extra), sorted({p.split('/')[0] for p in old_extra})))
say()

say("## Stage G - old manifests / runtime assets")
mo = json.load(open(MF_OLD))
say("- old manifest entries = %d (expect 1398); path set == ls-tree set: %s"
    % (len(mo), {e['path'] for e in mo} == base))
if len(mo) != 1398 or {e['path'] for e in mo} != base:
    fails.append("old manifest path set/count unexpected")
ra_new = json.load(open(RA_NEW))
ra_old = json.load(open(RA_OLD))
say("- runtime-assets new = %d assets (format %s, root %s)"
    % (len(ra_new["assets"]), ra_new["format"], ra_new["execution_root"]))
say("- runtime-assets old = %d assets (format %s, root %s)"
    % (len(ra_old["assets"]), ra_old["format"], ra_old["execution_root"]))
if len(ra_new["assets"]) != 8 or len(ra_old["assets"]) != 8:
    fails.append("runtime-assets count != 8")
for d, r in (("new", ra_new), ("old", ra_old)):
    bad = []
    for a in r["assets"]:
        root = NEW if d == "new" else OLD
        full = os.path.join(root, a["path"])
        if not os.path.isfile(full) or sha256(full) != a["sha256"]:
            bad.append(a["path"])
        if a.get("content") is not None and open(full).read().strip() != a["content"]:
            bad.append(a["path"] + "(content)")
    say("- runtime-assets %s recompute mismatches = %d %s" % (d, len(bad), bad))
    if bad:
        fails.append("runtime-assets %s mismatch: %s" % (d, bad))
o_paths = {a["path"]: a["sha256"] for a in ra_old["assets"]}
n_paths = {a["path"]: a["sha256"] for a in ra_new["assets"]}
same = {k for k in o_paths if k in n_paths and o_paths[k] == n_paths[k]}
say("- runtime-asset paths shared old/new with identical sha256 = %d/%d" % (len(same), len(o_paths)))
say()

say("## Stage H - runtime-assets content-change disclosure")
for k in sorted(set(o_paths) | set(n_paths)):
    say("    %-24s old=%s new=%s %s"
        % (k, (o_paths.get(k) or "-")[:12], (n_paths.get(k) or "-")[:12],
           "same" if o_paths.get(k) == n_paths.get(k) else "DIFFERENT"))
say()

say("## RESULT")
if fails:
    say("FAIL (%d):" % len(fails))
    for f in fails:
        say("  - %s" % f)
else:
    say("ALL INDEPENDENT CHECKS PASS")
open(os.path.join(OUT, "xcheck.out.txt"), "w").write("\n".join(report) + "\n")
sys.exit(1 if fails else 0)
