package boring

object IntDivisionOps {
    fun quotient(numerator: Int, denominator: Int): Float {
        return (numerator).toFloat() / (denominator).toFloat()
    }

    fun offset(width: Int, index: Int, span: Int): Float {
        return (width * index).toFloat() / (span).toFloat()
    }

    fun scaled(width: Int, index: Int, span: Int, bias: Float): Float {
        return (width * index).toFloat() / (span).toFloat() * 2.0f + bias
    }

    fun truncated(numerator: Int, denominator: Int): Int {
        return (numerator / denominator)
    }

    fun remainder(numerator: Int, denominator: Int): Int {
        return numerator % denominator
    }

    fun floored(numerator: Int, denominator: Int): Float {
        return ((kotlin.math.floor((numerator).toFloat() / (denominator).toFloat())).toInt()).toFloat()
    }
}
