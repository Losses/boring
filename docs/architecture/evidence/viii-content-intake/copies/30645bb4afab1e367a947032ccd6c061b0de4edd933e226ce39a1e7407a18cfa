#![cfg(test)]

use crate::boring::dart_char_null_ops::DartCharNullOps;
use crate::runtime::test as testlib;
use crate::runtime::test_core;
use crate::runtime::u_string;
use crate::runtime::u_string::UStr;
use crate::runtime::u_string::UString;


#[test]
fn char_null_narrowing() {
    testlib::run("tests.DartCharNullTests.charNullNarrowing", "tests.DartCharNullTests.charNullNarrowing: charCodeAt results narrow correctly at consumer boundaries", || {
        test_core::TestCore::test_core_equals_int(97i32, i32::from_ne_bytes(((DartCharNullOps::dart_char_null_ops_arg_shape(UStr::new(&[97,98,99]))) as i32).to_ne_bytes()), UStr::new(&[]));
        test_core::TestCore::test_core_equals_int(97i32, i32::from_ne_bytes(((DartCharNullOps::dart_char_null_ops_bound_arg_shape(UStr::new(&[97,98,99]))) as i32).to_ne_bytes()), UStr::new(&[]));
        test_core::TestCore::test_core_equals_bool(true, DartCharNullOps::dart_char_null_ops_compare_shape(UStr::new(&[98,97])), UStr::new(&[]));
        test_core::TestCore::test_core_equals_int(99i32, i32::from_ne_bytes(((DartCharNullOps::dart_char_null_ops_return_shape(UStr::new(&[97,98,99]))) as i32).to_ne_bytes()), UStr::new(&[]));
        test_core::TestCore::test_core_equals_bool(true, DartCharNullOps::dart_char_null_ops_annotated_compare_shape(UStr::new(&[98,97])), UStr::new(&[]));
        test_core::TestCore::test_core_equals_int(97i32, i32::from_ne_bytes(((DartCharNullOps::dart_char_null_ops_annotated_bound_arg_shape(UStr::new(&[97,98,99]))) as i32).to_ne_bytes()), UStr::new(&[]));
    });
}

#[test]
fn char_null_out_of_range() {
    testlib::run("tests.DartCharNullTests.charNullOutOfRange", "tests.DartCharNullTests.charNullOutOfRange: charCodeAt preserves null for out-of-range indices", || {
        let out_of_range = u_string::unit_at(&UString::from(""), 5u32);
        test_core::TestCore::test_core_equals_bool(true, out_of_range.is_none(), UStr::new(&[]));
    });
}
