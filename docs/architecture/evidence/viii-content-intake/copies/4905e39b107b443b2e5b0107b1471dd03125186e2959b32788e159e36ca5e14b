package tests

import boring.runtime.test.Test

object TestHelper {
    fun equalsValue(a: Boolean, b: Boolean): Boolean = a == b
    fun formatValue(v: Boolean): String = if (v) "true" else "false"
    fun assertEquals(expected: Boolean, actual: Boolean, message: String? = null) {
        if (!equalsValue(expected, actual)) Test.reportFailure(message, formatValue(expected), formatValue(actual))
    }

    fun equalsValue(a: Int, b: Int): Boolean = a == b
    fun formatValue(v: Int): String = v.toString()
    fun assertEquals(expected: Int, actual: Int, message: String? = null) {
        if (!equalsValue(expected, actual)) Test.reportFailure(message, formatValue(expected), formatValue(actual))
    }

    fun equalsValue(a: Double, b: Double): Boolean = a == b
    fun formatValue(v: Double): String = Test.formatFloat(v)
    fun assertEquals(expected: Double, actual: Double, message: String? = null) {
        if (!equalsValue(expected, actual)) Test.reportFailure(message, formatValue(expected), formatValue(actual))
    }

    fun equalsValue(a: String?, b: String?): Boolean = a == b
    fun formatValue(v: String?): String = if (v == null) "null" else "\"" + Test.escapeJson(v) + "\""
    fun assertEquals(expected: String?, actual: String?, message: String? = null) {
        if (!equalsValue(expected, actual)) Test.reportFailure(message, formatValue(expected), formatValue(actual))
    }

    fun equalsValue(a: ByteArray, b: ByteArray): Boolean = java.util.Arrays.equals(a, b)
    fun formatValue(v: ByteArray): String = Test.formatBytes(v)
    fun assertEquals(expected: ByteArray, actual: ByteArray, message: String? = null) {
        if (!equalsValue(expected, actual)) Test.reportFailure(message, formatValue(expected), formatValue(actual))
    }

    @JvmName("equalsValue_list_Int")
    fun equalsValue(a: List<Int>, b: List<Int>): Boolean = a.size == b.size && a.indices.all { equalsValue(a[it], b[it]) }
    @JvmName("formatValue_list_Int")
    fun formatValue(v: List<Int>): String = "[" + v.map { formatValue(it) }.joinToString(", ") + "]"
    @JvmName("assertEquals_list_Int")
    fun assertEquals(expected: List<Int>, actual: List<Int>, message: String? = null) { if (!equalsValue(expected, actual)) Test.reportFailure(message, formatValue(expected), formatValue(actual)) }

    @JvmName("equalsValue_list_String")
    fun equalsValue(a: List<String>, b: List<String>): Boolean = a.size == b.size && a.indices.all { equalsValue(a[it], b[it]) }
    @JvmName("formatValue_list_String")
    fun formatValue(v: List<String>): String = "[" + v.map { formatValue(it) }.joinToString(", ") + "]"
    @JvmName("assertEquals_list_String")
    fun assertEquals(expected: List<String>, actual: List<String>, message: String? = null) { if (!equalsValue(expected, actual)) Test.reportFailure(message, formatValue(expected), formatValue(actual)) }

    @JvmName("equalsValue_list_boring_GlyphMetrics")
    fun equalsValue(a: List<boring.GlyphMetrics>, b: List<boring.GlyphMetrics>): Boolean = a.size == b.size && a.indices.all { equalsValue(a[it], b[it]) }
    @JvmName("formatValue_list_boring_GlyphMetrics")
    fun formatValue(v: List<boring.GlyphMetrics>): String = "[" + v.map { formatValue(it) }.joinToString(", ") + "]"
    @JvmName("assertEquals_list_boring_GlyphMetrics")
    fun assertEquals(expected: List<boring.GlyphMetrics>, actual: List<boring.GlyphMetrics>, message: String? = null) { if (!equalsValue(expected, actual)) Test.reportFailure(message, formatValue(expected), formatValue(actual)) }

    fun equalsValue(a: boring.BoundsEm, b: boring.BoundsEm): Boolean = equalsValue(a.xMin, b.xMin) && equalsValue(a.yMin, b.yMin) && equalsValue(a.xMax, b.xMax) && equalsValue(a.yMax, b.yMax)
    fun formatValue(v: boring.BoundsEm): String = "{" + "xMin: " + formatValue(v.xMin) + ", " + "yMin: " + formatValue(v.yMin) + ", " + "xMax: " + formatValue(v.xMax) + ", " + "yMax: " + formatValue(v.yMax) + "}"
    fun assertEquals(expected: boring.BoundsEm, actual: boring.BoundsEm, message: String? = null) { if (!equalsValue(expected, actual)) Test.reportFailure(message, formatValue(expected), formatValue(actual)) }

    fun equalsValue(a: boring.GlyphMetrics, b: boring.GlyphMetrics): Boolean = equalsValue(a.codePoint, b.codePoint) && equalsValue(a.advanceEm, b.advanceEm) && equalsValue(a.bounds, b.bounds)
    fun formatValue(v: boring.GlyphMetrics): String = "{" + "codePoint: " + formatValue(v.codePoint) + ", " + "advanceEm: " + formatValue(v.advanceEm) + ", " + "bounds: " + formatValue(v.bounds) + "}"
    fun assertEquals(expected: boring.GlyphMetrics, actual: boring.GlyphMetrics, message: String? = null) { if (!equalsValue(expected, actual)) Test.reportFailure(message, formatValue(expected), formatValue(actual)) }

    fun equalsValue(a: boring.VectorException, b: boring.VectorException): Boolean = a == b
    fun formatValue(v: boring.VectorException): String = when(v) {
            is boring.VectorException.UnexpectedEof -> "UnexpectedEof"
            is boring.VectorException.TrailingBytes -> "TrailingBytes(" + formatValue(v.remaining) + ")"
            is boring.VectorException.CountOverflow -> "CountOverflow"
            is boring.VectorException.BadMagic -> "BadMagic"
    }
    fun assertEquals(expected: boring.VectorException, actual: boring.VectorException, message: String? = null) { if (!equalsValue(expected, actual)) Test.reportFailure(message, formatValue(expected), formatValue(actual)) }
}
