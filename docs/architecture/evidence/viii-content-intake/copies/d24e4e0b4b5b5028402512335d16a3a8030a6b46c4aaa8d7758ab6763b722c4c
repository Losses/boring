use crate::runtime::sorted_table::SortedTable;
use crate::runtime::u_string::UStr;
use crate::runtime::u_string::UString;


#[derive(Clone, PartialEq)]
pub struct InheritCtorBase {
    pub base_message: UString,
}

impl InheritCtorBase {
    pub fn new(payload: InheritCtorPayload) -> Self {
        Self {
            base_message: {
    let _g = match payload { InheritCtorPayload::Message { message, .. } => message };
    let message = _g;
    message
},
        }
    }
}

#[derive(Debug, Clone, PartialEq)]
pub struct InheritCtorOps {
    pub message: UString,
}

impl InheritCtorOps {
    pub fn new(message: &UStr) -> Self {
        Self {
            message: message.to_ustring(),
        }
    }

    pub fn to_string(&self) -> UString {
        return UString::from(format!("{}", { let mut __s = UString::new(); __s += &(UString::from("InheritCtorOps(")); __s += &(UString::from("message=")); __s += (self.message).to_ustring().as_ustr(); __s += &(UString::from(")")); __s }).as_str());
    }
}

pub fn compare_inherit_ctor_ops(a: &InheritCtorOps, b: &InheritCtorOps) -> i32 {
    let cmp_message = SortedTable::sorted_table_compare_strings((&a.message).as_ustr(), (&b.message).as_ustr());
    if cmp_message != 0 { return cmp_message; }
    0
}

#[derive(Debug, Clone, PartialEq)]
pub enum InheritCtorPayload {
    Message { message: UString },
}

impl InheritCtorPayload {
    pub fn to_string(&self) -> String {
        match self {
            InheritCtorPayload::Message { message } => format!("Message(message={})", (message).clone()),
        }
    }
}
