package boring

class IterItem(var index: Int) {
}

class IterPrep(var items: MutableList<IterItem>) {
}

object RustIterOps {
    fun sumItems(prep: IterPrep): Int {
        var total = 0
        run {
            val _g1 = prep.items
            for (item in _g1) {
                total += item.index
            }
        }
        return total
    }
}
