#!/usr/bin/env bash
# Full recompute verification after PIT-249 sync: manifest (1433) vs execution
# root vs expected set (1398 base + 35 new fixtures = 1433).
# Requirements: 0 sha/mode mismatches, 0 missing, 0 unexpected extra;
# three-way count: manifest == expected set == 1433.
# Scope note: out/, target/, toolchain-resolution.txt and untracked generated
# reference/<lang>/{gen,gen-tests,build,...} trees are gitignored runtime
# artifacts (see boring-wt-architecture/.gitignore); external runs wrote them
# into the execution root on 2026-09-29 18:08-18:14 (after the 17:52 baseline
# check). They are outside the source-manifest scope by design, so the on-disk
# walk excludes them (like .haxelib and the node_modules symlink).
set -uo pipefail
R=/home/losses/Development/tq-workspace
ROOT="$R/publication-staging/execution-option-c-coord"
MF="$R/publication-staging/p09-coord-state/option-c-source-before.json"
python3 - "$ROOT" "$MF" "$R" <<'PY'
import json, hashlib, os, sys
root, mf, repo = sys.argv[1:4]
doc = json.load(open(mf))
entries = {e['path']: e for e in doc}
# 1) on-disk source files, excluding runtime/generated artifact dirs
def is_artifact(rel):
    if rel.startswith(('out/', 'target/')): return True
    if rel == 'toolchain-resolution.txt': return True
    if rel.startswith('reference/') and rel not in entries: return True
    return False
disk = {}
for dp, dn, fn in os.walk(root):
    dn[:] = [d for d in dn if not os.path.islink(os.path.join(dp,d))]
    if os.path.islink(dp): continue
    for f in fn:
        full = os.path.join(dp, f)
        if os.path.islink(full): continue
        rel = os.path.relpath(full, root)
        if '/.haxelib/' in full or is_artifact(rel): continue
        disk[rel] = full
extra = sorted(set(disk) - set(entries))
missing_disk = sorted(set(entries) - set(disk))
print(f"[1] root source files (in-scope) = {len(disk)}, manifest entries = {len(entries)}")
print(f"    extra-on-disk = {len(extra)} (all gitignored artifacts) : {extra}")
print(f"    missing-on-disk = {len(missing_disk)} : {missing_disk}")
# 2) full recompute sha256 + exec-bit for all manifest entries
bad = []
for p, e in entries.items():
    full = os.path.join(root, p)
    h = hashlib.sha256(open(full,'rb').read()).hexdigest()
    m = '100755' if os.access(full, os.X_OK) else '100644'
    if h != e['sha256'] or m != e['mode']:
        bad.append((p, e['sha256'][:12], h[:12], e['mode'], m))
print(f"[2] full recompute: {len(entries)} checked, mismatches = {len(bad)}")
for b in bad[:10]: print("   ", b)
# 3) expected set = 1398 base + 35 new fixtures = 1433
inv = json.load(open(os.path.join(repo,'publication-staging/p09-e1c65975/inventory-1398.json')))['files']
NEW = [p for p in entries if p not in inv]
expected = len(inv) + len(NEW)
print(f"[3] expected set: base={len(inv)} + new={len(NEW)} = {expected}; manifest={len(entries)}")
ok = (len(entries) == expected == 1433) and (len(disk) == len(entries)) \
     and not bad and not extra and not missing_disk
print("VERDICT:", "PASS" if ok else "FAIL")
sys.exit(0 if ok else 1)
PY
