package boring

import boring.runtime.SortedMapTable
import boring.runtime.SortedTable

object PipelineOps {
    fun doubleScores(items: MutableList<Item>): MutableList<Int> {
        val pipeline_result = Array(items.size) { pipeline_index ->
            val v = items[pipeline_index]
            v.score * 2
        }.toMutableList()
        return pipeline_result
    }

    fun shadowingMap(items: MutableList<Item>): MutableList<Int> {
        var item = 999
        val pipeline_result = Array(items.size) { pipeline_index ->
            val v = items[pipeline_index]
            v.score + v.id
        }.toMutableList()
        val mapped = pipeline_result
        if ((items.size > 100)) {
            item = 1000
        }
        if ((item != 999)) {
            return mutableListOf<Int>()
        }
        return mapped
    }

    fun filterHighScore(items: MutableList<Item>, threshold: Int): MutableList<Item> {
        val pipeline_result = mutableListOf<Item>()
        for (v in items) {
            if ((v.score >= threshold)) {
                pipeline_result.add(v)
            }
        }
        return pipeline_result
    }

    fun mintCaptureFilter(items: MutableList<Item>): MutableList<Item> {
        val pipeline_threshold = 20
        val pipeline_result = mutableListOf<Item>()
        for (v in items) {
            if ((v.score >= pipeline_threshold)) {
                pipeline_result.add(v)
            }
        }
        return pipeline_result
    }

    fun sumScores(items: MutableList<Item>): Int {
        var total = 0
        for (item in items) {
            total += item.score
        }
        return total
    }

    fun associateById(items: MutableList<Item>): SortedMapTable<Int, String> {
        val pipeline_builder = SortedTable.mapBuilder<Int, String>(SortedTable::compareInts)
        for (item in items) {
            pipeline_builder.put(item.id, item.name)
        }
        val pipeline_result = pipeline_builder.build()
        return pipeline_result
    }

    fun sortByScore(items: MutableList<Item>): MutableList<Item> {
        val pipeline_result = items.toMutableList().apply { sortBy { item -> item.score } }
        return pipeline_result
    }

    fun highScorerNames(items: MutableList<Item>, minScore: Int): MutableList<String> {
        val pipeline_result = mutableListOf<Item>()
        for (v in items) {
            if ((v.score >= minScore)) {
                pipeline_result.add(v)
            }
        }
        val highScorers = pipeline_result
        val pipeline_result1 = Array(highScorers.size) { pipeline_index1 ->
            val v_2 = highScorers[pipeline_index1]
            v_2.name
        }.toMutableList()
        return pipeline_result1
    }

    fun chainedFilterMap(numbers: MutableList<Int>): MutableList<Int> {
        val pipeline_result = mutableListOf<Int>()
        for (v in numbers) {
            if ((v % 2 == 0)) {
                pipeline_result.add(v)
            }
        }
        val _this = pipeline_result
        val pipeline_result1 = Array(_this.size) { pipeline_index1 ->
            val v_2 = _this[pipeline_index1]
            v_2 * 10
        }.toMutableList()
        return pipeline_result1
    }

    fun nestedLoopMap(matrix: MutableList<MutableList<Int>>, offset: Int): MutableList<MutableList<Int>> {
        val result = mutableListOf<MutableList<Int>>()
        for (r in 0 until matrix.size) {
            val row = matrix[r]
            val pipeline_result = Array(row.size) { pipeline_index ->
                val v = row[pipeline_index]
                v + offset
            }.toMutableList()
            val mappedRow = pipeline_result
            result.add(mappedRow)
        }
        return result
    }

    fun hasHighScore(items: MutableList<Item>, threshold: Int): Boolean {
        var pipeline_result = false
        for (item in items) {
            if (item.score >= threshold) {
                pipeline_result = true
                break
            }
        }
        return pipeline_result
    }

    fun allAboveScore(items: MutableList<Item>, threshold: Int): Boolean {
        var pipeline_result = true
        for (item in items) {
            if (!(item.score >= threshold)) {
                pipeline_result = false
                break
            }
        }
        return pipeline_result
    }

    fun findFirstHighScore(items: MutableList<Item>, threshold: Int): Item? {
        var pipeline_result: Item? = null
        for (item in items) {
            if (item.score >= threshold) {
                pipeline_result = item
                break
            }
        }
        return pipeline_result
    }

    fun totalScore(items: MutableList<Item>): Int {
        var pipeline_result = 0
        for (item in items) {
            pipeline_result += item.score
        }
        return pipeline_result
    }

    fun totalWeightedScore(items: MutableList<Item>, weight: Float): Float {
        var pipeline_result = 0.0f
        for (item in items) {
            pipeline_result += (item.score).toFloat() * weight
        }
        return pipeline_result
    }

    fun extractValidNames(items: MutableList<Item>, minScore: Int): MutableList<String> {
        val pipeline_result = mutableListOf<String>()
        for (item in items) {
            var validName: String? = null
            if ((item.score >= minScore)) {
                validName = item.name
            }
            run {
                val pipeline_item = validName
                if (pipeline_item != null) {
                    pipeline_result.add(pipeline_item)
                }
            }
        }
        return pipeline_result
    }

    fun duplicateScores(items: MutableList<Item>): MutableList<Int> {
        val pipeline_result = mutableListOf<Int>()
        for (item in items) {
            val scores = mutableListOf<Int>()
            if ((item.score > 0)) {
                scores.add(item.score)
                scores.add(item.score * 2)
            }
            run {
                val pipeline_inner = scores
                for (pipeline_index1 in 0 until pipeline_inner.size) {
                    pipeline_result.add(pipeline_inner[pipeline_index1])
                }
            }
        }
        return pipeline_result
    }

    fun groupNamesByScore(items: MutableList<Item>): SortedMapTable<Int, MutableList<String>> {
        val pipeline_builder = SortedTable.mapBuilder<Int, MutableList<String>>(SortedTable::compareInts)
        for (item in items) {
            run {
                val pipeline_entry = ItemKeyVal(key = item.score, value = item.name)
                var pipeline_bucket = pipeline_builder.get(pipeline_entry.key)
                if (pipeline_bucket == null) {
                    pipeline_bucket = mutableListOf<String>()
                    pipeline_builder.put(pipeline_entry.key, pipeline_bucket!!)
                }
                pipeline_bucket.add(pipeline_entry.value)
            }
        }
        val pipeline_result = pipeline_builder.build()
        return pipeline_result
    }
}

data class Item(
    var id: Int,
    var name: String,
    var score: Int
)

fun compare(a: Item, b: Item): Int {
    if (a === b) return 0
    var cmp = 0
    cmp = a.id.compareTo(b.id)
    if (cmp != 0) return cmp
    cmp = a.name.compareTo(b.name)
    if (cmp != 0) return cmp
    cmp = a.score.compareTo(b.score)
    if (cmp != 0) return cmp
    return 0
}

data class ItemKeyVal(
    var key: Int,
    var value: String
)

fun compare(a: ItemKeyVal, b: ItemKeyVal): Int {
    if (a === b) return 0
    var cmp = 0
    cmp = a.key.compareTo(b.key)
    if (cmp != 0) return cmp
    cmp = a.value.compareTo(b.value)
    if (cmp != 0) return cmp
    return 0
}
