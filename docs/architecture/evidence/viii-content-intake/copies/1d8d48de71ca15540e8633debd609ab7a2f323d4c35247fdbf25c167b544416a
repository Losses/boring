#[test]
fn test_cr_lf() {
    testlib::run("tests.GraphemeTests.testCrLf", "tests.GraphemeTests.testCrLf: carriage return and line feed form one cluster", || {
        test_core::TestCore::test_core_equals_int(1i32, i32::from_ne_bytes(((GraphemeOps::grapheme_ops_grapheme_count(UStr::new(&[13,10]))) as i32).to_ne_bytes()), UStr::new(&[]));
        assert_equals_opt_string(&Some(UString::from(concat!("\r\n",
""))), &GraphemeOps::grapheme_ops_cluster_at(UStr::new(&[13,10]), 0), UStr::new(&[]));
        test_core::TestCore::test_core_equals_int(3i32, i32::from_ne_bytes(((GraphemeOps::grapheme_ops_grapheme_count(UStr::new(&[97,13,10,98]))) as i32).to_ne_bytes()), UStr::new(&[]));
        assert_equals_opt_string(&Some(UString::from(concat!("\r\n",
""))), &GraphemeOps::grapheme_ops_cluster_at(UStr::new(&[97,13,10,98]), 1), UStr::new(&[]));
        assert_equals_opt_string(&Some(UString::from("b")), &GraphemeOps::grapheme_ops_cluster_at(UStr::new(&[97,13,10,98]), 2), UStr::new(&[]));
    });
}

#[test]
fn test_emoji_sequences() {
    testlib::run("tests.GraphemeTests.testEmojiSequences", "tests.GraphemeTests.testEmojiSequences: emoji sequences with joiners and modifiers form one cluster", || {
        let family = { let mut __s = UString::new(); __s += u_string::from_code_point(128104).as_ustr(); __s += u_string::from_code_point(8205).as_ustr(); __s += u_string::from_code_point(128105).as_ustr(); __s += u_string::from_code_point(8205).as_ustr(); __s += u_string::from_code_point(128103).as_ustr(); __s += u_string::from_code_point(8205).as_ustr(); __s += u_string::from_code_point(128102).as_ustr(); __s };
        let thumbs_up_with_tone = { let mut __s = UString::new(); __s += u_string::from_code_point(128077).as_ustr(); __s += u_string::from_code_point(127997).as_ustr(); __s };
        let keycap = { let mut __s = UString::new(); __s += u_string::from_code_point(49).as_ustr(); __s += u_string::from_code_point(65039).as_ustr(); __s += u_string::from_code_point(8419).as_ustr(); __s };
        test_core::TestCore::test_core_equals_int(1i32, i32::from_ne_bytes(((GraphemeOps::grapheme_ops_grapheme_count(family.as_ustr())) as i32).to_ne_bytes()), UStr::new(&[]));
        test_core::TestCore::test_core_equals_int(7i32, i32::from_ne_bytes(((GraphemeOps::grapheme_ops_code_point_count(family.as_ustr())) as i32).to_ne_bytes()), UStr::new(&[]));
        test_core::TestCore::test_core_equals_int(1i32, i32::from_ne_bytes(((GraphemeOps::grapheme_ops_grapheme_count(thumbs_up_with_tone.as_ustr())) as i32).to_ne_bytes()), UStr::new(&[]));
        test_core::TestCore::test_core_equals_int(2i32, i32::from_ne_bytes(((GraphemeOps::grapheme_ops_code_point_count(thumbs_up_with_tone.as_ustr())) as i32).to_ne_bytes()), UStr::new(&[]));
        test_core::TestCore::test_core_equals_int(1i32, i32::from_ne_bytes(((GraphemeOps::grapheme_ops_grapheme_count(keycap.as_ustr())) as i32).to_ne_bytes()), UStr::new(&[]));
