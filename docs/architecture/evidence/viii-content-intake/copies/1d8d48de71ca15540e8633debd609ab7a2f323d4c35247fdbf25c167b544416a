#[test]
fn test_slicing() {
    testlib::run("tests.GraphemeTests.testSlicing", "tests.GraphemeTests.testSlicing: cluster slicing clamps like the code-point tier", || {
        let mixed = { let mut __s = UString::new(); __s += u_string::from_code_point(128077).as_ustr(); __s += u_string::from_code_point(127997).as_ustr(); __s += u_string::from_code_point(25552).as_ustr(); __s += u_string::from_code_point(26912).as_ustr(); __s };
        test_core::TestCore::test_core_equals_int(3i32, i32::from_ne_bytes(((GraphemeOps::grapheme_ops_grapheme_count(mixed.as_ustr())) as i32).to_ne_bytes()), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string((UString::from(format!("{}", { let mut __s = UString::new(); __s += u_string::from_code_point(128077).as_ustr(); __s += u_string::from_code_point(127997).as_ustr(); __s }).as_str())).as_ustr(), GraphemeOps::grapheme_ops_cluster_slice(mixed.as_ustr(), 0, 1).as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[25552,26912]), GraphemeOps::grapheme_ops_cluster_slice(mixed.as_ustr(), 1, 3).as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(mixed.as_ustr(), GraphemeOps::grapheme_ops_clamped_slice(mixed.as_ustr()).as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[]), GraphemeOps::grapheme_ops_cluster_slice(mixed.as_ustr(), 2, 1).as_ustr(), UStr::new(&[]));
    });
}

