#[test]
fn test_cjk_clusters() {
    testlib::run("tests.GraphemeTests.testCjkClusters", "tests.GraphemeTests.testCjkClusters: cjk text counts one cluster per character", || {
        test_core::TestCore::test_core_equals_int(4i32, i32::from_ne_bytes(((GraphemeOps::grapheme_ops_grapheme_count(UStr::new(&[25552,26912,25490,29256]))) as i32).to_ne_bytes()), UStr::new(&[]));
        assert_equals_opt_string(&Some(UString::from("提")), &GraphemeOps::grapheme_ops_cluster_at(UStr::new(&[25552,26912,25490,29256]), 0), UStr::new(&[]));
        assert_equals_opt_string(&Some(UString::from("版")), &GraphemeOps::grapheme_ops_cluster_at(UStr::new(&[25552,26912,25490,29256]), 3), UStr::new(&[]));
        assert_equals_opt_string(&None::<UString>, &GraphemeOps::grapheme_ops_cluster_at(UStr::new(&[25552,26912,25490,29256]), 4), UStr::new(&[]));
    });
}

#[test]
fn test_combining_marks() {
    testlib::run("tests.GraphemeTests.testCombiningMarks", "tests.GraphemeTests.testCombiningMarks: combining marks join their base character", || {
        let decomposed = { let mut __s = UString::new(); __s += u_string::from_code_point(101).as_ustr(); __s += u_string::from_code_point(769).as_ustr(); __s };
        let precomposed = u_string::from_code_point(233);
        test_core::TestCore::test_core_equals_int(1i32, i32::from_ne_bytes(((GraphemeOps::grapheme_ops_grapheme_count(decomposed.as_ustr())) as i32).to_ne_bytes()), UStr::new(&[]));
        test_core::TestCore::test_core_equals_int(1i32, i32::from_ne_bytes(((GraphemeOps::grapheme_ops_grapheme_count(precomposed.as_ustr())) as i32).to_ne_bytes()), UStr::new(&[]));
        test_core::TestCore::test_core_equals_int(2i32, i32::from_ne_bytes(((GraphemeOps::grapheme_ops_code_point_count(decomposed.as_ustr())) as i32).to_ne_bytes()), UStr::new(&[]));
        assert_equals_opt_string(&Some(decomposed.clone()), &GraphemeOps::grapheme_ops_cluster_at(decomposed.as_ustr(), 0), UStr::new(&[]));
    });
}

