#[test]
fn test_boundaries() {
    testlib::run("tests.GraphemeTests.testBoundaries", "tests.GraphemeTests.testBoundaries: boundary offsets list every cluster edge in string units", || {
        let mixed = { let mut __s = UString::new(); __s += u_string::from_code_point(128077).as_ustr(); __s += u_string::from_code_point(127997).as_ustr(); __s += u_string::from_code_point(25552).as_ustr(); __s += u_string::from_code_point(769).as_ustr(); __s };
        let mixed_boundaries = GraphemeOps::grapheme_ops_grapheme_boundaries(mixed.as_ustr());
        test_core::TestCore::test_core_equals_int(3i32, i32::from_ne_bytes(((u32::try_from((mixed_boundaries.len()) & 0xFFFF_FFFF).unwrap_or(0)) as i32).to_ne_bytes()), UStr::new(&[]));
        test_core::TestCore::test_core_equals_int(0i32, { let v: u32 = mixed_boundaries[0usize]; i32::from_ne_bytes(v.to_ne_bytes()) }, UStr::new(&[]));
        test_core::TestCore::test_core_equals_int(4i32, { let v: u32 = mixed_boundaries[1usize]; i32::from_ne_bytes(v.to_ne_bytes()) }, UStr::new(&[]));
        test_core::TestCore::test_core_equals_int(6i32, { let v: u32 = mixed_boundaries[2usize]; i32::from_ne_bytes(v.to_ne_bytes()) }, UStr::new(&[]));
        let cjk_boundaries = GraphemeOps::grapheme_ops_grapheme_boundaries(UStr::new(&[25552,26912,25490,29256]));
        test_core::TestCore::test_core_equals_int(5i32, i32::from_ne_bytes(((u32::try_from((cjk_boundaries.len()) & 0xFFFF_FFFF).unwrap_or(0)) as i32).to_ne_bytes()), UStr::new(&[]));
        test_core::TestCore::test_core_equals_int(4i32, { let v: u32 = cjk_boundaries[4usize]; i32::from_ne_bytes(v.to_ne_bytes()) }, UStr::new(&[]));
        let prepend = { let mut __s = UString::new(); __s += u_string::from_code_point(1536).as_ustr(); __s += u_string::from_code_point(49).as_ustr(); __s += u_string::from_code_point(50).as_ustr(); __s };
        let prepend_boundaries = GraphemeOps::grapheme_ops_grapheme_boundaries(prepend.as_ustr());
        test_core::TestCore::test_core_equals_int(3i32, i32::from_ne_bytes(((u32::try_from((prepend_boundaries.len()) & 0xFFFF_FFFF).unwrap_or(0)) as i32).to_ne_bytes()), UStr::new(&[]));
        test_core::TestCore::test_core_equals_int(2i32, { let v: u32 = prepend_boundaries[1usize]; i32::from_ne_bytes(v.to_ne_bytes()) }, UStr::new(&[]));
        test_core::TestCore::test_core_equals_int(3i32, { let v: u32 = prepend_boundaries[2usize]; i32::from_ne_bytes(v.to_ne_bytes()) }, UStr::new(&[]));
        let pair_boundaries = GraphemeOps::grapheme_ops_grapheme_boundaries(UStr::new(&[13,10]));
        test_core::TestCore::test_core_equals_int(2i32, i32::from_ne_bytes(((u32::try_from((pair_boundaries.len()) & 0xFFFF_FFFF).unwrap_or(0)) as i32).to_ne_bytes()), UStr::new(&[]));
        test_core::TestCore::test_core_equals_int(2i32, { let v: u32 = pair_boundaries[1usize]; i32::from_ne_bytes(v.to_ne_bytes()) }, UStr::new(&[]));
        let empty_boundaries = GraphemeOps::grapheme_ops_grapheme_boundaries(UStr::new(&[]));
        test_core::TestCore::test_core_equals_int(1i32, i32::from_ne_bytes(((u32::try_from((empty_boundaries.len()) & 0xFFFF_FFFF).unwrap_or(0)) as i32).to_ne_bytes()), UStr::new(&[]));
        test_core::TestCore::test_core_equals_int(0i32, { let v: u32 = empty_boundaries[0usize]; i32::from_ne_bytes(v.to_ne_bytes()) }, UStr::new(&[]));
    });
}
