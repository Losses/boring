#!/usr/bin/env python3
"""Exact census of SwiftArrayBoundary.render() output shapes in a generated tree."""
import os,re,sys
root=sys.argv[1]
shapes={
 'KeepPreparedArray|PreserveNullArrayValue (unwrapped operand)':'<not textual>',
 'WrapMutableArrayView      ReadOnlyArray(OPERAND)':r'ReadOnlyArray\(',
 'MapOptionalMutableArrayView  (OPERAND).map { ReadOnlyArray($0) }':r'\{ ReadOnlyArray\(\$0\) \}',
 'ContextualReadOnlyEmpty   ReadOnlyArray<T>()':r'ReadOnlyArray<[^<>]*>\(\)',
 'CopyReadOnlyIntoMutableArray  ANY call  X.toMutableArray()':r'[\w.)\]]\.toMutableArray\(\)',
 'CopyReadOnlyIntoMutableArray  BUGGY  TiqianArray(OPERAND.toMutableArray())':r'TiqianArray\([^()]*(?:\(\))?[^()]*\.toMutableArray\(\)\)',
 'MapOptionalReadOnlyIntoMutableArray FIXED  (OP).map { $0.toMutableArray() }':r'\.map \{ \$0\.toMutableArray\(\) \}',
 'MapOptionalReadOnlyIntoMutableArray BUGGY  (OP).map { TiqianArray($0.toMutableArray()) }':r'map \{ TiqianArray\(\$0\.toMutableArray\(\)\) \}',
}
rx={k:re.compile(v) for k,v in shapes.items() if v!='<not textual>'}
counts={k:0 for k in shapes}
files={k:set() for k in shapes}
for dp,_d,fs in os.walk(root):
    for f in sorted(fs):
        if not f.endswith('.swift'): continue
        p=os.path.join(dp,f)
        txt=open(p,encoding='utf-8',errors='replace').read()
        for k,r in rx.items():
            n=len(r.findall(txt))
            if n: counts[k]+=n; files[k].add(os.path.relpath(p,root))
FIXED_COPY = counts['CopyReadOnlyIntoMutableArray  ANY call  X.toMutableArray()'] - counts['CopyReadOnlyIntoMutableArray  BUGGY  TiqianArray(OPERAND.toMutableArray())']
print('tree:',root)
for k in shapes:
    print(f'  {counts[k]:4d}  {k}')
    for f in sorted(files[k])[:6]:
        print(f'          - {f}')
print(f'  {FIXED_COPY:4d}  CopyReadOnlyIntoMutableArray  FIXED = ANY({counts["CopyReadOnlyIntoMutableArray  ANY call  X.toMutableArray()"]}) - BUGGY({counts["CopyReadOnlyIntoMutableArray  BUGGY  TiqianArray(OPERAND.toMutableArray())"]})')
