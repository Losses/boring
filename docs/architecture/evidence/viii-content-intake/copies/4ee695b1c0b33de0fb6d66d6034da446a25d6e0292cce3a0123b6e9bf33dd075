package boring

data class GlyphCluster(var clusterRange: Int, var start: Int, var end: Int) {
    val width: Int get() = get_width()

    fun get_width(): Int {
        return this.end - this.start
    }
}

fun compareGlyphCluster(a: GlyphCluster, b: GlyphCluster): Int {
    var cmp = 0
    cmp = a.clusterRange.compareTo(b.clusterRange)
    if (cmp != 0) return cmp
    cmp = a.start.compareTo(b.start)
    if (cmp != 0) return cmp
    cmp = a.end.compareTo(b.end)
    if (cmp != 0) return cmp
    return 0
}
