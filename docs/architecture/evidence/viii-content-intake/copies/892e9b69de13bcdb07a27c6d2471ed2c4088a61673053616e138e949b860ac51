package boring

import boring.runtime.SortedTable

object EnumSortedKeysOps {
    fun describe(): String {
        val b = SortedTable.setBuilder<EnumTier>({ a, b -> a.ordinal - b.ordinal })
        b.put(EnumTier.High)
        b.put(EnumTier.Low)
        b.put(EnumTier.Mid)
        val s = b.build()
        var out = ""
        for (i in 0 until s.size()) {
            out += ((if ((i == 0)) "" else ",")) + s.at(i)
        }
        return out
    }

    fun mapOrder(): String {
        val b = SortedTable.mapBuilder<EnumTier, Int>({ a, b -> a.ordinal - b.ordinal })
        b.put(EnumTier.High, 3)
        b.put(EnumTier.Low, 1)
        b.put(EnumTier.Mid, 2)
        val m = b.build()
        return m.keyAt(0).name + ":" + m.valueAt(0) + ";" + m.keyAt(1) + ":" + m.valueAt(1) + ";" + m.keyAt(2) + ":" + m.valueAt(2)
    }

    fun has(): Boolean {
        val b = SortedTable.setBuilder<EnumTier>({ a, b -> a.ordinal - b.ordinal })
        b.put(EnumTier.Mid)
        val s = b.build()
        return s.has(EnumTier.Mid) && !s.has(EnumTier.High)
    }

    fun declarationOrder(): String {
        val b = SortedTable.setBuilder<ReverseTier>({ a, b -> a.ordinal - b.ordinal })
        b.put(ReverseTier.Earlier)
        b.put(ReverseTier.Later)
        val s = b.build()
        return s.at(0).name + "," + s.at(1)
    }
}

enum class EnumTier {
    Low,
    Mid,
    High
}
fun compareEnumTier(a: EnumTier, b: EnumTier): Int = a.ordinal - b.ordinal

enum class ReverseTier {
    Later,
    Earlier
}
fun compareReverseTier(a: ReverseTier, b: ReverseTier): Int = a.ordinal - b.ordinal
