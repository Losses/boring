use crate::runtime::u_string::UStr;
use crate::runtime::u_string::UString;


#[derive(Clone, Copy)]
pub struct StringConvOps;

impl StringConvOps {
    pub fn string_conv_ops_hex_zero() -> UString {
        return UString::from(format!("{}", format!("{:X}", 0)).as_str());
    }

    pub fn string_conv_ops_hex_ten() -> UString {
        return UString::from(format!("{}", format!("{:X}", 10)).as_str());
    }

    pub fn string_conv_ops_hex_byte() -> UString {
        return UString::from(format!("{}", format!("{:X}", 255)).as_str());
    }

    pub fn string_conv_ops_hex_cjk() -> UString {
        return UString::from(format!("{}", format!("{:X}", 40959)).as_str());
    }

    pub fn string_conv_ops_hex_digits_zero() -> UString {
        return UString::from(format!("{}", format!("{:0w$X}", 10, w = usize::try_from(0).unwrap_or_default())).as_str());
    }

    pub fn string_conv_ops_hex_padded() -> UString {
        return UString::from(format!("{}", format!("{:0w$X}", 10, w = usize::try_from(4).unwrap_or_default())).as_str());
    }

    pub fn string_conv_ops_hex_wider_than_digits() -> UString {
        return UString::from(format!("{}", format!("{:0w$X}", 40959, w = usize::try_from(2).unwrap_or_default())).as_str());
    }

    pub fn string_conv_ops_hex_dynamic(value: u32, digits: u32) -> UString {
        return UString::from(format!("{}", format!("{:0w$X}", value, w = usize::try_from(digits).unwrap_or_default())).as_str());
    }

    pub fn string_conv_ops_hex_lowercase() -> UString {
        return UString::from(format!("{}", { let mut __s = UString::new(); __s += &(UString::from("U+")); __s += UString::from(format!("{}", format!("{:0w$X}", 40959, w = usize::try_from(0).unwrap_or_default()).to_lowercase()).as_str()).as_ustr(); __s }).as_str());
    }

    pub fn string_conv_ops_lower_ascii() -> UString {
        return UString::from("TiQian").to_lowercase();
    }

    pub fn string_conv_ops_upper_ascii() -> UString {
        return UString::from("tiqian").to_uppercase();
    }

    pub fn string_conv_ops_lower_language_tag() -> UString {
        return UString::from("ZH-CN").to_lowercase();
    }

    pub fn string_conv_ops_upper_language_tag() -> UString {
        return UString::from("zh-cn").to_uppercase();
    }

    pub fn string_conv_ops_lower_cjk() -> UString {
        return UString::from("提椠排版").to_lowercase();
    }

    pub fn string_conv_ops_upper_cjk() -> UString {
        return UString::from("提椠排版").to_uppercase();
    }

    pub fn string_conv_ops_lower_dynamic(value: &UStr) -> UString {
        return value.to_lowercase();
    }

    pub fn string_conv_ops_upper_dynamic(value: &UStr) -> UString {
        return value.to_uppercase();
    }
}
