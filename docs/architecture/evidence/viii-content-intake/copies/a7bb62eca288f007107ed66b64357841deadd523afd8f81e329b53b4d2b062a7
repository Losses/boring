#[derive(Clone, PartialEq)]
pub struct FloatHolder {
    pub value: f32,
}

impl FloatHolder {
    pub fn new(value: f32) -> Self {
        Self {
            value,
        }
    }
}

#[derive(Clone, Copy)]
pub struct FloatLiteralOps;

impl FloatLiteralOps {
    pub fn float_literal_ops_integer_constructor_argument() -> f32 {
        return FloatHolder::new(0 as f32 as f32).value;
    }

    pub fn float_literal_ops_arg_leading_dot() -> f32 {
        return 0.001f32;
    }

    pub fn float_literal_ops_local_leading_dot_neg() -> f32 {
        let f = -0.1f32;
        return f;
    }

    pub fn float_literal_ops_arg_small() -> f32 {
        return 0.25f32;
    }

    pub fn float_literal_ops_local_small_neg() -> f32 {
        let f = -0.5f32;
        return f;
    }
}
