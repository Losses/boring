use crate::boring::value_exception::ValueError;
use crate::runtime::u_string::UString;


#[derive(Debug, Clone, PartialEq)]
pub struct DataClassCtorGuardOps {
    pub magnitude: f64,
}

impl DataClassCtorGuardOps {
    pub fn new(magnitude: f64) -> Result<Self, ValueError> {
        if !(magnitude).is_finite() || (magnitude) < (0.0f64) {
            return Err(ValueError::NegativeStart);
        }
        Ok(Self {
            magnitude,
        })
    }

    pub fn to_string(&self) -> UString {
        return UString::from(format!("{}", { let mut __s = UString::new(); __s += &(UString::from("DataClassCtorGuardOps(")); __s += &(UString::from("magnitude=")); __s += &(crate::runtime::fp_helper::FPHelper::format_float(self.magnitude)); __s += &(UString::from(")")); __s }).as_str());
    }
}
