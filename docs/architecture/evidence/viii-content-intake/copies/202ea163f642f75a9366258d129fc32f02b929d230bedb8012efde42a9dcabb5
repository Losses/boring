#![cfg(test)]

use crate::boring::clone_derive_gap_ops::CloneDeriveAbstractResult;
use crate::boring::clone_derive_gap_ops::CloneDeriveGapOps;
use crate::boring::clone_derive_gap_ops::CloneDeriveRange;
use crate::boring::clone_derive_gap_ops::CloneDeriveResult;
use crate::runtime::test as testlib;
use crate::runtime::test_core;
use crate::runtime::u_string::UStr;
use crate::runtime::u_string::UString;


#[test]
fn resolve() {
    testlib::run("tests.CloneDeriveGapTests.resolve", "tests.CloneDeriveGapTests.resolve: data class holding a plain-class field derives Clone and reads owned values", || {
        test_core::TestCore::test_core_equals_string(UStr::new(&[49,46,46,51,58,120]), CloneDeriveGapOps::clone_derive_gap_ops_resolve(&vec![(CloneDeriveResult::new(CloneDeriveRange::new(1u32, 3u32), &(UStr::new(&[120])))).clone()]).as_ustr(), UStr::new(&[]));
    });
}

#[test]
fn resolve_abstract() {
    testlib::run("tests.CloneDeriveGapTests.resolveAbstract", "tests.CloneDeriveGapTests.resolveAbstract: class holding a string abstract field derives Clone and reads owned values", || {
        test_core::TestCore::test_core_equals_string(UStr::new(&[120,58,50]), CloneDeriveGapOps::clone_derive_gap_ops_resolve_abstract(&vec![(CloneDeriveAbstractResult::new(&(UString::from("x")), 2u32)).clone()]).as_ustr(), UStr::new(&[]));
    });
}
