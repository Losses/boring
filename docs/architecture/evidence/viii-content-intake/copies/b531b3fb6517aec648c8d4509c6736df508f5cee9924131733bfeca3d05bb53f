package dcpe

object DoubleEvalControl {
    @JvmField
    var callCount: Int = 0

    fun nextKind(): Kind {
        DoubleEvalControl.callCount = DoubleEvalControl.callCount + 1
        return Kind.B(21)
    }

    fun reset() {
        DoubleEvalControl.callCount = 0
    }

    fun doubleOnce(): Int {
        var acc = 0
        run {
            val _g = DoubleEvalControl.nextKind()
            when (_g) {
    is Kind.A -> acc = 1
    is Kind.B -> acc = _g.value
    is Kind.C -> acc = 3
}
        }
        run {
            val _g_2 = DoubleEvalControl.nextKind()
            when (_g_2) {
    is Kind.A -> acc = acc + 1
    is Kind.B -> acc = acc + _g_2.value
    is Kind.C -> acc = acc + 3
}
        }
        return acc
    }

    fun main() {
    }
}
