#![cfg(test)]

use crate::boring::underscore_param_ops::UnderscoreParamOps;
use crate::runtime::test as testlib;
use crate::runtime::test_core;
use crate::runtime::u_string::UStr;


#[test]
fn underscore_parameters() {
    testlib::run("tests.UnderscoreParamTests.underscoreParameters", "tests.UnderscoreParamTests.underscoreParameters: underscore parameters are readable and independently named", || {
        test_core::TestCore::test_core_equals_int(4i32, i32::from_ne_bytes(((UnderscoreParamOps::underscore_param_ops_resolve(3)) as i32).to_ne_bytes()), UStr::new(&[]));
        test_core::TestCore::test_core_equals_int(7i32, i32::from_ne_bytes(((UnderscoreParamOps::underscore_param_ops_pair(3, 4)) as i32).to_ne_bytes()), UStr::new(&[]));
    });
}
