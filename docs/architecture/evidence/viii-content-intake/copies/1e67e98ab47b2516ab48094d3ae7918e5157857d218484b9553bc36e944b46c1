#[derive(Clone, PartialEq)]
pub struct BorrowedArrayHolder {
    pub values: Option<Vec<u32>>,
}

impl BorrowedArrayHolder {
    pub fn new(values: Option<Vec<u32>>) -> Self {
        Self {
            values,
        }
    }

    pub fn has_values(&self) -> bool {
        return (self.values).clone().is_some();
    }
}

#[derive(Clone, PartialEq)]
pub struct BorrowedReadOnlyArrayHolder {
    pub values: Option<Vec<u32>>,
}

impl BorrowedReadOnlyArrayHolder {
    pub fn new(values: Option<Vec<u32>>) -> Self {
        Self {
            values,
        }
    }

    pub fn has_values(&self) -> bool {
        return (self.values).clone().is_some();
    }
}

#[derive(Clone, Copy)]
pub struct BorrowedArrayBoundaryOps;

impl BorrowedArrayBoundaryOps {
    pub fn borrowed_array_boundary_ops_wrap(values: &Vec<u32>) -> BorrowedArrayHolder {
        return BorrowedArrayHolder::new(Some((values).clone()));
    }

    pub fn borrowed_array_boundary_ops_read_only_wrap(values: &Vec<u32>) -> BorrowedReadOnlyArrayHolder {
        return BorrowedReadOnlyArrayHolder::new(Some((values).clone()));
    }

    pub fn borrowed_array_boundary_ops_nullable_return(values: &Vec<u32>) -> Option<Vec<u32>> {
        return Some((*values).clone());
    }

    pub fn borrowed_array_boundary_ops_rebind(values: &Vec<u32>) -> u32 {
        let mut current = vec![0];
        current = (*values).clone();
        return u32::try_from((current.len()) & 0xFFFF_FFFF).unwrap_or(0);
    }

    pub fn borrowed_array_boundary_ops_choose(values: &Vec<u32>, flag: bool) -> Vec<u32> {
        let chosen = if flag { (*values).clone() } else { vec![] };
        return chosen;
    }
}
