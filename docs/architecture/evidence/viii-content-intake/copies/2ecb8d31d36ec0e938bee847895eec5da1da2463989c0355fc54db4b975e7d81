#![cfg(test)]

use crate::boring::optional_param_null::OptionalParamNull;
use crate::runtime::test as testlib;
use crate::runtime::test_core;
use crate::runtime::u_string::UStr;


#[test]
fn test_int_default() {
    testlib::run("tests.OptionalParamNullTests.testIntDefault", "tests.OptionalParamNullTests.testIntDefault: omitted Int optional parameter falls back to its null default", || {
        test_core::TestCore::test_core_equals_int(0i32, i32::from_ne_bytes(((OptionalParamNull::optional_param_null_int_default(None)) as i32).to_ne_bytes()), UStr::new(&[]));
    });
}

#[test]
fn test_class_default() {
    testlib::run("tests.OptionalParamNullTests.testClassDefault", "tests.OptionalParamNullTests.testClassDefault: omitted class optional parameter falls back to its null default", || {
        test_core::TestCore::test_core_equals_string(UStr::new(&[100,101,102,97,117,108,116]), OptionalParamNull::optional_param_null_class_default(None).as_ustr(), UStr::new(&[]));
    });
}
