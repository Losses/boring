package boring

object StaticFnOps {
    val transform: (String) -> String = fun(value: String): String {
    return value + "!"
}
    @JvmField
    var count: Int = 0

    fun apply(value: String): String {
        return StaticFnOps.transform(value)
    }

    fun increment(): Int {
        StaticFnOps.count += 1
        return StaticFnOps.count
    }
}
