use crate::boring::borrowed_string_return_ops::BorrowedStringReturnOps;
use crate::runtime::u_string;
use crate::runtime::u_string::UStr;
use crate::runtime::u_string::UString;


#[derive(Debug, Clone, PartialEq)]
pub enum HaxeExceptionOpsThrowMixedFault {
    HaxeExceptionFaultFault(crate::boring::haxe_exception_ops::HaxeExceptionFault),
    BorrowedStringReturnFaultFault(crate::boring::borrowed_string_return_ops::BorrowedStringReturnFault),
}
impl std::fmt::Display for HaxeExceptionOpsThrowMixedFault {
    fn fmt(&self, formatter: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        match self {
            HaxeExceptionOpsThrowMixedFault::HaxeExceptionFaultFault(value) => write!(formatter, "{}", value),
            HaxeExceptionOpsThrowMixedFault::BorrowedStringReturnFaultFault(value) => write!(formatter, "{}", value),
        }
    }
}

impl From<HaxeExceptionOpsThrowMixedFault> for crate::boring::haxe_exception_ops::HaxeExceptionFault {
    fn from(value: HaxeExceptionOpsThrowMixedFault) -> Self {
        match value {
            HaxeExceptionOpsThrowMixedFault::HaxeExceptionFaultFault(value) => value,
            _ => panic!("fault union converted to an unrelated fault"),
        }
    }
}

impl From<HaxeExceptionOpsThrowMixedFault> for crate::boring::borrowed_string_return_ops::BorrowedStringReturnFault {
    fn from(value: HaxeExceptionOpsThrowMixedFault) -> Self {
        match value {
            HaxeExceptionOpsThrowMixedFault::BorrowedStringReturnFaultFault(value) => value,
            _ => panic!("fault union converted to an unrelated fault"),
        }
    }
}

impl From<crate::boring::haxe_exception_ops::HaxeExceptionFault> for HaxeExceptionOpsThrowMixedFault {
    fn from(value: crate::boring::haxe_exception_ops::HaxeExceptionFault) -> Self {
        HaxeExceptionOpsThrowMixedFault::HaxeExceptionFaultFault(value)
    }
}

impl From<crate::boring::borrowed_string_return_ops::BorrowedStringReturnFault> for HaxeExceptionOpsThrowMixedFault {
    fn from(value: crate::boring::borrowed_string_return_ops::BorrowedStringReturnFault) -> Self {
        HaxeExceptionOpsThrowMixedFault::BorrowedStringReturnFaultFault(value)
    }
}

#[derive(Clone, Copy)]
pub struct HaxeExceptionOps;

impl HaxeExceptionOps {
    pub fn haxe_exception_ops_throw_fault(message: &UStr) -> Result<(), HaxeExceptionFault> {
        return Err(HaxeExceptionFault::new(&(message).to_utf8_lossy()));
    }

    pub fn haxe_exception_ops_throw_joined(lead: &UStr, tail: &UStr) -> Result<(), HaxeExceptionFault> {
        return Err(HaxeExceptionFault::new(&({ let mut __s = UString::new(); __s += lead; __s += tail; __s }).to_utf8_lossy()));
    }

    pub fn haxe_exception_ops_throw_mixed(value: &UStr) -> Result<(), HaxeExceptionOpsThrowMixedFault> {
        if u_string::unit_count(&(value)) == 0 {
            return Err(HaxeExceptionOpsThrowMixedFault::HaxeExceptionFaultFault(HaxeExceptionFault::new("direct")));
        }
        BorrowedStringReturnOps::borrowed_string_return_ops_require_text(value).map_err(|e| HaxeExceptionOpsThrowMixedFault::BorrowedStringReturnFaultFault(e))?;
        Ok(())
    }
}

#[derive(Debug, Clone, PartialEq)]
pub struct HaxeExceptionFault {
    pub message: String,
}
impl HaxeExceptionFault {
    pub fn new(message: &str) -> Self {
        Self { message: message.to_string() }
    }
}
impl std::fmt::Display for HaxeExceptionFault {
    fn fmt(&self, formatter: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        write!(formatter, "{}", self.message)
    }
}
impl std::error::Error for HaxeExceptionFault {}
