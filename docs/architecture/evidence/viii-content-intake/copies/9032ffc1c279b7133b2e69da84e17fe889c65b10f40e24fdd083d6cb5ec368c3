#[derive(Clone, Copy)]
pub struct OptionalInterfaceArgumentOps;

impl OptionalInterfaceArgumentOps {
    pub fn optional_interface_argument_ops_render(shape: Option<Box<dyn OptionalArgShape>>) -> UString {
        return match &(shape) { None => UString::from("none"), Some(__option) => __option.describe().to_ustring() };
    }

    pub fn optional_interface_argument_ops_render_fresh() -> UString {
        return OptionalInterfaceArgumentOps::optional_interface_argument_ops_render(Some(Box::new(OptionalArgCircle::new())));
    }

    pub fn optional_interface_argument_ops_render_local(shape: Box<dyn OptionalArgShape>) -> UString {
        return OptionalInterfaceArgumentOps::optional_interface_argument_ops_render(Some(shape));
    }

    pub fn optional_interface_argument_ops_render_nullable_local(shape: Option<Box<dyn OptionalArgShape>>) -> UString {
        return OptionalInterfaceArgumentOps::optional_interface_argument_ops_render((shape).clone());
    }

    pub fn optional_interface_argument_ops_make_square() -> Box<dyn OptionalArgShape> {
        return Box::new(OptionalArgSquare::new());
    }
}
