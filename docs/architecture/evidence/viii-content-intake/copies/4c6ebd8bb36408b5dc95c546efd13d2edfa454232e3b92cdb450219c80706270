#![cfg(test)]

use crate::boring::data_class_ctor_guard_ops::DataClassCtorGuardOps;
use crate::boring::value_exception::ValueError;
use crate::runtime::test as testlib;
use crate::runtime::test_core;
use crate::runtime::u_string::UStr;


#[test]
fn accepts_valid_value() {
    testlib::run("tests.DataClassCtorGuardTests.acceptsValidValue", "tests.DataClassCtorGuardTests.acceptsValidValue: data-class constructor accepts finite non-negative values", || {
        let value = DataClassCtorGuardOps::new(2.5f64).unwrap();
        test_core::TestCore::test_core_equals_float(2.5f64, value.magnitude, UStr::new(&[]));
    });
}

#[test]
fn rejects_negative_value() {
    testlib::run("tests.DataClassCtorGuardTests.rejectsNegativeValue", "tests.DataClassCtorGuardTests.rejectsNegativeValue: data-class constructor rejects negative values", || {
        let mut rejected = false;
        let __outcome: Result<DataClassCtorGuardOps, ValueError> = (|| {
            return Ok(DataClassCtorGuardOps::new(-1.0f64)?);
        })();
        match __outcome {
            Ok(_) => {}
            Err(_) => {
                rejected = true;
            }
        }
        test_core::TestCore::test_core_equals_bool(true, rejected, UStr::new(&[]));
    });
}

#[test]
fn rejects_non_finite_value() {
    testlib::run("tests.DataClassCtorGuardTests.rejectsNonFiniteValue", "tests.DataClassCtorGuardTests.rejectsNonFiniteValue: data-class constructor rejects non-finite values", || {
        let mut rejected = false;
        let __outcome1: Result<DataClassCtorGuardOps, ValueError> = (|| {
            return Ok(DataClassCtorGuardOps::new(f64::INFINITY)?);
        })();
        match __outcome1 {
            Ok(_) => {}
            Err(_) => {
                rejected = true;
            }
        }
        test_core::TestCore::test_core_equals_bool(true, rejected, UStr::new(&[]));
    });
}
