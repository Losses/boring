#!/usr/bin/env bash
# L5 negative controls: deliberately-wrong inputs that must NOT land in the class
# they superficially resemble. A classifier that cannot be shown to separate the
# classes is decoration (docs/architecture/LAYERED-VERIFICATION.md L5).
set -eu
B="$(cd "$(dirname "$0")" && pwd)"
RET=/home/losses/Development/tq-workspace/dc-warn/out/ci-wire/evidence/recorded-baseline-proof-run.log

# Control A: the artifact byte-identity TEST fails, but NOT with the byte diff -
# its compiler exit-code assertion (package-artifacts.test.ts:332) fails instead.
# Must land in `assertion`, never in the flake class.
{
  printf '$ bun test tests/ packages/registry/tests/\n'
  printf 'bun test v1.3.13 (bf2e2cec)\n\n'
  printf 'tests/ts/package-artifacts.test.ts:\n'
  printf '325 |         const a = await runHaxe(`package-artifacts-id-a.hxml`, rewriteHxml(pkg.hxml, first, pkg.extra));\n'
  printf '326 |         expect(a.stderr).toBe("");\n'
  printf '327 |         expect(a.exitCode).toBe(0);\n'
  printf '                     ^\n'
  printf 'error: expect(received).toBe(expected)\n\nExpected: 0\nReceived: 1\n\n'
  printf '      at <anonymous> (/home/losses/Development/tq-workspace/boring-wt-architecture/tests/ts/package-artifacts.test.ts:327:27)\n'
  printf '(fail) package artifact emission > two generations of the same inputs produce byte-identical artifacts [418900.00ms]\n\n'
  printf '1 tests failed:\n'
  printf '(fail) package artifact emission > two generations of the same inputs produce byte-identical artifacts [418900.00ms]\n\n'
  printf ' 0 pass\n 1 fail\n 1 expect() calls\nRan 1 test across 1 file. [430000.00ms]\n'
  printf 'error: script "test" exited with code 1\n'
} > "$B/control-A-artifact-test-fails-without-byte-diff.log"

# Control B: the artifact byte-identity test exceeds its own 420 s budget. A timeout
# marker must win over the flake identity - a killed test is not a byte diff.
{
  printf '$ bun test tests/ packages/registry/tests/\n'
  printf 'bun test v1.3.13 (bf2e2cec)\n\n'
  printf 'tests/ts/package-artifacts.test.ts:\n'
  printf 'killed 1 dangling process\n'
  printf '(fail) package artifact emission > two generations of the same inputs produce byte-identical artifacts [420001.10ms]\n'
  printf '  ^ this test timed out after 420000ms.\n\n'
  printf '1 tests failed:\n'
  printf '(fail) package artifact emission > two generations of the same inputs produce byte-identical artifacts [420001.10ms]\n'
  printf '  ^ this test timed out after 420000ms.\n\n'
  printf ' 0 pass\n 1 fail\n 1 expect() calls\nRan 1 test across 1 file. [430000.00ms]\n'
  printf 'error: script "test" exited with code 1\n'
} > "$B/control-B-artifact-test-times-out.log"

# Control C: a cascade in a file with NO timeout marker. It must be reported as
# unattributed, NOT absorbed into the timeout class (which would be the waiver).
{
  printf '$ bun test tests/ packages/registry/tests/\n'
  printf 'bun test v1.3.13 (bf2e2cec)\n\n'
  printf 'tests/ts/registry-roundtrip.test.ts:\n'
  printf '(pass) registry roundtrip > the manifest round-trips [3.00ms]\n'
  printf '# Unhandled error between tests\n'
  printf -- '-------------------------------\n'
  printf 'error: generate-repeat: \nExpected: 0\nReceived: null\n'
  printf -- '-------------------------------\n'
  printf '(fail) registry roundtrip > regenerating twice keeps the manifest [1.00ms]\n\n'
  printf '1 tests failed:\n'
  printf '(fail) registry roundtrip > regenerating twice keeps the manifest [1.00ms]\n\n'
  printf ' 1 pass\n 1 fail\n 1 errors\n 1 expect() calls\nRan 2 tests across 1 file. [40.00ms]\n'
  printf 'error: script "test" exited with code 1\n'
} > "$B/control-C-cascade-without-timeout.log"

# Control D: the package-shell.test.ts:249 spec gap, verbatim from the retained log.
# MANAGEMENT-RULING-005 forbids classifying it as a timeout or hiding it as the flake;
# it must land in `assertion`.
{
  printf '$ bun test tests/ packages/registry/tests/\n'
  printf 'bun test v1.3.13 (bf2e2cec)\n\n'
  sed -n '684,702p' "$RET"
  printf '\n1 tests failed:\n'
  sed -n '702p' "$RET"
  printf '\n 5 pass\n 1 fail\n 5 expect() calls\nRan 6 tests across 1 file. [200000.00ms]\n'
  printf 'error: script "test" exited with code 1\n'
} > "$B/control-D-package-shell-spec-gap.log"

echo "built 4 controls"

# Control E: the run died before printing any summary or recap (a crash / OOM kill).
# The classifier must fall back to the inline body, deduplicate by test id, and say the
# total is unknown instead of inventing a reconciliation against a total that is absent.
{
  printf '$ bun test tests/ packages/registry/tests/\n'
  printf 'bun test v1.3.13 (bf2e2cec)\n\n'
  printf 'tests/ts/precision-switch.test.ts:\n'
  printf 'killed 1 dangling process\n'
  printf '(fail) float precision switch on the TypeScript target > float-precision=f32 aborts the TS compile with the startup error [5000.93ms]\n'
  printf '  ^ this test timed out after 5000ms.\n\n'
  printf 'tests/ts/legacy.test.ts:\n'
  printf '(pass) legacy > still runs\n'
} > "$B/control-E-died-before-summary.log"
echo "built control E"

# Control F: a Buffer byte-identity diff in a DIFFERENT test file. The flake class is
# narrow by design (test identity AND shape); this must land in `assertion` with the
# summary saying the byte-diff shape was seen but is not the known artifact flake.
{
  printf '$ bun test tests/ packages/registry/tests/\n'
  printf 'bun test v1.3.13 (bf2e2cec)\n\n'
  printf 'tests/ts/vector.test.ts:\n'
  printf 'error: expect(received).toEqual(expected)\n\n'
  printf '  {\n    "data": [\n      1,\n      0,\n'
  printf -- '-     4,\n-     0,\n-     0,\n'
  printf -- '+     5,\n+     0,\n+     0,\n'
  printf '      0,\n    ],\n    "type": "Buffer",\n  }\n\n'
  printf -- '- Expected  - 3\n+ Received  + 3\n\n'
  printf '      at <anonymous> (/home/losses/Development/tq-workspace/boring-wt-architecture/tests/ts/vector.test.ts:88:31)\n'
  printf '(fail) committed cross-language vector > re-encoding the decoded records reproduces the committed bytes [4.00ms]\n\n'
  printf '1 tests failed:\n'
  printf '(fail) committed cross-language vector > re-encoding the decoded records reproduces the committed bytes [4.00ms]\n\n'
  printf ' 0 pass\n 1 fail\n 1 expect() calls\nRan 1 test across 1 file. [30.00ms]\n'
  printf 'error: script "test" exited with code 1\n'
} > "$B/control-F-buffer-diff-other-file.log"
echo "built control F"

# Control G: a GREEN log. The attribution section must not fail the step, invent a
# total, or claim a residual on a run with nothing to attribute.
{
  printf '$ bun test tests/ packages/registry/tests/\n'
  printf 'bun test v1.3.13 (bf2e2cec)\n\n'
  printf 'tests/ts/vector.test.ts:\n'
  printf '(pass) committed cross-language vector > decoded binary matches the JSON description [3.00ms]\n'
  printf '(pass) vector format > decode rejects trailing bytes with the TrailingBytes variant [1.00ms]\n\n'
  printf 'tests/ts/arithmetic-helpers.test.ts:\n'
  printf '(pass) arithmetic helpers generated tree > Rust inlines arithmetic helpers into native comparison operators and if-blocks [1.00ms]\n\n'
  printf ' 3 pass\n 0 fail\n 3 expect() calls\nRan 3 tests across 2 files. [40.00ms]\n'
} > "$B/control-G-green-run.log"
echo "built control G"
