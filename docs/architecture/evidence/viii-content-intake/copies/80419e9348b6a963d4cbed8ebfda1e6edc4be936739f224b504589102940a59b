#![cfg(test)]

use crate::boring::interface_getter_property::InterfaceGetterProperty;
use crate::boring::interface_getter_property::InterfaceGetterPropertyImpl;
use crate::boring::interface_getter_property::InterfaceGetterPropertyUse;
use crate::runtime::test as testlib;
use crate::runtime::test_core;
use crate::runtime::u_string::UStr;


#[test]
fn test_interface_getter_property() {
    testlib::run("tests.InterfaceGetterPropertyTests.testInterfaceGetterProperty", "tests.InterfaceGetterPropertyTests.testInterfaceGetterProperty: reads a getter-only property through the interface type", || {
        let iface: Box<dyn InterfaceGetterProperty> = Box::new(InterfaceGetterPropertyImpl::new(&(UStr::new(&[104,101,108,108,111]))));
        let actual = iface.get_name();
        test_core::TestCore::test_core_equals_string(UStr::new(&[104,101,108,108,111]), actual.as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[104,101,108,108,111]), InterfaceGetterPropertyUse::interface_getter_property_use_name_of(iface.clone()).as_ustr(), UStr::new(&[]));
    });
}
