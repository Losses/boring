import re
# file -> target attribution rules based on line content
rust_markers = ('UString','UStr','to_ustring','as_ustr','i32::from_ne_bytes','u32::from_ne_bytes','fn ','pub ','Mutex<','LazyLock','Vec<','HashMap','Option<','String::new','write!(','not.toContain(" as "')
out = []
for line in open('inventory-sweep-base.txt'):
    line = line.rstrip('\n')
    m = re.match(r'(\S+?):(\d+):(.*)', line)
    f, ln, code = m.group(1), m.group(2), m.group(3)
    base = f.split('/')[-1]
    c = code.strip()
    # test-infra / comments / names / file-reads
    if '//' in code and code.strip().startswith('//') or c.startswith('[') and 'reference' in c:
        cls = 'I'
    elif re.search(r'String\.fromCharCode|stdout\.toString|stderr\.toString|spawn\(|\.hxml|Bun\.|process\.|toString\(\) \+|expect\(proc', c):
        cls = 'I'
    elif re.search(r'^\s*test\(', c) or re.search(r'const (content|rust|decl|ops|swift|dart|ts|proc|result|stdout) =|readFileSync|fs\.existsSync|path\.join|\.test\.ts|\["reference', c):
        cls = 'I'
    # haxe-source mutation inputs
    elif re.search(r'hxSource|HX_SOURCE|samples/|\.hx|public static function|import |class \w+ \{|override fun|val \w+:|final \w+ =|static function|:Void|Float|:Int\b', c) and re.search(r'function |class |:Void|:Int|:Float|:Bool|static function|package |import |public |override |final ', c):
        cls = 'I'
    # non-Rust targets
    elif re.search(r'fun |MutableList|MutableMap|data class|: String|String =|String\?|String\[|: Int\b|TiqianArray|ReadOnlyArray|\[String|Optional<String>|String: Int32|-> String\b|\(String|String\)|func |String =|Int32\)|String\)|enum FloatWidth|CaseIterable|String,|joinToString|toRadixString|toUpperCase|padLeft|toLowerCase|compareStrings|\.ts"|\.kt"|\.swift"|\.dart"|List<String>|Map<String|String\?|String, |String\] =|var \w+: String|: String =|String, prefix|String, sep|String = name|text\.uppercase|String? = nil', c) and 'UString' not in c and 'UStr' not in c and 'to_ustring' not in c:
        cls = 'N'
    # Rust target
    elif any(k in c for k in rust_markers) or re.search(r'-> UString|-> &UStr|&UStr|UString::|UStr::|to_ustring|-> i32|-> u32|-> f64|-> bool|SortedTable|SortedMap|SortedSet|Mutex<|LazyLock<|Vec<UString|Option<UString|Vec<UString|String::new|write!\(|\.to_string\(\)|as_str|unwrap_or_else', c):
        # distinguish legit vs refreshed
        if re.search(r'not\.toContain\(|not\.toMatch\(', c):
            cls = 'L-guard'
        elif re.search(r'String::new|write!\(|to_string\(\)|\.to_string', c) and 'UString' not in c and 'UStr' not in c:
            cls = 'L'
        else:
            cls = 'R'
    else:
        cls = '?'
    out.append(f'{cls}|{f}:{ln}|{c[:110]}')
open('inventory-classified.txt','w').write('\n'.join(out))
from collections import Counter
print(Counter(o.split('|')[0] for o in out))
print('--- UNKNOWN/LEGIT lines ---')
for o in out:
    if o.split('|')[0] in ('?','L','L-guard'):
        print(o)
