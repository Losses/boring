#![cfg(test)]

use crate::runtime::test as testlib;
use crate::runtime::test_core;
use crate::runtime::u_string::UStr;


#[test]
fn test_find_from() {
    testlib::run("tests.StringSearchFromTests.testFindFrom", "tests.StringSearchFromTests.testFindFrom: a string index search keeps its start index", || {
        test_core::TestCore::test_core_equals_bool(true, true, UStr::new(&[]));
    });
}

