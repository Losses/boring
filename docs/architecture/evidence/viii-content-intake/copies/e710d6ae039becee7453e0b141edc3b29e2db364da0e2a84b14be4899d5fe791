package tests

import boring.OverrideMemberOps
import boring.runtime.test.Test

class OverrideMemberTests {
@boring.test.Test
    fun hashMember() {
        Test.run("tests.OverrideMemberTests.hashMember", "tests.OverrideMemberTests.hashMember: a handwritten zero-argument hashCode is emitted as an Any override") {
                Test.equals(17, OverrideMemberOps.hash(17), null)
        }
    }

@boring.test.Test
    fun ordinary() {
        Test.run("tests.OverrideMemberTests.ordinary", "tests.OverrideMemberTests.ordinary: ordinary members remain ordinary") {
                Test.equals("ordinary", OverrideMemberOps.ordinary(), null)
        }
    }

@boring.test.Test
    fun message() {
        Test.run("tests.OverrideMemberTests.message", "tests.OverrideMemberTests.message: message payloads retain their value") {
                Test.equals("payload", OverrideMemberOps.message("payload"), null)
        }
    }
}
