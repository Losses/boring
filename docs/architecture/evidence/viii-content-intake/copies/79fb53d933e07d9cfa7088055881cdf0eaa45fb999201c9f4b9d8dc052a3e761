package boring

object SwitchCaseScopeOps {
    fun toneRow(kind: ToneKind, n: Int): Int {
        return when (kind) {
            ToneKind.Yinping -> 0
            ToneKind.Yangping -> {
                val row = n * 2
                row
            }
            ToneKind.Shang -> {
                val row_2 = n * 3
                row_2
            }
            ToneKind.Qu -> {
                val row_3 = n * 4
                row_3
            }
            ToneKind.Neutral -> 0
            ToneKind.Ru -> {
                val row_4 = n * 5
                row_4
            }
        }
    }

    fun toneInk(kind: ToneKind, inkTop: Double, inkBottom: Double): Double {
        return when (kind) {
            ToneKind.Yinping -> 0.0
            ToneKind.Yangping -> {
                val top = inkTop
                val bottom = inkBottom
                top + bottom
            }
            ToneKind.Shang -> {
                val top_2 = inkTop * 2.0
                val bottom_2 = inkBottom * 2.0
                top_2 + bottom_2
            }
            ToneKind.Qu -> {
                val top_3 = inkTop * 3.0
                val bottom_3 = inkBottom * 3.0
                top_3 + bottom_3
            }
            ToneKind.Neutral -> 0.0
            ToneKind.Ru -> {
                val top_4 = inkTop * 4.0
                val bottom_4 = inkBottom * 4.0
                top_4 + bottom_4
            }
        }
    }

    fun mixed(kind: ToneKind, n: Int): Int {
        return when (kind) {
            ToneKind.Yinping -> 1
            ToneKind.Yangping -> 2
            ToneKind.Shang -> {
                val tmp = n + 10
                tmp
            }
            ToneKind.Qu -> {
                val tmp_2 = n + 20
                tmp_2
            }
            ToneKind.Neutral -> 3
            ToneKind.Ru -> {
                val tmp_3 = n + 30
                tmp_3
            }
        }
    }
}

enum class ToneKind {
    Yinping,
    Yangping,
    Shang,
    Qu,
    Neutral,
    Ru
}
fun compareToneKind(a: ToneKind, b: ToneKind): Int = a.ordinal - b.ordinal
