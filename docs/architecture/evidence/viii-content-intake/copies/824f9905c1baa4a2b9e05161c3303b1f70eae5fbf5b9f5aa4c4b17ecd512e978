251:     public static function render(plan:SwiftArrayBoundaryPlan, operand:String, elementText:Null<String>):String {
252:         return switch (plan.operation) {
253:             case KeepPreparedArray | PreserveNullArrayValue: operand;
254:             case WrapMutableArrayView: "ReadOnlyArray(" + operand + ")";
255:             case MapOptionalMutableArrayView: "(" + operand + ").map { ReadOnlyArray($0) }";
256:             case ContextualReadOnlyEmpty:
257:                 elementText == null ?throw new haxe.Exception("read-only empty array boundary is missing its element type"):"ReadOnlyArray<" + elementText +
258:                 ">()";
259:             case CopyReadOnlyIntoMutableArray: operand + ".toMutableArray()";
260:             case MapOptionalReadOnlyIntoMutableArray: "(" + operand + ").map { $0.toMutableArray() }";
261:         };
262:     }
