143:     /** Distinguish a container boundary from an ordinary assignment. */
144:     public static function isBoundary(sourceType:Null<Type>, destinationType:Null<Type>):Bool
145:         return isReadOnlyArray(destinationType) || (isMutableArray(destinationType) && isReadOnlyArray(sourceType));
