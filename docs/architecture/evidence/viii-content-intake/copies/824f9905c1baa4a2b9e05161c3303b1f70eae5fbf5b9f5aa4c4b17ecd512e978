147:     /** Classify source syntax; it does not replace a prepared storage fact. */
148:     public static function sourceStorage(t:Null<Type>, emptyLiteral:Bool = false, nullLiteral:Bool = false):SwiftArrayStorage {
149:         if (nullLiteral)
150:             return NullArrayValue;
151:         if (emptyLiteral)
152:             return ContextualEmptyLiteral;
153:         if (isReadOnlyArray(t))
154:             return ReadOnlyArrayView;
155:         if (isMutableArray(t))
156:             return MutableArrayWrapper;
157:         return OtherArrayStorage;
158:     }
