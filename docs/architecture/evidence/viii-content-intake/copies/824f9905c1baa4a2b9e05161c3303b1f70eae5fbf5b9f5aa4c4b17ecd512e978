160:     /**
161:         Prepare a boundary from actual emitted representation and flow state.
162:         Source and destination Types preserve Haxe type evidence; they never
163:         override preparedStorage or preparedOptionality.
164:     **/
165:     public static function prepare(operand:SwiftArrayPreparedOperand, destinationType:Null<Type>,
166:             destinationOptionalOverride:Null<Bool> = null):Null<SwiftArrayBoundaryPlan> {
167:         final sourceType = operand.sourceType;
168:         final preparedStorage = operand.storage;
169:         final preparedOptionality = operand.optionality;
170:         final presenceFact = operand.presenceFact;
171:         final destReadOnly = isReadOnlyArray(destinationType);
172:         final destMutable = isMutableArray(destinationType);
173:         final destOptional = destinationOptionalOverride == null ? isOptionalType(destinationType) : destinationOptionalOverride;
174:         var operation:Null<SwiftArrayOperation> = null;
175:         var resultStorage = preparedStorage;
176:         var resultOptionality = preparedOptionality;
177:         final element = destReadOnly ? elementType(destinationType) : elementType(sourceType);
178: 
179:         if (destReadOnly) {
180:             switch (preparedStorage) {
181:                 case ContextualEmptyLiteral:
182:                     if (element != null) {
183:                         operation = ContextualReadOnlyEmpty;
184:                         resultStorage = ReadOnlyArrayView;
185:                         resultOptionality = RequiredOperand;
186:                     }
187:                 case NullArrayValue:
188:                     if (destOptional) {
189:                         operation = PreserveNullArrayValue;
190:                         resultStorage = NullArrayValue;
191:                         resultOptionality = OptionalOperand;
192:                     }
193:                 case MutableArrayWrapper:
194:                     if (element != null) {
195:                         resultStorage = ReadOnlyArrayView;
196:                         switch (preparedOptionality) {
197:                             case RequiredOperand:
198:                                 operation = WrapMutableArrayView;
199:                                 resultOptionality = RequiredOperand;
200:                             case OptionalOperand if (destOptional):
201:                                 operation = MapOptionalMutableArrayView;
202:                                 resultOptionality = OptionalOperand;
203:                             case OptionalOperand:
204:                         }
205:                     }
206:                 case ReadOnlyArrayView:
207:                     if (preparedOptionality == RequiredOperand || destOptional) {
208:                         operation = KeepPreparedArray;
209:                     }
210:                 case OtherArrayStorage:
211:             }
212:         } else if (destMutable && preparedStorage == ReadOnlyArrayView && element != null) {
213:             resultStorage = MutableArrayWrapper;
214:             switch (preparedOptionality) {
215:                 case RequiredOperand:
216:                     operation = CopyReadOnlyIntoMutableArray;
217:                     resultOptionality = RequiredOperand;
218:                 case OptionalOperand if (destOptional):
219:                     operation = MapOptionalReadOnlyIntoMutableArray;
220:                     resultOptionality = OptionalOperand;
221:                 case OptionalOperand:
222:             }
223:         }
224: 
225:         if (isOptionalType(sourceType)
226:             && preparedOptionality == RequiredOperand
227:             && presenceFact != LiteralProvenPresent
228:             && presenceFact != GuardProvenPresent
229:             && presenceFact != BranchValuesRequired
230:             && presenceFact != DefaultMaterializedPresent)
231:             operation = null;
232: 
233:         if (operation == null)
234:             return null;
235: 
236:         return {
237:             sourceType: sourceType,
238:             destinationType: destinationType,
239:             sourceStorage: preparedStorage,
240:             sourceOptionality: preparedOptionality,
241:             presenceFact: presenceFact,
242:             destinationOptional: destOptional,
243:             resultStorage: resultStorage,
244:             resultOptionality: resultOptionality,
245:             elementType: element,
246:             operation: operation
247:         };
248:     }
