67: /**
68:     Swift-local storage and conversion decisions for Haxe array boundaries.
69:     The producer receives AST provenance, the storage representation
70:     established by operand preparation, and flow-derived optionality. It
71:     never prints or reads emitted text. Rendering consumes this immutable
72:     plan plus the operand string from the same preparation environment.
73: **/
74: class SwiftArrayBoundary {
75:     static function withoutNull(t:Null<Type>):Null<Type> {
76:         if (t == null)
77:             return null;
78:         return switch (Context.follow(t)) {
79:             case TAbstract(a, [inner]) if (a.get().name == "Null"): withoutNull(inner);
80:             case _: t;
81:         };
82:     }
83: 
84:     static function isMutableArray(t:Null<Type>):Bool {
85:         return switch (Context.follow(withoutNull(t))) {
86:             case TInst(c, _): c.get().pack.length == 0 && c.get().name == "Array";
87:             case TAbstract(a, _): a.get().name == "Array";
88:             case _: false;
89:         };
90:     }
91: 
92:     static function isReadOnlyArray(t:Null<Type>):Bool
93:         return StaticFieldHelper.isReadOnlyArrayType(t);
94: 
95:     static function isOptionalType(t:Null<Type>):Bool {
96:         if (t == null)
97:             return false;
98:         switch (t) {
99:             case TAbstract(a, _) if (a.get().name == "Null"):
100:                 return true;
101:             case _:
102:         }
103:         return switch (Context.follow(t)) {
104:             case TAbstract(a, _) if (a.get().name == "Null"): true;
105:             case _: false;
106:         };
107:     }
108: 
109:     public static function isOptionalArrayType(t:Null<Type>):Bool
110:         return isOptionalType(t);
111: 
112:     static function elementType(t:Null<Type>):Null<Type> {
113:         if (t == null)
114:             return null;
115:         switch (t) {
116:             case TAbstract(a, [inner]) if (a.get().name == "Null"):
117:                 return elementType(inner);
118:             case _:
119:         }
120:         final unwrapped = withoutNull(t);
121:         final direct = switch (unwrapped) {
122:             case TInst(c, params) if (c.get().name == "Array" && params.length > 0): params[0];
123:             case TAbstract(a, params) if ((a.get().name == "ReadOnlyArray" || a.get().module == "std.ReadOnlyArray")
124:                 && params.length > 0): params[0];
125:             case TType(d, params) if ((d.get().name == "ReadOnlyArray" || d.get().module == "std.ReadOnlyArray")
126:                 && params.length > 0): params[0];
127:             case TLazy(f): return elementType(f());
128:             case _: null;
129:         };
130:         if (direct != null)
131:             return direct;
132:         return switch (Context.follow(unwrapped)) {
133:             case TInst(c, params) if (c.get().name == "Array" && params.length > 0): params[0];
134:             case TAbstract(a, params) if ((a.get().name == "ReadOnlyArray" || a.get().module == "std.ReadOnlyArray")
135:                 && params.length > 0): params[0];
136:             case TType(d, params) if ((d.get().name == "ReadOnlyArray" || d.get().module == "std.ReadOnlyArray")
137:                 && params.length > 0): params[0];
138:             case TLazy(f): elementType(f());
139:             case _: null;
140:         };
141:     }
