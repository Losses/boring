package tests

import boring.FloatWidth
import boring.StdStringOps
import boring.runtime.test.Test
import tests.TestHelper

class StdStringTests {
@boring.test.Test
    fun concatenatedScalars() {
        Test.run("tests.StdStringTests.concatenatedScalars", "tests.StdStringTests.concatenatedScalars: Std.string converts scalar operands inside concatenation") {
                Test.equals("string=text", StdStringOps.concatString("text"), null)
                Test.equals("int=42", StdStringOps.concatInt(42), null)
                Test.equals("float=2.5", StdStringOps.concatFloat(2.5), null)
                Test.equals("bool=true", StdStringOps.concatBool(true), null)
        }
    }

@boring.test.Test
    fun standaloneScalars() {
        Test.run("tests.StdStringTests.standaloneScalars", "tests.StdStringTests.standaloneScalars: Std.string converts standalone scalar operands") {
                Test.equals("text", StdStringOps.stringValue("text"), null)
                Test.equals("42", StdStringOps.intValue(42), null)
                Test.equals("2.5", StdStringOps.floatValue(2.5), null)
                Test.equals("false", StdStringOps.boolValue(false), null)
        }
    }

@boring.test.Test
    fun valueEnumerations() {
        Test.run("tests.StdStringTests.valueEnumerations", "tests.StdStringTests.valueEnumerations: Std.string converts value enumeration operands to constructor names") {
                Test.equals("enum=F64", StdStringOps.concatEnum(FloatWidth.F64), null)
                Test.equals("F16", StdStringOps.enumValue(FloatWidth.F16), null)
                Test.equals(true, StdStringOps.enumMatchesConstructor(), null)
        }
    }

@boring.test.Test
    fun floatForms() {
        Test.run("tests.StdStringTests.floatForms", "tests.StdStringTests.floatForms: Std.string uses the ECMAScript float spelling") {
                val forms = mutableListOf<String>("2", "0", "0", "2.5", "-1.25", "100000000000000000000", "1e+21", "0.000001", "1e-7")
                TestHelper.assertEquals(forms, StdStringOps.floatForms(), null)
        }
    }

@boring.test.Test
    fun arrays() {
        Test.run("tests.StdStringTests.arrays", "tests.StdStringTests.arrays: Std.string renders arrays with ruled separators and element forms") {
                Test.equals("[1, 2, 3]", StdStringOps.intArray(), null)
                Test.equals("[alpha, beta]", StdStringOps.stringArray(), null)
                Test.equals("[1.5, 2.25]", StdStringOps.floatArray(), null)
                Test.equals("[true, false]", StdStringOps.boolArray(), null)
                Test.equals("[F64, F16]", StdStringOps.enumArray(), null)
                Test.equals("[]", StdStringOps.emptyArray(), null)
                Test.equals("[[1, 2], [3]]", StdStringOps.nestedArray(), null)
                Test.equals("[alpha, beta]", StdStringOps.readOnlyArray(), null)
        }
    }
}
