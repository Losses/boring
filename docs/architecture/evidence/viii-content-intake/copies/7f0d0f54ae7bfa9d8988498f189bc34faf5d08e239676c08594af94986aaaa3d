object NumericConversionWidening {
    fun compareEqual(a: Float, b: Int): Boolean {
        return a == (b).toFloat()
    }

    fun compareNotEqual(a: Float, b: Int): Boolean {
        return a != (b).toFloat()
    }

    fun returnIntAsFloat(x: Int): Float {
        return (x).toFloat()
    }

    fun initFloat(): Float {
        val x = (16).toFloat()
        return x
    }

    fun assignIntToFloat(): Float {
        var x = (0).toFloat()
        x = (42).toFloat()
        return x
    }

    fun floatParam(value: Float): Float {
        return value + 1.0f
    }

    fun callFloatParam(): Float {
        return NumericConversionWidening.floatParam((8).toFloat())
    }
}
