#![cfg(test)]

use crate::boring::string_unit_ops::StringUnitOps;
use crate::runtime::test as testlib;
use crate::runtime::test_core;
use crate::runtime::u_string;
use crate::runtime::u_string::UStr;
use crate::runtime::u_string::UString;
use crate::tests::test_helper::*;


#[test]
fn unit_surface() {
    testlib::run("tests.StringUnitTests.unitSurface", "tests.StringUnitTests.unitSurface: code-unit reads and splits follow the unit domain", || {
        assert_equals_opt(&Some(46), &StringUnitOps::string_unit_ops_code_in_range(UStr::new(&[97,46,98])), UStr::new(&[]));
        assert_equals_opt(&Some(26912), &StringUnitOps::string_unit_ops_code_in_range(UStr::new(&[25552,26912])), UStr::new(&[]));
        assert_equals_opt(&Some(98), &StringUnitOps::string_unit_ops_code_at_end(UStr::new(&[97,98])), UStr::new(&[]));
        test_core::TestCore::test_core_equals_bool(true, StringUnitOps::string_unit_ops_code_out_of_range(UStr::new(&[97,98])).is_none(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_bool(true, StringUnitOps::string_unit_ops_is_space_at(UStr::new(&[97,32,98]), 1), UStr::new(&[]));
        test_core::TestCore::test_core_equals_bool(false, StringUnitOps::string_unit_ops_is_space_at(UStr::new(&[97,32,98]), 99), UStr::new(&[]));
        test_core::TestCore::test_core_equals_int(-1i32, i32::from_ne_bytes(((StringUnitOps::string_unit_ops_code_at_or_fallback(UStr::new(&[97,98]), 99)) as i32).to_ne_bytes()), UStr::new(&[]));
        test_core::TestCore::test_core_equals_int(97i32, i32::from_ne_bytes(((StringUnitOps::string_unit_ops_code_at_or_fallback(UStr::new(&[97,98,99]), 0)) as i32).to_ne_bytes()), UStr::new(&[]));
        test_core::TestCore::test_core_equals_int(3i32, i32::from_ne_bytes(((StringUnitOps::string_unit_ops_split_count(UStr::new(&[49,46,48,46,48]))) as i32).to_ne_bytes()), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[49]), StringUnitOps::string_unit_ops_split_first(UStr::new(&[49,46,48,46,48])).as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_int(3i32, i32::from_ne_bytes(((StringUnitOps::string_unit_ops_split_empty_parts(UStr::new(&[97,46,46,46,46,98]))) as i32).to_ne_bytes()), UStr::new(&[]));
        test_core::TestCore::test_core_equals_int(1i32, i32::from_ne_bytes(((StringUnitOps::string_unit_ops_split_absent(UStr::new(&[97,98,99]))) as i32).to_ne_bytes()), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[97,98,99]), u_string::substring(&UString::from("abcdef"), -2i32, 3i32).as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[98,99,100,101,102]), u_string::substring(&UString::from("abcdef"), 1i32, 99i32).as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[98,99]), u_string::substring(&UString::from("abcdef"), 3i32, 1i32).as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[99,100,101,102]), u_string::substring_from(&UString::from("abcdef"), 2i32).as_ustr(), UStr::new(&[]));
    });
}

#[test]
fn char_code_at_unit_domain() {
    testlib::run("tests.StringUnitTests.charCodeAtUnitDomain", "tests.StringUnitTests.charCodeAtUnitDomain: charCodeAt addresses UTF-16 code units", || {
        assert_equals_opt(&Some(97), &StringUnitOps::string_unit_ops_code_at(UStr::new(&[97,98]), 0), UStr::new(&[]));
        assert_equals_opt(&Some(98), &StringUnitOps::string_unit_ops_code_at(UStr::new(&[97,98]), 1), UStr::new(&[]));
        test_core::TestCore::test_core_equals_bool(true, StringUnitOps::string_unit_ops_code_at(UStr::new(&[97,98]), 2).is_none(), UStr::new(&[]));
        let text = { let mut __s = UString::new(); __s += &(UString::from("a")); __s += u_string::from_code_point(128512).as_ustr(); __s += &(UString::from("b")); __s };
        assert_equals_opt(&Some(97), &StringUnitOps::string_unit_ops_code_at(text.as_ustr(), 0), UStr::new(&[]));
        assert_equals_opt(&Some(55357), &StringUnitOps::string_unit_ops_code_at(text.as_ustr(), 1), UStr::new(&[]));
        assert_equals_opt(&Some(56832), &StringUnitOps::string_unit_ops_code_at(text.as_ustr(), 2), UStr::new(&[]));
        assert_equals_opt(&Some(98), &StringUnitOps::string_unit_ops_code_at(text.as_ustr(), 3), UStr::new(&[]));
        test_core::TestCore::test_core_equals_bool(true, StringUnitOps::string_unit_ops_code_at(text.as_ustr(), 4).is_none(), UStr::new(&[]));
    });
}

#[test]
fn substr_unit_domain() {
    testlib::run("tests.StringUnitTests.substrUnitDomain", "tests.StringUnitTests.substrUnitDomain: substr counts UTF-16 code units", || {
        let astral = u_string::from_code_point(128512);
        let text = { let mut __s = UString::new(); __s += &(UString::from("a")); __s += astral.as_ustr(); __s += &(UString::from("b")); __s };
        test_core::TestCore::test_core_equals_string(UStr::new(&[97]), StringUnitOps::string_unit_ops_unit_cut(text.as_ustr(), 0, 1).as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(astral.as_ustr(), StringUnitOps::string_unit_ops_unit_cut(text.as_ustr(), 1, 2).as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[98]), StringUnitOps::string_unit_ops_unit_cut(text.as_ustr(), 3, 1).as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[]), StringUnitOps::string_unit_ops_unit_cut(text.as_ustr(), 4, 1).as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string((UString::from(format!("{}", { let mut __s = UString::new(); __s += astral.as_ustr(); __s += &(UString::from("b")); __s }).as_str())).as_ustr(), StringUnitOps::string_unit_ops_unit_cut_from(text.as_ustr(), 1).as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[98]), StringUnitOps::string_unit_ops_unit_cut(text.as_ustr(), 4294967295u32, 1).as_ustr(), UStr::new(&[]));
    });
}

#[test]
fn split_empty_delimiter() {
    testlib::run("tests.StringUnitTests.splitEmptyDelimiter", "tests.StringUnitTests.splitEmptyDelimiter: empty delimiter splits one part per code unit", || {
        let letters = StringUnitOps::string_unit_ops_split_units(UStr::new(&[97,98,99]));
        test_core::TestCore::test_core_equals_int(3i32, i32::from_ne_bytes(((u32::try_from((letters.len()) & 0xFFFF_FFFF).unwrap_or(0)) as i32).to_ne_bytes()), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[97]), (letters[0usize]).clone().as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[98]), (letters[1usize]).clone().as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[99]), (letters[2usize]).clone().as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_int(3i32, i32::from_ne_bytes(((StringUnitOps::string_unit_ops_split_unit_count(UStr::new(&[97,98,99]))) as i32).to_ne_bytes()), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[97]), StringUnitOps::string_unit_ops_split_unit_at(UStr::new(&[97,98,99]), 0).as_ustr(), UStr::new(&[]));
        assert_equals_opt(&Some(97), &StringUnitOps::string_unit_ops_split_unit_code(UStr::new(&[97,98,99]), 0), UStr::new(&[]));
        test_core::TestCore::test_core_equals_int(1i32, i32::from_ne_bytes(((u32::try_from((StringUnitOps::string_unit_ops_split_units(UStr::new(&[53])).len()) & 0xFFFF_FFFF).unwrap_or(0)) as i32).to_ne_bytes()), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[53]), (StringUnitOps::string_unit_ops_split_units(UStr::new(&[53]))[0usize]).clone().as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_int(1i32, i32::from_ne_bytes(((StringUnitOps::string_unit_ops_split_unit_count(UStr::new(&[53]))) as i32).to_ne_bytes()), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[53]), StringUnitOps::string_unit_ops_split_unit_at(UStr::new(&[53]), 0).as_ustr(), UStr::new(&[]));
    });
}

#[test]
fn split_empty_delimiter_surrogates() {
    testlib::run("tests.StringUnitTests.splitEmptyDelimiterSurrogates", "tests.StringUnitTests.splitEmptyDelimiterSurrogates: empty delimiter keeps a surrogate pair as two units", || {
        let astral = u_string::from_code_point(128512);
        let text = { let mut __s = UString::new(); __s += &(UString::from("a")); __s += astral.as_ustr(); __s += &(UString::from("b")); __s };
        test_core::TestCore::test_core_equals_int(4i32, i32::from_ne_bytes(((u_string::unit_count(&(text))) as i32).to_ne_bytes()), UStr::new(&[]));
        let units = StringUnitOps::string_unit_ops_split_units(text.as_ustr());
        test_core::TestCore::test_core_equals_int(4i32, i32::from_ne_bytes(((u32::try_from((units.len()) & 0xFFFF_FFFF).unwrap_or(0)) as i32).to_ne_bytes()), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[97]), (units[0usize]).clone().as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[98]), (units[3usize]).clone().as_ustr(), UStr::new(&[]));
    });
}
