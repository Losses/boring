package laz;

import std.ReadOnlyArray;

enum Pick { A; B; }

enum LazFault { Only(tag:String); }

class LazException extends haxe.Exception {
	public final fault:LazFault;
	public function new(fault:LazFault) {
		this.fault = fault;
		super(LazException.describe(fault));
	}
	public static function describe(f:LazFault):String {
		return switch (f) { case Only(tag): tag; };
	}
}

class Laz {
	static var log:String = "";
	static var calls:Int = 0;
	static function a():Array<Int> { calls++; log += "a"; return [1]; }
	static function b():Array<Int> { calls++; log += "b"; return [2]; }
	static function reset():Void { log = ""; calls = 0; }
	static function consume(v:ReadOnlyArray<Int>):Int return v.length;

	// switch initializer at a ReadOnlyArray destination
	public static function bySwitch(p:Pick):String {
		reset();
		var view:ReadOnlyArray<Int> = switch (p) { case A: a(); case B: b(); };
		return view.length + ":" + log + ":" + calls;
	}
	// try initializer at a ReadOnlyArray destination
	public static function byTry(flag:Bool):String {
		reset();
		var view:ReadOnlyArray<Int> = try {
			if (flag) throw new LazException(LazFault.Only("x"));
			a();
		} catch (e:LazException) {
			b();
		}
		return view.length + ":" + log + ":" + calls;
	}
	// ternary control
	public static function byTernary(flag:Bool):String {
		reset();
		var view:ReadOnlyArray<Int> = flag ? a() : b();
		return view.length + ":" + log + ":" + calls;
	}
	// expression block in argument position
	public static function byBlockArg():String {
		reset();
		var n = consume({
			var t = a();
			t;
		});
		return n + ":" + log + ":" + calls;
	}
}
