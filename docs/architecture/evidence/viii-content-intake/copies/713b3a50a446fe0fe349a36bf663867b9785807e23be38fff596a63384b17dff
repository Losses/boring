#[derive(Clone, Copy)]
pub struct NumericCoalesceLocalOps;

impl NumericCoalesceLocalOps {
    pub fn numeric_coalesce_local_ops_pick(penalty: Option<u32>) -> u32 {
        let cost = match &(penalty) { None => 5, Some(__option) => *__option };
        return NumericCoalesceLocalOps::numeric_coalesce_local_ops_add_one(cost);
    }

    pub fn numeric_coalesce_local_ops_sum_pair(left: Option<u32>, right: Option<u32>) -> u32 {
        let a = match &(left) { None => 1, Some(__option1) => *__option1 };
        let b = match &(right) { None => 2, Some(__option2) => *__option2 };
        return NumericCoalesceLocalOps::numeric_coalesce_local_ops_combine(a, b);
    }

    pub(crate) fn numeric_coalesce_local_ops_add_one(value: u32) -> u32 {
        return u32::wrapping_add(value, 1);
    }

    pub(crate) fn numeric_coalesce_local_ops_combine(a: u32, b: u32) -> u32 {
        return u32::wrapping_add(a, b);
    }
}
