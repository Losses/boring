use crate::runtime::u_string;
use crate::runtime::u_string::UStr;
use crate::runtime::u_string::UString;


#[derive(Clone, Copy)]
pub struct CryptoTestSupport;

impl CryptoTestSupport {
    pub fn crypto_test_support_data(name: &UStr) -> Vec<u8> {
        if name == UString::from("empty") {
            return vec![0u8; 0usize];
        }
        if name == UString::from("abc") {
            return CryptoTestSupport::crypto_test_support_ascii(&vec![97, 98, 99]);
        }
        if name == UString::from("digits") {
            return CryptoTestSupport::crypto_test_support_ascii(&vec![49, 50, 51, 52, 53, 54, 55, 56, 57]);
        }
        let mut length = 0u32;
        if name == UString::from("bytes0to255") {
            length = 256u32;
        } else {
            if name == UString::from("len1") {
                length = 1u32;
            } else {
                if name == UString::from("len16") {
                    length = 16u32;
                } else {
                    if name == UString::from("len17") {
                        length = 17u32;
                    } else {
                        if name == UString::from("len63") {
                            length = 63u32;
                        } else {
                            if name == UString::from("len64") {
                                length = 64u32;
                            } else {
                                if name == UString::from("len65") {
                                    length = 65u32;
                                } else {
                                    if name == UString::from("len127") {
                                        length = 127u32;
                                    } else {
                                        if name == UString::from("len128") {
                                            length = 128u32;
                                        } else {
                                            if name == UString::from("len129") {
                                                length = 129u32;
                                            } else {
                                                if name == UString::from("len239") {
                                                    length = 239u32;
                                                } else {
                                                    if name == UString::from("len240") {
                                                        length = 240u32;
                                                    } else {
                                                        if name == UString::from("len241") {
                                                            length = 241u32;
                                                        } else {
                                                            if name == UString::from("len1003") {
                                                                length = 1003u32;
                                                            } else {
                                                                if name == UString::from("len1004") {
                                                                    length = 1004u32;
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        let mut bytes = vec![0u8; usize::try_from(length).unwrap_or(0)];
        for i in 0..length {
            bytes[usize::try_from(i).unwrap_or(0)] = u8::try_from((if name == UString::from("bytes0to255") { u32::from(i.to_be_bytes()[3]) } else { u32::from(u32::wrapping_add(u32::wrapping_mul(i, 31), 7).to_be_bytes()[3]) }) & 0xFF).unwrap_or(0);
        }
        return bytes;
    }

    pub(crate) fn crypto_test_support_ascii(values: &Vec<u32>) -> Vec<u8> {
        let mut bytes = vec![0u8; usize::try_from(u32::try_from((values.len()) & 0xFFFF_FFFF).unwrap_or(0)).unwrap_or(0)];
        for i in 0..match u32::try_from(values.len()) { Ok(value) => value, Err(_) => u32::MAX } {
            bytes[usize::try_from(i).unwrap_or(0)] = u8::try_from((values[usize::try_from(i).unwrap_or(0)]) & 0xFF).unwrap_or(0);
        }
        return bytes;
    }

    pub fn crypto_test_support_signed32(raw: f64) -> u32 {
        return if raw >= 2147483648.0f64 { u32::from_ne_bytes(((match f64::from(raw - 4294967296.0f64) { v if v.is_nan() => 0i32, v if v >= 2147483648.0 => 2147483647i32, v if v < -2147483648.0 => -2147483648i32, v if v < 0.0 => i32::from_ne_bytes(u32::wrapping_sub(0, match ((0.0 - v).to_bits() >> 52) & 2047 { e if e < 1023 => 0u32, e => u32::try_from((((0.0 - v).to_bits() & 4503599627370495) | 4503599627370496) >> (52 - (e - 1023))).unwrap_or(0) }).to_ne_bytes()), v => i32::from_ne_bytes(match ((v).to_bits() >> 52) & 2047 { e if e < 1023 => 0u32, e => u32::try_from((((v).to_bits() & 4503599627370495) | 4503599627370496) >> (52 - (e - 1023))).unwrap_or(0) }.to_ne_bytes()) }) as u32).to_ne_bytes()) } else { u32::from_ne_bytes(((match f64::from(raw) { v if v.is_nan() => 0i32, v if v >= 2147483648.0 => 2147483647i32, v if v < -2147483648.0 => -2147483648i32, v if v < 0.0 => i32::from_ne_bytes(u32::wrapping_sub(0, match ((0.0 - v).to_bits() >> 52) & 2047 { e if e < 1023 => 0u32, e => u32::try_from((((0.0 - v).to_bits() & 4503599627370495) | 4503599627370496) >> (52 - (e - 1023))).unwrap_or(0) }).to_ne_bytes()), v => i32::from_ne_bytes(match ((v).to_bits() >> 52) & 2047 { e if e < 1023 => 0u32, e => u32::try_from((((v).to_bits() & 4503599627370495) | 4503599627370496) >> (52 - (e - 1023))).unwrap_or(0) }.to_ne_bytes()) }) as u32).to_ne_bytes()) };
    }

    pub fn crypto_test_support_i64_hex(value: i64) -> UString {
        return UString::from(format!("{}", { let mut __s = UString::new(); __s += CryptoTestSupport::crypto_test_support_word_hex(u32::try_from((value >> 32) & 0xFFFF_FFFF).unwrap_or(0)).as_ustr(); __s += CryptoTestSupport::crypto_test_support_word_hex(u32::try_from((value) & 0xFFFF_FFFF).unwrap_or(0)).as_ustr(); __s }).as_str());
    }

    pub(crate) fn crypto_test_support_word_hex(value: u32) -> UString {
        let mut s = UString::from(format!("{}", format!("{:X}", value)).as_str());
        while (i32::from_ne_bytes(((u_string::unit_count(&(s))) as i32).to_ne_bytes())) < (8) {
            s = UString::from(format!("{}", { let mut __s = UString::new(); __s += &(UString::from("0")); __s += s.as_ustr(); __s }).as_str());
        }
        return s.to_lowercase();
    }
}
