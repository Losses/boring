#![cfg(test)]

use crate::boring::float_mod_compare_ops::FloatModCompareOps;
use crate::runtime::test as testlib;
use crate::runtime::test_core;
use crate::runtime::u_string::UStr;


#[test]
fn even() {
    testlib::run("tests.FloatModCompareOpsTests.even", "tests.FloatModCompareOpsTests.even: a Float remainder compares zero in the Float domain", || {
        test_core::TestCore::test_core_equals_bool(true, FloatModCompareOps::float_mod_compare_ops_even(4.0f64), UStr::new(&[]));
        test_core::TestCore::test_core_equals_bool(false, FloatModCompareOps::float_mod_compare_ops_even(3.0f64), UStr::new(&[]));
    });
}
