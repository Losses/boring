#!/usr/bin/env bash
# Two-sided discriminating-power proof for the no-trailing-LF append control.
# Reproduction script. Scratch only; does NOT modify any frozen artifact.
# Never pipes a command whose exit code is measured.
set -u
R=/home/losses/Development/tq-workspace/boring-wt-architecture/out/integration-a3-evidence/exclusive-runner
ROOT=/home/losses/Development/tq-workspace/boring-wt-architecture
W=/home/losses/Development/tq-workspace/dc-warn/out/selftest-nolf/work
EV=/home/losses/Development/tq-workspace/dc-warn/out/selftest-nolf/evidence
OLD=/home/losses/Development/tq-workspace/dc-warn/out/integrity-bytefix/backup/check-log-integrity.sh.orig
NEW="$R/check-log-integrity.sh"

rm -rf "$W/proof"
mkdir -p "$W/proof"

# 1. Produce a fresh, normally sealed attempt with the frozen harness.
bash "$R/run-exclusive.sh" "$ROOT" "$R/plan-a.txt" >/dev/null 2>&1
HARNESS_RC=$?
L=$(cat "$R/.latest-run")

# 2. Untampered baseline: both checkers must say OK (proves neither is broken).
cp -a "$L" "$W/proof/clean"
CLEAN_BYTES=$(wc -c <"$W/proof/clean/harness.log")
CLEAN_LINES=$(wc -l <"$W/proof/clean/harness.log")
bash "$NEW" "$W/proof/clean" >"$EV/primary-00-clean-new.log" 2>&1
CLEAN_NEW_RC=$?
bash "$OLD" "$W/proof/clean" >"$EV/primary-01-clean-old.log" 2>&1
CLEAN_OLD_RC=$?

# 3. THE CONTROL, no trailing LF: identical bytes fed to both checkers.
cp -a "$L" "$W/proof/noLF"
printf 'abcdef' >>"$W/proof/noLF/harness.log"
NOLF_BYTES=$(wc -c <"$W/proof/noLF/harness.log")
NOLF_LINES=$(wc -l <"$W/proof/noLF/harness.log")
NOLF_SHA_BEFORE=$(sha256sum "$W/proof/noLF/harness.log" | cut -d' ' -f1)
MARKER_OFF=$(grep -abo '^harness end marker sha256=' "$W/proof/noLF/harness.log" | tail -1 | cut -d: -f1)
MARKER_LINE_BYTES=$(tail -c "+$((MARKER_OFF + 1))" "$W/proof/noLF/harness.log" | head -n 1 | wc -c | tr -d '[:space:]')
MARKER_END=$((MARKER_OFF + MARKER_LINE_BYTES))
bash "$NEW" "$W/proof/noLF" >"$EV/primary-02-noLF-new.log" 2>&1
NOLF_NEW_RC=$?
NOLF_SHA_MID=$(sha256sum "$W/proof/noLF/harness.log" | cut -d' ' -f1)
bash "$OLD" "$W/proof/noLF" >"$EV/primary-03-noLF-old.log" 2>&1
NOLF_OLD_RC=$?
NOLF_SHA_AFTER=$(sha256sum "$W/proof/noLF/harness.log" | cut -d' ' -f1)

# 4. Attribution: the SAME 6 bytes plus a LF. Only the LF differs.
cp -a "$L" "$W/proof/withLF"
printf 'abcdef\n' >>"$W/proof/withLF/harness.log"
WITLF_BYTES=$(wc -c <"$W/proof/withLF/harness.log")
WITLF_LINES=$(wc -l <"$W/proof/withLF/harness.log")
bash "$NEW" "$W/proof/withLF" >"$EV/primary-04-withLF-new.log" 2>&1
WITLF_NEW_RC=$?
bash "$OLD" "$W/proof/withLF" >"$EV/primary-05-withLF-old.log" 2>&1
WITLF_OLD_RC=$?

# 5. Geometry of the no-LF tamper, written as its own raw evidence block.
{
    echo "source attempt          : $L"
    echo "run-exclusive.sh rc     : $HARNESS_RC"
    echo "no-LF harness.log bytes : $NOLF_BYTES"
    echo "no-LF harness.log lines : $NOLF_LINES   (unchanged by the append: no LF added)"
    echo "marker line byte offset : $MARKER_OFF"
    echo "marker line bytes       : $MARKER_LINE_BYTES  (includes the marker's own LF)"
    echo "marker end byte offset  : $MARKER_END"
    echo "bytes past marker end   : $((NOLF_BYTES - MARKER_END))   (the 6 appended bytes)"
    echo "last 8 bytes (od -c)    :"
    tail -c 8 "$W/proof/noLF/harness.log" | od -c
    echo "harness.log sha256 before any checker run : $NOLF_SHA_BEFORE"
    echo "harness.log sha256 after  NEW checker run : $NOLF_SHA_MID"
    echo "harness.log sha256 after  OLD checker run : $NOLF_SHA_AFTER"
    echo "checkers are read-only on the input (all three hashes equal): $([ "$NOLF_SHA_BEFORE" = "$NOLF_SHA_MID" ] && [ "$NOLF_SHA_MID" = "$NOLF_SHA_AFTER" ] && echo yes || echo NO)"
    echo
    echo "clean       : NEW rc=$CLEAN_NEW_RC  OLD rc=$CLEAN_OLD_RC"
    echo "no-LF 6B    : NEW rc=$NOLF_NEW_RC  OLD rc=$NOLF_OLD_RC   <-- the control: NEW detects, OLD misses"
    echo "6B + LF     : NEW rc=$WITLF_NEW_RC  OLD rc=$WITLF_OLD_RC   <-- identical payload, only the LF differs"
    echo
    echo "clean   bytes=$CLEAN_BYTES lines=$CLEAN_LINES   (the sealed attempt before tampering)"
    echo "no-LF   bytes=$NOLF_BYTES lines=$NOLF_LINES   delta: +$((NOLF_BYTES - CLEAN_BYTES)) byte(s), $((NOLF_LINES - CLEAN_LINES)) line(s)"
    echo "6B+LF   bytes=$WITLF_BYTES lines=$WITLF_LINES   delta: +$((WITLF_BYTES - CLEAN_BYTES)) byte(s), +$((WITLF_LINES - CLEAN_LINES)) line(s)  <- the LF is what adds the line and lets OLD catch it"
} >"$EV/primary-06-geometry.txt" 2>&1

cat "$EV/primary-06-geometry.txt"
