#[derive(Clone, Copy)]
pub struct ArrayIterationOps;

impl ArrayIterationOps {
    pub fn array_iteration_ops_sum_values(values: &Vec<u32>) -> u32 {
        let mut total = 0u32;
        for &item in values {
            total = u32::wrapping_add(total, item);
        }
        return total;
    }

    pub fn array_iteration_ops_count_read_only(values: &[u32]) -> u32 {
        let mut total = 0u32;
        for &item in values {
            total = u32::wrapping_add(total, item);
        }
        return total;
    }

    pub fn array_iteration_ops_sum_field(holder: Holder) -> u32 {
        let mut total = 0u32;
        {
            let _g1 = holder.values.clone();
            for &item in &_g1 {
                total = u32::wrapping_add(total, item);
            }
        }
        return total;
    }
}

#[derive(Clone, PartialEq)]
pub struct Holder {
    pub values: Vec<u32>,
}

impl Holder {
    pub fn new(values: Vec<u32>) -> Self {
        Self {
            values,
        }
    }
}
