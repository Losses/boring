package boring

class KnullInitNarrowing {
    fun fieldOffNullableReceiver(nested: Nested?): Int {
        val bound = nested
        return bound!!.value!!
    }

    fun ternaryWithNullableArm(flag: Boolean, fallback: Nested?): Int {
        val bound = (if ((flag)) Nested(1) else fallback)
        return bound!!.value!!
    }

    fun chainedFieldAccess(nested: Nested?): String {
        val bound = nested
        return bound!!.name!!
    }
}

class Nested(val value: Int) {
    val name: String
    init {
    this.name = "v" + value
    }
}
