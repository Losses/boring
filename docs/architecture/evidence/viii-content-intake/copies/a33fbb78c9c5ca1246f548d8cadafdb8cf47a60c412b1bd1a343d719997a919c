#![cfg(test)]

use crate::boring::value_type_consumer::ValueTypeConsumer;
use crate::runtime::test as testlib;
use crate::runtime::test_core;
use crate::runtime::u_string::UStr;


#[test]
fn test_arithmetic() {
    testlib::run("tests.ValueTypeTests.testArithmetic", "tests.ValueTypeTests.testArithmetic: value wrapper arithmetic and member call", || {
        test_core::TestCore::test_core_equals_float(6.0f32, ValueTypeConsumer::value_type_consumer_arithmetic(), UStr::new(&[]));
    });
}

#[test]
fn test_equality() {
    testlib::run("tests.ValueTypeTests.testEquality", "tests.ValueTypeTests.testEquality: equal wrapper representations compare equal", || {
        test_core::TestCore::test_core_equals_bool(true, ValueTypeConsumer::value_type_consumer_equal_representations(), UStr::new(&[]));
    });
}

#[test]
fn test_static_field() {
    testlib::run("tests.ValueTypeTests.testStaticField", "tests.ValueTypeTests.testStaticField: value wrapper static field is preserved", || {
        test_core::TestCore::test_core_equals_float(0.0f32, ValueTypeConsumer::value_type_consumer_static_value(), UStr::new(&[]));
    });
}

#[test]
fn test_blank_rejected() {
    testlib::run("tests.ValueTypeTests.testBlankRejected", "tests.ValueTypeTests.testBlankRejected: validating wrapper rejects blank construction", || {
        test_core::TestCore::test_core_equals_bool(true, ValueTypeConsumer::value_type_consumer_blank_rejected(), UStr::new(&[]));
    });
}

#[test]
fn test_optional_ic() {
    testlib::run("tests.ValueTypeTests.testOptionalIc", "tests.ValueTypeTests.testOptionalIc: nullable value wrapper field preserves its presence", || {
        test_core::TestCore::test_core_equals_float(2.0f32, ValueTypeConsumer::value_type_consumer_optional_ic_present(), UStr::new(&[]));
    });
}

#[test]
fn test_rendered_string() {
    testlib::run("tests.ValueTypeTests.testRenderedString", "tests.ValueTypeTests.testRenderedString: declared wrapper toString returns its representation", || {
        test_core::TestCore::test_core_equals_string(UStr::new(&[102,97,99,101]), ValueTypeConsumer::value_type_consumer_rendered_id().as_ustr(), UStr::new(&[]));
    });
}
