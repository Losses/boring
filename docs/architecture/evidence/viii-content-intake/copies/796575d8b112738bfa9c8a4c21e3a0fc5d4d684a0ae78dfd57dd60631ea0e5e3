package tests

import boring.DataClassCtorGuardOps
import boring.ValueException
import boring.runtime.test.Test

class DataClassCtorGuardTests {
@boring.test.Test
    fun acceptsValidValue() {
        Test.run("tests.DataClassCtorGuardTests.acceptsValidValue", "tests.DataClassCtorGuardTests.acceptsValidValue: data-class constructor accepts finite non-negative values") {
                val value = DataClassCtorGuardOps(2.5f)
                Test.equals(2.5f, value.magnitude, null)
        }
    }

@boring.test.Test
    fun rejectsNegativeValue() {
        Test.run("tests.DataClassCtorGuardTests.rejectsNegativeValue", "tests.DataClassCtorGuardTests.rejectsNegativeValue: data-class constructor rejects negative values") {
                var rejected = false
                try {
                    DataClassCtorGuardOps(-1.0f)
                } catch (i: ValueException) {
                    rejected = true
                }
                Test.equals(true, rejected, null)
        }
    }

@boring.test.Test
    fun rejectsNonFiniteValue() {
        Test.run("tests.DataClassCtorGuardTests.rejectsNonFiniteValue", "tests.DataClassCtorGuardTests.rejectsNonFiniteValue: data-class constructor rejects non-finite values") {
                var rejected = false
                try {
                    DataClassCtorGuardOps(Float.POSITIVE_INFINITY)
                } catch (i: ValueException) {
                    rejected = true
                }
                Test.equals(true, rejected, null)
        }
    }
}
