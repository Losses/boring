package boring

data class OptionalIcRecord(val indent: Ic?) {
}



object ValueTypeConsumer {
    fun arithmetic(): Double {
        val first = Ic(2.0)
        val total = first + Ic.ZERO
        return total.toPx(3.0)
    }

    fun equalRepresentations(): Boolean {
        return Ic(2.0) == Ic(2.0)
    }

    fun staticValue(): Double {
        return Ic.ZERO.toPx(5.0)
    }

    fun blankRejected(): Boolean {
        var rejected = false
        try {
            FontFaceId(" ")
        } catch (i: ValueException) {
            rejected = true
        }
        return rejected
    }

    fun optionalIcPresent(): Double {
        val record = OptionalIcRecord(Ic(2.0))
        val indent = record.indent
        if ((indent == null)) {
            return -1.0
        }
        return (if ((indent == null)) -1.0 else 2.0)
    }

    fun renderedId(): String {
        val id = FontFaceId("face")
        return id.toString()
    }
}
