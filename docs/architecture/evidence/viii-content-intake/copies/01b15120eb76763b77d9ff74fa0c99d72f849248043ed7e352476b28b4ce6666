#!/usr/bin/env bash
# Stage 2: NEW defeat attempts against the HARDENED guard.
set -u
. "$(dirname "$0")/xlib.sh"

root_del() { python3 - "$1" "$2" <<'PY'
import sys
p, mod = sys.argv[1], sys.argv[2]
lines = open(p, encoding="utf-8").read().split("\n")
open(p, "w", encoding="utf-8").write("\n".join(l for l in lines if l.strip() != mod))
PY
}
root_sub() { python3 - "$1" "$2" "$3" <<'PY'
import sys
p, old, new = sys.argv[1], sys.argv[2], sys.argv[3]
lines = open(p, encoding="utf-8").read().split("\n")
open(p, "w", encoding="utf-8").write("\n".join(new if l.strip() == old else l for l in lines))
PY
}
alw_add() { python3 - "$@" <<'PY'
import json, sys
p, section, target, mod, reason = sys.argv[1:6]
d = json.load(open(p, encoding="utf-8"))
d.setdefault(section, []).append({"target": target, "module": mod, "reason": reason})
json.dump(d, open(p, "w", encoding="utf-8"), indent=2)
PY
}
alw_only() { # replace the whole allowlist with one exempt entry
python3 - "$@" <<'PY'
import json, sys
p, target, mod, reason = sys.argv[1:5]
json.dump({"exempt": [{"target": target, "module": mod, "reason": reason}]},
          open(p, "w", encoding="utf-8"), indent=2)
PY
}
