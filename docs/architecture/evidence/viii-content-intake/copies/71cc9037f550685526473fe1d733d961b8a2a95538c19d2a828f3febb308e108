#![cfg(test)]

use crate::boring::node_fs_borrow_ops::NodeFsBorrowOps;
use crate::runtime::test as testlib;
use crate::runtime::test_core;
use crate::runtime::u_string::UStr;


#[test]
fn write_probe() {
    testlib::run("tests.NodeFsBorrowOpsTests.writeProbe", "tests.NodeFsBorrowOpsTests.writeProbe: a node:fs extern borrows its String arguments", || {
        let path = NodeFsBorrowOps::node_fs_borrow_ops_write_probe(UStr::new(&[112,114,111,98,101]), UStr::new(&[112,114,111,98,101]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[116,97,114,103,101,116,47,98,111,114,105,110,103,45,110,111,100,101,45,102,115,45,112,114,111,98,101]), path.as_ustr(), UStr::new(&[]));
    });
}
