package tests

import boring.StringUnitOps
import boring.runtime.UString
import boring.runtime.test.Test

class StringUnitTests {
@boring.test.Test
    fun unitSurface() {
        Test.run("tests.StringUnitTests.unitSurface", "tests.StringUnitTests.unitSurface: code-unit reads and splits follow the unit domain") {
                Test.equals(46, StringUnitOps.codeInRange("a.b"), null)
                Test.equals(26912, StringUnitOps.codeInRange("提椠"), null)
                Test.equals(98, StringUnitOps.codeAtEnd("ab"), null)
                Test.equals(true, StringUnitOps.codeOutOfRange("ab") == null, null)
                Test.equals(true, StringUnitOps.isSpaceAt("a b", 1), null)
                Test.equals(false, StringUnitOps.isSpaceAt("a b", 99), null)
                Test.equals(-1, StringUnitOps.codeAtOrFallback("ab", 99), null)
                Test.equals(97, StringUnitOps.codeAtOrFallback("abc", 0), null)
                Test.equals(3, StringUnitOps.splitCount("1.0.0"), null)
                Test.equals("1", StringUnitOps.splitFirst("1.0.0"), null)
                Test.equals(3, StringUnitOps.splitEmptyParts("a....b"), null)
                Test.equals(1, StringUnitOps.splitAbsent("abc"), null)
                Test.equals("abc", run { val _s = "abcdef"; val _from = -2; val _to = 3; val _start = if (_from < 0) 0 else if (_from > _s.length) _s.length else _from; val _end = if (_to < 0) 0 else if (_to > _s.length) _s.length else _to; if (_start > _end) _s.substring(_end, _start) else _s.substring(_start, _end) }, null)
                Test.equals("bcdef", run { val _s = "abcdef"; val _from = 1; val _to = 99; val _start = if (_from < 0) 0 else if (_from > _s.length) _s.length else _from; val _end = if (_to < 0) 0 else if (_to > _s.length) _s.length else _to; if (_start > _end) _s.substring(_end, _start) else _s.substring(_start, _end) }, null)
                Test.equals("bc", run { val _s = "abcdef"; val _from = 3; val _to = 1; val _start = if (_from < 0) 0 else if (_from > _s.length) _s.length else _from; val _end = if (_to < 0) 0 else if (_to > _s.length) _s.length else _to; if (_start > _end) _s.substring(_end, _start) else _s.substring(_start, _end) }, null)
                Test.equals("cdef", run { val _s = "abcdef"; val _from = 2; val _start = if (_from < 0) 0 else if (_from > _s.length) _s.length else _from; _s.substring(_start) }, null)
        }
    }

@boring.test.Test
    fun charCodeAtUnitDomain() {
        Test.run("tests.StringUnitTests.charCodeAtUnitDomain", "tests.StringUnitTests.charCodeAtUnitDomain: charCodeAt addresses UTF-16 code units") {
                Test.equals(97, StringUnitOps.codeAt("ab", 0), null)
                Test.equals(98, StringUnitOps.codeAt("ab", 1), null)
                Test.equals(true, StringUnitOps.codeAt("ab", 2) == null, null)
                val text = "a" + UString.fromCodePoint(128512) + "b"
                Test.equals(97, StringUnitOps.codeAt(text, 0), null)
                Test.equals(55357, StringUnitOps.codeAt(text, 1), null)
                Test.equals(56832, StringUnitOps.codeAt(text, 2), null)
                Test.equals(98, StringUnitOps.codeAt(text, 3), null)
                Test.equals(true, StringUnitOps.codeAt(text, 4) == null, null)
        }
    }

@boring.test.Test
    fun substrUnitDomain() {
        Test.run("tests.StringUnitTests.substrUnitDomain", "tests.StringUnitTests.substrUnitDomain: substr counts UTF-16 code units") {
                val astral = UString.fromCodePoint(128512)
                val text = "a" + astral + "b"
                Test.equals("a", StringUnitOps.unitCut(text, 0, 1), null)
                Test.equals(astral, StringUnitOps.unitCut(text, 1, 2), null)
                Test.equals("b", StringUnitOps.unitCut(text, 3, 1), null)
                Test.equals("", StringUnitOps.unitCut(text, 4, 1), null)
                Test.equals(astral + "b", StringUnitOps.unitCutFrom(text, 1), null)
                Test.equals("b", StringUnitOps.unitCut(text, -1, 1), null)
        }
    }

@boring.test.Test
    fun splitEmptyDelimiter() {
        Test.run("tests.StringUnitTests.splitEmptyDelimiter", "tests.StringUnitTests.splitEmptyDelimiter: empty delimiter splits one part per code unit") {
                val letters = StringUnitOps.splitUnits("abc")
                Test.equals(3, letters.size, null)
                Test.equals("a", letters[0], null)
                Test.equals("b", letters[1], null)
                Test.equals("c", letters[2], null)
                Test.equals(3, StringUnitOps.splitUnitCount("abc"), null)
                Test.equals("a", StringUnitOps.splitUnitAt("abc", 0), null)
                Test.equals(97, StringUnitOps.splitUnitCode("abc", 0), null)
                Test.equals(1, StringUnitOps.splitUnits("5").size, null)
                Test.equals("5", StringUnitOps.splitUnits("5")[0], null)
                Test.equals(1, StringUnitOps.splitUnitCount("5"), null)
                Test.equals("5", StringUnitOps.splitUnitAt("5", 0), null)
        }
    }

@boring.test.Test
    fun splitEmptyDelimiterSurrogates() {
        Test.run("tests.StringUnitTests.splitEmptyDelimiterSurrogates", "tests.StringUnitTests.splitEmptyDelimiterSurrogates: empty delimiter keeps a surrogate pair as two units") {
                val astral = UString.fromCodePoint(128512)
                val text = "a" + astral + "b"
                Test.equals(4, text.length, null)
                val units = StringUnitOps.splitUnits(text)
                Test.equals(4, units.size, null)
                Test.equals("a", units[0], null)
                Test.equals("b", units[3], null)
                Test.equals(55357, StringUnitOps.splitUnitCode(text, 1), null)
                Test.equals(56832, StringUnitOps.splitUnitCode(text, 2), null)
        }
    }
}
