#![cfg(test)]

use crate::boring::signed_int_constructor_ops::SignedIntConstructorOps;
use crate::runtime::test as testlib;
use crate::runtime::test_core;
use crate::runtime::u_string::UStr;


#[test]
fn sum_index() {
    testlib::run("tests.SignedIntConstructorTests.sumIndex", "tests.SignedIntConstructorTests.sumIndex: a signed wrapping sum reinterprets into an owned u32 constructor slot", || {
        test_core::TestCore::test_core_equals_int(5i32, i32::from_ne_bytes(((SignedIntConstructorOps::signed_int_constructor_ops_sum_index(UStr::new(&[120,98,99]), 5)) as i32).to_ne_bytes()), UStr::new(&[]));
        test_core::TestCore::test_core_equals_int(4i32, i32::from_ne_bytes(((SignedIntConstructorOps::signed_int_constructor_ops_sum_index(UStr::new(&[97,98,99]), 5)) as i32).to_ne_bytes()), UStr::new(&[]));
    });
}

#[test]
fn negated_index() {
    testlib::run("tests.SignedIntConstructorTests.negatedIndex", "tests.SignedIntConstructorTests.negatedIndex: a negated signed index reinterprets into an owned u32 constructor slot", || {
        test_core::TestCore::test_core_equals_int(0i32, i32::from_ne_bytes(((SignedIntConstructorOps::signed_int_constructor_ops_negated_index(UStr::new(&[120,98,99]))) as i32).to_ne_bytes()), UStr::new(&[]));
        test_core::TestCore::test_core_equals_int(1i32, i32::from_ne_bytes(((SignedIntConstructorOps::signed_int_constructor_ops_negated_index(UStr::new(&[97,98,99]))) as i32).to_ne_bytes()), UStr::new(&[]));
    });
}
