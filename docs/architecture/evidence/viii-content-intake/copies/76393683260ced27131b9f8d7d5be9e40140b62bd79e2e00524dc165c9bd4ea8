package mx;

import std.ReadOnlyArray;
import mx.MXSupport.QChoice;
import mx.MXSupport.QSource;

/**
	P1: the lambda body is EXACTLY one `return <non-try, non-switch expr>`.
	    functionLiteralInner's single-return fast path renders expr(r) with no
	    boundary conversion and never reads currentReturnType.
	P2: the lambda body is EXACTLY one `return switch ...`: same fast path, but
	    expr(TSwitch) dispatches to switchExpression whose destination is sw.t.
**/
class MXFast {
	public static function pFastPlain(flag:Bool):Int {
		var f = function(flag:Bool):ReadOnlyArray<Int> {
			return QSource.first();
		}
		return QSource.view(f(flag));
	}

	public static function pFastSwitch(c:QChoice):Int {
		var f = function(c:QChoice):ReadOnlyArray<Int> {
			return switch (c) {
				case QOne: QSource.first();
				case QTwo: QSource.second();
			}
		}
		return QSource.view(f(c));
	}
}
