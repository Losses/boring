#[derive(Clone, Copy)]
pub struct FloatArrayAnnoOps;

impl FloatArrayAnnoOps {
    pub fn float_array_anno_ops_sum_of(values: &Vec<f64>) -> f64 {
        let mut total = 0.0f64;
        for &v in values {
            total += v;
        }
        return total;
    }

    pub fn float_array_anno_ops_verify() -> bool {
        let floats = vec![1.5f64, 2.0f64, 3.5f64];
        return FloatArrayAnnoOps::float_array_anno_ops_sum_of(&floats) == 7.0f64;
    }
}
