#[derive(Clone, Copy)]
pub struct Fp16;

impl Fp16 {
    pub fn fp16_f16_to_f32_bits(h16: u32) -> u32 {
        let sign = h16 >> 15 & 1;
        let exp5 = h16 >> 10 & 31;
        let mant10 = h16 & 1023;
        if exp5 == 0 {
            if mant10 == 0 {
                return (sign) << (31);
            }
            let mut mant = mant10;
            let mut shift = 0u32;
            while (mant & 1024) == 0 {
                mant <<= 1;
                shift = u32::wrapping_add(shift, 1);
            }
            return (sign) << (31) | (u32::wrapping_sub(113, shift)) << (23) | (mant & 1023) << (13);
        }
        if exp5 == 31 {
            if mant10 == 0 {
                return (sign) << (31) | 2139095040;
            }
            return (sign) << (31) | 2143289344 | (mant10 & 1023) << (13);
        }
        return (sign) << (31) | (u32::wrapping_add(exp5, 112)) << (23) | (mant10) << (13);
    }

    pub fn fp16_f32_to_f16_bits(b32: u32) -> u32 {
        let sign = b32 >> 31;
        let exp8 = b32 >> 23 & 255;
        let mant23 = b32 & 8388607;
        if exp8 == 255 {
            if mant23 == 0 {
                return (sign) << (15) | 31744;
            }
            return (sign) << (15) | 32256 | mant23 >> 13;
        }
        if exp8 == 0 {
            return (sign) << (15);
        }
        if i32::from_ne_bytes(((exp8) as i32).to_ne_bytes()) >= 143 {
            return (sign) << (15) | 31744;
        }
        if i32::from_ne_bytes(((exp8) as i32).to_ne_bytes()) >= 113 {
            let mut exp5 = u32::wrapping_sub(exp8, 112);
            let mut sig11 = Fp16::fp16_round_shift(mant23 | 8388608, 13);
            if sig11 == 2048 {
                exp5 = u32::wrapping_add(exp5, 1);
                if i32::from_ne_bytes(((exp5) as i32).to_ne_bytes()) >= 31 {
                    return (sign) << (15) | 31744;
                }
                sig11 = 1024u32;
            }
            return (sign) << (15) | (exp5) << (10) | sig11 & 1023;
        }
        let shift = u32::wrapping_sub(126, exp8);
        if i32::from_ne_bytes(((shift) as i32).to_ne_bytes()) > (24) {
            return (sign) << (15);
        }
        let h = Fp16::fp16_round_shift(mant23 | 8388608, shift);
        if h == 1024 {
            return (sign) << (15) | 1024;
        }
        return (sign) << (15) | h;
    }

    pub(crate) fn fp16_round_shift(value: u32, shift: u32) -> u32 {
        let base = value >> shift;
        let rest = value & u32::wrapping_sub((1) << (shift), 1);
        let half = 1 << (u32::wrapping_sub(shift, 1));
        if i32::from_ne_bytes(((rest) as i32).to_ne_bytes()) > (i32::from_ne_bytes(((half) as i32).to_ne_bytes())) || rest == half && (base & 1) == 1 {
            return u32::wrapping_add(base, 1);
        }
        return base;
    }
}
