package boring

object StringConvOps {
    fun hexZero(): String {
        return (0).toUInt().toString(16).uppercase()
    }

    fun hexTen(): String {
        return (10).toUInt().toString(16).uppercase()
    }

    fun hexByte(): String {
        return (255).toUInt().toString(16).uppercase()
    }

    fun hexCjk(): String {
        return (40959).toUInt().toString(16).uppercase()
    }

    fun hexDigitsZero(): String {
        return (10).toUInt().toString(16).uppercase().padStart(0, '0')
    }

    fun hexPadded(): String {
        return (10).toUInt().toString(16).uppercase().padStart(4, '0')
    }

    fun hexWiderThanDigits(): String {
        return (40959).toUInt().toString(16).uppercase().padStart(2, '0')
    }

    fun hexDynamic(value: Int, digits: Int): String {
        return (value).toUInt().toString(16).uppercase().padStart(digits, '0')
    }

    fun hexLowercase(): String {
        return "U+" + (40959).toUInt().toString(16).uppercase().padStart(0, '0').lowercase()
    }

    fun lowerAscii(): String {
        return "TiQian".lowercase()
    }

    fun upperAscii(): String {
        return "tiqian".uppercase()
    }

    fun lowerLanguageTag(): String {
        return "ZH-CN".lowercase()
    }

    fun upperLanguageTag(): String {
        return "zh-cn".uppercase()
    }

    fun lowerCjk(): String {
        return "提椠排版".lowercase()
    }

    fun upperCjk(): String {
        return "提椠排版".uppercase()
    }

    fun lowerDynamic(value: String): String {
        return value.lowercase()
    }

    fun upperDynamic(value: String): String {
        return value.uppercase()
    }
}
