    pub fn sorted_data_class_keys_ops_nullable_mutation() -> UString {
        let null_key = RubySpan::new(TextRange::new(1u32, 2u32), &(UStr::new(&[120])), vec![UString::from("serif").to_ustring()], RubyKind::Other, vec![RubyKind::Other], vec![(TextRange::new(1u32, 2u32)).clone()], if RubyKind::Other == RubyKind::Bopomofo { Some(UString::from("zh-TW")) } else { None });
