#[derive(Debug, Clone, PartialEq)]
pub struct TextRange {
    pub start: u32,
    pub end: u32,
}

impl TextRange {
    pub fn new(start: u32, end: u32) -> Self {
        Self {
            start,
            end,
        }
    }

    pub fn get_is_empty(&self) -> bool {
        return self.start == self.end;
    }

    pub fn to_string(&self) -> UString {
        return UString::from(format!("{}", { let mut __s = UString::new(); __s += &(UString::from("TextRange(")); __s += &(UString::from("start=")); __s += &(UString::from((self.start).to_string().as_str())); __s += &(UString::from(", ")); __s += &(UString::from("end=")); __s += &(UString::from((self.end).to_string().as_str())); __s += &(UString::from(")")); __s }).as_str());
    }
}

pub fn compare_text_range(a: &TextRange, b: &TextRange) -> i32 {
    let cmp_start = match i32::from_ne_bytes((*(&a.start)).to_ne_bytes()).cmp(&i32::from_ne_bytes((*(&b.start)).to_ne_bytes())) { core::cmp::Ordering::Less => -1, core::cmp::Ordering::Equal => 0, core::cmp::Ordering::Greater => 1 };
    if cmp_start != 0 { return cmp_start; }
    let cmp_end = match i32::from_ne_bytes((*(&a.end)).to_ne_bytes()).cmp(&i32::from_ne_bytes((*(&b.end)).to_ne_bytes())) { core::cmp::Ordering::Less => -1, core::cmp::Ordering::Equal => 0, core::cmp::Ordering::Greater => 1 };
    if cmp_end != 0 { return cmp_end; }
    0
}

#[derive(Debug, Clone, PartialEq)]
pub struct RubySpan {
    pub base_range: TextRange,
    pub text: UString,
    pub font_families: Vec<UString>,
    pub kind: RubyKind,
    pub enum_kinds: Vec<RubyKind>,
    pub ranges: Vec<TextRange>,
    pub locale: Option<UString>,
}

impl RubySpan {
    pub fn new(base_range: TextRange, text: &UStr, font_families: Vec<UString>, kind: RubyKind, enum_kinds: Vec<RubyKind>, ranges: Vec<TextRange>, locale: Option<UString>) -> Self {
        let locale = locale.or_else(|| if kind == RubyKind::Bopomofo { Some(UString::from("zh-TW")) } else { None });
        Self {
            base_range,
            text: text.to_ustring(),
            font_families,
            kind,
            enum_kinds,
            ranges,
            locale: locale,
        }
    }

    pub fn to_string(&self) -> UString {
        return UString::from(format!("{}", { let mut __s = UString::new(); __s += &(UString::from("RubySpan(")); __s += &(UString::from("baseRange=")); __s += UString::from(format!("{}", (self.base_range).clone().to_string()).as_str()).as_ustr(); __s += &(UString::from(", ")); __s += &(UString::from("text=")); __s += (self.text).to_ustring().as_ustr(); __s += &(UString::from(", ")); __s += &(UString::from("fontFamilies=")); __s += UString::from(format!("{}", {
        let mut out = String::new();
        out.push('[');
        let n = (self.font_families).clone().len();
        let mut i = 0usize;
        while i < n {
            if i > 0 { out.push_str(", "); }
            let _ = write!(out, "{}", (self.font_families).clone()[i]);
            i += 1;
        }
        out.push(']');
        out
    }).as_str()).as_ustr(); __s += &(UString::from(", ")); __s += &(UString::from("kind=")); __s += UString::from(self.kind.name()).as_ustr(); __s += &(UString::from(", ")); __s += &(UString::from("enumKinds=")); __s += UString::from(format!("{}", {
        let mut out = String::new();
        out.push('[');
        let n = (self.enum_kinds).clone().len();
        let mut i = 0usize;
        while i < n {
            if i > 0 { out.push_str(", "); }
            let _ = write!(out, "{}", (self.enum_kinds).clone()[i].name());
            i += 1;
        }
        out.push(']');
        out
    }).as_str()).as_ustr(); __s += &(UString::from(", ")); __s += &(UString::from("ranges=")); __s += UString::from(format!("{}", {
        let mut out = String::new();
        out.push('[');
        let n = (self.ranges).clone().len();
        let mut i = 0usize;
        while i < n {
            if i > 0 { out.push_str(", "); }
            let _ = write!(out, "{}", (self.ranges).clone()[i].to_string());
            i += 1;
        }
        out.push(']');
        out
    }).as_str()).as_ustr(); __s += &(UString::from(", ")); __s += &(UString::from("locale=")); __s += match &((self.locale).clone()) { Some(v) => v.as_ustr(), None => UStr::new(&[]) }; __s += &(UString::from(")")); __s }).as_str());
    }
}

fn ruby_span_order_0(v: &RubyKind) -> i32 {
    match v {
        RubyKind::Bopomofo => 0,
        RubyKind::Other => 1,
    }
}

fn ruby_span_order_1(v: &RubyKind) -> i32 {
    match v {
        RubyKind::Bopomofo => 0,
        RubyKind::Other => 1,
    }
}

pub fn compare_ruby_span(a: &RubySpan, b: &RubySpan) -> i32 {
    let cmp_base_range = compare_text_range(&a.base_range, &b.base_range);
    if cmp_base_range != 0 { return cmp_base_range; }
    let cmp_text = SortedTable::sorted_table_compare_strings((&a.text).as_ustr(), (&b.text).as_ustr());
    if cmp_text != 0 { return cmp_text; }
    let cmp_font_families = { let mut cmp = 0; for (av, bv) in (&a.font_families).iter().zip((&b.font_families).iter()) { cmp = SortedTable::sorted_table_compare_strings((av).as_ustr(), (bv).as_ustr()); if cmp != 0 { break; } } if cmp == 0 { cmp = match (&a.font_families).len().cmp(&(&b.font_families).len()) { core::cmp::Ordering::Less => -1, core::cmp::Ordering::Equal => 0, core::cmp::Ordering::Greater => 1 }; } cmp };
    if cmp_font_families != 0 { return cmp_font_families; }
    let cmp_kind = match ruby_span_order_0(&a.kind).cmp(&ruby_span_order_0(&b.kind)) { core::cmp::Ordering::Less => -1, core::cmp::Ordering::Equal => 0, core::cmp::Ordering::Greater => 1 };
    if cmp_kind != 0 { return cmp_kind; }
    let cmp_enum_kinds = { let mut cmp = 0; for (av, bv) in (&a.enum_kinds).iter().zip((&b.enum_kinds).iter()) { cmp = match ruby_span_order_1(av).cmp(&ruby_span_order_1(bv)) { core::cmp::Ordering::Less => -1, core::cmp::Ordering::Equal => 0,
core::cmp::Ordering::Greater => 1 }; if cmp != 0 { break; } } if cmp == 0 { cmp = match (&a.enum_kinds).len().cmp(&(&b.enum_kinds).len()) { core::cmp::Ordering::Less => -1, core::cmp::Ordering::Equal => 0, core::cmp::Ordering::Greater => 1 }; } cmp };
    if cmp_enum_kinds != 0 { return cmp_enum_kinds; }
    let cmp_ranges = { let mut cmp = 0; for (av, bv) in (&a.ranges).iter().zip((&b.ranges).iter()) { cmp = compare_text_range(av, bv); if cmp != 0 { break; } } if cmp == 0 { cmp = match (&a.ranges).len().cmp(&(&b.ranges).len()) { core::cmp::Ordering::Less => -1,
core::cmp::Ordering::Equal => 0, core::cmp::Ordering::Greater => 1 }; } cmp };
    if cmp_ranges != 0 { return cmp_ranges; }
    let cmp_locale = match (&a.locale, &b.locale) { (None, None) => 0, (None, Some(_)) => -1, (Some(_), None) => 1, (Some(av), Some(bv)) => SortedTable::sorted_table_compare_strings((av).as_ustr(), (bv).as_ustr()) };
    if cmp_locale != 0 { return cmp_locale; }
    0
}

