#[derive(Debug, Clone, Copy, PartialEq)]
pub enum QuoteType {
    Open,
    Close,
}

pub fn compare_quote_type(a: &QuoteType, b: &QuoteType) -> i32 {
    if a == b { return 0; }
    fn rank(v: &QuoteType) -> i32 {
        match v {
            QuoteType::Open => 0,
            QuoteType::Close => 1,
        }
    }
    rank(a) - rank(b)
}

impl QuoteType {
    pub fn to_string(&self) -> String {
        match self {
            QuoteType::Open => "Open".to_string(),
            QuoteType::Close => "Close".to_string(),
        }
    }
}

impl QuoteType {
    pub fn name(&self) -> &'static str {
        match self {
            QuoteType::Open => "Open",
            QuoteType::Close => "Close",
        }
    }
}

