package boring

import std.UStringException

object TryOps {
    private fun throwingCodec(count: Int): Int {
        if ((count > 10)) {
            throw VectorException.CountOverflow
        }
        return count * 2
    }

    fun classifyFault(error: VectorException): Int {
        return when (error) {
            is VectorException.BadMagic -> 11
            is VectorException.CountOverflow -> 12
            is VectorException.UnexpectedEof -> 13
            is VectorException.TrailingBytes -> 24
        }
    }

    private fun classifyCode(fault: UStringException): Int {
        return when (fault) {
            is UStringException.InvalidCodePoint -> 30 + fault.code
            is UStringException.UnpairedSurrogate -> 40 + fault.unit
        }
    }

    fun caughtStatement(count: Int): Int {
        var total = 0
        try {
            total = total + TryOps.throwingCodec(count)
        } catch (error: VectorException) {
            total = total + TryOps.classifyFault(error)
        }
        return total
    }

    fun regionReturn(count: Int): Int {
        return try {
            TryOps.throwingCodec(count)
        } catch (error: VectorException) {
            TryOps.classifyFault(error)
        }
    }

    fun regionValue(count: Int): Int {
        val value = try {
            TryOps.throwingCodec(count)
        } catch (error: VectorException) {
            TryOps.classifyFault(error)
        }
        return value + 1
    }

    fun handlerReturn(count: Int): Int {
        var total = 0
        try {
            total = total + TryOps.throwingCodec(count)
        } catch (error: VectorException) {
            return TryOps.classifyFault(error)
        }
        return total
    }

    fun regionMessage(count: Int): String {
        val text = try {
            TryOps.throwingCodec(count)
            "no fault"
        } catch (error: VectorException) {
            error.message
        }
        return text
    }

    fun faultPayload(code: Int): Int {
        val value = try {
            throw UStringException.InvalidCodePoint(code)
            0
        } catch (error: UStringException) {
            TryOps.classifyCode(error)
        }
        return value
    }
}
