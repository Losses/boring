#!/usr/bin/env python3
"""Strip Haxe comments (block, nested block, line; string-literal aware) and compare
two revisions of a file at token level.  Independent check of the coordinator's claim
that Compiler.hx 07896d15.. -> 57ee4997.. is a comment-only change.

usage: deepen-compiler-comments.py <fileA> <fileB> [<authoritative-fix-source>]
"""
import sys, re

def strip(src):
    out = []
    i, n = 0, len(src)
    while i < n:
        c = src[i]
        if c == '/' and i + 1 < n and src[i+1] == '*':
            depth = 1; i += 2
            while i < n and depth:
                if src[i] == '/' and i + 1 < n and src[i+1] == '*':
                    depth += 1; i += 2
                elif src[i] == '*' and i + 1 < n and src[i+1] == '/':
                    depth -= 1; i += 2
                else:
                    i += 1
            out.append(' ')
            continue
        if c == '/' and i + 1 < n and src[i+1] == '/':
            while i < n and src[i] != '\n':
                i += 1
            out.append(' ')
            continue
        if c in '"\'':
            q = c
            out.append(c); i += 1
            while i < n:
                if src[i] == '\\' and i + 1 < n:
                    out.append(src[i:i+2]); i += 2; continue
                out.append(src[i])
                if src[i] == q:
                    i += 1; break
                i += 1
            continue
        out.append(c); i += 1
    return ''.join(out)

def statements(src):
    body = strip(src)
    body = re.sub(r'\s+', ' ', body)
    return [s.strip() for s in body.split(';') if s.strip()]

a_path, b_path = sys.argv[1], sys.argv[2]
a_src, b_src = open(a_path).read(), open(b_path).read()
print("A = %s" % a_path)
print("B = %s" % b_path)
print("bytes: A=%d B=%d" % (len(a_src), len(b_src)))
sa, sb = statements(a_src), statements(b_src)
print("statements after comment strip: A=%d B=%d" % (len(sa), len(sb)))
same = (sa == sb)
print("STATEMENT STREAMS IDENTICAL: %s" % same)
if not same:
    import difflib
    d = [l for l in difflib.unified_diff(sa, sb, lineterm='', n=0)]
    print("first 40 diff lines:")
    for l in d[:40]:
        print("  ", l)
if len(sys.argv) > 3:
    c_path = sys.argv[3]
    c_src = open(c_path).read()
    sc = statements(c_src)
    print()
    print("C (authoritative PIT-248 source) = %s" % c_path)
    print("statements: C=%d" % len(sc))
    print("A == C: %s   B == C: %s" % (sa == sc, sb == sc))
    if sa != sc:
        import difflib
        for l in list(difflib.unified_diff(sa, sc, lineterm='', n=0))[:20]:
            print("  A/C", l)
    if sb != sc:
        import difflib
        for l in list(difflib.unified_diff(sb, sc, lineterm='', n=0))[:20]:
            print("  B/C", l)
sys.exit(0 if same else 1)
