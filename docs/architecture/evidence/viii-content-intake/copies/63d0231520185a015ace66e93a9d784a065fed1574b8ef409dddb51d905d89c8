            output.add_byte(u8::try_from((u32::try_from((word) & 0xFFFF_FFFF).unwrap_or(0)) & 0xFF).unwrap_or(0));
        }
        return output.get_bytes();
    }

    pub fn sha512_make(data: &[u8]) -> Vec<u8> {
        let mut hash = Sha512::new();
        hash.update(&data);
        return hash.digest();
    }

    pub(crate) fn sha512_process_block(hash: &mut Vec<i64>, input: &[u8]) {
        let mut words: Vec<i64> = vec![];
        for _ in 0..80 {
            words.push(0i64);
        }
        for i in 0..16 {
            let offset = u32::wrapping_mul(i, 8);
            words[usize::try_from(i).unwrap_or(0)] = i64::from(u32::from_be_bytes([
