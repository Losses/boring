    pub(crate) fn sha512_add(a: i64, b: i64) -> i64 {
        return a.wrapping_add(b);
    }

    pub(crate) fn sha512_add4(a: i64, b: i64, c: i64, d: i64) -> i64 {
        return a.wrapping_add(b).wrapping_add(c).wrapping_add(d);
    }

    pub(crate) fn sha512_choose(x: i64, y: i64, z: i64) -> i64 {
        return x & y ^ !x & z;
    }

    pub(crate) fn sha512_majority(x: i64, y: i64, z: i64) -> i64 {
        return x & y ^ x & z ^ y & z;
    }

    pub(crate) fn sha512_rotate(x: i64, n: u32) -> i64 {
        return i64::from_ne_bytes(u64::from_ne_bytes((x).to_ne_bytes()).wrapping_shr(n).to_ne_bytes()) | x.wrapping_shl(u32::wrapping_sub(64, n));
    }

    pub(crate) fn sha512_sigma0(x: i64) -> i64 {
        return Sha512::sha512_rotate(x, 28) ^ Sha512::sha512_rotate(x, 34) ^ Sha512::sha512_rotate(x, 39);
    }

    pub(crate) fn sha512_sigma1(x: i64) -> i64 {
        return Sha512::sha512_rotate(x, 14) ^ Sha512::sha512_rotate(x, 18) ^ Sha512::sha512_rotate(x, 41);
    }

    pub(crate) fn sha512_gamma0(x: i64) -> i64 {
        return Sha512::sha512_rotate(x, 1) ^ Sha512::sha512_rotate(x, 8) ^ i64::from_ne_bytes(u64::from_ne_bytes((x).to_ne_bytes()).wrapping_shr(7u32).to_ne_bytes());
    }

    pub(crate) fn sha512_gamma1(x: i64) -> i64 {
        return Sha512::sha512_rotate(x, 19) ^ Sha512::sha512_rotate(x, 61) ^ i64::from_ne_bytes(u64::from_ne_bytes((x).to_ne_bytes()).wrapping_shr(6u32).to_ne_bytes());
    }
