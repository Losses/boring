pub struct Sha512 {
    pub(crate) state: Vec<i64>,
    pub(crate) block: Vec<u8>,
    pub(crate) block_pos: u32,
    pub(crate) total_length: i64,
}

impl Sha512 {
    pub fn new() -> Self {
        Self {
