            final_block[124usize] = u8::try_from((u32::try_from((i64::from_ne_bytes(u64::from_ne_bytes((bit_length).to_ne_bytes()).wrapping_shr(24u32).to_ne_bytes())) & 0xFFFF_FFFF).unwrap_or(0)) & 0xFF).unwrap_or(0);
