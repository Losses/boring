            final_block[126usize] = u8::try_from((u32::try_from((i64::from_ne_bytes(u64::from_ne_bytes((bit_length).to_ne_bytes()).wrapping_shr(8u32).to_ne_bytes())) & 0xFFFF_FFFF).unwrap_or(0)) & 0xFF).unwrap_or(0);
            final_block[127usize] = u8::try_from((u32::try_from((i64::from_ne_bytes(u64::from_ne_bytes((bit_length).to_ne_bytes()).wrapping_shr(0u32).to_ne_bytes())) & 0xFFFF_FFFF).unwrap_or(0)) & 0xFF).unwrap_or(0);
        }
        Sha512::sha512_process_block(&mut final_state, &final_block);
        let mut output = BytesBuffer::new();
        for i in 0..8 {
            let word = final_state[usize::try_from(i).unwrap_or(0)];
            output.add_byte(u8::try_from((u32::try_from((i64::from_ne_bytes(u64::from_ne_bytes((word).to_ne_bytes()).wrapping_shr(56u32).to_ne_bytes())) & 0xFFFF_FFFF).unwrap_or(0)) & 0xFF).unwrap_or(0));
            output.add_byte(u8::try_from((u32::try_from((i64::from_ne_bytes(u64::from_ne_bytes((word).to_ne_bytes()).wrapping_shr(48u32).to_ne_bytes())) & 0xFFFF_FFFF).unwrap_or(0)) & 0xFF).unwrap_or(0));
