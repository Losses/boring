#[test]
fn singleton_role() {
    testlib::run("tests.RecordInterfaceOpsTests.singletonRole", "tests.RecordInterfaceOpsTests.singletonRole: a singleton interface field prints its bare name", || {
        test_core::TestCore::test_core_equals_string(UStr::new(&[66,97,99,107,103,114,111,117,110,100]), (UString::from(format!("{}", { let __guard = crate::boring::record_interface_ops::BACKGROUND_INSTANCE.lock().unwrap_or_else(|e| e.into_inner()); __guard.clone() }.to_string()).as_str())).as_ustr(), UStr::new(&[]));
        let span = RecordInterfaceOps::record_interface_ops_singleton_span();
        test_core::TestCore::test_core_equals_string(UStr::new(&[82,105,99,104,84,101,120,116,83,112,97,110,40,114,111,108,101,61,66,97,99,107,103,114,111,117,110,100,44,32,110,111,116,101,61,110,117,108,108,41]), (UString::from(format!("{}", span.to_string()).as_str())).as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string((UString::from(format!("{}", { let mut __s = UString::new(); __s += &(UString::from("RichTextSpan(")); __s += &(UString::from("role=")); __s += UString::from(format!("{}", span.role.to_string()).as_str()).as_ustr(); __s += &(UString::from(", ")); __s += &(UString::from("note=")); __s += (match &(span.note) { None => UString::from("null"), Some(__option1) => UString::from(format!("{}", __option1.to_string()).as_str()) }).as_ustr(); __s += &(UString::from(")")); __s }).as_str())).as_ustr(), (UString::from(format!("{}", span.to_string()).as_str())).as_ustr(), UStr::new(&[]));
    });
}

