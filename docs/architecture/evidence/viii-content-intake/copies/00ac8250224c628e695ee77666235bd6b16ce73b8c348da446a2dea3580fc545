#[test]
fn data_class_equality() {
    testlib::run("tests.RecordInterfaceOpsTests.dataClassEquality", "tests.RecordInterfaceOpsTests.dataClassEquality: data class equality compares interface fields", || {
        let left = RecordInterfaceOps::record_interface_ops_singleton_span();
        let same = (left).clone();
        let different = RecordInterfaceOps::record_interface_ops_record_span();
        test_core::TestCore::test_core_equals_bool(true, (left).role.__haxe_type_name() == (same).role.__haxe_type_name() && match (&(left).note, &(same).note) { (Some(__left), Some(__right)) => __left.__haxe_type_name() == __right.__haxe_type_name(), (None, None) => true, _ => false }, UStr::new(&[]));
        test_core::TestCore::test_core_equals_bool(false, !((left).role.__haxe_type_name() == (same).role.__haxe_type_name() && match (&(left).note, &(same).note) { (Some(__left), Some(__right)) => __left.__haxe_type_name() == __right.__haxe_type_name(), (None, None) => true, _ => false }), UStr::new(&[]));
        test_core::TestCore::test_core_equals_bool(false, (left).role.__haxe_type_name() == (different).role.__haxe_type_name() && match (&(left).note, &(different).note) { (Some(__left), Some(__right)) => __left.__haxe_type_name() == __right.__haxe_type_name(), (None, None) => true, _ => false }, UStr::new(&[]));
        test_core::TestCore::test_core_equals_bool(true, !((left).role.__haxe_type_name() == (different).role.__haxe_type_name() && match (&(left).note, &(different).note) { (Some(__left), Some(__right)) => __left.__haxe_type_name() == __right.__haxe_type_name(), (None, None) => true, _ => false }), UStr::new(&[]));
    });
}
