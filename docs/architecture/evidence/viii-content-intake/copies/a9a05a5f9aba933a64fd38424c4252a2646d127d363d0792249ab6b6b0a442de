#![cfg(test)]

use crate::boring::float_width::FloatWidth;
use crate::boring::std_string_ops::StdStringOps;
use crate::runtime::test as testlib;
use crate::runtime::test_core;
use crate::runtime::u_string::UStr;
use crate::runtime::u_string::UString;
use crate::tests::test_helper::*;


#[test]
fn concatenated_scalars() {
    testlib::run("tests.StdStringTests.concatenatedScalars", "tests.StdStringTests.concatenatedScalars: Std.string converts scalar operands inside concatenation", || {
        test_core::TestCore::test_core_equals_string(UStr::new(&[115,116,114,105,110,103,61,116,101,120,116]), StdStringOps::std_string_ops_concat_string(UStr::new(&[116,101,120,116])).as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[105,110,116,61,52,50]), StdStringOps::std_string_ops_concat_int(42).as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[102,108,111,97,116,61,50,46,53]), StdStringOps::std_string_ops_concat_float(2.5f64).as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[98,111,111,108,61,116,114,117,101]), StdStringOps::std_string_ops_concat_bool(true).as_ustr(), UStr::new(&[]));
    });
}

#[test]
fn standalone_scalars() {
    testlib::run("tests.StdStringTests.standaloneScalars", "tests.StdStringTests.standaloneScalars: Std.string converts standalone scalar operands", || {
        test_core::TestCore::test_core_equals_string(UStr::new(&[116,101,120,116]), StdStringOps::std_string_ops_string_value(UStr::new(&[116,101,120,116])).as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[52,50]), StdStringOps::std_string_ops_int_value(42).as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[50,46,53]), StdStringOps::std_string_ops_float_value(2.5f64).as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[102,97,108,115,101]), StdStringOps::std_string_ops_bool_value(false).as_ustr(), UStr::new(&[]));
    });
}

#[test]
fn value_enumerations() {
    testlib::run("tests.StdStringTests.valueEnumerations", "tests.StdStringTests.valueEnumerations: Std.string converts value enumeration operands to constructor names", || {
        test_core::TestCore::test_core_equals_string(UStr::new(&[101,110,117,109,61,70,54,52]), StdStringOps::std_string_ops_concat_enum(FloatWidth::F64).as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[70,49,54]), StdStringOps::std_string_ops_enum_value(FloatWidth::F16).as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_bool(true, StdStringOps::std_string_ops_enum_matches_constructor(), UStr::new(&[]));
    });
}

#[test]
fn float_forms() {
    testlib::run("tests.StdStringTests.floatForms", "tests.StdStringTests.floatForms: Std.string uses the ECMAScript float spelling", || {
        let forms = vec![
    UString::from("2").to_ustring(),
    UString::from("0").to_ustring(),
    UString::from("0").to_ustring(),
    UString::from("2.5").to_ustring(),
    UString::from("-1.25").to_ustring(),
    UString::from("100000000000000000000").to_ustring(),
    UString::from("1e+21").to_ustring(),
    UString::from("0.000001").to_ustring(),
    UString::from("1e-7").to_ustring(),
];
        assert_equals_vec_ustring(&forms, &StdStringOps::std_string_ops_float_forms(), UStr::new(&[]));
    });
}

#[test]
fn arrays() {
    testlib::run("tests.StdStringTests.arrays", "tests.StdStringTests.arrays: Std.string renders arrays with ruled separators and element forms", || {
        test_core::TestCore::test_core_equals_string(UStr::new(&[91,49,44,32,50,44,32,51,93]), StdStringOps::std_string_ops_int_array().as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[91,97,108,112,104,97,44,32,98,101,116,97,93]), StdStringOps::std_string_ops_string_array().as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[91,49,46,53,44,32,50,46,50,53,93]), StdStringOps::std_string_ops_float_array().as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[91,116,114,117,101,44,32,102,97,108,115,101,93]), StdStringOps::std_string_ops_bool_array().as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[91,70,54,52,44,32,70,49,54,93]), StdStringOps::std_string_ops_enum_array().as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[91,93]), StdStringOps::std_string_ops_empty_array().as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[91,91,49,44,32,50,93,44,32,91,51,93,93]), StdStringOps::std_string_ops_nested_array().as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[91,97,108,112,104,97,44,32,98,101,116,97,93]), StdStringOps::std_string_ops_read_only_array().as_ustr(), UStr::new(&[]));
    });
}
