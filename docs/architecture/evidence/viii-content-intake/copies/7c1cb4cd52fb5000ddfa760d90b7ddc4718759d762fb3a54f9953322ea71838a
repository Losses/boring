#![cfg(test)]

use crate::boring::nullability_ops::NullabilityOps;
use crate::boring::nullable_receiver::NullableReceiver;
use crate::runtime::test as testlib;
use crate::runtime::test_core;
use crate::runtime::u_string::UStr;


#[test]
fn test_nullable_to_string() {
    testlib::run("tests.NullabilityTests.testNullableToString", "tests.NullabilityTests.testNullableToString: nullable toString in argument", || {
        test_core::TestCore::test_core_equals_string(UStr::new(&[112,114,101,115,101,110,116]), NullabilityOps::nullability_ops_nullable_to_string(Some(NullableReceiver::new())).as_ustr(), UStr::new(&[]));
    });
}

#[test]
fn test_nullable_to_string_with_param() {
    testlib::run("tests.NullabilityTests.testNullableToStringWithParam", "tests.NullabilityTests.testNullableToStringWithParam: nullable toString with suffix", || {
        test_core::TestCore::test_core_equals_string(UStr::new(&[112,114,101,115,101,110,116,33]), NullabilityOps::nullability_ops_nullable_to_string_with_param(Some(NullableReceiver::new()), UStr::new(&[33])).as_ustr(), UStr::new(&[]));
    });
}

#[test]
fn test_narrowed_float() {
    testlib::run("tests.NullabilityTests.testNarrowedFloat", "tests.NullabilityTests.testNarrowedFloat: a guarded nullable Float read widens after extraction", || {
        test_core::TestCore::test_core_equals_bool(true, true, UStr::new(&[]));
    });
}

#[test]
fn test_ctor_field_label() {
    testlib::run("tests.NullabilityTests.testCtorFieldLabel", "tests.NullabilityTests.testCtorFieldLabel: a nullable constructor argument reaches a nullable property", || {
        test_core::TestCore::test_core_equals_bool(true, true, UStr::new(&[]));
    });
}
