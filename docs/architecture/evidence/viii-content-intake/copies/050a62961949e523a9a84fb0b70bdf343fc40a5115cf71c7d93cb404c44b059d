#[derive(Clone, Copy)]
pub struct NullableArrayArgumentOps;

impl NullableArrayArgumentOps {
    pub fn nullable_array_argument_ops_sum(values: &Vec<u32>) -> u32 {
        let mut total = 0u32;
        for &value in values {
            total = u32::wrapping_add(total, value);
        }
        return total;
    }

    pub fn nullable_array_argument_ops_checked_sum(values: Option<Vec<u32>>) -> u32 {
        if values.is_none() {
            return 0;
        }
        return NullableArrayArgumentOps::nullable_array_argument_ops_sum((values).as_ref().unwrap());
    }
}
