package boring

data class ComparatorBoolRecord(val id: Int, val enabled: Boolean) {
}



data class ComparatorFloatRecord(val id: Int, val weight: Double) {
}



data class ComparatorIntStringRecord(val id: Int, val name: String) {
}

fun compareComparatorIntStringRecord(a: ComparatorIntStringRecord, b: ComparatorIntStringRecord): Int {
    var cmp = 0
    cmp = a.id.compareTo(b.id)
    if (cmp != 0) return cmp
    cmp = a.name.compareTo(b.name)
    if (cmp != 0) return cmp
    return 0
}

data class ComparatorNestedRecord(val value: ComparatorIntStringRecord) {
}

fun compareComparatorNestedRecord(a: ComparatorNestedRecord, b: ComparatorNestedRecord): Int {
    var cmp = 0
    cmp = boring.compareComparatorIntStringRecord(a.value, b.value)
    if (cmp != 0) return cmp
    return 0
}

object ComparatorGateOps {
    fun comparable(): ComparatorNestedRecord {
        return ComparatorNestedRecord(ComparatorIntStringRecord(1, "ok"))
    }
}
