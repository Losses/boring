        let __outcome: Result<u32, F1Fault> = (|| {
            return Ok(EnumProbe::enum_probe_throw_e1(UStr::new(&[97]))?);
        })();
        match __outcome {
            Ok(_) => {}
            Err(e) => {
                let h: u32 = match (|| -> Result<u32, F1Fault> {
                    return Err(F1Fault::E1Fault(Box::new(E1::new(e))));
                })() {
                    Ok(__value) => __value,
                    Err(e2) => 5,
                };
                v = h;
            }
        }
        return v;
    }

