#![cfg(test)]

use crate::boring::value_type_clash_ops::ClashCount;
use crate::boring::value_type_clash_ops::PlainCount;
use crate::runtime::test as testlib;
use crate::runtime::test_core;
use crate::runtime::u_string::UStr;


#[test]
fn clash_doubled() {
    testlib::run("tests.ValueTypeClashTests.clashDoubled", "tests.ValueTypeClashTests.clashDoubled: clashing wrapper reads through the colliding member", || {
        test_core::TestCore::test_core_equals_float(4.0f32, ClashCount(2.0f32).doubled(), UStr::new(&[]));
    });
}

#[test]
fn control_member() {
    testlib::run("tests.ValueTypeClashTests.controlMember", "tests.ValueTypeClashTests.controlMember: clash-free wrapper reads its representation", || {
        test_core::TestCore::test_core_equals_float(3.0f32, PlainCount(3.0f32).read(), UStr::new(&[]));
    });
}
