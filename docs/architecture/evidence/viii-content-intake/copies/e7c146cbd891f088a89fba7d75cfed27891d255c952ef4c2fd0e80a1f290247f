#!/usr/bin/env python3
"""Check 6: full drift scan — every coord-tree source file (tracked + untracked, gitignore-respecting)
vs execution root, byte-for-byte (sha256 + exec bit). Independent re-scan (workers' scan was 18:25)."""
import hashlib, os, subprocess, sys

WS = "/home/losses/Development/tq-workspace"
GIT = os.path.join(WS, "boring")
COORD = os.path.join(WS, "boring-wt-architecture")
EXEC = os.path.join(WS, "publication-staging", "execution-option-c-coord")
COMMIT = "e1c65975"

def sha256_file(p):
    h = hashlib.sha256()
    with open(p, "rb") as f:
        for c in iter(lambda: f.read(1 << 20), b""):
            h.update(c)
    return h.hexdigest()

tracked = set(l for l in subprocess.run(["git", "-C", COORD, "ls-files"], check=True,
                                        capture_output=True, text=True).stdout.splitlines() if l)
untracked = set(l for l in subprocess.run(["git", "-C", COORD, "ls-files", "--others", "--exclude-standard"],
                                          check=True, capture_output=True, text=True).stdout.splitlines() if l)
tracked_at_head = set(l for l in subprocess.run(["git", "-C", GIT, "ls-tree", "-r", "--name-only", COMMIT],
                                                check=True, capture_output=True, text=True).stdout.splitlines() if l)
print(f"tracked(worktree)={len(tracked)}  untracked(non-ignored)={len(untracked)}  tracked@e1c65975={len(tracked_at_head)}")
scope = sorted(tracked | untracked)
match, differ, missing = [], [], []
for p in scope:
    cp = os.path.join(COORD, p)
    ep = os.path.join(EXEC, p)
    if not os.path.isfile(cp):
        print(f"  WARN: coord path vanished: {p}"); continue
    if not os.path.isfile(ep) or os.path.islink(ep):
        missing.append(p); continue
    cs, es = sha256_file(cp), sha256_file(ep)
    if cs != es:
        differ.append(p); continue
    cexec = bool(os.stat(cp).st_mode & 0o111)
    eexec = bool(os.stat(ep).st_mode & 0o111)
    if cexec != eexec:
        differ.append(p + "  [exec-bit differs: coord=%s exec=%s]" % (cexec, eexec))
    else:
        match.append(p)
print(f"scope={len(scope)}  MATCH={len(match)}  DIFFER={len(differ)}  MISSING={len(missing)}")
print("DIFFER:")
for p in differ: print("  DIFFER:", p)
print("MISSING:")
for p in missing: print("  MISSING:", p)

EXPECTED_DIFFER = {"docs/investigations/architecture-round-1/d-observation.md", "tests/support/stage-check.sh"}
EXPECTED_MISSING = {"docs/investigations/architecture-round-2/p09-fixed-matrix-preparation-runbook.md"}
ok = (set(d.split("  [")[0] for d in differ) == EXPECTED_DIFFER and set(missing) == EXPECTED_MISSING
      and len(match) == len(scope) - 3)
print("CHECK6 VERDICT (expect only 2 tracked in-progress DIFFER + 1 untracked doc MISSING):", "PASS" if ok else "FAIL")
sys.exit(0 if ok else 1)
