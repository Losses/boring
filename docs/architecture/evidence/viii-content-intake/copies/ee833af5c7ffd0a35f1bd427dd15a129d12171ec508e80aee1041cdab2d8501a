#![cfg(test)]

use crate::boring::float_field_literal_ops::FloatFieldLiteralOps;
use crate::runtime::test as testlib;
use crate::runtime::test_core;
use crate::runtime::u_string::UStr;


#[test]
fn pair() {
    testlib::run("tests.FloatFieldLiteralOpsTests.pair", "tests.FloatFieldLiteralOpsTests.pair: an Int literal widens into an anonymous Float field", || {
        let leading = FloatFieldLiteralOps::float_field_literal_ops_pair(0, 2.0f64);
        test_core::TestCore::test_core_equals_float(2.0f64, leading.leading, UStr::new(&[]));
        test_core::TestCore::test_core_equals_float(0.0f64, leading.trailing, UStr::new(&[]));
        let trailing = FloatFieldLiteralOps::float_field_literal_ops_pair(1, 3.0f64);
        test_core::TestCore::test_core_equals_float(0.0f64, trailing.leading, UStr::new(&[]));
        test_core::TestCore::test_core_equals_float(3.0f64, trailing.trailing, UStr::new(&[]));
        let both = FloatFieldLiteralOps::float_field_literal_ops_pair(2, 4.0f64);
        test_core::TestCore::test_core_equals_float(2.0f64, both.leading, UStr::new(&[]));
        test_core::TestCore::test_core_equals_float(2.0f64, both.trailing, UStr::new(&[]));
    });
}
