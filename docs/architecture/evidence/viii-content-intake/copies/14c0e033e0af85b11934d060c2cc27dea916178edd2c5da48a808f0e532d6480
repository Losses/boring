use crate::runtime::sorted_table::SortedMapTable;
use crate::runtime::sorted_table::SortedMapTableBuilder;
use crate::runtime::sorted_table::SortedSetTable;
use crate::runtime::sorted_table::SortedSetTableBuilder;
use crate::runtime::sorted_table::SortedTable;
use crate::runtime::u_string::UString;
use std::fmt::Write;
use std::sync::Arc;


#[derive(Clone, Copy)]
pub struct ClusterTags;

impl ClusterTags {
    pub fn cluster_tags_create_map() -> SortedMapTable<ClusterTag, u32> {
        let mut b: SortedMapTableBuilder<ClusterTag, u32> = SortedTable::sorted_table_map_builder::<ClusterTag, u32>(Arc::new(compare_cluster_tag));
        b.put(&(ClusterTag { name: UString::from("beta").to_ustring(), score: 10, sub: SubTag { priority: 1 }, active: true }), &(100));
        b.put(&(ClusterTag { name: UString::from("alpha").to_ustring(), score: 20, sub: SubTag { priority: 2 }, active: false }), &(200));
        b.put(&(ClusterTag { name: UString::from("alpha").to_ustring(), score: 10, sub: SubTag { priority: 3 }, active: true }), &(300));
        b.put(&(ClusterTag { name: UString::from("alpha").to_ustring(), score: 10, sub: SubTag { priority: 1 }, active: true }), &(400));
        b.put(&(ClusterTag { name: UString::from("alpha").to_ustring(), score: 10, sub: SubTag { priority: 1 }, active: false }), &(500));
        return b.clone().build();
    }

    pub fn cluster_tags_create_set() -> SortedSetTable<ClusterTag> {
        let mut b: SortedSetTableBuilder<ClusterTag> = SortedTable::sorted_table_set_builder::<ClusterTag>(Arc::new(compare_cluster_tag));
        b.put(&(ClusterTag { name: UString::from("beta").to_ustring(), score: 10, sub: SubTag { priority: 1 }, active: true }));
        b.put(&(ClusterTag { name: UString::from("alpha").to_ustring(), score: 10, sub: SubTag { priority: 1 }, active: false }));
        b.put(&(ClusterTag { name: UString::from("beta").to_ustring(), score: 10, sub: SubTag { priority: 1 }, active: true }));
        b.put(&(ClusterTag { name: UString::from("alpha").to_ustring(), score: 20, sub: SubTag { priority: 2 }, active: false }));
        return b.clone().build();
    }

    pub fn cluster_tags_tag_score(tag: ClusterTag) -> Option<u32> {
        let map: SortedMapTable<ClusterTag, u32> = ClusterTags::cluster_tags_create_map();
        return map.get(&(tag));
    }

    pub fn cluster_tags_describe_order() -> UString {
        let map: SortedMapTable<ClusterTag, u32> = ClusterTags::cluster_tags_create_map();
        let mut parts: Vec<UString> = vec![];
        let count = u32::from_ne_bytes(((map.size()) as u32).to_ne_bytes());
        for i in 0..count {
            let k = map.key_at({ let v: u32 = i; i32::from_ne_bytes(v.to_ne_bytes()) });
            let mut act = UString::from("F").to_ustring();
            if k.active {
                act = UString::from("T").to_ustring();
            }
            parts.push(UString::from(format!("{}", { let mut __s = UString::new(); __s += (k.name).to_ustring().as_ustr(); __s += &(UString::from(":")); __s += &(UString::from((k.score).to_string().as_str())); __s += &(UString::from(":")); __s += &(UString::from(((k.sub).clone().priority).to_string().as_str())); __s += &(UString::from(":")); __s += act.as_ustr(); __s += &(UString::from("=")); __s += &(UString::from((map.value_at({ let v: u32 = i; i32::from_ne_bytes(v.to_ne_bytes()) })).to_string().as_str())); __s }).as_str()));
        }
        return UString::from(format!("{}", { let joined = parts; let mut out = String::new(); let n = joined.len(); let mut index = 0usize; while index < n { if index > 0 { out.push_str("; "); } let _ = write!(out, "{}", joined[index]); index += 1; } UString::from(out.as_str()) }).as_str());
    }

    pub fn cluster_tags_describe_set_order() -> UString {
        let set: SortedSetTable<ClusterTag> = ClusterTags::cluster_tags_create_set();
        let mut parts: Vec<UString> = vec![];
        let count = u32::from_ne_bytes(((set.size()) as u32).to_ne_bytes());
        for i in 0..count {
            let k = set.at({ let v: u32 = i; i32::from_ne_bytes(v.to_ne_bytes()) });
            let mut act = UString::from("F").to_ustring();
            if k.active {
                act = UString::from("T").to_ustring();
            }
            parts.push(UString::from(format!("{}", { let mut __s = UString::new(); __s += (k.name).to_ustring().as_ustr(); __s += &(UString::from(":")); __s += &(UString::from((k.score).to_string().as_str())); __s += &(UString::from(":")); __s += &(UString::from(((k.sub).clone().priority).to_string().as_str())); __s += &(UString::from(":")); __s += act.as_ustr(); __s }).as_str()));
        }
        return UString::from(format!("{}", { let joined1 = parts; let mut out = String::new(); let n = joined1.len(); let mut index1 = 0usize; while index1 < n { if index1 > 0 { out.push_str("; "); } let _ = write!(out, "{}", joined1[index1]); index1 += 1; } UString::from(out.as_str()) }).as_str());
    }

    pub fn cluster_tags_set_scores() -> Vec<u32> {
        let set: SortedSetTable<ClusterTag> = ClusterTags::cluster_tags_create_set();
        let capacity = usize::try_from(u32::from_ne_bytes(((set.size()) as u32).to_ne_bytes())).unwrap_or(0);
        let mut scores = Vec::with_capacity(capacity);
        for i in 0..u32::from_ne_bytes(((set.size()) as u32).to_ne_bytes()) {
            scores.push(set.at(i32::from_ne_bytes(((i) as i32).to_ne_bytes())).score);
        }
        return scores;
    }

    pub fn cluster_tags_describe_scores() -> UString {
        let scores = ClusterTags::cluster_tags_set_scores();
        let capacity = scores.len();
        let mut parts = Vec::with_capacity(capacity);
        for i in 0..match u32::try_from(scores.len()) { Ok(value) => value, Err(_) => u32::MAX } {
            parts.push(UString::from((scores[usize::try_from(i).unwrap_or(0)]).to_string().as_str()));
        }
        return UString::from(format!("{}", { let joined2 = parts; let mut out = String::new(); let n = joined2.len(); let mut index2 = 0usize; while index2 < n { if index2 > 0 { out.push_str(","); } let _ = write!(out, "{}", joined2[index2]); index2 += 1; } UString::from(out.as_str()) }).as_str());
    }
}

#[derive(Debug, Clone, Copy, PartialEq)]
pub struct SubTag {
    pub priority: u32,
}

pub fn compare_sub_tag(a: &SubTag, b: &SubTag) -> i32 {
    let cmp_priority = match i32::from_ne_bytes((a.priority).to_ne_bytes()).cmp(&i32::from_ne_bytes((b.priority).to_ne_bytes())) { core::cmp::Ordering::Less => -1, core::cmp::Ordering::Equal => 0, core::cmp::Ordering::Greater => 1 };
    if cmp_priority != 0 { return cmp_priority; }
    0
}

#[derive(Debug, Clone, PartialEq)]
pub struct ClusterTag {
    pub name: UString,
    pub score: u32,
    pub sub: SubTag,
    pub active: bool,
}

pub fn compare_cluster_tag(a: &ClusterTag, b: &ClusterTag) -> i32 {
    let cmp_name = SortedTable::sorted_table_compare_strings(a.name.as_ustr(), b.name.as_ustr());
    if cmp_name != 0 { return cmp_name; }
    let cmp_score = match i32::from_ne_bytes((a.score).to_ne_bytes()).cmp(&i32::from_ne_bytes((b.score).to_ne_bytes())) { core::cmp::Ordering::Less => -1, core::cmp::Ordering::Equal => 0, core::cmp::Ordering::Greater => 1 };
    if cmp_score != 0 { return cmp_score; }
    let cmp_sub = compare_sub_tag(&a.sub, &b.sub);
    if cmp_sub != 0 { return cmp_sub; }
    let cmp_active = if a.active < b.active { -1 } else if a.active > b.active { 1 } else { 0 };
    if cmp_active != 0 { return cmp_active; }
    0
}
