package tests

import boring.CloneDeriveAbstractResult
import boring.CloneDeriveGapOps
import boring.CloneDeriveRange
import boring.CloneDeriveResult
import boring.runtime.test.Test

class CloneDeriveGapTests {
@boring.test.Test
    fun resolve() {
        Test.run("tests.CloneDeriveGapTests.resolve", "tests.CloneDeriveGapTests.resolve: data class holding a plain-class field derives Clone and reads owned values") {
                Test.equals("1..3:x", CloneDeriveGapOps.resolve(mutableListOf<CloneDeriveResult>(CloneDeriveResult(CloneDeriveRange(1, 3), "x"))), null)
        }
    }

@boring.test.Test
    fun resolveAbstract() {
        Test.run("tests.CloneDeriveGapTests.resolveAbstract", "tests.CloneDeriveGapTests.resolveAbstract: class holding a string abstract field derives Clone and reads owned values") {
                Test.equals("x:2", CloneDeriveGapOps.resolveAbstract(mutableListOf<CloneDeriveAbstractResult>(CloneDeriveAbstractResult("x", 2))), null)
        }
    }
}
