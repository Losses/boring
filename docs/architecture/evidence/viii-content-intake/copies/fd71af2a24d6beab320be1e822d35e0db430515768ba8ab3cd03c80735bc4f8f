package tests

import boring.Fp16
import boring.runtime.test.Test

class Fp16Tests {
@boring.test.Test
    fun widen() {
        Test.run("tests.Fp16Tests.widen", "tests.Fp16Tests.widen: binary16 patterns widen to exact binary32 bits") {
                Test.equals(1056964608, Fp16.f16ToF32Bits(14336), "0x3800 widens to 0.5")
                Test.equals(-1101004800, Fp16.f16ToF32Bits(45824), "0xB300 widens to -0.21875")
                Test.equals(947896320, Fp16.f16ToF32Bits(1023), "0x03FF widens to 1023*2^-24")
                Test.equals(864026624, Fp16.f16ToF32Bits(1), "0x0001 widens to 2^-24")
                Test.equals(2139095040, Fp16.f16ToF32Bits(31744), "0x7C00 widens to infinity")
        }
    }

@boring.test.Test
    fun narrow() {
        Test.run("tests.Fp16Tests.narrow", "tests.Fp16Tests.narrow: binary32 patterns narrow with round-to-nearest-even") {
                Test.equals(14336, Fp16.f32ToF16Bits(1056964608), "0.5 narrows to 0x3800")
                Test.equals(31736, Fp16.f32ToF16Bits(1199505408), "65280 narrows to 0x7BF8")
                Test.equals(31743, Fp16.f32ToF16Bits(1199562752), "65504 narrows to the largest finite 0x7BFF")
                Test.equals(31744, Fp16.f32ToF16Bits(1199568896), "the 65520 tie narrows to infinity")
                Test.equals(0, Fp16.f32ToF16Bits(855638016), "2^-25 ties to zero")
                Test.equals(1, Fp16.f32ToF16Bits(859832320), "1.5*2^-25 rounds up to the smallest subnormal")
        }
    }
}
