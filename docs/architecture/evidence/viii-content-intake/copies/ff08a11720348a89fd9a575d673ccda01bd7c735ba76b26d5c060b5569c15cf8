package registry

class Release(o: String, r: String, v: String, p: String, n: String, l: String?, read: String) {
    var owner: String
    var repo: String
    var version: String
    var name: String
    var license: String?
    var readme: String
    var platform: String
    var url: String?
    var digest: String
    var archive: String?
    var packageSwift: String?
    var pubspec: JsonValue?
    var groupId: String?
    var artifacts: MutableList<String>
    var artifactUrls: MutableList<String>
    init {
    this.owner = o
    this.repo = r
    this.version = v
    this.platform = p
    this.name = n
    this.license = l
    this.readme = read
    this.url = null
    this.digest = ""
    this.archive = null
    this.packageSwift = null
    this.pubspec = null
    this.groupId = null
    this.artifacts = mutableListOf<String>()
    this.artifactUrls = mutableListOf<String>()
    }
}
