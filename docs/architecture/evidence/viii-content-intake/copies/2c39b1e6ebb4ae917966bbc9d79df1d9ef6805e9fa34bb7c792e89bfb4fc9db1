#!/usr/bin/env python3
"""Check 5: exec bits — disk (expect 755) vs manifest (expect 100755) for the 4 known files."""
import json, os, stat, sys

WS = "/home/losses/Development/tq-workspace"
EXEC = os.path.join(WS, "publication-staging", "execution-option-c-coord")
COORD = os.path.join(WS, "boring-wt-architecture")
MANIFEST = os.path.join(WS, "publication-staging", "p09-coord-state", "option-c-source-before.json")
m = {e["path"]: e for e in json.load(open(MANIFEST))}
files = ["tests/haxe/swift-rt-probe/run-stages.sh", "tests/haxe/swift-rt-plain/run-stages.sh",
         "tests/haxe/dc-null-guard-fallthrough/run.sh", "tests/haxe/try-tail/run-stages.sh"]
ok = True
for p in files:
    ep, cp = os.path.join(EXEC, p), os.path.join(COORD, p)
    st = os.stat(ep)
    stc = os.stat(cp)
    mode = oct(st.st_mode & 0o777)[2:]
    mmode = m[p]["mode"]
    same_bytes = open(ep,'rb').read() == open(cp,'rb').read()
    good = (mode == "755" and mmode == "100755" and same_bytes)
    ok = ok and good
    print(f"{p}: disk={mode} (coord={oct(stc.st_mode&0o777)[2:]}) manifest={mmode} exec==coord-bytes={same_bytes} -> {'OK' if good else 'BAD'}")
print("CHECK5 VERDICT:", "PASS" if ok else "FAIL")
sys.exit(0 if ok else 1)
