package tests

import boring.TryOps
import boring.VectorException
import boring.runtime.test.Test
import registry.CoreException

class RustUnionFaultTests {
@boring.test.Test
    fun unionFaults() {
        Test.run("tests.RustUnionFaultTests.unionFaults", "tests.RustUnionFaultTests.unionFaults: union faults preserve deterministic source text") {
                val text = "direct|edge|cascade"
                Test.equals("direct|edge|cascade", text, null)
                try {
                    RustUnionFaultSupport.directBoth(true)
                } catch (e: VectorException) {
                    Test.equals(11, TryOps.classifyFault(e), null)
                }
        }
    }
}

object RustUnionFaultSupport {
    fun directBoth(flag: Boolean): Int {
        if ((flag)) {
            throw VectorException.BadMagic
        }
        throw CoreException.Config("core")
    }

    fun vectorPath(): Int {
        throw VectorException.UnexpectedEof
    }

    fun corePath(): Int {
        throw CoreException.Tree("tree")
    }

    fun throughCalls(flag: Boolean): Int {
        if ((flag)) {
            return RustUnionFaultSupport.vectorPath()
        }
        return RustUnionFaultSupport.corePath()
    }

    fun secondCaller(flag: Boolean): Int {
        return RustUnionFaultSupport.throughCalls(flag)
    }

    fun mixedCaller(flag: Boolean): Int {
        if ((flag)) {
            return RustUnionFaultSupport.throughCalls(flag)
        }
        throw VectorException.BadMagic
    }
}
