package boring.runtime

object StringTools {
    fun isSpace(s: String, pos: Int): Boolean {
        if ((s.length == 0 || pos < 0 || pos >= s.length)) {
            return false
        }
        val c = run { val _s = s; val _i = pos; if (_i >= 0 && _i < _s.length) _s[_i].code else null }
        return c!! > 8 && c!! < 14 || c == 32
    }

    fun ltrim(s: String): String {
        val l = s.length
        var r = 0
        while ((r < l && StringTools.isSpace(s, r))) {
            r++
        }
        return (if ((r > 0)) run { val _s = s; val _pos = r; val _len = l - r; val _start = if (_pos < 0) maxOf(0, _s.length + _pos) else minOf(_pos, _s.length); if (_len < 0) "" else { val _end = minOf(_s.length, _start + _len); _s.substring(_start, _end) } } else s)
    }

    fun rtrim(s: String): String {
        val l = s.length
        var r = 0
        while ((r < l && StringTools.isSpace(s, l - r - 1))) {
            r++
        }
        return (if ((r > 0)) run { val _s = s; val _pos = 0; val _len = l - r; val _start = if (_pos < 0) maxOf(0, _s.length + _pos) else minOf(_pos, _s.length); if (_len < 0) "" else { val _end = minOf(_s.length, _start + _len); _s.substring(_start, _end) } } else s)
    }

    fun lpad(s: String, c: String, l: Int): String {
        if ((c.length <= 0)) {
            return s
        }
        var buf_b = ""
        val remaining = l - s.length
        while ((buf_b.length < remaining)) {
            buf_b += c
        }
        buf_b += s
        return buf_b
    }

    fun rpad(s: String, c: String, l: Int): String {
        if ((c.length <= 0)) {
            return s
        }
        var buf_b = ""
        buf_b += s
        val remaining = l - s.length
        while ((buf_b.length < remaining)) {
            buf_b += c
        }
        return buf_b
    }

    fun replace(s: String, sub: String, by: String): String {
        return s.split(sub).joinToString(by)
    }
}
