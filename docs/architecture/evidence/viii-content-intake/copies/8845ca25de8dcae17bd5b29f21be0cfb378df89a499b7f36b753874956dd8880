package tests

import boring.StringConvOps
import boring.runtime.test.Test

class StringConvTests {
@boring.test.Test
    fun testHex() {
        Test.run("tests.StringConvTests.testHex", "tests.StringConvTests.testHex: StringTools.hex renders uppercase and optional padding") {
                Test.equals("0", StringConvOps.hexZero(), null)
                Test.equals("A", StringConvOps.hexTen(), null)
                Test.equals("FF", StringConvOps.hexByte(), null)
                Test.equals("9FFF", StringConvOps.hexCjk(), null)
                Test.equals("A", StringConvOps.hexDigitsZero(), null)
                Test.equals("000A", StringConvOps.hexPadded(), null)
                Test.equals("9FFF", StringConvOps.hexWiderThanDigits(), null)
                Test.equals("000A", StringConvOps.hexDynamic(10, 4), null)
                Test.equals("U+9fff", StringConvOps.hexLowercase(), null)
        }
    }

@boring.test.Test
    fun testCaseConversions() {
        Test.run("tests.StringConvTests.testCaseConversions", "tests.StringConvTests.testCaseConversions: String case conversions preserve the target-independent rows") {
                Test.equals("tiqian", StringConvOps.lowerAscii(), null)
                Test.equals("TIQIAN", StringConvOps.upperAscii(), null)
                Test.equals("zh-cn", StringConvOps.lowerLanguageTag(), null)
                Test.equals("ZH-CN", StringConvOps.upperLanguageTag(), null)
                Test.equals("提椠排版", StringConvOps.lowerCjk(), null)
                Test.equals("提椠排版", StringConvOps.upperCjk(), null)
                Test.equals("tiqian", StringConvOps.lowerDynamic("TIQIAN"), null)
                Test.equals("TIQIAN", StringConvOps.upperDynamic("tiqian"), null)
        }
    }
}
