#[derive(Clone, Copy)]
pub struct ArithmeticOps;

impl ArithmeticOps {
    pub fn arithmetic_ops_check_within_int(value: u32, low: u32, high: u32) -> bool {
        return (i32::from_ne_bytes(((value) as i32).to_ne_bytes())) >= i32::from_ne_bytes(((low) as i32).to_ne_bytes()) && (i32::from_ne_bytes(((value) as i32).to_ne_bytes())) <= i32::from_ne_bytes(((high) as i32).to_ne_bytes());
    }

    pub fn arithmetic_ops_check_within_float(value: f32, low: f32, high: f32) -> bool {
        return (value) >= low && (value) <= high;
    }

    pub fn arithmetic_ops_clamp_least_int(value: u32, floor: u32) -> u32 {
        return if i32::from_ne_bytes(((value) as i32).to_ne_bytes()) < (i32::from_ne_bytes(((floor) as i32).to_ne_bytes())) { floor } else { value };
    }

    pub fn arithmetic_ops_clamp_least_float(value: f32, floor: f32) -> f32 {
        return if value < (floor) { floor } else { value };
    }

    pub fn arithmetic_ops_clamp_most_int(value: u32, ceiling: u32) -> u32 {
        return if i32::from_ne_bytes(((value) as i32).to_ne_bytes()) > (i32::from_ne_bytes(((ceiling) as i32).to_ne_bytes())) { ceiling } else { value };
    }

    pub fn arithmetic_ops_clamp_most_float(value: f32, ceiling: f32) -> f32 {
        return if value > (ceiling) { ceiling } else { value };
    }

    pub fn arithmetic_ops_clamp_in_int(value: u32, low: u32, high: u32) -> u32 {
        let v = if i32::from_ne_bytes(((value) as i32).to_ne_bytes()) < (i32::from_ne_bytes(((low) as i32).to_ne_bytes())) { low } else { value };
        return if i32::from_ne_bytes(((v) as i32).to_ne_bytes()) > (i32::from_ne_bytes(((high) as i32).to_ne_bytes())) { high } else { v };
    }

    pub fn arithmetic_ops_clamp_in_float(value: f32, low: f32, high: f32) -> f32 {
        let v = if value < (low) { low } else { value };
        return if v > (high) { high } else { v };
    }

    pub fn arithmetic_ops_in_range(start: u32, end: u32, value: u32) -> bool {
        let range_start = start;
        let range_end = end;
        return (i32::from_ne_bytes(((value) as i32).to_ne_bytes())) >= i32::from_ne_bytes(((range_start) as i32).to_ne_bytes()) && (i32::from_ne_bytes(((value) as i32).to_ne_bytes())) <= i32::from_ne_bytes(((range_end) as i32).to_ne_bytes());
    }
}
