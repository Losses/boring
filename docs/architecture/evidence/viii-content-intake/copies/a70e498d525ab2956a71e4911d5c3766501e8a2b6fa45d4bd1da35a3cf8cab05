package boring;

/** xcheck additional probe: the c2 expression-position probe
    (switch as a call argument) with the boundary crossing removed —
    the argument destination is Array<Int>, not ReadOnlyArray<Int>.
    If this is green, expression-position syntax itself is not the
    cause of the red reading on switchExprDest. */
class ExprNoCrossProbe {
    public static function switchExprNoCross(flag:Bool):String {
        final choice = flag ? C2Choice.Values([1, 2]) : C2Choice.Marker(0);
        return consumeArr(switch (choice) {
            case Values(v): v;
            case Marker(_): fallbackArray();
        }, 1);
    }

    public static function consumeArr(values:Array<Int>, marker:Int):String {
        return values[0] + ":" + marker + ":" + values.length;
    }

    public static function fallbackArray():Array<Int> {
        return [9];
    }

    public static function main():Void {
        #if !swift_output
        trace("expr-nocross=" + switchExprNoCross(true));
        #else
        ExprNoCrossProbe.switchExprNoCross(true);
        #end
    }
}
