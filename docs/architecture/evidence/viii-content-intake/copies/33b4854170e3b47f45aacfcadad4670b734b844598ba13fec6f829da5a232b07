#![cfg(test)]

use crate::boring::extension_consumer::ExtensionConsumer;
use crate::boring::extension_ops::ExtensionMode;
use crate::boring::extension_ops::string_label;
use crate::boring::file_level_consumer::FileLevelConsumer;
use crate::boring::file_level_ops::public_value;
use crate::runtime::test as testlib;
use crate::runtime::test_core;
use crate::runtime::u_string::UStr;


#[test]
fn test_top_level_results() {
    testlib::run("tests.StaticExtensionTests.testTopLevelResults", "tests.StaticExtensionTests.testTopLevelResults: top-level functions cross module boundaries", || {
        test_core::TestCore::test_core_equals_int(17i32, i32::from_ne_bytes(((FileLevelConsumer::file_level_consumer_public_result()) as i32).to_ne_bytes()), UStr::new(&[]));
        test_core::TestCore::test_core_equals_int(23i32, i32::from_ne_bytes(((FileLevelConsumer::file_level_consumer_private_result_through_public()) as i32).to_ne_bytes()), UStr::new(&[]));
        test_core::TestCore::test_core_equals_int(17i32, i32::from_ne_bytes(((public_value(7)) as i32).to_ne_bytes()), UStr::new(&[]));
    });
}

#[test]
fn test_owned_extension() {
    testlib::run("tests.StaticExtensionTests.testOwnedExtension", "tests.StaticExtensionTests.testOwnedExtension: owned extension renders and evaluates as a receiver method", || {
        test_core::TestCore::test_core_equals_string(UStr::new(&[104,111,116,33]), ExtensionConsumer::extension_consumer_enum_result().as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[112,114,105,118,97,116,101,45,99,111,108,100]), ExtensionConsumer::extension_consumer_private_result().as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[99,111,108,100,63]), ExtensionMode::Cold.mode_label(UStr::new(&[63])).as_ustr(), UStr::new(&[]));
    });
}

#[test]
fn test_string_extension() {
    testlib::run("tests.StaticExtensionTests.testStringExtension", "tests.StaticExtensionTests.testStringExtension: foreign string extension keeps its receiver argument", || {
        test_core::TestCore::test_core_equals_string(UStr::new(&[64,99,111,114,101]), ExtensionConsumer::extension_consumer_string_result().as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[35,116,101,120,116]), string_label(UStr::new(&[116,101,120,116]), UStr::new(&[35])).as_ustr(), UStr::new(&[]));
    });
}
