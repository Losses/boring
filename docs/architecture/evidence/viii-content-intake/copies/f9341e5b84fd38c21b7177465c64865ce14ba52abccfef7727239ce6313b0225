pub static RANGES: [u32; 75] = [
    0x20, 0x7e, 1, 0xa0, 0xff, 1, 0x100, 0x17f,
    1, 0x370, 0x3ff, 2, 0x400, 0x4ff, 3, 0x530,
    0x58f, 4, 0x590, 0x5ff, 5, 0x600, 0x6ff, 6,
    0x900, 0x97f, 7, 0x980, 0x9ff, 8, 0xa00, 0xa7f,
    9, 0xa80, 0xaff, 0xa, 0xb00, 0xb7f, 0xb, 0xb80,
    0xbff, 0xc, 0xc00, 0xc7f, 0xd, 0xc80, 0xcff, 0xe,
    0xd00, 0xd7f, 0xf, 0xd80, 0xdff, 0x10, 0xe00, 0xe7f,
    0x11, 0xe80, 0xeff, 0x12, 0x3040, 0x309f, 0x13, 0x30a0,
    0x30ff, 0x14, 0x4e00, 0x9fff, 0x15, 0xac00, 0xd7af, 0x16,
    0x2fa00, 0x2fa1f, 0x17
];

#[derive(Clone, Copy)]
pub struct ScriptEvidenceTable;

impl ScriptEvidenceTable {

    pub fn script_evidence_table_classify(code_point: u32) -> u32 {
        let mut low = 0u32;
        let mut high = u32::try_from((RANGES.len()) & 0xFFFF_FFFF).unwrap_or(0) / (3);
        while (i32::from_ne_bytes(((low) as i32).to_ne_bytes())) < (i32::from_ne_bytes(((high) as i32).to_ne_bytes())) {
            let mid = u32::wrapping_add(low, high) >> 1;
            let start = RANGES[usize::try_from(u32::wrapping_mul(mid, 3)).unwrap_or(0)];
            let end = RANGES[usize::try_from(u32::wrapping_add(u32::wrapping_mul(mid, 3), 1)).unwrap_or(0)];
            if i32::from_ne_bytes(((code_point) as i32).to_ne_bytes()) < (i32::from_ne_bytes(((start) as i32).to_ne_bytes())) {
                high = mid;
            } else {
                if i32::from_ne_bytes(((code_point) as i32).to_ne_bytes()) > (i32::from_ne_bytes(((end) as i32).to_ne_bytes())) {
                    low = u32::wrapping_add(mid, 1);
                } else {
                    return RANGES[usize::try_from(u32::wrapping_add(u32::wrapping_mul(mid, 3), 2)).unwrap_or(0)];
                }
            }
        }
        return 0;
    }
}
