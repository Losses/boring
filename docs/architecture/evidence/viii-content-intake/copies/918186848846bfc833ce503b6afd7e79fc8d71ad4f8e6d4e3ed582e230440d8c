package boring

object ArraySliceOps {
    fun values(count: Int): MutableList<Int> {
        val out = mutableListOf<Int>()
        var i = 0
        while ((i < count)) {
            out.add(i + 1)
            i++
        }
        return out
    }

    fun sliceText(count: Int, from: Int, to: Int): String {
        return run { val _a = ArraySliceOps.values(count); val _n = _a.size; val _from = from; val _start = if (_from < 0) maxOf(0, _n + _from) else minOf(_from, _n); val _to = to; val _end = if (_to < 0) maxOf(0, _n + _to) else minOf(_to, _n); val _stop = if (_end < _start) _start else _end; _a.slice(_start until _stop) }.joinToString(",")
    }

    fun fromText(count: Int, from: Int): String {
        return run { val _a = ArraySliceOps.values(count); val _n = _a.size; val _from = from; val _start = if (_from < 0) maxOf(0, _n + _from) else minOf(_from, _n); val _stop = _n; _a.slice(_start until _stop) }.joinToString(",")
    }

    fun spliceText(count: Int, pos: Int, len: Int): String {
        val values = ArraySliceOps.values(count)
        val removed = run { val _a = values; val _p0 = pos; val _l = len; val _sz = _a.size; val _p = if (_p0 < 0) maxOf(_sz + _p0, 0) else _p0; if (_l < 0 || _p0 > _sz) _a.subList(0, 0).toMutableList() else { val _c = minOf(_l, _sz - _p); val _r = _a.subList(_p, _p + _c).toMutableList(); _a.subList(_p, _p + _c).clear(); _r } }
        return removed.joinToString(",") + "|" + values.joinToString(",")
    }

    fun insertText(count: Int, pos: Int): String {
        val values = ArraySliceOps.values(count)
        run { val _a = values; val _n = _a.size; val _pos = pos; val _at = if (_pos < 0) maxOf(0, _n + _pos) else minOf(_pos, _n); _a.add(_at, 99) }
        return values.joinToString(",")
    }

    fun nullableText(values: MutableList<Int>?, from: Int, to: Int): String {
        val sliced = (if ((values != null)) run { val _a = values; val _n = _a.size; val _from = from; val _start = if (_from < 0) maxOf(0, _n + _from) else minOf(_from, _n); val _to = to; val _end = if (_to < 0) maxOf(0, _n + _to) else minOf(_to, _n); val _stop = if (_end < _start) _start else _end; _a.slice(_start until _stop) } else null)
        return (if ((sliced == null)) "none" else sliced.joinToString(","))
    }

    fun nullInitText(count: Int): String {
        var values: MutableList<Int>? = null
        values = ArraySliceOps.values(count)
        return (values?.let { _a -> val _n = _a.size; val _from = 0; val _start = if (_from < 0) maxOf(0, _n + _from) else minOf(_from, _n); val _to = 20; val _end = if (_to < 0) maxOf(0, _n + _to) else minOf(_to, _n); val _stop = if (_end < _start) _start else _end; _a.slice(_start until _stop) }?.joinToString(","))!!
    }

    fun emptyToTwentyText(): String {
        val failures = mutableListOf<String>()
        return run { val _a = failures; val _n = _a.size; val _from = 0; val _start = if (_from < 0) maxOf(0, _n + _from) else minOf(_from, _n); val _to = 20; val _end = if (_to < 0) maxOf(0, _n + _to) else minOf(_to, _n); val _stop = if (_end < _start) _start else _end; _a.slice(_start until _stop) }.joinToString(",")
    }

    fun emptyToTwentySize(): Int {
        val failures = mutableListOf<String>()
        return run { val _a = failures; val _n = _a.size; val _from = 0; val _start = if (_from < 0) maxOf(0, _n + _from) else minOf(_from, _n); val _to = 20; val _end = if (_to < 0) maxOf(0, _n + _to) else minOf(_to, _n); val _stop = if (_end < _start) _start else _end; _a.slice(_start until _stop) }.size
    }

    fun nullInitSpliceText(count: Int, pos: Int, len: Int): String {
        var values: MutableList<Int>? = null
        values = ArraySliceOps.values(count)
        val removed = run { val _a = values; val _p0 = pos; val _l = len; val _sz = _a.size; val _p = if (_p0 < 0) maxOf(_sz + _p0, 0) else _p0; if (_l < 0 || _p0 > _sz) _a.subList(0, 0).toMutableList() else { val _c = minOf(_l, _sz - _p); val _r = _a.subList(_p, _p + _c).toMutableList(); _a.subList(_p, _p + _c).clear(); _r } }!!
        return removed.joinToString(",") + "|" + values?.joinToString(",")
    }
}
