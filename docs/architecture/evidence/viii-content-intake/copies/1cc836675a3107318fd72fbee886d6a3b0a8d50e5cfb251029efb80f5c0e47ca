use crate::runtime::env::Env;
use crate::runtime::fs::Fs;
use crate::runtime::u_string::UStr;
use crate::runtime::u_string::UString;
use crate::std::path::Path;


#[derive(Clone, Copy)]
pub struct PlatformOps;

impl PlatformOps {
    pub fn platform_ops_exists(path: &UStr) -> bool {
        return Fs::exists(path);
    }

    pub fn platform_ops_read_text(path: &UStr) -> UString {
        return Fs::read_text(path);
    }

    pub fn platform_ops_write_append_read(path: &UStr, first: &UStr, second: &UStr) -> UString {
        Fs::write_text(path, first);
        Fs::append_text(path, second);
        return Fs::read_text(path);
    }

    pub fn platform_ops_make_dirs_check(path: &UStr) -> bool {
        Fs::make_dirs(path);
        return Fs::is_directory(path);
    }

    pub fn platform_ops_list_dir(path: &UStr) -> Vec<UString> {
        return Fs::read_dir(path);
    }

    pub fn platform_ops_env_get(key: &UStr) -> UString {
        let value = Env::get(key);
        return match &(value) { None => UString::from("<absent>"), Some(__option) => __option.to_ustring() };
    }

    pub fn platform_ops_env_round_trip(key: &UStr, value: &UStr) -> UString {
        Env::set(key, value);
        let after_set = Env::get(key);
        Env::remove(key);
        let after_remove = Env::get(key);
        return UString::from(format!("{}", { let mut __s = UString::new(); __s += PlatformOps::platform_ops_text_or(after_set.clone(), UStr::new(&[60,110,117,108,108,62])).as_ustr(); __s += &(UString::from("|")); __s += PlatformOps::platform_ops_text_or(after_remove.clone(), UStr::new(&[60,97,98,115,101,110,116,62])).as_ustr(); __s }).as_str());
    }

    pub(crate) fn platform_ops_text_or(value: Option<UString>, marker: &UStr) -> UString {
        return match &(value) { None => marker.to_ustring(), Some(__option1) => __option1.to_ustring() };
    }

    pub fn platform_ops_first_arg() -> UString {
        let args = std::env::args().skip(1).map(|__a| UString::from(__a.as_str())).collect::<Vec<UString>>();
        return if i32::from_ne_bytes(((u32::try_from((args.len()) & 0xFFFF_FFFF).unwrap_or(0)) as i32).to_ne_bytes()) > (0) { (args[0usize]).clone() } else { UString::from("<none>") };
    }

    pub fn platform_ops_join(a: &UStr, b: &UStr) -> UString {
        return Path::path_join(a, b);
    }

    pub fn platform_ops_dirname(p: &UStr) -> UString {
        return Path::path_dirname(p);
    }

    pub fn platform_ops_normalize(p: &UStr) -> UString {
        return Path::path_normalize(p);
    }

    pub fn platform_ops_home() -> UString {
        let value = Env::get(UStr::new(&[80,76,65,84,70,79,82,77,95,84,69,83,84,95,72,79,77,69]));
        return match &(value) { None => UString::from("<absent>"), Some(__option2) => __option2.to_ustring() };
    }
}
