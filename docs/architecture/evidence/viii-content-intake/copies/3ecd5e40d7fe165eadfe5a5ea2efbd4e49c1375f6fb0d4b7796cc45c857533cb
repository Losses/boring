package tests

import boring.BinaryWriter
import boring.BoundsEm
import boring.GlyphMetrics

object TestData {
    fun sampleBounds(): BoundsEm {
        return BoundsEm(xMin = 0.0f, yMin = 0.0f, xMax = 0.5f, yMax = 0.5f)
    }

    fun glyphSamples(): MutableList<GlyphMetrics> {
        return mutableListOf<GlyphMetrics>(GlyphMetrics(codePoint = 65, advanceEm = 0.5f, bounds = BoundsEm(xMin = 0.0f, yMin = 0.0f, xMax = 0.5f, yMax = 0.5f)))
    }

    fun sampleBytes(): ByteArray {
        val writer = BinaryWriter()
        writer.writeU32(1112688433)
        return writer.finish()
    }
}
