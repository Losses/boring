#!/usr/bin/env bash
set -u
REPO=/home/losses/Development/tq-workspace/boring-wt-architecture
OUT=/home/losses/Development/tq-workspace/dc-warn/out/finite-classify-fix
SCRATCH=/home/losses/Development/tq-workspace/dc-warn/tmp/patch-check
case "$SCRATCH" in
  /home/losses/Development/tq-workspace/dc-warn/tmp/patch-check) ;;
  *) echo "refusing to clean unexpected path: $SCRATCH"; exit 1 ;;
esac
rm -rf "$SCRATCH"
mkdir -p "$SCRATCH/samples/tests"
git -C "$REPO" show HEAD:samples/tests/NumberClassifyTests.hx > "$SCRATCH/samples/tests/NumberClassifyTests.hx"
cd "$SCRATCH" && git init -q .
git apply -p1 --check "$OUT/PATCH.diff"
echo "GIT_APPLY_CHECK_EXIT=$?"
git apply -p1 "$OUT/PATCH.diff"
echo "GIT_APPLY_EXIT=$?"
diff "$SCRATCH/samples/tests/NumberClassifyTests.hx" "$REPO/samples/tests/NumberClassifyTests.hx" && echo "TEST_FILE_MATCHES_WORKTREE"
diff "$SCRATCH/tools/precision-guard/check.ts" "$REPO/tools/precision-guard/check.ts" && echo "GUARD_FILE_MATCHES_WORKTREE"
