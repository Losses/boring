package tests

import boring.NullabilityOps
import boring.NullableReceiver
import boring.runtime.test.Test

class NullabilityTests {
@boring.test.Test
    fun testNullableToString() {
        Test.run("tests.NullabilityTests.testNullableToString", "tests.NullabilityTests.testNullableToString: nullable toString in argument") {
                Test.equals("present", NullabilityOps.nullableToString(NullableReceiver()), null)
                Test.equals(null, NullabilityOps.nullableToString(null), null)
        }
    }

@boring.test.Test
    fun testNullableToStringWithParam() {
        Test.run("tests.NullabilityTests.testNullableToStringWithParam", "tests.NullabilityTests.testNullableToStringWithParam: nullable toString with suffix") {
                Test.equals("present!", NullabilityOps.nullableToStringWithParam(NullableReceiver(), "!"), null)
                Test.equals(null, NullabilityOps.nullableToStringWithParam(null, "!"), null)
        }
    }

@boring.test.Test
    fun testNarrowedFloat() {
        Test.run("tests.NullabilityTests.testNarrowedFloat", "tests.NullabilityTests.testNarrowedFloat: a guarded nullable Float read widens after extraction") {
                val values = mutableListOf<Float?>(1.5f, null)
                Test.equals(1.5f, NullabilityOps.narrowedFloat(values, 0), null)
                Test.equals(0.0f, NullabilityOps.narrowedFloat(values, 1), null)
        }
    }

@boring.test.Test
    fun testCtorFieldLabel() {
        Test.run("tests.NullabilityTests.testCtorFieldLabel", "tests.NullabilityTests.testCtorFieldLabel: a nullable constructor argument reaches a nullable property") {
                Test.equals("HI", NullabilityOps.ctorFieldLabel("hi"), null)
                Test.equals(null, NullabilityOps.ctorFieldLabel(null), null)
        }
    }
}
