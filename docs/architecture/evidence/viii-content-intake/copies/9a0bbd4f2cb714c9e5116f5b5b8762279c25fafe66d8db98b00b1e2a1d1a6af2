#!/usr/bin/env bash
# Independent three-state re-run of the ThrowFaultVariantGrowth cross-check.
# usage: bash run-all.sh <state: pristine|postfix|negctl> <...segments>
# Segment syntax: <fixture-rel>:<expected-abs>:<harness-rel>:<label>
set -uo pipefail
WT=/home/losses/Development/tq-workspace/dc-warn/worktrees/rust-trytail-xcheck
SRC=/home/losses/Development/tq-workspace/dc-warn/worktrees/rust-trytail-xcheck/packages/compiler/reflaxe/rust/rustcompiler
STATE="$1"; shift
export XDG_CACHE_HOME=/tmp/rt-xcheck-nix-cache
cd "$WT"

case "$STATE" in
pristine) cp /tmp/rt-xcheck/src-pristine/*.hx "$SRC/" ;;
postfix) cp /tmp/rt-xcheck/src-postfix/*.hx "$SRC/" ;;
negctl)
	cp /tmp/rt-xcheck/src-postfix/*.hx "$SRC/"
	# revert ONLY the scan-side registration call the patch inserted
	python3 - "$SRC/Compiler.hx" <<'PY'
import sys
p = sys.argv[1]
s = open(p).read()
call = "                                            registerThrownExceptionVariant(stripDecorations(t));\n"
assert s.count(call) == 1, "registration call not found exactly once"
open(p, "w").write(s.replace(call, "                                            // NEGCTL: registration call reverted\n"))
PY
	;;
*) echo "unknown state $STATE"; exit 9 ;;
esac

echo "STATE=$STATE"
sha256sum "$SRC"/Compiler.hx "$SRC"/RustDecl.hx "$SRC"/RustExpr.hx "$SRC"/RustEmissionState.hx

EVBASE=/home/losses/Development/tq-workspace/dc-warn/out/rust-trytail-xcheck/attempt-xcheck-01
mkdir -p "$EVBASE"
for seg in "$@"; do
	IFS=: read -r FIX EXP HARNESS LABEL <<<"$seg"
	EV="$EVBASE/$LABEL"
	GEN=/tmp/rt-xcheck/run-$LABEL
	TGT=/tmp/rt-xcheck/tgt-$LABEL
	rm -rf "$GEN" "$TGT"
	mkdir -p "$EV"
	( cd "$WT" && sha256sum "$FIX/expected.txt" "$FIX/gen/rust.hxml" "$FIX/native/harness.rs" >"$EV/input-hashes.txt" )
	bash /tmp/rt-xcheck/stages.sh full "$FIX" "$GEN" "$TGT" "$EXP" "$HARNESS" "$EV"
	echo "SEGMENT $LABEL done rc=$?"
done
