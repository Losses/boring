use crate::runtime::u_string::UStr;
use crate::runtime::u_string::UString;


#[derive(Clone, PartialEq)]
pub struct BorrowedLoopItemHolder {
    pub entry: BorrowedLoopItemEntry,
}

impl BorrowedLoopItemHolder {
    pub fn new(entry: BorrowedLoopItemEntry) -> Self {
        Self {
            entry,
        }
    }
}

#[derive(Clone, Copy)]
pub struct BorrowedLoopItemBoundaryOps;

impl BorrowedLoopItemBoundaryOps {
    pub fn borrowed_loop_item_boundary_ops_describe(entry: BorrowedLoopItemEntry) -> UString {
        return UString::from(format!("{}", {
    let _g = match entry { BorrowedLoopItemEntry::Entry { label, .. } => label };
    let label = (_g).clone();
    label
}).as_str());
    }

    pub fn borrowed_loop_item_boundary_ops_first_entry(entries: &Vec<BorrowedLoopItemEntry>) -> Option<BorrowedLoopItemEntry> {
        for entry in entries {
            return Some((*entry).clone());
        }
        return None;
    }

    pub fn borrowed_loop_item_boundary_ops_wrapped_entries(entries: &Vec<BorrowedLoopItemEntry>) -> Vec<BorrowedLoopItemHolder> {
        let mut out: Vec<BorrowedLoopItemHolder> = vec![];
        for entry in entries {
            out.push(BorrowedLoopItemHolder::new((*entry).clone()));
        }
        return out;
    }

    pub fn borrowed_loop_item_boundary_ops_described_labels(entries: &Vec<BorrowedLoopItemEntry>) -> Vec<UString> {
        let mut out: Vec<UString> = vec![];
        for entry in entries {
            out.push(BorrowedLoopItemBoundaryOps::borrowed_loop_item_boundary_ops_describe((*entry).clone()));
        }
        return out;
    }

    pub fn borrowed_loop_item_boundary_ops_records(entries: &Vec<BorrowedLoopItemEntry>) -> Vec<BorrowedLoopItemRecord> {
        let mut out: Vec<BorrowedLoopItemRecord> = vec![];
        for entry in entries {
            let record = BorrowedLoopItemRecord { tag: UString::from("tag").to_ustring(), entry: (*entry).clone() };
            out.push(record.clone());
        }
        return out;
    }

    pub fn borrowed_loop_item_boundary_ops_has_marker(markers: &Vec<BorrowedLoopMarker>, target: BorrowedLoopMarker) -> bool {
        for marker in markers {
            if *marker == target {
                return true;
            }
        }
        return false;
    }

    pub fn borrowed_loop_item_boundary_ops_index_of_nullable_ints(values: Option<Vec<u32>>, target: u32) -> u32 {
        return match &(values) { None => 4294967295u32, Some(__option) => u32::from_ne_bytes(((match __option.iter().position(|e| e == &target) { Some(v) => i32::from_ne_bytes(u32::try_from(v).unwrap_or(0).to_ne_bytes()), None => -1 }) as u32).to_ne_bytes()) };
    }

    pub fn borrowed_loop_item_boundary_ops_index_of_nullable_strings(values: Option<Vec<UString>>, needle: &UStr) -> u32 {
        return match &(values) { None => 4294967295u32, Some(__option1) => u32::from_ne_bytes(((match __option1.iter().position(|e| e == &needle) { Some(v) => i32::from_ne_bytes(u32::try_from(v).unwrap_or(0).to_ne_bytes()), None => -1 }) as u32).to_ne_bytes()) };
    }
}

#[derive(Debug, Clone, PartialEq)]
pub enum BorrowedLoopItemEntry {
    Entry { label: UString },
}

impl BorrowedLoopItemEntry {
    pub fn to_string(&self) -> String {
        match self {
            BorrowedLoopItemEntry::Entry { label } => format!("Entry(label={})", (label).clone()),
        }
    }
}

#[derive(Debug, Clone, Copy, PartialEq)]
pub enum BorrowedLoopMarker {
    MarkerAlpha,
    MarkerBeta,
}

pub fn compare_borrowed_loop_marker(a: &BorrowedLoopMarker, b: &BorrowedLoopMarker) -> i32 {
    if a == b { return 0; }
    fn rank(v: &BorrowedLoopMarker) -> i32 {
        match v {
            BorrowedLoopMarker::MarkerAlpha => 0,
            BorrowedLoopMarker::MarkerBeta => 1,
        }
    }
    rank(a) - rank(b)
}

impl BorrowedLoopMarker {
    pub fn to_string(&self) -> String {
        match self {
            BorrowedLoopMarker::MarkerAlpha => "MarkerAlpha".to_string(),
            BorrowedLoopMarker::MarkerBeta => "MarkerBeta".to_string(),
        }
    }
}

#[derive(Debug, Clone, PartialEq)]
pub struct BorrowedLoopItemRecord {
    pub tag: UString,
    pub entry: BorrowedLoopItemEntry,
}
