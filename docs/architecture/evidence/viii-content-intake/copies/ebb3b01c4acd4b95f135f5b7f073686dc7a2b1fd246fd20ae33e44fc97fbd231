package tests

import boring.BuiltInNameResolver
import boring.FnValuesOps
import boring.runtime.test.Test

class FnValuesTests {
@boring.test.Test
    fun testFieldInvocation() {
        Test.run("tests.FnValuesTests.testFieldInvocation", "tests.FnValuesTests.testFieldInvocation: function-typed fields stored and invoked") {
                val ops = FnValuesOps(fun(index: Int): String {
    return "s" + index
}, BuiltInNameResolver())
                Test.equals("s3", ops.styleLabel(3), null)
                Test.equals("built-in:cjk", ops.resolveLabel("cjk"), null)
        }
    }

@boring.test.Test
    fun testParameterInvocation() {
        Test.run("tests.FnValuesTests.testParameterInvocation", "tests.FnValuesTests.testParameterInvocation: function-typed parameter invoked inside the callee") {
                Test.equals("i1", FnValuesOps.applyPicker(mutableListOf<String>("a", "b"), fun(index: Int): String {
    return "i" + index
}), null)
        }
    }

@boring.test.Test
    fun testGenericParameter() {
        Test.run("tests.FnValuesTests.testGenericParameter", "tests.FnValuesTests.testGenericParameter: generic function-typed parameter") {
                Test.equals(6, FnValuesOps.mapOne(5, fun(item: Int): Int {
    return item + 1
}), null)
                Test.equals("x!", FnValuesOps.mapOne("x", fun(item: String): String {
    return item + "!"
}), null)
        }
    }

@boring.test.Test
    fun testStoredLocal() {
        Test.run("tests.FnValuesTests.testStoredLocal", "tests.FnValuesTests.testStoredLocal: local function value stored and invoked") {
                Test.equals("u19968", FnValuesOps.storedLocal(), null)
        }
    }

@boring.test.Test
    fun testReturnedFunction() {
        Test.run("tests.FnValuesTests.testReturnedFunction", "tests.FnValuesTests.testReturnedFunction: function value returned from a function") {
                val prefixed = FnValuesOps.makePrefixer("pre-")
                Test.equals("pre-suffix", prefixed("suffix"), null)
        }
    }

@boring.test.Test
    fun testStaticField() {
        Test.run("tests.FnValuesTests.testStaticField", "tests.FnValuesTests.testStaticField: static function-typed field invoked") {
                Test.equals("tag7", FnValuesOps.defaultTag(7), null)
        }
    }
}
