package boring

interface MutatingCounter {
    fun bump(): Int
}

object MutatingCounterOps {
    private fun makeCounter(): MutatingCounter {
        return CountingMutatingCounter()
    }

    fun bumpTwice(): Int {
        val counter = MutatingCounterOps.makeCounter()
        return counter.bump() + counter.bump()
    }

    private fun makeReadOnlyCounter(): MutatingCounter {
        return ReadOnlyMutatingCounter()
    }

    fun readOnly(): Int {
        val counter = MutatingCounterOps.makeReadOnlyCounter()
        return counter.bump()
    }

    fun bumpThriceConcrete(): Int {
        val counter = CountingMutatingCounter()
        counter.bump()
        counter.bump()
        return counter.bump()
    }
}

class CountingMutatingCounter : MutatingCounter {
    var count: Int
    init {
    this.count = 0
    }

    override fun bump(): Int {
        this.count += 1
        return this.count
    }
}

class ReadOnlyMutatingCounter : MutatingCounter {
    override fun bump(): Int {
        return 0
    }
}
