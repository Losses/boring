    fp=os.path.join(ROOT,e['path'])
    if not os.path.isfile(fp): fail.append((e['path'],'MISSING')); continue
    s=sha(fp); m=perm(fp); mm=int(e['mode'],8)&0o777
    if s!=e['sha256']: fail.append((e['path'],'SHA'))
    if m!=mm: fail.append((e['path'],'MODE coord?',oct(m),e['mode']))
