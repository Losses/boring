# ---- 5. mode census whole trees
def census(base):
    c=collections.Counter()
    for dp,dns,fns in os.walk(base):
        dns[:]=[x for x in dns if x not in SKIP]
        for fn in fns: c[oct(os.lstat(os.path.join(dp,fn)).st_mode&0o777)[2:]]+=1
    return c
print('\nCOORD perm census',dict(census(COORD)))
print('ROOT  perm census',dict(census(ROOT)))

# ---- 6. untracked fixtures
rc,ub,_=git('ls-files','-o','--exclude-standard','-z')
unts=[p for p in ub.decode().split('\0') if p]
bad=[]
for p in unts:
    cf=os.path.join(COORD,p); rf=os.path.join(ROOT,p)
    if not os.path.isfile(rf): bad.append((p,'MISSING')); continue
    if sha(cf)!=sha(rf): bad.append((p,'DIFFER'))
    elif perm(cf)!=perm(rf): bad.append((p,'MODE',oct(perm(cf))[2:],oct(perm(rf))[2:]))
print('\nUNTRACKED n=%d anomalies=%d'%(len(unts),len(bad)))
for b in bad: print('   ',b)
