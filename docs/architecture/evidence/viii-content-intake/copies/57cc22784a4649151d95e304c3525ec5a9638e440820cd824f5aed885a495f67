#[derive(Clone, PartialEq)]
pub struct CrcModel {
    pub width: u32,
    pub poly: u32,
    pub init: u32,
    pub refin: bool,
    pub refout: bool,
    pub xorout: u32,
}

impl CrcModel {
    pub fn new(width: u32, poly: u32, init: u32, refin: bool, refout: bool, xorout: u32) -> Self {
        Self {
            width,
            poly,
            init,
            refin,
            refout,
            xorout,
        }
    }
}
