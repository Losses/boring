#!/usr/bin/env bash
# auditgen.sh <tree-tag> <name> <fixture-dir> <main-class> [getType...]
set -u
export PATH="$(grep -m1 '^PATH=' /home/losses/Development/tq-workspace/dc-warn/out/chainA-fixed-rerun/evidence/env.json | cut -d= -f2-)"
TAG="$1"; NAME="$2"; FIX="$3"; MAIN="$4"; shift 4
TREE="/tmp/vc8/$TAG"
GEN="/tmp/vc8/out/$TAG-$NAME/gen"
DRV="/tmp/vc8/drv/$TAG-$NAME.hxml"
AOUT="/tmp/vc8/logs/audit-$TAG-$NAME.txt"
mkdir -p "$GEN"
{
  echo "-lib reflaxe"
  echo "-lib boring"
  echo "-cp packages/compiler"
  echo "-cp packages/compiler/reflaxe/swift/std-shadow"
  echo "-cp packages/compiler/reflaxe/swift"
  echo "-cp samples"
  echo "-cp $FIX"
  echo "-cp /tmp/vc8/haxedump"
  echo "--macro Intercept.run(['samples', '$FIX'])"
  echo "--macro AuditG.run()"
  echo "-D auditout=$AOUT"
  echo "--macro swiftcompiler.Compiler.use()"
  echo "-D swift-test-runner=native"
  echo "-D runtime-import=@boring/runtime"
  echo "-D runtime-emit=."
  echo "-D swift-output=$GEN"
  echo "$MAIN"
  for g in "$@"; do echo "--macro haxe.macro.Context.getType(\"$g\")"; done
} > "$DRV"
LOG="/tmp/vc8/logs/auditgen-$TAG-$NAME.log"
( cd "$TREE" && haxe "$DRV" ) > "$LOG" 2>&1
rc=$?
echo "auditgen $TAG/$NAME rc=$rc -> $AOUT"
