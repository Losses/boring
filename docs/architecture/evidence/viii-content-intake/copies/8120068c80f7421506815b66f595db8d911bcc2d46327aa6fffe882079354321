use crate::runtime::fp_helper::FPHelper;


#[derive(Clone, Copy)]
pub struct Fp32;

impl Fp32 {
    pub fn fp32_to_bits(value: f32) -> u32 {
        let d = FPHelper::f32_to_i64(value);
        return Fp32::fp32_f64_halves_to_f32_bits(d.low, d.high);
    }

    pub fn fp32_from_bits(bits: u32) -> f32 {
        let sign = bits >> 31;
        let exp8 = bits >> 23 & 255;
        let mant23 = bits & 8388607;
        if exp8 == 255 {
            let high = sign << (31) | 2146435072 | (if mant23 == 0 { 0 } else { 524288 | mant23 >> 3 });
            let low = (mant23 & 7) << (29);
            return FPHelper::i64_to_f32(low, high);
        }
        if exp8 == 0 {
            if mant23 == 0 {
                return FPHelper::i64_to_f32(0, (sign) << (31));
            }
            let mut mant = mant23;
            let mut shift = 0u32;
            while (mant & 8388608) == 0 {
                mant <<= 1;
                shift = u32::wrapping_add(shift, 1);
            }
            let frac = mant & 8388607;
            let high = sign << (31) | (u32::wrapping_sub(897, shift)) << (20) | frac >> 3;
            let low = (frac & 7) << (29);
            return FPHelper::i64_to_f32(low, high);
        }
        let high = sign << (31) | (u32::wrapping_add(exp8, 896)) << (20) | mant23 >> 3;
        let low = (mant23 & 7) << (29);
        return FPHelper::i64_to_f32(low, high);
    }

    pub fn fp32_f64_halves_to_f32_bits(low: u32, high: u32) -> u32 {
        let sign = high >> 31;
        let exp11 = high >> 20 & 2047;
        if exp11 == 2047 {
            if high & 1048575 == 0 && low == 0 {
                return (sign) << (31) | 2139095040;
            }
            return (sign) << (31) | 2139095040 | 4194304 | high >> 10 & 1023;
        }
        if exp11 == 0 {
            return (sign) << (31);
        }
        let mant_high = high & 1048575;
        let mut sig24 = 8388608 | (mant_high) << (3) | low >> 29;
        let dropped = low & 536870911;
        let half = 268435456u32;
        if i32::from_ne_bytes(((dropped) as i32).to_ne_bytes()) > (i32::from_ne_bytes(((half) as i32).to_ne_bytes())) || dropped == half && (sig24 & 1) == 1 {
            sig24 = u32::wrapping_add(sig24, 1);
        }
        let mut e2 = exp11;
        if sig24 == 16777216 {
            sig24 = 8388608u32;
            e2 = u32::wrapping_add(e2, 1);
        }
        if i32::from_ne_bytes(((e2) as i32).to_ne_bytes()) >= 1151 {
            return (sign) << (31) | 2139095040;
        }
        if i32::from_ne_bytes(((e2) as i32).to_ne_bytes()) >= 897 {
            return (sign) << (31) | (u32::wrapping_sub(e2, 896)) << (23) | sig24 & 8388607;
        }
        return (sign) << (31) | Fp32::fp32_subnormal_target(mant_high, low, u32::wrapping_sub(896, e2));
    }

    pub(crate) fn fp32_subnormal_target(mant_high: u32, low: u32, k: u32) -> u32 {
        if i32::from_ne_bytes(((k) as i32).to_ne_bytes()) >= 24 {
            return 0;
        }
        let top = (1048576 | mant_high) << (2) | low >> 30;
        let rest = low & 1073741823;
        let half_rest = 536870912u32;
        let mut h = if k == 0 { top } else { top >> k };
        if k == 0 {
            if i32::from_ne_bytes(((rest) as i32).to_ne_bytes()) > (i32::from_ne_bytes(((half_rest) as i32).to_ne_bytes())) || rest == half_rest && (h & 1) == 1 {
                h = u32::wrapping_add(h, 1);
            }
        } else {
            let r = top & u32::wrapping_sub((1) << (k), 1);
            let half_r = 1 << (u32::wrapping_sub(k, 1));
            if i32::from_ne_bytes(((r) as i32).to_ne_bytes()) > (i32::from_ne_bytes(((half_r) as i32).to_ne_bytes())) || r == half_r && (i32::from_ne_bytes(((rest) as i32).to_ne_bytes())) > (0) || r == half_r && rest == 0 && (h & 1) == 1 {
                h = u32::wrapping_add(h, 1);
            }
        }
        if h == 8388608 {
            return 8388608;
        }
        return h;
    }
}
