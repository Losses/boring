use crate::runtime::u_string::UStr;
use crate::runtime::u_string::UString;


#[derive(Clone, PartialEq)]
pub struct CloneDeriveRange {
    pub start: u32,
    pub end: u32,
}

impl CloneDeriveRange {
    pub fn new(start: u32, end: u32) -> Self {
        Self {
            start,
            end,
        }
    }

    pub fn to_string(&self) -> UString {
        return UString::from(format!("{}", { let mut __s = UString::new(); __s += &(UString::from((self.start).to_string().as_str())); __s += &(UString::from("..")); __s += &(UString::from((self.end).to_string().as_str())); __s }).as_str());
    }
}

#[derive(Clone, PartialEq)]
pub struct CloneDeriveResult {
    pub range: CloneDeriveRange,
    pub label: UString,
}

impl CloneDeriveResult {
    pub fn new(range: CloneDeriveRange, label: &UStr) -> Self {
        Self {
            range,
            label: label.to_ustring(),
        }
    }

    pub fn to_string(&self) -> UString {
        return UString::from(format!("{}", { let mut __s = UString::new(); __s += &(UString::from("CloneDeriveResult(")); __s += &(UString::from("range=")); __s += UString::from(format!("{}", (self.range).clone().to_string()).as_str()).as_ustr(); __s += &(UString::from(", ")); __s += &(UString::from("label=")); __s += (self.label).to_ustring().as_ustr(); __s += &(UString::from(")")); __s }).as_str());
    }
}

#[derive(Clone)]
pub struct CloneDeriveAbstractResult {
    pub label: UString,
    pub size: u32,
}

impl CloneDeriveAbstractResult {
    pub fn new(label: &UStr, size: u32) -> Self {
        Self {
            label: label.to_ustring(),
            size,
        }
    }
}

#[derive(Clone, Copy)]
pub struct CloneDeriveGapOps;

impl CloneDeriveGapOps {
    pub fn clone_derive_gap_ops_resolve(results: &Vec<CloneDeriveResult>) -> UString {
        let r = (results[0usize]).clone();
        return UString::from(format!("{}", { let mut __s = UString::new(); __s += UString::from(format!("{}", r.range.to_string()).as_str()).as_ustr(); __s += &(UString::from(":")); __s += (r.label).to_ustring().as_ustr(); __s }).as_str());
    }

    pub fn clone_derive_gap_ops_resolve_abstract(results: &Vec<CloneDeriveAbstractResult>) -> UString {
        let r = (results[0usize]).clone();
        let label = r.label.clone();
        return UString::from(format!("{}", { let mut __s = UString::new(); __s += label.as_ustr(); __s += &(UString::from(":")); __s += &(UString::from((r.size).to_string().as_str())); __s }).as_str());
    }
}
