COORD=/home/losses/Development/tq-workspace/boring-wt-architecture
NEUTRAL=/home/losses/Development/tq-workspace/dc-warn/out/chainA-fixed-rerun/evidence/haxelib-probe-dir
echo "flake shellHook HAXELIB_PATH = ${HAXELIB_PATH:-<unset>}"
echo
probe() {
  label="$1"; cwd="$2"; shift 2
  echo "### $label (cwd=$cwd)"
  ( cd "$cwd" && "$@" haxelib path boring 2>&1 | head -2 | sed 's/^/    /' )
  echo
}
probe "A: HAXELIB_PATH=<coord>/.haxelib   [previous rerun's env]" "$ROOT" env HAXELIB_PATH="$COORD/.haxelib"
probe "B: HAXELIB_PATH=<ROOT>/.haxelib    [this run's env]" "$ROOT" env HAXELIB_PATH="$ROOT/.haxelib"
probe "C: HAXELIB_PATH unset               [flake hook not overridden, but hook value inherited]" "$ROOT" env -u HAXELIB_PATH
probe "D: cwd=NEUTRAL, HAXELIB_PATH=<ROOT>/.haxelib" "$NEUTRAL" env HAXELIB_PATH="$ROOT/.haxelib"
probe "E: cwd=NEUTRAL, HAXELIB_PATH=<coord>/.haxelib" "$NEUTRAL" env HAXELIB_PATH="$COORD/.haxelib"
