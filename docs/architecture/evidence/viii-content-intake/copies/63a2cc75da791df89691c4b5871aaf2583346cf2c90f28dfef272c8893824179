#![cfg(test)]

use crate::boring::nullable_call_ops2::NullableCallOps2;
use crate::boring::nullable_call_ops::NullableCallOps;
use crate::boring::nullable_receiver::NullableReceiver;
use crate::runtime::test as testlib;
use crate::runtime::test_core;
use crate::runtime::u_string::UStr;


#[test]
fn test_nullable_to_string_result() {
    testlib::run("tests.NullableCallTests.testNullableToStringResult", "tests.NullableCallTests.testNullableToStringResult: nullable toString result", || {
        test_core::TestCore::test_core_equals_string(UStr::new(&[112,114,101,115,101,110,116]), NullableCallOps::nullable_call_ops_nullable_to_string_result(Some(NullableReceiver::new())).as_ustr(), UStr::new(&[]));
    });
}

#[test]
fn test_normalized_to_string_result() {
    testlib::run("tests.NullableCallTests.testNormalizedToStringResult", "tests.NullableCallTests.testNormalizedToStringResult: normalized local toString result", || {
        test_core::TestCore::test_core_equals_string(UStr::new(&[112,114,101,115,101,110,116]), NullableCallOps2::nullable_call_ops2_normalized_to_string_result(Some(NullableReceiver::new())).as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[112,114,101,115,101,110,116]), NullableCallOps2::nullable_call_ops2_normalized_to_string_result(None).as_ustr(), UStr::new(&[]));
    });
}

