package boring

import std.UStringException

object StringBufOps {
    fun buildEmpty(): String {
        val buf = StringBuilder()
        val tail = buf.lastOrNull()?.code ?: -1
        if (tail >= 55296 && tail <= 56319) {
            throw UStringException.UnpairedSurrogate(tail)
        }
        return buf.toString()
    }

    fun buildParts(a: String, b: String, c: String): String {
        val buf = StringBuilder()
        val tail2 = buf.lastOrNull()?.code ?: -1
        if (tail2 >= 55296 && tail2 <= 56319 && a.length > 0 && !(a[0].code >= 56320 && a[0].code <= 57343)) {
            throw UStringException.UnpairedSurrogate(tail2)
        }
        buf.append(a)
        val tail3 = buf.lastOrNull()?.code ?: -1
        if (tail3 >= 55296 && tail3 <= 56319 && b.length > 0 && !(b[0].code >= 56320 && b[0].code <= 57343)) {
            throw UStringException.UnpairedSurrogate(tail3)
        }
        buf.append(b)
        val tail4 = buf.lastOrNull()?.code ?: -1
        if (tail4 >= 55296 && tail4 <= 56319 && c.length > 0 && !(c[0].code >= 56320 && c[0].code <= 57343)) {
            throw UStringException.UnpairedSurrogate(tail4)
        }
        buf.append(c)
        val tail5 = buf.lastOrNull()?.code ?: -1
        if (tail5 >= 55296 && tail5 <= 56319) {
            throw UStringException.UnpairedSurrogate(tail5)
        }
        return buf.toString()
    }

    fun buildWithChars(prefix: String, codeA: Int, codeB: Int): String {
        val buf = StringBuilder()
        val tail6 = buf.lastOrNull()?.code ?: -1
        if (tail6 >= 55296 && tail6 <= 56319 && prefix.length > 0 && !(prefix[0].code >= 56320 && prefix[0].code <= 57343)) {
            throw UStringException.UnpairedSurrogate(tail6)
        }
        buf.append(prefix)
        val tail7 = buf.lastOrNull()?.code ?: -1
        if (codeA >= 56320 && codeA <= 57343) {
            if (!(tail7 >= 55296 && tail7 <= 56319)) {
                throw UStringException.UnpairedSurrogate(codeA)
            }
        } else if (tail7 >= 55296 && tail7 <= 56319) {
            throw UStringException.UnpairedSurrogate(tail7)
        }
        buf.append((codeA).toChar())
        val tail8 = buf.lastOrNull()?.code ?: -1
        if (codeB >= 56320 && codeB <= 57343) {
            if (!(tail8 >= 55296 && tail8 <= 56319)) {
                throw UStringException.UnpairedSurrogate(codeB)
            }
        } else if (tail8 >= 55296 && tail8 <= 56319) {
            throw UStringException.UnpairedSurrogate(tail8)
        }
        buf.append((codeB).toChar())
        val tail9 = buf.lastOrNull()?.code ?: -1
        if (tail9 >= 55296 && tail9 <= 56319) {
            throw UStringException.UnpairedSurrogate(tail9)
        }
        return buf.toString()
    }

    fun measureLength(parts: MutableList<String>): Int {
        val buf = StringBuilder()
        for (i in 0 until parts.size) {
            val tail10 = buf.lastOrNull()?.code ?: -1
            if (tail10 >= 55296 && tail10 <= 56319 && (parts[i]).length > 0 && !((parts[i])[0].code >= 56320 && (parts[i])[0].code <= 57343)) {
                throw UStringException.UnpairedSurrogate(tail10)
            }
            buf.append((parts[i]))
        }
        return buf.length
    }

