    fun completePair(lead: Int, trail: Int): String {
        val buf = StringBuilder()
        val tail22 = buf.lastOrNull()?.code ?: -1
        if (lead >= 56320 && lead <= 57343) {
            if (!(tail22 >= 55296 && tail22 <= 56319)) {
                throw UStringException.UnpairedSurrogate(lead)
            }
        } else if (tail22 >= 55296 && tail22 <= 56319) {
            throw UStringException.UnpairedSurrogate(tail22)
        }
        buf.append((lead).toChar())
        val tail23 = buf.lastOrNull()?.code ?: -1
        if (trail >= 56320 && trail <= 57343) {
            if (!(tail23 >= 55296 && tail23 <= 56319)) {
                throw UStringException.UnpairedSurrogate(trail)
            }
        } else if (tail23 >= 55296 && tail23 <= 56319) {
            throw UStringException.UnpairedSurrogate(tail23)
        }
        buf.append((trail).toChar())
        val tail24 = buf.lastOrNull()?.code ?: -1
        if (tail24 >= 55296 && tail24 <= 56319) {
            throw UStringException.UnpairedSurrogate(tail24)
        }
        return buf.toString()
    }

    private fun classifyFault(fault: UStringException): Int {
        return when (fault) {
            is UStringException.InvalidCodePoint -> 1000 + fault.code
            is UStringException.UnpairedSurrogate -> 2000 + fault.unit
        }
    }

    fun caughtTrailUnit(trail: Int): Int {
        val value = try {
            val buf = StringBuilder()
            val tail25 = buf.lastOrNull()?.code ?: -1
            if (trail >= 56320 && trail <= 57343) {
                if (!(tail25 >= 55296 && tail25 <= 56319)) {
                    throw UStringException.UnpairedSurrogate(trail)
                }
            } else if (tail25 >= 55296 && tail25 <= 56319) {
                throw UStringException.UnpairedSurrogate(tail25)
            }
            buf.append((trail).toChar())
            0
        } catch (error: UStringException) {
            StringBufOps.classifyFault(error)
        }
        return value
    }

