        val tail12 = buf.lastOrNull()?.code ?: -1
        if (tail12 >= 55296 && tail12 <= 56319) {
            throw UStringException.UnpairedSurrogate(tail12)
        }
        val s1 = buf.toString()
        val tail13 = buf.lastOrNull()?.code ?: -1
        if (tail13 >= 55296 && tail13 <= 56319 && "-step2".length > 0 && !("-step2"[0].code >= 56320 && "-step2"[0].code <= 57343)) {
