#![cfg(test)]

use crate::haxe::crypto::sha256::Sha256;
use crate::runtime::test as testlib;
use crate::runtime::test_core;
use crate::runtime::u_string::UStr;
use crate::tests::sha256_test_support::Sha256TestSupport;


#[test]
fn empty() {
    testlib::run("tests.Sha256Tests.empty", "tests.Sha256Tests.empty: hashes the empty byte sequence", || {
        test_core::TestCore::test_core_equals_string(UStr::new(&[101,51,98,48,99,52,52,50,57,56,102,99,49,99,49,52,57,97,102,98,102,52,99,56,57,57,54,102,98,57,50,52,50,55,97,101,52,49,101,52,54,52,57,98,57,51,52,99,97,52,57,53,57,57,49,98,55,56,53,50,98,56,53,53]), Sha256TestSupport::sha256_test_support_digest_hex(&Sha256::sha256_make(&Sha256TestSupport::sha256_test_support_zeroes(0))).as_ustr(), UStr::new(&[]));
    });
}

#[test]
fn abc() {
    testlib::run("tests.Sha256Tests.abc", "tests.Sha256Tests.abc: hashes abc", || {
        let mut bytes = vec![0u8; 3usize];
        bytes[0usize] = 97u8;
        bytes[1usize] = 98u8;
        bytes[2usize] = 99u8;
        test_core::TestCore::test_core_equals_string(UStr::new(&[98,97,55,56,49,54,98,102,56,102,48,49,99,102,101,97,52,49,52,49,52,48,100,101,53,100,97,101,50,50,50,51,98,48,48,51,54,49,97,51,57,54,49,55,55,97,57,99,98,52,49,48,102,102,54,49,102,50,48,48,49,53,97,100]), Sha256TestSupport::sha256_test_support_digest_hex(&Sha256::sha256_make(&bytes)).as_ustr(), UStr::new(&[]));
    });
}

#[test]
fn incremental() {
    testlib::run("tests.Sha256Tests.incremental", "tests.Sha256Tests.incremental: matches one-shot and incremental blocks", || {
        let bytes = Sha256TestSupport::sha256_test_support_zeroes(64);
        let one_shot = Sha256::sha256_make(&bytes);
        let mut hash = Sha256::new();
        hash.update(&bytes[0usize..usize::try_from(0 + 17).unwrap_or(0)].to_vec());
        hash.update(&bytes[17usize..usize::try_from(17 + 23).unwrap_or(0)].to_vec());
        hash.update(&bytes[40usize..usize::try_from(40 + 24).unwrap_or(0)].to_vec());
        test_core::TestCore::test_core_equals_string(UStr::new(&[102,53,97,53,102,100,52,50,100,49,54,97,50,48,51,48,50,55,57,56,101,102,54,101,100,51,48,57,57,55,57,98,52,51,48,48,51,100,50,51,50,48,100,57,102,48,101,56,101,97,57,56,51,49,97,57,50,55,53,57,102,98,52,98]), Sha256TestSupport::sha256_test_support_digest_hex(&one_shot).as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(Sha256TestSupport::sha256_test_support_digest_hex(&one_shot).as_ustr(), Sha256TestSupport::sha256_test_support_digest_hex(&hash.digest()).as_ustr(), UStr::new(&[]));
    });
}
