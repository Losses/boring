#[derive(Clone, Copy)]
pub struct SwitchCaseScopeOps;

impl SwitchCaseScopeOps {
    pub fn switch_case_scope_ops_tone_row(kind: ToneKind, n: u32) -> u32 {
        return match kind {
            ToneKind::Yinping => 0,
            ToneKind::Yangping => {
            let row = u32::wrapping_mul(n, 2);
            row
        },
            ToneKind::Shang => {
            let row = u32::wrapping_mul(n, 3);
            row
        },
            ToneKind::Qu => {
            let row = u32::wrapping_mul(n, 4);
            row
        },
            ToneKind::Neutral => 0,
            ToneKind::Ru => {
            let row = u32::wrapping_mul(n, 5);
            row
        },
        };
    }

    pub fn switch_case_scope_ops_tone_ink(kind: ToneKind, ink_top: f32, ink_bottom: f32) -> f32 {
        return match kind {
            ToneKind::Yinping => 0.0f32,
            ToneKind::Yangping => {
            let top = ink_top;
            let bottom = ink_bottom;
            top + bottom
        },
            ToneKind::Shang => {
            let top = ink_top * 2.0f32;
            let bottom = ink_bottom * 2.0f32;
            top + bottom
        },
            ToneKind::Qu => {
            let top = ink_top * 3.0f32;
            let bottom = ink_bottom * 3.0f32;
            top + bottom
        },
            ToneKind::Neutral => 0.0f32,
            ToneKind::Ru => {
            let top = ink_top * 4.0f32;
            let bottom = ink_bottom * 4.0f32;
            top + bottom
        },
        };
    }

    pub fn switch_case_scope_ops_mixed(kind: ToneKind, n: u32) -> u32 {
        return match kind {
            ToneKind::Yinping => 1,
            ToneKind::Yangping => 2,
            ToneKind::Shang => {
            let tmp = u32::wrapping_add(n, 10);
            tmp
        },
            ToneKind::Qu => {
            let tmp = u32::wrapping_add(n, 20);
            tmp
        },
            ToneKind::Neutral => 3,
            ToneKind::Ru => {
            let tmp = u32::wrapping_add(n, 30);
            tmp
        },
        };
    }
}

#[derive(Debug, Clone, Copy, PartialEq)]
pub enum ToneKind {
    Yinping,
    Yangping,
    Shang,
    Qu,
    Neutral,
    Ru,
}

pub fn compare_tone_kind(a: &ToneKind, b: &ToneKind) -> i32 {
    if a == b { return 0; }
    fn rank(v: &ToneKind) -> i32 {
        match v {
            ToneKind::Yinping => 0,
            ToneKind::Yangping => 1,
            ToneKind::Shang => 2,
            ToneKind::Qu => 3,
            ToneKind::Neutral => 4,
            ToneKind::Ru => 5,
        }
    }
    rank(a) - rank(b)
}

impl ToneKind {
    pub fn to_string(&self) -> String {
        match self {
            ToneKind::Yinping => "Yinping".to_string(),
            ToneKind::Yangping => "Yangping".to_string(),
            ToneKind::Shang => "Shang".to_string(),
            ToneKind::Qu => "Qu".to_string(),
            ToneKind::Neutral => "Neutral".to_string(),
            ToneKind::Ru => "Ru".to_string(),
        }
    }
}
