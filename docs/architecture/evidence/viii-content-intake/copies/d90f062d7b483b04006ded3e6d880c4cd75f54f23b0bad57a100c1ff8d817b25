use crate::boring::glyph_cluster::GlyphCluster;
use crate::boring::glyph_cluster_holder::GlyphClusterHolder;


#[derive(Clone, Copy)]
pub struct GlyphClusterReader;

impl GlyphClusterReader {
    pub fn glyph_cluster_reader_ranges() -> Vec<GlyphCluster> {
        return vec![(GlyphCluster::new(3u32, 0u32, 4u32)).clone(), (GlyphCluster::new(7u32, 4u32, 8u32)).clone()];
    }

    pub fn glyph_cluster_reader_first_range(holder: GlyphClusterHolder) -> u32 {
        return holder.clusters[0usize].cluster_range;
    }

    pub fn glyph_cluster_reader_first_returned_range() -> u32 {
        let arr = GlyphClusterReader::glyph_cluster_reader_ranges();
        return arr[0usize].cluster_range;
    }

    pub fn glyph_cluster_reader_first_width(holder: GlyphClusterHolder) -> u32 {
        return (holder.clusters[0usize]).clone().get_width();
    }
}
