package boring

import kotlin.math.pow

object MathMinMaxOps {
    fun smaller(a: Float, b: Float): Float {
        return kotlin.math.min(a, b)
    }

    fun larger(a: Float, b: Float): Float {
        return kotlin.math.max(a, b)
    }

    fun smallerOfInts(a: Int, b: Int): Float {
        return kotlin.math.min((a).toFloat(), (b).toFloat())
    }

    fun largerOfInts(a: Int, b: Int): Float {
        return kotlin.math.max((a).toFloat(), (b).toFloat())
    }

    fun absValue(a: Float): Float {
        return kotlin.math.abs(a)
    }

    fun absOfInts(a: Int): Float {
        return kotlin.math.abs((a).toFloat())
    }

    fun power(a: Float, b: Float): Float {
        return (a).pow(b)
    }

    fun powerOfInts(a: Int, b: Int): Float {
        return ((a).toFloat()).pow((b).toFloat())
    }

    fun rounded(a: Float): Int {
        return Math.round(a)
    }

    fun floored(a: Float): Int {
        return (kotlin.math.floor(a)).toInt()
    }

    fun ceiled(a: Float): Int {
        return (kotlin.math.ceil(a)).toInt()
    }
}
