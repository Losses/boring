#!/usr/bin/env bash
# Outer entry of the fixed rerun: evaluate the flake on the (git) coordination worktree,
# run the in-shell preflight probes, then the exact chain invocation.
#   cwd              = boring-wt-architecture (flake source; same as the previous rerun)
#   XDG_CACHE_HOME   = /tmp/chainA-fixed2-nix-cache   (throwaway nix fetcher cache)
#   TMPDIR           = /tmp/chainA-fixed2-tmp
set -u
OUT=/home/losses/Development/tq-workspace/dc-warn/out/chainA-fixed-rerun
COORD=/home/losses/Development/tq-workspace/boring-wt-architecture
export XDG_CACHE_HOME=/tmp/chainA-fixed2-nix-cache
export TMPDIR=/tmp/chainA-fixed2-tmp
mkdir -p "$XDG_CACHE_HOME" "$TMPDIR"
cd "$COORD" || exit 64
echo "outer_start=$(date -uIs) cwd=$PWD"
export OUT
nix develop -c bash -c 'bash "$OUT/preflight3.sh" || { echo "PREFLIGHT FAILED"; exit 70; }; bash "$OUT/command3.sh"'
rc=$?
echo "OUTER_RC=$rc $(date -uIs)"
exit "$rc"
