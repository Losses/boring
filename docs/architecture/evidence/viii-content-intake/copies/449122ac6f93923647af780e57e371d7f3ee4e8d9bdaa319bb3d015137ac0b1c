package tests

import boring.runtime.test.Test
import registry.Json

class RegistryJsonTests {
@boring.test.Test
    fun roundTrip() {
        Test.run("tests.RegistryJsonTests.roundTrip", "tests.RegistryJsonTests.roundTrip: JSON preserves escaped nested values and formatting") {
                val value = Json.read("{\"text\":\"a\\n\\\"b\",\"nested\":[1,2.5,true,null]}")
                Test.equals("{\n  \"text\": \"a\\n\\\"b\",\n  \"nested\": [\n    1,\n    2.5,\n    true,\n    null\n  ]\n}\n", Json.write(value), null)
        }
    }
}
