#!/usr/bin/env python3
"""Extract unique failing-test names from a bun `test` capture.

bun prints every failure TWICE (inline during the run + trailing summary), so
counting `(fail)` lines double-counts. Dedup by test name.

Usage: extract-unique.py <capture> <out-unique.txt> [<out-context.txt>]
"""
import re
import sys


def parse(path):
    lines = open(path, encoding="utf-8", errors="replace").read().split("\n")
    first, order = {}, []
    raw = 0
    for i, line in enumerate(lines):
        m = re.match(r"^\(fail\) (.*)$", line)
        if not m:
            continue
        raw += 1
        name = re.sub(r" \[\d+(\.\d+)?ms\]$", "", m.group(1))
        if name not in first:
            first[name] = i
            order.append(name)
    return lines, first, order, raw


def main():
    cap, out_unique = sys.argv[1], sys.argv[2]
    out_ctx = sys.argv[3] if len(sys.argv) > 3 else None
    lines, first, order, raw = parse(cap)
    names = sorted(first)
    with open(out_unique, "w") as f:
        f.write("\n".join(names) + "\n")
    if out_ctx:
        with open(out_ctx, "w") as f:
            for name in names:
                i = first[name]
                blk = "\n".join(lines[max(0, i - 60):i + 3])
                kind = "TIMEOUT" if re.search(r"this test timed out after \d+ms", blk) else "ASSERT"
                f.write("=" * 100 + "\n")
                f.write("KIND: %s\nNAME: %s\n" % (kind, name))
                f.write("-" * 100 + "\n" + blk + "\n\n")
    print("%s: %d unique names from %d raw (fail) lines (expect raw == 2*unique = %d)"
          % (cap, len(names), raw, 2 * len(names)))


if __name__ == "__main__":
    main()
