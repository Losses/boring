#!/usr/bin/env bash
# Extract a per-stage verdict table, child-record summary and failure text from a
# sealed chain-A attempt.
# usage: extract-evidence.sh <attempt-dir> <evidence-out-dir> <plan-file>
set -u
ATT="$1"; EV="$2"; PLAN="$3"
mkdir -p "$EV"
STAGES=("env-guard" "identity" "driver-build" "driver-verify" "authored-tests" "test-haxe" \
        "test-kotlin" "test-intercept" "test-dart" "test-rust" "registry-compile" "lint" \
        "typecheck" "check-docs" "gen-vector" "vector-hash" "check-reflaxe")

# --- map plan lines to the harness step-<cksum> names (harness: cksum of the line) ---
python3 - "$PLAN" > "$EV/step-map.txt" <<'PY'
import subprocess, sys
i = 0
for raw in open(sys.argv[1]):
    line = raw.rstrip("\n")
    if not line or line.startswith("#") or line.startswith("require-"):
        continue
    c = subprocess.run(["cksum"], input=line.encode(), capture_output=True).stdout.split()[0].decode()
    i += 1
    print("step-%s\tplan-line-%d" % (c, i))
PY

{
echo "attempt=$ATT"
echo "utc=$(date -uIs)"
echo
echo "=== harness.log head/tail ==="
head -8 "$ATT/harness.log" 2>/dev/null
echo "..."
tail -25 "$ATT/harness.log" 2>/dev/null
echo
echo "=== per-stage wrapper rc / post-state ==="
printf '%-16s %-4s %-14s %-40s\n' "stage" "rc" "poststate-rc" "poststate summary"
for s in "${STAGES[@]}"; do
    rc=$(cat "$ATT/option-c/$s.rc" 2>/dev/null || echo "-")
    prc=$(cat "$ATT/option-c/$s.poststate-rc" 2>/dev/null || echo "-")
    summ=$(tail -1 "$ATT/option-c/$s.poststate" 2>/dev/null || echo "(not reached)")
    printf '%-16s %-4s %-14s %-40s\n' "$s" "$rc" "$prc" "$summ"
done
echo
echo "=== harness step statuses ==="
while IFS=$'\t' read -r step label; do
    st=$(cat "$ATT/stages/$step.status" 2>/dev/null || echo "MISSING")
    printf '%-22s %-14s %s\n' "$step" "$label" "$(tr '\t' ' ' < <(printf '%s' "$st"))"
done < "$EV/step-map.txt"
} > "$EV/stage-rcs.txt" 2>&1
cat "$EV/stage-rcs.txt"

# --- child records ---
python3 - "$ATT" > "$EV/child-records-summary.txt" <<'PY'
import json, os, sys, glob
att = sys.argv[1]
rows = []
for d in sorted(glob.glob(os.path.join(att, "child-evidence", "run-*", "*"))):
    rj = os.path.join(d, "record.json")
    if not os.path.isfile(rj):
        continue
    r = json.load(open(rj))
    rows.append(r)
print("child records: %d" % len(rows))
bad = [r for r in rows if r.get("exitStatus") != 0 or r.get("captureComplete") is not True or r.get("captureError")]
print("nonzero-exit / incomplete captures: %d" % len(bad))
print()
print("%-5s %-10s %-12s %-28s %-6s %-14s %-12s %-9s" % ("seq","bundle","action","step","exit","outcome","capture","stdoutB"))
for r in sorted(rows, key=lambda x: x["sequence"]):
    print("%-5s %-10s %-12s %-28s %-6s %-14s %-12s %-9s" % (
        r["sequence"], r.get("bundle"), r.get("action"), (r.get("step") or "")[:28],
        r.get("exitStatus"), r.get("outcome"), r.get("captureComplete"), r.get("stdoutBytes")))
print()
for r in sorted(rows, key=lambda x: x["sequence"]):
    if r.get("exitStatus") != 0:
        print("=== failing child %s (%s/%s %s) ===" % (r["sequence"], r.get("bundle"), r.get("action"), r.get("step")))
        print("command:", r.get("command"), r.get("argv"))
        for key in ("stdoutPath", "stderrPath"):
            p = r.get(key)
            if p and os.path.isfile(p):
                txt = open(p, "rb").read().decode("utf-8", "replace")
                print("--- %s (last 4000 bytes) ---" % os.path.basename(p))
                print(txt[-4000:])
PY
cat "$EV/child-records-summary.txt"
