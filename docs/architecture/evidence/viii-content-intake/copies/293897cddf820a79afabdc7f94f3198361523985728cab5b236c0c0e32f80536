#!/usr/bin/env bash
# Independent discriminating-power control for tools/roots-guard:
# reconstruct the PRE-FIX examples/ (HEAD e1c65975 bytes of the six hxml files)
# and the POST-FIX examples/ (coordination tree bytes), then run the guard on both.
set -u
OUT=/home/losses/Development/tq-workspace/dc-warn/out/chainA-fixed-rerun
COORD=/home/losses/Development/tq-workspace/boring-wt-architecture
D=$OUT/evidence/roots-guard-control
rm -rf "$D"; mkdir -p "$D/prefix" "$D/postfix"
cd "$COORD" || exit 64
for t in kotlin rust swift; do
    git show "e1c65975:examples/$t.hxml"      > "$D/prefix/$t.hxml"
    git show "e1c65975:examples/$t-f32.hxml"  > "$D/prefix/$t-f32.hxml"
    cp "examples/$t.hxml"      "$D/postfix/"
    cp "examples/$t-f32.hxml"  "$D/postfix/"
done
{
echo "control inputs: $D"
echo "prefix  = git show e1c65975:examples/{kotlin,rust,swift}[-f32].hxml"
echo "postfix = coordination tree examples/{kotlin,rust,swift}[-f32].hxml"
echo
echo "=== guard on PRE-FIX (expect rc=1: f32 roots missing) ==="
bash tools/roots-guard/check-roots-guard.sh "$D/prefix"
echo "guard rc=$?"
echo
echo "=== guard on POST-FIX (expect rc=0) ==="
bash tools/roots-guard/check-roots-guard.sh "$D/postfix"
echo "guard rc=$?"
} 2>&1 | tee "$OUT/evidence/roots-guard-control.txt"
