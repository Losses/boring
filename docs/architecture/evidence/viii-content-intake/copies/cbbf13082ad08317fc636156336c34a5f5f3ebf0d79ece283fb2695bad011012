use crate::runtime::u_string::UStr;
use crate::runtime::u_string::UString;


#[derive(Debug, Clone, PartialEq)]
pub enum E2Fault {
    Two { tag: UString },
}

impl std::fmt::Display for E2Fault {
    fn fmt(&self, formatter: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        match self {
            E2Fault::Two { tag } => {
                write!(formatter, "{}", tag)
            }
        }
    }
}

impl std::error::Error for E2Fault {}

#[derive(Debug, Clone, PartialEq)]
pub enum E1Fault {
    One { tag: UString },
    E1Fault(Box<crate::pkrev::payload_key_probe::E1>),
}

impl std::fmt::Display for E1Fault {
    fn fmt(&self, formatter: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        match self {
            E1Fault::One { tag } => {
                write!(formatter, "{}", tag)
            }
            E1Fault::E1Fault(inner) => write!(formatter, "{:?}", inner),
        }
    }
}

impl std::error::Error for E1Fault {}

#[derive(Debug, Clone, PartialEq)]
pub struct E1 {
    pub fault: E1Fault,
}
impl E1 {
    pub fn new(fault: E1Fault) -> Self {
        E1 { fault }
    }
}
impl std::fmt::Display for E1 {
    fn fmt(&self, formatter: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        write!(formatter, "{}", self.fault)
    }
}

