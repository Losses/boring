package mx;

import std.ReadOnlyArray;
import mx.MXSupport.QError;

/**
	Decisive probe for the blockExpression destination question.
	An inline helper (features/43 expression block) whose value is Array<Int>
	reaches four different destinations. The question is whether the block's
	own `currentReturnType` conversion is load-bearing at any of them.
**/
class MXBlockRet {
	inline static function two(a:Array<Int>):Array<Int> {
		final s = a.length;
		return a.slice(s, 0);
	}

	static function viewLen(a:ReadOnlyArray<Int>):Int
		return a.length;

	// 1. return position, member return type IS the read-only boundary
	public static function rRetView():ReadOnlyArray<Int> {
		final h = [1, 2, 3];
		return two(h);
	}

	// 2. initializer position, declared read-only destination
	public static function rInitView():Int {
		final h = [1, 2, 3];
		final v:ReadOnlyArray<Int> = two(h);
		return v.length;
	}

	// 3. call argument position, read-only parameter
	public static function rArgView():Int {
		final h = [1, 2, 3];
		return viewLen(two(h));
	}

	// 4. return position, member return type is NOT read-only
	public static function rRetPlain():Array<Int> {
		final h = [1, 2, 3];
		return two(h);
	}

	// 5. argument position of a plain Array parameter
	public static function rArgPlain():Int {
		final h = [1, 2, 3];
		return plainLen(two(h));
	}

	static function plainLen(a:Array<Int>):Int
		return a.length;

	// 6. THE decisive case: block in an argument of a READ-ONLY parameter while
	//    the enclosing member itself returns a read-only array. currentReturnType
	//    is read-only, so the old blockExpression read wraps the block value; the
	//    call-argument site independently wraps the whole IIFE. Only the outer
	//    wrap is correct.
	public static function rArgViewUnderViewReturn():ReadOnlyArray<Int> {
		final h = [1, 2, 3];
		final n = viewLen(two(h));
		if (n < 0) {
			throw new QError();
		}
		final out:ReadOnlyArray<Int> = h;
		return out;
	}
}
