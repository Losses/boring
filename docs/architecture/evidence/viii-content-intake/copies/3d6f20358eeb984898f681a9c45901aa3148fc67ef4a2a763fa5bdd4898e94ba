#![cfg(test)]

use crate::boring::fp_helper_rust_ops::FPHelperRustOps;
use crate::runtime::fp_helper::FPHelper;
use crate::runtime::test as testlib;
use crate::runtime::test_core;
use crate::runtime::u_string::UStr;


#[test]
fn value_of() {
    testlib::run("tests.FPHelperRustTests.valueOf", "tests.FPHelperRustTests.valueOf: an FPHelper bit edge reinterprets a u32 Int argument", || {
        test_core::TestCore::test_core_equals_int(42i32, i32::from_ne_bytes(((FPHelper::float_to_i32(FPHelperRustOps::fp_helper_rust_ops_value_of(42))) as i32).to_ne_bytes()), UStr::new(&[]));
    });
}

#[test]
fn decompose() {
    testlib::run("tests.FPHelperRustTests.decompose", "tests.FPHelperRustTests.decompose: floatToI32 reads stay signed through u32 struct fields", || {
        test_core::TestCore::test_core_equals_int(8388608i32, i32::from_ne_bytes(((FPHelperRustOps::fp_helper_rust_ops_decompose(1.0f64).mant24) as i32).to_ne_bytes()), UStr::new(&[]));
        test_core::TestCore::test_core_equals_int(-23i32, i32::from_ne_bytes(((FPHelperRustOps::fp_helper_rust_ops_decompose(1.0f64).exp2) as i32).to_ne_bytes()), UStr::new(&[]));
        test_core::TestCore::test_core_equals_int(8388608i32, i32::from_ne_bytes(((FPHelperRustOps::fp_helper_rust_ops_decompose(8388608.0f64).mant24) as i32).to_ne_bytes()), UStr::new(&[]));
        test_core::TestCore::test_core_equals_int(0i32, i32::from_ne_bytes(((FPHelperRustOps::fp_helper_rust_ops_decompose(8388608.0f64).exp2) as i32).to_ne_bytes()), UStr::new(&[]));
    });
}
