#!/usr/bin/env bash
# Boundary-fixture generation/build across states.
# usage: bash bx-all.sh <state: pristine|postfix|negctl> <mode: gen|build>
set -uo pipefail
WT=/home/losses/Development/tq-workspace/dc-warn/worktrees/rust-trytail-xcheck
SRC=$WT/packages/compiler/reflaxe/rust/rustcompiler
STATE="$1"; MODE="$2"
export XDG_CACHE_HOME=/tmp/rt-xcheck-nix-cache
cd "$WT"
case "$STATE" in
pristine) cp /tmp/rt-xcheck/src-pristine/*.hx "$SRC/" ;;
postfix) cp /tmp/rt-xcheck/src-postfix/*.hx "$SRC/" ;;
negctl)
	cp /tmp/rt-xcheck/src-postfix/*.hx "$SRC/"
	python3 - "$SRC/Compiler.hx" <<'PY'
import sys
p = sys.argv[1]
s = open(p).read()
call = "                                            registerThrownExceptionVariant(stripDecorations(t));\n"
assert s.count(call) == 1, "registration call not found exactly once"
open(p, "w").write(s.replace(call, "                                            // NEGCTL: registration call reverted\n"))
PY
	;;
*) echo "unknown state"; exit 9 ;;
esac
BASE=/tmp/rt-xcheck/bx-$STATE
mkdir -p "$BASE"
: >"$BASE/status.tsv"
for k in xs-scope xs-twoexc xs-growth xs-xmod xs-generic; do
	rm -rf "$BASE/$k"
	timeout 600 nix develop -c haxe "tests/haxe/$k/gen/rust.hxml" -D rust-output="$BASE/$k" >"$BASE/$k.gen.stdout" 2>"$BASE/$k.gen.stderr"
	gs=$?
	printf '%s\tgen\t%s\n' "$k" "$gs" >>"$BASE/status.tsv"
	printf '[%s/%s] %s gen=%s\n' "$STATE" "$MODE" "$k" "$gs"
	[ "$MODE" = "build" ] || continue
	[ "$gs" -eq 0 ] || { printf '%s\tbuild\tnot-reached\n' "$k" >>"$BASE/status.tsv"; continue; }
	CARGO_TARGET_DIR=/tmp/rt-xcheck/bxtgt-$STATE timeout 1800 nix develop -c bash -c "cd '$BASE/$k' && cargo build --offline" >"$BASE/$k.cargo.stdout" 2>"$BASE/$k.cargo.stderr"
	cs=$?
	printf '%s\tbuild\t%s\n' "$k" "$cs" >>"$BASE/status.tsv"
	printf '[%s/%s] %s build=%s\n' "$STATE" "$MODE" "$k" "$cs"
done
