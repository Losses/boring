package tests

import boring.MathNaNOps
import boring.MathNaNTestSupport
import boring.runtime.test.Test

class MathNaNOpsTests {
@boring.test.Test
    fun minValues() {
        Test.run("tests.MathNaNOpsTests.minValues", "tests.MathNaNOpsTests.minValues: Math.min propagates NaN and handles finite and infinity edges") {
                MathNaNTestSupport.assertNaN(MathNaNOps.minOf(Double.NaN, 2.0), "min NaN, finite")
                MathNaNTestSupport.assertNaN(MathNaNOps.minOf(2.0, Double.NaN), "min finite, NaN")
                MathNaNTestSupport.assertNaN(MathNaNOps.minOf(Double.NaN, Double.NaN), "min NaN, NaN")
                Test.equals(-3.0, MathNaNOps.minOf(-3.0, 4.0), null)
                Test.equals(-3.0, MathNaNOps.minOf(4.0, -3.0), null)
                Test.equals(2.0, MathNaNOps.minOf(2.0, Double.POSITIVE_INFINITY), null)
                Test.equals(2.0, MathNaNOps.minOf(Double.POSITIVE_INFINITY, 2.0), null)
                Test.equals(Double.NEGATIVE_INFINITY, MathNaNOps.minOf(Double.NEGATIVE_INFINITY, 2.0), null)
                Test.equals(Double.NEGATIVE_INFINITY, MathNaNOps.minOf(2.0, Double.NEGATIVE_INFINITY), null)
                Test.equals(Double.NEGATIVE_INFINITY, MathNaNOps.minOf(Double.POSITIVE_INFINITY, Double.NEGATIVE_INFINITY), null)
                Test.equals(Double.NEGATIVE_INFINITY, MathNaNOps.minOf(Double.NEGATIVE_INFINITY, Double.POSITIVE_INFINITY), null)
                MathNaNTestSupport.assertNaN(MathNaNOps.minOf(Double.NaN, Double.POSITIVE_INFINITY), "min NaN, infinity")
                MathNaNTestSupport.assertNaN(MathNaNOps.minOf(Double.POSITIVE_INFINITY, Double.NaN), "min infinity, NaN")
                MathNaNTestSupport.assertNegativeZero(MathNaNOps.minOf(-0.0, 0.0), "min -0, +0")
                MathNaNTestSupport.assertNegativeZero(MathNaNOps.minOf(0.0, -0.0), "min +0, -0")
                Test.equals(Double.NEGATIVE_INFINITY, MathNaNOps.minOf(-0.0, Double.NEGATIVE_INFINITY), null)
                Test.equals(Double.NEGATIVE_INFINITY, MathNaNOps.minOf(Double.NEGATIVE_INFINITY, -0.0), null)
                Test.equals(Double.NEGATIVE_INFINITY, MathNaNOps.minOf(0.0, Double.NEGATIVE_INFINITY), null)
                Test.equals(Double.NEGATIVE_INFINITY, MathNaNOps.minOf(Double.NEGATIVE_INFINITY, 0.0), null)
                MathNaNTestSupport.assertNegativeZero(MathNaNOps.minOf(-0.0, Double.POSITIVE_INFINITY), "min -0, +infinity")
                MathNaNTestSupport.assertNegativeZero(MathNaNOps.minOf(Double.POSITIVE_INFINITY, -0.0), "min +infinity, -0")
                MathNaNTestSupport.assertPositiveZero(MathNaNOps.minOf(0.0, Double.POSITIVE_INFINITY), "min +0, +infinity")
                MathNaNTestSupport.assertPositiveZero(MathNaNOps.minOf(Double.POSITIVE_INFINITY, 0.0), "min +infinity, +0")
                Test.equals(4.0, MathNaNOps.minInts(4, 9), "min widens Int operands")
        }
    }

@boring.test.Test
    fun maxValues() {
        Test.run("tests.MathNaNOpsTests.maxValues", "tests.MathNaNOpsTests.maxValues: Math.max propagates NaN and handles finite and infinity edges") {
                MathNaNTestSupport.assertNaN(MathNaNOps.maxOf(Double.NaN, 2.0), "max NaN, finite")
                MathNaNTestSupport.assertNaN(MathNaNOps.maxOf(2.0, Double.NaN), "max finite, NaN")
                MathNaNTestSupport.assertNaN(MathNaNOps.maxOf(Double.NaN, Double.NaN), "max NaN, NaN")
                Test.equals(4.0, MathNaNOps.maxOf(-3.0, 4.0), null)
                Test.equals(4.0, MathNaNOps.maxOf(4.0, -3.0), null)
                Test.equals(Double.POSITIVE_INFINITY, MathNaNOps.maxOf(2.0, Double.POSITIVE_INFINITY), null)
                Test.equals(Double.POSITIVE_INFINITY, MathNaNOps.maxOf(Double.POSITIVE_INFINITY, 2.0), null)
                Test.equals(2.0, MathNaNOps.maxOf(Double.NEGATIVE_INFINITY, 2.0), null)
                Test.equals(2.0, MathNaNOps.maxOf(2.0, Double.NEGATIVE_INFINITY), null)
                Test.equals(Double.POSITIVE_INFINITY, MathNaNOps.maxOf(Double.POSITIVE_INFINITY, Double.NEGATIVE_INFINITY), null)
                Test.equals(Double.POSITIVE_INFINITY, MathNaNOps.maxOf(Double.NEGATIVE_INFINITY, Double.POSITIVE_INFINITY), null)
                MathNaNTestSupport.assertNaN(MathNaNOps.maxOf(Double.NaN, Double.NEGATIVE_INFINITY), "max NaN, infinity")
                MathNaNTestSupport.assertNaN(MathNaNOps.maxOf(Double.NEGATIVE_INFINITY, Double.NaN), "max infinity, NaN")
                MathNaNTestSupport.assertPositiveZero(MathNaNOps.maxOf(-0.0, 0.0), "max -0, +0")
                MathNaNTestSupport.assertPositiveZero(MathNaNOps.maxOf(0.0, -0.0), "max +0, -0")
                Test.equals(Double.POSITIVE_INFINITY, MathNaNOps.maxOf(-0.0, Double.POSITIVE_INFINITY), null)
                Test.equals(Double.POSITIVE_INFINITY, MathNaNOps.maxOf(Double.POSITIVE_INFINITY, -0.0), null)
                Test.equals(Double.POSITIVE_INFINITY, MathNaNOps.maxOf(0.0, Double.POSITIVE_INFINITY), null)
                Test.equals(Double.POSITIVE_INFINITY, MathNaNOps.maxOf(Double.POSITIVE_INFINITY, 0.0), null)
                MathNaNTestSupport.assertNegativeZero(MathNaNOps.maxOf(-0.0, Double.NEGATIVE_INFINITY), "max -0, -infinity")
                MathNaNTestSupport.assertNegativeZero(MathNaNOps.maxOf(Double.NEGATIVE_INFINITY, -0.0), "max -infinity, -0")
                MathNaNTestSupport.assertPositiveZero(MathNaNOps.maxOf(0.0, Double.NEGATIVE_INFINITY), "max +0, -infinity")
                MathNaNTestSupport.assertPositiveZero(MathNaNOps.maxOf(Double.NEGATIVE_INFINITY, 0.0), "max -infinity, +0")
                Test.equals(9.0, MathNaNOps.maxInts(4, 9), "max widens Int operands")
        }
    }

@boring.test.Test
    fun foldedConstantEdges() {
        Test.run("tests.MathNaNOpsTests.foldedConstantEdges", "tests.MathNaNOpsTests.foldedConstantEdges: literal constant edges keep NaN, both infinities, and the f32 flush values") {
                MathNaNTestSupport.assertNaN(MathNaNOps.constantNan(), "0.0 / 0.0 is NaN")
                Test.equals(Double.POSITIVE_INFINITY, MathNaNOps.constantPosInf(), "1.0 / 0.0 is +infinity")
                Test.equals(Double.NEGATIVE_INFINITY, MathNaNOps.constantNegInf(), "-1.0 / 0.0 is -infinity")
                Test.equals(true, MathNaNOps.constantOverflow() > 3e38, "1e300 exceeds the binary32 range")
                Test.equals(true, MathNaNOps.constantUnderflow() >= 0.0, "1e-300 never goes negative")
                Test.equals(true, MathNaNOps.constantUnderflow() < 1e-38, "1e-300 stays below the binary32 normal range")
        }
    }
}
