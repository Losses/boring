#![cfg(test)]

use crate::boring::record_ops::RecordOps;
use crate::runtime::test as testlib;
use crate::runtime::test_core;
use crate::runtime::u_string::UStr;


#[test]
fn test_zero_override() {
    testlib::run("tests.RecordTests.testZeroOverride", "tests.RecordTests.testZeroOverride: zero override returns record with all original fields", || {
        let orig = RecordOps::record_ops_make_item(1, UStr::new(&[97,108,112,104,97]), 100, true);
        let copy = RecordOps::record_ops_copy_no_override((orig).clone());
        test_core::TestCore::test_core_equals_int(1i32, i32::from_ne_bytes(((copy.id) as i32).to_ne_bytes()), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[97,108,112,104,97]), (copy.name).to_ustring().as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_int(100i32, i32::from_ne_bytes(((copy.score) as i32).to_ne_bytes()), UStr::new(&[]));
        test_core::TestCore::test_core_equals_bool(true, copy.active, UStr::new(&[]));
    });
}

#[test]
fn test_single_override() {
    testlib::run("tests.RecordTests.testSingleOverride", "tests.RecordTests.testSingleOverride: single override replaces only targeted field", || {
        let orig = RecordOps::record_ops_make_item(2, UStr::new(&[98,101,116,97]), 80, false);
        let copy = RecordOps::record_ops_copy_single_override((orig).clone(), 99);
        test_core::TestCore::test_core_equals_int(2i32, i32::from_ne_bytes(((copy.id) as i32).to_ne_bytes()), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[98,101,116,97]), (copy.name).to_ustring().as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_int(99i32, i32::from_ne_bytes(((copy.score) as i32).to_ne_bytes()), UStr::new(&[]));
        test_core::TestCore::test_core_equals_bool(false, copy.active, UStr::new(&[]));
    });
}

#[test]
fn test_reordered_overrides() {
    testlib::run("tests.RecordTests.testReorderedOverrides", "tests.RecordTests.testReorderedOverrides: reordered overrides apply in declaration order and preserve untouched fields", || {
        let orig = RecordOps::record_ops_make_item(3, UStr::new(&[103,97,109,109,97]), 50, false);
        let copy = RecordOps::record_ops_copy_reordered((orig).clone(), true, UStr::new(&[103,97,109,109,97,95,117,112,100,97,116,101,100]));
        test_core::TestCore::test_core_equals_int(3i32, i32::from_ne_bytes(((copy.id) as i32).to_ne_bytes()), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[103,97,109,109,97,95,117,112,100,97,116,101,100]), (copy.name).to_ustring().as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_int(50i32, i32::from_ne_bytes(((copy.score) as i32).to_ne_bytes()), UStr::new(&[]));
        test_core::TestCore::test_core_equals_bool(true, copy.active, UStr::new(&[]));
    });
}

#[test]
fn test_multiple_overrides() {
    testlib::run("tests.RecordTests.testMultipleOverrides", "tests.RecordTests.testMultipleOverrides: multiple overrides replace all specified fields", || {
        let orig = RecordOps::record_ops_make_item(4, UStr::new(&[100,101,108,116,97]), 20, false);
        let copy = RecordOps::record_ops_copy_multiple((orig).clone(), 10, UStr::new(&[100,101,108,116,97,95,97,108,108]), 999);
        test_core::TestCore::test_core_equals_int(10i32, i32::from_ne_bytes(((copy.id) as i32).to_ne_bytes()), UStr::new(&[]));
        test_core::TestCore::test_core_equals_string(UStr::new(&[100,101,108,116,97,95,97,108,108]), (copy.name).to_ustring().as_ustr(), UStr::new(&[]));
        test_core::TestCore::test_core_equals_int(999i32, i32::from_ne_bytes(((copy.score) as i32).to_ne_bytes()), UStr::new(&[]));
        test_core::TestCore::test_core_equals_bool(false, copy.active, UStr::new(&[]));
    });
}
