#!/usr/bin/env bash
# Reproduce the option-c harness stages 2 (driver-build), 3 (driver-verify) and
# 4 (authored-tests = `bun run test`) inside a given execution root, with the
# environment taken verbatim from the successful harness run's evidence/env.json.
# Usage: run-tree.sh <ABS-ROOT> <LABEL>
set -u
ROOT="${1:?root}"
LABEL="${2:?label}"
ENVJSON=/home/losses/Development/tq-workspace/dc-warn/out/chainA-fixed-rerun/evidence/env.json
OUTDIR="$ROOT/out/attribution-$LABEL"
mkdir -p "$OUTDIR"
get() { sed -n "s|^$1=||p" "$ENVJSON" | head -1; }

export PATH="$(get PATH)"
export HAXELIB_PATH="$ROOT/.haxelib"
export XDG_CACHE_HOME="$ROOT/out/xdg-cache"
export GIT_CEILING_DIRECTORIES="$ROOT"
export BORING_SWIFT_SYSTEM_PACKAGE="$(get BORING_SWIFT_SYSTEM_PACKAGE)"
export BORING_SWIFT_LIBDISPATCH="$(get BORING_SWIFT_LIBDISPATCH)"
export BORING_SWIFT_DYNAMIC_LINKER="$(get BORING_SWIFT_DYNAMIC_LINKER)"
export SWIFT_SHIM_STATE="$(get SWIFT_SHIM_STATE)"
unset LD_LIBRARY_PATH HAXE_STD_PATH
mkdir -p "$XDG_CACHE_HOME"
export TMPDIR="$OUTDIR/tmpdir"
mkdir -p "$TMPDIR"
cd "$ROOT" || exit 90

log() { printf '%s\n' "$*" >>"$OUTDIR/run.log"; printf '%s\n' "$*"; }

stage() {
	name="$1"; shift
	log "=== stage $name START utc=$(date -uIs) ==="
	log "uptime-before: $(uptime)"
	( "$@" ) >"$OUTDIR/$name.stdout" 2>"$OUTDIR/$name.stderr"
	rc=$?
	printf '%s\n' "$rc" >"$OUTDIR/$name.rc"
	log "=== stage $name END utc=$(date -uIs) rc=$rc ==="
	log "uptime-after: $(uptime)"
	return $rc
}

log "run START utc=$(date -uIs) label=$LABEL"
log "ROOT=$ROOT"
log "ENVJSON=$ENVJSON"
log "HAXELIB_PATH=$HAXELIB_PATH XDG_CACHE_HOME=$XDG_CACHE_HOME TMPDIR=$TMPDIR"
log "SWIFT_SHIM_STATE=$SWIFT_SHIM_STATE BORING_SWIFT_SYSTEM_PACKAGE=$BORING_SWIFT_SYSTEM_PACKAGE"
log "toolchain: haxe=$(command -v haxe) bun=$(command -v bun) rustc=$(command -v rustc) kotlinc=$(command -v kotlinc) dart=$(command -v dart) swiftc=$(command -v swiftc)"
log "uptime: $(uptime)"
log "concurrent bun-test windows seen at start: $(ps -eo args | grep -c '^bun test tests/ packages/registry/tests/')"

stage driver-build haxe tools/bundle/driver.hxml
stage driver-verify bun out/bundle/driver.js verify
stage authored-tests bun run test

log "run END utc=$(date -uIs)"
log "uptime: $(uptime)"
