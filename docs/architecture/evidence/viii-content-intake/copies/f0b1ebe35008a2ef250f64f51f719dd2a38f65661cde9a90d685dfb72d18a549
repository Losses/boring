#!/usr/bin/env bash
# Phase B: measure each failing test's real cost under a generous 900s budget.
# Sequential, single-file scoped, -t name filter. No pipes around exit codes.
set -u
EV=/home/losses/Development/tq-workspace/dc-warn/out/timeout-budget-fix/evidence
REPO=/home/losses/Development/tq-workspace/boring-wt-architecture
export PATH="$(grep -m1 '^PATH=' /home/losses/Development/tq-workspace/dc-warn/out/chainA-fixed-rerun/evidence/env.json | cut -d= -f2-)"
cd "$REPO"

m() { # m <label> <file> <testname-regex>
  local label=$1 file=$2 name=$3
  echo "pre-guard=$(grep -c 'Test.equals' samples/boring/MathNaNTestSupport.hx) start=$(date -u +%FT%TZ)" > "$EV/$label.rc"
  bun test "$file" -t "$name" --timeout 900000 > "$EV/$label.log" 2>&1
  local rc=$?
  echo "post-guard=$(grep -c 'Test.equals' samples/boring/MathNaNTestSupport.hx) end=$(date -u +%FT%TZ) rc=$rc" >> "$EV/$label.rc"
  echo "[$label] rc=$rc"
}

m B-dart-precision    tests/dart/precision-switch.test.ts            "float-precision=f32 aborts the Dart compile with the startup error"
m B-ts-precision      tests/ts/precision-switch.test.ts              "float-precision=f32 aborts the TS compile with the startup error"
m B-strict-output     tests/ts/strict-output.test.ts                 "strict TypeScript emitter output"
m B-enum-sorted       tests/ts/enum-sorted-keys.test.ts              "payload enums are rejected as sorted keys"
m B-array-root        tests/ts/array-root.test.ts                    "small array initializer mutation rules retain all three diagnostics"
m B-constructed       tests/ts/constructed-state.test.ts             "constructed static mutation rules retain all three diagnostics"
m B-rust-packages     tests/ts/rust-packages.test.ts                 "Rust emits one module layer per Haxe package segment"
m B-rust-bytes        tests/ts/rust-bytes-ownership.test.ts          "Rust borrows input Bytes fields and owns allocated Bytes fields"
m B-sealed-sealed     tests/ts/sealed-variants.test.ts               "@:sealed on a class reports the interface-only error"
m B-sealed-selfcon    tests/ts/sealed-variants.test.ts               "self-construction with arguments keeps the static initializer error"
m B-sealed-lanes      tests/ts/sealed-variants.test.ts               "the sanctioned self-construction static uses each target lane"
m B-extern            tests/ts/extern-bindings.test.ts               "TypeScript extern binding modules"
m B-stringtools       tests/ts/stringtools-conv.test.ts              "negative hex arguments report the named domain error"
m B-deferred          tests/ts/deferred-locals.test.ts               "a missing deferred assignment is rejected by the Kotlin tree build"
m B-fn-values         tests/ts/fn-values.test.ts                     "a capturing static initializer reports the ruled Rust error"
m B-static-state      tests/ts/static-state.test.ts                  "static initializer mutation is rejected with the sanctioned error"
m B-pkg-artifacts     tests/ts/package-artifacts.test.ts             "the cargo crate and the Pub archive keep the tree at the root"
m B-readonly          tests/swift-readonly-boundary/readonly-boundary.test.ts "Swift read-only array boundary shares storage and preserves flow"
m B-printed-record    tests/ts/printed-record.test.ts                "marker and explicit-member mutations affect the four emitted members"
m B-value-type        tests/ts/value-type.test.ts                    "rejects each invalid marker shape with the ruled error on every target"
m B-std-string        tests/ts/std-string.test.ts                    "nullable operands are rejected on every target"
m B-pkg-shell-byn     tests/ts/package-shell.test.ts                 "a by-name runtime import with an emitted manifest aborts the compile"
echo "PHASE-B-DONE"
