package tests

import boring.SumOfFloatLocalOps
import boring.runtime.test.Test

class SumOfFloatLocalTests {
@boring.test.Test
    fun testTotal() {
        Test.run("tests.SumOfFloatLocalTests.testTotal", "tests.SumOfFloatLocalTests.testTotal: sumOfFloat in a local function keeps the Float accumulator") {
                Test.equals(6.0f, SumOfFloatLocalOps.total(mutableListOf<Float>(1.5f, 2.0f, 2.5f)), null)
                Test.equals(7.25f, SumOfFloatLocalOps.total(mutableListOf<Float>(1.5f, 2.5f, 3.25f)), null)
                Test.equals(0.0f, SumOfFloatLocalOps.total(mutableListOf<Float>()), null)
        }
    }

@boring.test.Test
    fun testWeighted() {
        Test.run("tests.SumOfFloatLocalTests.testWeighted", "tests.SumOfFloatLocalTests.testWeighted: a weighted sumOfFloat in a local function scales the accumulator") {
                Test.equals(12.0f, SumOfFloatLocalOps.weighted(mutableListOf<Float>(1.5f, 2.0f, 2.5f), 2.0f), null)
                Test.equals(14.5f, SumOfFloatLocalOps.weighted(mutableListOf<Float>(1.5f, 2.5f, 3.25f), 2.0f), null)
        }
    }
}
