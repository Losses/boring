use crate::runtime::u_string;
use crate::runtime::u_string::UStr;
use crate::runtime::u_string::UString;


#[derive(Clone, Copy)]
pub struct BorrowedStringReturnOps;

impl BorrowedStringReturnOps {
    pub fn borrowed_string_return_ops_require_text(value: &UStr) -> Result<UString, BorrowedStringReturnFault> {
        if u_string::unit_count(&(value)) == 0 {
            return Err(BorrowedStringReturnFault::new("blank"));
        }
        return Ok((value).to_ustring());
    }
}

#[derive(Debug, Clone, PartialEq)]
pub struct BorrowedStringReturnFault {
    pub message: String,
}
impl BorrowedStringReturnFault {
    pub fn new(message: &str) -> Self {
        Self { message: message.to_string() }
    }
}
impl std::fmt::Display for BorrowedStringReturnFault {
    fn fmt(&self, formatter: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        write!(formatter, "{}", self.message)
    }
}
impl std::error::Error for BorrowedStringReturnFault {}
