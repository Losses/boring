use crate::runtime::u_string::UString;


#[derive(Clone, PartialEq)]
pub struct KnullInitNarrowing {
}

impl KnullInitNarrowing {
    pub const fn new() -> Self {
        Self {
        }
    }

    pub fn field_off_nullable_receiver(&self, nested: Option<Nested>) -> u32 {
        let bound = (nested).clone();
        return bound.as_ref().unwrap().value;
    }

    pub fn ternary_with_nullable_arm(&self, flag: bool, fallback: Option<Nested>) -> u32 {
        let bound = if flag { Some(Nested::new(1u32)) } else { fallback };
        return bound.as_ref().unwrap().value;
    }

    pub fn chained_field_access(&self, nested: Option<Nested>) -> UString {
        let bound = (nested).clone();
        return ((bound.as_ref().unwrap().name).to_ustring()).clone();
    }
}

#[derive(Clone, PartialEq)]
pub struct Nested {
    pub value: u32,
    pub name: UString,
}

impl Nested {
    pub fn new(value: u32) -> Self {
        Self {
            value,
            name: { let mut __s = UString::new(); __s += &(UString::from("v")); __s += UString::from((value).to_string().as_str()).as_ustr(); __s },
        }
    }
}
