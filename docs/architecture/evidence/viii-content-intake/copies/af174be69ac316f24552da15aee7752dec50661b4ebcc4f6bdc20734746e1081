#!/usr/bin/env bash
# Stage 4: compile-relevant divergences the hardened guard still cannot see,
#          the undocumented allowlist override, and honest-negative checks.
set -u
. "$(dirname "$0")/xlib.sh"

root_del() { python3 - "$1" "$2" <<'PY'
import sys
p, mod = sys.argv[1], sys.argv[2]
lines = open(p, encoding="utf-8").read().split("\n")
open(p, "w", encoding="utf-8").write("\n".join(l for l in lines if l.strip() != mod))
PY
}
alw_add() { python3 - "$@" <<'PY'
import json, sys
p, section, target, mod, reason = sys.argv[1:6]
d = json.load(open(p, encoding="utf-8"))
d.setdefault(section, []).append({"target": target, "module": mod, "reason": reason})
json.dump(d, open(p, "w", encoding="utf-8"), indent=2)
PY
}

echo "########## root deleted from BOTH files, module has no @:test ##########"
new_case new-both-deleted-nontest hard
root_del "$CASE/examples/kotlin.hxml" boring.BytesOps
root_del "$CASE/examples/kotlin-f32.hxml" boring.BytesOps
run_case new-both-deleted-nontest

echo "########## -cp divergence: f32 loses the classpath that holds its own roots ##########"
new_case new-cp-removed hard
python3 - "$CASE/examples/swift-f32.hxml" <<'PY'
import sys
p = sys.argv[1]
lines = open(p, encoding="utf-8").read().split("\n")
open(p, "w", encoding="utf-8").write("\n".join(l for l in lines if l.strip() != "-cp samples"))
PY
run_case new-cp-removed

echo "########## undocumented ROOTS_GUARD_ALLOWLIST override ##########"
new_case new-envallwlist hard
root_del "$CASE/examples/swift-f32.hxml" tests.EarlyReturnTests
cat > "$CASE/permissive-allowlist.json" <<'EOF'
{ "exempt": [
  { "target": "kotlin", "module": "registry.Main", "reason": "registry.Main is the binary64 packaging/demo entry root (no @:test cases); f32 bundles declare no package/pack action and their reference tree intentionally carries no Main artifact." },
  { "target": "rust",   "module": "registry.Main", "reason": "registry.Main is the binary64 packaging/demo entry root (no @:test cases); f32 bundles declare no package/pack action and their reference tree intentionally carries no Main artifact." },
  { "target": "swift",  "module": "registry.Main", "reason": "registry.Main is the binary64 packaging/demo entry root (no @:test cases); f32 bundles declare no package/pack action and their reference tree intentionally carries no Main artifact." },
  { "target": "swift",  "module": "tests.EarlyReturnTests", "reason": "qqqq wwww eeee rrrr tttt yyyy" } ],
  "unrootedTestModules": [
  { "target": "*", "module": "tests.E0308FiTests", "reason": "Orphan rust-only probe: the file is wrapped in `#if rust_output` and neither that define nor the module appears in any examples/*.hxml, so it is a root of no guarded pair; declared here so the coverage check stays fatal instead of silently ignoring an uncollected @:test module." },
  { "target": "*", "module": "tests.f32.PrintedFloatTests", "reason": "f32-only oracle collected by the haxe f32 TestCollector bundle (tests/haxe/generate-main-f32.hxml scans samples/tests/f32), so none of the three guarded example pairs lists it as a root; its six test ids are separately declared in tools/test-consistency/extra-id-allowlist.json." } ] }
EOF
( cd "$CASE" && ROOTS_GUARD_ALLOWLIST="$CASE/permissive-allowlist.json" bash tools/roots-guard/check-roots-guard.sh ) > "$EV/new-envallwlist.txt" 2>&1
rc=$?
printf 'exit_code=%s\n' "$rc" >> "$EV/new-envallwlist.txt"
printf 'new-envallwlist\trc=%s\n' "$rc" | tee -a "$EV/rc.tsv"

echo "########## control: same case with the shipped allowlist ##########"
new_case new-envallwlist-control hard
root_del "$CASE/examples/swift-f32.hxml" tests.EarlyReturnTests
alw_add "$CASE/tools/roots-guard/roots-allowlist.json" exempt swift tests.EarlyReturnTests "qqqq wwww eeee rrrr tttt yyyy"
run_case new-envallwlist-control

echo "########## no-mutation check: does a guard run write into the tree? ##########"
new_case new-nomutation hard
before="$(cd "$CASE" && find examples tools -type f -exec sha256sum {} \; | sort | sha256sum)"
run_case new-nomutation
after="$(cd "$CASE" && find examples tools -type f -exec sha256sum {} \; | sort | sha256sum)"
printf 'tree-before=%s\ntree-after =%s\n' "$before" "$after" | tee "$EV/nomutation.txt"
[ "$before" = "$after" ] && echo "NO_MUTATION=confirmed" | tee -a "$EV/nomutation.txt" || echo "NO_MUTATION=FAILED" | tee -a "$EV/nomutation.txt"

echo "########## independent recount of duplicate root lines ##########"
python3 - "$R/examples" > "$EV/dup-recount.txt" <<'PY'
import collections, os, sys, re
d = sys.argv[1]
pat = re.compile(r'^[A-Za-z_][A-Za-z0-9_]*(\.[A-Za-z_][A-Za-z0-9_]*)*$')
total = 0
for t in ("kotlin", "rust", "swift"):
    for suf in ("", "-f32"):
        p = os.path.join(d, t + suf + ".hxml")
        c = collections.Counter(l for l in open(p, encoding="utf-8").read().split("\n") if pat.match(l))
        n = sum(v - 1 for v in c.values() if v > 1)
        print(f"{t}{suf}: {n}")
        total += n
print(f"TOTAL={total}")
PY
cat "$EV/dup-recount.txt"

echo "done"
