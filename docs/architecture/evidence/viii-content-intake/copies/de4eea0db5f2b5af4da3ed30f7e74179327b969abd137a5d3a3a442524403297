def main():
    changed = {}
    for rel, old, new in EDITS:
        p = os.path.join(TREE, rel)
        src = open(p, encoding="utf-8").read()
        n = src.count(old)
        if n != 1:
            raise SystemExit(f"FAIL {rel}: anchor matched {n} times (expected 1)\n---\n{old}")
        src = src.replace(old, new, 1)
        open(p, "w", encoding="utf-8").write(src)
        changed[rel] = changed.get(rel, 0) + 1
    for rel, n in sorted(changed.items()):
        print(f"{n:>3} edit(s)  {rel}")
    print("total files:", len(changed), "total edits:", sum(changed.values()))

main()
