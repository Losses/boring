import re, sys, json, collections

path = sys.argv[1]
lines = open(path, encoding="utf-8", errors="replace").read().split("\n")

# find summary start
sum_start = None
for i,l in enumerate(lines):
    if re.match(r"^\d+ tests failed:$", l):
        sum_start = i
        break

fail_re = re.compile(r"^\(fail\) (.+?)(?: \[([0-9.]+)ms\])?$")
to_re = re.compile(r"^  \^ this test timed out after (\d+)ms\.$")

records = collections.defaultdict(lambda: {"elapsed": set(), "budget": set(), "timeout": False, "live_to": False, "sum_to": False, "sections": []})

cur_file = None
for i,l in enumerate(lines):
    if l.startswith("tests/") or l.startswith("packages/") or l.startswith("reference/"):
        if l.rstrip().endswith(":"):
            cur_file = l.rstrip()[:-1]
    m = fail_re.match(l)
    if not m: continue
    name = m.group(1)
    el = m.group(2)
    nxt = lines[i+1] if i+1 < len(lines) else ""
    t = to_re.match(nxt)
    rec = records[name]
    if el: rec["elapsed"].add(float(el))
    if t: rec["budget"].add(int(t.group(1)))
    if t: rec["timeout"] = True
    sec = "summary" if (sum_start is not None and i > sum_start) else "live"
    rec["sections"].append(sec)
    if t and sec == "live": rec["live_to"] = True
    if t and sec == "summary": rec["sum_to"] = True
    if not t and sec == "live" and cur_file: rec.setdefault("files", set()).add(cur_file)
    if cur_file: rec.setdefault("files", set()).add(cur_file)

print("summary_start_line", sum_start)
allf = sorted(records)
print("total unique failing names:", len(allf))
to = [n for n in allf if records[n]["timeout"]]
ass = [n for n in allf if not records[n]["timeout"]]
print("timeout-class:", len(to))
print("non-timeout-class:", len(ass))
print()
print("=== TIMEOUT CLASS (sorted by budget desc, then elapsed desc) ===")
def key(n):
    r = records[n]
    return (max(r["budget"] or {0}), max(r["elapsed"] or {0}))
for n in sorted(to, key=key, reverse=True):
    r = records[n]
    print(f"{sorted(r['budget'])}  elapsed={sorted(r['elapsed'])}  file={sorted(r.get('files',[]))}  live_to={r['live_to']} sum_to={r['sum_to']}  :: {n}")
print()
print("=== NON-TIMEOUT CLASS ===")
for n in allf:
    if n in to: continue
    r = records[n]
    print(f"elapsed={sorted(r['elapsed'])}  sections={sorted(set(r['sections']))}  :: {n}")
json.dump({n: {k: (sorted(v) if isinstance(v,set) else v) for k,v in records[n].items()} for n in allf},
          open(sys.argv[2],"w"), indent=1, default=str)
