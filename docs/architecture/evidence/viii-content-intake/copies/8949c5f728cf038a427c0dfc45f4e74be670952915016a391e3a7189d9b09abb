#[derive(Clone, Copy)]
pub struct FloatCompoundAssignOps;

impl FloatCompoundAssignOps {
    pub fn float_compound_assign_ops_scaled(value: f64) -> f64 {
        let mut x = value;
        while (x) >= 10.0f64 {
            x /= 10 as f64;
        }
        while (x) < (1.0f64) {
            x *= 10 as f64;
        }
        return x;
    }

    pub fn float_compound_assign_ops_step_total() -> f64 {
        let mut total = 0.0f64;
        for _ in 0..3 {
            total += 1 as f64;
        }
        return total;
    }

    pub fn float_compound_assign_ops_walk(value: f64) -> f64 {
        let mut x = value;
        x += 2 as f64;
        x -= 1 as f64;
        return x;
    }
}
