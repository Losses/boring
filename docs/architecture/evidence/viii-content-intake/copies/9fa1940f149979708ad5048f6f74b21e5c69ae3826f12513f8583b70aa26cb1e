package tests

import boring.PrintedCustom
import boring.PrintedInner
import boring.PrintedRecord
import boring.runtime.test.Test

class PrintedRecordTests {
@boring.test.Test
    fun memberMatchesMacro() {
        Test.run("tests.PrintedRecordTests.memberMatchesMacro", "tests.PrintedRecordTests.memberMatchesMacro: synthesized member matches RecordStr") {
                val value = PrintedRecord(7, 1.5f, PrintedInner("Name"), null)
                Test.equals("PrintedRecord(count=7, ratio=1.5, inner=PrintedInner(name=Name), note=null)", value.toString(), null)
                Test.equals("PrintedRecord(" + "count=" + value.count + ", " + "ratio=" + value.ratio + ", " + "inner=" + value.inner.toString() + ", " + "note=" + ((if ((value.note == null)) "null" else value.note.toString())) + ")", value.toString(), null)
        }
    }

@boring.test.Test
    fun standardStringUsesMember() {
        Test.run("tests.PrintedRecordTests.standardStringUsesMember", "tests.PrintedRecordTests.standardStringUsesMember: Std.string and concatenation use the member") {
                val value = PrintedRecord(7, 1.5f, PrintedInner("Name"), null)
                Test.equals(value.toString(), value.toString(), null)
                Test.equals(value.toString(), "" + value.toString(), null)
        }
    }

@boring.test.Test
    fun nestedRecordUsesMember() {
        Test.run("tests.PrintedRecordTests.nestedRecordUsesMember", "tests.PrintedRecordTests.nestedRecordUsesMember: nested records use their printed form") {
                val value = PrintedRecord(7, 1.5f, PrintedInner("Name"), null)
                Test.equals("PrintedInner(name=Name)", value.inner.toString(), null)
                Test.equals("PrintedRecord(count=7, ratio=1.5, inner=PrintedInner(name=Name), note=null)", value.toString(), null)
        }
    }

@boring.test.Test
    fun presentNotePrintsMember() {
        Test.run("tests.PrintedRecordTests.presentNotePrintsMember", "tests.PrintedRecordTests.presentNotePrintsMember: a present nullable record field prints its member text") {
                val value = PrintedRecord(7, 1.5f, PrintedInner("Name"), PrintedInner("Note"))
                Test.equals("PrintedRecord(count=7, ratio=1.5, inner=PrintedInner(name=Name), note=PrintedInner(name=Note))", value.toString(), null)
                Test.equals("PrintedRecord(" + "count=" + value.count + ", " + "ratio=" + value.ratio + ", " + "inner=" + value.inner.toString() + ", " + "note=" + ((if ((value.note == null)) "null" else value.note.toString())) + ")", value.toString(), null)
        }
    }

@boring.test.Test
    fun explicitMemberWins() {
        Test.run("tests.PrintedRecordTests.explicitMemberWins", "tests.PrintedRecordTests.explicitMemberWins: explicit printed member wins") {
                Test.equals("custom=9", PrintedCustom(9).toString(), null)
        }
    }
}
