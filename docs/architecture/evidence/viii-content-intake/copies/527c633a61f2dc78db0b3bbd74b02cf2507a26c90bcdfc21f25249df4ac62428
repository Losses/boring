#!/usr/bin/env python3
"""For every unique failing name in a bun capture, dump the tightest assertion
evidence: the code frame + `error:` + Expected/Received + the `at ...` stack line
that belongs to the FIRST (inline) occurrence of that failure.

Usage: assertion-evidence.py <capture> <out.txt> [ASSERT|TIMEOUT|ALL]
"""
import re
import sys

FAIL = re.compile(r"^\(fail\) (.*)$")
ERR = re.compile(r"^\s*(error:|Expected|Received|\^|at )")


def main():
    cap, out, only = sys.argv[1], sys.argv[2], (sys.argv[3] if len(sys.argv) > 3 else "ALL")
    lines = open(cap, encoding="utf-8", errors="replace").read().split("\n")
    first = {}
    for i, line in enumerate(lines):
        m = FAIL.match(line)
        if not m:
            continue
        n = re.sub(r" \[\d+(\.\d+)?ms\]$", "", m.group(1))
        if n not in first:
            first[n] = (i, line)
    fh = open(out, "w")
    n_assert = n_timeout = 0
    for name in sorted(first):
        i, headline = first[name]
        window = lines[max(0, i - 80):i + 3]
        # the timeout marker is the line immediately AFTER the (fail) line
        nxt = lines[i + 1] if i + 1 < len(lines) else ""
        tmo = re.match(r"^\s*\^ this test timed out after (\d+)ms", nxt)
        kind = "TIMEOUT" if tmo else "ASSERT"
        if kind == "TIMEOUT":
            n_timeout += 1
        else:
            n_assert += 1
        if only != "ALL" and kind != only:
            continue
        # the assertion evidence is the preceding code frame + error block
        start = None
        for j in range(len(window) - 1, -1, -1):
            if re.match(r"^\s*error: ", window[j]):
                start = j
                break
        if start is None:
            body = "\n".join(window[-12:])
        else:
            body = "\n".join(window[max(0, start - 13):])
        fh.write("=" * 100 + "\n")
        fh.write("KIND: %-7s HEADLINE: %s\n" % (kind, headline))
        fh.write("-" * 100 + "\n")
        fh.write(body.rstrip() + "\n\n")
    fh.close()
    print("%s: ASSERT=%d TIMEOUT=%d (wrote %s, filter=%s)" % (cap, n_assert, n_timeout, out, only))


if __name__ == "__main__":
    main()
