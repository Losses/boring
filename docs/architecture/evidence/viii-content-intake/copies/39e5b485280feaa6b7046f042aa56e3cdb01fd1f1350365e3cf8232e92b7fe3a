package tests

import boring.WidgetAssembly
import boring.runtime.test.Test

class WidgetCoalescingTests {
@boring.test.Test
    fun builderDefault() {
        Test.run("tests.WidgetCoalescingTests.builderDefault", "tests.WidgetCoalescingTests.builderDefault: coalescing default constructs builder with omitted defaults") {
                val made = WidgetAssembly.build(null)
                Test.equals(1, made.scale, null)
                Test.equals(2, made.bias, null)
        }
    }

@boring.test.Test
    fun lensDefault() {
        Test.run("tests.WidgetCoalescingTests.lensDefault", "tests.WidgetCoalescingTests.lensDefault: coalescing default constructs lens in non-main-class module") {
                Test.equals(3, WidgetAssembly.lens(null).zoom, null)
        }
    }
}
