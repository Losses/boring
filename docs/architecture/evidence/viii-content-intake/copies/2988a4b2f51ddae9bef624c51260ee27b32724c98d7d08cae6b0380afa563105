#!/usr/bin/env bash
# Build the isolated chain-A execution root for the "fixed rerun" attempt.
# Base   : publication-staging/execution-option-c-coord (canonical staged pre-run root)
# Source : boring-wt-architecture (coordination tree, live) -- source dirs mirrored exactly
# Output : $ROOT  (p09-chainA-work/execution-option-c-chainA-fixed3)
set -u
WS=/home/losses/Development/tq-workspace
COORD=$WS/boring-wt-architecture
BASE=$WS/publication-staging/execution-option-c-coord
NM=$WS/publication-staging/execution-option-c-e1c65975/node_modules
ROOT=$WS/p09-chainA-work/execution-option-c-chainA-fixed3

if [ -e "$ROOT" ] || [ -L "$ROOT" ]; then
    echo "REFUSE: root already exists: $ROOT" >&2
    exit 64
fi
echo "utc_start=$(date -uIs)"
echo "coord=$COORD"
echo "base=$BASE"
echo "root=$ROOT"

mkdir -p "$ROOT" || exit 64

# 1. base body (node_modules symlink, .haxelib, out/, reference/, target/ included as-is)
rsync -a "$BASE"/ "$ROOT"/ || exit 65

# 2. node_modules: the staged base keeps a RELATIVE symlink to execution-option-c-e1c65975,
#    which does not resolve from outside publication-staging/.  Materialise a real, self
#    contained copy (internal entry symlinks are relative and stay valid).
if [ -L "$ROOT/node_modules" ]; then
    rm -f "$ROOT/node_modules" || exit 65
    mkdir -p "$ROOT/node_modules" || exit 65
    cp -a "$NM"/. "$ROOT/node_modules"/ || exit 65
    echo "node_modules: materialised real copy ($(ls -A "$ROOT/node_modules" | wc -l) entries)"
else
    echo "REFUSE: expected node_modules symlink in base" >&2
    exit 65
fi

# 3. source dirs: exact mirror of the coordination tree
for d in docs examples packages samples tests tools .github; do
    rsync -a --delete "$COORD/$d/" "$ROOT/$d/" || exit 66
    echo "synced source dir: $d"
done

# 4. top-level regular files + dot files from the coordination tree
#    (artefact dirs and the previous run's toolchain-resolution.txt are excluded)
for f in $(ls -A "$COORD"); do
    case "$f" in
        node_modules|out|reference|target|.haxelib|.git|toolchain-resolution.txt) continue ;;
        docs|examples|packages|samples|tests|tools|.github) continue ;;
    esac
    rsync -a "$COORD/$f" "$ROOT/$f" || exit 67
    echo "synced top-level: $f"
done

# 5. loader identity: .haxelib/boring/.dev must point at THIS root (no trailing newline,
#    same byte shape as haxelib dev writes)
printf '%s' "$ROOT" >"$ROOT/.haxelib/boring/.dev" || exit 68

echo "utc_end=$(date -uIs)"
echo "root_size=$(du -sh "$ROOT" | cut -f1)"
echo "BUILD OK"
