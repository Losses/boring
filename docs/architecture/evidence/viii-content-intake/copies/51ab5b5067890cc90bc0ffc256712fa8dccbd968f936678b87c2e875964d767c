label: mutate-pom
cwd: /home/losses/Development/tq-workspace/boring/dc-warn/worktrees/kotlin-manifest
argv:
  bash
  -c
  
    set -eu
    dst=/home/losses/Development/tq-workspace/dc-warn/out/kotlin-manifest/20260929T192808Z-2698141/03-mutate-pom/copy
    mkdir -p "$dst"
    cp out/dc-kotlin-manifest-version/kotlin/gen/build.gradle.kts "$dst/build.gradle.kts"
    cp out/dc-kotlin-manifest-version/kotlin/maven/dev/boring/generated/0.1.0/generated-0.1.0.pom "$dst/generated-0.1.0.pom"
    sha256sum "$dst/build.gradle.kts" "$dst/generated-0.1.0.pom" > "$dst/before.sha256"
    line=$(awk -f out/dc-kotlin-manifest-version/pom-stdlib-version-line.awk "$dst/generated-0.1.0.pom")
    [ -n "$line" ] || { echo "mutate: no stdlib version line" >&2; exit 2; }
    before=$(sed -n "${line}p" "$dst/generated-0.1.0.pom")
    # the single-sided change: only the POM stdlib version, on its own line
    sed -i "${line}s#<version>[0-9][0-9.]*</version>#<version>2.5.99</version>#" "$dst/generated-0.1.0.pom"
    after=$(sed -n "${line}p" "$dst/generated-0.1.0.pom")
    sha256sum "$dst/build.gradle.kts" "$dst/generated-0.1.0.pom" > "$dst/after.sha256"
    diff -u "$dst/before.sha256" "$dst/after.sha256" > "$dst/mutation.diff" || true
    echo "mutated POM line $line:"
    echo "  before: $before"
    echo "  after:  $after"
    [ "$before" != "$after" ] || { echo "mutate: the version line did not change" >&2; exit 2; }
  
