#!/usr/bin/env bash
# fromdiff.sh -- literal FIX.diff route on LOCAL disk:
#  1. copy producer pristine/ -> $XS/fromdiff/pristine
#  2. patch -p0 < FIX.diff           (must apply cleanly, rc=0)
#  3. stage the patched result as a fresh tree at $XS/fromdiff/root/out/...
#     with ONLY the ROOT line re-pointed at that tree (env adaptation for
#     "I must not write the frozen tree"); everything else verbatim.
#  4. run the full selftest, capture exit code and log tail.
set -u
XS="/home/losses/Development/tq-workspace/out/option-c-xcheck"
DEL="/home/losses/Development/tq-workspace/dc-warn/out/option-c/selftest"
FROZ="/home/losses/Development/tq-workspace/boring-wt-architecture/out/integration-a3-evidence/exclusive-runner"
FD="$XS/fromdiff"
E="$FD/root/out/integration-a3-evidence/exclusive-runner"
rm -rf "$FD"; mkdir -p "$FD/pristine" "$E"
cp -p "$DEL/pristine"/* "$FD/pristine"/
cd "$FD"
echo "### step 2: patch -p0 < FIX.diff"
patch -p0 < "$DEL/FIX.diff"; echo "patch rc=$?"
echo
echo "### step 2b: patched files vs producer fixed/ (must be byte-identical)"
cmp "$FD/pristine/option-c-stage-wrapper.sh" "$DEL/fixed/option-c-stage-wrapper.sh" && echo "wrapper: EXACT"
cmp "$FD/pristine/selftest.sh"               "$DEL/fixed/selftest.sh"               && echo "selftest: EXACT"
echo
echo "### step 3: stage patched tree, re-point ROOT only"
cp -p "$FD/pristine"/* "$E"/
for f in "$FROZ"/*; do b="$(basename "$f")"; [ -f "$E/$b" ] || continue; chmod "$(stat -c '%a' "$f")" "$E/$b"; done
# tool.sh is created+chmod'ed by selftest itself; nothing else needed.
sed -i "s#^ROOT=.*#ROOT=\"$FD/root\"#" "$E/selftest.sh"
echo "deviations from patched output (expect exactly one line: ROOT):"
diff -u "$FD/pristine/selftest.sh" "$E/selftest.sh" | sed 's/^/    /' || true
echo
echo "### step 4: full selftest"
cd "$E"
bash selftest.sh >"$FD/last-selftest.log" 2>&1; rc=$?
echo "REAL_EXIT_CODE=$rc"
echo "summary: $(grep -E '^self-test:' "$FD/last-selftest.log")"
echo "passes: $(grep -c '^PASS' "$FD/last-selftest.log")  fails: $(grep -c '^FAIL' "$FD/last-selftest.log")"
echo
echo "### log tail (last 12 lines)"
tail -12 "$FD/last-selftest.log"
