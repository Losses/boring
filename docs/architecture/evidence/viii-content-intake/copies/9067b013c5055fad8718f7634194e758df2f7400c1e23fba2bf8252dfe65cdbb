#![cfg(test)]

use crate::runtime::test as testlib;
use crate::runtime::test_core;
use crate::runtime::u_string::UStr;
use crate::runtime::u_string::UString;


#[test]
fn conditional_return() {
    testlib::run("tests.EarlyReturnTests.conditionalReturn", "tests.EarlyReturnTests.conditionalReturn: conditional early return exits the test body", || {
        let should_stop = true;
        if should_stop {
            return;
        }
        test_core::TestCore::test_core_fail(&(UString::from("unreachable assertion")));
    });
}

#[test]
fn fall_through() {
    testlib::run("tests.EarlyReturnTests.fallThrough", "tests.EarlyReturnTests.fallThrough: fall-through path continues after the conditional", || {
        let should_stop = false;
        if should_stop {
            return;
        }
        test_core::TestCore::test_core_ok(true, UStr::new(&[]));
    });
}
