package boring

class Frame(val label: String) {
}

object FrameBase {
    const val factor: Double = 1.5
}

object BuiltInFrame {
    val frame: Frame = Frame("cross-class")
}

class FramePolicy(val label: String, val mode: FrameMode, val values: MutableList<String>) {

    fun valueCountText(): String {
        return (this.values.size).toString()
    }

    companion object {
        val weighted: FramePolicy = FramePolicy("weighted", FrameMode.Weighted(FrameBase.factor), mutableListOf<String>("a", "b"))

        val plain: FramePolicy = FramePolicy("plain", FrameMode.Plain, mutableListOf<String>())

        val imported: FramePolicy = FramePolicy("imported", FrameMode.Plain, mutableListOf<String>("cross-class"))

        val generated: FramePolicy = FramePolicy("generated", FrameMode.Plain, mutableListOf<String>())
    }
}

object ConstructedStateOps {
    fun labels(): String {
        return FramePolicy.weighted.label + "," + FramePolicy.plain.label + "," + FramePolicy.imported.label + "," + FramePolicy.generated.label
    }

    fun weight(): Double {
        return FrameBase.factor
    }

    fun firstLengths(): String {
        return FramePolicy.weighted.valueCountText() + "," + FramePolicy.plain.valueCountText()
    }

    fun crossClassText(): String {
        return BuiltInFrame.frame.label
    }

    fun generatedLabel(): String {
        return FramePolicy.generated.label
    }
}

sealed interface FrameMode {
    data object Plain : FrameMode
    data class Weighted(val weight: Double) : FrameMode
}
