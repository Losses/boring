#![cfg(test)]

use crate::runtime::test as testlib;
use crate::runtime::test_core;
use crate::runtime::u_string::UStr;


#[test]
fn literal_loop_scopes() {
    testlib::run("tests.BlockScopeUnrollTests.literalLoopScopes", "tests.BlockScopeUnrollTests.literalLoopScopes: literal loop unrolls into scoped blocks", || {
        let mut total = 0u32;
        {
            {
                let step = 1u32;
                let doubled = u32::wrapping_mul(step, 2);
                total = u32::wrapping_add(total, doubled);
            }
            {
                let step = 3u32;
                let doubled = u32::wrapping_mul(step, 2);
                total = u32::wrapping_add(total, doubled);
            }
            {
                let step = 7u32;
                let doubled = u32::wrapping_mul(step, 2);
                total = u32::wrapping_add(total, doubled);
            }
            {
                let step = 31u32;
                let doubled = u32::wrapping_mul(step, 2);
                total = u32::wrapping_add(total, doubled);
            }
        }
        test_core::TestCore::test_core_equals_int(84i32, i32::from_ne_bytes(((total) as i32).to_ne_bytes()), UStr::new(&[]));
    });
}

#[test]
fn sequential_loops() {
    testlib::run("tests.BlockScopeUnrollTests.sequentialLoops", "tests.BlockScopeUnrollTests.sequentialLoops: sequential literal loops reuse names", || {
        let mut total = 0u32;
        {
            {
                let v = 1u32;
                let tag = v;
                total = u32::wrapping_add(total, tag);
            }
            {
                let v = 2u32;
                let tag = v;
                total = u32::wrapping_add(total, tag);
            }
        }
        {
            {
                let v = 3u32;
                let tag = v;
                total = u32::wrapping_add(total, tag);
            }
            {
                let v = 4u32;
                let tag = v;
                total = u32::wrapping_add(total, tag);
            }
        }
        test_core::TestCore::test_core_equals_int(10i32, i32::from_ne_bytes(((total) as i32).to_ne_bytes()), UStr::new(&[]));
    });
}

#[test]
fn return_from_segment() {
    testlib::run("tests.BlockScopeUnrollTests.returnFromSegment", "tests.BlockScopeUnrollTests.returnFromSegment: return inside unrolled body", || {
        test_core::TestCore::test_core_equals_int(7i32, i32::from_ne_bytes(((BlockScopeUnrollSupport::block_scope_unroll_support_first_above_five()) as i32).to_ne_bytes()), UStr::new(&[]));
    });
}

#[test]
fn break_continue_path() {
    testlib::run("tests.BlockScopeUnrollTests.breakContinuePath", "tests.BlockScopeUnrollTests.breakContinuePath: break and continue keep the counted loop path", || {
        let mut total = 0u32;
        {
            let _g1 = vec![1, 3, 7, 31];
            for &step in &_g1 {
                if step == 3 {
                    continue;
                }
                if step == 31 {
                    break;
                }
                total = u32::wrapping_add(total, step);
            }
        }
        test_core::TestCore::test_core_equals_int(8i32, i32::from_ne_bytes(((total) as i32).to_ne_bytes()), UStr::new(&[]));
    });
}

#[derive(Clone, Copy)]
pub struct BlockScopeUnrollSupport;

impl BlockScopeUnrollSupport {
    pub fn block_scope_unroll_support_first_above_five() -> u32 {
        {
            {
                let step = 1u32;
                if i32::from_ne_bytes(((step) as i32).to_ne_bytes()) > (i32::from_ne_bytes(((BlockScopeUnrollSupport::block_scope_unroll_support_threshold()) as i32).to_ne_bytes())) {
                    return step;
                }
            }
            {
                let step = 3u32;
                if i32::from_ne_bytes(((step) as i32).to_ne_bytes()) > (i32::from_ne_bytes(((BlockScopeUnrollSupport::block_scope_unroll_support_threshold()) as i32).to_ne_bytes())) {
                    return step;
                }
            }
            {
                let step = 7u32;
                if i32::from_ne_bytes(((step) as i32).to_ne_bytes()) > (i32::from_ne_bytes(((BlockScopeUnrollSupport::block_scope_unroll_support_threshold()) as i32).to_ne_bytes())) {
                    return step;
                }
            }
            {
                let step = 31u32;
                if i32::from_ne_bytes(((step) as i32).to_ne_bytes()) > (i32::from_ne_bytes(((BlockScopeUnrollSupport::block_scope_unroll_support_threshold()) as i32).to_ne_bytes())) {
                    return step;
                }
            }
        }
        return 0;
    }

    pub fn block_scope_unroll_support_threshold() -> u32 {
        return 5;
    }
}
