        match self {
            E1PayloadFault::One { tag } => {
                write!(formatter, "{}", tag)
            }
            E1PayloadFault::E1Fault(inner) => write!(formatter, "{:?}", inner),
        }
    }
}

impl std::error::Error for E1PayloadFault {}

#[derive(Debug, Clone, PartialEq)]
