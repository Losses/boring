package tests

import boring.RecordOps
import boring.runtime.test.Test

class RecordTests {
@boring.test.Test
    fun testZeroOverride() {
        Test.run("tests.RecordTests.testZeroOverride", "tests.RecordTests.testZeroOverride: zero override returns record with all original fields") {
                val orig = RecordOps.makeItem(1, "alpha", 100, true)
                val copy = RecordOps.copyNoOverride(orig)
                Test.equals(1, copy.id, null)
                Test.equals("alpha", copy.name, null)
                Test.equals(100, copy.score, null)
                Test.equals(true, copy.active, null)
        }
    }

@boring.test.Test
    fun testSingleOverride() {
        Test.run("tests.RecordTests.testSingleOverride", "tests.RecordTests.testSingleOverride: single override replaces only targeted field") {
                val orig = RecordOps.makeItem(2, "beta", 80, false)
                val copy = RecordOps.copySingleOverride(orig, 99)
                Test.equals(2, copy.id, null)
                Test.equals("beta", copy.name, null)
                Test.equals(99, copy.score, null)
                Test.equals(false, copy.active, null)
        }
    }

@boring.test.Test
    fun testReorderedOverrides() {
        Test.run("tests.RecordTests.testReorderedOverrides", "tests.RecordTests.testReorderedOverrides: reordered overrides apply in declaration order and preserve untouched fields") {
                val orig = RecordOps.makeItem(3, "gamma", 50, false)
                val copy = RecordOps.copyReordered(orig, true, "gamma_updated")
                Test.equals(3, copy.id, null)
                Test.equals("gamma_updated", copy.name, null)
                Test.equals(50, copy.score, null)
                Test.equals(true, copy.active, null)
        }
    }

@boring.test.Test
    fun testMultipleOverrides() {
        Test.run("tests.RecordTests.testMultipleOverrides", "tests.RecordTests.testMultipleOverrides: multiple overrides replace all specified fields") {
                val orig = RecordOps.makeItem(4, "delta", 20, false)
                val copy = RecordOps.copyMultiple(orig, 10, "delta_all", 999)
                Test.equals(10, copy.id, null)
                Test.equals("delta_all", copy.name, null)
                Test.equals(999, copy.score, null)
                Test.equals(false, copy.active, null)
        }
    }
}
