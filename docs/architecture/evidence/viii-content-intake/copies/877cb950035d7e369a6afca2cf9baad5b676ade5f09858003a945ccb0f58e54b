package boring

object NilContextOps {
    fun conditional(flag: Boolean): String? {
        return (if ((flag)) "present" else null)
    }

    fun nullArgument(): String {
        return NilContextOps.choose(null)
    }

    private fun choose(value: String?): String {
        return (if ((value == null)) "empty" else value)
    }
}
