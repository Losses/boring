use crate::boring::binary_writer::BinaryWriter;
use crate::boring::glyph_metrics::BoundsEm;
use crate::boring::glyph_metrics::GlyphMetrics;


#[derive(Clone, Copy)]
pub struct TestData;

impl TestData {
    pub fn test_data_sample_bounds() -> BoundsEm {
        return BoundsEm { x_min: 0.0f32, y_min: 0.0f32, x_max: 0.5f32, y_max: 0.5f32 };
    }

    pub fn test_data_glyph_samples() -> Vec<GlyphMetrics> {
        return vec![
    GlyphMetrics { code_point: 65, advance_em: 0.5f32, bounds: BoundsEm { x_min: 0.0f32, y_min: 0.0f32, x_max: 0.5f32, y_max: 0.5f32 } },
];
    }

    pub fn test_data_sample_bytes() -> Vec<u8> {
        let mut writer = BinaryWriter::new();
        writer.write_u32(1112688433);
        return writer.finish();
    }
}
