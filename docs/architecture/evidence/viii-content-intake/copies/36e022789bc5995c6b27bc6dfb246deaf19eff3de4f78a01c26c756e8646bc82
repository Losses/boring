package tests

import boring.AllowGuest
import boring.runtime.test.Test

class AllowAccessTests {
@boring.test.Test
    fun staticAccess() {
        Test.run("tests.AllowAccessTests.staticAccess", "tests.AllowAccessTests.staticAccess: allowed private static function is callable across classes") {
                Test.equals(4, AllowGuest.useStatic(3), null)
        }
    }

@boring.test.Test
    fun staticFieldAccess() {
        Test.run("tests.AllowAccessTests.staticFieldAccess", "tests.AllowAccessTests.staticFieldAccess: allowed private static field is writable across classes") {
                Test.equals(42, AllowGuest.useCounter(), null)
        }
    }

@boring.test.Test
    fun instanceAccess() {
        Test.run("tests.AllowAccessTests.instanceAccess", "tests.AllowAccessTests.instanceAccess: allowed private instance members are reachable across classes") {
                val g = AllowGuest()
                Test.equals("mhost", g.useMethod(), null)
        }
    }
}
