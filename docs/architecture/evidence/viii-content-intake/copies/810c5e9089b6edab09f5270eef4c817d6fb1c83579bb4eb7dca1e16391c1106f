package tests

import boring.UStringResidentOps
import boring.runtime.test.Test

class UStringResidentTests {
@boring.test.Test
    fun testResidentMembers() {
        Test.run("tests.UStringResidentTests.testResidentMembers", "tests.UStringResidentTests.testResidentMembers: UString member calls resolve through the Dart runtime resident") {
                Test.equals(6, UStringResidentOps.count("tiqian"), null)
                Test.equals(105, UStringResidentOps.at("tiqian", 1), null)
                Test.equals("iq", UStringResidentOps.slice("tiqian", 1, 3), null)
                Test.equals("一", UStringResidentOps.fromCodePoint(19968), null)
        }
    }
}
