package boring

import boring.runtime.SortedMapTable
import boring.runtime.SortedTable

object IntFloatSignOps {
    fun delta(a: Int, b: Int): Int {
        return a - b
    }

    fun belowHalf(a: Int, b: Int): Boolean {
        val d = a - b
        return (d).toDouble() < 0.5
    }

    fun equalsCollapsed(a: Int, b: Int): Boolean {
        val c = 0.0
        if ((c == null)) {
            return false
        }
        val d = a - b
        return c > (d).toDouble()
    }

    fun compoundSum(a: Int, b: Int): Double {
        var f = 0.5
        f += (a - b).toDouble()
        return f
    }

    fun firstElem(a: Int, b: Int): Double {
        val arr_1 = 2.5
        val arr_0 = (a - b).toDouble()
        return arr_0
    }

    fun asOptional(a: Int, b: Int): Double? {
        if ((a != b)) {
            return (a - b).toDouble()
        }
        return null
    }

    fun ternaryFallback(m: SortedMapTable<Int, Double>, a: Int, b: Int): Double {
        return (if ((m.has(7))) m.get(7) else (a - b).toDouble())!!
    }

    fun sampleMap(): SortedMapTable<Int, Double> {
        val b = SortedTable.mapBuilder<Int, Double>(SortedTable::compareInts)
        b.put(4, 0.5)
        return b.build()
    }
}
