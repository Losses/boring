package tests

import boring.NumericConversionWidening
import boring.runtime.test.Test

class NumericConversionWideningTests {
@boring.test.Test
    fun testComparison() {
        Test.run("tests.NumericConversionWideningTests.testComparison", "tests.NumericConversionWideningTests.testComparison: Numeric conversion widening compares Float and Int") {
                Test.equals(true, NumericConversionWidening.compareEqual(1.0, 1), null)
                Test.equals(false, NumericConversionWidening.compareEqual(1.0, 2), null)
                Test.equals(false, NumericConversionWidening.compareNotEqual(1.0, 1), null)
                Test.equals(true, NumericConversionWidening.compareNotEqual(1.0, 2), null)
        }
    }

@boring.test.Test
    fun testReturn() {
        Test.run("tests.NumericConversionWideningTests.testReturn", "tests.NumericConversionWideningTests.testReturn: Numeric conversion widening returns Int from Float function") {
                Test.equals(5.0, NumericConversionWidening.returnIntAsFloat(5), null)
        }
    }

@boring.test.Test
    fun testInit() {
        Test.run("tests.NumericConversionWideningTests.testInit", "tests.NumericConversionWideningTests.testInit: Numeric conversion widening initializes Float from Int") {
                Test.equals(16.0, NumericConversionWidening.initFloat(), null)
        }
    }

@boring.test.Test
    fun testAssign() {
        Test.run("tests.NumericConversionWideningTests.testAssign", "tests.NumericConversionWideningTests.testAssign: Numeric conversion widening assigns Int to Float") {
                Test.equals(42.0, NumericConversionWidening.assignIntToFloat(), null)
        }
    }

@boring.test.Test
    fun testParam() {
        Test.run("tests.NumericConversionWideningTests.testParam", "tests.NumericConversionWideningTests.testParam: Numeric conversion widening passes Int to Float parameter") {
                Test.equals(9.0, NumericConversionWidening.callFloatParam(), null)
        }
    }
}
