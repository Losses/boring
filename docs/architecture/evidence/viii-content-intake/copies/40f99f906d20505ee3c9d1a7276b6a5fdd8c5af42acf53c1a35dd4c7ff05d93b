import re, os, collections

DIFF = "/home/losses/Development/tq-workspace/dc-warn/out/composite-patch/COMPOSITE.diff"
CFGA = "/tmp/p1run/cfg-a/tests/ts"
OUTA = "/home/losses/Development/tq-workspace/dc-warn/out/p1-scoped-run/evidence/cfg-a-outcomes-no-timing.txt"

outcomes = {}
for line in open(OUTA, encoding="utf8"):
    m = re.match(r"^\((pass|fail)\)\s+(.*?)(?:\s+\[.*\])?$", line.strip())
    if m:
        outcomes[m.group(2).strip()] = m.group(1)

def outcome_for(short):
    hits = [k for k in outcomes if k.endswith(short)]
    return outcomes[hits[0]] if len(hits) == 1 else ("AMBIG:%d" % len(hits) if hits else "NOT-FOUND")

cur = None
hunks = collections.defaultdict(list)
for line in open(DIFF, encoding="utf8"):
    m = re.match(r"^\+\+\+ b/(.*)$", line)
    if m:
        cur = m.group(1); continue
    m = re.match(r"^@@ -\d+(?:,\d+)? \+(\d+)(?:,(\d+))? @@", line)
    if m and cur:
        start = int(m.group(1)); count = int(m.group(2) or 1)
        hunks[cur].append((start, start + count - 1))

def tests_in(path):
    src = open(path, encoding="utf8").read().splitlines()
    marks = []
    for i, l in enumerate(src, 1):
        m = re.match(r'\s*(?:test|it)\(\s*"((?:[^"\\]|\\.)*)"', l)
        if m:
            marks.append((i, m.group(1)))
    return src, [(marks[j][0], (marks[j+1][0]-1 if j+1 < len(marks) else len(src)), marks[j][1]) for j in range(len(marks))]

allchanged = {}
for f, hs in sorted(hunks.items()):
    path = os.path.join(CFGA, os.path.basename(f))
    src, spans = tests_in(path)
    changed = set()
    for a, b in hs:
        changed.update(range(a, b+1))
    print(f"\n## {f}  hunks={hs}  changed_lines={sorted(changed)}")
    touched = []
    for a, b, name in spans:
        inter = changed & set(range(a, b+1))
        if inter:
            st = outcome_for(name)
            touched.append((name, st, sorted(inter)))
            print(f"   [{st:>5}] test lines {a}-{b}: {name}  (changed: {sorted(inter)})")
    inside = set()
    for a, b, name in spans:
        inside |= set(range(a, b+1))
    orphan = sorted(changed - inside)
    if orphan:
        print(f"   changed lines in module scope / tables (not inside a test body): {orphan}")
    allchanged[os.path.basename(f)] = (touched, orphan)

print("\n\n=== SUMMARY: patch-changed lines inside TEST bodies, by outcome ===")
npass = nfail = nmod = 0
for f, (touched, orphan) in allchanged.items():
    for name, st, lines in touched:
        if st == "pass": npass += 1
        elif st == "fail": nfail += 1
        print(f"  {st:>5}  {f}: {name}")
    if orphan:
        nmod += 1
        print(f"  [module-scope/table change] {f}: lines {orphan}")
print(f"\ntests containing changed lines: pass={npass} fail={nfail}; files with changes only outside test bodies: {nmod}")
