#!/usr/bin/env python3
"""Field-level inspection of the driver's child evidence records.

Walks BORING_CHILD_EVIDENCE_DIR for run-*/NNNN/record.json files and
asserts, per record (real ChildEvidenceRecord schema):
- captureComplete is true;
- outcome is "normal-exit" with exitStatus 0 (the inspector runs after
  successful driver stages; a nonzero or non-normal-exit record is
  reported and fails the inspection);
- argv is a non-empty list;
- captureError is null.
Prints one line per record and a summary; exits 0 only when every
record passes. Count is never the check.
"""
import json
import os
import sys


def main():
    if len(sys.argv) != 2:
        print("usage: option-c-child-records.py <BORING_CHILD_EVIDENCE_DIR>")
        return 2
    root = sys.argv[1]
    records = []
    for run_dir in sorted(os.listdir(root)):
        if not run_dir.startswith("run-"):
            continue
        seq_dir = os.path.join(root, run_dir)
        for name in sorted(os.listdir(seq_dir)):
            if name.endswith(".json"):
                records.append(os.path.join(seq_dir, name))
    if not records:
        print("FAIL: no child records found under " + root)
        return 1
    bad = 0
    for path in records:
        rec = json.load(open(path))
        problems = []
        if rec.get("captureComplete") is not True:
            problems.append("captureComplete is not true")
        if rec.get("outcome") != "normal-exit":
            problems.append("outcome=%r" % rec.get("outcome"))
        if rec.get("exitStatus") != 0:
            problems.append("exitStatus=%r" % rec.get("exitStatus"))
        if not isinstance(rec.get("argv"), list) or not rec["argv"]:
            problems.append("argv empty or missing")
        if rec.get("captureError") is not None:
            problems.append("captureError=%r" % rec.get("captureError"))
        label = rec.get("invocationId", "?") + "/seq-" + str(rec.get("sequence", "?"))
        if problems:
            bad += 1
            print("FAIL " + label + ": " + "; ".join(problems))
        else:
            print("PASS " + label)
    total = len(records)
    print("child records: %d checked, %d bad" % (total, bad))
    return 1 if bad else 0


if __name__ == "__main__":
    sys.exit(main())
