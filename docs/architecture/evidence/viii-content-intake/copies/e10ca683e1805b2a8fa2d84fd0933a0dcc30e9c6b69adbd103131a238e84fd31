#![cfg(test)]

use crate::boring::array_access_ops::ArrayAccessOps;
use crate::runtime::test as testlib;
use crate::runtime::test_core;
use crate::runtime::u_string::UStr;


#[test]
fn test_write_split() {
    testlib::run("tests.ArrayAccessTests.testWriteSplit", "tests.ArrayAccessTests.testWriteSplit: split results support written array access", || {
        test_core::TestCore::test_core_equals_string(UStr::new(&[120]), ArrayAccessOps::array_access_ops_write_split(UStr::new(&[97,44,98])).as_ustr(), UStr::new(&[]));
    });
}

#[test]
fn test_read_split() {
    testlib::run("tests.ArrayAccessTests.testReadSplit", "tests.ArrayAccessTests.testReadSplit: split results support read array access", || {
        test_core::TestCore::test_core_equals_string(UStr::new(&[97]), ArrayAccessOps::array_access_ops_read_split(UStr::new(&[97,44,98])).as_ustr(), UStr::new(&[]));
    });
}

#[test]
fn test_composite_part() {
    testlib::run("tests.ArrayAccessTests.testCompositePart", "tests.ArrayAccessTests.testCompositePart: composite StringBuf part can read its first character", || {
