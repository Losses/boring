def body(src, start_idx):
    """Return text of the call starting at the first '(' at/after start_idx, balanced."""
    i = src.index("(", start_idx)
    depth = 0
    j = i
    while j < len(src):
        c = src[j]
        if c == "(": depth += 1
        elif c == ")":
            depth -= 1
            if depth == 0: return src[i:j+1]
        j += 1
    return src[i:]

spawn_re = re.compile(r"Bun\.(spawn|spawnSync|\$)\s*\(\s*\[?\s*([^\]]*?)\]", re.S)
