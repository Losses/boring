    # find the test( call at or before this line
    pre = "\n".join(lines[:line])
    idx = pre.rfind("test(")
    call = body("\n".join(lines), idx)
    cmds = []
    for m in re.finditer(r'"((?:haxe|kotlinc|java|node|cargo|swiftc|dart|tar|python3|git|npm|tsc))"', call):
        cmds.append(m.group(1))
    # classify: does the body reference a helper function?
    helpers = re.findall(r'(?:await\s+)?([A-Za-z_][A-Za-z0-9_]*)\s*\(', call)
    out[t["name"]] = {"file": t["file"], "line": line, "budget": t["budget"],
                      "elapsed": t["elapsed"], "spawn_literals": sorted(set(cmds)),
                      "body_len": len(call), "calls": sorted(set(helpers))}
    print(f'--- {t["file"]}:{line}  budget={t["budget"]} elapsed={t["elapsed"]}')
    print(f'    name: {t["name"]}')
    print(f'    literal spawn binaries in body: {sorted(set(cmds)) or "NONE DIRECTLY"}')
    print(f'    calls made: {", ".join(sorted(set(helpers))[:14])}')
