use crate::runtime::sorted_table::SortedTable;
use crate::runtime::u_string;
use crate::runtime::u_string::UStr;
use crate::runtime::u_string::UString;


#[derive(Clone, Copy)]
pub struct ValuePassingOps;

impl ValuePassingOps {
    pub fn value_passing_ops_read_two_fields(card: ValueCard) -> UString {
        let first = (card.title).to_ustring().clone();
        let second = (card.title).to_ustring().clone();
        return UString::from(format!("{}", { let mut __s = UString::new(); __s += first.as_ustr(); __s += &(UString::from("|")); __s += second.as_ustr(); __s }).as_str());
    }

    pub fn value_passing_ops_pass_twice(card: ValueCard) -> u32 {
        let a = ValuePassingOps::value_passing_ops_tag_count((card).clone());
        let b = ValuePassingOps::value_passing_ops_tag_count((card).clone());
        return u32::wrapping_add(a, b);
    }

    pub(crate) fn value_passing_ops_tag_count(card: ValueCard) -> u32 {
        return u32::try_from((card.tags.len()) & 0xFFFF_FFFF).unwrap_or(0);
    }

    pub fn value_passing_ops_forward_parameter(tags: &Vec<UString>) -> u32 {
        return ValuePassingOps::value_passing_ops_count_all(&tags);
    }

    pub(crate) fn value_passing_ops_count_all(tags: &Vec<UString>) -> u32 {
        let mut total = 0u32;
        for i in 0..match u32::try_from(tags.len()) { Ok(value) => value, Err(_) => u32::MAX } {
            total = u32::wrapping_add(total, u_string::unit_count(&((tags[usize::try_from(i).unwrap_or(0)]).clone())));
        }
        return total;
    }

    pub fn value_passing_ops_push_through(tags: &mut Vec<UString>) -> UString {
        ValuePassingOps::value_passing_ops_append_one(tags);
        return (tags[usize::try_from(u32::wrapping_sub(u32::try_from((tags.len()) & 0xFFFF_FFFF).unwrap_or(0), 1)).unwrap_or(0)]).clone();
    }

    pub(crate) fn value_passing_ops_append_one(tags: &mut Vec<UString>) {
        tags.push(UString::from("added").to_ustring());
    }

    pub fn value_passing_ops_length_arithmetic(text: &UStr) -> u32 {
        let n = u_string::unit_count(&(text));
        return u32::wrapping_add(u32::wrapping_mul(n, 2), 1);
    }

    pub fn value_passing_ops_build_card() -> ValueCard {
        let inner = InnerNote { label: UString::from("note").to_ustring(), weight: 2 };
        return ValueCard { title: UString::from("card").to_ustring(), tags: vec![UString::from("alpha").to_ustring(), UString::from("beta").to_ustring()], note: inner };
    }
}

#[derive(Debug, Clone, PartialEq)]
pub struct InnerNote {
    pub label: UString,
    pub weight: u32,
}

pub fn compare_inner_note(a: &InnerNote, b: &InnerNote) -> i32 {
    let cmp_label = SortedTable::sorted_table_compare_strings(a.label.as_ustr(), b.label.as_ustr());
    if cmp_label != 0 { return cmp_label; }
    let cmp_weight = match i32::from_ne_bytes((a.weight).to_ne_bytes()).cmp(&i32::from_ne_bytes((b.weight).to_ne_bytes())) { core::cmp::Ordering::Less => -1, core::cmp::Ordering::Equal => 0, core::cmp::Ordering::Greater => 1 };
    if cmp_weight != 0 { return cmp_weight; }
    0
}

#[derive(Debug, Clone, PartialEq)]
pub struct ValueCard {
    pub title: UString,
    pub tags: Vec<UString>,
    pub note: InnerNote,
}
