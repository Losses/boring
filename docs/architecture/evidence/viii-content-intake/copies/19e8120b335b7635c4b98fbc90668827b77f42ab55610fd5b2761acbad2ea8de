#![cfg(test)]

use crate::boring::static_ref_ops::StaticRefOps;
use crate::runtime::test as testlib;
use crate::runtime::test_core;
use crate::runtime::u_string::UStr;


#[test]
fn test_pass_to_param() {
    testlib::run("tests.StaticRefTests.testPassToParam", "tests.StaticRefTests.testPassToParam: static method passed as value to function-typed parameter", || {
        test_core::TestCore::test_core_equals_string(UStr::new(&[99,111,100,101,58,52,50]), StaticRefOps::static_ref_ops_pass_to_param().as_ustr(), UStr::new(&[]));
    });
}

#[test]
fn test_store_local() {
    testlib::run("tests.StaticRefTests.testStoreLocal", "tests.StaticRefTests.testStoreLocal: static method stored in function-typed local", || {
        test_core::TestCore::test_core_equals_string(UStr::new(&[99,111,100,101,58,52,50]), StaticRefOps::static_ref_ops_store_local().as_ustr(), UStr::new(&[]));
    });
}

#[test]
fn test_return_fn() {
    testlib::run("tests.StaticRefTests.testReturnFn", "tests.StaticRefTests.testReturnFn: static method returned as function value", || {
        test_core::TestCore::test_core_equals_string(UStr::new(&[99,111,100,101,58,52,50]), StaticRefOps::static_ref_ops_return_fn()(42).as_ustr(), UStr::new(&[]));
    });
}

#[test]
fn test_reassign_local() {
