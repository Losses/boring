#[test]
fn test_statics_only_value() {
    testlib::run("tests.StaticRefTests.testStaticsOnlyValue", "tests.StaticRefTests.testStaticsOnlyValue: statics-only class static method used as value", || {
        test_core::TestCore::test_core_equals_int(1i32, i32::from_ne_bytes(((StaticRefOps::static_ref_ops_statics_only_value()) as i32).to_ne_bytes()), UStr::new(&[]));
    });
}

