package registry

object Semver {
    private fun intOf(x: String): Int {
        var out = 0
        for (i in 0 until x.length) {
            out = out * 10 + (run { val _s = x; val _i = i; if (_i >= 0 && _i < _s.length) _s[_i].code else null })!! - 48
        }
        return out
    }

    private fun splitParts(s: String): MutableList<String> {
        val out = mutableListOf<String>()
        val ps = s.split(".")
        for (i in 0 until ps.size) {
            out.add(ps[i])
        }
        return out
    }

    private fun exceptionOf(f: SemverException): SemverException {
        return when (f) {
            is SemverException.InvalidCore -> SemverException.InvalidCore(f.version)
            is SemverException.InvalidExtension -> SemverException.InvalidExtension(f.version)
        }
    }

    private fun validNumeric(x: String): Boolean {
        if ((x.length == 0)) {
            return false
        }
        if ((x.length > 1 && run { val _s = x; val _i = 0; if (_i >= 0 && _i < _s.length) _s[_i].code else null } == 48)) {
            return false
        }
        for (i in 0 until x.length) {
            val c = run { val _s = x; val _i = i; if (_i >= 0 && _i < _s.length) _s[_i].code else null }
            if ((c!! < 48 || c!! > 57)) {
                return false
            }
        }
        return true
    }

    private fun validIdentifier(x: String): Boolean {
        if ((x.length == 0)) {
            return false
        }
        for (i in 0 until x.length) {
            val c = run { val _s = x; val _i = i; if (_i >= 0 && _i < _s.length) _s[_i].code else null }
            if ((!(c!! >= 48 && c!! <= 57 || c!! >= 65 && c!! <= 90 || c!! >= 97 && c!! <= 122 || c == 45))) {
                return false
            }
        }
        return true
    }

    private fun validIdentifiers(x: String): Boolean {
        val a = x.split(".")
        for (i in 0 until a.size) {
            if ((!Semver.validIdentifier(a[i]))) {
                return false
            }
        }
        return true
    }

    private fun parseFault(version: String): SemverException? {
        var core = version
        val dash = version.indexOf("-")
        val plus = version.indexOf("+")
        if ((plus >= 0)) {
            if ((dash >= 0 && plus < dash)) {
                return SemverException.InvalidExtension(version)
            }
            if ((!Semver.validIdentifiers(run { val _s = version; val _from = plus + 1; val _start = if (_from < 0) 0 else if (_from > _s.length) _s.length else _from; _s.substring(_start) }))) {
                return SemverException.InvalidExtension(version)
            }
            core = run { val _s = version; val _from = 0; val _to = plus; val _start = if (_from < 0) 0 else if (_from > _s.length) _s.length else _from; val _end = if (_to < 0) 0 else if (_to > _s.length) _s.length else _to; if (_start > _end) _s.substring(_end, _start) else _s.substring(_start, _end) }
        }
        if ((dash >= 0)) {
            val end = (if ((plus >= 0)) plus else version.length)
            if ((!Semver.validIdentifiers(run { val _s = version; val _from = dash + 1; val _to = end; val _start = if (_from < 0) 0 else if (_from > _s.length) _s.length else _from; val _end = if (_to < 0) 0 else if (_to > _s.length) _s.length else _to; if (_start > _end) _s.substring(_end, _start) else _s.substring(_start, _end) }))) {
                return SemverException.InvalidExtension(version)
            }
            core = run { val _s = version; val _from = 0; val _to = dash; val _start = if (_from < 0) 0 else if (_from > _s.length) _s.length else _from; val _end = if (_to < 0) 0 else if (_to > _s.length) _s.length else _to; if (_start > _end) _s.substring(_end, _start) else _s.substring(_start, _end) }
        }
        val parts = core.split(".")
        if ((parts.size != 3 || !Semver.validNumeric(parts[0]) || !Semver.validNumeric(parts[1]) || !Semver.validNumeric(parts[2]))) {
            return SemverException.InvalidCore(version)
        }
        return null
    }

    private fun parseUnvalidated(version: String): Version {
        val dash = version.indexOf("-")
        val plus = version.indexOf("+")
        val end = (if ((plus >= 0)) plus else version.length)
        var pre = mutableListOf<String>()
        if ((dash >= 0)) {
            pre = Semver.splitParts(run { val _s = version; val _from = dash + 1; val _to = end; val _start = if (_from < 0) 0 else if (_from > _s.length) _s.length else _from; val _end = if (_to < 0) 0 else if (_to > _s.length) _s.length else _to; if (_start > _end) _s.substring(_end, _start) else _s.substring(_start, _end) })
        }
        var core = version
        if ((dash >= 0)) {
            core = run { val _s = version; val _from = 0; val _to = dash; val _start = if (_from < 0) 0 else if (_from > _s.length) _s.length else _from; val _end = if (_to < 0) 0 else if (_to > _s.length) _s.length else _to; if (_start > _end) _s.substring(_end, _start) else _s.substring(_start, _end) }
        } else {
            if ((plus >= 0)) {
                core = run { val _s = version; val _from = 0; val _to = plus; val _start = if (_from < 0) 0 else if (_from > _s.length) _s.length else _from; val _end = if (_to < 0) 0 else if (_to > _s.length) _s.length else _to; if (_start > _end) _s.substring(_end, _start) else _s.substring(_start, _end) }
            }
        }
        val parts = core.split(".")
        val v = Version(major = Semver.intOf(parts[0]), minor = Semver.intOf(parts[1]), patch = Semver.intOf(parts[2]), pre = pre)
        return v
    }

    fun parse(version: String): Version? {
        val f = Semver.parseFault(version)
        if ((f != null)) {
            return null
        }
        return Semver.parseUnvalidated(version)
    }

    fun require(version: String): Version {
        val f = Semver.parseFault(version)
        if ((f != null)) {
            throw Semver.exceptionOf(f)
        }
        return Semver.parseUnvalidated(version)
    }

    fun isPrerelease(version: String): Boolean {
        val v = Semver.parse(version)
        return v != null && v.pre.size > 0
    }

    private fun pre(a: MutableList<String>, b: MutableList<String>): Int {
        if ((a.size == 0 && b.size == 0)) {
            return 0
        }
        if ((a.size == 0)) {
            return 1
        }
        if ((b.size == 0)) {
            return -1
        }
        val n = (if ((a.size < b.size)) a.size else b.size)
        for (i in 0 until n) {
            val x = a[i]
            val y = b[i]
            val xd = Semver.validNumeric(x)
            val yd = Semver.validNumeric(y)
            if ((xd && yd)) {
                val d = Semver.intOf(x) - Semver.intOf(y)
                if ((d != 0)) {
                    return d
                }
            } else {
                if ((xd != yd)) {
                    return (if ((xd)) -1 else 1)
                } else {
                    if ((x != y)) {
                        return (if ((x < y)) -1 else 1)
                    }
                }
            }
        }
        return a.size - b.size
    }

    fun compare(a: String, b: String): Int {
        val x = Semver.require(a)
        val y = Semver.require(b)
        if ((x.major != y.major)) {
            return x.major - y.major
        }
        if ((x.minor != y.minor)) {
            return x.minor - y.minor
        }
        if ((x.patch != y.patch)) {
            return x.patch - y.patch
        }
        return Semver.pre(x.pre, y.pre)
    }
}

data class Version(
    var major: Int,
    var minor: Int,
    var patch: Int,
    var pre: MutableList<String>
)
