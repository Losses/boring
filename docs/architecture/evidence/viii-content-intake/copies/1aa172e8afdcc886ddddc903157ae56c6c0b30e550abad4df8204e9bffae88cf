import re, sys, os, json, collections
stdout = sys.argv[1]; repo = sys.argv[2]
lines = open(stdout, encoding="utf-8", errors="replace").read().split("\n")
sum_start = next(i for i,l in enumerate(lines) if re.match(r"^\d+ tests failed:$", l))
fail_re = re.compile(r"^\(fail\) (.+?)(?: \[([0-9.]+)ms\])?$")
to_re = re.compile(r"^  \^ this test timed out after (\d+)ms\.$")
recs = {}
cur = None
for i,l in enumerate(lines[:sum_start]):
    if l.rstrip().endswith(":") and (l.startswith("tests/") or l.startswith("packages/")):
        cur = l.rstrip()[:-1]
    m = fail_re.match(l)
    if not m: continue
    name, el = m.group(1), m.group(2)
    t = to_re.match(lines[i+1]) if i+1 < len(lines) else None
    r = recs.setdefault(name, {"file": cur, "elapsed": [], "budget": None, "timeout": False})
    if el: r["elapsed"].append(float(el))
    if t: r["budget"] = int(t.group(1)); r["timeout"] = True
out = []
for name, r in recs.items():
    if not r["timeout"]: continue
    path = os.path.join(repo, r["file"])
    src = open(path, encoding="utf-8", errors="replace").read().split("\n")
    segs = [s.strip() for s in name.split(" > ")]
    leaf = segs[-1]
    hits = [j+1 for j,s in enumerate(src) if re.search(re.escape(json.dumps(leaf)[1:-1]), s)]
    if not hits:
        hits = [j+1 for j,s in enumerate(src) if leaf[:40] in s]
    out.append({"name": name, "file": r["file"], "elapsed": sorted(r["elapsed"]), "budget": r["budget"], "lines": hits})
for o in sorted(out, key=lambda o:(-o["budget"], o["file"])):
    print(f'{o["budget"]:>7} {str(o["elapsed"]):>22} {o["file"]}:{o["lines"]}  {o["name"]}')
json.dump(out, open(sys.argv[3],"w"), indent=1)
print("TOTAL", len(out))
