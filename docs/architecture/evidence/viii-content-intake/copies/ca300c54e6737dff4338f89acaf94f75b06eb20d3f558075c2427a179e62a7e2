package mx;

import std.ReadOnlyArray;
import mx.MXSupport.QError;
import mx.MXSupport.QSource;

/**
	Control for P4: the SAME expression block at member scope, in a member whose
	own return type is already ReadOnlyArray<Int>. currentReturnType is that
	ReadOnlyArray in BOTH trees, so both must behave alike -- this shows whether
	blockExpression's read of currentReturnType was already wrong before the fix.
**/
class MXBlockMember {
	static function len(a:Array<Int>):Int
		return a.length;

	inline static function two(a:Array<Int>):Array<Int> {
		final s = a.length;
		return a.slice(s, 0);
	}

	public static function pBlockMemberReadOnly():ReadOnlyArray<Int> {
		final src:Array<Int> = QSource.first();
		final n:Int = len(two(src));
		if (n < 0) {
			throw new QError();
		}
		return src;
	}

	// the same block in a member whose return type is NOT read-only
	public static function pBlockMemberPlain():Int {
		final src:Array<Int> = QSource.first();
		return len(two(src));
	}
}
