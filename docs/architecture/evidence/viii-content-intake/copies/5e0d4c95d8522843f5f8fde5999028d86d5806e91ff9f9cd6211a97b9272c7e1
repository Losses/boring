#![cfg(test)]

use crate::boring::deferred_locals_ops::DeferredLocalsOps;
use crate::runtime::test as testlib;
use crate::runtime::test_core;
use crate::runtime::u_string::UStr;


#[test]
fn test_deferred_locals() {
    testlib::run("tests.DeferredLocalsTests.testDeferredLocals", "tests.DeferredLocalsTests.testDeferredLocals: deferred locals initialize along control-flow paths", || {
        test_core::TestCore::test_core_equals_int(2i32, i32::from_ne_bytes(((DeferredLocalsOps::deferred_locals_ops_tier_of(4)) as i32).to_ne_bytes()), UStr::new(&[105,102,32,98,114,97,110,99,104]));
        test_core::TestCore::test_core_equals_int(1i32, i32::from_ne_bytes(((DeferredLocalsOps::deferred_locals_ops_tier_of(1)) as i32).to_ne_bytes()), UStr::new(&[101,108,115,101,32,98,114,97,110,99,104]));
        test_core::TestCore::test_core_equals_int(8i32, i32::from_ne_bytes(((DeferredLocalsOps::deferred_locals_ops_nullable_value(Some(8))) as i32).to_ne_bytes()), UStr::new(&[110,117,108,108,97,98,108,101,32,98,114,97,110,99,104]));
        test_core::TestCore::test_core_equals_int(0i32, i32::from_ne_bytes(((DeferredLocalsOps::deferred_locals_ops_nullable_value(None)) as i32).to_ne_bytes()), UStr::new(&[110,117,108,108,32,98,114,97,110,99,104]));
        test_core::TestCore::test_core_equals_int(2i32, i32::from_ne_bytes(((DeferredLocalsOps::deferred_locals_ops_loop_value(3)) as i32).to_ne_bytes()), UStr::new(&[108,111,111,112,32,97,115,115,105,103,110,109,101,110,116]));
    });
}
