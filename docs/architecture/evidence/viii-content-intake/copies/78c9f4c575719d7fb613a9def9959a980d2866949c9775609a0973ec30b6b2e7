+#!/usr/bin/env bash
+# Stage runner for the swift-rt-probe fixture (t-mun5d99p-op76 / t-mun75tk1-h36w).
+# Usage: EV=<evidence dir> bash a/tests/haxe/swift-rt-probe/run-stages.sh
+# Run inside the pinned nix develop environment. Each stage records argv,
+# separated streams, and numeric exit status under $EV/stages/<stage>/.
+#
+# Compile-set construction (fix for t-mun75tk1-h36w review finding): the
+# compile set is globbed over the ENTIRE generated tree
+#   find <gen-tree> -name '*.swift' ! -name native-main.swift ! -name Package.swift
+# which includes tree-root Runtime.swift whenever the compiler emits it.
+# The earlier formulation (find std <module> -name '*.swift') structurally
+# excluded the tree root, so pre/post patches were indistinguishable: the
+# fixture measured "Runtime.swift in argv", not the patch. Assertion
+# semantics are unchanged: this fixture still asserts "the leg compiles
+# and runs".
+set -uo pipefail
+HERE="$(cd "$(dirname "$0")" && pwd)"
+NAME="$(basename "$HERE")"        # swift-rt-probe / swift-rt-plain
+MOD="${NAME#swift-rt-}"           # probe / plain
+ROOT="${FIXTURE_WORKTREE_ROOT:-$(cd "$HERE/../../.." && pwd)}"
+if [ ! -f "$ROOT/flake.nix" ] || [ ! -f "$ROOT/tests/haxe/$NAME/expected.txt" ]; then
+	printf '%s: worktree root misresolved: %s\n' "$NAME" "$ROOT" >&2
+	printf '%s: set FIXTURE_WORKTREE_ROOT=<worktree root> explicitly\n' "$NAME" >&2
+	exit 2
+fi
+EV="${EV:?EV must point at the evidence directory}"
+OUTREL="${FIXTURE_OUTREL:-out/swift-rt-fx/$MOD}"
+GEN="$ROOT/$OUTREL"
+cd "$ROOT"
+STAGES="$EV/stages"
+mkdir -p "$STAGES"
+TAB="$(printf '\t')"
+
+record() {
+	printf '%s%s%s%s%s\n' "$1" "$TAB" "$TAB$2" "$TAB" "$3" >>"$EV/status.tsv"
+	printf '%s observed=%s\n' "$1" "$2"
+}
+
+stage() {
+	local name=$1 expected=$2
+	shift 2
+	local dir="$STAGES/$name"
+	mkdir -p "$dir"
+	{
+		printf 'cwd %s\nargv' "$ROOT"
+		printf ' %q' "$@"
+		printf '\n'
+	} >"$dir/argv"
+	( cd "$ROOT" && "$@" ) >"$dir/stdout" 2>"$dir/stderr"
+	local observed=$?
+	printf '%s\n' "$observed" >"$dir/status"
+	record "$name" "$observed" "$expected"
+	return "$observed"
+}
+
+not_reached() {
+	local producer=$1 observed=$2
+	shift 2
+	for name in "$@"; do
+		record "$name" "producer-$producer-status-$observed" "not-reached"
+	done
+}
+
+# ---- swift toolchain resolution (same bwrap limitation as elsewhere):
+# the flake wrapper fails (bwrap uid map), fall back to store raw swiftc.
+SWIFTC_WRAPPER="$(command -v swiftc || true)"
+SWIFTC=""
+SWIFT_MODE=""
+if [ -n "$SWIFTC_WRAPPER" ] && timeout 60 "$SWIFTC_WRAPPER" --version >"$STAGES/swiftc-wrapper-probe.stdout" 2>"$STAGES/swiftc-wrapper-probe.stderr"; then
+	SWIFTC="$SWIFTC_WRAPPER"
+	SWIFT_MODE=wrapper
+else
+	SWIFTROOT="$(grep -o '/nix/store/[^"]*-swift-toolchain-[^"]*' "$SWIFTC_WRAPPER" 2>/dev/null | head -1 | sed 's#/usr/bin/swiftc$##' || true)"
+	FHSSCRIPT="$(grep -o '/nix/store/[^"]*-swift-[0-9.]*-fhs/bin/[a-z0-9.-]*' "$SWIFTC_WRAPPER" 2>/dev/null | head -1 || true)"
+	if [ -n "$SWIFTROOT" ] && [ -x "$SWIFTROOT/usr/bin/swiftc" ] && [ -n "$FHSSCRIPT" ] && [ -f "$FHSSCRIPT" ]; then
+		FHS_ROOTFS="$(grep -oE '/nix/store/[a-z0-9]+-swift-[0-9.]+-fhs-fhsenv-rootfs' "$FHSSCRIPT" | head -1 || true)"
+		if [ -n "$FHS_ROOTFS" ] && [ -d "$FHS_ROOTFS" ]; then
+			GLIBC_LIB="$(dirname "$(readlink -f "$FHS_ROOTFS/usr/lib64/Scrt1.o" 2>/dev/null || true)" 2>/dev/null || true)"
+			if [ -n "$GLIBC_LIB" ] && [ -f "$GLIBC_LIB/crtn.o" ]; then
+				GCCRT_DIR="$(gcc -print-libgcc-file-name 2>/dev/null | sed 's#/[^/]*$##' || true)"
+				[ -n "$GCCRT_DIR" ] && [ -f "$GCCRT_DIR/crtbeginS.o" ] || GCCRT_DIR=""
+				LIBGCCS_DIR="$(gcc -print-file-name=libgcc_s.so.1 2>/dev/null | sed 's#/[^/]*$##' || true)"
+				[ -n "$LIBGCCS_DIR" ] && [ -f "$LIBGCCS_DIR/libgcc_s.so.1" ] || LIBGCCS_DIR=""
+				if [ -n "$GCCRT_DIR" ] && [ -n "$LIBGCCS_DIR" ]; then
+					SWIFTC="$SWIFTROOT/usr/bin/swiftc"
+					SWIFT_MODE=raw
+				fi
+			fi
+		fi
+	fi
+fi
+if [ "$SWIFT_MODE" = "raw" ]; then
+	mkdir -p "$EV/swift-shim"
+	for f in Scrt1.o crti.o crtn.o; do cp "$GLIBC_LIB/$f" "$EV/swift-shim/$f" 2>/dev/null || true; done
+	for f in crtbeginS.o crtendS.o; do cp "$GCCRT_DIR/$f" "$EV/swift-shim/$f" 2>/dev/null || true; done
+fi
+printf 'mode %s\nswiftc %s\n' "$SWIFT_MODE" "${SWIFTC:-none}" >"$EV/swift-toolchain.txt"
+LDRT="$FHS_ROOTFS/usr/lib64:$FHS_ROOTFS/lib64:$SWIFTROOT/usr/lib/swift/linux:/usr/lib64:/usr/lib"
+
+# ---- 1. generate the Swift tree (tree root may or may not get Runtime.swift)
+stage gen zero bash -c "rm -rf $OUTREL && haxe tests/haxe/$NAME/gen/swift.hxml -D swift-output=$OUTREL -D swift-test-output=$OUTREL-test"
+GEN_RC=$(cat "$STAGES/gen/status")
+( cd "$ROOT" && find "$OUTREL" -type f | sort ) >"$EV/gen-tree.files"
+( cd "$ROOT" && while read -r f; do printf '%s  %s\n' "$(sha256sum "$f" | cut -d' ' -f1)" "$f"; done <"$EV/gen-tree.files" ) >"$EV/gen-tree.sha256"
+printf 'runtime-swift-present %s\n' "$([ -f "$GEN/Runtime.swift" ] && echo yes || echo no)" >"$EV/runtime-swift.txt"
+
+# ---- 2. copy the native harness into the tree root
+stage prep zero bash -c "cp tests/haxe/$NAME/native/native-main.swift $OUTREL/native-main.swift && sha256sum $OUTREL/native-main.swift"
+
+# ---- 3. compile: compile set = ENTIRE generated tree (root included) + harness
+if [ "$SWIFT_MODE" = "raw" ]; then
+	SWIFTS="$(find "$GEN" -name '*.swift' ! -name native-main.swift ! -name Package.swift | sort | tr '\n' ' ')"
+	stage compile-swift data bash -c "cd $EV/swift-shim && LD_LIBRARY_PATH='$LDRT' XDG_CACHE_HOME='${XDG_CACHE_HOME:-/tmp/swiftfix-xdg}' TMPDIR='${TMPDIR:-/tmp}' timeout 1800 $SWIFTC -o $GEN/run-bin $SWIFTS $GEN/native-main.swift -Xcc -I$FHS_ROOTFS/usr/include -L$FHS_ROOTFS/usr/lib64 -L$GCCRT_DIR -L$LIBGCCS_DIR -L$GLIBC_LIB"
+else
+	SWIFTS="$(find "$GEN" -name '*.swift' ! -name native-main.swift ! -name Package.swift | sort | tr '\n' ' ')"
+	stage compile-swift data bash -c "timeout 1800 $SWIFTC -o $GEN/run-bin $SWIFTS $GEN/native-main.swift"
+fi
+C1=$(cat "$STAGES/compile-swift/status")
+CERR="$STAGES/compile-swift/stderr"
+TOTAL=$(grep -c ' error: ' "$CERR" 2>/dev/null || true)
+BORING=$(grep -c "cannot find type 'BoringException'" "$CERR" 2>/dev/null || true)
+OTHER=$((TOTAL - BORING)); [ "$OTHER" -lt 0 ] && OTHER=0
+printf 'exit\t%s\nboring-missing\t%s\nother-type-errors\t%s\ntotal-errors\t%s\n' "$C1" "$BORING" "$OTHER" "$TOTAL" >"$EV/compile-counts.tsv"
+
+# ---- 4. run (off-fuse: copy binary to /tmp, mount strips exec bit) + compare
+if [ "$GEN_RC" = "0" ] && [ "$C1" = "0" ]; then
+	RUNBIN="/tmp/swift-rt-fx-run-$$"
+	stage run-swift zero bash -c "cp $GEN/run-bin $RUNBIN && chmod 755 $RUNBIN && cd $GEN && LD_LIBRARY_PATH='$LDRT' timeout 300 $RUNBIN; rc=\$?; rm -f $RUNBIN; exit \$rc"
+	R1=$(cat "$STAGES/run-swift/status")
+	if [ "$R1" = "0" ]; then
+		diff -u "tests/haxe/$NAME/expected.txt" "$STAGES/run-swift/stdout" >"$STAGES/compare-swift.stdout" 2>"$STAGES/compare-swift.stderr"
+		record "compare-swift" "$?" "0-identical-nonzero-differs"
+	else
+		record "compare-swift" "producer-run-swift-status-$R1" "not-reached"
+	fi
+else
+	not_reached compile-swift "$C1" run-swift compare-swift
+fi
+
+printf 'fixture\t%s\nroot\t%s\n' "$NAME" "$ROOT" >"$EV/identity.txt"
+git -C "$ROOT" rev-parse HEAD >>"$EV/identity.txt" 2>/dev/null || true
+sha256sum "tests/haxe/$NAME/probe/Probe.hx" "tests/haxe/$NAME/plain/Plain.hx" "tests/haxe/$NAME/gen/swift.hxml" "tests/haxe/$NAME/native/native-main.swift" "tests/haxe/$NAME/expected.txt" >>"$EV/identity.txt" 2>/dev/null
+# summary line for cross-attempt diffing: fixture ROOT exit boring other
+printf '%s\t%s\t%s\t%s\t%s\n' "$NAME" "$ROOT" "$C1" "$BORING" "$OTHER" >"$EV/summary.tsv"
+exit 0
