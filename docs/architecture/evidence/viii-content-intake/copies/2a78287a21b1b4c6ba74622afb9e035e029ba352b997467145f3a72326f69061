use crate::runtime::u_string::UString;


#[derive(Clone, Copy)]
pub struct DartLocalNameFixOps;

impl DartLocalNameFixOps {
    pub fn dart_local_name_fix_ops_local_shadow() -> UString {
        let text = UString::from("value").to_ustring();
        return UString::from(format!("{}", { let mut __s = UString::new(); __s += text.as_ustr(); __s += &(UString::from("!")); __s }).as_str());
