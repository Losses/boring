package tests

import boring.SwitchCaseScopeOps
import boring.ToneKind
import boring.runtime.test.Test

class SwitchCaseScopeTests {
@boring.test.Test
    fun testToneRow() {
        Test.run("tests.SwitchCaseScopeTests.testToneRow", "tests.SwitchCaseScopeTests.testToneRow: multiple cases declaring the same name resolve without collision") {
                Test.equals(0, SwitchCaseScopeOps.toneRow(ToneKind.Yinping, 5), null)
                Test.equals(10, SwitchCaseScopeOps.toneRow(ToneKind.Yangping, 5), null)
                Test.equals(15, SwitchCaseScopeOps.toneRow(ToneKind.Shang, 5), null)
                Test.equals(20, SwitchCaseScopeOps.toneRow(ToneKind.Qu, 5), null)
                Test.equals(0, SwitchCaseScopeOps.toneRow(ToneKind.Neutral, 5), null)
                Test.equals(25, SwitchCaseScopeOps.toneRow(ToneKind.Ru, 5), null)
        }
    }

@boring.test.Test
    fun testToneInk() {
        Test.run("tests.SwitchCaseScopeTests.testToneInk", "tests.SwitchCaseScopeTests.testToneInk: cases declaring multiple locals resolve without collision") {
                Test.equals(0.0, SwitchCaseScopeOps.toneInk(ToneKind.Yinping, 1.0, 2.0), null)
                Test.equals(3.0, SwitchCaseScopeOps.toneInk(ToneKind.Yangping, 1.0, 2.0), null)
                Test.equals(6.0, SwitchCaseScopeOps.toneInk(ToneKind.Shang, 1.0, 2.0), null)
                Test.equals(9.0, SwitchCaseScopeOps.toneInk(ToneKind.Qu, 1.0, 2.0), null)
                Test.equals(0.0, SwitchCaseScopeOps.toneInk(ToneKind.Neutral, 1.0, 2.0), null)
                Test.equals(12.0, SwitchCaseScopeOps.toneInk(ToneKind.Ru, 1.0, 2.0), null)
        }
    }

@boring.test.Test
    fun testMixed() {
        Test.run("tests.SwitchCaseScopeTests.testMixed", "tests.SwitchCaseScopeTests.testMixed: mixed declaring and non-declaring cases coexist") {
                Test.equals(1, SwitchCaseScopeOps.mixed(ToneKind.Yinping, 5), null)
                Test.equals(2, SwitchCaseScopeOps.mixed(ToneKind.Yangping, 5), null)
                Test.equals(15, SwitchCaseScopeOps.mixed(ToneKind.Shang, 5), null)
                Test.equals(25, SwitchCaseScopeOps.mixed(ToneKind.Qu, 5), null)
                Test.equals(3, SwitchCaseScopeOps.mixed(ToneKind.Neutral, 5), null)
                Test.equals(35, SwitchCaseScopeOps.mixed(ToneKind.Ru, 5), null)
        }
    }
}
