#!/usr/bin/env bun
// Independent re-measurement driver for the npm artifact entry-set question.
// Written for this verification; it replicates the *post-fix* rewriteHxml
// (no module-list filter, no fixture mutation) so that MODE=real vs MODE=stub
// differ in exactly one variable: the content of samples/boring/MathNaNTestSupport.hx.
//
// usage: bun repro-verify.mjs <TREE> <real|stub|stub-harness> <N> <TAG>
import * as crypto from "node:crypto";
import * as fs from "node:fs";
import * as os from "node:os";
import * as path from "node:path";

const TREE = path.resolve(process.argv[2]);
const MODE = process.argv[3];
const N = Number(process.argv[4] ?? 3);
const TAG = process.argv[5] ?? "v";
const TSC = path.join(TREE, "node_modules/typescript/bin/tsc");
const FILTER = process.env.FILTER === "1";
const KEEP = process.env.KEEP === "1";
const FIXTURE = path.join(TREE, "samples/boring/MathNaNTestSupport.hx");
const STUB = "package boring;\nclass MathNaNTestSupport {\n    public static function assertNaN(value:Float, message:String):Void {}\n    public static function assertNegativeZero(value:Float, message:String):Void {}\n    public static function assertPositiveZero(value:Float, message:String):Void {}\n}\n";

function sha256(buf) { return crypto.createHash("sha256").update(buf).digest("hex"); }
function sha256file(p) { return sha256(fs.readFileSync(p)); }

function rewriteHxml(name, root, extra = []) {
  const source = fs.readFileSync(path.join(TREE, "examples", name), "utf8");
  let out = source.replace(/reference\/[a-z0-9-]+(\/[a-z0-9-]+)*/g, m => m.replace("reference", root));
  out = out.replace("-D runtime-import=@boring/runtime", "-D runtime-import=./runtime");
  out = out.replace("-D package-shell=none\n", "");
  if (FILTER) out = out.replaceAll("boring.MathNaNTestSupport\n", "");
  out += "-D package-artifacts=emit\n";
  for (const line of extra) out += line + "\n";
  return out;
}

function fixtureState() {
  const text = fs.readFileSync(FIXTURE, "utf8");
  return { sha256: sha256file(FIXTURE), bytes: Buffer.byteLength(text), testEquals: (text.match(/Test\.equals/g) || []).length, stub: text === STUB };
}

const pristine = fs.readFileSync(FIXTURE);
console.log(JSON.stringify({ event: "tree", tree: TREE, mode: MODE, n: N, tag: TAG, tsc: TSC, fixture_pristine_sha256: sha256(pristine), fixture_pristine_testEquals: (pristine.toString().match(/Test\.equals/g) || []).length }));

const fixtureHashes = new Set();
const results = [];
for (let i = 0; i < N; i++) {
  const root = fs.mkdtempSync(path.join(os.tmpdir(), `vfy-npm-${TAG}-${i}-`));   // fresh root per generation
  const hxmlName = `verify-npm-${TAG}-${i}.hxml`;
  const hxmlPath = path.join(TREE, "out", hxmlName);
  fs.mkdirSync(path.dirname(hxmlPath), { recursive: true });
  fs.writeFileSync(hxmlPath, rewriteHxml("ts.hxml", root, [`-D package-tsc=${TSC}`]));

  const before = fixtureState();
  let hidden = false;
  if (MODE === "stub") { fs.writeFileSync(FIXTURE, STUB); hidden = true; }
  const mid = fixtureState();

  const t0 = Date.now();
  const proc = Bun.spawnSync(["haxe", path.relative(TREE, hxmlPath)], { cwd: TREE });
  const ms = Date.now() - t0;
  const exitCode = proc.exitCode;
  const stderr = proc.stderr.toString();

  if (hidden) fs.writeFileSync(FIXTURE, pristine);   // restore the pristine committed bytes
  const after = fixtureState();

  fixtureHashes.add(before.sha256); fixtureHashes.add(mid.sha256); fixtureHashes.add(after.sha256);

  const line = { gen: i, exitCode, stderr_len: stderr.length, stderr_head: stderr.slice(0, 400), ms, root,
                 fixture_before: before, fixture_mid: mid, fixture_after: after };
  if (exitCode === 0) {
    const tgz = path.join(root, "ts", "generated-0.1.0.tgz");
    if (!fs.existsSync(tgz)) { line.error = "no tgz"; }
    else {
      const buf = fs.readFileSync(tgz);
      const names = Bun.spawnSync(["tar", "tzf", tgz]).stdout.toString().split("\n").filter(Boolean);
      line.entries = names.length;
      line.sha256 = sha256(buf);
      line.bytes = buf.length;
      line.nan = names.filter(n => n.includes("MathNaNTestSupport"));
      line.runtime_test = names.filter(n => n.includes("runtime/test"));
      line.ts_sources = names.filter(n => n.endsWith(".ts") && !n.endsWith(".d.ts"));
      line.sha256_listing = sha256(Buffer.from(names.join("\n")));
      // tar member metadata for the NaN entries + first entries (dates pinned?)
      const v = Bun.spawnSync(["tar", "-tvzf", tgz]).stdout.toString().split("\n").filter(Boolean);
      line.tar_meta_first3 = v.slice(0, 3).map(s => s.replace(/\s+/g, " "));
      line.tar_meta_nan = v.filter(s => s.includes("MathNaNTestSupport")).map(s => s.replace(/\s+/g, " "));
      line.sorted = JSON.stringify(names) === JSON.stringify([...names].sort());
    }
  }
  console.log(JSON.stringify(line));
  results.push(line);
  if (!KEEP) fs.rmSync(root, { recursive: true, force: true });
}
const ok = results.filter(r => r.exitCode === 0 && r.sha256);
const uniq = new Set(ok.map(r => r.sha256));
console.log(JSON.stringify({ event: "summary", mode: MODE, tag: TAG, generations: results.length, compiled_ok: ok.length,
  entry_counts: [...new Set(ok.map(r => r.entries))], unique_hashes: uniq.size, hashes: [...uniq],
  fixture_states_seen: [...fixtureHashes], all_sorted: ok.every(r => r.sorted === true) }));
if (fs.readFileSync(FIXTURE).compare(pristine) !== 0) { console.log(JSON.stringify({ event: "FIXTURE_RESTORE_FAILED" })); process.exit(3); }
