// Reproduces the FULL package-artifacts byte-identity test loop (all 5
// packages, two generations each), keeps both roots, and reports per-package
// byte comparison. For any differing archive it unpacks and identifies the
// entries that differ (name/size/mtime/content).
// Run: bun identity-inspect-all.ts
import * as crypto from "node:crypto";
import * as fs from "node:fs";
import * as os from "node:os";
import * as path from "node:path";
import * as zlib from "node:zlib";

const REPO_ROOT = "/home/losses/Development/tq-workspace/boring-wt-architecture";
const TSC = path.join(REPO_ROOT, "node_modules/typescript/bin/tsc");

function rewriteHxml(name: string, root: string, extra: string[] = []): string {
  const source = fs.readFileSync(path.join(REPO_ROOT, "examples", name), "utf8");
  let out = source.replace(/reference\/[a-z0-9-]+(\/[a-z0-9-]+)*/g, (match) =>
    match.replace("reference", root),
  );
  out = out.replace("-D runtime-import=@boring/runtime", "-D runtime-import=./runtime");
  out = out.replace("-D package-shell=none\n", "");
  out = out.replaceAll("boring.MathNaNTestSupport\n", "");
  out += "-D package-artifacts=emit\n";
  for (const line of extra) out += line + "\n";
  return out;
}

async function runHaxe(hxmlName: string, content: string): Promise<{ exitCode: number | null; stderr: string }> {
  const hxmlPath = path.join(REPO_ROOT, "out", hxmlName);
  fs.mkdirSync(path.dirname(hxmlPath), { recursive: true });
  fs.writeFileSync(hxmlPath, content);
  const probe = path.join(REPO_ROOT, "samples/boring/MathNaNTestSupport.hx");
  const isTs = content.includes("ts-output") || hxmlName.includes("npm") || hxmlName.includes("tsc") || hxmlName.includes("id-");
  let hidden = false;
  let backup = "";
  const stub = "package boring;\nclass MathNaNTestSupport {\n    public static function assertNaN(value:Float, message:String):Void {}\n    public static function assertNegativeZero(value:Float, message:String):Void {}\n    public static function assertPositiveZero(value:Float, message:String):Void {}\n}\n";
  if (isTs && fs.existsSync(probe)) {
    backup = fs.readFileSync(probe, "utf8");
    fs.writeFileSync(probe, stub);
    hidden = true;
  }
  try {
    const proc = Bun.spawn(["haxe", path.relative(REPO_ROOT, hxmlPath)], {
      cwd: REPO_ROOT, stdout: "pipe", stderr: "pipe",
    });
    const [exitCode, stderr] = await Promise.all([proc.exited, new Response(proc.stderr).text()]);
    return { exitCode, stderr };
  } finally {
    if (hidden) fs.writeFileSync(probe, backup);
  }
}

type Entry = { name: string; size: number; mtime: number; digest: string };
function listTarEntries(tar: Buffer): Entry[] {
  const out: Entry[] = [];
  let off = 0;
  while (off + 512 <= tar.length) {
    const header = tar.subarray(off, off + 512);
    if (header.every((b) => b === 0)) break;
    const name = header.subarray(0, 100).toString("utf8").replace(/\0+$/, "");
    const size = parseInt((header.subarray(124, 136).toString("utf8").replace(/\0+$/g, "").trim() || "0"), 8);
    const mtime = parseInt((header.subarray(136, 148).toString("utf8").replace(/\0+$/g, "").trim() || "0"), 8);
    const body = tar.subarray(off + 512, off + 512 + size);
    out.push({ name, size, mtime, digest: crypto.createHash("sha256").update(body).digest("hex").slice(0, 16) });
    off += 512 + Math.ceil(size / 512) * 512;
  }
  return out;
}
function unzip(buf: Buffer): Buffer {
  // zip: central directory at end; find EOCD, read entries
  // Use unzip via child process instead for simplicity:
  const tmp = fs.mkdtempSync(path.join(os.tmpdir(), "ziptmp-"));
  const zipPath = path.join(tmp, "a.zip");
  fs.writeFileSync(zipPath, buf);
  const proc = Bun.spawnSync(["/usr/bin/unzip", "-o", "-q", zipPath, "-d", path.join(tmp, "x")]);
  if (proc.exitCode !== 0) throw new Error(`unzip failed: ${proc.stderr.toString()}`);
  const out: Entry[] = [];
  const walk = (dir: string, prefix: string) => {
    for (const e of fs.readdirSync(dir, { withFileTypes: true })) {
      const p = path.join(dir, e.name);
      const rel = prefix + e.name;
      if (e.isDirectory()) walk(p, rel + "/");
      else {
        const b = fs.readFileSync(p);
        out.push({ name: rel, size: b.length, mtime: 0, digest: crypto.createHash("sha256").update(b).digest("hex").slice(0, 16) });
      }
    }
  };
  walk(path.join(tmp, "x"), "");
  fs.rmSync(tmp, { recursive: true, force: true });
  return (undefined as any) as never; // replaced below
}
function zipEntries(buf: Buffer): Entry[] {
  const tmp = fs.mkdtempSync(path.join(os.tmpdir(), "ziptmp-"));
  const zipPath = path.join(tmp, "a.zip");
  fs.writeFileSync(zipPath, buf);
  const outDir = path.join(tmp, "x");
  const proc = Bun.spawnSync(["/usr/bin/unzip", "-o", "-q", zipPath, "-d", outDir]);
  if (proc.exitCode !== 0) throw new Error(`unzip failed: ${proc.stderr.toString()}`);
  const out: Entry[] = [];
  const walk = (dir: string, prefix: string) => {
    for (const e of fs.readdirSync(dir, { withFileTypes: true }).sort((a, b) => a.name.localeCompare(b.name))) {
      const p = path.join(dir, e.name);
      const rel = prefix + e.name;
      if (e.isDirectory()) walk(p, rel + "/");
      else {
        const b = fs.readFileSync(p);
        out.push({ name: rel, size: b.length, mtime: 0, digest: crypto.createHash("sha256").update(b).digest("hex").slice(0, 16) });
      }
    }
  };
  walk(outDir, "");
  fs.rmSync(tmp, { recursive: true, force: true });
  return out;
}
function jarEntries(buf: Buffer): Entry[] {
  return zipEntries(buf);
}

const keepDir = fs.mkdtempSync(path.join(os.tmpdir(), "boring-identity-all-"));
const first = path.join(keepDir, "first");
const second = path.join(keepDir, "second");
fs.mkdirSync(first, { recursive: true });
fs.mkdirSync(second, { recursive: true });

const packages = [
  { hxml: "ts.hxml", file: "ts/generated-0.1.0.tgz", extra: [`-D package-tsc=${TSC}`], kind: "tgz" },
  { hxml: "rust.hxml", file: "rust/boring-codec-gen-0.1.0.crate", extra: [], kind: "crate" },
  { hxml: "swift.hxml", file: "swift/generated-0.1.0.zip", extra: [], kind: "zip" },
  { hxml: "dart.hxml", file: "dart/generated-0.1.0.tar.gz", extra: [], kind: "tgz" },
  { hxml: "kotlin.hxml", file: "kotlin/maven/generated/generated/0.1.0/generated-0.1.0.jar", extra: ["-D package-kotlinc=kotlinc"], kind: "jar" },
];

let anyDiff = false;
for (const pkg of packages) {
  const t0 = Date.now();
  const a = await runHaxe(`package-artifacts-idall-a.hxml`, rewriteHxml(pkg.hxml, first, pkg.extra));
  const t1 = Date.now();
  const b = await runHaxe(`package-artifacts-idall-b.hxml`, rewriteHxml(pkg.hxml, second, pkg.extra));
  const t2 = Date.now();
  console.log(`== ${pkg.hxml} (${pkg.file}) genA rc=${a.exitCode} ${t1 - t0}ms genB rc=${b.exitCode} ${t2 - t1}ms stderrA="${a.stderr.slice(0, 120)}" stderrB="${b.stderr.slice(0, 120)}"`);
  const fA = path.join(first, pkg.file);
  const fB = path.join(second, pkg.file);
  const bufA = fs.readFileSync(fA);
  const bufB = fs.readFileSync(fB);
  if (Buffer.compare(bufA, bufB) === 0) {
    console.log(`   IDENTICAL (${bufA.length} bytes)`);
    continue;
  }
  anyDiff = true;
  console.log(`   DIFFERS: A=${bufA.length} B=${bufB.length} delta=${bufB.length - bufA.length}`);
  if (pkg.kind === "tgz" || pkg.kind === "crate") {
    const eA = listTarEntries(zlib.gunzipSync(bufA));
    const eB = listTarEntries(zlib.gunzipSync(bufB));
    console.log(`   entries A=${eA.length} B=${eB.length}`);
    const mapA = new Map(eA.map((e) => [e.name, e]));
    for (const eb of eB) {
      const ea = mapA.get(eb.name);
      if (!ea) { console.log(`   only in B: ${eb.name} (${eb.size}b)`); continue; }
      const diffs: string[] = [];
      if (ea.size !== eb.size) diffs.push(`size ${ea.size}->${eb.size}`);
      if (ea.digest !== eb.digest) diffs.push("content");
      if (ea.mtime !== eb.mtime) diffs.push(`mtime ${ea.mtime}->${eb.mtime} (${new Date(ea.mtime * 1000).toISOString()} -> ${new Date(eb.mtime * 1000).toISOString()})`);
      if (diffs.length) console.log(`   DIFF ${eb.name}: ${diffs.join(", ")}`);
    }
    for (const ea of eA) if (!eB.some((e) => e.name === ea.name)) console.log(`   only in A: ${ea.name} (${ea.size}b)`);
  } else {
    const eA = pkg.kind === "zip" ? zipEntries(bufA) : jarEntries(bufA);
    const eB = pkg.kind === "zip" ? zipEntries(bufB) : jarEntries(bufB);
    console.log(`   entries A=${eA.length} B=${eB.length}`);
    const mapA = new Map(eA.map((e) => [e.name, e]));
    for (const eb of eB) {
      const ea = mapA.get(eb.name);
      if (!ea) { console.log(`   only in B: ${eb.name} (${eb.size}b)`); continue; }
      if (ea.size !== eb.size || ea.digest !== eb.digest) console.log(`   DIFF ${eb.name}: size ${ea.size}->${eb.size} content=${ea.digest === eb.digest ? "same" : "diff"}`);
    }
    for (const ea of eA) if (!eB.some((e) => e.name === ea.name)) console.log(`   only in A: ${ea.name} (${ea.size}b)`);
  }
}
console.log(`ANY_DIFF=${anyDiff}`);
console.log(`KEEP: ${keepDir}`);
