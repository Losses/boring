package tests

import boring.NumericDomainOps
import boring.runtime.test.Test

class NumericDomainTests {
@boring.test.Test
    fun testPrefixUnit() {
        Test.run("tests.NumericDomainTests.testPrefixUnit", "tests.NumericDomainTests.testPrefixUnit: A positive-checked index stays unsigned in charCodeAt") {
                Test.equals(65, NumericDomainOps.prefixUnit("AB", 1), null)
                Test.equals(0, NumericDomainOps.prefixUnit("AB", 0), null)
        }
    }

@boring.test.Test
    fun testOffsets() {
        Test.run("tests.NumericDomainTests.testOffsets", "tests.NumericDomainTests.testOffsets: Loop offsets stay in the u32 domain") {
                Test.equals(3, NumericDomainOps.offsets("abcd").size, null)
                Test.equals(1, NumericDomainOps.offsets("abcd")[0], null)
                Test.equals(3, NumericDomainOps.offsets("abcd")[2], null)
        }
    }

@boring.test.Test
    fun testFindIndex() {
        Test.run("tests.NumericDomainTests.testFindIndex", "tests.NumericDomainTests.testFindIndex: A negative sentinel local assigns from a u32 loop index") {
                Test.equals(30, NumericDomainOps.findIndex(mutableListOf<Int>(10, 20, 30), 30), null)
                Test.equals(0, NumericDomainOps.findIndex(mutableListOf<Int>(10, 20, 30), 99), null)
        }
    }

@boring.test.Test
    fun testBeforeChar() {
        Test.run("tests.NumericDomainTests.testBeforeChar", "tests.NumericDomainTests.testBeforeChar: An i32 index reaches the u32 charCodeAt slot") {
                Test.equals(65, NumericDomainOps.beforeChar("AB", 2), null)
        }
    }

@boring.test.Test
    fun testColonPair() {
        Test.run("tests.NumericDomainTests.testColonPair", "tests.NumericDomainTests.testColonPair: An i32 indexOf result feeds a u32 vec literal") {
                val pair = NumericDomainOps.colonPair("a:b", 0)
                Test.equals(2, pair.size, null)
                Test.equals(0, pair[0], null)
                Test.equals(2, pair[1], null)
                Test.equals(0, NumericDomainOps.colonPair("ab", 0).size, null)
        }
    }

@boring.test.Test
    fun testCollectOffsets() {
        Test.run("tests.NumericDomainTests.testCollectOffsets", "tests.NumericDomainTests.testCollectOffsets: An i32 offset pushes into a u32 array") {
                Test.equals(3, NumericDomainOps.collectOffsets("abcd").size, null)
                Test.equals(1, NumericDomainOps.collectOffsets("abcd")[0], null)
        }
    }
}
