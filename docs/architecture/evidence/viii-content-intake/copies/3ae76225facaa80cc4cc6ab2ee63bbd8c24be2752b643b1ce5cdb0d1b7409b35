package boring

object SwitchMergeOps {
    fun grouped(value: SwitchMergeValue): String {
        return when (value) {
            is SwitchMergeValue.First -> "grouped:" + value.value
            is SwitchMergeValue.Second -> "grouped:" + value.value
            is SwitchMergeValue.Third -> "third"
        }
    }

    fun groupedPlain(value: SwitchMergeValue): String {
        return when (value) {
            is SwitchMergeValue.First -> "plain"
            is SwitchMergeValue.Second -> "plain"
            is SwitchMergeValue.Third -> "third"
        }
    }

    fun single(value: SwitchMergeValue): String {
        return when (value) {
            is SwitchMergeValue.First -> "first:" + value.value
            is SwitchMergeValue.Second -> "second:" + value.value
            is SwitchMergeValue.Third -> "third"
        }
    }

    fun partial(value: SwitchMergeValue): String {
        var result: String
        when (value) {
    is SwitchMergeValue.First -> result = "partial:" + value.value
    is SwitchMergeValue.Second -> result = "partial:" + value.value
    is SwitchMergeValue.Third -> result = "third"
}
        return result
    }
}

sealed interface SwitchMergeValue {
    data class First(val value: Int) : SwitchMergeValue
    data class Second(val value: Int) : SwitchMergeValue
    data object Third : SwitchMergeValue
}
