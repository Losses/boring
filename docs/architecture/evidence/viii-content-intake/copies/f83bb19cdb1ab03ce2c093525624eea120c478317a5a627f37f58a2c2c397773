import os, sys
root = sys.argv[1]        # normalised mirror
orig_tree = sys.argv[2]   # tree root string to erase
orig_sw = sys.argv[3]     # sweep dir string to erase
n = 0
for dirpath, dirnames, filenames in os.walk(root):
    for f in filenames:
        p = os.path.join(dirpath, f)
        try:
            with open(p, 'rb') as fh:
                data = fh.read()
            if b'\0' in data:
                continue
            text = data.decode('utf-8')
        except (UnicodeDecodeError, OSError):
            continue
        new = text.replace(orig_tree, 'SWEEP').replace(orig_sw, 'SWEEP').replace(root, 'SWEEP')
        if new != text:
            with open(p, 'w') as fh:
                fh.write(new)
            n += 1
print(f"normalised {n} file(s) under {root}")
