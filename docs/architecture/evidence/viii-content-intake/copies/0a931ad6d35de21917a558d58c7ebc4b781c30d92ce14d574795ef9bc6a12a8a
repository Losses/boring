package tests

import boring.ValuePassingOps
import boring.runtime.test.Test

class ValuePassingTests {
@boring.test.Test
    fun valueFlow() {
        Test.run("tests.ValuePassingTests.valueFlow", "tests.ValuePassingTests.valueFlow: field reads and parameter passes keep values usable") {
                val card = ValuePassingOps.buildCard()
                Test.equals("card|card", ValuePassingOps.readTwoFields(card), null)
                Test.equals(4, ValuePassingOps.passTwice(card), null)
                Test.equals(9, ValuePassingOps.forwardParameter(card.tags), null)
                Test.equals("added", ValuePassingOps.pushThrough(card.tags), null)
                Test.equals(9, ValuePassingOps.lengthArithmetic("four"), null)
        }
    }
}
