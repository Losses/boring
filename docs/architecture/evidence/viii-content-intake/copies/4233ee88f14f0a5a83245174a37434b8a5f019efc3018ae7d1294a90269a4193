package tests

import boring.PrintedMark
import boring.PrintedNullableMark
import boring.PrintedPoint
import boring.PrintedSortedFields
import boring.comparePrintedPoint
import boring.runtime.SortedTable
import boring.runtime.test.Test

class PrintedSortedFieldsTests {
@boring.test.Test
    fun fields() {
        Test.run("tests.PrintedSortedFieldsTests.fields", "tests.PrintedSortedFieldsTests.fields: sorted fields use ruled forms") {
                val sb = SortedTable.setBuilder<Int>(SortedTable::compareInts)
                sb.put(2)
                sb.put(1)
                val pb = SortedTable.setBuilder<PrintedPoint>(::comparePrintedPoint)
                pb.put(PrintedPoint(1, 2))
                val mb = SortedTable.mapBuilder<String, Int>(SortedTable::compareStrings)
                mb.put("b", 2)
                mb.put("a", 1)
                val emptySet = SortedTable.setBuilder<Int>(SortedTable::compareInts)
                val emptyMap = SortedTable.mapBuilder<String, Int>(SortedTable::compareStrings)
                val value = PrintedSortedFields(sb.build(), pb.build(), mb.build(), emptySet.build(), emptyMap.build())
                val expected = "PrintedSortedFields(marks=[1, 2], points=[PrintedPoint(x=1, y=2)], lookup={a=1, b=2}, emptySet=[], emptyMap={})"
                Test.equals(expected, value.toString(), null)
                val nullMark = PrintedNullableMark(null)
                Test.equals("PrintedNullableMark(mark=null)", nullMark.toString(), null)
                val ringMark = PrintedNullableMark(PrintedMark.Ring(1.5))
                Test.equals("PrintedNullableMark(mark=Ring(diameter=1.5))", ringMark.toString(), null)
        }
    }
}
