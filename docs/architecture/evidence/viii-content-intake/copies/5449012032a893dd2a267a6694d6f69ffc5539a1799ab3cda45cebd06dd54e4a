package tests

import boring.KnullInitNarrowing
import boring.Nested
import boring.runtime.test.Test

class KnullInitNarrowingTests {
@boring.test.Test
    fun fieldOffNullableReceiver() {
        Test.run("tests.KnullInitNarrowingTests.fieldOffNullableReceiver", "tests.KnullInitNarrowingTests.fieldOffNullableReceiver: reads a field off a nullable receiver bound to a non-null local") {
                val k = KnullInitNarrowing()
                val nested = Nested(5)
                Test.equals(5, k.fieldOffNullableReceiver(nested), null)
        }
    }

@boring.test.Test
    fun ternaryWithNullableArm() {
        Test.run("tests.KnullInitNarrowingTests.ternaryWithNullableArm", "tests.KnullInitNarrowingTests.ternaryWithNullableArm: binds a non-null local from a ternary whose else arm is nullable") {
                val k = KnullInitNarrowing()
                Test.equals(1, k.ternaryWithNullableArm(true, null), null)
        }
    }

@boring.test.Test
    fun chainedFieldAccess() {
        Test.run("tests.KnullInitNarrowingTests.chainedFieldAccess", "tests.KnullInitNarrowingTests.chainedFieldAccess: chains two field accesses off a nullable receiver") {
                val k = KnullInitNarrowing()
                val nested = Nested(7)
                Test.equals("v7", k.chainedFieldAccess(nested), null)
        }
    }
}
