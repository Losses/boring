package boring

import std.UStringException

object StringBufUnionOps {
    fun buildCharChecked(count: Int): String {
        if ((count == 0)) {
            throw VectorException.BadMagic
        }
        val buf = StringBuilder()
        val tail = buf.lastOrNull()?.code ?: -1
        if (65 >= 56320 && 65 <= 57343) {
            if (!(tail >= 55296 && tail <= 56319)) {
                throw UStringException.UnpairedSurrogate(65)
            }
        } else if (tail >= 55296 && tail <= 56319) {
            throw UStringException.UnpairedSurrogate(tail)
        }
        buf.append((65).toChar())
        val tail2 = buf.lastOrNull()?.code ?: -1
        if (tail2 >= 55296 && tail2 <= 56319) {
            throw UStringException.UnpairedSurrogate(tail2)
        }
        return buf.toString()
    }

    fun buildChecked(count: Int): String {
        if ((count == 0)) {
            throw VectorException.UnexpectedEof
        }
        val buf = StringBuilder()
        val tail3 = buf.lastOrNull()?.code ?: -1
        if (tail3 >= 55296 && tail3 <= 56319 && "item".length > 0 && !("item"[0].code >= 56320 && "item"[0].code <= 57343)) {
            throw UStringException.UnpairedSurrogate(tail3)
        }
        buf.append("item")
        val tail4 = buf.lastOrNull()?.code ?: -1
        if (tail4 >= 55296 && tail4 <= 56319) {
            throw UStringException.UnpairedSurrogate(tail4)
        }
        return buf.toString()
    }

    fun vectorFaultCode(): Int {
        var result = 0
        try {
            StringBufUnionOps.buildChecked(0)
        } catch (e: VectorException) {
            result = (if ((e == VectorException.UnexpectedEof)) 1 else 0)
        }
        return result
    }
}
