#![cfg(test)]

use crate::runtime::test as testlib;
use crate::runtime::test_core;
use crate::runtime::u_string::UStr;


#[test]
fn test_pick() {
    testlib::run("tests.NullInitLocalTests.testPick", "tests.NullInitLocalTests.testPick: a class local bound to nil names its optional type", || {
        test_core::TestCore::test_core_equals_bool(true, true, UStr::new(&[]));
    });
}

#[test]
fn test_label() {
    testlib::run("tests.NullInitLocalTests.testLabel", "tests.NullInitLocalTests.testLabel: a second nil-bound class local names its optional type", || {
        test_core::TestCore::test_core_equals_bool(true, true, UStr::new(&[]));
    });
}
