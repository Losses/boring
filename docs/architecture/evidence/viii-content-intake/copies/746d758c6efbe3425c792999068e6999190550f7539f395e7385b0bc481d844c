use crate::runtime::u_string::UString;


#[derive(Clone, Copy)]
pub struct NarrowedOptionReturnOps;

impl NarrowedOptionReturnOps {
    pub fn narrowed_option_return_ops_pick(value: Option<UString>) -> Result<UString, NarrowedOptionReturnFault> {
        match &(value) {
            Some(__option) => {
                return Ok((*__option).clone());
            }
            None => {
            }
        }
        return Err(NarrowedOptionReturnFault::new("missing"));
    }
}

#[derive(Debug, Clone, PartialEq)]
pub struct NarrowedOptionReturnFault {
    pub message: String,
}
impl NarrowedOptionReturnFault {
    pub fn new(message: &str) -> Self {
        Self { message: message.to_string() }
    }
}
impl std::fmt::Display for NarrowedOptionReturnFault {
    fn fmt(&self, formatter: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        write!(formatter, "{}", self.message)
    }
}
impl std::error::Error for NarrowedOptionReturnFault {}
