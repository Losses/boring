-lib reflaxe
-lib boring
-cp packages/compiler
-cp packages/compiler/reflaxe/swift/std-shadow
-cp packages/compiler/reflaxe/swift
-cp samples
-cp /tmp/p08ir/probes/probeD
--macro Intercept.run(['samples', '/tmp/p08ir/probes/probeD'])
--macro swiftcompiler.Compiler.use()
-D swift-test-runner=native
-D runtime-import=@boring/runtime
-D runtime-emit=.
probeD.PD
--macro haxe.macro.Context.getType("probeD.PD.PDTryShapes")
--macro haxe.macro.Context.getType("probeD.PD.PDError")
