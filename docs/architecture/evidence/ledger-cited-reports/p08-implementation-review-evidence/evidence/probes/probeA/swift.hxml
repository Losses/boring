-lib reflaxe
-lib boring
-cp packages/compiler
-cp packages/compiler/reflaxe/swift/std-shadow
-cp packages/compiler/reflaxe/swift
-cp samples
-cp /tmp/p08ir/probes/probeA
--macro Intercept.run(['samples', '/tmp/p08ir/probes/probeA'])
--macro swiftcompiler.Compiler.use()
-D swift-test-runner=native
-D runtime-import=@boring/runtime
-D runtime-emit=.
probeA.PA
--macro haxe.macro.Context.getType("probeA.PA.PACatchRef")
--macro haxe.macro.Context.getType("probeA.PA.PASwitchShapes")
--macro haxe.macro.Context.getType("probeA.PA.PAHolder")
--macro haxe.macro.Context.getType("probeA.PA.PASwitchAssignNullable")
--macro haxe.macro.Context.getType("probeA.PA.PAError")
