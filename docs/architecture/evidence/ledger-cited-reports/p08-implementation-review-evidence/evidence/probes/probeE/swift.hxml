-lib reflaxe
-lib boring
-cp packages/compiler
-cp packages/compiler/reflaxe/swift/std-shadow
-cp packages/compiler/reflaxe/swift
-cp samples
-cp /tmp/p08ir/probes/probeE
--macro Intercept.run(['samples', '/tmp/p08ir/probes/probeE'])
--macro swiftcompiler.Compiler.use()
-D swift-test-runner=native
-D runtime-import=@boring/runtime
-D runtime-emit=.
probeE.PE
--macro haxe.macro.Context.getType("probeE.PE.PELambda")
--macro haxe.macro.Context.getType("probeE.PE.PEError")
