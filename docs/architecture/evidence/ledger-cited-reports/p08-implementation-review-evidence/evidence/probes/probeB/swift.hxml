-lib reflaxe
-lib boring
-cp packages/compiler
-cp packages/compiler/reflaxe/swift/std-shadow
-cp packages/compiler/reflaxe/swift
-cp samples
-cp /tmp/p08ir/probes/probeB
--macro Intercept.run(['samples', '/tmp/p08ir/probes/probeB'])
--macro swiftcompiler.Compiler.use()
-D swift-test-runner=native
-D runtime-import=@boring/runtime
-D runtime-emit=.
probeB.PB
--macro haxe.macro.Context.getType("probeB.PB.PBSwitchMerge")
--macro haxe.macro.Context.getType("probeB.PB.PBSwitchNullableDest")
--macro haxe.macro.Context.getType("probeB.PB.PBSwitchViaLocal")
--macro haxe.macro.Context.getType("probeB.PB.PBMutError")
