-lib reflaxe
-lib boring
-cp packages/compiler
-cp packages/compiler/reflaxe/swift/std-shadow
-cp packages/compiler/reflaxe/swift
-cp samples
-cp /tmp/p08ir/probes/probeC
--macro Intercept.run(['samples', '/tmp/p08ir/probes/probeC'])
--macro swiftcompiler.Compiler.use()
-D swift-test-runner=native
-D runtime-import=@boring/runtime
-D runtime-emit=.
probeC.PC
--macro haxe.macro.Context.getType("probeC.PC.PCWrappedSwitch")
