From 695940e876f7c5b22f7bd669670d49233681bf05 Mon Sep 17 00:00:00 2001
From: LOSSES Don <1384036+Losses@users.noreply.github.com>
Date: Wed, 30 Sep 2026 12:35:15 -0400
Subject: [PATCH] fix(test): exclude generated out/ tree from bun test
 discovery

---
 bunfig.toml | 10 ++++++++++
 1 file changed, 10 insertions(+)
 create mode 100644 bunfig.toml

diff --git a/bunfig.toml b/bunfig.toml
new file mode 100644
index 00000000..4b0b3e6c
--- /dev/null
+++ b/bunfig.toml
@@ -0,0 +1,10 @@
+# bun test discovers test files by scanning the project root and matching
+# positional arguments as path suffixes. The generated out/ tree (654 MB,
+# ~4000 duplicated *.test.ts files under out/**/tests/) is therefore swept
+# into every run, and duplicates like
+# out/architecture-alias-targets/e3b8-source/tests/ts/array-root.test.ts
+# match the same suffix as the real file. Collection then dies with
+# "Cannot find module ... from ''" / EMFILE before any test executes.
+# Exclude the generated tree from discovery; tests themselves are untouched.
+[test]
+pathIgnorePatterns = ["out/**"]
-- 
2.54.0

