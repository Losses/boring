# The TypeScript toolchain of the scoped npm package-name fixture. The driver
# runs haxe from this project root, so every path resolves from here.
-lib reflaxe
-lib boring
-cp ../../packages/compiler/reflaxe/ts/std-shadow
-cp ../../packages/compiler/reflaxe/ts
-cp ../../samples
-cp src
--macro Intercept.run(['src'])
--macro tscompiler.Compiler.use()
-D runtime-import=./runtime
-D runtime-emit=.
-D package-shell=emit
scoped.ScopedProbe
