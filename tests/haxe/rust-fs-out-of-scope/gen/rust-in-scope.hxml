# P6.4 in-scope arm: samples/std is in both classpath AND Intercept scope,
# so std.FsError/std.FsException are emitted, the payload enum has a declaration
# site, and generation succeeds with a cargo-checkable crate.
-lib reflaxe
-cp packages/compiler
-cp packages/compiler/reflaxe/rust/std-shadow
-cp packages/compiler/reflaxe/rust
-cp tests/haxe/rust-fs-out-of-scope
-cp samples
--macro Intercept.run(['samples', 'tests/haxe/rust-fs-out-of-scope'])
--macro rustcompiler.Compiler.use()
-D runtime-import=crate::runtime
-D runtime-emit=runtime
-D package-name=rust-fs-out-of-scope
-D package-license=MIT
fsprobe.RustFsOutOfScopeProbe
runtime.UString
runtime.SortedTable
