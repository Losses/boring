# Typer probe of the dc-promoted-eval fixture: records the typed shape the
# targets receive for the statement-position switch, and counts the
# side-effecting subject calls in the typed AST of each probe method.
# Run from the worktree root:
#   nix develop -c haxe tests/haxe/dc-promoted-eval/probe.hxml
-lib reflaxe
-lib boring
-cp packages/compiler
-cp tests/haxe/dc-promoted-eval
-cp samples
--macro Intercept.run(['samples', 'tests/haxe/dc-promoted-eval'])
--macro dcpe.SubjectProbe.run()
dcpe.ProbeEntry
