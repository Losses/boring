# Generation of the dc-promoted-eval fixture for the kotlin target.
# The caller supplies -D kotlin-output=... (and -D kotlin-test-output=... where the
# target expects one); this file is otherwise the complete generation input.
# Run from the worktree root:
#   nix develop -c haxe tests/haxe/dc-promoted-eval/gen/kotlin.hxml -D kotlin-output=<dir>
-lib reflaxe
-lib boring
-cp packages/compiler
-cp packages/compiler/reflaxe/kotlin/std-shadow
-cp packages/compiler/reflaxe/kotlin
-cp tests/haxe/dc-promoted-eval
-cp samples
--macro Intercept.run(['samples', 'tests/haxe/dc-promoted-eval'])
--macro kotlincompiler.Compiler.use()
-D runtime-import=boring.runtime
-D runtime-emit=runtime
dcpe.EvalProbe
dcpe.DoubleEvalControl
