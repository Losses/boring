# Kotlin generation of the try-tail fixture.
# The runner passes -D kotlin-output=... and -D kotlin-test-output=...
# on the command line.
-lib reflaxe
-lib boring
-cp packages/compiler
-cp packages/compiler/reflaxe/kotlin/std-shadow
-cp packages/compiler/reflaxe/kotlin
-cp tests/haxe/try-tail
-cp samples
--macro Intercept.run(['samples', 'tests/haxe/try-tail'])
--macro kotlincompiler.Compiler.use()
-D runtime-import=boring.runtime
-D runtime-emit=runtime
trytail.TryTailOracle
