-lib reflaxe
-cp packages/compiler
-cp packages/compiler/reflaxe/ts/std-shadow
-cp packages/compiler/reflaxe/ts
-cp tests/haxe/ts-source-origin
-cp samples
--macro Intercept.run(['tests/haxe/ts-source-origin'])
--macro tscompiler.Compiler.use()
-D ts-output=out/ts-source-origin/default
-D package-shell=none
-main OriginSubject
