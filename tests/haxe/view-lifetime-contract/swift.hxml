# Fresh Swift generation of the view-lifetime case sources.
# The runner overrides -D swift-output with the per-attempt directory.
# No test discovery is requested; the ordinary runtime emission is selected
# by the array usage itself.
-lib reflaxe
-lib boring
-cp packages/compiler/reflaxe/swift/std-shadow
-cp packages/compiler/reflaxe/swift
-cp samples
-cp tests/haxe/view-lifetime-contract
--macro Intercept.run(['tests/haxe/view-lifetime-contract'])
--macro swiftcompiler.Compiler.use()
-main ViewLifetimeOracle
-D swift-output=out/view-lifetime-contract/current/gen
-D runtime-import=@boring/runtime
-D runtime-emit=.
-D package-shell=none
