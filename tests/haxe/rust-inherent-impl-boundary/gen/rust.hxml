-lib reflaxe
-lib boring
-cp packages/compiler
-cp packages/compiler/reflaxe/rust/std-shadow
-cp packages/compiler/reflaxe/rust
-cp tests/haxe/rust-inherent-impl-boundary
-cp samples
--macro Intercept.run(['samples', 'tests/haxe/rust-inherent-impl-boundary'])
--macro rustcompiler.Compiler.use()
-D runtime-import=crate::runtime
-D runtime-emit=runtime
boundaryscope.BoundaryProbe
boundaryscope.IntRangeFns
boundaryscope.LayoutResultFns
boundaryscope.LayoutResultLineFns
