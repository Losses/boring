# Generates out/haxe/TestMain.hx (docs/specs/features/19-testing.md).
# Runs before tests/haxe/test-main.hxml so -main TestMain resolves on a
# fresh tree: haxe caches classpath listings before --macro callbacks fire.
-cp src
-cp samples
-cp tests/haxe
-cp packages/registry/src
--macro haxe.macro.Compiler.addGlobalMetadata('boring', '@:build(std.RecordMember.build())')
--macro TestCollector.generate('out/haxe')
-main GenerateMain
-js out/haxe/generate-main.js
