# Dart generation of the dc-null-guard-fallthrough probe.
-lib reflaxe
-lib boring
-cp packages/compiler
-cp packages/compiler/reflaxe/dart/std-shadow
-cp packages/compiler/reflaxe/dart
-cp tests/haxe/dc-null-guard-fallthrough
-cp samples
--macro Intercept.run(['samples', 'tests/haxe/dc-null-guard-fallthrough'])
--macro dartcompiler.Compiler.use()
-D runtime-import=@boring/runtime
-D runtime-emit=.
dcguard.DcGuard
