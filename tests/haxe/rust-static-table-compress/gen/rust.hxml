-lib reflaxe
-lib boring
-cp packages/compiler
-cp packages/compiler/reflaxe/rust/std-shadow
-cp packages/compiler/reflaxe/rust
-cp tests/haxe/rust-static-table-compress
-cp samples
--macro Intercept.run(['samples', 'tests/haxe/rust-static-table-compress'])
--macro rustcompiler.Compiler.use()
-D runtime-import=crate::runtime
-D runtime-emit=runtime
probe.StaticTableTest
probe.StaticTable
runtime.UString
