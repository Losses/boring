# Rust generation of the xt-twoexc-emit fixture (two exception classes,
# one module; E1 declared last and rethrown by value).
# The runner passes -D rust-output=... on the command line.
-lib reflaxe
-lib boring
-cp packages/compiler
-cp packages/compiler/reflaxe/rust/std-shadow
-cp packages/compiler/reflaxe/rust
-cp tests/haxe/xt-twoexc-emit
-cp samples
--macro Intercept.run(['samples', 'tests/haxe/xt-twoexc-emit'])
--macro rustcompiler.Compiler.use()
-D runtime-import=crate::runtime
-D runtime-emit=runtime
twoemitscope.TwoEmitProbe
