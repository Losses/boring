# Focused Rust generation of the enum comparison module.
# Run from the repository root; the caller supplies the output tree so
# every attempt writes into its own run directory:
#   nix develop -c haxe tests/haxe/enum-comparison/rust-gen.hxml \
#     -D rust-output=out/enum-comparison/runs/<run>/rust-gen
-lib reflaxe
-cp packages/compiler
-cp packages/compiler/reflaxe/rust/std-shadow
-cp packages/compiler/reflaxe/rust
-cp tests/haxe/enum-comparison
-cp samples
--macro Intercept.run(['tests/haxe/enum-comparison'])
--macro rustcompiler.Compiler.use()
-D runtime-import=crate::runtime
-D runtime-emit=runtime
enumcomparison.EnumComparisonSubject
runtime.UString
runtime.SortedTable
