# Static Dart generation of the enum comparison module.
# Run from the repository root; the caller supplies the output tree so
# every attempt writes into its own run directory:
#   nix develop -c haxe tests/haxe/enum-comparison/dart-gen.hxml \
#     -D dart-output=out/enum-comparison/runs/<run>/dart-gen
# The runner generates this tree for inspection only. No Dart stage
# compiles or executes it, so it carries no runtime claim.
-lib reflaxe
-cp packages/compiler
-cp packages/compiler/reflaxe/dart/std-shadow
-cp packages/compiler/reflaxe/dart
-cp tests/haxe/enum-comparison
-cp samples
--macro Intercept.run(['tests/haxe/enum-comparison'])
--macro dartcompiler.Compiler.use()
-D dart-output=out/enum-comparison/runs/dart-gen
-D runtime-import=@boring/runtime
-D runtime-emit=.
enumcomparison.EnumComparisonSubject
runtime.UString
runtime.SortedTable
