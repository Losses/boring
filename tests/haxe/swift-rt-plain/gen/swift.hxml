# Swift generation of the boundary plain fixture (t-mun5d99p-op76).
-lib reflaxe
-lib boring
-cp packages/compiler
-cp packages/compiler/reflaxe/swift/std-shadow
-cp packages/compiler/reflaxe/swift
-cp tests/haxe/swift-rt-plain
-cp samples
--macro Intercept.run(['samples', 'tests/haxe/swift-rt-plain'])
--macro swiftcompiler.Compiler.use()
-D swift-test-runner=native
-D runtime-import=@boring/runtime
-D runtime-emit=.
plain.Plain
