-lib reflaxe
-lib boring
-cp packages/compiler/reflaxe/swift/std-shadow
-cp packages/compiler/reflaxe/swift
-cp samples
-cp tests/haxe/swift-runtime-closure
--macro Intercept.run(['tests/haxe/swift-runtime-closure'])
--macro swiftcompiler.Compiler.use()
--macro haxe.macro.Context.getType('closureFixture.ClosureTests')
--macro haxe.macro.Context.getType('runtime.TestCore')
-main Main
-D swift-output=out/swift-runtime-closure/with-tests
-D swift-test-output=out/swift-runtime-closure/tests
-D swift-test-runner=native
-D runtime-import=@boring/runtime
-D runtime-emit=.
-D package-shell=none
