-lib reflaxe
-lib boring
-cp packages/compiler/reflaxe/swift/std-shadow
-cp packages/compiler/reflaxe/swift
-cp samples
-cp tests/haxe/comparison-plan
--macro Intercept.run(['tests/haxe/comparison-plan'])
--macro swiftcompiler.Compiler.use()
-D swift-output=out/a3-comparison-plan/identity-runtime/swift-gen
-D runtime-import=@boring/runtime
-D runtime-emit=.
-D package-shell=none
comparisonplan.IdentityRuntimeMain
comparisonplan.IdentityReference
std.ReadOnlyArray
std.SortedMap
runtime.SortedTable
runtime.TestCore
std.FpText
