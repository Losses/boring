-lib reflaxe
-lib boring
-cp packages/compiler/reflaxe/kotlin/std-shadow
-cp packages/compiler/reflaxe/kotlin
-cp samples
-cp tests/haxe/kotlin-comparison-consumer
--macro Intercept.run(['tests/haxe/kotlin-comparison-consumer'])
--macro kotlincompiler.Compiler.use()
-D kotlin-output=out/kotlin-comparison-consumer/current/pidentity-gen
-D runtime-import=boring.runtime
-D runtime-emit=runtime
pid.ParameterIdentityProbe
std.SortedMap
runtime.SortedTable
