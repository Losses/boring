# Repro: a static var declared without an initializer crashed the emitter.
-lib reflaxe
-lib boring
-cp packages/compiler
-cp packages/compiler/reflaxe/rust/std-shadow
-cp packages/compiler/reflaxe/rust
-cp tests/haxe/static-var-noinit
-cp samples
--macro Intercept.run(['samples', 'tests/haxe/static-var-noinit'])
--macro rustcompiler.Compiler.use()
-D runtime-import=crate::runtime
-D runtime-emit=runtime
probe.StaticNoInitProbe
