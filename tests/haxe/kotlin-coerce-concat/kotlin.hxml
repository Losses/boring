# Generation input for the Kotlin String-concatenation coercion fixture (P2.6).
# The caller supplies -D kotlin-output=<dir>; this file is otherwise the
# complete generation input.
#
# Run from the worktree root:
#   haxe tests/haxe/kotlin-coerce-concat/kotlin.hxml -D kotlin-output=<dir>
#
# -cp packages/compiler names this tree's emitter explicitly, so the fixture
# always measures the tree it lives in (PIT-376).
-lib reflaxe
-cp packages/compiler
-cp packages/compiler/reflaxe/kotlin/std-shadow
-cp packages/compiler/reflaxe/kotlin
-cp tests/haxe/kotlin-coerce-concat
-cp samples
--macro Intercept.run(['samples', 'tests/haxe/kotlin-coerce-concat'])
--macro kotlincompiler.Compiler.use()
coerceconcat.ConcatCases
