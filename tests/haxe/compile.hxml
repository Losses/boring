# Compile the Haxe test entry to JavaScript and run it with bun
# (`bun run test:haxe`). The library sources live in samples and the
# typed test runner in tests/haxe.
-cp src
-cp samples
-cp tests/haxe
-main Main
-js out/haxe/tests.js
-D analyzer-optimize
--macro reflaxe.unicode.GraphemeData.ensureType()
--macro Intercept.run(['samples', 'tests/haxe'], ['samples/boring/BinaryReader.hx', 'samples/boring/BinaryWriter.hx', 'tests/haxe/UStringRtOracle.hx', 'tests/haxe/GraphemesOracle.hx'])
