# Compile the Haxe test entry to JavaScript and run it with bun
# (`bun run test:haxe`). The library sources live in samples and the
# typed test runner in tests/haxe.
-cp src
-cp samples
-cp tests/haxe
-main Main
-js out/haxe/tests.js
-D analyzer-optimize
--macro Intercept.run(['samples', 'tests/haxe'])
--macro haxe.macro.Compiler.addGlobalMetadata('boring', '@:build(std.RecordMember.build())')
