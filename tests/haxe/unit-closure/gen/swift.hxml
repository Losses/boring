-lib reflaxe
-lib boring
-cp packages/compiler
-cp packages/compiler/reflaxe/swift/std-shadow
-cp packages/compiler/reflaxe/swift
-cp tests/haxe/unit-closure
-cp samples
--macro Intercept.run(['samples', 'tests/haxe/unit-closure'])
--macro swiftcompiler.Compiler.use()
-D runtime-import=@boring/runtime
-D runtime-emit=.
-D package-shell=none
probe.MainEntry
probe.GoldenDataTest
