# Swift generation of the charcodeat fixture.
# The runner passes -D swift-output=... and -D swift-test-output=... on
# the command line. No -main: the native harness is an authored @main
# entry (native/native-main.swift) compiled alongside the emitted
# Runtime.swift, mirroring tests/haxe/readonly-alias.
-lib reflaxe
-lib boring
-cp packages/compiler
-cp packages/compiler/reflaxe/swift/std-shadow
-cp packages/compiler/reflaxe/swift
-cp tests/haxe/charcodeat
-cp samples
--macro Intercept.run(['samples', 'tests/haxe/charcodeat'])
--macro swiftcompiler.Compiler.use()
-D swift-test-runner=native
-D swift-test-import=CharCodeAtOracle
-D runtime-import=@boring/runtime
-D runtime-emit=.
charcodeat.CharCodeAtOracle
