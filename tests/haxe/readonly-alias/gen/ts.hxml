# TypeScript generation of the readonly-alias fixture.
# The runner passes -D ts-output=... and -D ts-test-output=... on the
# command line; this file is otherwise the complete input.
-lib reflaxe
-lib boring
-cp packages/compiler
-cp packages/compiler/reflaxe/ts/std-shadow
-cp packages/compiler/reflaxe/ts
-cp tests/haxe/readonly-alias
-cp samples
--macro Intercept.run(['samples', 'tests/haxe/readonly-alias'])
--macro tscompiler.Compiler.use()
-D ts-test-runner=bun
-D runtime-import=./runtime
-D runtime-emit=.
-D package-shell=none
roalias.ReadOnlyAliasOracle
