# Dart generation of the minimal extension-member-collision fixture (task
# t-mwj2nzqa-mgcv). The runner passes -D dart-output=... and
# -D dart-test-output=... on the command line. Two marked extension
# functions over one receiver render the same member name; a Dart
# extension cannot overload a member, so the later declaration keeps its
# declaring class and its call sites use the class-qualified static form.
-lib reflaxe
-lib boring
-cp packages/compiler
-cp packages/compiler/reflaxe/dart/std-shadow
-cp packages/compiler/reflaxe/dart
-cp tests/haxe/dart-extension-member-collision
-cp samples
--macro Intercept.run(['samples', 'tests/haxe/dart-extension-member-collision'])
--macro dartcompiler.Compiler.use()
-D dart-test-runner=native
-D runtime-import=@boring/runtime
-D runtime-emit=.
pub.ExtensionOverloads
pub.ExtensionOverloadsConsumer
pub.ReversedOverloads
pub.ReversedOverloadsConsumer
