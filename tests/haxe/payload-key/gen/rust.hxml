# Rust generation of the payload-key counterexample fixture (PIT-281,
# task t-mune0a1j-vmt1). One module, two payload exception classes; the
# runner passes -D rust-output=... on the command line.
-lib reflaxe
-lib boring
-cp packages/compiler
-cp packages/compiler/reflaxe/rust/std-shadow
-cp packages/compiler/reflaxe/rust
-cp tests/haxe/payload-key
-cp samples
--macro Intercept.run(['samples', 'tests/haxe/payload-key'])
--macro rustcompiler.Compiler.use()
-D runtime-import=crate::runtime
-D runtime-emit=runtime
pk.PayloadKeyProbe
