# Swift generation input for the record-typedef shape-lookup fixture
# (board t-mwficz03-x636). The caller supplies -D swift-output=<dir> and
# -D swift-test-output=<dir>; this file is otherwise the complete generation
# input. Run from the worktree root:
#   haxe tests/haxe/record-typedef-inferred-field/swift.hxml #     -D swift-output=<dir> -D swift-test-output=<dir>
#
# -cp packages/compiler names this tree's emitter explicitly, so the fixture
# always measures the tree it lives in; the workspace haxelib projection is
# bypassed (PIT-376). runtime-emit=. writes Runtime.swift inside the output
# tree so swiftc -typecheck resolves it relatively.
-lib reflaxe
-cp packages/compiler
-cp packages/compiler/reflaxe/swift/std-shadow
-cp packages/compiler/reflaxe/swift
-cp samples
-cp tests/haxe/record-typedef-inferred-field
--macro Intercept.run(['samples', 'tests/haxe/record-typedef-inferred-field'])
--macro swiftcompiler.Compiler.use()
-D runtime-import=@boring/runtime
-D runtime-emit=.
-D swift-test-runner=native
-D package-shell=none
exposed.Records
