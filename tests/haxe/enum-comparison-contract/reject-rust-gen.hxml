# Focused Rust generation of the rejected direct payload-enum key probe.
# Run from the repository root; the caller supplies the output tree so
# every attempt writes into its own run directory:
#   nix develop -c haxe tests/haxe/enum-comparison-contract/reject-rust-gen.hxml \
#     -D rust-output=out/enum-comparison-contract/runs/<run>/reject-gen
# The compilation must stop with the payload-key diagnostic, so no output
# tree survives the attempt.
-lib reflaxe
-cp packages/compiler
-cp packages/compiler/reflaxe/rust/std-shadow
-cp packages/compiler/reflaxe/rust
-cp tests/haxe/enum-comparison-contract
-cp samples
--macro Intercept.run(['tests/haxe/enum-comparison-contract'])
--macro rustcompiler.Compiler.use()
-D runtime-import=crate::runtime
-D runtime-emit=runtime
enumcontract.rejected.RejectPayloadEnumKey
