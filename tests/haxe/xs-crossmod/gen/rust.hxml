# Reviewer-authored neighbour-shape probe: two payload exception classes in one
# module whose payload enums live in two different modules.
-lib reflaxe
-lib boring
-cp packages/compiler
-cp packages/compiler/reflaxe/rust/std-shadow
-cp packages/compiler/reflaxe/rust
-cp tests/haxe/xs-crossmod
-cp samples
--macro Intercept.run(['samples', 'tests/haxe/xs-crossmod'])
--macro rustcompiler.Compiler.use()
-D runtime-import=crate::runtime
-D runtime-emit=runtime
xsxm.CrossProbe
