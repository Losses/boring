# Focused Rust generation of the comparison fixture.
# Run from the repository root; the caller supplies the output tree so every
# attempt writes into its own run directory:
#   nix develop -c haxe tests/haxe/comparison-runtime-observation/hxml/rust.hxml \
#     -D rust-output=out/comparison-runtime-observation/runs/<run>/rust-gen
-lib reflaxe
-lib boring
-cp packages/compiler/reflaxe/rust/std-shadow
-cp packages/compiler/reflaxe/rust
-cp samples
-cp tests/haxe/comparison-runtime-observation
--macro Intercept.run(['tests/haxe/comparison-runtime-observation'])
--macro rustcompiler.Compiler.use()
-D rust-output=out/comparison-runtime-observation/current/rust-gen
-D runtime-import=crate::runtime
-D runtime-emit=runtime
comparison.ComparisonObserve
std.ReadOnlyArray
std.SortedMap
runtime.SortedTable
# The emitted test host names runtime.TestCore, and its Kotlin host source
# calls FPHelper, so the two modules ride in the entry list and the generated
# tree compiles as a whole. They carry no observation case.
runtime.TestCore
std.FpText
