# Focused Kotlin generation of the comparison fixture.
# Run from the repository root; the caller supplies the output tree so every
# attempt writes into its own run directory:
#   nix develop -c haxe tests/haxe/comparison-runtime-observation/hxml/kotlin.hxml \
#     -D kotlin-output=out/comparison-runtime-observation/runs/<run>/kotlin-gen
-lib reflaxe
-lib boring
-cp packages/compiler/reflaxe/kotlin/std-shadow
-cp packages/compiler/reflaxe/kotlin
-cp samples
-cp tests/haxe/comparison-runtime-observation
--macro Intercept.run(['tests/haxe/comparison-runtime-observation'])
--macro kotlincompiler.Compiler.use()
-D kotlin-output=out/comparison-runtime-observation/current/kotlin-gen
-D runtime-import=boring.runtime
-D runtime-emit=runtime
comparison.ComparisonObserve
std.ReadOnlyArray
std.SortedMap
runtime.SortedTable
# The emitted test host names runtime.TestCore, and its Kotlin host source
# calls FPHelper, so the two modules ride in the entry list and the generated
# tree compiles as a whole. They carry no observation case.
runtime.TestCore
std.FpText
