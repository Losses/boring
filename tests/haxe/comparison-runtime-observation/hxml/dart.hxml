# Focused Dart generation of the comparison fixture.
# Run from the repository root; the caller supplies the output tree so every
# attempt writes into its own run directory:
#   nix develop -c haxe tests/haxe/comparison-runtime-observation/hxml/dart.hxml \
#     -D dart-output=out/comparison-runtime-observation/runs/<run>/dart-gen
-lib reflaxe
-lib boring
-cp packages/compiler/reflaxe/dart/std-shadow
-cp packages/compiler/reflaxe/dart
-cp samples
-cp tests/haxe/comparison-runtime-observation
--macro Intercept.run(['tests/haxe/comparison-runtime-observation'])
--macro dartcompiler.Compiler.use()
-D dart-output=out/comparison-runtime-observation/current/dart-gen
-D dart-test-output=out/comparison-runtime-observation/current/dart-gen-tests
-D dart-test-runner=native
-D runtime-import=@boring/runtime
-D runtime-emit=.
comparison.ComparisonObserve
std.ReadOnlyArray
std.SortedMap
runtime.SortedTable
# The emitted test host names runtime.TestCore, and its Kotlin host source
# calls FPHelper, so the two modules ride in the entry list and the generated
# tree compiles as a whole. They carry no observation case.
runtime.TestCore
std.FpText
