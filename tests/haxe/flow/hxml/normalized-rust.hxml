# The normalized group, Rust generation. Run from the repository root:
# haxe tests/haxe/flow/hxml/normalized-rust.hxml
-lib reflaxe
-lib boring
-cp packages/compiler/reflaxe/rust/std-shadow
-cp packages/compiler/reflaxe/rust
-cp samples
-cp tests/haxe/flow
--macro Intercept.run(['samples', 'tests/haxe/flow'])
--macro rustcompiler.Compiler.use()
-D rust-output=out/flow/normalized/rust
-D runtime-import=crate::runtime
-D runtime-emit=runtime
-D package-name=flow-normalized
-D package-license=MIT
flow.normalized.FlowMain
