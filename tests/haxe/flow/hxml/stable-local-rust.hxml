# The stable-local group, Rust generation. Run from the repository root:
# haxe tests/haxe/flow/hxml/stable-local-rust.hxml
-lib reflaxe
-lib boring
-cp packages/compiler/reflaxe/rust/std-shadow
-cp packages/compiler/reflaxe/rust
-cp samples
-cp tests/haxe/flow
--macro Intercept.run(['samples', 'tests/haxe/flow'])
--macro rustcompiler.Compiler.use()
-D rust-output=out/flow/stable-local/rust
-D runtime-import=crate::runtime
-D runtime-emit=runtime
-D package-name=flow-stable-local
-D package-license=MIT
flow.stable.FlowMain
