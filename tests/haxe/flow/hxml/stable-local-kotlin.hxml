# The stable-local group, Kotlin generation. Run from the repository root:
# haxe tests/haxe/flow/hxml/stable-local-kotlin.hxml
-lib reflaxe
-lib boring
-cp packages/compiler/reflaxe/kotlin/std-shadow
-cp packages/compiler/reflaxe/kotlin
-cp samples
-cp tests/haxe/flow
--macro Intercept.run(['samples', 'tests/haxe/flow'])
--macro kotlincompiler.Compiler.use()
-D kotlin-output=out/flow/stable-local/kotlin
-D runtime-import=boring.runtime
-D runtime-emit=runtime
flow.stable.FlowMain
