# The normalized group, Kotlin generation. Run from the repository root:
# haxe tests/haxe/flow/hxml/normalized-kotlin-debug.hxml
-lib reflaxe
-lib boring
-cp packages/compiler/reflaxe/kotlin/std-shadow
-cp packages/compiler/reflaxe/kotlin
-cp samples
-cp tests/haxe/flow
--macro Intercept.run(['samples', 'tests/haxe/flow'])
--macro kotlincompiler.Compiler.use()
-D kotlin-output=out/flow/normalized/kotlin-debug
-D runtime-import=boring.runtime
-D runtime-emit=runtime
-D kotlin_fold_debug
flow.normalized.FlowMain
