# Generates the f32 oracle runner for feature 44 record float text.
# The output directories are the bundle driver's derived dirs for the
# haxe-f32 bundle (feature spec 59): <outRoot>/haxe-f32/gen and
# <outRoot>/haxe-f32/gen-tests.
-cp packages/compiler
-cp samples
-cp tests/haxe
-cp packages/registry/src
--macro haxe.macro.Compiler.addGlobalMetadata('boring', '@:build(std.RecordMember.build())')
--macro TestCollector.generate('reference/haxe-f32/gen-tests', ['samples/tests/f32', 'samples/boring'], 'TestMainF32')
-main GenerateMain
-js reference/haxe-f32/gen/generate-main-f32.js
-D boring_oracle
-D float-precision=f32
