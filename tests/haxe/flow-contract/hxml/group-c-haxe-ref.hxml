# Group C (stable-local isolation) Haxe reference run. Run from the repository root:
# haxe tests/haxe/flow-contract/hxml/group-c-haxe-ref.hxml
-lib reflaxe
-lib boring
-cp packages/compiler
-cp samples
-cp tests/haxe/flow-contract
--macro Intercept.run(['samples', 'tests/haxe/flow-contract'])
-main flow.stable.FlowMain
-js out/flow-contract/group-c/haxe/flow-main.js
