# Group A (normalized cases) Haxe reference run. Run from the repository root:
# haxe tests/haxe/flow-contract/hxml/group-a-haxe-ref.hxml
-lib reflaxe
-lib boring
-cp packages/compiler
-cp samples
-cp tests/haxe/flow-contract
--macro Intercept.run(['samples', 'tests/haxe/flow-contract'])
-main flow.normalized.FlowMain
-js out/flow-contract/group-a/haxe/flow-main.js
