# Flow contract Haxe reference run. The output runs under bun and holds the
# expected result of every case. Run from the repository root:
# haxe tests/haxe/flow-contract/haxe-ref.hxml
-lib reflaxe
-lib boring
-cp packages/compiler
-cp samples
-cp tests/haxe/flow-contract
--macro Intercept.run(['samples', 'tests/haxe/flow-contract'])
-main flow.FlowMain
-js out/flow-contract/haxe/flow-main.js
