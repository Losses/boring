# Flow contract Rust generation. Run from the repository root:
# haxe tests/haxe/flow-contract/rust.hxml
-lib reflaxe
-lib boring
-cp packages/compiler/reflaxe/rust/std-shadow
-cp packages/compiler/reflaxe/rust
-cp samples
-cp tests/haxe/flow-contract
--macro Intercept.run(['samples', 'tests/haxe/flow-contract'])
--macro rustcompiler.Compiler.use()
-D rust-output=out/flow-contract/rust
-D runtime-import=crate::runtime
-D runtime-emit=runtime
-D package-name=flow-contract-gen
-D package-license=MIT
flow.FlowMain
