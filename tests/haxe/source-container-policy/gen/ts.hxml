# TypeScript generation of the container caller cases.
# Run from the repository root:
#   nix develop -c haxe tests/haxe/source-container-policy/gen/ts.hxml \
#     -D ts-output=out/source-container-policy/<run>/ts/gen \
#     -D ts-test-output=out/source-container-policy/<run>/ts/gen-tests
-lib reflaxe
-lib boring
-cp packages/compiler
-cp packages/compiler/reflaxe/ts/std-shadow
-cp packages/compiler/reflaxe/ts
-cp tests/haxe/source-container-policy
-cp samples
--macro Intercept.run(['samples', 'tests/haxe/source-container-policy'])
--macro tscompiler.Compiler.use()
-D ts-test-runner=bun
-D runtime-import=./runtime
-D runtime-emit=.
-D package-shell=none
scp.CallerCases
