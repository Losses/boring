# Dart generation of the container caller cases.
# Run from the repository root:
#   nix develop -c haxe tests/haxe/source-container-policy/gen/dart.hxml \
#     -D dart-output=out/source-container-policy/<run>/dart/gen \
#     -D dart-test-output=out/source-container-policy/<run>/dart/gen-tests
-lib reflaxe
-lib boring
-cp packages/compiler
-cp packages/compiler/reflaxe/dart/std-shadow
-cp packages/compiler/reflaxe/dart
-cp tests/haxe/source-container-policy
-cp samples
--macro Intercept.run(['samples', 'tests/haxe/source-container-policy'])
--macro dartcompiler.Compiler.use()
-D dart-test-runner=native
-D runtime-import=@boring/runtime
-D runtime-emit=.
scp.CallerCases
