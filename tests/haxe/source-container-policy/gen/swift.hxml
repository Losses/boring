# Swift generation of the container caller cases.
# Run from the repository root:
#   nix develop -c haxe tests/haxe/source-container-policy/gen/swift.hxml \
#     -D swift-output=out/source-container-policy/<run>/swift/gen \
#     -D swift-test-output=out/source-container-policy/<run>/swift/gen-tests
-lib reflaxe
-lib boring
-cp packages/compiler
-cp packages/compiler/reflaxe/swift/std-shadow
-cp packages/compiler/reflaxe/swift
-cp tests/haxe/source-container-policy
-cp samples
--macro Intercept.run(['samples', 'tests/haxe/source-container-policy'])
--macro swiftcompiler.Compiler.use()
-D swift-test-runner=native
-D swift-test-import=CallerCases
-D runtime-import=@boring/runtime
-D runtime-emit=.
scp.CallerCases
