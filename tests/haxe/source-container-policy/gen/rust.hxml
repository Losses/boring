# Rust generation of the container caller cases.
# Run from the repository root:
#   nix develop -c haxe tests/haxe/source-container-policy/gen/rust.hxml \
#     -D rust-output=out/source-container-policy/<run>/rust/gen
-lib reflaxe
-lib boring
-cp packages/compiler
-cp packages/compiler/reflaxe/rust/std-shadow
-cp packages/compiler/reflaxe/rust
-cp tests/haxe/source-container-policy
-cp samples
--macro Intercept.run(['samples', 'tests/haxe/source-container-policy'])
--macro rustcompiler.Compiler.use()
-D runtime-import=crate::runtime
-D runtime-emit=runtime
scp.CallerCases
