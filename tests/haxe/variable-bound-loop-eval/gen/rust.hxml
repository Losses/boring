# Generation of the variable-bound-loop-eval fixture for the rust target.
# The caller supplies -D rust-output=...; this file is otherwise the complete
# generation input. Run from the worktree root:
#   haxe tests/haxe/variable-bound-loop-eval/gen/rust.hxml -D rust-output=<dir>
-lib reflaxe
-lib boring
-cp packages/compiler
-cp tests/haxe/variable-bound-loop-eval/shadow
-cp packages/compiler/reflaxe/rust/std-shadow
-cp packages/compiler/reflaxe/rust
-cp tests/haxe/variable-bound-loop-eval
-cp samples
--macro Intercept.run(['samples', 'tests/haxe/variable-bound-loop-eval'])
--macro rustcompiler.Compiler.use()
-D runtime-import=crate::runtime
-D runtime-emit=runtime
vble.Probe
