# Generation of the variable-bound-loop-eval fixture for the kotlin target.
# The caller supplies -D kotlin-output=... (and -D kotlin-test-output=...);
# this file is otherwise the complete generation input. Run from the worktree
# root:
#   haxe tests/haxe/variable-bound-loop-eval/gen/kotlin.hxml -D kotlin-output=<dir>
-lib reflaxe
-lib boring
-cp packages/compiler
-cp tests/haxe/variable-bound-loop-eval/shadow
-cp packages/compiler/reflaxe/kotlin/std-shadow
-cp packages/compiler/reflaxe/kotlin
-cp tests/haxe/variable-bound-loop-eval
-cp samples
--macro Intercept.run(['samples', 'tests/haxe/variable-bound-loop-eval'])
--macro kotlincompiler.Compiler.use()
-D runtime-import=boring.runtime
-D runtime-emit=runtime
vble.Probe
