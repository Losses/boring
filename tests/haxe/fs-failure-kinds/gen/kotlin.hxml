# kotlin generation of the fs-failure-kinds fixture.
# The runner passes the output defines on the command line.
-lib reflaxe
-lib boring
-cp packages/compiler
-cp packages/compiler/reflaxe/kotlin/std-shadow
-cp packages/compiler/reflaxe/kotlin
-cp tests/haxe/fs-failure-kinds
-cp samples
--macro Intercept.run(['samples', 'tests/haxe/fs-failure-kinds'])
--macro kotlincompiler.Compiler.use()
-D runtime-import=boring.runtime
-D runtime-emit=runtime
fsfail.FsFailOracle
