# ts generation of the fs-failure-kinds fixture.
# The runner passes the output defines on the command line.
-lib reflaxe
-lib boring
-cp packages/compiler
-cp packages/compiler/reflaxe/ts/std-shadow
-cp packages/compiler/reflaxe/ts
-cp tests/haxe/fs-failure-kinds
-cp samples
--macro Intercept.run(['samples', 'tests/haxe/fs-failure-kinds'])
--macro tscompiler.Compiler.use()
-D ts-test-runner=bun
-D runtime-import=./runtime
-D runtime-emit=.
-D package-shell=none
fsfail.FsFailOracle
