# swift generation of the fs-failure-kinds fixture.
# The runner passes the output defines on the command line.
-lib reflaxe
-lib boring
-cp packages/compiler
-cp packages/compiler/reflaxe/swift/std-shadow
-cp packages/compiler/reflaxe/swift
-cp tests/haxe/fs-failure-kinds
-cp samples
--macro Intercept.run(['samples', 'tests/haxe/fs-failure-kinds'])
--macro swiftcompiler.Compiler.use()
-D swift-test-runner=native
-D runtime-import=@boring/runtime
-D runtime-emit=.
fsfail.FsFailOracle
