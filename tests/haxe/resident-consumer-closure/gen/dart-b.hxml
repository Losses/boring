# dart generation of the resident-closure consumer fixture
# (t-mum0mp8l-m0a6), variant b. Entry lists the runtime.* roots the examples hxml lists (positive control).
# Run from the repository root; the runner records rc and raw log.
-lib reflaxe
-lib boring
-cp packages/compiler
-cp packages/compiler/reflaxe/dart/std-shadow
-cp packages/compiler/reflaxe/dart
-cp samples
-cp tests/haxe/resident-consumer-closure
--macro Intercept.run(['samples', 'tests/haxe/resident-consumer-closure'])
--macro dartcompiler.Compiler.use()
-D dart-output=out/resident-consumer-closure/dart-b
-D runtime-import=@boring/runtime
-D runtime-emit=.
-D dart-test-output=out/resident-consumer-closure/dart-b-checks
Consumer
runtime.UString
runtime.GraphemeWalk
runtime.Graphemes
runtime.SortedTable
runtime.TestCore
