# Focused Rust generation of the paired place module.
# Run from the repository root; the caller supplies the output tree so
# every attempt writes into its own run directory:
#   nix develop -c haxe tests/haxe/place/rust-gen.hxml \
#     -D rust-output=out/place/runs/<run>/rust-gen-<variant>
# Case splitting uses -D placeSplit with one case define.
-lib reflaxe
-cp packages/compiler
-cp packages/compiler/reflaxe/rust/std-shadow
-cp packages/compiler/reflaxe/rust
-cp tests/haxe/place
-cp samples
--macro Intercept.run(['tests/haxe/place'])
--macro rustcompiler.Compiler.use()
-D runtime-import=crate::runtime
-D runtime-emit=runtime
place.PlaceObserveStatic
