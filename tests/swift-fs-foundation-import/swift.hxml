# Focused regression fixture (docs/specs/stdlib/17-platform-modules.md).
# A generated file that calls a fallible std.Fs operation carries the
# boringFsError failure classifier and boringFsRename, and must import
# Foundation so NSError / NSPOSIXErrorDomain resolve on a toolchain whose
# FoundationEssentials lacks them. The collected driver is
# tests/swift-fs-foundation-import/fs-foundation-import.test.ts.
-lib reflaxe
-lib boring
-cp packages/compiler/reflaxe/swift/std-shadow
-cp packages/compiler/reflaxe/swift
-cp samples
-cp tests/swift-fs-foundation-import
--macro Intercept.run(['samples', 'tests/swift-fs-foundation-import'])
--macro swiftcompiler.Compiler.use()
-D swift-test-runner=native
-D runtime-import=@boring/runtime
-D runtime-emit=.
fsfnd.FsFoundationOps
