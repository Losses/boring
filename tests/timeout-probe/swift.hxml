# Runner-timeout probe entry for the Swift target (feature spec 19).
# Run from the repository root: haxe tests/timeout-probe/swift.hxml
# The probe is kept out of examples/swift.hxml on purpose: it overruns the
# test budget, so an ordinary generation entry would carry a slow and red
# test. This entry compiles the probe alone.
#
# The test output directory is named "gen-checks": the repository test
# command searches with the pattern "tests/", which matches any path
# segment pair of that spelling, so a tree called "gen-tests" under out/
# would join every repository test run.
-lib reflaxe
-lib boring
-cp packages/compiler/reflaxe/swift/std-shadow
-cp packages/compiler/reflaxe/swift
-cp samples
-cp tests/timeout-probe
--macro Intercept.run(['samples', 'tests/timeout-probe'])
--macro haxe.macro.Compiler.addGlobalMetadata('boring', '@:build(std.RecordMember.build())')
--macro swiftcompiler.Compiler.use()
-D swift-output=out/timeout-probe/swift/gen
-D swift-test-output=out/timeout-probe/swift/gen-checks
-D swift-test-runner=native
-D swift-test-import=Codec
-D runtime-import=@boring/runtime
-D runtime-emit=.
-D package-shell=none
probe.TimeoutProbeTests
# runtime.TestCore holds the assertion checks and the canonical result line
# the generated test entry calls; it is appended to the emitted Test.swift,
# and the swift target compiles resident modules only when the entry lists
# them (examples/swift.hxml does the same).
runtime.TestCore
