# Shared configuration for the two precision entries. The driver runs haxe
# with the project root as the working directory, so every path here is
# relative to tests/kotlin-pack-regressions.
-lib reflaxe
-lib boring
-cp ../../packages/compiler/reflaxe/kotlin/std-shadow
-cp ../../packages/compiler/reflaxe/kotlin
-cp ../../samples
-cp src
--macro Intercept.run(['src'])
--macro kotlincompiler.Compiler.use()
-D runtime-import=kotlinpack.runtime
-D runtime-emit=runtime
