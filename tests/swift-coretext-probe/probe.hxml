# The Core Text expressiveness probe (task t-mwl2ttvv-yaco).
# Run from the repository root: haxe tests/swift-coretext-probe/probe.hxml
-lib reflaxe
-lib boring
-cp packages/compiler/reflaxe/swift/std-shadow
-cp packages/compiler/reflaxe/swift
-cp samples
-cp tests/swift-coretext-probe
--macro Intercept.run(['tests/swift-coretext-probe'])
--macro swiftcompiler.Compiler.use()
-D swift-output=out/coretext-probe/gen
-D swift-test-output=out/coretext-probe/gen-tests
-D swift-test-runner=native
-D swift-test-import=CoreText
-D runtime-import=@boring/runtime
-D runtime-emit=.
-D package-shell=none
probe.CoreTextMetricsTests
