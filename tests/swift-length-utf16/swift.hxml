# Swift codegen for the coalescing String.length fixture.
# Run from the repository root, with the output directory supplied
# via -D swift-output (kept out of the tree by convention):
#   haxe tests/swift-length-utf16/swift.hxml -D swift-output=/tmp/len-utf16/gen
# The codegen scope covers only lenfix/; the oracle entry under oracle/
# uses haxe.Sys, which does not type under the Swift std shadow.
-lib reflaxe
-lib boring
-cp packages/compiler
-cp packages/compiler/reflaxe/swift/std-shadow
-cp packages/compiler/reflaxe/swift
-cp samples
-cp tests/swift-length-utf16
--macro Intercept.run(['tests/swift-length-utf16/lenfix'])
--macro swiftcompiler.Compiler.use()
-D swift-test-runner=native
-D runtime-import=@boring/runtime
-D runtime-emit=.
-main lenfix.CharCount
