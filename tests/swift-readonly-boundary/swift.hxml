-lib reflaxe
-lib boring
-cp packages/compiler/reflaxe/swift/std-shadow
-cp packages/compiler/reflaxe/swift
-cp samples
-cp samples/haxe
-cp packages/registry/src
-cp tests/swift-readonly-boundary
-cp tests/swift-readonly-boundary/tests
--macro Intercept.run(['samples', 'packages/registry/src', 'tests/swift-readonly-boundary'])
--macro boring.SwiftBoundaryPlanChecks.run()
--macro swiftcompiler.Compiler.use()
--macro haxe.macro.Context.getType("runtime.TestCore")
-main boring.ReadOnlyBoundaryOracle
-D swift-output=out/readonly-boundary/current/gen
-D package-shell=none
-D runtime-emit=.
-D runtime-import=@boring/runtime
-D swift-test-output=out/readonly-boundary/current/tests
-D swift-test-runner=native
